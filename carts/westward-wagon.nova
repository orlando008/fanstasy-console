{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Westward Wagon",
    "author": "NOVA-16",
    "description": "Lead a wagon party of five from Missouri to the Willamette Valley in 1848: buy supplies, set the pace and the rations, ford the rivers, hunt and trade along the way, and choose wisely, for not everyone makes it. Real landmarks, period folk tunes, a diary of the journey and the graves of earlier parties on the trail."
  },
  "label": null,
  "code": "// Westward Wagon (docs/carts/westward-wagon.md)\n// An original wagon-trail game: a party of five from Independence, Missouri, to the Willamette Valley in 1848. The journey is a set of pure\n// functions on one object (J): a day's travel, the food, the health, the weather, the landmarks; the screens drive them.\n\n// --- Colours: the default palette's overlay colours (the overlay's index 0 is transparent) ---\n\nconst SHADOW = 1, PANEL = 3, BROWN = 4, RED = 6, ORANGE = 9, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15, SOLID = 113, BOARD = 114;\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"rabbit0\": {\"pal\": 2, \"size\": 16, \"tile\": 610}, \"rabbit1\": {\"pal\": 2, \"size\": 16, \"tile\": 616}, \"squirrel0\": {\"pal\": 2, \"size\": 16, \"tile\": 618}, \"squirrel1\": {\"pal\": 2, \"size\": 16, \"tile\": 644}},\n  scenes: {\"far\": {\"h\": 32, \"mx\": 0, \"my\": 0, \"pal\": 3, \"w\": 32}, \"ground\": {\"h\": 32, \"mx\": 64, \"my\": 0, \"pal\": 1, \"w\": 32}, \"logo\": {\"h\": 7, \"mx\": 96, \"my\": 0, \"pal\": 4, \"w\": 32}, \"near\": {\"h\": 32, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n  big: {\"bear0\": {\"h\": 24, \"parts\": [[0, 0, 714, 16, 2, 0], [16, 0, 716, 16, 2, 0], [0, 16, 718, 16, 2, 0], [16, 16, 736, 16, 2, 0]], \"w\": 32}, \"bear1\": {\"h\": 24, \"parts\": [[0, 0, 714, 16, 2, 0], [16, 0, 716, 16, 2, 0], [0, 16, 738, 16, 2, 0], [16, 16, 740, 16, 2, 0]], \"w\": 32}, \"buffalo0\": {\"h\": 24, \"parts\": [[0, 0, 742, 16, 2, 0], [16, 0, 744, 16, 2, 0], [0, 16, 746, 16, 2, 0], [16, 16, 748, 16, 2, 0]], \"w\": 32}, \"buffalo1\": {\"h\": 24, \"parts\": [[0, 0, 742, 16, 2, 0], [16, 0, 744, 16, 2, 0], [0, 16, 750, 16, 2, 0], [16, 16, 768, 16, 2, 0]], \"w\": 32}, \"deer0\": {\"h\": 24, \"parts\": [[0, 0, 646, 16, 2, 0], [16, 0, 648, 16, 2, 0], [0, 16, 650, 16, 2, 0], [16, 16, 652, 16, 2, 0]], \"w\": 32}, \"deer1\": {\"h\": 24, \"parts\": [[0, 0, 654, 16, 2, 0], [16, 0, 676, 16, 2, 0], [0, 16, 678, 16, 2, 0], [16, 16, 680, 16, 2, 0]], \"w\": 32}, \"elk0\": {\"h\": 24, \"parts\": [[0, 0, 682, 16, 2, 0], [16, 0, 684, 16, 2, 0], [0, 16, 686, 16, 2, 0], [16, 16, 704, 16, 2, 0]], \"w\": 32}, \"elk1\": {\"h\": 24, \"parts\": [[0, 0, 706, 16, 2, 0], [16, 0, 708, 16, 2, 0], [0, 16, 710, 16, 2, 0], [16, 16, 712, 16, 2, 0]], \"w\": 32}, \"oxen0\": {\"h\": 32, \"parts\": [[0, 0, 580, 32, 1, 0], [32, 0, 578, 16, 1, 0], [32, 16, 584, 16, 1, 0]], \"w\": 48}, \"oxen1\": {\"h\": 32, \"parts\": [[0, 0, 588, 32, 1, 0], [32, 0, 578, 16, 1, 0], [32, 16, 586, 16, 1, 0]], \"w\": 48}, \"oxen2\": {\"h\": 32, \"parts\": [[0, 0, 580, 32, 1, 0], [32, 0, 578, 16, 1, 0], [32, 16, 584, 16, 1, 0]], \"w\": 48}, \"oxen3\": {\"h\": 32, \"parts\": [[0, 0, 640, 32, 1, 0], [32, 0, 578, 16, 1, 0], [32, 16, 608, 16, 1, 0]], \"w\": 48}, \"wagon0\": {\"h\": 40, \"parts\": [[0, 0, 448, 32, 0, 0], [32, 0, 452, 32, 0, 0], [0, 32, 432, 8, 0, 0], [8, 32, 433, 8, 0, 0], [16, 32, 434, 8, 0, 0], [32, 32, 435, 8, 0, 0], [40, 32, 436, 8, 0, 0], [48, 32, 437, 8, 0, 0]], \"w\": 56}, \"wagon1\": {\"h\": 40, \"parts\": [[0, 0, 456, 32, 0, 0], [32, 0, 460, 32, 0, 0], [0, 32, 432, 8, 0, 0], [8, 32, 438, 8, 0, 0], [16, 32, 439, 8, 0, 0], [32, 32, 440, 8, 0, 0], [40, 32, 441, 8, 0, 0], [48, 32, 437, 8, 0, 0]], \"w\": 56}, \"wagon2\": {\"h\": 40, \"parts\": [[0, 0, 512, 32, 0, 0], [32, 0, 516, 32, 0, 0], [0, 32, 432, 8, 0, 0], [8, 32, 442, 8, 0, 0], [16, 32, 443, 8, 0, 0], [32, 32, 444, 8, 0, 0], [40, 32, 445, 8, 0, 0], [48, 32, 437, 8, 0, 0]], \"w\": 56}, \"wagon3\": {\"h\": 40, \"parts\": [[0, 0, 520, 32, 0, 0], [32, 0, 524, 32, 0, 0], [0, 32, 432, 8, 0, 0], [8, 32, 446, 8, 0, 0], [16, 32, 447, 8, 0, 0], [32, 32, 576, 8, 0, 0], [40, 32, 577, 8, 0, 0], [48, 32, 437, 8, 0, 0]], \"w\": 56}},\n  anims: {\"bear\": [\"bear0\", \"bear1\"], \"buffalo\": [\"buffalo0\", \"buffalo1\"], \"deer\": [\"deer0\", \"deer1\"], \"elk\": [\"elk0\", \"elk1\"], \"oxen\": [\"oxen0\", \"oxen1\", \"oxen2\", \"oxen3\"], \"wagon\": [\"wagon0\", \"wagon1\", \"wagon2\", \"wagon3\"]},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[26089,26089,26089,26089,26089,26089,26090,26090,26122,26122,26122,26122,26122,26122,26122,27147,27179,27179,27179,27179,27179,27179,27179,27180,27212,27212,27212,27212,27212,27212,27212,28237,28237,28269,28269,28269,28269,28269,28269,28270,28270,28302,28302,28302,28302,28302,28302,28303,29327,29359,29359,29359,29359,29359,29359,29360,29360,29392,29392,29392,29392,29392,29392,29393,30417,30449,30449,29425,29425,29426,29426,29426,29426,29426,29426,29427,29427,29459,29459,29459,29460,29460,29460,29460,29460,29460,28437,28437,28437,28469,28469,28470,28470,28470,28470,28470,28470,28471,28471,28471,28471,28471,28504,27480,27480,27480,27480,27480,27481,27481,27481,27481,27481,27482,27482,27482,27514,27514,26490,26491,26491,26491,26491,26491,26491,26492,26492,26492,26492,26492,26525],\"y0\":0}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n/** Queue one of ART.sprites at (x, y); opts as for spr. */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5): songs on channels 0 to 5, effects take turns on 6 and 7 ---\n\nconst SFX = { move: 0, select: 1, pause: 2, bad: 3, over: 4, good: 5, record: 6, shot: 7, splash: 8 };\nconst SONG = { title: 0, trail: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- The journey's rules (spec section 5) ---\n\nconst BACKGROUNDS = [\n  { name: 'BANKER', money: 1600, mult: 1, gift: 'MORE MONEY' },\n  { name: 'CARPENTER', money: 800, mult: 2, gift: 'MENDS THE WAGON' },\n  { name: 'FARMER', money: 400, mult: 3, gift: 'OXEN TIRE LESS' },\n];\nconst MONTHS = ['JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE', 'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'];\nconst MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nconst START_MONTHS = [2, 3, 4, 5, 6, 7];                          // March to August\n// The store (5.1): the price, the unit, the most you can have.\nconst GOODS = [\n  { key: 'oxen', name: 'OXEN', unit: 'YOKE', price: 40, step: 1, max: 9 },\n  { key: 'food', name: 'FOOD', unit: 'LB', price: 0.2, step: 50, max: 2000 },\n  { key: 'clothes', name: 'CLOTHING', unit: 'SET', price: 10, step: 1, max: 40 },\n  { key: 'bullets', name: 'AMMUNITION', unit: 'BOX OF 20', price: 2, step: 1, max: 50, per: 20 },   // kept in rounds: a box is 20\n  { key: 'wheel', name: 'SPARE WHEEL', unit: '', price: 10, step: 1, max: 3 },\n  { key: 'axle', name: 'SPARE AXLE', unit: '', price: 10, step: 1, max: 3 },\n  { key: 'tongue', name: 'SPARE TONGUE', unit: '', price: 10, step: 1, max: 3 },\n];\nconst PACES = [{ name: 'STEADY', miles: 15, cost: 0 }, { name: 'STRENUOUS', miles: 19, cost: 0.5 }, { name: 'GRUELING', miles: 24, cost: 1.5 }];   // miles a day (history: 15 to 20) and health a day\nconst RATIONS = [{ name: 'FILLING', lb: 3, cost: 0 }, { name: 'MEAGER', lb: 2, cost: 0.4 }, { name: 'BARE BONES', lb: 1, cost: 1.2 }];\nconst STARVING = 4, REST_GAIN = 3, EASY_GAIN = 0.6, RECOVER = 0.12, RECOVER_REST = 0.3;   // health points a day (5.2); the chance a day an illness passes\n// The trail (spec section 6): the mile, the name, the kind, and for a river its width (ft) and depth (ft) in spring, for a fort its prices.\n// A fork's route: 0 the main trail, 1 the first choice's branch, 2 the second's.\nconst TRAIL = [\n  { mile: 0, name: 'INDEPENDENCE', kind: 'town' },\n  { mile: 102, name: 'KANSAS RIVER', kind: 'river', width: 620, depth: 3.6, ferry: 5 },\n  { mile: 185, name: 'BIG BLUE RIVER', kind: 'river', width: 210, depth: 2.2 },\n  { mile: 304, name: 'FORT KEARNEY', kind: 'fort', prices: 1.25 },\n  { mile: 554, name: 'CHIMNEY ROCK', kind: 'sight' },\n  { mile: 640, name: 'FORT LARAMIE', kind: 'fort', prices: 1.4 },\n  { mile: 830, name: 'INDEPENDENCE ROCK', kind: 'sight' },\n  { mile: 932, name: 'SOUTH PASS', kind: 'fork', choices: ['FORT BRIDGER', 'THE SUBLETTE CUTOFF'] },\n  { mile: 1057, name: 'FORT BRIDGER', kind: 'fort', prices: 1.5, route: 1 },\n  { mile: 989, name: 'GREEN RIVER', kind: 'river', width: 400, depth: 3.2, ferry: 10, route: 2 },\n  { mile: 1151, name: 'SODA SPRINGS', kind: 'sight' },\n  { mile: 1208, name: 'FORT HALL', kind: 'fort', prices: 1.6 },\n  { mile: 1390, name: 'SNAKE RIVER', kind: 'river', width: 1000, depth: 6.4, guide: 1 },\n  { mile: 1504, name: 'FORT BOISE', kind: 'fort', prices: 2 },\n  { mile: 1600, name: 'BLUE MOUNTAINS', kind: 'sight' },\n  { mile: 1800, name: 'THE DALLES', kind: 'fork', choices: ['RAFT DOWN THE COLUMBIA', 'THE BARLOW ROAD'] },\n  { mile: 2040, name: 'WILLAMETTE VALLEY', kind: 'end' },\n];\nconst CUTOFF_SAVES = 68, BARLOW_TOLL = 30, BARLOW_DAYS = 10;\n/** The region at a mile (5.2's terrain and the art's layers): 0 prairie, 1 bluffs, 2 mountains, 3 high desert, 4 forest. */\nconst regionAt = (m) => (m < 500 ? 0 : m < 820 ? 1 : m < 1150 ? 2 : m < 1560 ? 3 : 4);\nconst TERRAIN = [1, 0.9, 0.6, 0.85, 0.75];\nconst WEATHERS = ['VERY HOT', 'HOT', 'WARM', 'COOL', 'COLD', 'VERY COLD', 'RAIN', 'HEAVY RAIN', 'SNOW', 'HEAVY SNOW', 'FOG'];\nconst WEATHER_MILES = [1, 1, 1, 1, 1, 0.9, 0.7, 0.5, 0.7, 0.3, 0.8];\nconst COLD = [0, 0, 0, 0, 1, 2, 0, 0, 2, 3, 0];                    // how cold each weather is (clothing needed)\nconst HEAT = [1, 0.3, 0, 0, 0, 0, 0, 0, 0, 0, 0];\n\n/** A new journey: the background, the month (0 to 11), the party's names. */\nfunction newJourney(bg, month, names) {\n  return {\n    bg, money: BACKGROUNDS[bg].money, month, day: 1, mile: 0, next: 1, route: 0, days: 0,\n    oxen: 0, food: 0, clothes: 0, bullets: 0, wheel: 0, axle: 0, tongue: 0,\n    pace: 0, rations: 0, weather: 3, party: names.map((name) => ({ name, health: 100, ill: 0, alive: true })),\n    done: false, arrived: false, log: [], region: 0, talked: {}, departed: false,\n  };\n}\nconst alive = (J) => J.party.filter((p) => p.alive);\n/** The party's health in words (5.1): good, fair, poor, very poor, from the average of those alive. */\nfunction healthWord(J) {\n  const a = alive(J); if (!a.length) return 'GONE';\n  const h = a.reduce((s, p) => s + p.health, 0) / a.length;\n  return h >= 70 ? 'GOOD' : h >= 50 ? 'FAIR' : h >= 30 ? 'POOR' : 'VERY POOR';\n}\nconst dateText = (J) => `${MONTHS[J.month]} ${J.day}, 1848`;\n/** The next landmark on this route, from J.next on. */\nfunction nextMark(J) { for (let k = J.next; k < TRAIL.length; k++) if (!TRAIL[k].route || TRAIL[k].route === J.route) return k; return TRAIL.length - 1; }\n/** A landmark's mile on this route (the cutoff saves some). */\nconst markMile = (J, k) => TRAIL[k].mile - (J.route === 2 && TRAIL[k].mile > 989 ? CUTOFF_SAVES : 0);\n/** The weather for a month and region: warm in summer, cold at the ends of the year and in the mountains; rain in spring, snow in winter. */\nfunction rollWeather(month, region) {\n  const temp = [5, 5, 4, 3, 2, 2, 1, 1, 2, 3, 4, 5][month] + (region === 2 ? 1 : 0) + rndi(-1, 1);   // each month's average, a step either way (midsummer: very hot a third of the days)\n  const r = rnd(1);\n  if (r < 0.12) return temp >= 4 ? (rnd(1) < 0.3 ? 9 : 8) : rnd(1) < 0.3 ? 7 : 6;   // rain, or snow when it is cold\n  if (r < 0.15) return 10;\n  return clamp(temp, 0, 5);\n}\nfunction advanceDate(J) {\n  J.days++; J.day++;\n  if (J.day > MONTH_DAYS[J.month]) { J.day = 1; J.month = (J.month + 1) % 12; }\n}\n/** One person's day (5.2): the pace, the rations (or none), the weather against the clothing, an illness; rest or an easy day heals. */\nfunction personDay(J, p, resting, starving) {\n  let loss = 0, gain = 0;\n  if (!resting) loss += PACES[J.pace].cost;\n  loss += starving ? STARVING : RATIONS[J.rations].cost;\n  const sets = J.clothes / Math.max(1, alive(J).length);\n  loss += COLD[J.weather] * (sets >= 2 ? 0 : sets >= 1 ? 0.7 : 1.5) + HEAT[J.weather];      // the cold, for want of two sets of clothing each\n  if (p.ill) loss += ILLS[p.ill].hurt;\n  if (resting) gain += REST_GAIN + (J.rations === 0 && !starving ? 1 : 0);\n  else if (J.pace === 0 && J.rations === 0 && !p.ill && !starving) gain += EASY_GAIN;\n  p.health = clamp(Math.round((p.health - loss + gain) * 10) / 10, 0, 100);\n  if (p.ill && rnd(1) < (resting ? RECOVER_REST : RECOVER)) { J.log.push(`${p.name} IS BETTER.`); p.ill = 0; }\n  if (p.health <= 0) { p.alive = false; J.log.push(`${p.name} HAS DIED.`); return true; }\n  return false;\n}\nconst ILLS = [null, { name: 'DYSENTERY', hurt: 2.5 }, { name: 'CHOLERA', hurt: 4 }, { name: 'MEASLES', hurt: 2 }, { name: 'TYPHOID', hurt: 3 }, { name: 'EXHAUSTION', hurt: 1.5 }, { name: 'A FEVER', hurt: 2 }, { name: 'A BROKEN ARM', hurt: 1 }, { name: 'A BROKEN LEG', hurt: 1.5 }, { name: 'A SNAKEBITE', hurt: 2.5 }];\n/** One day (5.2): the weather, the miles (unless resting), the food, each person's health, maybe an illness. Returns what happened:\n * { miles, arrived: the landmark reached, or -1, died: [names], ill: ['MARY HAS DYSENTERY.'] }. */\nfunction dayOnTrail(J, resting = false) {\n  J.weather = rollWeather(J.month, regionAt(J.mile));\n  const out = { miles: 0, arrived: -1, died: [], ill: [] };\n  const stuck = resting === 'stuck'; if (stuck) resting = false;      // a day lost (lost on the trail, waiting for a part): no miles and no rest\n  if (!resting && !stuck) {\n    const yoke = J.oxen < 2 ? 0.5 : 1 + 0.05 * (J.oxen - 2) * (J.bg === 2 ? 1.2 : 1);\n    let miles = Math.round(PACES[J.pace].miles * yoke * TERRAIN[regionAt(J.mile)] * WEATHER_MILES[J.weather]);\n    if (J.oxen <= 0) miles = 0;\n    const k = nextMark(J), to = markMile(J, k);\n    if (J.mile + miles >= to) { miles = to - J.mile; out.arrived = k; }\n    J.mile += miles; out.miles = miles;\n  }\n  const need = RATIONS[J.rations].lb * alive(J).length, starving = J.food < need;\n  J.food = Math.max(0, J.food - need);\n  for (const p of alive(J)) {\n    if (!p.ill && rnd(1) < illChance(J, p, resting)) { p.ill = rndi(1, ILLS.length - 1); out.ill.push(`${p.name} HAS ${ILLS[p.ill].name}.`); J.log.push(`${p.name} HAS ${ILLS[p.ill].name}.`); }\n    if (personDay(J, p, resting, starving)) out.died.push(p.name);\n  }\n  advanceDate(J);\n  if (!alive(J).length) J.done = true;\n  return out;\n}\n/** n days lost (5.3): the food is eaten, the party neither travels nor rests. Returns the names of any who died. */\nfunction loseDays(J, n) { const died = []; for (let d = 0; d < n && !J.done; d++) died.push(...dayOnTrail(J, 'stuck').died); return died; }\n\n// --- Events (spec 5.3): each day on the move, one may happen. Each is [its chance a day, when it can happen (or null), what it does to the\n// journey, returning its lines]; the chance is multiplied by the weights of the place, season and pace. ---\nconst EVENT_RATE = 1;                                               // tuning: all events' chances at once\nconst someone = (J) => { const a = alive(J); return a[rndi(0, a.length - 1)]; };\nconst EVENTS = [\n  [0.012, null, (J) => brokenPart(J)],\n  [0.004, (J) => J.oxen > 0, (J) => { if (J.bg === 2 && rnd(1) < 0.5) return ['AN OX WENT LAME, BUT THE FARMER', 'NURSED IT BACK TO PULLING.']; J.oxen--; return ['AN OX IS LAME. A YOKE CAN NO LONGER PULL.', `OXEN: ${J.oxen} YOKE`]; }],\n  [0.006, (J) => J.food > 40, (J) => { const f = Math.floor(J.food * (0.1 + rnd(0.2))); J.food -= f; const b = Math.floor(J.bullets * 0.3); J.bullets -= b; return ['A THIEF CAME IN THE NIGHT.', `LOST ${f} LB OF FOOD${b ? ` AND ${b} BULLETS` : ''}.`]; }],\n  [0.005, null, (J) => { const n = rndi(2, 4); const d = loseDays(J, n); return ['YOU LOST THE TRAIL.', `IT TOOK ${n} DAYS TO FIND IT AGAIN.`].concat(d.map((x) => `${x} HAS DIED.`)); }],\n  [0.007, (J) => regionAt(J.mile) >= 1, (J) => { for (const p of alive(J)) p.health = Math.max(1, p.health - 6); return ['BAD WATER.', 'THE PARTY IS SICK FROM IT.']; }],\n  [0.006, (J) => regionAt(J.mile) === 1 || regionAt(J.mile) === 3, (J) => { loseDays(J, 1); return ['LITTLE GRASS FOR THE OXEN.', 'YOU RESTED THEM FOR A DAY.']; }],\n  [0.006, (J) => regionAt(J.mile) === 2 || regionAt(J.mile) === 4, (J) => { loseDays(J, rndi(1, 2)); return ['ROUGH TRAIL.', 'THE WAGON CRAWLED OVER THE ROCKS.']; }],\n  [0.004, (J) => J.weather >= 6 && J.weather <= 7, (J) => { const f = Math.floor(J.food * 0.1); J.food -= f; for (const p of alive(J)) p.health = Math.max(1, p.health - 3); return ['A HAILSTORM.', `${f} LB OF FOOD SPOILED.`]; }],\n  [0.03, (J) => J.weather >= 8, (J) => { const n = rndi(2, 4); const d = loseDays(J, n); return ['A BLIZZARD.', `SNOWED IN FOR ${n} DAYS.`].concat(d.map((x) => `${x} HAS DIED.`)); }],\n  [0.003, (J) => J.food > 50, (J) => { const f = Math.floor(J.food * 0.15), c = Math.floor(J.clothes * 0.2); J.food -= f; J.clothes -= c; return ['A FIRE IN THE WAGON.', `LOST ${f} LB OF FOOD${c ? ` AND ${c} SETS OF CLOTHING` : ''}.`]; }],\n  // good fortune\n  [0.008, (J) => J.month >= 5 && J.month <= 8 && regionAt(J.mile) !== 2, (J) => { const f = rndi(20, 40); J.food += f; return ['YOU FOUND WILD BERRIES.', `+${f} LB OF FOOD.`]; }],\n  [0.005, null, (J) => { const what = rndi(0, 2); if (what === 0) { J.food += 50; return ['AN ABANDONED WAGON BY THE TRAIL.', 'YOU FOUND 50 LB OF FOOD.']; } if (what === 1) { J.clothes += 2; return ['AN ABANDONED WAGON BY THE TRAIL.', 'YOU FOUND 2 SETS OF CLOTHING.']; } const k = ['wheel', 'axle', 'tongue'][rndi(0, 2)]; J[k]++; return ['AN ABANDONED WAGON BY THE TRAIL.', `YOU FOUND A SPARE ${k.toUpperCase()}.`]; }],\n  [0.005, (J) => alive(J).some((p) => p.ill), (J) => { const p = alive(J).find((x) => x.ill); p.ill = 0; p.health = Math.min(100, p.health + 10); return ['A DOCTOR TRAVELLING WEST', `TENDED ${p.name}, WHO IS BETTER.`]; }],\n  [0.004, (J) => J.food < 300, (J) => { J.food += 60; return ['ANOTHER PARTY SHARED', 'THEIR FOOD: +60 LB.']; }],\n  [0.004, (J) => regionAt(J.mile) >= 2, (J) => { const near = TRAIL[nextMark(J)].mile, g = Math.min(rndi(10, 25), markMile(J, nextMark(J)) - J.mile - 1); if (g > 0) J.mile += g; return regionAt(J.mile) === 3 ? ['A SHOSHONE GUIDE SHOWED YOU', `A SHORTER WAY: +${Math.max(0, g)} MILES.`] : ['A TRAPPER SHOWED YOU', `A SHORTER WAY: +${Math.max(0, g)} MILES.`]; }],\n  [0.005, (J) => regionAt(J.mile) === 3 || regionAt(J.mile) === 1, (J) => { for (const p of alive(J)) p.health = Math.min(100, p.health + 5); return regionAt(J.mile) === 3 ? ['A SHOSHONE FAMILY SHOWED YOU', 'A SPRING OF GOOD WATER.'] : ['A LAKOTA FAMILY SHOWED YOU', 'A SPRING OF GOOD WATER.']; }],\n];\n/** A broken wheel, axle or tongue: a spare mends it; without one, a carpenter mends it half the time, anyone else a third; or the party\n * waits for a passing train to trade one. */\nfunction brokenPart(J) {\n  const k = ['wheel', 'axle', 'tongue'][rndi(0, 2)], name = `A WAGON ${k.toUpperCase()} BROKE.`;\n  if (J[k] > 0) { J[k]--; return [name, 'YOU REPLACED IT WITH A SPARE.']; }\n  if (rnd(1) < (J.bg === 1 ? 0.5 : 0.33)) return [name, J.bg === 1 ? 'THE CARPENTER MENDED IT.' : 'YOU MANAGED TO MEND IT.'];\n  const n = rndi(3, 6), f = Math.min(J.food, 40); J.food -= f; const d = loseDays(J, n);\n  return [name, `YOU WAITED ${n} DAYS FOR A PASSING`, `PARTY TO TRADE YOU ONE (${f} LB OF FOOD).`].concat(d.map((x) => `${x} HAS DIED.`));\n}\n/** Today's event, if any (5.3): the chances are multiplied by the pace (a hard pace breaks things) and the rations. Applies it and returns\n * its lines, or null. */\nfunction rollEvent(J) {\n  const w = EVENT_RATE * (1 + 0.3 * J.pace);\n  for (const [chance, when, act] of EVENTS) {\n    if (when && !when(J)) continue;\n    if (rnd(1) < chance * w) { const lines = act(J); J.log.push(lines.join(' ')); if (!alive(J).length) J.done = true; return lines; }\n  }\n  return null;\n}\n/** The chance a well person falls ill today: more with a hard pace, poor rations, poor health and cold. */\nconst illChance = (J, p, resting) => 0.006 * (1 + J.pace + J.rations + (p.health < 50 ? 2 : 0) + (COLD[J.weather] ? 1 : 0)) * (resting ? 0.5 : 1);\n/** The score on arriving (5.6). */\nfunction scoreOf(J) {\n  const words = { GOOD: 4, FAIR: 3, POOR: 2, 'VERY POOR': 1 };\n  let s = 0;\n  for (const p of alive(J)) { const h = p.health >= 70 ? 4 : p.health >= 50 ? 3 : p.health >= 30 ? 2 : 1; s += 500 * h; }\n  s += 50 + J.oxen * 4 + (J.wheel + J.axle + J.tongue) * 2 + J.clothes * 2 + Math.floor(J.bullets / 50) + Math.floor(J.food / 25) + Math.floor(J.money / 5);\n  return s * BACKGROUNDS[J.bg].mult;\n}\n/** Crossing a river (5.4): what the depth does to a ford; the ferry; caulking and floating, by the float's hits. */\nfunction crossRiver(J, how, river, hits = 0) {\n  const d = riverDepth(J, river);\n  if (how === 'guide') { if (J.clothes < 1) return 'NO CLOTHING TO TRADE FOR A GUIDE.'; J.clothes--; advanceDate(J); return 'A SHOSHONE GUIDE LED THE WAGON ACROSS BY THE SHALLOWS, SAFELY.'; }\n  if (how === 'ferry') { const fee = river.ferry || 0; if (J.money < fee) return 'NO MONEY FOR THE FERRY'; J.money -= fee; advanceDate(J); return 'THE FERRY TOOK YOU ACROSS.'; }\n  if (how === 'ford') {\n    if (d < 2.5) return 'YOU FORDED THE RIVER SAFELY.';\n    if (d < 3 && rnd(1) < 0.7) return 'YOU FORDED THE RIVER. IT WAS CLOSE.';\n    return loseSupplies(J, d < 3 ? 0.2 : 0.4, 'THE WAGON TIPPED IN THE RIVER.');\n  }\n  return floatOutcome(J, hits, false);                              // caulk and float: what the float (its hits) did\n}\n/** What a float's hits do (5.4): none is safe; one loses some food; two lose a share of the goods; three or more swamp the wagon, and\n * someone may drown. The Columbia (big) is worse. */\nfunction floatOutcome(J, hits, big) {\n  if (!hits) return big ? 'YOU RAFTED DOWN THE COLUMBIA SAFELY.' : 'YOU FLOATED ACROSS SAFELY.';\n  if (hits === 1) { const f = Math.floor(J.food * 0.08); J.food -= f; J.log.push(`THE WAGON STRUCK A ROCK. LOST ${f} LB OF FOOD.`); return `THE WAGON STRUCK A ROCK. LOST ${f} LB OF FOOD.`; }\n  if (hits === 2) return loseSupplies(J, big ? 0.25 : 0.15, 'THE WAGON STRUCK ROCKS.');\n  return loseSupplies(J, big ? 0.5 : 0.35, 'THE WAGON SWAMPED.');\n}\nfunction loseSupplies(J, share, what) {\n  const lost = Math.floor(J.food * share); J.food -= lost; J.clothes -= Math.floor(J.clothes * share); J.bullets -= Math.floor(J.bullets * share);\n  let t = `${what} LOST ${lost} LB OF FOOD`;\n  if (rnd(1) < share) { const v = alive(J)[rndi(0, alive(J).length - 1)]; v.alive = false; t += `. ${v.name} DROWNED`; if (!alive(J).length) J.done = true; }\n  J.log.push(t + '.');\n  return t + '.';\n}\n/** The cost of buying n more of a good at a price multiplier (the forts': 5.1). */\nconst costOf = (g, n, mult = 1) => Math.round(g.price * n * mult * 100) / 100;\n\n// --- The hunt (5.5): 30 seconds; animals of the region cross in three lanes at their own speeds; the d-pad aims, A fires a bullet. At most\n// CARRY lb comes back, and the hunt takes a day. ---\nconst MEAT = { rabbit: 2, squirrel: 1, deer: 50, elk: 80, bear: 100, buffalo: 400 };\nconst SPEED = { rabbit: 1.5, squirrel: 1.2, deer: 1.1, elk: 0.85, bear: 0.6, buffalo: 0.5 };\nconst BIG = { deer: 1, elk: 1, bear: 1, buffalo: 1 };\nconst GAME = [                                                       // by region: [kind, how often]\n  [['rabbit', 4], ['squirrel', 2], ['deer', 3], ['buffalo', 3]],     // the prairie\n  [['rabbit', 4], ['deer', 3], ['buffalo', 3]],                      // the bluffs\n  [['squirrel', 4], ['deer', 3], ['elk', 2], ['bear', 1]],           // the mountains\n  [['rabbit', 5], ['deer', 3], ['elk', 1]],                          // the high desert\n  [['squirrel', 4], ['deer', 3], ['elk', 2], ['bear', 1]],           // the forest\n];\nconst HUNT_FRAMES = 1800, CARRY = 100, AIM_SPEED = 2, LANES = [124, 136, 149];   // the lanes' feet, far to near\nlet hunt = null;\nfunction toHunt() {\n  state = 'hunt'; timer = 0; card = null;\n  hunt = { aim: [128, 96], animals: [], meat: 0, kills: 0, fired: 0, flash: 0, spawn: 20, pops: [] };\n}\nfunction pickGame(region) {\n  const list = GAME[region], total = list.reduce((s, g) => s + g[1], 0);\n  let r = rnd(total); for (const [k, w] of list) { if ((r -= w) < 0) return k; } return list[0][0];\n}\n/** An animal's box to hit (inside its picture). */\nconst animalBox = (a) => (BIG[a.kind] ? [a.x + 3, a.y + 4, 26, 20] : [a.x + 2, a.y + 6, 12, 10]);\nfunction updateHunt() {\n  const h = hunt, held = (b) => (inputMask & (1 << b)) !== 0;\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (held(LEFT)) h.aim[0] -= AIM_SPEED; if (held(RIGHT)) h.aim[0] += AIM_SPEED;\n  if (held(UP)) h.aim[1] -= AIM_SPEED; if (held(DOWN)) h.aim[1] += AIM_SPEED;\n  h.aim[0] = clamp(h.aim[0], 4, 251); h.aim[1] = clamp(h.aim[1], 60, 148);\n  if (--h.spawn <= 0 && h.animals.filter((a) => !a.dead).length < 5) {\n    const kind = pickGame(regionAt(J.mile)), lane = rndi(0, 2), dir = rnd(1) < 0.5 ? 1 : -1, w = BIG[kind] ? 32 : 16, hh = BIG[kind] ? 24 : 16;\n    h.animals.push({ kind, x: dir > 0 ? -w : 256, y: LANES[lane] - hh, lane, w, h: hh, dir, v: SPEED[kind] * (0.85 + rnd(0.3)), dead: 0, t: 0 });\n    h.animals.sort((a, b) => a.lane - b.lane);\n    h.spawn = Math.round(rndi(35, 90) * (J.month <= 1 || J.month === 11 ? 1.6 : 1));   // fewer in winter\n  }\n  for (const a of h.animals) { a.t++; if (a.dead) a.dead++; else a.x += a.v * a.dir; }\n  h.animals = h.animals.filter((a) => a.dead < 40 && a.x > -40 && a.x < 260);\n  for (const p of h.pops) p.t++; h.pops = h.pops.filter((p) => p.t < 50);\n  if (h.flash) h.flash--;\n  if (pressed(A)) {\n    if (J.bullets <= 0) fx(SFX.move);\n    else {\n      J.bullets--; h.fired++; h.flash = 5; fx(SFX.shot);\n      const [x, y] = h.aim, hit = h.animals.slice().reverse().find((a) => { if (a.dead) return false; const [bx, by, bw, bh] = animalBox(a); return x >= bx && x < bx + bw && y >= by && y < by + bh; });\n      if (hit) { hit.dead = 1; h.meat += MEAT[hit.kind]; h.kills++; h.pops.push({ x: hit.x + hit.w / 2, y: hit.y, n: MEAT[hit.kind], t: 0 }); fx(SFX.good); }\n      else for (const a of h.animals) if (!a.dead && Math.abs(a.x + a.w / 2 - x) < 48) a.v *= 1.8;   // a miss startles those near it\n    }\n  }\n  if (timer >= HUNT_FRAMES || (pressed(B) && timer > 20)) endHunt();\n}\nfunction endHunt() {\n  const h = hunt, got = Math.min(h.meat, CARRY);\n  J.food += got;\n  const died = loseDays(J, 1);\n  J.log.push(h.meat ? `HUNTED: ${h.meat} LB OF MEAT, ${got} LB CARRIED BACK.` : 'HUNTED, AND SHOT NOTHING.');\n  toTrail(); hunt = null;\n  const lines = h.meat ? [`YOU SHOT ${h.meat} LB OF MEAT.`].concat(h.meat > CARRY ? [`YOU CAN CARRY ONLY ${CARRY} LB`, 'BACK TO THE WAGON.'] : []) : ['YOU SHOT NOTHING.'];\n  showCard('THE HUNT', lines.concat(died.map((n) => `${n} HAS DIED.`)), null, () => { if (J.done) endJourney(); });\n}\n\n// --- The float (5.4): the wagon, caulked, goes down the current from the bottom of the screen; rocks and eddies come at it; LEFT and RIGHT\n// steer. Each rock struck is a hit; floatOutcome says what they cost. ---\nconst WATER = 115, WATER2 = 116, ROCK = 117, ROCK2 = 118, BANK = 119, BANK2 = 120, CANVAS = 121, WOOD = 122;\nconst FLOAT_Y = 136;\nlet flt = null;\n/** A float: frames long, a rock every gap frames, the current's speed; then(hits) when it is over. */\nfunction toFloat(title, frames, gap, current, then) {\n  state = 'float'; timer = 0; card = null;\n  flt = { title, frames, gap, current, then, x: 128, vx: 0, rocks: [], eddies: [], hits: 0, hurt: 0, dist: 0, spawn: 30, bump: 0 };\n}\n/** The banks at a screen line: [left edge of the water, right edge]. */\nfunction banks(f, y) { const k = f.dist - y; return [26 + 12 * Math.sin(k / 47) + 6 * Math.sin(k / 13), 230 + 12 * Math.sin(k / 53 + 2) + 6 * Math.sin(k / 17)]; }\nfunction updateFloat() {\n  const f = flt, held = (b) => (inputMask & (1 << b)) !== 0;\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (held(LEFT)) f.vx -= 0.3; if (held(RIGHT)) f.vx += 0.3;\n  if (!held(LEFT) && !held(RIGHT)) f.vx *= 0.88;\n  for (const e of f.eddies) if (Math.abs(e.x - f.x) < e.r + 6 && Math.abs(e.y - FLOAT_Y) < e.r + 8) f.vx += 0.12 * e.s;\n  f.vx = clamp(f.vx, -2.4, 2.4); f.x += f.vx;\n  const [l, r] = banks(f, FLOAT_Y);\n  if (f.x < l + 8 || f.x > r - 8) { f.x = clamp(f.x, l + 8, r - 8); f.vx = 0; if (!f.bump) { fx(SFX.move); f.bump = 20; } }\n  if (f.bump) f.bump--;\n  f.dist += f.current;\n  for (const o of f.rocks) o.y += f.current; for (const e of f.eddies) e.y += f.current;\n  f.rocks = f.rocks.filter((o) => o.y < 200); f.eddies = f.eddies.filter((e) => e.y < 200);\n  if (--f.spawn <= 0 && timer < f.frames - 70) {\n    const [bl, br] = banks(f, -12), rr = rndi(5, 9);\n    if (rnd(1) < 0.8) f.rocks.push({ x: rndi(bl + rr + 4, br - rr - 4), y: -12, r: rr });\n    else f.eddies.push({ x: rndi(bl + 20, br - 20), y: -14, r: 12, s: rnd(1) < 0.5 ? 1 : -1 });\n    f.spawn = Math.round(f.gap * (0.6 + rnd(0.8)));\n  }\n  if (f.hurt) f.hurt--;\n  else for (const o of f.rocks) if (!o.hit && Math.abs(o.x - f.x) < o.r + 5 && Math.abs(o.y - FLOAT_Y) < o.r + 9) { o.hit = true; f.hits++; f.hurt = 40; fx(SFX.splash); break; }\n  if (timer >= f.frames) { const then = f.then, hits = f.hits; flt = null; toTrail(); then(hits); }\n}\n\n// --- Trading (5.5): a day spent waiting by the trail brings a trader: one of the region's people, or another traveller. Each offers one\n// good for another, near its worth; accept or decline. ---\nconst TRADERS = [['A PAWNEE TRADER', 'A SETTLER'], ['A LAKOTA TRADER', 'A FRENCH TRAPPER'], ['A SHOSHONE TRADER', 'A MOUNTAIN MAN'], ['A SHOSHONE TRADER', 'A FAMILY GOING EAST'], ['A NEZ PERCE TRADER', 'A SETTLER']];\nconst WORTH = { oxen: 40, food: 0.2, clothes: 10, bullets: 0.1, wheel: 10, axle: 10, tongue: 10 };\nconst TRADE_LOTS = { oxen: [1, 1], food: [50, 150], clothes: [1, 3], bullets: [20, 60], wheel: [1, 1], axle: [1, 1], tongue: [1, 1] };\nconst TRADE_STEP = { food: 10, bullets: 10 };\nfunction goodText(k, n) {\n  if (k === 'oxen') return `${n} YOKE OF OXEN`;\n  if (k === 'food') return `${n} LB OF FOOD`;\n  if (k === 'clothes') return `${n} SET${n > 1 ? 'S' : ''} OF CLOTHING`;\n  if (k === 'bullets') return `${n} BULLETS`;\n  return n > 1 ? `${n} SPARE ${k.toUpperCase()}S` : `A SPARE ${k.toUpperCase()}`;\n}\n/** Today's offer, or null: { who, give: [good, n], want: [good, n] }, where want is something the party has. */\nfunction tradeOffer(J) {\n  const keys = Object.keys(WORTH), region = regionAt(J.mile);\n  for (let tries = 0; tries < 12; tries++) {\n    const give = keys[rndi(0, keys.length - 1)], want = keys[rndi(0, keys.length - 1)];\n    if (give === want) continue;\n    const [lo, hi] = TRADE_LOTS[give], step = TRADE_STEP[give] || 1, gn = Math.round(rndi(lo, hi) / step) * step;\n    const ws = TRADE_STEP[want] || 1, wn = Math.max(ws, Math.round(gn * WORTH[give] * (0.9 + rnd(0.5)) / WORTH[want] / ws) * ws);\n    const gw = WORTH[give] * gn, ww = WORTH[want] * wn;\n    if (ww < gw * 0.8 || ww > gw * 1.6) continue;                  // near its worth (a little in the trader's favour)\n    if (J[want] < wn + (want === 'oxen' ? 1 : 0)) continue;           // only what the party has, and never their last yoke\n    const who = TRADERS[region][rnd(1) < 0.6 ? 0 : 1];\n    return { who, give: [give, gn], want: [want, wn] };\n  }\n  return null;\n}\nfunction applyTrade(J, o) { J[o.want[0]] -= o.want[1]; J[o.give[0]] += o.give[1]; J.log.push(`TRADED ${goodText(...o.want)} FOR ${goodText(...o.give)}.`); }\n/** The menu's TRADE: a day passes, then the offer (or nobody). */\nfunction seekTrade() {\n  const died = loseDays(J, 1), dl = died.map((n) => `${n} HAS DIED.`);\n  if (J.done) return showCard(dateText(J), dl, null, endJourney);\n  const o = rnd(1) < 0.85 ? tradeOffer(J) : null;\n  if (!o) return showCard('TRADING', dl.concat(['NOBODY CAME BY TO TRADE TODAY.']));\n  showCard('TRADING', dl.concat([`${o.who} OFFERS`, `${goodText(...o.give)}`, `FOR ${goodText(...o.want)}.`]), ['ACCEPT', 'DECLINE'], (c) => {\n    if (c === 0) { applyTrade(J, o); fx(SFX.good); showCard('TRADING', ['IT IS A DEAL.', `+${goodText(...o.give)}`]); }\n  });\n  card.offer = o;\n}\n\n// --- Save slots (spec section 13; the journey's save comes in step 6) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, TOP_SLOT = 100, TOP_N = 10;\nfunction topTen() { const out = []; for (let i = 0; i < TOP_N; i++) out.push({ score: dget(TOP_SLOT + i * 4), name: unpackName(dget(TOP_SLOT + i * 4 + 1), dget(TOP_SLOT + i * 4 + 2)), bg: dget(TOP_SLOT + i * 4 + 3) }); return out; }\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) { const [a, b] = packName(list[i].name); dset(TOP_SLOT + i * 4, list[i].score); dset(TOP_SLOT + i * 4 + 1, a); dset(TOP_SLOT + i * 4 + 2, b); dset(TOP_SLOT + i * 4 + 3, list[i].bg); }\n  return at;\n}\nconst CHARS = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ.-\\'';\n/** A name of up to 10 characters in two slots (5 bits each, 5 a slot... 6 in the first). */\nfunction packName(s) { const v = [0, 0]; for (let i = 0; i < 10; i++) { const c = Math.max(0, CHARS.indexOf(s[i] || ' ')); v[i >> 1 > 2 ? 1 : 0] += 0; } let a = 0, b = 0; for (let i = 0; i < 5; i++) a = a * 32 + Math.max(0, CHARS.indexOf(s[i] || ' ')); for (let i = 5; i < 10; i++) b = b * 32 + Math.max(0, CHARS.indexOf(s[i] || ' ')); return [a, b]; }\nfunction unpackName(a, b) { let s = ''; for (let i = 4; i >= 0; i--) s = CHARS[(a >> (5 * i)) & 31] + s; let t = ''; for (let i = 4; i >= 0; i--) t = CHARS[(b >> (5 * i)) & 31] + t; return (rev(s) + rev(t)).trim(); }\nconst rev = (s) => s.split('').reverse().join('');\n\n// --- Input ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst stepped = (b) => pressed(b) || (btnp(b) && (inputMask & (1 << b)) !== 0);\n\n// --- State ---\n\nlet skipTitle = false;                                              // tests set this to land straight on the trail with a stocked wagon\nlet state = 'title', paused = false, timer = 0, clock = 0, sel = 0, pauseSel = 0;\nlet J = null, setup = { bg: 0, month: 1, step: 0 }, cart = {}, storeMult = 1, card = null, dayTimer = 0, scroll = 0, rank = -1;\nconst DAY_FRAMES = 50;                                              // a day rolls by in this many frames (spec: about a second)\nconst NAMES = ['MARY', 'JOHN', 'SARAH', 'WILL', 'ELLA'];            // step 6 adds naming them\n\n// --- The book (rom/book.bin, from book.py): each place's paragraph and its people, the regions' cards ---\nlet BOOK = null;\nfunction loadBook() {\n  const b = rom('book'); let i = 3;\n  const str = () => { const n = b[i++]; let t = ''; for (let k = 0; k < n; k++) t += String.fromCharCode(b[i++]); return t; };\n  const places = {}, regions = [];\n  for (let n = b[i++]; n > 0; n--) { const name = str(), about = str().split('|'), talk = []; for (let t = b[i++]; t > 0; t--) talk.push({ who: str(), lines: str().split('|') }); places[name] = { about, talk }; }\n  for (let n = b[i++]; n > 0; n--) regions.push({ name: str(), lines: str().split('|') });\n  BOOK = { places, regions };\n}\n\nfunction init() {\n  loadBook();\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  for (const [layer, name] of [[0, 'ground'], [1, 'near'], [2, 'far']]) { const sc = ART.scenes[name]; bg(layer, { mx: sc.mx, my: sc.my, mw: sc.w, mh: sc.h, x: 0, y: 0, wrap: true, show: true }); }\n  color(SOLID, 6, 4, 2); color(BOARD, 14, 9, 5);\n  color(WATER, 6, 12, 18); color(WATER2, 14, 21, 26); color(ROCK, 10, 9, 9); color(ROCK2, 17, 16, 15); color(BANK, 9, 14, 6); color(BANK2, 20, 17, 10); color(CANVAS, 29, 28, 24); color(WOOD, 13, 8, 4);\n  blend({ layers: ['overlay'], half: true });\n  if (skipTitle) { J = newJourney(0, 3, NAMES); Object.assign(J, { departed: true, oxen: 4, food: 900, clothes: 10, bullets: 200, wheel: 1, axle: 1, tongue: 1, money: 1600 - 4 * 40 - 180 - 100 - 20 - 30 }); toTrail(); }\n  else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; sel = 0; paused = false; play(SONG.title); }\nfunction toSetup() { state = 'setup'; timer = 0; setup = { bg: 0, month: 1, step: 0 }; }\nfunction toStore(mult = 1) { state = 'store'; timer = 0; sel = 0; storeMult = mult; cart = {}; for (const g of GOODS) cart[g.key] = 0; }\nfunction toTrail() { state = 'trail'; timer = 0; paused = false; card = null; dayTimer = 0; play(SONG.trail); }\nfunction toMenu() { state = 'menu'; timer = 0; sel = 0; }\n/** A card over the trail: a title, lines, and choices (or none: A continues). then(choice) runs when one is made. */\nfunction showCard(title, lines, choices = null, then = null) { card = { title, lines, choices, then, sel: 0 }; }\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (card) updateCard();\n  else if (state === 'title') updateTitle();\n  else if (state === 'setup') updateSetup();\n  else if (state === 'store') updateStore();\n  else if (state === 'trail') updateTrail();\n  else if (state === 'menu') updateMenu();\n  else if (state === 'hunt') updateHunt();\n  else if (state === 'float') updateFloat();\n  else if (state === 'end') updateEnd();\n  else if (state === 'records') { if (timer > 20 && (pressed(A) || pressed(B) || pressed(START))) toTitle(); }\n  prevMask = inputMask;\n}\n\nfunction updateCard() {\n  const c = card;\n  if (c.choices) {\n    if (stepped(UP)) { c.sel = (c.sel + c.choices.length - 1) % c.choices.length; fx(SFX.move); }\n    if (stepped(DOWN)) { c.sel = (c.sel + 1) % c.choices.length; fx(SFX.move); }\n    if (pressed(A)) { fx(SFX.select); card = null; if (c.then) c.then(c.sel); }\n  } else if (pressed(A) || pressed(B)) { fx(SFX.select); card = null; if (c.then) c.then(0); }\n}\n\nfunction updateTitle() {\n  scroll++;                                                        // the prairie drifts by behind the title\n  if (stepped(UP) || stepped(DOWN)) { sel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) { fx(SFX.select); if (sel === 0) toSetup(); else { state = 'records'; timer = 0; } }\n}\n\n/** The setup (spec 10): the background, then the month; the names are fixed until step 6. */\nfunction updateSetup() {\n  if (setup.step === 0) {\n    if (stepped(UP)) { setup.bg = (setup.bg + 2) % 3; fx(SFX.move); }\n    if (stepped(DOWN)) { setup.bg = (setup.bg + 1) % 3; fx(SFX.move); }\n  } else {\n    if (stepped(UP)) { setup.month = (setup.month + 5) % 6; fx(SFX.move); }\n    if (stepped(DOWN)) { setup.month = (setup.month + 1) % 6; fx(SFX.move); }\n  }\n  if (pressed(B)) { fx(SFX.move); if (setup.step) setup.step--; else toTitle(); }\n  else if (pressed(A)) {\n    fx(SFX.select);\n    if (setup.step === 0) setup.step = 1;\n    else { J = newJourney(setup.bg, START_MONTHS[setup.month], NAMES); toStore(); }\n  }\n}\n\n/** The store (5.1): UP and DOWN choose a good, LEFT and RIGHT change how many to buy, A leaves (with at least a yoke of oxen at Independence). */\nconst cartCost = () => GOODS.reduce((s, g) => s + costOf(g, cart[g.key], storeMult), 0);\nfunction updateStore() {\n  const n = GOODS.length + 1;\n  if (stepped(UP)) { sel = (sel + n - 1) % n; fx(SFX.move); }\n  if (stepped(DOWN)) { sel = (sel + 1) % n; fx(SFX.move); }\n  if (sel < GOODS.length) {\n    const g = GOODS[sel], have = Math.ceil(J[g.key] / (g.per || 1)) + cart[g.key];\n    if (stepped(RIGHT) && have + g.step <= g.max && cartCost() + costOf(g, g.step, storeMult) <= J.money + 1e-9) { cart[g.key] += g.step; fx(SFX.move); }\n    if (stepped(LEFT) && cart[g.key] > 0) { cart[g.key] -= g.step; fx(SFX.move); }\n  }\n  if (pressed(A) && sel === GOODS.length || pressed(START)) {\n    if (J.mile === 0 && J.oxen + cart.oxen < 1) { fx(SFX.bad); showCard('THE STORE', ['YOU NEED AT LEAST ONE YOKE', 'OF OXEN TO PULL THE WAGON.']); return; }\n    J.money = Math.round((J.money - cartCost()) * 100) / 100;\n    for (const g of GOODS) J[g.key] += cart[g.key] * (g.per || 1);\n    fx(SFX.select); toTrail();\n    if (!J.departed) { J.departed = true; showCard('INDEPENDENCE, MISSOURI', BOOK.places.INDEPENDENCE.about); }   // setting out\n  } else if (pressed(B) && J.mile > 0) { fx(SFX.move); toTrail(); }\n}\n\n/** The trail: a day every DAY_FRAMES frames; A stops for the menu; landmarks and deaths stop the wagon with a card. */\nfunction updateTrail() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(A)) { fx(SFX.select); toMenu(); return; }\n  scroll += 1;\n  if (++dayTimer < DAY_FRAMES) return;\n  dayTimer = 0;\n  travel(false);\n}\n/** A day's travel, then what it brings: deaths, illness, the landmark reached, the end. */\nfunction travel(resting) {\n  const out = dayOnTrail(J, resting), lines = [];\n  for (const n of out.died) lines.push(`${n} HAS DIED.`);\n  for (const t of out.ill) if (!out.died.some((n) => t.startsWith(n + ' '))) lines.push(t);   // the illness as it struck (it may have passed by the evening)\n  const ev = !resting && out.arrived < 0 && !J.done ? rollEvent(J) : null;   // an event on a day of travel that reached no landmark\n  const reg = regionAt(J.mile), newRegion = reg > J.region; J.region = Math.max(J.region, reg);\n  const after = () => {\n    if (J.done) return endJourney();\n    const go = () => { if (out.arrived >= 0) reach(out.arrived); };\n    if (newRegion) { const r = BOOK.regions[reg]; showCard(r.name, r.lines, null, go); } else go();   // a card on entering a new region\n  };\n  const evCard = () => { if (ev) { fx(/DIED|LOST|BROKE|THIEF|LAME|STORM|BLIZZARD|FIRE|BAD|ROUGH|LITTLE/.test(ev[0]) ? SFX.bad : SFX.good); showCard(dateText(J), ev, null, after); } else after(); };\n  if (lines.length) { fx(out.died.length ? SFX.over : SFX.bad); showCard(dateText(J), lines, null, evCard); }\n  else evCard();\n  return out;\n}\n/** Reaching a landmark (5.3 to 5.4, 6): its scene and card, where you can look around (the book's paragraph), talk to the people there\n * (a different one each time) and, at a fort, buy supplies; then a river asks how to cross, a fork which way; the end ends. */\nfunction reach(k) {\n  const m = TRAIL[k]; J.next = k + 1; fx(SFX.good);\n  J.log.push(`REACHED ${m.name}.`);\n  if (m.kind === 'end') { J.arrived = true; J.done = true; return endJourney(); }\n  showScene(m.name);                                                // its painted scene, when it has one (step 7 paints the rest)\n  const page = BOOK.places[m.name], off = () => { sceneOn = -1; };\n  const line = m.kind === 'river' ? `${m.width} FEET ACROSS, ${riverDepth(J, m).toFixed(1)} FEET DEEP.` : m.kind === 'fort' ? 'A FORT, WITH A STORE.' : m.kind === 'fork' ? 'THE TRAIL DIVIDES HERE.' : 'A LANDMARK ON THE TRAIL.';\n  const look = () => showCard(m.name, page.about, null, arrive);\n  const talk = () => {\n    if (!page.talk.length) return showCard(m.name, ['NOBODY IS ABOUT.'], null, arrive);\n    const n = J.talked[m.name] || 0, who = page.talk[n % page.talk.length]; J.talked[m.name] = n + 1;\n    showCard(who.who, who.lines, null, arrive);\n  };\n  const onward = () => { off(); if (m.kind === 'river') crossing(m); else if (m.kind === 'fork') fork(m); };\n  const opts = [['LOOK AROUND', look], ['TALK TO SOMEONE', talk]].concat(m.kind === 'fort' ? [['BUY SUPPLIES', () => { off(); toStore(m.prices); }]] : [])\n    .concat([[m.kind === 'river' ? 'CROSS THE RIVER' : m.kind === 'fork' ? 'CHOOSE THE WAY' : 'GO ON', onward]]);\n  const arrive = () => showCard(m.name, [line], opts.map((o) => o[0]), (c) => opts[c][1]());\n  arrive();\n}\nconst riverDepth = (J, m) => m.depth * (J.month >= 6 ? 0.7 : 1);    // lower water in late summer\n/** A river's crossing (5.4): ford, float, the ferry, a guide where one offers, or wait a day. */\nfunction crossing(m) {\n  const ways = [['FORD THE RIVER', 'ford'], ['CAULK THE WAGON AND FLOAT', 'float']].concat(m.ferry ? [[`TAKE THE FERRY ($${m.ferry})`, 'ferry']] : [])\n    .concat(m.guide ? [['HIRE A GUIDE (1 CLOTHING)', 'guide']] : []).concat([['WAIT A DAY', 'wait']]);\n  const ask = () => showCard(m.name, [`${m.width} FEET ACROSS, ${riverDepth(J, m).toFixed(1)} FEET DEEP.`], ways.map((w) => w[0]), (c) => {\n    const how = ways[c][1];\n    if (how === 'wait') { dayOnTrail(J, true); return ask(); }\n    const done = (r) => { fx(/LOST|DROWN|NO MONEY|NO CLOTHING/.test(r) ? SFX.bad : SFX.good); if (/^NO /.test(r)) return showCard(m.name, [r], null, ask); showCard(m.name, wrapText(r), null, () => { if (J.done) endJourney(); }); };\n    if (how === 'float') return toFloat(m.name, clamp(Math.round(m.width * 0.6), 360, 660), Math.max(18, Math.round(40 - m.depth * 4)), 1.6 + m.depth * 0.1, (hits) => done(crossRiver(J, 'float', m, hits)));\n    done(crossRiver(J, how, m));\n  });\n  ask();\n}\n/** A fork (5.3, 6): South Pass's two routes; at The Dalles the raft (a float down the Columbia) or the Barlow Road. */\nfunction fork(m) {\n  showCard(m.name, ['WHICH WAY?'], m.choices, (c) => {\n    if (m.name === 'SOUTH PASS') J.route = c + 1;\n    else if (c === 1) { J.money = Math.max(0, J.money - BARLOW_TOLL); for (let d = 0; d < BARLOW_DAYS; d++) dayOnTrail(J, true); J.log.push('TOOK THE BARLOW ROAD.'); }\n    else { J.log.push('RAFTED DOWN THE COLUMBIA.'); toFloat('THE COLUMBIA RIVER', 1200, 18, 2.4, (hits) => { const r = floatOutcome(J, hits, true); fx(hits ? SFX.bad : SFX.good); showCard('THE COLUMBIA RIVER', wrapText(r), null, () => { if (J.done) endJourney(); }); }); }\n  });\n}\n/** A text in lines of at most 28 letters (a card's width), broken at spaces. */\nfunction wrapText(t, w = 28) {\n  const out = []; let l = '';\n  for (const word of t.split(' ')) { if (l && l.length + 1 + word.length > w) { out.push(l); l = word; } else l = l ? `${l} ${word}` : word; }\n  if (l) out.push(l);\n  return out;\n}\nfunction endJourney() {\n  state = 'end'; timer = 0; card = null;\n  const sc = J.arrived ? scoreOf(J) : 0;\n  rank = J.arrived ? insertTop({ score: sc, name: J.party[0].name, bg: J.bg }) : -1;\n  J.score = sc; fx(J.arrived ? SFX.record : SFX.over);\n}\nfunction updateEnd() { if (timer > 60 && (pressed(A) || pressed(START))) { fx(SFX.select); state = 'records'; timer = 0; } }\n\n/** The menu (spec 4): continue, supplies, pace, rations, rest, hunt, trade. */\nconst MENU = ['CONTINUE ON THE TRAIL', 'CHECK SUPPLIES', 'CHANGE PACE', 'CHANGE RATIONS', 'STOP TO REST', 'HUNT FOR FOOD', 'TRADE'];\nfunction updateMenu() {\n  if (stepped(UP)) { sel = (sel + MENU.length - 1) % MENU.length; fx(SFX.move); }\n  if (stepped(DOWN)) { sel = (sel + 1) % MENU.length; fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.move); toTrail(); return; }\n  if (!pressed(A)) return;\n  fx(SFX.select);\n  if (sel === 0) toTrail();\n  else if (sel === 1) showCard('SUPPLIES', supplyLines());\n  else if (sel === 2) showCard('PACE', ['HOW FAST TO GO.'], PACES.map((p) => p.name), (c) => { J.pace = c; });\n  else if (sel === 3) showCard('RATIONS', ['HOW MUCH TO EAT.'], RATIONS.map((r) => r.name), (c) => { J.rations = c; });\n  else if (sel === 5) { if (J.bullets <= 0) showCard('THE HUNT', ['YOU HAVE NO BULLETS.']); else toHunt(); }\n  else if (sel === 6) seekTrade();\n  else showCard('REST', ['HOW MANY DAYS?'], ['1 DAY', '3 DAYS', '5 DAYS'], (c) => { const n = [1, 3, 5][c]; for (let d = 0; d < n && !J.done; d++) dayOnTrail(J, true); if (J.done) endJourney(); });\n}\nfunction supplyLines() {\n  return [`OXEN: ${J.oxen} YOKE`, `FOOD: ${J.food} LB`, `CLOTHING: ${J.clothes} SETS`, `BULLETS: ${J.bullets}`, `WHEELS ${J.wheel}  AXLES ${J.axle}  TONGUES ${J.tongue}`, `MONEY: $${J.money.toFixed(2)}`];\n}\n\nfunction updatePause() {\n  if (pressed(UP) || pressed(DOWN)) { pauseSel ^= 1; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0) || (pressed(A) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) { fx(SFX.select); toTitle(); }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  const trailOn = state === 'trail' || state === 'menu' || state === 'end' || state === 'title' || state === 'hunt';\n  setLayers(trailOn);\n  if (trailOn) weatherLook();\n  if (trailOn && sceneOn < 0) { if (state !== 'hunt') drawWagon(); if (J && state !== 'title') drawWeather(); }\n  if (trailOn && state !== 'title' && state !== 'hunt' && sceneOn < 0) drawHudBoard();\n  if (state === 'title') drawTitle();\n  else if (state === 'setup') drawSetup();\n  else if (state === 'store') drawStore();\n  else if (state === 'menu') drawMenu();\n  else if (state === 'hunt') drawHunt();\n  else if (state === 'float') drawFloat();\n  else if (state === 'end') drawEnd();\n  else if (state === 'records') drawRecords();\n  if (card) drawCard();\n  if (paused) drawPause();\n}\n\n/** The layers (spec 12): on the trail BG2 the far hills, BG1 the near, BG0 the ground, scrolled at their own speeds (parallax); on the\n * title BG2 is the logo; at a landmark with a scene, BG2 shows the scene (from the ROM) and the others hide. */\nfunction setLayers(trailOn) {\n  const lg = ART.scenes.logo, fr = ART.scenes.far;\n  if (sceneOn >= 0) {\n    bg(0, { show: false }); bg(1, { show: false });\n    bg(2, { mx: SCENE_MAP[0], my: SCENE_MAP[1], mw: 32, mh: 19, x: 0, y: 0, wrap: false, show: true });\n    return;\n  }\n  bg(0, { show: trailOn }); bg(1, { show: trailOn });\n  if (state === 'title') bg(2, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -24, wrap: false, show: true });\n  else bg(2, { mx: fr.mx, my: fr.my, mw: fr.w, mh: fr.h, x: scroll >> 3, y: 0, wrap: true, show: trailOn });\n  bgscroll(1, (scroll * 3) >> 3, 0); bgscroll(0, scroll, 0);\n}\n/** The wagon and the oxen: their frames go round while the wagon rolls. */\nfunction drawWagon() {\n  const rolling = state === 'trail' && !card && !paused, f = rolling ? (scroll >> 3) & 3 : 0;\n  bigSprite(ART.big[ART.anims.wagon[f]], 92, 108, { prio: 3 });\n  bigSprite(ART.big[ART.anims.oxen[rolling ? (scroll >> 2) & 3 : 0]], 144, 114, { prio: 3 });\n}\n\n// --- The landmark scenes (art.py: rom/scenes.bin): one at a time, its tiles into the reserved block from SCENE_BASE, its map into Map RAM\n// at SCENE_MAP, its colours into BG palette 5. ---\nconst SCENE_BASE = 800, SCENE_MAP = [128, 32], SCENE_OF = { 'CHIMNEY ROCK': 0 };\nlet sceneOn = -1, sceneLoaded = -1;\nfunction loadScene(k) {\n  const b = rom('scenes'); let o = 1;\n  for (let i = 0; i < k; i++) { const n = b[o + 30] | (b[o + 31] << 8); o += 32 + n * 32 + 32 * 19 * 2; }\n  for (let i = 0; i < 15; i++) { const v = b[o + i * 2] | (b[o + i * 2 + 1] << 8); color(81 + i, v & 31, (v >> 5) & 31, v >> 10); }\n  o += 30; const n = b[o] | (b[o + 1] << 8); o += 2;\n  for (let t = 0; t < n; t++) {\n    const tn = SCENE_BASE + t, x0 = (tn % 16) * 8, y0 = (tn >> 4) * 8;\n    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x += 2) { const v = b[o++]; sset(x0 + x, y0 + y, v & 15); sset(x0 + x + 1, y0 + y, v >> 4); }\n  }\n  for (let i = 0; i < 32 * 19; i++) {\n    const v = b[o + i * 2] | (b[o + i * 2 + 1] << 8), t = v & 1023;\n    mset(SCENE_MAP[0] + (i % 32), SCENE_MAP[1] + ((i / 32) | 0), t ? tile(SCENE_BASE + t - 1, 5, !!(v & (1 << 13)), !!(v & (1 << 14))) : 0);\n  }\n  sceneLoaded = k;\n}\nfunction showScene(name) { const k = SCENE_OF[name]; if (k === undefined) return; if (sceneLoaded !== k) loadScene(k); sceneOn = k; }\n\n// --- The weather you can see, and the season (spec 5.2): rain, snow and fog on the overlay, grey clouds and a dimmer sky in bad weather,\n// the grass browning through the autumn. The colours are set from the art's own (kept at the start). ---\nconst FOG = 201, CLOUD0 = 52, GRASS0 = 17;\nlet baseCols = null, skyDim = 1;\nfunction weatherLook() {\n  if (!baseCols) { baseCols = {}; for (let e = 16; e < 64; e++) baseCols[e] = color(e); color(FOG, 26, 27, 28); }\n  const w = J ? J.weather : 3, bad = w >= 6 && w <= 10;\n  skyDim = w === 7 || w === 9 ? 0.6 : bad ? 0.8 : 1;\n  for (let i = 0; i < 3; i++) { const v = baseCols[CLOUD0 + i], g = Math.round((v[0] + v[1] + v[2]) / 3 * 0.75); color(CLOUD0 + i, ...(bad ? [g, g, g + 1] : v)); }\n  const m = J ? J.month : 4, autumn = clamp((m - 7) / 3, 0, 1), snow = w === 8 || w === 9 ? 0.5 : 0;   // September to November: towards straw\n  for (let i = 0; i < 4; i++) { const v = baseCols[GRASS0 + i]; color(GRASS0 + i, ...v.map((c, k) => Math.round(lerp(lerp(c, [24, 20, 10][k] * (0.6 + 0.15 * i), autumn * 0.7), 28, snow)))); }\n}\nfunction drawWeather() {\n  const w = J.weather;\n  if (w === 6 || w === 7) for (let k = 0; k < (w === 7 ? 70 : 35); k++) { const x = (hash(k) + clock * 2) % 280 - 12, y = (hash(k * 7) + clock * 6) % 152; line(x, y, x - 2, y + 5, DIM); }\n  if (w === 8 || w === 9) for (let k = 0; k < (w === 9 ? 80 : 40); k++) { const x = (hash(k) + clock + Math.round(3 * Math.sin((clock + k * 9) / 20))) % 256, y = (hash(k * 7) + clock) % 152; pset(x, y, WHITE); }\n  if (w === 10) rectfill(0, 20, 256, 132, FOG);\n}\nconst hash = (k) => (Math.imul(k + 1, 2654435761) >>> 0) % 997;\n\nfunction drawHudBoard() {\n  rectfill(0, 152, 256, 72, BOARD); for (let y = 160; y < 224; y += 16) line(0, y, 255, y, BROWN);\n  rect(0, 152, 256, 72, 1); rectfill(0, 152, 256, 2, SOLID);\n  const k = nextMark(J), to = markMile(J, k) - J.mile;\n  txt(dateText(J), 8, 158, WHITE); txt(WEATHERS[J.weather], 248 - WEATHERS[J.weather].length * 8, 158, CYAN);\n  txt(`HEALTH: ${healthWord(J)}`, 8, 172, healthWord(J) === 'GOOD' ? GREEN : healthWord(J) === 'FAIR' ? GOLD : RED);\n  txt(`FOOD: ${J.food} LB`, 8, 184, J.food < 100 ? RED : WHITE);\n  txt(`NEXT: ${TRAIL[k].name}`, 8, 196, WHITE); txt(`${to} MILES`, 8, 208, DIM);\n  const tm = `${J.mile} MI`; txt(tm, 248 - tm.length * 8, 208, GOLD);\n  txt(`${PACES[J.pace].name}`, 248 - PACES[J.pace].name.length * 8, 184, DIM);\n  if (state === 'trail' && (clock >> 5) & 1) txt('A: STOP', 248 - 56, 196, DIM);\n}\n\nfunction drawTitle() {\n  ['NEW JOURNEY', 'TOP 10'].forEach((s, i) => txt(`${i === sel ? '> ' : '  '}${s}`, 80, 168 + i * 14, i === sel ? WHITE : DIM));   // under the trail, clear of the wagon\n}\nfunction drawSetup() {\n  panel(8, 16, 240, 192);\n  ctxt(setup.step === 0 ? 'WHO LEADS THE PARTY?' : 'WHEN DO YOU SET OUT?', 26, GOLD);\n  if (setup.step === 0) BACKGROUNDS.forEach((b, i) => { const y = 52 + i * 34, on = i === setup.bg; txt(`${on ? '>' : ' '} A ${b.name}`, 24, y, on ? WHITE : DIM); txt(`$${b.money}, ${b.gift}`, 40, y + 11, on ? GOLD : DIM); txt(`SCORE X${b.mult}`, 40, y + 21, DIM); });\n  else START_MONTHS.forEach((m, i) => txt(`${i === setup.month ? '> ' : '  '}${MONTHS[m]}`, 72, 52 + i * 14, i === setup.month ? WHITE : DIM));\n  ctxt('A: CHOOSE   B: BACK', 192, DIM);\n}\nfunction drawStore() {\n  panel(4, 4, 248, 216);\n  ctxt(J.mile === 0 ? 'THE STORE AT INDEPENDENCE' : `${TRAIL[J.next - 1].name}'S STORE`, 12, GOLD);\n  GOODS.forEach((g, i) => {\n    const y = 32 + i * 18, on = i === sel;\n    txt(`${on ? '>' : ' '} ${g.name}`, 10, y, on ? WHITE : DIM);\n    txt(`$${(g.price * storeMult).toFixed(2)} ${g.unit}`, 26, y + 9, DIM);\n    const n = `${J[g.key] + cart[g.key] * (g.per || 1)}`; txt(n, 200 - n.length * 8, y, cart[g.key] ? GOLD : WHITE);\n    if (on) txt('< >', 208, y, GOLD);\n  });\n  const y = 32 + GOODS.length * 18 + 4;\n  txt(`${sel === GOODS.length ? '>' : ' '} LEAVE THE STORE`, 10, y, sel === GOODS.length ? WHITE : DIM);\n  txt(`BILL $${cartCost().toFixed(2)}`, 10, 196, WHITE); const m = `YOU HAVE $${(J.money - cartCost()).toFixed(2)}`; txt(m, 246 - m.length * 8, 196, GOLD);\n}\nfunction drawMenu() {\n  panel(16, 12, 224, 136);\n  ctxt(`${TRAIL[nextMark(J)].name}: ${markMile(J, nextMark(J)) - J.mile} MI`, 20, GOLD);\n  MENU.forEach((s, i) => txt(`${i === sel ? '> ' : '  '}${s}`, 28, 40 + i * 14, i === sel ? WHITE : DIM));\n}\n/** The hunt: the animals over the trail's layers, the aim, a flash for a shot, the meat rising from a kill; the board below. */\nfunction drawHunt() {\n  const h = hunt;\n  for (const a of h.animals) {\n    if (a.dead && (a.dead >> 2) & 1) continue;                   // a kill blinks out\n    const f = a.dead ? 0 : (a.t >> (BIG[a.kind] ? 3 : 2)) & 1, flip = a.dir < 0;\n    if (BIG[a.kind]) bigSprite(ART.big[ART.anims[a.kind][f]], Math.round(a.x), a.y, { fx: flip, prio: 3 });\n    else sprite(ART.sprites[a.kind + f], Math.round(a.x), a.y, { fx: flip });\n  }\n  const [ax, ay] = h.aim;                                           // the aim, on the overlay above the animals\n  for (const [c, o] of [[SHADOW, 1], [WHITE, 0]]) { line(ax - 7 + o, ay + o, ax - 3 + o, ay + o, c); line(ax + 3 + o, ay + o, ax + 7 + o, ay + o, c); line(ax + o, ay - 7 + o, ax + o, ay - 3 + o, c); line(ax + o, ay + 3 + o, ax + o, ay + 7 + o, c); }\n  pset(ax, ay, RED);\n  if (h.flash) circ(ax, ay, 9 - h.flash, GOLD);\n  for (const p of h.pops) txt(`+${p.n}`, Math.round(p.x) - 8, Math.round(p.y - p.t / 3), GOLD);\n  rectfill(0, 152, 256, 72, BOARD); for (let y = 160; y < 224; y += 16) line(0, y, 255, y, BROWN);\n  rect(0, 152, 256, 72, 1); rectfill(0, 152, 256, 2, SOLID);\n  const left = Math.max(0, Math.ceil((HUNT_FRAMES - timer) / 60));\n  txt('THE HUNT', 8, 158, GOLD); const t = `TIME ${left}`; txt(t, 248 - t.length * 8, 158, left <= 5 ? RED : WHITE);\n  txt(`MEAT: ${h.meat} LB`, 8, 174, h.meat > CARRY ? GOLD : WHITE); const b = `BULLETS: ${J.bullets}`; txt(b, 248 - b.length * 8, 174, J.bullets ? WHITE : RED);\n  txt(`YOU CAN CARRY ${CARRY} LB BACK`, 8, 190, DIM);\n  txt('A: SHOOT   B: STOP', 8, 206, DIM);\n}\n/** The float, from above, on the overlay: the water and its ripples, the banks, eddies, rocks, and the caulked wagon. */\nfunction drawFloat() {\n  const f = flt;\n  rectfill(0, 0, 256, 152, WATER);\n  for (let k = 0; k < 40; k++) { const x = hash(k) % 256, y = (hash(k * 5) + f.dist) % 160 - 4; line(x, y, x + 4 + (k & 3), y, WATER2); }\n  for (let y = 0; y < 152; y += 2) { const [l, r] = banks(f, y); rectfill(0, y, Math.round(l), 2, BANK); rectfill(Math.round(r), y, 256, 2, BANK); rectfill(Math.round(l) - 3, y, 3, 2, BANK2); rectfill(Math.round(r), y, 3, 2, BANK2); }\n  for (const e of f.eddies) { circ(Math.round(e.x), Math.round(e.y), e.r, WATER2); circ(Math.round(e.x), Math.round(e.y), e.r - 5, WATER2); }\n  for (const o of f.rocks) { circfill(Math.round(o.x), Math.round(o.y), o.r, ROCK); circfill(Math.round(o.x) - 2, Math.round(o.y) - 2, o.r - 3, ROCK2); line(Math.round(o.x) - o.r, Math.round(o.y) + o.r - 1, Math.round(o.x) + o.r, Math.round(o.y) + o.r - 1, WATER2); }\n  if (!(f.hurt && (f.hurt >> 2) & 1)) {\n    const x = Math.round(f.x) - 6, y = FLOAT_Y - 10;\n    rectfill(x - 1, y + 1, 14, 20, WOOD); rectfill(x + 1, y, 10, 20, CANVAS);\n    for (let k = 3; k < 20; k += 5) line(x + 1, y + k, x + 10, y + k, BANK2);\n    line(x + 2, y + 21 + (clock >> 3 & 1), x + 9, y + 21 + (clock >> 3 & 1), WATER2);   // the wake\n  }\n  rectfill(0, 152, 256, 72, BOARD); for (let y = 160; y < 224; y += 16) line(0, y, 255, y, BROWN);\n  rect(0, 152, 256, 72, 1); rectfill(0, 152, 256, 2, SOLID);\n  txt(f.title, 8, 158, GOLD);\n  txt('ACROSS', 8, 176, DIM); rect(64, 176, 176, 8, BROWN); rectfill(65, 177, Math.round(174 * Math.min(1, timer / f.frames)), 6, CYAN);\n  txt(`ROCKS STRUCK: ${f.hits}`, 8, 192, f.hits ? RED : WHITE);\n  txt('LEFT/RIGHT: STEER', 8, 208, DIM);\n}\nfunction drawEnd() {\n  panel(16, 24, 224, 120);\n  if (J.arrived) {\n    ctxt('YOU HAVE REACHED', 34, WHITE); ctxt('THE WILLAMETTE VALLEY!', 46, GOLD);\n    ctxt(`${alive(J).length} OF 5 MADE IT, ${dateText(J)}`, 66, WHITE);\n    ctxt(`SCORE ${J.score}`, 86, GOLD);\n    if (rank >= 0) ctxt(`TOP 10: #${rank + 1}`, 100, CYAN);\n  } else { ctxt('THE WHOLE PARTY', 50, WHITE); ctxt('HAS DIED ON THE TRAIL.', 62, RED); ctxt(`${J.mile} MILES FROM INDEPENDENCE`, 82, DIM); }\n  if (timer > 60 && (clock >> 5) & 1) ctxt('A: CONTINUE', 124, DIM);\n}\nfunction drawRecords() {\n  panel(16, 16, 224, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => { const y = 44 + i * 14; txt(String(i + 1).padStart(2), 28, y, DIM); txt(e.score ? e.name : '---', 56, y, WHITE); if (e.score) { const s = String(e.score); txt(s, 228 - s.length * 8, y, GOLD); } });\n}\nfunction drawCard() {\n  const c = card, h = 34 + c.lines.length * 11 + (c.choices ? c.choices.length * 12 + 6 : 12);\n  const y0 = sceneOn >= 0 ? 224 - h - 4 : Math.max(4, 76 - (h >> 1));   // under a landmark's scene, at the foot of the screen\n  panel(8, y0, 240, h);\n  ctxt(c.title, y0 + 8, GOLD);\n  c.lines.forEach((l, i) => ctxt(l, y0 + 24 + i * 11, WHITE));\n  const yc = y0 + 28 + c.lines.length * 11;\n  if (c.choices) c.choices.forEach((s, i) => txt(`${i === c.sel ? '> ' : '  '}${s}`, 20, yc + i * 12, i === c.sel ? WHITE : DIM));\n  else if ((clock >> 4) & 1) ctxt('A', yc, DIM);\n}\nfunction drawPause() {\n  panel(56, 80, 144, 48);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 68, 104 + i * 11, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SOLID); rect(x, y, w, h, GOLD); rect(x + 2, y + 2, w - 4, h - 4, BROWN); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky's colour (the SNES did its skies this way, with HDMA). */\nfunction scanline(y) {\n  const v = ART.gradients.sky.lines[y];\n  if (v !== undefined) color(0, flr((v & 31) * skyDim), flr(((v >> 5) & 31) * skyDim), flr((v >> 10) * skyDim));   // dimmer under rain and snow\n}\n",

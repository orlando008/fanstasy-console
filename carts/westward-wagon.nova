{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Westward Wagon",
    "author": "NOVA-16",
    "description": "Lead a wagon party of five from Missouri to the Willamette Valley in 1848: buy supplies, set the pace and the rations, ford the rivers, hunt and trade along the way, and choose wisely, for not everyone makes it. Real landmarks, period folk tunes, a diary of the journey and the graves of earlier parties on the trail."
  },
  "label": null,
  "code": "// Westward Wagon (docs/carts/westward-wagon.md)\n// An original wagon-trail game: a party of five from Independence, Missouri, to the Willamette Valley in 1848. The journey is a set of pure\n// functions on one object (J): a day's travel, the food, the health, the weather, the landmarks; the screens drive them.\n\n// --- Colours: the default palette's overlay colours (the overlay's index 0 is transparent) ---\n\nconst SHADOW = 1, PANEL = 3, BROWN = 4, RED = 6, ORANGE = 9, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15, SOLID = 113, BOARD = 114;\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"gem\": {\"pal\": 1, \"size\": 16, \"tile\": 324}, \"hero0\": {\"pal\": 0, \"size\": 32, \"tile\": 256}, \"hero1\": {\"pal\": 0, \"size\": 32, \"tile\": 260}, \"hero2\": {\"pal\": 0, \"size\": 32, \"tile\": 264}, \"hero3\": {\"pal\": 0, \"size\": 32, \"tile\": 268}, \"hero4\": {\"pal\": 0, \"size\": 32, \"tile\": 320}},\n  scenes: {\"field\": {\"h\": 8, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hills\": {\"h\": 8, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"logo\": {\"h\": 3, \"mx\": 0, \"my\": 16, \"pal\": 3, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[13475,13475,13475,13475,13475,13475,13475,14499,14499,14531,14531,14532,14532,14532,14532,14532,14532,15556,15556,15556,15556,15556,15588,15588,15588,15588,15588,16612,16612,16612,16612,16612,16612,16612,16645,16645,16645,17669,17669,17669,17669,17669,17669,17669,17669,17669,18725,18725,18725,18725,18725,18725,18725,18725,18725,19749,19750,19750,19782,19782,19782,19782,19782,19782,19782,20806,20806,20806,20806,20806,20838,20838,20838,20838,21862,21862,21862,21863,21863,21863,21863,21863,21895,22919,22919,22919,22919,22919,22919,22919,22919,22951,22952,22952,23976,23976,23976,23976,24008,24008,24009,24009,24009,24009,24041,24041,25065,25065,25066,25066,25066,25098,25098,25098,25098,25099,25099,25131,26155,26155,26155,26155,26155,26156,26188,26188,26188,26188,26188,26188,27245,27245,27245,27245,27245,27245,27245,27278,27278,27278,27278,27278,28302,28334,28335,28335,28335,28335,28335,28335,28367,28368,28368,28368,28368,29392,29424,29424,29425,29425,29425,29425,29457,29457,29457,29458,29458,29458,30482,30514,30514,30514,30515,30515,30515,30547],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n/** Queue one of ART.sprites at (x, y); opts as for spr. */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5): songs on channels 0 to 5, effects take turns on 6 and 7 ---\n\nconst SFX = { move: 0, select: 1, pause: 2, bad: 3, over: 4, good: 5, record: 6 };\nconst SONG = { title: 0, trail: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- The journey's rules (spec section 5) ---\n\nconst BACKGROUNDS = [\n  { name: 'BANKER', money: 1600, mult: 1, gift: 'MORE MONEY' },\n  { name: 'CARPENTER', money: 800, mult: 2, gift: 'MENDS THE WAGON' },\n  { name: 'FARMER', money: 400, mult: 3, gift: 'OXEN TIRE LESS' },\n];\nconst MONTHS = ['JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE', 'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'];\nconst MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nconst START_MONTHS = [2, 3, 4, 5, 6, 7];                          // March to August\n// The store (5.1): the price, the unit, the most you can have.\nconst GOODS = [\n  { key: 'oxen', name: 'OXEN', unit: 'YOKE', price: 40, step: 1, max: 9 },\n  { key: 'food', name: 'FOOD', unit: 'LB', price: 0.2, step: 50, max: 2000 },\n  { key: 'clothes', name: 'CLOTHING', unit: 'SET', price: 10, step: 1, max: 40 },\n  { key: 'bullets', name: 'AMMUNITION', unit: 'BOX OF 20', price: 2, step: 1, max: 50 },\n  { key: 'wheel', name: 'SPARE WHEEL', unit: '', price: 10, step: 1, max: 3 },\n  { key: 'axle', name: 'SPARE AXLE', unit: '', price: 10, step: 1, max: 3 },\n  { key: 'tongue', name: 'SPARE TONGUE', unit: '', price: 10, step: 1, max: 3 },\n];\nconst PACES = [{ name: 'STEADY', miles: 15, cost: 0 }, { name: 'STRENUOUS', miles: 19, cost: 0.5 }, { name: 'GRUELING', miles: 24, cost: 1.5 }];   // miles a day (history: 15 to 20) and health a day\nconst RATIONS = [{ name: 'FILLING', lb: 3, cost: 0 }, { name: 'MEAGER', lb: 2, cost: 0.4 }, { name: 'BARE BONES', lb: 1, cost: 1.2 }];\nconst STARVING = 4, REST_GAIN = 3, EASY_GAIN = 0.6, RECOVER = 0.12, RECOVER_REST = 0.3;   // health points a day (5.2); the chance a day an illness passes\n// The trail (spec section 6): the mile, the name, the kind, and for a river its width (ft) and depth (ft) in spring, for a fort its prices.\n// A fork's route: 0 the main trail, 1 the first choice's branch, 2 the second's.\nconst TRAIL = [\n  { mile: 0, name: 'INDEPENDENCE', kind: 'town' },\n  { mile: 102, name: 'KANSAS RIVER', kind: 'river', width: 620, depth: 3.6, ferry: 5 },\n  { mile: 185, name: 'BIG BLUE RIVER', kind: 'river', width: 210, depth: 2.2 },\n  { mile: 304, name: 'FORT KEARNEY', kind: 'fort', prices: 1.25 },\n  { mile: 554, name: 'CHIMNEY ROCK', kind: 'sight' },\n  { mile: 640, name: 'FORT LARAMIE', kind: 'fort', prices: 1.4 },\n  { mile: 830, name: 'INDEPENDENCE ROCK', kind: 'sight' },\n  { mile: 932, name: 'SOUTH PASS', kind: 'fork', choices: ['FORT BRIDGER', 'THE SUBLETTE CUTOFF'] },\n  { mile: 1057, name: 'FORT BRIDGER', kind: 'fort', prices: 1.5, route: 1 },\n  { mile: 989, name: 'GREEN RIVER', kind: 'river', width: 400, depth: 3.2, ferry: 10, route: 2 },\n  { mile: 1151, name: 'SODA SPRINGS', kind: 'sight' },\n  { mile: 1208, name: 'FORT HALL', kind: 'fort', prices: 1.6 },\n  { mile: 1390, name: 'SNAKE RIVER', kind: 'river', width: 1000, depth: 6.4 },\n  { mile: 1504, name: 'FORT BOISE', kind: 'fort', prices: 2 },\n  { mile: 1600, name: 'BLUE MOUNTAINS', kind: 'sight' },\n  { mile: 1800, name: 'THE DALLES', kind: 'fork', choices: ['RAFT DOWN THE COLUMBIA', 'THE BARLOW ROAD'] },\n  { mile: 2040, name: 'WILLAMETTE VALLEY', kind: 'end' },\n];\nconst CUTOFF_SAVES = 68, BARLOW_TOLL = 30, BARLOW_DAYS = 10;\n/** The region at a mile (5.2's terrain and the art's layers): 0 prairie, 1 bluffs, 2 mountains, 3 high desert, 4 forest. */\nconst regionAt = (m) => (m < 500 ? 0 : m < 820 ? 1 : m < 1150 ? 2 : m < 1560 ? 3 : 4);\nconst TERRAIN = [1, 0.9, 0.6, 0.85, 0.75];\nconst WEATHERS = ['VERY HOT', 'HOT', 'WARM', 'COOL', 'COLD', 'VERY COLD', 'RAIN', 'HEAVY RAIN', 'SNOW', 'HEAVY SNOW', 'FOG'];\nconst WEATHER_MILES = [1, 1, 1, 1, 1, 0.9, 0.7, 0.5, 0.7, 0.3, 0.8];\nconst COLD = [0, 0, 0, 0, 1, 2, 0, 0, 2, 3, 0];                    // how cold each weather is (clothing needed)\nconst HEAT = [1, 0.3, 0, 0, 0, 0, 0, 0, 0, 0, 0];\n\n/** A new journey: the background, the month (0 to 11), the party's names. */\nfunction newJourney(bg, month, names) {\n  return {\n    bg, money: BACKGROUNDS[bg].money, month, day: 1, mile: 0, next: 1, route: 0, days: 0,\n    oxen: 0, food: 0, clothes: 0, bullets: 0, wheel: 0, axle: 0, tongue: 0,\n    pace: 0, rations: 0, weather: 3, party: names.map((name) => ({ name, health: 100, ill: 0, alive: true })),\n    done: false, arrived: false, log: [],\n  };\n}\nconst alive = (J) => J.party.filter((p) => p.alive);\n/** The party's health in words (5.1): good, fair, poor, very poor, from the average of those alive. */\nfunction healthWord(J) {\n  const a = alive(J); if (!a.length) return 'GONE';\n  const h = a.reduce((s, p) => s + p.health, 0) / a.length;\n  return h >= 70 ? 'GOOD' : h >= 50 ? 'FAIR' : h >= 30 ? 'POOR' : 'VERY POOR';\n}\nconst dateText = (J) => `${MONTHS[J.month]} ${J.day}, 1848`;\n/** The next landmark on this route, from J.next on. */\nfunction nextMark(J) { for (let k = J.next; k < TRAIL.length; k++) if (!TRAIL[k].route || TRAIL[k].route === J.route) return k; return TRAIL.length - 1; }\n/** A landmark's mile on this route (the cutoff saves some). */\nconst markMile = (J, k) => TRAIL[k].mile - (J.route === 2 && TRAIL[k].mile > 989 ? CUTOFF_SAVES : 0);\n/** The weather for a month and region: warm in summer, cold at the ends of the year and in the mountains; rain in spring, snow in winter. */\nfunction rollWeather(month, region) {\n  const temp = [5, 5, 4, 3, 2, 1, 0, 0, 2, 3, 4, 5][month] + (region === 2 ? 1 : 0);\n  const r = rnd(1);\n  if (r < 0.12) return temp >= 4 ? (rnd(1) < 0.3 ? 9 : 8) : rnd(1) < 0.3 ? 7 : 6;   // rain, or snow when it is cold\n  if (r < 0.15) return 10;\n  return clamp(temp, 0, 5);\n}\nfunction advanceDate(J) {\n  J.days++; J.day++;\n  if (J.day > MONTH_DAYS[J.month]) { J.day = 1; J.month = (J.month + 1) % 12; }\n}\n/** One person's day (5.2): the pace, the rations (or none), the weather against the clothing, an illness; rest or an easy day heals. */\nfunction personDay(J, p, resting, starving) {\n  let loss = 0, gain = 0;\n  if (!resting) loss += PACES[J.pace].cost;\n  loss += starving ? STARVING : RATIONS[J.rations].cost;\n  const sets = J.clothes / Math.max(1, alive(J).length);\n  loss += COLD[J.weather] * (sets >= 2 ? 0 : sets >= 1 ? 0.7 : 1.5) + HEAT[J.weather];      // the cold, for want of two sets of clothing each\n  if (p.ill) loss += ILLS[p.ill].hurt;\n  if (resting) gain += REST_GAIN + (J.rations === 0 && !starving ? 1 : 0);\n  else if (J.pace === 0 && J.rations === 0 && !p.ill && !starving) gain += EASY_GAIN;\n  p.health = clamp(Math.round((p.health - loss + gain) * 10) / 10, 0, 100);\n  if (p.ill && rnd(1) < (resting ? RECOVER_REST : RECOVER)) { J.log.push(`${p.name} IS BETTER.`); p.ill = 0; }\n  if (p.health <= 0) { p.alive = false; J.log.push(`${p.name} HAS DIED.`); return true; }\n  return false;\n}\nconst ILLS = [null, { name: 'DYSENTERY', hurt: 2.5 }, { name: 'CHOLERA', hurt: 4 }, { name: 'MEASLES', hurt: 2 }, { name: 'TYPHOID', hurt: 3 }, { name: 'EXHAUSTION', hurt: 1.5 }, { name: 'A FEVER', hurt: 2 }, { name: 'A BROKEN ARM', hurt: 1 }, { name: 'A BROKEN LEG', hurt: 1.5 }, { name: 'A SNAKEBITE', hurt: 2.5 }];\n/** One day (5.2): the weather, the miles (unless resting), the food, each person's health, maybe an illness. Returns what happened:\n * { miles, arrived: the landmark reached, or -1, died: [names], ill: ['MARY HAS DYSENTERY.'] }. */\nfunction dayOnTrail(J, resting = false) {\n  J.weather = rollWeather(J.month, regionAt(J.mile));\n  const out = { miles: 0, arrived: -1, died: [], ill: [] };\n  if (!resting) {\n    const yoke = J.oxen < 2 ? 0.5 : 1 + 0.05 * (J.oxen - 2) * (J.bg === 2 ? 1.2 : 1);\n    let miles = Math.round(PACES[J.pace].miles * yoke * TERRAIN[regionAt(J.mile)] * WEATHER_MILES[J.weather]);\n    if (J.oxen <= 0) miles = 0;\n    const k = nextMark(J), to = markMile(J, k);\n    if (J.mile + miles >= to) { miles = to - J.mile; out.arrived = k; }\n    J.mile += miles; out.miles = miles;\n  }\n  const need = RATIONS[J.rations].lb * alive(J).length, starving = J.food < need;\n  J.food = Math.max(0, J.food - need);\n  for (const p of alive(J)) {\n    if (!p.ill && rnd(1) < illChance(J, p, resting)) { p.ill = rndi(1, ILLS.length - 1); out.ill.push(`${p.name} HAS ${ILLS[p.ill].name}.`); J.log.push(`${p.name} HAS ${ILLS[p.ill].name}.`); }\n    if (personDay(J, p, resting, starving)) out.died.push(p.name);\n  }\n  advanceDate(J);\n  if (!alive(J).length) J.done = true;\n  return out;\n}\n/** The chance a well person falls ill today: more with a hard pace, poor rations, poor health and cold. */\nconst illChance = (J, p, resting) => 0.006 * (1 + J.pace + J.rations + (p.health < 50 ? 2 : 0) + (COLD[J.weather] ? 1 : 0)) * (resting ? 0.5 : 1);\n/** The score on arriving (5.6). */\nfunction scoreOf(J) {\n  const words = { GOOD: 4, FAIR: 3, POOR: 2, 'VERY POOR': 1 };\n  let s = 0;\n  for (const p of alive(J)) { const h = p.health >= 70 ? 4 : p.health >= 50 ? 3 : p.health >= 30 ? 2 : 1; s += 500 * h; }\n  s += 50 + J.oxen * 4 + (J.wheel + J.axle + J.tongue) * 2 + J.clothes * 2 + Math.floor(J.bullets * 20 / 50) + Math.floor(J.food / 25) + Math.floor(J.money / 5);\n  return s * BACKGROUNDS[J.bg].mult;\n}\n/** Crossing a river (5.4, the float comes in step 4): what the depth does to a ford; caulking and floating; the ferry. */\nfunction crossRiver(J, how, river) {\n  const d = river.depth * (J.month >= 6 ? 0.7 : 1);              // lower water in late summer\n  if (how === 'ferry') { const fee = river.ferry || 0; if (J.money < fee) return 'NO MONEY FOR THE FERRY'; J.money -= fee; advanceDate(J); return 'THE FERRY TOOK YOU ACROSS.'; }\n  if (how === 'ford') {\n    if (d < 2.5) return 'YOU FORDED THE RIVER SAFELY.';\n    if (d < 3 && rnd(1) < 0.7) return 'YOU FORDED THE RIVER. IT WAS CLOSE.';\n    return loseSupplies(J, d < 3 ? 0.2 : 0.4, 'THE WAGON TIPPED IN THE RIVER.');\n  }\n  if (rnd(1) < (d < 3 ? 0.9 : 0.75)) return 'YOU FLOATED ACROSS SAFELY.';\n  return loseSupplies(J, 0.25, 'THE WAGON SWAMPED IN THE CURRENT.');\n}\nfunction loseSupplies(J, share, what) {\n  const lost = Math.floor(J.food * share); J.food -= lost; J.clothes -= Math.floor(J.clothes * share); J.bullets -= Math.floor(J.bullets * share);\n  let t = `${what} LOST ${lost} LB OF FOOD`;\n  if (rnd(1) < share) { const v = alive(J)[rndi(0, alive(J).length - 1)]; v.alive = false; t += `. ${v.name} DROWNED`; if (!alive(J).length) J.done = true; }\n  J.log.push(t + '.');\n  return t + '.';\n}\n/** The cost of buying n more of a good at a price multiplier (the forts': 5.1). */\nconst costOf = (g, n, mult = 1) => Math.round(g.price * n * mult * 100) / 100;\n\n// --- Save slots (spec section 13; the journey's save comes in step 6) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, TOP_SLOT = 100, TOP_N = 10;\nfunction topTen() { const out = []; for (let i = 0; i < TOP_N; i++) out.push({ score: dget(TOP_SLOT + i * 4), name: unpackName(dget(TOP_SLOT + i * 4 + 1), dget(TOP_SLOT + i * 4 + 2)), bg: dget(TOP_SLOT + i * 4 + 3) }); return out; }\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) { const [a, b] = packName(list[i].name); dset(TOP_SLOT + i * 4, list[i].score); dset(TOP_SLOT + i * 4 + 1, a); dset(TOP_SLOT + i * 4 + 2, b); dset(TOP_SLOT + i * 4 + 3, list[i].bg); }\n  return at;\n}\nconst CHARS = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ.-\\'';\n/** A name of up to 10 characters in two slots (5 bits each, 5 a slot... 6 in the first). */\nfunction packName(s) { const v = [0, 0]; for (let i = 0; i < 10; i++) { const c = Math.max(0, CHARS.indexOf(s[i] || ' ')); v[i >> 1 > 2 ? 1 : 0] += 0; } let a = 0, b = 0; for (let i = 0; i < 5; i++) a = a * 32 + Math.max(0, CHARS.indexOf(s[i] || ' ')); for (let i = 5; i < 10; i++) b = b * 32 + Math.max(0, CHARS.indexOf(s[i] || ' ')); return [a, b]; }\nfunction unpackName(a, b) { let s = ''; for (let i = 4; i >= 0; i--) s = CHARS[(a >> (5 * i)) & 31] + s; let t = ''; for (let i = 4; i >= 0; i--) t = CHARS[(b >> (5 * i)) & 31] + t; return (rev(s) + rev(t)).trim(); }\nconst rev = (s) => s.split('').reverse().join('');\n\n// --- Input ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst stepped = (b) => pressed(b) || (btnp(b) && (inputMask & (1 << b)) !== 0);\n\n// --- State ---\n\nlet skipTitle = false;                                              // tests set this to land straight on the trail with a stocked wagon\nlet state = 'title', paused = false, timer = 0, clock = 0, sel = 0, pauseSel = 0;\nlet J = null, setup = { bg: 0, month: 1, step: 0 }, cart = {}, storeMult = 1, card = null, dayTimer = 0, scroll = 0, rank = -1;\nconst DAY_FRAMES = 50;                                              // a day rolls by in this many frames (spec: about a second)\nconst NAMES = ['MARY', 'JOHN', 'SARAH', 'WILL', 'ELLA'];            // step 6 adds naming them\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  const f = ART.scenes.field, h = ART.scenes.hills;\n  bg(0, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, x: 0, y: -(152 - f.h * 8), wrap: true, show: true });\n  bg(1, { mx: h.mx, my: h.my, mw: h.w, mh: h.h, x: 0, y: -(152 - f.h * 8 - h.h * 8 + 8), wrap: true, show: true });\n  const lg = ART.scenes.logo;\n  bg(2, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -36, wrap: false, show: false });\n  color(SOLID, 6, 4, 2); color(BOARD, 14, 9, 5);\n  blend({ layers: ['overlay'], half: true });\n  if (skipTitle) { J = newJourney(0, 3, NAMES); Object.assign(J, { oxen: 4, food: 900, clothes: 10, bullets: 10, wheel: 1, axle: 1, tongue: 1, money: 1600 - 4 * 40 - 180 - 100 - 20 - 30 }); toTrail(); }\n  else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; sel = 0; paused = false; play(SONG.title); }\nfunction toSetup() { state = 'setup'; timer = 0; setup = { bg: 0, month: 1, step: 0 }; }\nfunction toStore(mult = 1) { state = 'store'; timer = 0; sel = 0; storeMult = mult; cart = {}; for (const g of GOODS) cart[g.key] = 0; }\nfunction toTrail() { state = 'trail'; timer = 0; paused = false; card = null; dayTimer = 0; play(SONG.trail); }\nfunction toMenu() { state = 'menu'; timer = 0; sel = 0; }\n/** A card over the trail: a title, lines, and choices (or none: A continues). then(choice) runs when one is made. */\nfunction showCard(title, lines, choices = null, then = null) { card = { title, lines, choices, then, sel: 0 }; }\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (card) updateCard();\n  else if (state === 'title') updateTitle();\n  else if (state === 'setup') updateSetup();\n  else if (state === 'store') updateStore();\n  else if (state === 'trail') updateTrail();\n  else if (state === 'menu') updateMenu();\n  else if (state === 'end') updateEnd();\n  else if (state === 'records') { if (timer > 20 && (pressed(A) || pressed(B) || pressed(START))) toTitle(); }\n  prevMask = inputMask;\n}\n\nfunction updateCard() {\n  const c = card;\n  if (c.choices) {\n    if (stepped(UP)) { c.sel = (c.sel + c.choices.length - 1) % c.choices.length; fx(SFX.move); }\n    if (stepped(DOWN)) { c.sel = (c.sel + 1) % c.choices.length; fx(SFX.move); }\n    if (pressed(A)) { fx(SFX.select); card = null; if (c.then) c.then(c.sel); }\n  } else if (pressed(A) || pressed(B)) { fx(SFX.select); card = null; if (c.then) c.then(0); }\n}\n\nfunction updateTitle() {\n  if (stepped(UP) || stepped(DOWN)) { sel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) { fx(SFX.select); if (sel === 0) toSetup(); else { state = 'records'; timer = 0; } }\n}\n\n/** The setup (spec 10): the background, then the month; the names are fixed until step 6. */\nfunction updateSetup() {\n  if (setup.step === 0) {\n    if (stepped(UP)) { setup.bg = (setup.bg + 2) % 3; fx(SFX.move); }\n    if (stepped(DOWN)) { setup.bg = (setup.bg + 1) % 3; fx(SFX.move); }\n  } else {\n    if (stepped(UP)) { setup.month = (setup.month + 5) % 6; fx(SFX.move); }\n    if (stepped(DOWN)) { setup.month = (setup.month + 1) % 6; fx(SFX.move); }\n  }\n  if (pressed(B)) { fx(SFX.move); if (setup.step) setup.step--; else toTitle(); }\n  else if (pressed(A)) {\n    fx(SFX.select);\n    if (setup.step === 0) setup.step = 1;\n    else { J = newJourney(setup.bg, START_MONTHS[setup.month], NAMES); toStore(); }\n  }\n}\n\n/** The store (5.1): UP and DOWN choose a good, LEFT and RIGHT change how many to buy, A leaves (with at least a yoke of oxen at Independence). */\nconst cartCost = () => GOODS.reduce((s, g) => s + costOf(g, cart[g.key], storeMult), 0);\nfunction updateStore() {\n  const n = GOODS.length + 1;\n  if (stepped(UP)) { sel = (sel + n - 1) % n; fx(SFX.move); }\n  if (stepped(DOWN)) { sel = (sel + 1) % n; fx(SFX.move); }\n  if (sel < GOODS.length) {\n    const g = GOODS[sel], have = J[g.key] + cart[g.key];\n    if (stepped(RIGHT) && have + g.step <= g.max && cartCost() + costOf(g, g.step, storeMult) <= J.money + 1e-9) { cart[g.key] += g.step; fx(SFX.move); }\n    if (stepped(LEFT) && cart[g.key] > 0) { cart[g.key] -= g.step; fx(SFX.move); }\n  }\n  if (pressed(A) && sel === GOODS.length || pressed(START)) {\n    if (J.mile === 0 && J.oxen + cart.oxen < 1) { fx(SFX.bad); showCard('THE STORE', ['YOU NEED AT LEAST ONE YOKE', 'OF OXEN TO PULL THE WAGON.']); return; }\n    J.money = Math.round((J.money - cartCost()) * 100) / 100;\n    for (const g of GOODS) J[g.key] += cart[g.key] * (g.key === 'bullets' ? 1 : 1);\n    fx(SFX.select); toTrail();\n  } else if (pressed(B) && J.mile > 0) { fx(SFX.move); toTrail(); }\n}\n\n/** The trail: a day every DAY_FRAMES frames; A stops for the menu; landmarks and deaths stop the wagon with a card. */\nfunction updateTrail() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(A)) { fx(SFX.select); toMenu(); return; }\n  scroll += 1;\n  if (++dayTimer < DAY_FRAMES) return;\n  dayTimer = 0;\n  travel(false);\n}\n/** A day's travel, then what it brings: deaths, illness, the landmark reached, the end. */\nfunction travel(resting) {\n  const out = dayOnTrail(J, resting), lines = [];\n  for (const n of out.died) lines.push(`${n} HAS DIED.`);\n  for (const t of out.ill) if (!out.died.some((n) => t.startsWith(n + ' '))) lines.push(t);   // the illness as it struck (it may have passed by the evening)\n  const after = () => { if (J.done) return endJourney(); if (out.arrived >= 0) reach(out.arrived); };\n  if (lines.length) { fx(out.died.length ? SFX.over : SFX.bad); showCard(dateText(J), lines, null, after); }\n  else after();\n  return out;\n}\n/** Reaching a landmark (5.3 to 5.4): its card; a river asks how to cross, a fork which way, a fort offers its store, the end ends. */\nfunction reach(k) {\n  const m = TRAIL[k]; J.next = k + 1; fx(SFX.good);\n  J.log.push(`REACHED ${m.name}.`);\n  if (m.kind === 'end') { J.arrived = true; J.done = true; return endJourney(); }\n  if (m.kind === 'river') {\n    const d = (m.depth * (J.month >= 6 ? 0.7 : 1)).toFixed(1);\n    const choices = ['FORD THE RIVER', 'CAULK THE WAGON AND FLOAT'].concat(m.ferry ? [`TAKE THE FERRY ($${m.ferry})`] : []).concat(['WAIT A DAY']);\n    const ask = () => showCard(m.name, [`${m.width} FEET ACROSS, ${d} FEET DEEP.`], choices, (c) => {\n      const how = ['ford', 'float', m.ferry ? 'ferry' : 'wait', 'wait'][c];\n      if (how === 'wait') { dayOnTrail(J, true); return ask(); }\n      const r = crossRiver(J, how, m); fx(/LOST|DROWN|NO MONEY/.test(r) ? SFX.bad : SFX.good);\n      if (/NO MONEY/.test(r)) return showCard(m.name, [r], null, ask);\n      showCard(m.name, [r], null, () => { if (J.done) endJourney(); });\n    });\n    return ask();\n  }\n  if (m.kind === 'fork') {\n    return showCard(m.name, ['THE TRAIL DIVIDES.'], m.choices, (c) => {\n      if (m.name === 'SOUTH PASS') J.route = c + 1;\n      else if (c === 1) { J.money = Math.max(0, J.money - BARLOW_TOLL); for (let d = 0; d < BARLOW_DAYS; d++) dayOnTrail(J, true); J.log.push('TOOK THE BARLOW ROAD.'); }\n      else J.log.push('RAFTED DOWN THE COLUMBIA.');\n    });\n  }\n  if (m.kind === 'fort') return showCard(m.name, ['A FORT, WITH A STORE.'], ['GO ON', 'BUY SUPPLIES'], (c) => { if (c === 1) toStore(m.prices); });\n  showCard(m.name, ['A LANDMARK ON THE TRAIL.']);\n}\nfunction endJourney() {\n  state = 'end'; timer = 0; card = null;\n  const sc = J.arrived ? scoreOf(J) : 0;\n  rank = J.arrived ? insertTop({ score: sc, name: J.party[0].name, bg: J.bg }) : -1;\n  J.score = sc; fx(J.arrived ? SFX.record : SFX.over);\n}\nfunction updateEnd() { if (timer > 60 && (pressed(A) || pressed(START))) { fx(SFX.select); state = 'records'; timer = 0; } }\n\n/** The menu (spec 4): continue, supplies, pace, rations, rest. */\nconst MENU = ['CONTINUE ON THE TRAIL', 'CHECK SUPPLIES', 'CHANGE PACE', 'CHANGE RATIONS', 'STOP TO REST'];\nfunction updateMenu() {\n  if (stepped(UP)) { sel = (sel + MENU.length - 1) % MENU.length; fx(SFX.move); }\n  if (stepped(DOWN)) { sel = (sel + 1) % MENU.length; fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.move); toTrail(); return; }\n  if (!pressed(A)) return;\n  fx(SFX.select);\n  if (sel === 0) toTrail();\n  else if (sel === 1) showCard('SUPPLIES', supplyLines());\n  else if (sel === 2) showCard('PACE', ['HOW FAST TO GO.'], PACES.map((p) => p.name), (c) => { J.pace = c; });\n  else if (sel === 3) showCard('RATIONS', ['HOW MUCH TO EAT.'], RATIONS.map((r) => r.name), (c) => { J.rations = c; });\n  else showCard('REST', ['HOW MANY DAYS?'], ['1 DAY', '3 DAYS', '5 DAYS'], (c) => { const n = [1, 3, 5][c]; for (let d = 0; d < n && !J.done; d++) dayOnTrail(J, true); if (J.done) endJourney(); });\n}\nfunction supplyLines() {\n  return [`OXEN: ${J.oxen} YOKE`, `FOOD: ${J.food} LB`, `CLOTHING: ${J.clothes} SETS`, `BULLETS: ${J.bullets * 20}`, `WHEELS ${J.wheel}  AXLES ${J.axle}  TONGUES ${J.tongue}`, `MONEY: $${J.money.toFixed(2)}`];\n}\n\nfunction updatePause() {\n  if (pressed(UP) || pressed(DOWN)) { pauseSel ^= 1; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0) || (pressed(A) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) { fx(SFX.select); toTitle(); }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  bg(2, { show: state === 'title' });\n  const trailOn = state === 'trail' || state === 'menu' || state === 'end';\n  bg(0, { show: trailOn || state === 'title' }); bg(1, { show: trailOn || state === 'title' });\n  bgscroll(0, scroll >> 1, -(152 - ART.scenes.field.h * 8)); bgscroll(1, scroll >> 2, -(152 - ART.scenes.field.h * 8 - ART.scenes.hills.h * 8 + 8));\n  if (trailOn) drawTrail();\n  if (state === 'title') drawTitle();\n  else if (state === 'setup') drawSetup();\n  else if (state === 'store') drawStore();\n  else if (state === 'menu') drawMenu();\n  else if (state === 'end') drawEnd();\n  else if (state === 'records') drawRecords();\n  if (card) drawCard();\n  if (paused) drawPause();\n}\n\nfunction drawTrail() {\n  // the wagon (a placeholder until the art proof of step 2): a cover, a box, two wheels turning, an ox\n  const x = 120, y = 128, w = (scroll >> 3) & 1;\n  rectfill(x, y - 12, 34, 10, 15); rectfill(x + 2, y - 2, 30, 8, BROWN); circfill(x + 6, y + 8, 4, 1); circfill(x + 28, y + 8, 4, 1);\n  pset(x + 6 + (w ? 2 : -2), y + 8, 15); rectfill(x + 40, y - 2, 16, 8, BROWN); rectfill(x + 54, y - 6, 6, 6, BROWN); rectfill(x + 42 + w * 2, y + 6, 2, 6, 1); rectfill(x + 52 - w * 2, y + 6, 2, 6, 1);\n  // the HUD board\n  rectfill(0, 152, 256, 72, BOARD); rect(0, 152, 256, 72, 1);\n  const k = nextMark(J), to = markMile(J, k) - J.mile;\n  txt(dateText(J), 8, 158, WHITE); txt(WEATHERS[J.weather], 248 - WEATHERS[J.weather].length * 8, 158, CYAN);\n  txt(`HEALTH: ${healthWord(J)}`, 8, 172, healthWord(J) === 'GOOD' ? GREEN : healthWord(J) === 'FAIR' ? GOLD : RED);\n  txt(`FOOD: ${J.food} LB`, 8, 184, J.food < 100 ? RED : WHITE);\n  txt(`NEXT: ${TRAIL[k].name}`, 8, 196, WHITE); txt(`${to} MILES`, 8, 208, DIM);\n  const tm = `${J.mile} MI`; txt(tm, 248 - tm.length * 8, 208, GOLD);\n  txt(`${PACES[J.pace].name}`, 248 - PACES[J.pace].name.length * 8, 184, DIM);\n  if (state === 'trail' && (clock >> 5) & 1) txt('A: STOP', 248 - 56, 196, DIM);\n}\n\nfunction drawTitle() {\n  ['NEW JOURNEY', 'TOP 10'].forEach((s, i) => txt(`${i === sel ? '> ' : '  '}${s}`, 80, 100 + i * 14, i === sel ? WHITE : DIM));\n}\nfunction drawSetup() {\n  panel(8, 16, 240, 192);\n  ctxt(setup.step === 0 ? 'WHO LEADS THE PARTY?' : 'WHEN DO YOU SET OUT?', 26, GOLD);\n  if (setup.step === 0) BACKGROUNDS.forEach((b, i) => { const y = 52 + i * 34, on = i === setup.bg; txt(`${on ? '>' : ' '} A ${b.name}`, 24, y, on ? WHITE : DIM); txt(`$${b.money}, ${b.gift}`, 40, y + 11, on ? GOLD : DIM); txt(`SCORE X${b.mult}`, 40, y + 21, DIM); });\n  else START_MONTHS.forEach((m, i) => txt(`${i === setup.month ? '> ' : '  '}${MONTHS[m]}`, 72, 52 + i * 14, i === setup.month ? WHITE : DIM));\n  ctxt('A: CHOOSE   B: BACK', 192, DIM);\n}\nfunction drawStore() {\n  panel(4, 4, 248, 216);\n  ctxt(J.mile === 0 ? 'THE STORE AT INDEPENDENCE' : `${TRAIL[J.next - 1].name}'S STORE`, 12, GOLD);\n  GOODS.forEach((g, i) => {\n    const y = 32 + i * 18, on = i === sel;\n    txt(`${on ? '>' : ' '} ${g.name}`, 10, y, on ? WHITE : DIM);\n    txt(`$${(g.price * storeMult).toFixed(2)} ${g.unit}`, 26, y + 9, DIM);\n    const n = `${J[g.key] + cart[g.key]}`; txt(n, 200 - n.length * 8, y, cart[g.key] ? GOLD : WHITE);\n    if (on) txt('< >', 208, y, GOLD);\n  });\n  const y = 32 + GOODS.length * 18 + 4;\n  txt(`${sel === GOODS.length ? '>' : ' '} LEAVE THE STORE`, 10, y, sel === GOODS.length ? WHITE : DIM);\n  txt(`BILL $${cartCost().toFixed(2)}`, 10, 196, WHITE); const m = `YOU HAVE $${(J.money - cartCost()).toFixed(2)}`; txt(m, 246 - m.length * 8, 196, GOLD);\n}\nfunction drawMenu() {\n  panel(16, 20, 224, 120);\n  ctxt(`${TRAIL[nextMark(J)].name}: ${markMile(J, nextMark(J)) - J.mile} MI`, 28, GOLD);\n  MENU.forEach((s, i) => txt(`${i === sel ? '> ' : '  '}${s}`, 28, 48 + i * 16, i === sel ? WHITE : DIM));\n}\nfunction drawEnd() {\n  panel(16, 24, 224, 120);\n  if (J.arrived) {\n    ctxt('YOU HAVE REACHED', 34, WHITE); ctxt('THE WILLAMETTE VALLEY!', 46, GOLD);\n    ctxt(`${alive(J).length} OF 5 MADE IT, ${dateText(J)}`, 66, WHITE);\n    ctxt(`SCORE ${J.score}`, 86, GOLD);\n    if (rank >= 0) ctxt(`TOP 10: #${rank + 1}`, 100, CYAN);\n  } else { ctxt('THE WHOLE PARTY', 50, WHITE); ctxt('HAS DIED ON THE TRAIL.', 62, RED); ctxt(`${J.mile} MILES FROM INDEPENDENCE`, 82, DIM); }\n  if (timer > 60 && (clock >> 5) & 1) ctxt('A: CONTINUE', 124, DIM);\n}\nfunction drawRecords() {\n  panel(16, 16, 224, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => { const y = 44 + i * 14; txt(String(i + 1).padStart(2), 28, y, DIM); txt(e.score ? e.name : '---', 56, y, WHITE); if (e.score) { const s = String(e.score); txt(s, 228 - s.length * 8, y, GOLD); } });\n}\nfunction drawCard() {\n  const c = card, h = 34 + c.lines.length * 11 + (c.choices ? c.choices.length * 12 + 6 : 12);\n  const y0 = Math.max(4, 76 - (h >> 1));\n  panel(8, y0, 240, h);\n  ctxt(c.title, y0 + 8, GOLD);\n  c.lines.forEach((l, i) => ctxt(l, y0 + 24 + i * 11, WHITE));\n  const yc = y0 + 28 + c.lines.length * 11;\n  if (c.choices) c.choices.forEach((s, i) => txt(`${i === c.sel ? '> ' : '  '}${s}`, 20, yc + i * 12, i === c.sel ? WHITE : DIM));\n  else if ((clock >> 4) & 1) ctxt('A', yc, DIM);\n}\nfunction drawPause() {\n  panel(56, 80, 144, 48);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 68, 104 + i * 11, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SOLID); rect(x, y, w, h, GOLD); rect(x + 2, y + 2, w - 4, h - 4, BROWN); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky's colour (the SNES did its skies this way, with HDMA). */\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

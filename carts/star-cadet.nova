logo_cadet\": {\"h\": 27, \"parts\": [[0, 0, 896, 32, 3, 0], [32, 0, 900, 32, 3, 0], [64, 0, 904, 32, 3, 0], [96, 0, 908, 32, 3, 0]], \"w\": 123}, \"logo_pinball\": {\"h\": 19, \"parts\": [[0, 0, 834, 16, 3, 0], [16, 0, 864, 16, 3, 0], [32, 0, 866, 16, 3, 0], [48, 0, 960, 16, 3, 0], [64, 0, 962, 16, 3, 0], [80, 0, 964, 16, 3, 0], [96, 0, 964, 16, 3, 0]], \"w\": 115}, \"logo_star\": {\"h\": 27, \"parts\": [[0, 0, 836, 32, 3, 0], [32, 0, 840, 32, 3, 0], [64, 0, 844, 32, 3, 0]], \"w\": 99}, \"sling\": {\"h\": 96, \"parts\": [[8, 0, 623, 8, 2, 0], [8, 8, 624, 8, 2, 0], [8, 16, 625, 8, 2, 0], [8, 24, 626, 8, 2, 0], [16, 16, 627, 8, 2, 0], [16, 24, 628, 8, 2, 0], [0, 32, 648, 32, 2, 0], [8, 64, 629, 8, 2, 0], [16, 64, 634, 8, 2, 0], [24, 64, 635, 8, 2, 0]], \"w\": 32}, \"sling_hit\": {\"h\": 96, \"parts\": [[8, 0, 636, 8, 2, 0], [8, 8, 637, 8, 2, 0], [8, 16, 638, 8, 2, 0], [8, 24, 639, 8, 2, 0], [16, 16, 627, 8, 2, 0], [16, 24, 646, 8, 2, 0], [0, 32, 652, 32, 2, 0], [8, 64, 629, 8, 2, 0], [16, 64, 647, 8, 2, 0], [24, 64, 635, 8, 2, 0]], \"w\": 32}},\nanims: {\"flip\": [\"flip0\", \"flip1\", \"flip2\", \"flip3\", \"flip4\", \"flip5\", \"flip6\", \"flip7\", \"flip8\"]},\n};\nfunction bigSprite(b, x, y, opts = {}) {\nconst fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\nfor (const [dx, dy, t, size, pal, f] of b.parts) {\nspr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n{ size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n}\n}\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, flipUp: 3, flipDown: 4, bump: 5, sling: 8, standup: 9, drop: 10, bank: 11, lane: 12, laneSet: 13, ramp: 14, spin: 15,\ngateIn: 16, gateOut: 17, launch: 18, drain: 19, save: 20, nudge: 21, warn: 22, tilt: 23, tick: 24, mission: 25, rankUp: 26, fail: 27, extra: 28, record: 29,\nover: 30, lamp: 31, orbit: 32, kick: 33, jackpot: 34 };\nconst SONG = { title: 0, play: 1, mission: 4, multi: 5, final: 6 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 2, BEST_SLOT = 1, GAMES_SLOT = 2, INITIALS_SLOT = 3;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3;\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)), rn: dget(s + 2) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, e.rn || 0); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\nfunction insertTop(e) {\nif (!e.score) return -1;\nconst list = topTen(), at = list.findIndex((x) => e.score > x.score);\nif (at < 0) return -1;\nlist.splice(at, 0, e);\nfor (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\nreturn at;\n}\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\nconst TABLE_W = 192, TABLE_H = 640, VIEW_H = 224;\nconst BR = 5, SUB = 4;\nconst GRAV = 0.12, VMAX = 14;\nconst WALL_E = 0.45, FLIP_E = 0.7, REST_CUT = 0.3;\nconst FLEN = 34, FR = 4;\nconst REST_A = 30 * Math.PI / 180, UP_A = -28 * Math.PI / 180;\nconst W_UP = (REST_A - UP_A) / 4, W_DOWN = (REST_A - UP_A) / 6;\nconst LANE_X = 176, LANE_FLOOR = 612, BALL_HOME = { x: 184, y: LANE_FLOOR - BR };\nconst PLUNGE_FRAMES = 60;\nconst DRAIN_Y = 632;\nconst WALLS = (() => {\nconst w = [];\nfor (let i = 0; i < 16; i++) {\nconst a0 = Math.PI + (Math.PI * i) / 16, a1 = Math.PI + (Math.PI * (i + 1)) / 16;\nw.push([96 + 96 * Math.cos(a0), 96 + 96 * Math.sin(a0), 96 + 96 * Math.cos(a1), 96 + 96 * Math.sin(a1)]);\n}\nw.push([0, 96, 0, TABLE_H]);\nw.push([TABLE_W, 96, TABLE_W, LANE_FLOOR]);\nw.push([LANE_X, 120, LANE_X, LANE_FLOOR]);\nw.push([LANE_X, LANE_FLOOR, TABLE_W, LANE_FLOOR]);\nfor (const m of [0, 1]) {\nconst X = (x) => (m ? 176 - x : x);\nw.push([X(16), 492, X(16), 540], [X(16), 540, X(48), 588]);\nw.push([X(32), 480, X(32), 545], [X(32), 545, X(44), 545]);\nw.push([X(24), 158, X(24), 184], [X(24), 206, X(24), 258], [X(24), 280, X(24), 410]);\n}\nw.push([70, 44, 70, 76, 2], [106, 44, 106, 76, 2]);\nreturn w;\n})();\nconst BUMP_R = 11, BUMP_KICK = 6, SLING_KICK = 4.5, COOL = 8, HIT_FLASH = 6;\nconst BUMPERS = [[66, 168], [110, 168], [88, 204]].map(([x, y]) => ({ x, y, flash: 0, cool: 0 }));\nconst SLINGS = [[32, 480, 44, 545], [144, 480, 132, 545]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, flash: 0, cool: 0 }));\nconst STANDUPS = [[24, 184, 24, 206], [24, 258, 24, 280], [152, 184, 152, 206], [152, 258, 152, 280]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, lit: false, flash: 0, cool: 0 }));\nconst DROPS = [0, 1, 2].map((i) => ({ x0: 71 + 10 * i, y0: 287 + 10 * i / 3, x1: 80 + 10 * i, y1: 290 + 10 * i / 3, down: false, flash: 0 }));\nconst TARGET_R = 2, DROP_RESET = 90;\nconst LANE_XS = [52, 88, 124], LANE_Y = 62, LANE_HW = 18;\nconst GATE = { x: 88, y: 104, r: 10 }, GATE_HOLD = 45, NOGATE = 150;\nconst SPIN = { x0: 4, x1: 20, y0: 226, y1: 254, per: 4 };\nconst ORBIT_Y = 160, ORBIT_IN = 330, ORBIT_X = [24, 152];\nconst RAMPS = [\n{ ex: 12, ey: 420, tx: 12, ty: 165, evx: 1.5, evy: 2, lit: false },\n{ ex: 164, ey: 420, tx: 164, ty: 165, evx: -1.5, evy: 2, lit: false },\n].map((r) => ({ ...r, len: Math.hypot(r.tx - r.ex, r.ty - r.ey) }));\nconst ONEWAY = [[0, 142, 26, 152.5], [176, 142, 150, 152.5], [0, 418, 30, 430], [176, 418, 146, 430]];\nconst RAMP_SPEED = 7, RAMP_IN = 14, RAMP_MIN = 3.5, RAMP_MAX = 8.6;\nconst KICKBACK = { x: 16, y0: 575, y1: 606, v: 13 };\nconst PTS = { bump: 100, sling: 10, standup: 500, drop: 1000, bank: 5000, spin: 100, ramp: 1000, rampLit: 2500, orbit: 2000, lane: 500, gate: 5000 };\nlet spinPhase = 0, stats = {}, laneLit = [false, false, false], kickback = true, spinAcc = 0, dropTimer = 0, gateSide = 1;\nconst resetStats = () => { stats = { bump: 0, sling: 0, standup: 0, drop: 0, bank: 0, spin: 0, ramp: 0, rampL: 0, rampR: 0, orbit: 0, orbitL: 0, orbitR: 0, lane: 0, laneDone: 0, standupDone: 0, gate: 0, kick: 0 }; };\nresetStats();\nconst makeFlippers = () => [{ x: 48, y: 588, s: 1, a: REST_A, w: 0 }, { x: 128, y: 588, s: -1, a: REST_A, w: 0 }];\nconst flipTip = (f) => ({ x: f.x + f.s * FLEN * Math.cos(f.a), y: f.y + FLEN * Math.sin(f.a) });\nlet CN = [0, -1];\nfunction collide(b, x0, y0, x1, y1, r, e, vsAt) {\nconst dx = x1 - x0, dy = y1 - y0, len2 = dx * dx + dy * dy;\nconst t = len2 ? clamp(((b.x - x0) * dx + (b.y - y0) * dy) / len2, 0, 1) : 0;\nconst cx = x0 + dx * t, cy = y0 + dy * t, ox = b.x - cx, oy = b.y - cy, d2 = ox * ox + oy * oy, reach = BR + r;\nif (d2 >= reach * reach) return false;\nconst d = Math.sqrt(d2), nx = d ? ox / d : 0, ny = d ? oy / d : -1;\nb.x = cx + nx * reach; b.y = cy + ny * reach; CN = [nx, ny];\nconst vs = vsAt ? vsAt(t) : [0, 0];\nconst vn = (b.vx - vs[0]) * nx + (b.vy - vs[1]) * ny;\nif (vn < 0) {\nconst k = -(1 + (vn > -REST_CUT ? 0 : e)) * vn;\nb.vx += k * nx; b.vy += k * ny;\n}\nreturn true;\n}\nfunction kick(b, v) {\nconst vn = b.vx * CN[0] + b.vy * CN[1];\nif (vn < v) { b.vx += (v - vn) * CN[0]; b.vy += (v - vn) * CN[1]; }\n}\nfunction struck(el) { if (el.cool > 0) return false; el.cool = COOL; el.flash = HIT_FLASH; return true; }\nconst SAVE_FRAMES = 12 * 60, EXTRA_AT = 500000, MULT_MAX = 6, NUDGE_V = 1.2, NUDGE_WARN = 3, NUDGE_TILT = 4, BALLS = 3;\nconst BONUS = { standup: 1000, drop: 500, bank: 5000, ramp: 2000, orbit: 2000, gate: 5000 };\nlet evq = []; const emit = (k) => { evq.push(k); };\nlet bs = [];\nlet mult = 1, bonus = 0, extraBalls = 0, extraGiven = false, msg = '', msgT = 0;\nfunction say(t) { msg = t; msgT = 150; }\nconst earn = (k) => { bonus += BONUS[k]; };\nfunction award(n) {\nscore += n;\nif (!extraGiven && score >= EXTRA_AT) { extraGiven = true; extraBalls++; say('EXTRA BALL'); fx(SFX.extra); }\n}\nfunction gateCapture(b) {\nb.x = GATE.x; b.y = GATE.y; b.vx = b.vy = 0; b.ramp = null; b.hold = GATE_HOLD * SUB; stats.gate++; award(PTS.gate); earn('gate'); emit('gate'); fx(SFX.gateIn);\n}\nconst gateOpen = () => (mission ? !!MISSIONS[mission.r].gate?.(mission) : lamps.every(Boolean));\nfunction sensors(b) {\nLANE_XS.forEach((x, i) => {\nif (Math.abs(b.x - x) < LANE_HW && Math.abs(b.y - LANE_Y) < 6 && !laneLit[i]) {\nlaneLit[i] = true; stats.lane++; award(PTS.lane); emit('lane'); fx(SFX.lane);\nif (laneLit.every(Boolean)) { fx(SFX.laneSet); stats.laneDone++; laneLit = [false, false, false]; if (mult < MULT_MAX) { mult++; say('BONUS X' + mult); } }\n}\n});\nif (b.x > SPIN.x0 && b.x < SPIN.x1 && b.y > SPIN.y0 && b.y < SPIN.y1) {\nspinAcc += Math.abs(b.vy) / SUB; spinPhase += Math.abs(b.vy) / SUB / 4;\nwhile (spinAcc >= SPIN.per) { spinAcc -= SPIN.per; stats.spin++; award(PTS.spin); emit('spin'); if (stats.spin % 3 === 0) fx(SFX.spin); }\n}\nORBIT_X.forEach((ox, k) => {\nconst inL = k === 0 ? b.x < ox : b.x > ox && b.x < LANE_X, side = b.y > ORBIT_Y - 10 && b.y < ORBIT_IN + 10;\nif (inL && b.y > ORBIT_IN - 14 && b.y < ORBIT_IN + 6 && b.vy < -1) b.arm[k] = true;\nelse if (b.arm[k] && inL && b.y < ORBIT_Y) { b.arm[k] = false; stats.orbit++; stats[k ? 'orbitR' : 'orbitL']++; award(PTS.orbit); earn('orbit'); emit(k ? 'orbitR' : 'orbitL'); fx(SFX.orbit); }\nelse if (b.arm[k] && !inL && side && b.y < ORBIT_IN - 20) b.arm[k] = false;\n});\nif (b.nogate > 0) b.nogate--;\nelse if (Math.hypot(b.x - GATE.x, b.y - GATE.y) < GATE.r - 2) gateCapture(b);\nfor (const r of RAMPS) {\nif (Math.hypot(b.x - r.ex, b.y - r.ey) < RAMP_IN && b.vy < -RAMP_MIN && b.vy > -RAMP_MAX) { b.ramp = { r, d: 0, gate: gateOpen(), out: false }; stats.ramp++; fx(SFX.ramp); }\n}\nif (kickback && b.x < KICKBACK.x && b.y > KICKBACK.y0 && b.y < KICKBACK.y1 && b.vy > 0) {\nkickback = false; b.vx = 0.5; b.vy = -KICKBACK.v; stats.kick++; fx(SFX.kick);\n}\n}\nfunction stepTable(balls, flips, hold) {\nfor (let i = 0; i < SUB; i++) {\nflips.forEach((f, k) => {\nconst a0 = f.a;\nf.a = hold[k] ? Math.max(UP_A, f.a - W_UP / SUB) : Math.min(REST_A, f.a + W_DOWN / SUB);\nf.w = (f.a - a0) * SUB;\n});\nfor (const b of balls) stepBall(b, flips);\n}\nfor (const e of [...BUMPERS, ...SLINGS, ...STANDUPS, ...DROPS]) { if (e.cool > 0) e.cool--; if (e.flash > 0) e.flash--; }\nif (dropTimer > 0 && --dropTimer === 0) for (const e of DROPS) e.down = false;\n}\nfunction stepBall(b, flips) {\nif (b.ramp) {\nconst R = b.ramp, r = R.r, d = (R.d += RAMP_SPEED / SUB), gl = Math.hypot(GATE.x - r.tx, GATE.y - r.ty);\nif (d < r.len) { const t = d / r.len; b.x = r.ex + (r.tx - r.ex) * t; b.y = r.ey + (r.ty - r.ey) * t; b.vx = b.vy = 0; return; }\nif (!R.out) {\nR.out = true; b.x = r.tx; b.y = r.ty; award(r.lit ? PTS.rampLit : PTS.ramp); earn('ramp'); stats[r === RAMPS[0] ? 'rampL' : 'rampR']++; emit(r === RAMPS[0] ? 'rampL' : 'rampR'); if (bs.length > 1) emit('jackpot');\n}\nif (R.gate && d < r.len + gl) { const t = (d - r.len) / gl; b.x = r.tx + (GATE.x - r.tx) * t; b.y = r.ty + (GATE.y - r.ty) * t; return; }\nif (R.gate) { gateCapture(b); return; }\nb.vx = r.evx; b.vy = r.evy; b.ramp = null;\nreturn;\n}\nif (b.hold > 0) {\nif (--b.hold === 0) { gateSide = -gateSide; b.y = GATE.y + GATE.r + 1; b.vx = 1.2 * gateSide; b.vy = 5; b.nogate = NOGATE; fx(SFX.gateOut); }\nreturn;\n}\nb.vy += GRAV / SUB;\nconst sp = Math.hypot(b.vx, b.vy);\nif (sp > VMAX) { b.vx *= VMAX / sp; b.vy *= VMAX / sp; }\nb.x += b.vx / SUB; b.y += b.vy / SUB;\nfor (const w of WALLS) collide(b, w[0], w[1], w[2], w[3], w[4] || 0, WALL_E);\nif (b.vy > 0) for (const w of ONEWAY) collide(b, w[0], w[1], w[2], w[3], 0, WALL_E);\nfor (const e of BUMPERS) if (collide(b, e.x, e.y, e.x, e.y, BUMP_R, WALL_E)) {\nkick(b, BUMP_KICK); if (struck(e)) { stats.bump++; award(PTS.bump); emit('bump'); fx(SFX.bump + BUMPERS.indexOf(e)); }\n}\nfor (const e of SLINGS) if (collide(b, e.x0, e.y0, e.x1, e.y1, 0, WALL_E)) {\nkick(b, SLING_KICK); if (struck(e)) { stats.sling++; award(PTS.sling); emit('sling'); fx(SFX.sling); }\n}\nfor (const e of STANDUPS) if (collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E) && struck(e) && !e.lit) {\ne.lit = true; stats.standup++; award(PTS.standup); earn('standup'); emit('standup'); fx(SFX.standup);\nif (STANDUPS.every((q) => q.lit)) { stats.standupDone++; emit('standupSet'); for (const q of STANDUPS) q.lit = false; }\n}\nfor (const e of DROPS) if (!e.down && collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E)) {\ne.down = true; e.flash = HIT_FLASH; stats.drop++; award(PTS.drop); earn('drop'); emit('drop'); fx(SFX.drop);\nif (DROPS.every((q) => q.down)) { stats.bank++; award(PTS.bank); earn('bank'); emit('bank'); fx(SFX.bank); dropTimer = DROP_RESET; }\n}\nsensors(b);\nfor (const f of flips) {\nconst tip = flipTip(f);\ncollide(b, f.x, f.y, tip.x, tip.y, FR, FLIP_E, (t) => {\nconst r = t * FLEN;\nreturn [-f.s * Math.sin(f.a) * r * f.w, Math.cos(f.a) * r * f.w];\n});\n}\n}\nlet inputMask = 0, prevMask = 0;\nconst PAD_LEFT = [UP, DOWN, LEFT, RIGHT], PAD_RIGHT = [A, B, X, Y];\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, balls = BALLS, ball = null, flips = [], plunge = 0, camY = 0, held = [false, false], heldPrev = [false, false];\nlet demoStart = 0, wantPlayers = 1, newBest = 0, demo = false, idle = 0, titleCam = 0, lampN = [0, 0, 0], rk = 0, lamps = [false, false, false], career = false, mission = null, banner = null, floorBase = [];\nlet nPlayers = 1, cur = 0, players = [], nudges = 0, tilted = false, saveT = 0, saved = false, shake = 0, bonusRes = null, initQueue = [], firstRank = -1;\nlet sparks = [], glare = 0, warmth = 0, viewY = 0;\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nconst d = ART.scenes.decor, f = ART.scenes.floor, st = ART.scenes.stars;\nbg(0, { mx: d.mx, my: d.my, mw: d.w, mh: d.h, x: 0, y: 0, wrap: false, show: false });\nbg(1, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, x: 0, y: 0, wrap: false, show: false });\nbg(2, { mx: st.mx, my: st.my, mw: st.w, mh: st.h, x: 0, y: 0, wrap: true, show: true });\nfor (let i = 17; i <= DECK_LAST; i++) floorBase[i] = color(i);\nblend({ layers: ['overlay', 'spr'], op: 'add' });\nflips = makeFlippers(); ball = newBall(BALL_HOME.x, BALL_HOME.y); bs = [];\nif (skipTitle) startGame(); else toTitle();\n}\nfunction toTitle() { sparks = []; glare = 0; state = 'title'; timer = 0; titleSel = 0; paused = false; demo = false; idle = 0; nPlayers = wantPlayers; flips = makeFlippers(); bs = []; lamps = [false, false, false]; lampN = [0, 0, 0]; mission = null; banner = null; play(SONG.title); }\nconst makePlayer = () => ({ score: 0, balls: BALLS, lanes: [false, false, false], stand: [false, false, false, false], extra: 0, given: false, rk: 0, lamps: [false, false, false], lampN: [0, 0, 0], career: false, mission: null });\nfunction loadPlayer(i) {\nconst q = players[i]; cur = i;\nscore = q.score; balls = q.balls; laneLit = q.lanes.slice(); extraBalls = q.extra; extraGiven = q.given;\nrk = q.rk; lamps = q.lamps.slice(); lampN = q.lampN.slice(); career = q.career; mission = q.mission; applyRankLight();\nSTANDUPS.forEach((e, k) => { e.lit = q.stand[k]; });\n}\nfunction savePlayer() {\nObject.assign(players[cur], { score, balls, lanes: laneLit.slice(), stand: STANDUPS.map((e) => e.lit), extra: extraBalls, given: extraGiven, rk, lamps: lamps.slice(), lampN: lampN.slice(), career, mission });\n}\nfunction startGame(n = nPlayers) {\nnPlayers = n; players = Array.from({ length: n }, makePlayer);\nflips = makeFlippers(); resetStats(); msgT = 0; paused = false; timer = 0; sparks = []; glare = 0;\nloadPlayer(0); beginBall();\nstate = n > 1 ? 'turn' : 'play';\nif (!demo) playSong();\n}\nfunction playSong() {\nplay(mission ? (mission.r === 8 ? SONG.final : MISSIONS[mission.r].multi ? SONG.multi : SONG.mission) : SONG.play + (rk >= 4 ? 2 : rk >= 3 ? 1 : 0));\n}\nfunction startDemo() { startGame(1); demo = true; demoStart = clock; play(SONG.title); }\nfunction demoPad() {\nconst b = ball, pad = [false, false];\nif (inLane() && bs.length === 1) { pad[0] = plunge < 0.97; return { pad, plunge: true }; }\nflips.forEach((f, k) => {\nconst tip = flipTip(f);\nfor (const x of bs) if (x.y > 545 && x.vy > -2 && Math.abs(x.x - (f.x + tip.x) / 2) < 30 && Math.abs(x.y - (f.y + tip.y) / 2) < 22 && (k ? x.x > 76 : x.x < 100)) pad[k] = (clock >> 3) % 3 !== 2;\n});\nreturn { pad, plunge: false };\n}\nfunction beginBall() {\nmult = 1; bonus = 0; nudges = 0; tilted = false; saveT = 0; saved = false; shake = 0; kickback = true; dropTimer = 0; evq = [];\nfor (const e of DROPS) e.down = false;\nserve();\n}\nconst newBall = (x, y, hold = 0) => ({ x, y, vx: 0, vy: 0, ramp: null, hold, arm: [false, false] });\nfunction serve() {\nball = newBall(BALL_HOME.x, BALL_HOME.y); bs = [ball]; plunge = 0;\ncamY = clamp(ball.y - 150, 0, TABLE_H - VIEW_H);\n}\nconst inLane = () => ball.x > LANE_X && ball.y > LANE_FLOOR - 40;\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'play') updatePlay();\nelse if (state === 'players') updatePlayers();\nelse if (state === 'turn') updateTurn();\nelse if (state === 'bonus') updateBonus();\nelse if (state === 'over') updateOver();\nelse if (state === 'initials') updateInitials();\nelse if (state === 'records') updateRecords();\nprevMask = inputMask;\n}\nconst IDLE_DEMO = 20 * 60, DEMO_FRAMES = 60 * 60;\nfunction updateTitle() {\nidle = inputMask ? 0 : idle + 1;\nif (idle > IDLE_DEMO) { startDemo(); return; }\nif (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (titleSel === 0) { state = 'players'; timer = 0; } else { state = 'records'; hl = -1; timer = 0; }\n}\n}\nfunction updatePlayers() {\nif (pressed(LEFT) || pressed(DOWN)) { nPlayers = Math.max(1, nPlayers - 1); fx(SFX.move); }\nif (pressed(RIGHT) || pressed(UP)) { nPlayers = Math.min(4, nPlayers + 1); fx(SFX.move); }\nif (pressed(B)) { fx(SFX.move); toTitle(); }\nelse if ((pressed(A) || pressed(START)) && timer > 10) { fx(SFX.select); wantPlayers = nPlayers; startGame(); }\n}\nfunction updatePlay() {\nif (demo) { if ((inputMask && !prevMask) || clock - demoStart > DEMO_FRAMES) { toTitle(); return; } }\nelse if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nconst ai = demo ? demoPad() : null;\nconst pushed = demo ? ai.pad : [PAD_LEFT.some((k) => btn(k)), PAD_RIGHT.some((k) => btn(k))];\nheld = tilted ? [false, false] : pushed;\nif (!inLane() && !tilted) {\nif (pushed[0] && !heldPrev[0]) { laneLit.push(laneLit.shift()); fx(SFX.flipUp); }\nif (pushed[1] && !heldPrev[1]) { laneLit.unshift(laneLit.pop()); fx(SFX.flipUp); }\nif ((!pushed[0] && heldPrev[0]) || (!pushed[1] && heldPrev[1])) fx(SFX.flipDown);\n}\nheldPrev = pushed;\nconst waiting = inLane() && ball.vy >= 0 && ball.y >= BALL_HOME.y - 1;\nif (waiting && (pushed[0] || pushed[1])) plunge = Math.min(1, plunge + 1 / PLUNGE_FRAMES);\nelse if (waiting && plunge > 0.04) { ball.vy = -(4 + 10 * plunge); plunge = 0; if (!saved) saveT = SAVE_FRAMES; fx(SFX.launch); }\nelse if (!waiting) plunge = 0;\nconst side = demo ? 0 : pressed(L) ? -1 : pressed(R) ? 1 : 0;\nif ((side || (!demo && pressed(SELECT))) && !inLane() && !tilted && bs.some((b) => !b.ramp && !b.hold)) nudge(side, pressed(SELECT));\nstepTable(bs, flips, held);\nlightShow();\nprocessEvents();\nif (!demo) playSong();\nif (mission && !(inLane() && bs.length === 1)) tickMission();\nif (saveT > 0) saveT--;\nif (shake > 0) shake--;\nif (glare > 0) glare--;\nif (msgT > 0) msgT--;\nif (banner && banner.t > 0) banner.t--;\nconst want = clamp(Math.max(...bs.map((b) => b.y)) - 150, 0, TABLE_H - VIEW_H);\ncamY += (want - camY) * 0.12;\nfor (const b of bs.slice()) {\nif (!(b.y > DRAIN_Y && b.x < LANE_X)) continue;\nif (bs.length > 1) { bs.splice(bs.indexOf(b), 1); ball = bs[0]; fx(SFX.drain); } else { drain(); break; }\n}\n}\nconst RANK_NAMES = ['CADET', 'ENSIGN', 'PILOT', 'LIEUTENANT', 'COMMANDER', 'CAPTAIN', 'COMMODORE', 'ADMIRAL', 'FLEET ADMIRAL'];\nconst RANK_SHORT = ['CADET', 'ENSIGN', 'PILOT', 'LIEUT', 'CMDR', 'CAPTAIN', 'COMDORE', 'ADMIRAL', 'FLT ADM'];\nconst rankLabel = (n) => (n > 9 ? 'FLTADM*' : n > 0 ? RANK_SHORT[n - 1] : '');\nconst rankNo = (q) => (q.career ? 10 : q.rk + 1);\nconst LAMP_STANDUPS = 2, LAMP_DROPS = 2;\nconst RANK_BONUS = 10000, RANK_PRIZE = 500000, JACKPOT = 1000000, SHOTS = ['bump', 'sling', 'standup', 'drop', 'spin', 'rampL', 'rampR', 'orbitL', 'orbitR', 'gate', 'lane'];\nconst EXTRA_AT_RANK = [1, 4, 7];\nconst MISSIONS = [\n{ name: 'LAUNCH DRILL', time: 75, text: (m) => `BUMPERS ${m.n}/10`, on: (m, k) => { if (k === 'bump') m.n++; return m.n >= 10; } },\n{ name: 'ASTEROID BELT', time: 90, text: (m) => (m.step ? `DROP TARGETS ${m.n}/3` : `STANDUP TARGETS ${m.n}/3`), on: (m, k) => {\nif (!m.step && k === 'standup' && ++m.n >= 3) { m.step = 1; m.n = 0; } else if (m.step && k === 'drop' && ++m.n >= 3) return true;\nreturn false;\n} },\n{ name: 'SLALOM RUN', time: 90, text: (m) => `RAMPS ${m.n}/3`, on: (m, k) => { if (k === 'rampL' || k === 'rampR') m.n++; return m.n >= 3; } },\n{ name: 'ORBIT LOCK', time: 90, text: (m) => `ORBITS ${m.n}/2`, on: (m, k) => { if (k === 'orbitL' || k === 'orbitR') m.n++; return m.n >= 2; } },\n{ name: 'DOCKING', time: 120, gate: (m) => m.n >= 3, text: (m) => (m.n < 3 ? `RAMPS ${m.n}/3` : 'NOW THE GATE'), on: (m, k) => { if (m.n < 3 && (k === 'rampL' || k === 'rampR')) m.n++; else if (m.n >= 3 && k === 'gate') return true; return false; } },\n{ name: 'FUEL RUN', time: 90, text: (m) => `SPINS ${m.n}/30`, on: (m, k) => { if (k === 'spin') m.n++; return m.n >= 30; } },\n{ name: 'WORMHOLE', time: 120, gate: () => true, text: (m) => `GATE ${m.n}/2`, on: (m, k) => { if (k === 'gate') m.n++; return m.n >= 2; } },\n{ name: 'BATTLE FLEET', time: 90, multi: true, text: (m) => `JACKPOTS ${m.n}/3: RAMPS`, on: (m, k) => { if (k === 'jackpot') m.n++; return m.n >= 3; } },\n{ name: 'MOTHERSHIP', time: 150, gate: (m) => Object.keys(m.set).length >= SHOTS.length, text: (m) => (Object.keys(m.set).length < SHOTS.length ? `EVERY SHOT ${Object.keys(m.set).length}/${SHOTS.length}` : 'FINAL: THE GATE'), on: (m, k) => {\nif (Object.keys(m.set).length < SHOTS.length) { if (SHOTS.includes(k)) m.set[k] = 1; } else if (k === 'gate') return true;\nreturn false;\n} },\n];\nfunction applyRankLight() {\nconst t = (career ? 8 : rk) / 8;\nwarmth = t;\nfor (let i = 17; i <= DECK_LAST; i++) {\nconst [r, g, b] = floorBase[i] || [0, 0, 0], lum = 0.3 * r + 0.59 * g + 0.11 * b;\nconst k = 0.8 * t, f = 0.9 + 0.8 * t, ch = (v, gold) => clamp(Math.round((v * (1 - k) + gold * k) * f), 0, 31);\ncolor(i, ch(r, lum * 3), ch(g, lum * 2.3), ch(b, lum * 0.7));\n}\n}\nconst flash = (a, b) => { banner = { a, b, t: 150 }; };\nfunction processEvents() {\nfor (const k of evq) {\nif (mission) {\nif (k === 'jackpot') { if (MISSIONS[mission.r].multi) { award(JACKPOT); fx(SFX.jackpot); glare = 24; } else continue; }\nif (MISSIONS[mission.r].on(mission, k)) completeMission();\ncontinue;\n}\nif (k === 'standupSet') setLamp(0); else if (k === 'bank') setLamp(1);\nelse if (k === 'standup' && ++lampN[0] >= LAMP_STANDUPS) setLamp(0);\nelse if (k === 'drop' && ++lampN[1] >= LAMP_DROPS) setLamp(1);\nelse if (k === 'rampL' || k === 'rampR') setLamp(2);\nelse if (k === 'gate' && lamps.every(Boolean)) startMission();\n}\nevq.length = 0;\n}\nfunction setLamp(i) {\nif (lamps[i]) return;\nlamps[i] = true; lampN[i] = 0; fx(SFX.lamp);\nsay(lamps.every(Boolean) ? 'GATE LIT' : `LAMP ${i + 1}`);\n}\nfunction startMission() {\nlamps = [false, false, false];\nglare = 24;\nif (career) { award(RANK_PRIZE * 10); say('JACKPOT'); flash('MOTHERSHIP', 'JACKPOT 5000000'); fx(SFX.jackpot); return; }\nconst d = MISSIONS[rk];\nmission = { r: rk, left: d.time * 60, n: 0, step: 0, set: {} };\nflash(d.name, d.text(mission)); fx(SFX.mission);\nif (d.multi) {\nsaved = true; saveT = 0;\nfor (let i = 1; i <= 2; i++) bs.push(newBall(GATE.x, GATE.y, (GATE_HOLD + 25 * i) * SUB));\n}\n}\nfunction tickMission() {\nif (--mission.left <= 0) failMission('TIME UP');\nelse if (MISSIONS[mission.r].multi && bs.length < 2) failMission('MULTIBALL OVER');\n}\nfunction failMission(why) { mission = null; lamps = [true, true, true]; flash('MISSION FAILED', why); fx(SFX.fail); }\nfunction completeMission() {\nconst r = mission.r; mission = null;\naward(RANK_PRIZE * (r + 2));\nif (r < 8) rk = r + 1; else career = true;\nif (EXTRA_AT_RANK.includes(r)) { extraBalls++; say('EXTRA BALL'); } else say('RANK UP');\nlamps = [false, false, false]; lampN = [0, 0, 0]; applyRankLight();\nflash('RANK UP', RANK_NAMES[rk] + (career ? ' *' : '')); fx(SFX.rankUp); glare = 40;\n}\nfunction nudge(side, up) {\nnudges++;\nif (nudges >= NUDGE_TILT) { tilted = true; say('TILT'); fx(SFX.tilt); return; }\nif (nudges === NUDGE_WARN) { say('WARNING'); fx(SFX.warn); }\nfor (const b of bs) if (!b.ramp && !b.hold) { b.vx += side * NUDGE_V; if (up) b.vy -= NUDGE_V; }\nshake = 8; fx(SFX.nudge);\n}\nfunction drain() {\nif (saveT > 0 && !saved) { saved = true; saveT = 0; say('BALL SAVED'); fx(SFX.save); serve(); return; }\nfx(SFX.drain); if (mission && MISSIONS[mission.r].multi) failMission('BALL LOST');\nconst base = bonus + rk * RANK_BONUS, b = tilted ? 0 : base * mult;\nif (b > 0) {\nbonusRes = { base, mult, total: b }; award(b); state = 'bonus'; timer = 0;\n} else afterBall();\n}\nconst BONUS_COUNT = 90, BONUS_HOLD = 45;\nconst bonusShown = () => Math.ceil(bonusRes.total * Math.min(1, timer / BONUS_COUNT));\nfunction updateBonus() {\nif (demo && timer > 30) { afterBall(); return; }\nconst done = timer >= BONUS_COUNT;\nif (!done && timer % 5 === 0) fx(SFX.tick);\nif (pressed(A) || pressed(START)) {\nif (!done && timer > 10) timer = BONUS_COUNT; else if (done && timer > BONUS_COUNT + 10) afterBall();\n} else if (timer > BONUS_COUNT + BONUS_HOLD) afterBall();\n}\nfunction afterBall() {\nif (extraBalls > 0) { extraBalls--; beginBall(); say('SHOOT AGAIN'); state = 'play'; return; }\nballs--; savePlayer();\nfor (let i = 1; i <= nPlayers; i++) {\nconst j = (cur + i) % nPlayers;\nif (players[j].balls > 0) {\nloadPlayer(j); beginBall(); timer = 0;\nstate = nPlayers > 1 ? 'turn' : 'play';\nreturn;\n}\n}\ngameOver();\n}\nfunction updateTurn() { if (demo) { state = 'play'; return; } if (timer > 90 || (timer > 15 && (pressed(A) || pressed(START)))) { state = 'play'; timer = 0; } }\nfunction gameOver() {\nif (demo) { toTitle(); return; }\nstate = 'over'; timer = 0; play(-1); fx(SFX.over);\ndset(GAMES_SLOT, dget(GAMES_SLOT) + 1);\nnewBest = Math.max(...players.map(rankNo)) > dget(BEST_SLOT) ? Math.max(...players.map(rankNo)) : 0;\nif (newBest) dset(BEST_SLOT, newBest);\ninitQueue = players.map((q, i) => i).sort((a, b) => players[b].score - players[a].score); firstRank = -1;\n}\nfunction nextInitials() {\nwhile (initQueue.length) {\nconst i = initQueue.shift(), r = insertTop({ score: players[i].score, initials: lastInitials(), rn: rankNo(players[i]) });\nif (r < 0) continue;\nrank = r; if (firstRank < 0) firstRank = r;\nstate = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0, who: i }; fx(SFX.record);\nreturn true;\n}\nreturn false;\n}\nfunction updateOver() {\nif (timer < 60 || !(pressed(A) || pressed(START))) return;\nfx(SFX.select);\nif (!nextInitials()) toTitle();\n}\nfunction updateInitials() {\nconst ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\nif (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\nif (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\nconst done = pressed(START) || (pressed(A) && ini.pos === 2);\nif (pressed(A) && ini.pos < 2) ini.pos++;\nif (!done || timer < 20) return;\nconst v = packInitials(ini.chars.join(''));\ndset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\nfx(SFX.select);\nif (!nextInitials()) { state = 'records'; hl = firstRank; timer = 0; }\n}\nfunction updateRecords() {\nif ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\nfunction updatePause() {\nif (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) startGame();\nelse toTitle();\n}\n}\nconst DECK_LAST = 22;\nconst SPARK_MAX = 18, SPARK_LIFE = 18, TRAIL_MIN = 4.5;\nconst RANK_LAMPS = [...Array(9).keys()].map((k) => { const a = (160 - k * 17.5) * Math.PI / 180; return [Math.round(96 + 52 * Math.cos(a)), Math.round(336 + 30 * Math.sin(a))]; });\nfunction lightShow() {\nconst burst = (x, y, n, sp, r = 0) => {\nfor (let k = 0; k < n && sparks.length < SPARK_MAX; k++) {\nconst a = (k / n + (clock % 7) / 7 / n) * 2 * Math.PI, v = sp * (0.7 + ((k * 5 + clock) % 4) * 0.15);\nsparks.push({ x: x + r * Math.cos(a), y: y + r * Math.sin(a), vx: v * Math.cos(a), vy: v * Math.sin(a), t: SPARK_LIFE });\n}\n};\nfor (const e of BUMPERS) if (e.flash === HIT_FLASH - 1) burst(e.x, e.y, 6, 2.4, BUMP_R + 3);\nfor (const e of SLINGS) if (e.flash === HIT_FLASH - 1) burst((e.x0 + e.x1) / 2, (e.y0 + e.y1) / 2, 4, 2.2);\nfor (const e of STANDUPS) if (e.flash === HIT_FLASH - 1) burst(e.x0, (e.y0 + e.y1) / 2, 3, 1.8);\nfor (const q of sparks) { q.x += q.vx; q.y += q.vy; q.vy += 0.06; q.vx *= 0.96; q.t--; }\nsparks = sparks.filter((q) => q.t > 0);\nfor (const b of bs) { (b.tr = b.tr || []).unshift([b.x, b.y]); if (b.tr.length > 3) b.tr.pop(); }\n}\nfunction needs(k) {\nif (!mission) return false;\nconst d = MISSIONS[mission.r], m = { ...mission, set: { ...mission.set } }, before = JSON.stringify(m);\nreturn d.on(m, k) || JSON.stringify(m) !== before || (d.multi && (k === 'rampL' || k === 'rampR'));\n}\nconst INS = { off: [[11, 5, 1], [15, 8, 2]], mid: [[21, 11, 3], [29, 21, 8]], on: [[31, 21, 6], [31, 31, 22]] };\nconst INS_G = { off: [[9, 1, 6], [13, 3, 9]], mid: [[19, 4, 13], [29, 13, 22]], on: [[30, 9, 21], [31, 27, 31]] };\nfunction lightInserts() {\nconst C = ART.colors, attract = demo || state === 'title' || state === 'players', blink = clock % 24 < 14;\nconst want = attract ? [0, 1, 2].map((i) => (clock >> 4) % 3 === i)\n: [(!mission && !lamps[2]) || needs('rampL') || needs('orbitL'), (!mission && !lamps[2]) || needs('rampR') || needs('orbitR'), gateOpen() || needs('gate')];\n[[C.INS_L0, C.INS_L1, INS], [C.INS_R0, C.INS_R1, INS], [C.INS_G0, C.INS_G1, INS_G]].forEach(([a, b, T], i) => {\nconst c = want[i] ? (blink || attract ? T.on : T.mid) : T.off;\ncolor(a, ...c[0]); color(b, ...c[1]);\n});\n}\nconst NEB_STOPS = [[0, 2, 2, 7], [70, 8, 2, 11], [130, 3, 2, 8], [220, 2, 6, 9], [290, 2, 3, 7], [360, 6, 1, 9], [420, 2, 2, 6]];\nconst NEB = [...Array(424).keys()].map((v) => {\nlet k = 0; while (k < NEB_STOPS.length - 2 && v > NEB_STOPS[k + 1][0]) k++;\nconst [a, ...p] = NEB_STOPS[k], [b, ...q] = NEB_STOPS[k + 1], t = clamp((v - a) / (b - a), 0, 1);\nreturn p.map((c, i) => c + (q[i] - c) * t);\n});\nconst SKY = new Int32Array(224);\nfunction paintSky(cy) {\nviewY = cy;\nfor (let y = 0; y < 224; y++) {\nconst v = Math.round(y + cy * 0.3), [r, g, b] = NEB[clamp(v, 0, NEB.length - 1)], w = warmth, d = (v & 1) * 0.5;\nSKY[y] = flr(clamp(r + w * 4 + d, 0, 31)) | flr(clamp(g + w * 2 + d, 0, 31)) << 5 | flr(clamp(b - w * 3 + d, 1, 31)) << 10;\n}\n}\nfunction scanline(y) { const c = SKY[y]; color(0, c & 31, (c >> 5) & 31, c >> 10); }\nconst SEGS = [0x3f, 0x06, 0x5b, 0x4f, 0x66, 0x6d, 0x7d, 0x07, 0x7f, 0x6f];\nconst SEG_R = [[1, 0, 4, 2], [4, 1, 2, 4], [4, 6, 2, 4], [1, 9, 4, 2], [0, 6, 2, 4], [0, 1, 2, 4], [1, 5, 4, 1]];\nfunction led(v, x, y, n) {\nconst C = ART.colors, s = String(v);\nif (s.length > n) { x -= (s.length - n) * 7; n = s.length; }\nrectfill(x - 2, y - 2, n * 7 + 3, 15, C.LED_BG);\nfor (let i = 0; i < n; i++) {\nconst ch = s[s.length - n + i], on = ch === undefined ? 0 : SEGS[+ch], dx = x + i * 7;\nSEG_R.forEach(([sx, sy, w, h], k) => rectfill(dx + sx, y + sy, w, h, on >> k & 1 ? C.LED_ON : C.LED_OFF));\nif (on & 1) rectfill(dx + 1, y, 4, 1, C.LED_HI);\n}\n}\nfunction draw() {\ncls();\nconst inPlay = state === 'play' || state === 'over' || state === 'turn' || state === 'bonus', menu = state === 'title' || state === 'players';\nif (!inPlay && !menu) { bg(0, { show: false }); bg(1, { show: false }); paintSky(viewY); bg(2, { y: Math.round(viewY * 0.45 + clock * 0.05) }); }\nif (inPlay) drawPlay();\nelse if (menu) { drawTable(Math.round(96 + 96 * Math.sin(clock / 300))); drawMenuPanel(); if (state === 'title') drawTitle(); else drawPlayers(); }\nelse if (state === 'initials') drawInitials();\nelse if (state === 'records') drawRecords();\nif (state === 'turn') drawTurn();\nelse if (state === 'bonus') drawBonus();\nelse if (state === 'over') drawOver();\nif (paused) drawPause();\n}\nfunction drawPlay() {\nconst cy = Math.round(camY) + (shake > 0 ? (shake & 1 ? 2 : -2) : 0);\ndrawTable(cy);\nif (glare > 0) {\nconst step = glare > 34 ? 1 : glare > 16 ? 2 : 4;\nfor (let y = clock % step; y < 224; y += step) line(0, y, TABLE_W - 1, y, 193);\n}\nif (mission || (banner && banner.t > 0)) drawBanner();\ndrawPanel(cy);\nif (demo && clock % 60 < 40) ctab('DEMO: PRESS ANY BUTTON', 196, WHITE);\n}\nconst inOrbit = (b) => b.y > ORBIT_Y - 10 && b.y < ORBIT_IN + 10 && (b.x < ORBIT_X[0] || (b.x > ORBIT_X[1] && b.x < LANE_X));\nfunction drawTable(cy) {\nconst sy = (y) => Math.round(y - cy), R = Math.round, S = ART.sprites, B = ART.big;\nbg(0, { y: cy, show: true }); bg(1, { y: cy, show: true });\nbg(2, { y: Math.round(cy * 0.45 + clock * 0.05) });\npaintSky(cy); lightInserts();\nconst P = { prio: 2 };\nconst lamp = (x, y, on) => {\nif (on) sprite(S.glow, R(x) - 8, sy(y) - 8, { pal: 4, prio: 1 });\nsprite(on ? S.lamp_on : S.lamp, R(x) - 4, sy(y) - 4, { prio: 1 });\n};\nLANE_XS.forEach((x, i) => lamp(x, LANE_Y, laneLit[i]));\nRAMPS.forEach((r) => lamp(r.ex, r.ey + 14, r.lit));\nlamp(8, 588, kickback);\nlamps.forEach((on, i) => lamp(76 + i * 12, 124, on));\nconst menu = state === 'title' || state === 'players';\nRANK_LAMPS.forEach(([x, y], k) => lamp(x, y, career || k < rk || (k === rk && !menu && clock % 40 < 24)));\nif (lamps.every(Boolean) && !mission && clock % 30 < 20) sprite(S.glow, GATE.x - 8, sy(GATE.y) - 8, { pal: 4, prio: 1 });\nfor (const e of BUMPERS) {\nsprite(e.flash ? S.bump_hit : S.bump, e.x - 16, sy(e.y) - 16, P);\nif (e.flash) sprite(e.flash > HIT_FLASH / 2 ? S.ring0 : S.ring1, e.x - 16, sy(e.y) - 16, { prio: 3 });\n}\nSLINGS.forEach((e, k) => bigSprite(B[e.flash ? 'sling_hit' : 'sling'], k ? 123 : 22, sy(476), { ...P, fx: !!k }));\nSTANDUPS.forEach((e, k) => sprite(e.lit ? S.stand_hit : S.stand, k < 2 ? e.x0 - 3 : e.x0 - 28, sy(e.y0 - 5.5), { ...P, fx: k >= 2 }));\nfor (const e of DROPS) sprite(e.down ? S.drop_down : S.drop, R(e.x0 - 3), sy(e.y0 - 6), P);\nsprite(S['spin' + (flr(spinPhase) & 3)], 4, sy(240) - 8, P);\nconst pull = inLane() && plunge > 0 ? plunge * 12 : 0;\nsprite(S.plunger, LANE_X, sy(LANE_FLOOR - 1 + pull), P);\nfor (let i = 0; i < 3; i++) sprite(S.spring, LANE_X + 4, sy(LANE_FLOOR + 6 + pull + i * 8), P);\nflips.forEach((f, k) => {\nconst n = clamp(R((REST_A - f.a) / (REST_A - UP_A) * 8), 0, 8);\nbigSprite(B['flip' + n], R(k ? f.x - 38 : f.x - 10), sy(f.y) - 24, { ...P, fx: !!k });\n});\nfor (const b of bs) {\nconst pr = { prio: b.ramp || inOrbit(b) ? 3 : 2 }, t = b.tr || [];\nsprite(S.ball, R(b.x) - 8, sy(b.y + (b === ball && inLane() && plunge > 0 ? plunge * 12 : 0)) - 8, pr);\nif (b.hold) sprite(clock % 12 < 6 ? S.ring0 : S.ring1, GATE.x - 16, sy(GATE.y) - 16, { prio: 3, pal: 5 });\nelse if (t.length > 2 && Math.hypot(t[0][0] - t[1][0], t[0][1] - t[1][1]) > TRAIL_MIN) {\nconst dx = t[2][0] - t[0][0], dy = t[2][1] - t[0][1], L = Math.hypot(dx, dy) || 1;\nfor (let k = 0; k < 3; k++) { const d = Math.min(L, 5 * (k + 1)); sprite(S['trail' + k], R(b.x + dx / L * d) - 8, sy(b.y + dy / L * d) - 8, pr); }\n}\n}\nfor (const q of sparks) sprite(q.t > SPARK_LIFE / 2 ? S.spark0 : S.spark1, R(q.x) - 4, sy(q.y) - 4, { prio: 3 });\n}\nconst short = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e5 ? Math.floor(n / 1000) + 'K' : String(n));\nfunction drawPanel(cy) {\nconst R = Math.round;\npanelGlass();\ntxt(nPlayers > 1 ? `PLAYER ${cur + 1}` : 'SCORE', 196, 3, GOLD);\nled(score, 197, 14, 8);\ntxt(`BALL ${Math.min(BALLS, BALLS + 1 - balls)}`, 198, 32, balls > 1 ? DIM : RED);\ntxt(RANK_SHORT[rk], 198, 44, career ? GOLD : CYAN);\nif (mult > 1) txt(`MULT X${mult}`, 198, 56, CYAN);\nif (saveT > 0 && clock % 40 < 28) txt('SAVE', 198, 66, GREEN);\nif (msgT > 0 && (msgT > 30 || msgT % 8 < 5)) msg.split(' ').forEach((w, i) => txt(w, 198, 76 + i * 9, tilted ? RED : GOLD));\nsprite(ART.sprites['badge' + rk], 237, 104);\nconst mx = 208, my = 104;\nrect(mx - 1, my - 1, TABLE_W / 8 + 2, TABLE_H / 8 + 2, PANEL);\nrect(mx, my + R(cy / 8), TABLE_W / 8, VIEW_H / 8, DIM);\nfor (const b of bs) rectfill(mx + R(b.x / 8) - 1, my + R(b.y / 8) - 1, 2, 2, WHITE);\nif (nPlayers > 1) players.forEach((q, i) => {\nconst v = short(i === cur ? score : q.score);\ntxt(`${i + 1}`, 194, 189 + i * 9, i === cur ? GOLD : DIM); txt(v, 252 - v.length * 8, 189 + i * 9, i === cur ? WHITE : DIM);\n});\n}\nfunction drawBanner() {\nrectfill(0, 0, TABLE_W, 26, ART.colors.GLASS);\nif (mission) {\nconst d = MISSIONS[mission.r], sec = Math.ceil(mission.left / 60);\nctab(d.name, 3, GOLD); ctab(d.text(mission) + '  ' + Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0'), 14, sec <= 10 && clock % 20 < 10 ? RED : WHITE);\n} else { ctab(banner.a, 3, GOLD); ctab(banner.b, 14, WHITE); }\n}\nconst ctab = (s, y, c) => txt(s, 96 - s.length * 4, y, c);\nfunction drawTurn() {\npanel(24, 76, 144, 56);\nctab(`PLAYER ${cur + 1}`, 88, GOLD);\nctab(`BALL ${BALLS + 1 - balls}`, 102, WHITE);\nif (timer % 60 < 40) ctab('HOLD A BUTTON', 118, WHITE);\n}\nfunction drawBonus() {\nconst r = bonusRes, v = bonusShown();\npanel(16, 64, 160, 88);\nctab('BALL BONUS', 72, GOLD);\nctab(`${r.base}`, 90, WHITE);\nctab(`X ${r.mult}`, 102, CYAN);\nctab(String(v), 120, v >= r.total ? GOLD : WHITE);\nif (timer >= BONUS_COUNT && timer % 60 < 40) ctab('A: CONTINUE', 138, DIM);\n}\nfunction drawOver() {\nconst best = Math.max(...players.map((q) => q.score));\npanel(8, 56, 240, 44 + players.length * 14 + (newBest ? 14 : 0) + 16);\nctxt('GAME OVER', 64, RED);\nplayers.forEach((q, i) => {\nconst y = 84 + i * 14, top = nPlayers > 1 && q.score === best;\ntxt(nPlayers > 1 ? `P${i + 1}` : '', 20, y, top ? GOLD : DIM);\ntxt(rankLabel(rankNo(q)), 44, y, CYAN); txt(String(q.score), 236 - String(q.score).length * 8, y, top ? GOLD : WHITE);\n});\nif (newBest) ctxt(`NEW BEST RANK: ${rankLabel(newBest)}`, 84 + players.length * 14, GOLD);\nif (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 84 + players.length * 14 + (newBest ? 14 : 0) + 4, DIM);\n}\nfunction drawMenuPanel() {\npanelGlass();\nconst best = dget(BEST_SLOT), top = readEntry(0);\ntxt('HIGH', 196, 3, GOLD); led(top.score, 197, 14, 8);\ntxt('BEST', 198, 40, DIM); txt(best ? rankLabel(best) : '-', 198, 52, GOLD);\nif (best) sprite(ART.sprites['badge' + Math.min(8, best - 1)], 220, 66);\ntxt('GAMES', 198, 92, DIM); txt(String(dget(GAMES_SLOT)), 198, 104, WHITE);\n}\nfunction panelGlass() {\nrectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS);\nline(TABLE_W, 0, TABLE_W, 223, SHADOW); line(TABLE_W + 1, 0, TABLE_W + 1, 223, PANEL);\n}\nfunction drawPlayers() {\npanel(18, 90, 156, 82);\nctab('HOW MANY PLAYERS?', 98, GOLD);\nfor (let i = 1; i <= 4; i++) {\nconst x = 30 + (i - 1) * 34, on = i === nPlayers;\nif (on) rect(x - 4, 114, 24, 24, GOLD);\ntxt(String(i), x + 4, 123, on ? WHITE : DIM);\n}\nctab('LEFT / RIGHT: CHOOSE', 146, DIM); ctab('A: START   B: BACK', 158, DIM);\n}\nfunction drawTitle() {\n[['logo_star', 6], ['logo_cadet', 38], ['logo_pinball', 76]].forEach(([n, y]) => bigSprite(ART.big[n], 96 - ART.big[n].w / 2, y, { prio: 3 }));\nfor (let k = 0; k < 3; k++) {\nconst f = clock + k * 23, n = flr(f / 40), h = (n * 2654435761 + k * 40503) >>> 0;\nif (f % 40 < 12) sprite(f % 40 < 6 ? ART.sprites.spark0 : ART.sprites.spark1, 36 + h % 120, 10 + (h >>> 8) % 84, { prio: 3 });\n}\npanel(32, 118, 128, 50);\n['PLAY', 'RECORDS'].forEach((t, i) => ctab(`${i === titleSel ? '> ' : '  '}${t}`, 128 + i * 16, i === titleSel ? WHITE : DIM));\nctab('1 TO 4 PLAYERS', 184, DIM);\n}\nfunction drawRecords() {\npanel(8, 12, 240, 200);\nctxt('TOP 10', 20, GOLD);\ntopTen().forEach((e, i) => {\nconst y = 40 + i * 14, on = i === hl;\nif (on && timer % 40 < 30) rectfill(12, y - 2, 232, 12, PANEL);\ntxt(String(i + 1).padStart(2), 18, y, i === 0 ? GOLD : DIM);\ntxt(e.score ? e.initials : '---', 46, y, on ? GOLD : WHITE);\ntxt(e.score ? String(e.score).padStart(8) : '', 84, y, i === 0 ? GOLD : WHITE);\nif (e.score) txt(rankLabel(e.rn), 160, y, CYAN);\n});\nconst best = dget(BEST_SLOT);\nctxt(`BEST RANK ${best ? rankLabel(best) : '-'}   GAMES ${dget(GAMES_SLOT)}`, 184, DIM);\nif (timer % 60 < 40) ctxt('START: BACK', 198, WHITE);\n}\nfunction drawInitials() {\nconst ini = initials;\npanel(24, 40, 208, 144);\nctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\nctxt((nPlayers > 1 ? `PLAYER ${ini.who + 1}: ` : '') + String(players[ini.who].score), 68, WHITE);\nctxt('ENTER YOUR INITIALS', 90, DIM);\nfor (let i = 0; i < 3; i++) {\nconst on = i === ini.pos, x = 84 + i * 32;\nrect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\ntxt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n}\nif (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\nfunction drawPause() {\npanel(64, 80, 128, 64);\nctxt('PAUSED', 88, GOLD);\n['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

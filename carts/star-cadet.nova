{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Star Cadet Pinball",
    "author": "NOVA-16",
    "description": "A tall scrolling pinball table: ranks, missions and 1 to 4 players."
  },
  "label": "",
  "code": "// Star Cadet Pinball\n// Scaffolded by tools/new-cart.js. A tiny working game (dodge the falling blocks) around everything every cart\n// needs: a title, play, pause, game over, a saved top 10 with initials, a records screen, sound and music cues,\n// a skipTitle hook and save slots. Replace the play part, keep the frame. See docs/dev/playbook.md.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"ball\": {\"pal\": 0, \"size\": 16, \"tile\": 480}, \"bump\": {\"pal\": 2, \"size\": 32, \"tile\": 512}, \"bump_hit\": {\"pal\": 2, \"size\": 32, \"tile\": 516}, \"drop\": {\"pal\": 3, \"size\": 16, \"tile\": 674}, \"drop_down\": {\"pal\": 3, \"size\": 16, \"tile\": 676}, \"glow\": {\"pal\": 4, \"size\": 16, \"tile\": 704}, \"lamp\": {\"pal\": 3, \"size\": 8, \"tile\": 678}, \"lamp_on\": {\"pal\": 3, \"size\": 8, \"tile\": 679}, \"plunger\": {\"pal\": 3, \"size\": 16, \"tile\": 714}, \"spin0\": {\"pal\": 3, \"size\": 16, \"tile\": 706}, \"spin1\": {\"pal\": 3, \"size\": 16, \"tile\": 708}, \"spin2\": {\"pal\": 3, \"size\": 16, \"tile\": 710}, \"spin3\": {\"pal\": 3, \"size\": 16, \"tile\": 712}, \"spring\": {\"pal\": 3, \"size\": 8, \"tile\": 694}, \"stand\": {\"pal\": 3, \"size\": 16, \"tile\": 646}, \"stand_hit\": {\"pal\": 3, \"size\": 16, \"tile\": 672}},\n  scenes: {\"decor\": {\"h\": 80, \"mx\": 24, \"my\": 0, \"pal\": 2, \"w\": 24}, \"decor_hi\": {\"h\": 80, \"mx\": 24, \"my\": 0, \"pal\": 2, \"w\": 24}, \"floor\": {\"h\": 80, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 24}, \"stars\": {\"h\": 28, \"mx\": 48, \"my\": 0, \"pal\": 3, \"w\": 8}},\n  colors: {\"GLASS\": 200},\n  big: {\"flip0\": {\"h\": 48, \"parts\": [[0, 16, 482, 16, 1, 0], [16, 16, 484, 16, 1, 0], [16, 32, 486, 16, 1, 0], [32, 32, 488, 16, 1, 0]], \"w\": 48}, \"flip1\": {\"h\": 48, \"parts\": [[0, 16, 490, 16, 1, 0], [16, 16, 492, 16, 1, 0], [32, 24, 494, 8, 1, 0], [16, 32, 495, 8, 1, 0], [24, 32, 510, 8, 1, 0], [32, 32, 520, 16, 1, 0]], \"w\": 48}, \"flip2\": {\"h\": 48, \"parts\": [[0, 16, 522, 16, 1, 0], [16, 16, 524, 16, 1, 0], [32, 24, 511, 8, 1, 0], [40, 24, 526, 8, 1, 0], [24, 32, 527, 8, 1, 0], [32, 32, 542, 8, 1, 0], [40, 32, 543, 8, 1, 0]], \"w\": 48}, \"flip3\": {\"h\": 48, \"parts\": [[0, 16, 552, 16, 1, 0], [16, 16, 554, 16, 1, 0], [32, 16, 556, 16, 1, 0], [32, 32, 558, 8, 1, 0], [40, 32, 559, 8, 1, 0]], \"w\": 48}, \"flip4\": {\"h\": 48, \"parts\": [[0, 16, 576, 16, 1, 0], [16, 16, 578, 16, 1, 0], [32, 16, 580, 16, 1, 0]], \"w\": 48}, \"flip5\": {\"h\": 48, \"parts\": [[0, 16, 582, 16, 1, 0], [16, 16, 584, 16, 1, 0], [32, 16, 586, 16, 1, 0]], \"w\": 48}, \"flip6\": {\"h\": 48, \"parts\": [[24, 8, 574, 8, 1, 0], [0, 16, 588, 16, 1, 0], [16, 16, 590, 16, 1, 0], [32, 8, 575, 8, 1, 0], [40, 8, 608, 8, 1, 0], [32, 16, 609, 8, 1, 0], [40, 16, 610, 8, 1, 0]], \"w\": 48}, \"flip7\": {\"h\": 48, \"parts\": [[16, 8, 611, 8, 1, 0], [24, 8, 612, 8, 1, 0], [0, 16, 614, 16, 1, 0], [16, 16, 616, 16, 1, 0], [32, 8, 613, 8, 1, 0], [40, 8, 618, 8, 1, 0], [32, 16, 619, 8, 1, 0], [40, 16, 620, 8, 1, 0]], \"w\": 48}, \"flip8\": {\"h\": 48, \"parts\": [[16, 8, 621, 8, 1, 0], [24, 8, 622, 8, 1, 0], [0, 16, 640, 16, 1, 0], [16, 16, 642, 16, 1, 0], [32, 0, 644, 16, 1, 0], [32, 16, 558, 8, 1, 1]], \"w\": 48}, \"logo_cadet\": {\"h\": 27, \"parts\": [[0, 0, 776, 32, 3, 0], [32, 0, 780, 32, 3, 0], [64, 0, 832, 32, 3, 0], [96, 0, 836, 32, 3, 0]], \"w\": 123}, \"logo_pinball\": {\"h\": 19, \"parts\": [[0, 0, 736, 16, 3, 0], [16, 0, 738, 16, 3, 0], [32, 0, 740, 16, 3, 0], [48, 0, 742, 16, 3, 0], [64, 0, 744, 16, 3, 0], [80, 0, 746, 16, 3, 0], [96, 0, 746, 16, 3, 0]], \"w\": 115}, \"logo_star\": {\"h\": 27, \"parts\": [[0, 0, 716, 32, 3, 0], [32, 0, 768, 32, 3, 0], [64, 0, 772, 32, 3, 0]], \"w\": 99}, \"sling\": {\"h\": 96, \"parts\": [[8, 0, 623, 8, 3, 0], [8, 8, 624, 8, 3, 0], [8, 16, 625, 8, 3, 0], [8, 24, 626, 8, 3, 0], [16, 24, 627, 8, 3, 0], [0, 32, 648, 32, 3, 0], [8, 64, 628, 8, 3, 0], [16, 64, 629, 8, 3, 0]], \"w\": 32}, \"sling_hit\": {\"h\": 96, \"parts\": [[8, 0, 634, 8, 3, 0], [8, 8, 635, 8, 3, 0], [8, 16, 636, 8, 3, 0], [8, 24, 637, 8, 3, 0], [16, 24, 638, 8, 3, 0], [0, 32, 652, 32, 3, 0], [8, 64, 628, 8, 3, 0], [16, 64, 639, 8, 3, 0]], \"w\": 32}},\n  anims: {\"flip\": [\"flip0\", \"flip1\", \"flip2\", \"flip3\", \"flip4\", \"flip5\", \"flip6\", \"flip7\", \"flip8\"]},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 2, BEST_SLOT = 1, GAMES_SLOT = 2, INITIALS_SLOT = 3; // the best rank reached (1 to 10: 10 is the finished career), games played, the last initials\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: score, initials, rank number (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)), rn: dget(s + 2) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, e.rn || 0); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- The table and its physics (SPEC 4, 5). World pixels: x 0 to 192 across, y 0 to 640 down; the ball is 5 px in radius. ---\n// All the numbers are here, in one place, because only playing can say how the ball should feel.\n\nconst TABLE_W = 192, TABLE_H = 640, VIEW_H = 224;\nconst BR = 5, SUB = 4; // ball radius; substeps a frame (a substep moves the ball at most 3.5 px, under its radius)\nconst GRAV = 0.12, VMAX = 14; // px per frame squared; px per frame\nconst WALL_E = 0.45, FLIP_E = 0.7, REST_CUT = 0.3; // bounce of a wall and of a flipper; below this normal speed a hit does not bounce\nconst FLEN = 34, FR = 4; // a flipper is a capsule: length, radius\nconst REST_A = 30 * Math.PI / 180, UP_A = -28 * Math.PI / 180; // its angle (down is positive), at rest and held up\nconst W_UP = (REST_A - UP_A) / 4, W_DOWN = (REST_A - UP_A) / 6; // radians a frame: up in 4 frames, down in 6\nconst LANE_X = 176, LANE_FLOOR = 612, BALL_HOME = { x: 184, y: LANE_FLOOR - BR };\nconst PLUNGE_FRAMES = 60; // held this long is full power; the launch speed is 4 + 10 x power\nconst DRAIN_Y = 632;\n\n/** The walls: segments [x0, y0, x1, y1, r] (r: a post's radius, else 0). A top arch of radius 96 over the table, the plunger\n *  lane on the right, the outlanes and inlanes with their guides down to the flippers, the two orbits' inner guides (with gaps\n *  where the standup targets are) and the posts between the top lanes. */\nconst WALLS = (() => {\n  const w = [];\n  for (let i = 0; i < 16; i++) { // the arch: a half circle of 16 segments\n    const a0 = Math.PI + (Math.PI * i) / 16, a1 = Math.PI + (Math.PI * (i + 1)) / 16;\n    w.push([96 + 96 * Math.cos(a0), 96 + 96 * Math.sin(a0), 96 + 96 * Math.cos(a1), 96 + 96 * Math.sin(a1)]);\n  }\n  w.push([0, 96, 0, TABLE_H]); // the left wall, on down past the outlane\n  w.push([TABLE_W, 96, TABLE_W, LANE_FLOOR]); // the right wall of the lane\n  w.push([LANE_X, 120, LANE_X, LANE_FLOOR]); // the lane's inner wall, which is also the right outlane's outer wall\n  w.push([LANE_X, LANE_FLOOR, TABLE_W, LANE_FLOOR]); // the lane's floor\n  for (const m of [0, 1]) { // the two sides, the right one mirrored about x = 88\n    const X = (x) => (m ? 176 - x : x);\n    w.push([X(16), 492, X(16), 540], [X(16), 540, X(48), 588]); // the inlane guide: the outlane is outside it, the inlane inside\n    w.push([X(32), 480, X(32), 545], [X(32), 545, X(44), 545]); // the back and bottom of the slingshot\n    w.push([X(24), 150, X(24), 190], [X(24), 204, X(24), 262], [X(24), 276, X(24), 330]); // the orbit's inner guide\n  }\n  w.push([70, 44, 70, 76, 2], [106, 44, 106, 76, 2]); // the posts between the three top lanes\n  return w;\n})();\n/** The elements. Bumpers and slingshots kick the ball; standup targets light; drop targets go down; a ramp carries the ball. */\nconst BUMP_R = 11, BUMP_KICK = 6, SLING_KICK = 7, COOL = 8, HIT_FLASH = 6; // radius; the least speed away from it; frames\nconst BUMPERS = [[66, 168], [110, 168], [88, 204]].map(([x, y]) => ({ x, y, flash: 0, cool: 0 }));\nconst SLINGS = [[32, 480, 44, 545], [144, 480, 132, 545]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, flash: 0, cool: 0 }));\nconst STANDUPS = [[24, 190, 24, 204], [24, 262, 24, 276], [152, 190, 152, 204], [152, 262, 152, 276]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, lit: false, flash: 0, cool: 0 }));\nconst DROPS = [0, 1, 2].map((i) => ({ x0: 71 + 10 * i, y0: 287 + 10 * i / 3, x1: 80 + 10 * i, y1: 290 + 10 * i / 3, down: false, flash: 0 })); // slanted, so a ball cannot balance on it\nconst TARGET_R = 2, DROP_RESET = 90; // a target's radius; the frames before a cleared bank comes back up\nconst LANE_XS = [52, 88, 124], LANE_Y = 62, LANE_HW = 18; // the three top lanes: where their rollover sensors are\nconst GATE = { x: 88, y: 104, r: 7 }, GATE_HOLD = 45, NOGATE = 150; // substeps // the kickout hole; frames the ball is held\nconst SPIN = { x0: 4, x1: 20, y0: 226, y1: 254, per: 8 }; // the spinner in the left orbit: a spin for each 8 px of travel\nconst ORBIT_Y = 160, ORBIT_IN = 330, ORBIT_X = [24, 152]; // an orbit counts when the ball goes up its lane from y 330 to y 160\nconst RAMPS = [\n  { ex: 40, ey: 420, tx: 12, ty: 165, evx: 1.5, evy: 2, lit: false }, // the left ramp: up the table, out at the top of the left orbit\n  { ex: 136, ey: 420, tx: 164, ty: 165, evx: -1.5, evy: 2, lit: false },\n].map((r) => ({ ...r, len: Math.hypot(r.tx - r.ex, r.ty - r.ey) }));\n// Wire gates at the top and the bottom of the two orbit lanes: a slanted rail that only stops a ball coming down, so a ball from the\n// plunger is turned into the table, and a ball up an orbit goes through.\nconst ONEWAY = [[0, 142, 22, 152], [176, 142, 154, 152], [0, 358, 22, 370], [176, 358, 154, 370]]; // and a ball coming out of an orbit is turned into the table, not into the outlane\nconst RAMP_SPEED = 7, RAMP_IN = 12, RAMP_MIN = 4; // px a frame along a ramp; the entrance's radius; the least speed up the table to get on\nconst KICKBACK = { x: 16, y0: 575, y1: 606, v: 13 }; // the left outlane's kickback\nconst PTS = { bump: 100, sling: 10, standup: 500, drop: 1000, bank: 5000, spin: 100, ramp: 1000, rampLit: 2500, orbit: 2000, lane: 500, gate: 5000 };\nlet spinPhase = 0, stats = {}, laneLit = [false, false, false], kickback = true, spinAcc = 0, dropTimer = 0, gateSide = 1;\nconst resetStats = () => { stats = { bump: 0, sling: 0, standup: 0, drop: 0, bank: 0, spin: 0, ramp: 0, rampL: 0, rampR: 0, orbit: 0, orbitL: 0, orbitR: 0, lane: 0, laneDone: 0, standupDone: 0, gate: 0, kick: 0 }; };\nresetStats();\n\n/** Flippers: pivot, side (+1 points right), angle, and the last swing (radians a frame, for the ball). */\nconst makeFlippers = () => [{ x: 48, y: 588, s: 1, a: REST_A, w: 0 }, { x: 128, y: 588, s: -1, a: REST_A, w: 0 }];\nconst flipTip = (f) => ({ x: f.x + f.s * FLEN * Math.cos(f.a), y: f.y + FLEN * Math.sin(f.a) });\n\nlet CN = [0, -1]; // the normal of the last collision\n/** Push the ball out of a capsule (or a segment, r 0) and bounce it. vsAt(t): the surface's velocity at the contact. */\nfunction collide(b, x0, y0, x1, y1, r, e, vsAt) {\n  const dx = x1 - x0, dy = y1 - y0, len2 = dx * dx + dy * dy;\n  const t = len2 ? clamp(((b.x - x0) * dx + (b.y - y0) * dy) / len2, 0, 1) : 0;\n  const cx = x0 + dx * t, cy = y0 + dy * t, ox = b.x - cx, oy = b.y - cy, d2 = ox * ox + oy * oy, reach = BR + r;\n  if (d2 >= reach * reach) return false;\n  const d = Math.sqrt(d2), nx = d ? ox / d : 0, ny = d ? oy / d : -1;\n  b.x = cx + nx * reach; b.y = cy + ny * reach; CN = [nx, ny];\n  const vs = vsAt ? vsAt(t) : [0, 0];\n  const vn = (b.vx - vs[0]) * nx + (b.vy - vs[1]) * ny;\n  if (vn < 0) {\n    const k = -(1 + (vn > -REST_CUT ? 0 : e)) * vn;\n    b.vx += k * nx; b.vy += k * ny;\n  }\n  return true;\n}\n/** Make the ball leave the last thing it hit at least this fast. */\nfunction kick(b, v) {\n  const vn = b.vx * CN[0] + b.vy * CN[1];\n  if (vn < v) { b.vx += (v - vn) * CN[0]; b.vy += (v - vn) * CN[1]; }\n}\n/** An element was hit: true once in a while (its cooldown), so a ball touching it for several substeps scores once. */\nfunction struck(el) { if (el.cool > 0) return false; el.cool = COOL; el.flash = HIT_FLASH; return true; }\n// The rules' numbers (SPEC 5 and 9).\nconst SAVE_FRAMES = 12 * 60, EXTRA_AT = 500000, MULT_MAX = 6, NUDGE_V = 1.2, NUDGE_WARN = 3, NUDGE_TILT = 4, BALLS = 3;\nconst BONUS = { standup: 1000, drop: 500, bank: 5000, ramp: 2000, orbit: 2000, gate: 5000 }; // what each shot adds to the end-of-ball bonus\nlet evq = []; const emit = (k) => { evq.push(k); }; // what the ball did this frame, for the missions: bump sling standup standupSet drop bank spin rampL rampR orbitL orbitR gate lane jackpot\nlet bs = []; // every ball in play (the first is `ball`)\nlet mult = 1, bonus = 0, extraBalls = 0, extraGiven = false, msg = '', msgT = 0;\nfunction say(t) { msg = t; msgT = 150; }\nconst earn = (k) => { bonus += BONUS[k]; };\nfunction award(n) {\n  score += n;\n  if (!extraGiven && score >= EXTRA_AT) { extraGiven = true; extraBalls++; say('EXTRA BALL'); fx(SFX.record); }\n}\n\n/** The sensors and the things that move the ball by themselves: lanes, spinner, orbits, the gate, ramps and the kickback. */\nfunction sensors(b) {\n  LANE_XS.forEach((x, i) => {\n    if (Math.abs(b.x - x) < LANE_HW && Math.abs(b.y - LANE_Y) < 6 && !laneLit[i]) {\n      laneLit[i] = true; stats.lane++; award(PTS.lane); emit('lane'); fx(SFX.point);\n      if (laneLit.every(Boolean)) { stats.laneDone++; laneLit = [false, false, false]; if (mult < MULT_MAX) { mult++; say('BONUS X' + mult); } }\n    }\n  });\n  if (b.x > SPIN.x0 && b.x < SPIN.x1 && b.y > SPIN.y0 && b.y < SPIN.y1) {\n    spinAcc += Math.abs(b.vy) / SUB; spinPhase += Math.abs(b.vy) / SUB / 4;\n    while (spinAcc >= SPIN.per) { spinAcc -= SPIN.per; stats.spin++; award(PTS.spin); emit('spin'); }\n  }\n  ORBIT_X.forEach((ox, k) => {\n    const inL = k === 0 ? b.x < ox : b.x > ox && b.x < LANE_X, side = b.y > ORBIT_Y - 10 && b.y < ORBIT_IN + 10;\n    if (inL && b.y > ORBIT_IN - 14 && b.y < ORBIT_IN + 6 && b.vy < -1) b.arm[k] = true;\n    else if (b.arm[k] && inL && b.y < ORBIT_Y) { b.arm[k] = false; stats.orbit++; stats[k ? 'orbitR' : 'orbitL']++; award(PTS.orbit); earn('orbit'); emit(k ? 'orbitR' : 'orbitL'); fx(SFX.point); }\n    else if (b.arm[k] && !inL && side && b.y < ORBIT_IN - 20) b.arm[k] = false; // left the lane: no orbit\n  });\n  if (b.nogate > 0) b.nogate--; // a ball that has just left the gate does not fall into it again at once (the bumpers send it back up)\n  else if (Math.hypot(b.x - GATE.x, b.y - GATE.y) < GATE.r - 2) {\n    b.x = GATE.x; b.y = GATE.y; b.vx = b.vy = 0; b.hold = GATE_HOLD * SUB; stats.gate++; award(PTS.gate); earn('gate'); emit('gate'); fx(SFX.point);\n  }\n  for (const r of RAMPS) {\n    if (Math.hypot(b.x - r.ex, b.y - r.ey) < RAMP_IN && b.vy < -RAMP_MIN) { b.ramp = { r, d: 0 }; stats.ramp++; fx(SFX.point); }\n  }\n  if (kickback && b.x < KICKBACK.x && b.y > KICKBACK.y0 && b.y < KICKBACK.y1 && b.vy > 0) {\n    kickback = false; b.vx = 0.5; b.vy = -KICKBACK.v; stats.kick++; fx(SFX.point);\n  }\n}\n\n/** One frame of the table: the flippers swing and every ball moves, in SUB substeps. hold: the flippers' buttons [left, right]. */\nfunction stepTable(balls, flips, hold) {\n  for (let i = 0; i < SUB; i++) {\n    flips.forEach((f, k) => {\n      const a0 = f.a;\n      f.a = hold[k] ? Math.max(UP_A, f.a - W_UP / SUB) : Math.min(REST_A, f.a + W_DOWN / SUB);\n      f.w = (f.a - a0) * SUB;\n    });\n    for (const b of balls) stepBall(b, flips);\n  }\n  for (const e of [...BUMPERS, ...SLINGS, ...STANDUPS, ...DROPS]) { if (e.cool > 0) e.cool--; if (e.flash > 0) e.flash--; }\n  if (dropTimer > 0 && --dropTimer === 0) for (const e of DROPS) e.down = false;\n}\n\n/** One substep of one ball. */\nfunction stepBall(b, flips) {\n  if (b.ramp) { // carried along a ramp, above the table: nothing on it is touched\n    const r = b.ramp.r, d = (b.ramp.d += RAMP_SPEED / SUB), t = Math.min(1, d / r.len);\n    b.x = r.ex + (r.tx - r.ex) * t; b.y = r.ey + (r.ty - r.ey) * t; b.vx = b.vy = 0;\n    if (d >= r.len) { b.vx = r.evx; b.vy = r.evy; b.ramp = null; award(r.lit ? PTS.rampLit : PTS.ramp); earn('ramp'); stats[r === RAMPS[0] ? 'rampL' : 'rampR']++; emit(r === RAMPS[0] ? 'rampL' : 'rampR'); if (bs.length > 1) emit('jackpot'); }\n    return;\n  }\n  if (b.hold > 0) { // in the gate's hole\n    if (--b.hold === 0) { gateSide = -gateSide; b.y = GATE.y + GATE.r + 1; b.vx = 1.2 * gateSide; b.vy = 5; b.nogate = NOGATE; } // out of the hole's reach\n    return;\n  }\n  b.vy += GRAV / SUB;\n  const sp = Math.hypot(b.vx, b.vy);\n  if (sp > VMAX) { b.vx *= VMAX / sp; b.vy *= VMAX / sp; }\n  b.x += b.vx / SUB; b.y += b.vy / SUB;\n  for (const w of WALLS) collide(b, w[0], w[1], w[2], w[3], w[4] || 0, WALL_E);\n  if (b.vy > 0) for (const w of ONEWAY) collide(b, w[0], w[1], w[2], w[3], 0, WALL_E);\n  for (const e of BUMPERS) if (collide(b, e.x, e.y, e.x, e.y, BUMP_R, WALL_E)) {\n    kick(b, BUMP_KICK); if (struck(e)) { stats.bump++; award(PTS.bump); emit('bump'); fx(SFX.hit); }\n  }\n  for (const e of SLINGS) if (collide(b, e.x0, e.y0, e.x1, e.y1, 0, WALL_E)) {\n    kick(b, SLING_KICK); if (struck(e)) { stats.sling++; award(PTS.sling); emit('sling'); fx(SFX.move); }\n  }\n  for (const e of STANDUPS) if (collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E) && struck(e) && !e.lit) {\n    e.lit = true; stats.standup++; award(PTS.standup); earn('standup'); emit('standup'); fx(SFX.point);\n    if (STANDUPS.every((q) => q.lit)) { stats.standupDone++; emit('standupSet'); for (const q of STANDUPS) q.lit = false; }\n  }\n  for (const e of DROPS) if (!e.down && collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E)) {\n    e.down = true; e.flash = HIT_FLASH; stats.drop++; award(PTS.drop); earn('drop'); emit('drop'); fx(SFX.point);\n    if (DROPS.every((q) => q.down)) { stats.bank++; award(PTS.bank); earn('bank'); emit('bank'); dropTimer = DROP_RESET; }\n  }\n  sensors(b);\n  for (const f of flips) {\n    const tip = flipTip(f);\n    collide(b, f.x, f.y, tip.x, tip.y, FR, FLIP_E, (t) => {\n      const r = t * FLEN; // the contact's speed: its distance from the pivot times the turn\n      return [-f.s * Math.sin(f.a) * r * f.w, Math.cos(f.a) * r * f.w];\n    });\n  }\n}\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\n// The flippers: one hand each. Anything on the D-pad is the left flipper, any of the four buttons on the right is the right one.\nconst PAD_LEFT = [UP, DOWN, LEFT, RIGHT], PAD_RIGHT = [A, B, X, Y];\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, balls = BALLS, ball = null, flips = [], plunge = 0, camY = 0, held = [false, false], heldPrev = [false, false];\nlet wantPlayers = 1, newBest = 0, demo = false, idle = 0, titleCam = 0, rk = 0, lamps = [false, false, false], career = false, mission = null, banner = null, floorBase = [];\nlet nPlayers = 1, cur = 0, players = [], nudges = 0, tilted = false, saveT = 0, saved = false, shake = 0, bonusRes = null, initQueue = [], firstRank = -1;\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  // The table: the decor (rails, ramps ...) on layer 0, over the floor on layer 1; the starfield behind the panel on layer 2.\n  // (art.py draws all of them: the table's own numbers come from the physics block above.)\n  const d = ART.scenes.decor, f = ART.scenes.floor, st = ART.scenes.stars;\n  bg(0, { mx: d.mx, my: d.my, mw: d.w, mh: d.h, x: 0, y: 0, wrap: false, show: false });\n  bg(1, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, x: 0, y: 0, wrap: false, show: false });\n  bg(2, { mx: st.mx, my: st.my, mw: st.w, mh: st.h, x: 0, y: 0, wrap: true, show: true });\n  for (let i = 17; i < 32; i++) floorBase[i] = color(i); // the floor's colours, before the rank's light changes them\n  blend({ layers: ['overlay', 'spr'], op: 'add' }); // the panel's glass (overlay colours from 192) and the lamps' glow (sprite palette 4) add light\n  flips = makeFlippers(); ball = newBall(BALL_HOME.x, BALL_HOME.y); bs = []; // a table to show behind the menus\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; demo = false; idle = 0; nPlayers = wantPlayers; flips = makeFlippers(); bs = []; lamps = [false, false, false]; mission = null; banner = null; play(SONG.title); }\n\n/** The state of each player that is kept while the others play (the rest of the table is the ball's and starts again). */\nconst makePlayer = () => ({ score: 0, balls: BALLS, lanes: [false, false, false], stand: [false, false, false, false], extra: 0, given: false, rk: 0, lamps: [false, false, false], career: false });\nfunction loadPlayer(i) {\n  const q = players[i]; cur = i;\n  score = q.score; balls = q.balls; laneLit = q.lanes.slice(); extraBalls = q.extra; extraGiven = q.given;\n  rk = q.rk; lamps = q.lamps.slice(); career = q.career; applyRankLight();\n  STANDUPS.forEach((e, k) => { e.lit = q.stand[k]; });\n}\nfunction savePlayer() {\n  Object.assign(players[cur], { score, balls, lanes: laneLit.slice(), stand: STANDUPS.map((e) => e.lit), extra: extraBalls, given: extraGiven, rk, lamps: lamps.slice(), career });\n}\n\nfunction startGame(n = nPlayers) {\n  nPlayers = n; players = Array.from({ length: n }, makePlayer);\n  flips = makeFlippers(); resetStats(); msgT = 0; paused = false; timer = 0;\n  loadPlayer(0); beginBall();\n  state = n > 1 ? 'turn' : 'play';\n  play(SONG.play);\n}\n\n/** The attract mode: a game that plays itself (it scores nothing and records nothing) until a button is pressed. */\nfunction startDemo() { startGame(1); demo = true; play(SONG.title); }\n/** What a demo player does: pull the plunger to the full, then flip when the ball comes near a flipper. */\nfunction demoPad() {\n  const b = ball, pad = [false, false];\n  if (inLane() && bs.length === 1) { pad[0] = plunge < 0.97; return { pad, plunge: true }; }\n  flips.forEach((f, k) => {\n    const tip = flipTip(f);\n    for (const x of bs) if (x.y > 545 && x.vy > -2 && Math.abs(x.x - (f.x + tip.x) / 2) < 30 && Math.abs(x.y - (f.y + tip.y) / 2) < 22 && (k ? x.x > 76 : x.x < 100)) pad[k] = (clock >> 3) % 3 !== 2;\n  });\n  return { pad, plunge: false };\n}\n\n/** A new ball for the player whose turn it is: the things that belong to one ball start again. */\nfunction beginBall() {\n  mult = 1; bonus = 0; nudges = 0; tilted = false; saveT = 0; saved = false; shake = 0; kickback = true; dropTimer = 0; mission = null; evq = [];\n  for (const e of DROPS) e.down = false;\n  serve();\n}\n\nconst newBall = (x, y, hold = 0) => ({ x, y, vx: 0, vy: 0, ramp: null, hold, arm: [false, false] });\n\n/** The ball in the plunger lane (a saved ball comes back here too). */\nfunction serve() {\n  ball = newBall(BALL_HOME.x, BALL_HOME.y); bs = [ball]; plunge = 0;\n  camY = clamp(ball.y - 150, 0, TABLE_H - VIEW_H);\n}\nconst inLane = () => ball.x > LANE_X && ball.y > LANE_FLOOR - 40;\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'players') updatePlayers();\n  else if (state === 'turn') updateTurn();\n  else if (state === 'bonus') updateBonus();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nconst IDLE_DEMO = 20 * 60; // frames on the title before the table plays by itself\n\nfunction updateTitle() {\n  idle = inputMask ? 0 : idle + 1;\n  if (idle > IDLE_DEMO) { startDemo(); return; }\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) { state = 'players'; timer = 0; } else { state = 'records'; hl = -1; timer = 0; }\n  }\n}\n\n/** How many players: LEFT and RIGHT (or UP and DOWN) choose one to four, A starts, B goes back. */\nfunction updatePlayers() {\n  if (pressed(LEFT) || pressed(DOWN)) { nPlayers = Math.max(1, nPlayers - 1); fx(SFX.move); }\n  if (pressed(RIGHT) || pressed(UP)) { nPlayers = Math.min(4, nPlayers + 1); fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.move); toTitle(); }\n  else if ((pressed(A) || pressed(START)) && timer > 10) { fx(SFX.select); wantPlayers = nPlayers; startGame(); }\n}\n\n/** The game: the flippers, the plunger, the nudges and the ball. */\nfunction updatePlay() {\n  if (demo) { if (inputMask && !prevMask) { toTitle(); return; } } // a press ends the demo\n  else if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  const ai = demo ? demoPad() : null;\n  const pushed = demo ? ai.pad : [PAD_LEFT.some((k) => btn(k)), PAD_RIGHT.some((k) => btn(k))];\n  held = tilted ? [false, false] : pushed;\n  if (!inLane() && !tilted) {\n    if (pushed[0] && !heldPrev[0]) { laneLit.push(laneLit.shift()); fx(SFX.move); } // the flippers turn the lane lights, left and right\n    if (pushed[1] && !heldPrev[1]) { laneLit.unshift(laneLit.pop()); fx(SFX.move); }\n  }\n  heldPrev = pushed;\n  const waiting = inLane() && ball.vy >= 0 && ball.y >= BALL_HOME.y - 1;\n  if (waiting && (pushed[0] || pushed[1])) plunge = Math.min(1, plunge + 1 / PLUNGE_FRAMES);\n  else if (waiting && plunge > 0.04) { ball.vy = -(4 + 10 * plunge); plunge = 0; if (!saved) saveT = SAVE_FRAMES; fx(SFX.point); }\n  else if (!waiting) plunge = 0;\n  const side = demo ? 0 : pressed(L) ? -1 : pressed(R) ? 1 : 0;\n  if ((side || (!demo && pressed(SELECT))) && !inLane() && !tilted && bs.some((b) => !b.ramp && !b.hold)) nudge(side, pressed(SELECT));\n  stepTable(bs, flips, held);\n  processEvents();\n  if (mission) tickMission();\n  if (saveT > 0) saveT--;\n  if (shake > 0) shake--;\n  if (msgT > 0) msgT--;\n  if (banner && banner.t > 0) banner.t--;\n  const want = clamp(Math.max(...bs.map((b) => b.y)) - 150, 0, TABLE_H - VIEW_H); // the camera follows the lowest ball\n  camY += (want - camY) * 0.12;\n  for (const b of bs.slice()) {\n    if (!(b.y > DRAIN_Y && b.x < LANE_X)) continue;\n    if (bs.length > 1) { bs.splice(bs.indexOf(b), 1); ball = bs[0]; fx(SFX.hit); } else { drain(); break; }\n  }\n}\n\n// --- Ranks and missions (SPEC 5) ---\n\nconst RANK_NAMES = ['CADET', 'ENSIGN', 'PILOT', 'LIEUTENANT', 'COMMANDER', 'CAPTAIN', 'COMMODORE', 'ADMIRAL', 'FLEET ADMIRAL'];\nconst RANK_SHORT = ['CADET', 'ENSIGN', 'PILOT', 'LIEUT', 'CMDR', 'CAPTAIN', 'COMDORE', 'ADMIRAL', 'FLT ADM']; // for the panel, 7 letters at most\n/** A rank by its number, 1 to 9 (10 is a finished career), for the panel and the records. */\nconst rankLabel = (n) => (n > 9 ? 'FLTADM*' : n > 0 ? RANK_SHORT[n - 1] : '');\nconst rankNo = (q) => (q.career ? 10 : q.rk + 1);\nconst RANK_BONUS = 10000, RANK_PRIZE = 500000, JACKPOT = 1000000, SHOTS = ['bump', 'sling', 'standup', 'drop', 'spin', 'rampL', 'rampR', 'orbitL', 'orbitR', 'gate', 'lane'];\nconst EXTRA_AT_RANK = [1, 4, 7]; // completing the mission of these ranks (Ensign, Commander, Admiral) promotes to Pilot, Captain and Fleet Admiral: an extra ball\n/** A mission: its name, its time in seconds, the line that says what to do, and `on(m, k)`: the objective's rule for each thing the ball does (true when done). */\nconst MISSIONS = [\n  { name: 'LAUNCH DRILL', time: 60, text: (m) => `BUMPERS ${m.n}/15`, on: (m, k) => { if (k === 'bump') m.n++; return m.n >= 15; } },\n  { name: 'ASTEROID BELT', time: 60, text: (m) => (m.step ? 'CLEAR THE DROP BANK' : 'LIGHT ALL 4 TARGETS'), on: (m, k) => { if (!m.step && k === 'standupSet') m.step = 1; else if (m.step && k === 'bank') return true; return false; } },\n  { name: 'SLALOM RUN', time: 75, text: (m) => `RAMPS L R L R ${m.n}/4`, on: (m, k) => { if (k === (m.n % 2 ? 'rampR' : 'rampL')) m.n++; return m.n >= 4; } },\n  { name: 'ORBIT LOCK', time: 75, text: (m) => `LEFT ORBIT ${m.n}/3`, on: (m, k) => { if (k === 'orbitL') m.n++; return m.n >= 3; } },\n  { name: 'DOCKING', time: 90, text: (m) => (m.n < 5 ? `RAMPS ${m.n}/5` : 'NOW THE GATE'), on: (m, k) => { if (m.n < 5 && (k === 'rampL' || k === 'rampR')) m.n++; else if (m.n >= 5 && k === 'gate') return true; return false; } },\n  { name: 'FUEL RUN', time: 60, text: (m) => `SPINS ${m.n}/50`, on: (m, k) => { if (k === 'spin') m.n++; return m.n >= 50; } },\n  { name: 'WORMHOLE', time: 75, text: (m) => `GATE ${m.n}/3`, on: (m, k) => { if (k === 'gate') m.n++; return m.n >= 3; } },\n  { name: 'BATTLE FLEET', time: 90, multi: true, text: (m) => `JACKPOTS ${m.n}/3: RAMPS`, on: (m, k) => { if (k === 'jackpot') m.n++; return m.n >= 3; } },\n  { name: 'MOTHERSHIP', time: 120, text: (m) => (Object.keys(m.set).length < SHOTS.length ? `EVERY SHOT ${Object.keys(m.set).length}/${SHOTS.length}` : 'FINAL: THE GATE'), on: (m, k) => {\n    if (Object.keys(m.set).length < SHOTS.length) { if (SHOTS.includes(k)) m.set[k] = 1; } else if (k === 'gate') return true;\n    return false;\n  } },\n];\n\n/** The light of the table follows the rank: a dim cool blue for a cadet, a warm bright gold for a fleet admiral (the floor's palette is rewritten). */\nfunction applyRankLight() {\n  const t = (career ? 8 : rk) / 8;\n  for (let i = 17; i < 32; i++) {\n    const [r, g, b] = floorBase[i] || [0, 0, 0], lum = 0.3 * r + 0.59 * g + 0.11 * b;\n    const k = 0.8 * t, f = 0.9 + 0.8 * t, ch = (v, gold) => clamp(Math.round((v * (1 - k) + gold * k) * f), 0, 31);\n    color(i, ch(r, lum * 3), ch(g, lum * 2.3), ch(b, lum * 0.7));\n  }\n}\n\nconst flash = (a, b) => { banner = { a, b, t: 150 }; };\n\n/** What the ball did this frame, in order: the lamps, the missions and the jackpots. */\nfunction processEvents() {\n  for (const k of evq) {\n    if (mission) {\n      if (k === 'jackpot') { if (MISSIONS[mission.r].multi) award(JACKPOT); else continue; }\n      if (MISSIONS[mission.r].on(mission, k)) completeMission();\n      continue;\n    }\n    if (k === 'standupSet') setLamp(0); else if (k === 'bank') setLamp(1); else if (k === 'rampL' || k === 'rampR') setLamp(2);\n    else if (k === 'gate' && lamps.every(Boolean)) startMission();\n  }\n  evq.length = 0;\n}\n\n/** A mission lamp: lit by a full set of standup targets, by the drop bank and by a ramp; all three light the gate. */\nfunction setLamp(i) {\n  if (lamps[i]) return;\n  lamps[i] = true; fx(SFX.point);\n  say(lamps.every(Boolean) ? 'GATE LIT' : `LAMP ${i + 1}`);\n}\n\n/** The gate was shot with all three lamps lit: this rank's mission begins (after the last rank, a jackpot instead). */\nfunction startMission() {\n  lamps = [false, false, false];\n  if (career) { award(RANK_PRIZE * 10); say('JACKPOT'); flash('MOTHERSHIP', 'JACKPOT 5000000'); fx(SFX.record); return; }\n  const d = MISSIONS[rk];\n  mission = { r: rk, left: d.time * 60, n: 0, step: 0, set: {} };\n  flash(d.name, d.text(mission)); fx(SFX.select);\n  if (d.multi) { // two more balls come out of the gate behind the one that is in it, and there is no save\n    saved = true; saveT = 0;\n    for (let i = 1; i <= 2; i++) bs.push(newBall(GATE.x, GATE.y, (GATE_HOLD + 25 * i) * SUB));\n  }\n}\n\nfunction tickMission() {\n  if (--mission.left <= 0) failMission('TIME UP');\n  else if (MISSIONS[mission.r].multi && bs.length < 2) failMission('MULTIBALL OVER');\n}\n\nfunction failMission(why) { mission = null; lamps = [true, true, true]; flash('MISSION FAILED', why); fx(SFX.over); }\n\n/** Done: the prize (500,000 times the new rank's number), the new rank, an extra ball at some, and the lamps start again. */\nfunction completeMission() {\n  const r = mission.r; mission = null;\n  award(RANK_PRIZE * (r + 2));\n  if (r < 8) rk = r + 1; else career = true;\n  if (EXTRA_AT_RANK.includes(r)) { extraBalls++; say('EXTRA BALL'); } else say('RANK UP');\n  lamps = [false, false, false]; applyRankLight();\n  flash('RANK UP', RANK_NAMES[rk] + (career ? ' *' : '')); fx(SFX.record);\n}\n\n/** A shove of the table: the ball is pushed (L left, R right, SELECT up); the third in a ball is a warning, the fourth a tilt. */\nfunction nudge(side, up) {\n  nudges++;\n  if (nudges >= NUDGE_TILT) { tilted = true; say('TILT'); fx(SFX.over); return; }\n  if (nudges === NUDGE_WARN) say('WARNING');\n  for (const b of bs) if (!b.ramp && !b.hold) { b.vx += side * NUDGE_V; if (up) b.vy -= NUDGE_V; }\n  shake = 8; fx(SFX.move);\n}\n\n/** The ball is lost: a saved ball goes back to the plunger; otherwise the ball is over. */\nfunction drain() {\n  if (saveT > 0 && !saved) { saved = true; saveT = 0; say('BALL SAVED'); fx(SFX.record); serve(); return; }\n  fx(SFX.hit); if (mission) failMission('BALL LOST');\n  const base = bonus + rk * RANK_BONUS, b = tilted ? 0 : base * mult;\n  if (b > 0) { // the bonus is counted on its own screen: the shots of the ball (and 10,000 for each rank) times the multiplier\n    bonusRes = { base, mult, total: b }; award(b); state = 'bonus'; timer = 0;\n  } else afterBall();\n}\n\nconst BONUS_COUNT = 90, BONUS_HOLD = 45; // frames the bonus counts up, and waits when done\nconst bonusShown = () => Math.ceil(bonusRes.total * Math.min(1, timer / BONUS_COUNT));\nfunction updateBonus() {\n  if (demo && timer > 30) { afterBall(); return; }\n  const done = timer >= BONUS_COUNT;\n  if (!done && timer % 5 === 0) fx(SFX.point);\n  if (pressed(A) || pressed(START)) { // a press skips the counting; another goes on\n    if (!done && timer > 10) timer = BONUS_COUNT; else if (done && timer > BONUS_COUNT + 10) afterBall();\n  } else if (timer > BONUS_COUNT + BONUS_HOLD) afterBall();\n}\n\n/** After a ball's bonus: an extra ball plays the same player again; otherwise the next player with a ball left; or the game is over. */\nfunction afterBall() {\n  if (extraBalls > 0) { extraBalls--; beginBall(); say('SHOOT AGAIN'); state = 'play'; return; }\n  balls--; savePlayer();\n  for (let i = 1; i <= nPlayers; i++) {\n    const j = (cur + i) % nPlayers;\n    if (players[j].balls > 0) {\n      loadPlayer(j); beginBall(); timer = 0;\n      state = nPlayers > 1 ? 'turn' : 'play';\n      return;\n    }\n  }\n  gameOver();\n}\n\n/** A turn's splash: whose ball it is. */\nfunction updateTurn() { if (demo) { state = 'play'; return; } if (timer > 90 || (timer > 15 && (pressed(A) || pressed(START)))) { state = 'play'; timer = 0; } }\n\nfunction gameOver() {\n  if (demo) { toTitle(); return; }\n  state = 'over'; timer = 0; play(-1); fx(SFX.over);\n  dset(GAMES_SLOT, dget(GAMES_SLOT) + 1); // the games played, and the best rank reached by anyone\n  newBest = Math.max(...players.map(rankNo)) > dget(BEST_SLOT) ? Math.max(...players.map(rankNo)) : 0;\n  if (newBest) dset(BEST_SLOT, newBest);\n  initQueue = players.map((q, i) => i).sort((a, b) => players[b].score - players[a].score); firstRank = -1;\n}\n\n/** The next score that makes the top 10 asks for initials (best score first); true if there was one. */\nfunction nextInitials() {\n  while (initQueue.length) {\n    const i = initQueue.shift(), r = insertTop({ score: players[i].score, initials: lastInitials(), rn: rankNo(players[i]) });\n    if (r < 0) continue;\n    rank = r; if (firstRank < 0) firstRank = r;\n    state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0, who: i }; fx(SFX.record);\n    return true;\n  }\n  return false;\n}\n\nfunction updateOver() {\n  if (timer < 60 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (!nextInitials()) toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  if (!nextInitials()) { state = 'records'; hl = firstRank; timer = 0; }\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startGame(); // restart\n    else toTitle(); // quitting abandons the game: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  const inPlay = state === 'play' || state === 'over' || state === 'turn' || state === 'bonus', menu = state === 'title' || state === 'players';\n  if (!inPlay && !menu) { bg(0, { show: false }); bg(1, { show: false }); }\n  bg(2, { y: Math.round(clock * 0.25) });\n  if (inPlay) drawPlay();\n  else if (menu) { drawTable(Math.round(208 + 208 * Math.sin(clock / 300))); drawMenuPanel(); if (state === 'title') drawTitle(); else drawPlayers(); }\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (state === 'turn') drawTurn();\n  else if (state === 'bonus') drawBonus();\n  else if (state === 'over') drawOver();\n  if (paused) drawPause();\n}\n\n/** The picture of the table: sprites over the two background layers, which scroll with the camera; the panel on the overlay. */\nfunction drawPlay() {\n  const cy = Math.round(camY) + (shake > 0 ? (shake & 1 ? 2 : -2) : 0);\n  drawTable(cy);\n  if (mission || (banner && banner.t > 0)) drawBanner();\n  drawPanel(cy);\n  if (demo && clock % 60 < 40) ctab('DEMO: PRESS ANY BUTTON', 196, WHITE);\n}\n\n/** The table: both background layers scrolled to cy, and every part of it as a sprite. */\nfunction drawTable(cy) {\n  const sy = (y) => Math.round(y - cy), R = Math.round, S = ART.sprites, B = ART.big;\n  bg(0, { y: cy, show: true }); bg(1, { y: cy, show: true });\n  const P = { prio: 2 }; // the table's parts: over the rails, under a ramp\n  // lamps and their glow: under the decor (priority 1)\n  const lamp = (x, y, on) => {\n    if (on) sprite(S.glow, R(x) - 8, sy(y) - 8, { pal: 4, prio: 1 });\n    sprite(on ? S.lamp_on : S.lamp, R(x) - 4, sy(y) - 4, { prio: 1 });\n  };\n  LANE_XS.forEach((x, i) => lamp(x, LANE_Y, laneLit[i]));\n  RAMPS.forEach((r) => lamp(r.ex, r.ey + 14, r.lit));\n  lamp(8, 588, kickback);\n  lamps.forEach((on, i) => lamp(76 + i * 12, 124, on)); // the three mission lamps, under the gate\n  if (lamps.every(Boolean) && !mission && clock % 30 < 20) sprite(S.glow, GATE.x - 8, sy(GATE.y) - 8, { pal: 4, prio: 1 }); // the gate is lit\n  for (const e of BUMPERS) sprite(e.flash ? S.bump_hit : S.bump, e.x - 16, sy(e.y) - 16, P);\n  SLINGS.forEach((e, k) => bigSprite(B[e.flash ? 'sling_hit' : 'sling'], k ? 123 : 22, sy(476), { ...P, fx: !!k }));\n  STANDUPS.forEach((e, k) => sprite(e.lit ? S.stand_hit : S.stand, k < 2 ? e.x0 - 3 : e.x0 - 12, sy(e.y0 - 1), { ...P, fx: k >= 2 }));\n  for (const e of DROPS) sprite(e.down ? S.drop_down : S.drop, R(e.x0 - 3), sy(e.y0 - 6), P);\n  sprite(S['spin' + (flr(spinPhase) & 3)], 4, sy(240) - 8, P);\n  const pull = inLane() && plunge > 0 ? plunge * 12 : 0;\n  sprite(S.plunger, LANE_X, sy(LANE_FLOOR - 1 + pull), P);\n  for (let i = 0; i < 3; i++) sprite(S.spring, LANE_X + 4, sy(LANE_FLOOR + 6 + pull + i * 8), P);\n  flips.forEach((f, k) => {\n    const n = clamp(R((REST_A - f.a) / (REST_A - UP_A) * 8), 0, 8);\n    bigSprite(B['flip' + n], R(k ? f.x - 38 : f.x - 10), sy(f.y) - 24, { ...P, fx: !!k });\n  });\n  for (const b of bs) sprite(S.ball, R(b.x) - 8, sy(b.y + (b === ball && inLane() && plunge > 0 ? plunge * 12 : 0)) - 8, { prio: b.ramp ? 3 : 2 });\n}\n\n/** Short scores for the list of players: 12345, 151K, 1.2M. */\nconst short = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e5 ? Math.floor(n / 1000) + 'K' : String(n));\n\n/** The panel: glass over the starfield with the player, the score, the ball, the multiplier, a message, a map of the table and every player's score. */\nfunction drawPanel(cy) {\n  const R = Math.round;\n  rectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS); line(TABLE_W, 0, TABLE_W, 223, PANEL);\n  txt(nPlayers > 1 ? `P${cur + 1}` : 'SCORE', 198, 6, GOLD);\n  txt(String(score), 252 - String(score).length * 8, 16, WHITE);\n  txt(`BALL ${Math.min(BALLS, BALLS + 1 - balls)}`, 198, 28, balls > 1 ? DIM : RED);\n  txt(RANK_SHORT[rk], 198, 40, career ? GOLD : CYAN);\n  if (mult > 1) txt(`MULT X${mult}`, 198, 52, CYAN);\n  if (saveT > 0 && clock % 40 < 28) txt('SAVE', 198, 62, GREEN);\n  if (msgT > 0 && (msgT > 30 || msgT % 8 < 5)) msg.split(' ').forEach((w, i) => txt(w, 198, 74 + i * 10, tilted ? RED : GOLD));\n  // a map of the table: the balls and what the screen shows\n  const mx = 208, my = 104;\n  rect(mx - 1, my - 1, TABLE_W / 8 + 2, TABLE_H / 8 + 2, PANEL);\n  rect(mx, my + R(cy / 8), TABLE_W / 8, VIEW_H / 8, DIM);\n  for (const b of bs) rectfill(mx + R(b.x / 8) - 1, my + R(b.y / 8) - 1, 2, 2, WHITE);\n  if (nPlayers > 1) players.forEach((q, i) => {\n    const v = short(i === cur ? score : q.score);\n    txt(`${i + 1}`, 194, 189 + i * 9, i === cur ? GOLD : DIM); txt(v, 252 - v.length * 8, 189 + i * 9, i === cur ? WHITE : DIM);\n  });\n}\n\n/** At the top of the table: the mission and what is left to do and its time, or the last announcement (rank up, failed ...). */\nfunction drawBanner() {\n  rectfill(0, 0, TABLE_W, 26, ART.colors.GLASS);\n  if (mission) {\n    const d = MISSIONS[mission.r], sec = Math.ceil(mission.left / 60);\n    ctab(d.name, 3, GOLD); ctab(d.text(mission) + '  ' + Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0'), 14, sec <= 10 && clock % 20 < 10 ? RED : WHITE);\n  } else { ctab(banner.a, 3, GOLD); ctab(banner.b, 14, WHITE); }\n}\n\nconst ctab = (s, y, c) => txt(s, 96 - s.length * 4, y, c); // centred on the table, not the screen\n\nfunction drawTurn() {\n  panel(24, 76, 144, 56);\n  ctab(`PLAYER ${cur + 1}`, 88, GOLD);\n  ctab(`BALL ${BALLS + 1 - balls}`, 102, WHITE);\n  if (timer % 60 < 40) ctab('HOLD A BUTTON', 118, WHITE);\n}\n\nfunction drawBonus() {\n  const r = bonusRes, v = bonusShown();\n  panel(16, 64, 160, 88);\n  ctab('BALL BONUS', 72, GOLD);\n  ctab(`${r.base}`, 90, WHITE);\n  ctab(`X ${r.mult}`, 102, CYAN);\n  ctab(String(v), 120, v >= r.total ? GOLD : WHITE);\n  if (timer >= BONUS_COUNT && timer % 60 < 40) ctab('A: CONTINUE', 138, DIM);\n}\n\nfunction drawOver() {\n  const best = Math.max(...players.map((q) => q.score));\n  panel(8, 56, 240, 44 + players.length * 14 + (newBest ? 14 : 0) + 16);\n  ctxt('GAME OVER', 64, RED);\n  players.forEach((q, i) => {\n    const y = 84 + i * 14, top = nPlayers > 1 && q.score === best;\n    txt(nPlayers > 1 ? `P${i + 1}` : '', 20, y, top ? GOLD : DIM);\n    txt(rankLabel(rankNo(q)), 44, y, CYAN); txt(String(q.score), 236 - String(q.score).length * 8, y, top ? GOLD : WHITE);\n  });\n  if (newBest) ctxt(`NEW BEST RANK: ${rankLabel(newBest)}`, 84 + players.length * 14, GOLD);\n  if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 84 + players.length * 14 + (newBest ? 14 : 0) + 4, DIM);\n}\n\n/** The right panel of the title and the player select: the best rank reached, the games played and the best score. */\nfunction drawMenuPanel() {\n  rectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS); line(TABLE_W, 0, TABLE_W, 223, PANEL);\n  const best = dget(BEST_SLOT), top = readEntry(0);\n  txt('BEST', 198, 12, DIM); txt(best ? rankLabel(best) : '-', 198, 24, GOLD);\n  txt('HIGH', 198, 48, DIM); txt(top.score ? String(top.score) : '-', 252 - (top.score ? String(top.score).length : 1) * 8, 60, WHITE);\n  txt('GAMES', 198, 84, DIM); txt(String(dget(GAMES_SLOT)), 198, 96, WHITE);\n}\n\nfunction drawPlayers() {\n  panel(18, 90, 156, 82);\n  ctab('HOW MANY PLAYERS?', 98, GOLD);\n  for (let i = 1; i <= 4; i++) {\n    const x = 30 + (i - 1) * 34, on = i === nPlayers;\n    if (on) rect(x - 4, 114, 24, 24, GOLD);\n    txt(String(i), x + 4, 123, on ? WHITE : DIM);\n  }\n  ctab('LEFT / RIGHT: CHOOSE', 146, DIM); ctab('A: START   B: BACK', 158, DIM);\n}\n\nfunction drawTitle() {\n  [['logo_star', 6], ['logo_cadet', 38], ['logo_pinball', 76]].forEach(([n, y]) => bigSprite(ART.big[n], 96 - ART.big[n].w / 2, y, { prio: 3 }));\n  panel(32, 118, 128, 50);\n  ['PLAY', 'RECORDS'].forEach((t, i) => ctab(`${i === titleSel ? '> ' : '  '}${t}`, 128 + i * 16, i === titleSel ? WHITE : DIM));\n  ctab('1 TO 4 PLAYERS', 184, DIM);\n}\n\nfunction drawRecords() {\n  panel(8, 12, 240, 200);\n  ctxt('TOP 10', 20, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 40 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(12, y - 2, 232, 12, PANEL);\n    txt(String(i + 1).padStart(2), 18, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 46, y, on ? GOLD : WHITE);\n    txt(e.score ? String(e.score).padStart(8) : '', 84, y, i === 0 ? GOLD : WHITE);\n    if (e.score) txt(rankLabel(e.rn), 160, y, CYAN);\n  });\n  const best = dget(BEST_SLOT);\n  ctxt(`BEST RANK ${best ? rankLabel(best) : '-'}   GAMES ${dget(GAMES_SLOT)}`, 184, DIM);\n  if (timer % 60 < 40) ctxt('START: BACK', 198, WHITE);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt((nPlayers > 1 ? `PLAYER ${ini.who + 1}: ` : '') + String(players[ini.who].score), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

    "title": "Dungeon Crawl Pinball",
    "author": "NOVA-16",
    "description": "Descend a dungeon on a torchlit pinball table: take the keys from the side cubbies to open the x3 and x10 slots, clear four levels and beat the Pit Lord in a multiball. The plunger's pull picks your ramp; 1 to 4 players."
  },
  "label": null,
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {},\nsprites: {\"gem\": {\"pal\": 0, \"size\": 16, \"tile\": 258}, \"player\": {\"pal\": 0, \"size\": 16, \"tile\": 256}},\nscenes: {\"field\": {\"h\": 8, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hills\": {\"h\": 8, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}},\ncolors: {\"GLASS\": 200},\ngradients: {\"sky\":{\"entry\":0,\"lines\":[13475,13475,13475,13475,13475,13475,13475,14499,14499,14531,14531,14532,14532,14532,14532,14532,14532,15556,15556,15556,15556,15556,15588,15588,15588,15588,15588,16612,16612,16612,16612,16612,16612,16612,16645,16645,16645,17669,17669,17669,17669,17669,17669,17669,17669,17669,18725,18725,18725,18725,18725,18725,18725,18725,18725,19749,19750,19750,19782,19782,19782,19782,19782,19782,19782,20806,20806,20806,20806,20806,20838,20838,20838,20838,21862,21862,21862,21863,21863,21863,21863,21863,21895,22919,22919,22919,22919,22919,22919,22919,22919,22951,22952,22952,23976,23976,23976,23976,24008,24008,24009,24009,24009,24009,24041,24041,25065,25065,25066,25066,25066,25098,25098,25098,25098,25099,25099,25131,26155,26155,26155,26155,26155,26156,26188,26188,26188,26188,26188,26188,27245,27245,27245,27245,27245,27245,27245,27278,27278,27278,27278,27278,28302,28334,28335,28335,28335,28335,28335,28335,28367,28368,28368,28368,28368,29392,29424,29424,29425,29425,29425,29425,29457,29457,29457,29458,29458,29458,30482,30514,30514,30514,30515,30515,30515,30547],\"y0\":0}},\n};\nfunction gradientLine(g, y) {\nconst v = g.lines[y - g.y0];\nif (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1, DEEPEST_SLOT = 2, GAMES_SLOT = 3;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3;\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nconst BALLS = 3;\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)), lv: dget(s + 2) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, e.lv || 0); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\nfunction insertTop(e) {\nif (!e.score) return -1;\nconst list = topTen(), at = list.findIndex((x) => e.score > x.score);\nif (at < 0) return -1;\nlist.splice(at, 0, e);\nfor (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\nreturn at;\n}\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\nconst TABLE_W = 192, TABLE_H = 640, VIEW_H = 224;\nconst BR = 5, SUB = 4;\nconst GRAV = 0.12, VMAX = 14;\nconst WALL_E = 0.45, FLIP_E = 0.7, REST_CUT = 0.3;\nconst FLEN = 34, UFLEN = 26, FR = 4;\nconst REST_A = 30 * Math.PI / 180, UP_A = -28 * Math.PI / 180;\nconst W_UP = (REST_A - UP_A) / 4, W_DOWN = (REST_A - UP_A) / 6;\nconst LANE_X = 176, LANE_FLOOR = 612, BALL_HOME = { x: 184, y: LANE_FLOOR - BR };\nconst DRAIN_Y = 632;\nconst PLUNGE_FRAMES = 60, ZONE_A = [0.5, 0.68], ZONE_B = 0.95, SKILL = { A: 50000, B: 25000 };\nconst zoneOf = (p) => (p >= ZONE_B ? 'B' : p >= ZONE_A[0] && p < ZONE_A[1] ? 'A' : null);\nconst UF = { x: 166, y: 232 };\nconst HOLE_R = 7, HOLD = 60, NOCAP = 40;\nconst SLOTS = [\n{ k: 'slot10', x: 60, y: 70, l: 48, r: 72, out: [60, 95, 0.4, 3] },\n{ k: 'slot3', x: 124, y: 70, l: 112, r: 136, out: [124, 95, -0.4, 3] },\n];\nconst SLOT_GATE = 88;\nconst LANE_GATE = [LANE_X, 44, LANE_X, 120];\nconst CUBBY_R = 8;\nconst CUBBIES = [\n{ k: 'cubbyL', x: 9, y: 404, out: [20, 396, 2.5, 1] },\n{ k: 'cubbyR', x: 167, y: 404, out: [156, 396, -2.5, 1] },\n];\nconst WALLS = (() => {\nconst w = [];\nfor (let i = 0; i < 16; i++) {\nconst a0 = Math.PI + (Math.PI * i) / 16, a1 = Math.PI + (Math.PI * (i + 1)) / 16;\nw.push([96 + 96 * Math.cos(a0), 96 + 96 * Math.sin(a0), 96 + 96 * Math.cos(a1), 96 + 96 * Math.sin(a1)]);\n}\nw.push([0, 96, 0, TABLE_H], [TABLE_W, 96, TABLE_W, LANE_FLOOR], [LANE_X, 120, LANE_X, LANE_FLOOR], [LANE_X, LANE_FLOOR, TABLE_W, LANE_FLOOR]);\nfor (const m of [0, 1]) {\nconst X = (x) => (m ? 176 - x : x);\nw.push([X(16), 492, X(16), 540], [X(16), 540, X(48), 588]);\nw.push([X(32), 480, X(32), 545], [X(32), 545, X(44), 545]);\n}\nfor (const s of SLOTS) w.push([s.l, 56, s.x, 46], [s.x, 46, s.r, 56], [s.l, 56, s.l, SLOT_GATE], [s.r, 56, s.r, SLOT_GATE]);\nw.push([LANE_X, 214, UF.x + 2, UF.y - 1]);\nreturn w;\n})();\nconst RIDE_SPEED = 7;\nconst LAUNCH = {\nA: { at: 360, path: [[184, 360], [172, 326], [140, 306], [96, 300], [52, 306], [20, 330], [12, 380], [14, 440], [24, 486]], out: [0, 2] },\nB: { at: 140, path: [[184, 140], [182, 112], [172, 102], [162, 116], [164, 170], [170, 206]], out: [-0.6, 1.5] },\n};\nconst RAMP_IN = 14, RAMP_MIN = 3.5, RAMP_MAX = 9;\nconst RAMPS = [\n{ k: 'rampL', x: 14, y: 430, path: [[14, 430], [11, 330], [13, 200], [30, 124], [64, 104], [98, 110]], out: [1, 1.5] },\n{ k: 'rampR', x: 160, y: 430, path: [[160, 430], [165, 330], [166, 260], [170, 206]], out: [-0.6, 1.5] },\n];\nconst GUIDE = [\n[[166, 260], [166, 140], [146, 108], [100, 100], [70, 104], [60, 92], [60, 70]],\n[[166, 260], [166, 140], [150, 112], [130, 104], [124, 92], [124, 70]],\n];\nconst guided = () => (gates[0] ? 0 : gates[1] ? 1 : -1);\nconst pathLen = (P) => P.slice(1).reduce((s, q, i) => s + Math.hypot(q[0] - P[i][0], q[1] - P[i][1]), 0);\nfor (const k in LAUNCH) { LAUNCH[k].k = k; LAUNCH[k].len = pathLen(LAUNCH[k].path); }\nfor (const r of RAMPS) r.len = pathLen(r.path);\nconst GUIDE_LEN = GUIDE.map((P) => pathLen(RAMPS[1].path.slice(0, -1)) + pathLen(P));\nconst BUMP_R = 11, BUMP_KICK = 6, SLING_KICK = 4.5, COOL = 8, HIT_FLASH = 6, TARGET_R = 2;\nconst BUMPERS = [[77, 148], [111, 148], [94, 178]].map(([x, y]) => ({ x, y, flash: 0, cool: 0 }));\nconst SLINGS = [[32, 480, 44, 545], [144, 480, 132, 545]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, flash: 0, cool: 0 }));\nconst STANDUPS = [[68, 235, 80, 229], [108, 229, 120, 235], [34, 373, 46, 367], [142, 367, 154, 373]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, lit: false, flash: 0, cool: 0 }));\nconst CHEST = { x0: 87, y0: 302, x1: 101, y1: 298, lit: false, flash: 0, cool: 0 };\nconst KICKBACK = { x: 16, y0: 575, y1: 606, v: 13 };\nconst PIT = { x: 94, y: 430, r: 34 }, BOSS_R = 12, BOSS = { flash: 0, cool: 0 };\nconst PTS = { bump: 100, sling: 10, standup: 1000, chest: 0, ramp: 5000, cubby: 10000, slot3: 25000, slot10: 100000 };\nlet gates = [false, false], kickback = true, bossUp = false;\nconst makeFlippers = () => [\n{ x: 48, y: 588, s: 1, len: FLEN, hand: 0, a: REST_A, w: 0 },\n{ x: 128, y: 588, s: -1, len: FLEN, hand: 1, a: REST_A, w: 0 },\n{ x: UF.x, y: UF.y, s: -1, len: UFLEN, hand: 1, a: REST_A, w: 0 },\n];\nconst flipTip = (f) => ({ x: f.x + f.s * f.len * Math.cos(f.a), y: f.y + f.len * Math.sin(f.a) });\nlet CN = [0, -1];\nfunction collide(b, x0, y0, x1, y1, r, e, vsAt) {\nconst dx = x1 - x0, dy = y1 - y0, len2 = dx * dx + dy * dy;\nconst t = len2 ? clamp(((b.x - x0) * dx + (b.y - y0) * dy) / len2, 0, 1) : 0;\nconst cx = x0 + dx * t, cy = y0 + dy * t, ox = b.x - cx, oy = b.y - cy, d2 = ox * ox + oy * oy, reach = BR + r;\nif (d2 >= reach * reach) return false;\nconst d = Math.sqrt(d2), nx = d ? ox / d : 0, ny = d ? oy / d : -1;\nb.x = cx + nx * reach; b.y = cy + ny * reach; CN = [nx, ny];\nconst vs = vsAt ? vsAt(t) : [0, 0];\nconst vn = (b.vx - vs[0]) * nx + (b.vy - vs[1]) * ny;\nif (vn < 0) {\nconst k = -(1 + (vn > -REST_CUT ? 0 : e)) * vn;\nb.vx += k * nx; b.vy += k * ny;\n}\nreturn true;\n}\nfunction kick(b, v) {\nconst vn = b.vx * CN[0] + b.vy * CN[1];\nif (vn < v) { b.vx += (v - vn) * CN[0]; b.vy += (v - vn) * CN[1]; }\n}\nlet stats = {}, evq = [];\nconst resetStats = () => { stats = { launch: 0, rideA: 0, rideB: 0, skill: 0, drain: 0, bump: 0, sling: 0, standup: 0, standupLit: 0, standupSet: 0, levels: 0, bossStart: 0, bossBeaten: 0, treasure: 0, chest: 0, ramp: 0, rampL: 0, rampR: 0, cubby: 0, cubbyL: 0, cubbyR: 0, slot: 0, slot3: 0, slot10: 0, kick: 0, boss: 0 }; };\nresetStats();\nconst emit = (k) => { evq.push(k); };\nlet msg = '', msgT = 0;\nfunction say(t) { msg = t; msgT = 150; }\nfunction award(n) { score += n * (spell ? spell.m : 1); }\nfunction struck(el) { if (el.cool > 0) return false; el.cool = COOL; el.flash = HIT_FLASH; return true; }\nfunction score1(k, pts = PTS[k]) { stats[k]++; if (pts) award(pts); emit(k); }\nfunction ride(b, r) {\nconst g = r === RAMPS[1] ? guided() : -1;\nb.ride = g < 0 ? { r, d: 0, path: r.path, len: r.len, to: null } : { r, d: 0, path: r.path.slice(0, -1).concat(GUIDE[g]), len: GUIDE_LEN[g], to: SLOTS[g] };\nb.vx = b.vy = 0;\n}\nfunction capture(b, h) { b.hold = { h, t: HOLD * SUB }; b.vx = b.vy = 0; b.x = h.x; b.y = h.y; b.ride = null; b.zone = null; }\nfunction enterSlot(b, s) { capture(b, s); stats.slot++; score1(s.k); fx(SFX.point); }\nfunction along(P, d) {\nfor (let i = 1; i < P.length; i++) {\nconst L = Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]);\nif (d <= L) { const t = d / L; return [P[i - 1][0] + (P[i][0] - P[i - 1][0]) * t, P[i - 1][1] + (P[i][1] - P[i - 1][1]) * t]; }\nd -= L;\n}\nreturn P[P.length - 1];\n}\nfunction stepBall(b, flips) {\nif (b.ride) {\nconst R = b.ride, r = R.r;\nR.d += RIDE_SPEED / SUB;\nif (R.d < R.len) { [b.x, b.y] = along(R.path, R.d); return; }\n[b.x, b.y] = R.path[R.path.length - 1]; [b.vx, b.vy] = r.out; b.ride = null;\nif (r.k === 'A' || r.k === 'B') {\nstats['ride' + r.k]++; emit('ride' + r.k);\nif (b.skill) { b.skill = false; stats.skill++; award(SKILL[r.k]); emit('skill'); say(`SKILL SHOT ${r.k}`); fx(SFX.point); }\nreturn;\n}\nstats.ramp++; score1(r.k, PTS.ramp); fx(SFX.point);\nif (R.to && gates[SLOTS.indexOf(R.to)]) enterSlot(b, R.to);\nreturn;\n}\nif (b.hold) {\nif (--b.hold.t > 0) return;\nconst o = b.hold.h.out; [b.x, b.y, b.vx, b.vy] = o; b.hold = null; b.nocap = NOCAP * SUB;\nreturn;\n}\nif (b.nocap > 0) b.nocap--;\nb.vy += GRAV / SUB;\nconst sp = Math.hypot(b.vx, b.vy);\nif (sp > VMAX) { b.vx *= VMAX / sp; b.vy *= VMAX / sp; }\nb.x += b.vx / SUB; b.y += b.vy / SUB;\nif (b.zone && b.x > LANE_X && b.vy < 0 && b.y <= LAUNCH[b.zone].at) { const k = b.zone; b.zone = null; ride(b, LAUNCH[k]); return; }\nfor (const w of WALLS) collide(b, w[0], w[1], w[2], w[3], w[4] || 0, WALL_E);\nif (b.vx > 0 && b.x < LANE_X) collide(b, ...LANE_GATE, 0, WALL_E);\nSLOTS.forEach((s, i) => { if (!gates[i] && b.vy < 0) collide(b, s.l, SLOT_GATE, s.r, SLOT_GATE, 0, WALL_E); });\nfor (const e of BUMPERS) if (collide(b, e.x, e.y, e.x, e.y, BUMP_R, WALL_E)) { kick(b, BUMP_KICK); if (struck(e)) { score1('bump'); fx(SFX.hit); } }\nif (bossUp && collide(b, PIT.x, PIT.y, PIT.x, PIT.y, BOSS_R, WALL_E)) { kick(b, BUMP_KICK); if (struck(BOSS)) { stats.boss++; emit('boss'); fx(SFX.hit); } }\nfor (const e of SLINGS) if (collide(b, e.x0, e.y0, e.x1, e.y1, 0, WALL_E)) { kick(b, SLING_KICK); if (struck(e)) { score1('sling'); fx(SFX.hit); } }\nfor (const e of STANDUPS) if (collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E) && struck(e)) {\nscore1('standup'); fx(SFX.point);\nif (!e.lit) { e.lit = true; stats.standupLit++; emit('standupLit'); if (STANDUPS.every((q) => q.lit)) { stats.standupSet++; emit('standupSet'); for (const q of STANDUPS) q.lit = false; } }\n}\nif (collide(b, CHEST.x0, CHEST.y0, CHEST.x1, CHEST.y1, TARGET_R, WALL_E) && struck(CHEST)) { score1('chest'); fx(SFX.point); }\nif (!b.nocap) {\nfor (const [i, s] of SLOTS.entries()) if (gates[i] && Math.hypot(b.x - s.x, b.y - s.y) < HOLE_R) { enterSlot(b, s); return; }\nfor (const c of CUBBIES) if (b.vy < 0 && Math.hypot(b.x - c.x, b.y - c.y) < CUBBY_R) { capture(b, c); stats.cubby++; score1(c.k, PTS.cubby); fx(SFX.point); return; }\n}\nfor (const r of RAMPS) if (Math.hypot(b.x - r.x, b.y - r.y) < RAMP_IN && b.vy < -RAMP_MIN && b.vy > -RAMP_MAX) { ride(b, r); fx(SFX.point); return; }\nif (kickback && b.x < KICKBACK.x && b.y > KICKBACK.y0 && b.y < KICKBACK.y1 && b.vy > 0) { kickback = false; b.vx = 0.5; b.vy = -KICKBACK.v; stats.kick++; emit('kick'); fx(SFX.point); }\nfor (const f of flips) {\nconst tip = flipTip(f);\ncollide(b, f.x, f.y, tip.x, tip.y, FR, FLIP_E, (t) => {\nconst r = t * f.len;\nreturn [-f.s * Math.sin(f.a) * r * f.w, Math.cos(f.a) * r * f.w];\n});\n}\nif (b.x < LANE_X) b.zone = null;\n}\nfunction stepTable(balls, flips, hold) {\nfor (let i = 0; i < SUB; i++) {\nfor (const f of flips) {\nconst a0 = f.a;\nf.a = hold[f.hand] ? Math.max(UP_A, f.a - W_UP / SUB) : Math.min(REST_A, f.a + W_DOWN / SUB);\nf.w = (f.a - a0) * SUB;\n}\nfor (const b of balls) stepBall(b, flips);\n}\nfor (const e of [...BUMPERS, ...SLINGS, ...STANDUPS, CHEST, BOSS]) { if (e.cool > 0) e.cool--; if (e.flash > 0) e.flash--; }\n}\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, balls = BALLS, ball = null, bs = [], flips = [], plunge = 0, camY = 0, held = [false, false];\nlet nPlayers = 1, wantPlayers = 1, cur = 0, players = [], keys = 0, cubbyKey = [true, true], spell = null, depth = 1, level = 1, saveT = 0, saved = false;\nlet ballStats = {}, bonusRes = null, initQueue = [], firstRank = -1, newDeepest = 0;\nlet goalN = 0, boss = null, chestLit = false, treasureN = 0, extraBalls = 0, banner = null;\nconst PAD_LEFT = [UP, DOWN, LEFT, RIGHT], PAD_RIGHT = [A, B, X, Y];\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nbg(0, { show: false }); bg(1, { show: false }); bg(2, { show: false });\nflips = makeFlippers();\nblend({ layers: ['overlay'], half: true });\nif (skipTitle) startGame(); else toTitle();\n}\nfunction toTitle() {\nstate = 'title'; timer = 0; titleSel = 0; paused = false; nPlayers = wantPlayers; play(SONG.title);\nbs = []; flips = makeFlippers(); gates = [false, false]; level = 1; depth = 1; keys = 0; boss = null; bossUp = false; chestLit = false; banner = null; spell = null;\n}\nconst KEY_PTS = 15000, SPELL_TIME = 30 * 60, SAVE_FRAMES = 12 * 60;\nconst BONUS_PTS = { bump: 100, ramp: 5000, cubby: 10000, slot: 25000, level: 50000 };\nconst makePlayer = () => ({ score: 0, balls: BALLS, keys: 0, cubbyKey: [true, true], spell: null, depth: 1, level: 1, stand: [false, false, false, false], goalN: 0, chestLit: false, treasureN: 0, extra: 0 });\nfunction loadPlayer(i) {\nconst q = players[i]; cur = i;\nscore = q.score; balls = q.balls; keys = q.keys; cubbyKey = q.cubbyKey.slice(); spell = q.spell && { ...q.spell }; depth = q.depth; level = q.level;\ngoalN = q.goalN; chestLit = q.chestLit; treasureN = q.treasureN; extraBalls = q.extra;\nSTANDUPS.forEach((e, k) => { e.lit = q.stand[k]; });\nsetGates();\n}\nfunction savePlayer() {\nObject.assign(players[cur], { score, balls, keys, cubbyKey: cubbyKey.slice(), spell: spell && { ...spell }, depth, level, stand: STANDUPS.map((e) => e.lit), goalN, chestLit, treasureN, extra: extraBalls });\n}\nfunction setGates() { gates = [keys >= 2, keys >= 1]; }\nfunction startGame(n = nPlayers) {\nnPlayers = n; players = Array.from({ length: n }, makePlayer);\nflips = makeFlippers(); resetStats(); msgT = 0; paused = false; timer = 0; bossUp = false; boss = null; banner = null;\nloadPlayer(0); beginBall();\nstate = n > 1 ? 'turn' : 'play';\nplay(SONG.play);\n}\nfunction beginBall() {\nsaveT = 0; saved = false; kickback = true; evq = []; bonusRes = null; msgT = 0; bossUp = false; boss = null;\nballStats = { bump: 0, ramp: 0, cubby: 0, slot: 0, level: 0 };\nserve();\n}\nfunction processEvents() {\nfor (const k of evq) {\nconst g = GOAL_OF[k];\nif (g && level <= 4 && LEVELS[level - 1].k === g && ++goalN >= goalOf(level)) completeLevel();\nif (k === 'boss' && boss) hitBoss();\nif (k === 'chest' && chestLit) openChest();\nif (k === 'bump') ballStats.bump++;\nelse if (k === 'rampL' || k === 'rampR') { ballStats.ramp++; if (level === 5 && !boss) startBoss(); }\nelse if (k === 'cubbyL' || k === 'cubbyR') {\nballStats.cubby++;\nconst i = k === 'cubbyL' ? 0 : 1;\nif (cubbyKey[i]) { cubbyKey[i] = false; keys++; award(KEY_PTS); setGates(); say(keys > 1 ? 'KEY 2 X10 OPEN' : 'KEY 1 X3 OPEN'); fx(SFX.record); }\n} else if (k === 'slot3' || k === 'slot10') { ballStats.slot++; castSpell(k === 'slot10' ? 10 : 3); }\nelse if (k === 'launch' && !saved && saveT === 0) saveT = SAVE_FRAMES;\n}\nevq.length = 0;\n}\nfunction castSpell(m) {\nkeys = Math.max(0, keys - (m === 10 ? 2 : 1));\nif (keys === 0) cubbyKey = [true, true];\nsetGates();\nspell = { m: Math.max(m, spell ? spell.m : 0), t: SPELL_TIME };\nsay(m === 10 ? 'X10 MEGA SPELL' : 'X3 SPELL'); fx(SFX.record);\n}\nconst LEVELS = [\n{ name: 'THE GATEHOUSE', k: 'bump', n: 15, what: 'BUMPERS' },\n{ name: 'THE CRYPT', k: 'ramp', n: 4, what: 'RAMPS' },\n{ name: 'THE ARMOURY', k: 'standupLit', n: 4, what: 'TARGETS' },\n{ name: 'THE DEEP VAULT', k: 'cubby', n: 2, what: 'CUBBIES' },\n];\nconst GOAL_OF = { bump: 'bump', rampL: 'ramp', rampR: 'ramp', standupLit: 'standupLit', cubbyL: 'cubby', cubbyR: 'cubby' };\nconst goalOf = (lv) => Math.ceil(LEVELS[lv - 1].n * (1 + 0.5 * (depth - 1)));\nconst LEVEL_PTS = 100000, JACKPOT = 250000, BOSS_PRIZE = 2000000, TREASURE_PTS = 50000, TREASURE_SAVE = 20 * 60;\nconst bossHp = () => 6 + 2 * (depth - 1);\nconst showBanner = (a, b) => { banner = { a, b, t: 150 }; };\nfunction completeLevel() {\naward(LEVEL_PTS * level * depth); ballStats.level++; stats.levels++; chestLit = true; goalN = 0;\nshowBanner(`${LEVELS[level - 1].name} CLEARED`, level < 4 ? `DOWN TO LEVEL ${level + 1}` : 'THE PIT LORD AWAITS: A RAMP');\nlevel++; fx(SFX.record);\n}\nfunction startBoss() {\nboss = { hp: bossHp(), max: bossHp() }; bossUp = true; stats.bossStart++;\nsaveT = SAVE_FRAMES; saved = false;\nfor (let i = 0; i < 2; i++) { const s = SLOTS[i], b = newBall(s.x, s.y); b.hold = { h: s, t: (HOLD + 40 * i) * SUB }; bs.push(b); }\nshowBanner('THE PIT LORD RISES', 'HIT HIM WITH EVERY BALL'); fx(SFX.over);\n}\nfunction hitBoss() {\naward(JACKPOT * depth); boss.hp--;\nif (boss.hp > 0) { say('JACKPOT'); return; }\naward(BOSS_PRIZE * depth); stats.bossBeaten++;\nshowBanner('THE PIT LORD FALLS', `DESCEND TO DEPTH ${depth + 1}`);\ndepth++; level = 1; goalN = 0; treasureN = 0; boss = null; bossUp = false; fx(SFX.record);\n}\nfunction failBoss() { boss = null; bossUp = false; showBanner('THE PIT LORD SINKS', 'A RAMP TO FIGHT AGAIN'); }\nfunction openChest() {\nchestLit = false; award(TREASURE_PTS); stats.treasure++;\nconst t = treasureN++ % 3;\nif (t === 0) { saveT = TREASURE_SAVE; saved = false; say('TREASURE BALL SAVE'); }\nelse if (t === 1) { kickback = true; say('TREASURE KICKBACK'); }\nelse { extraBalls++; say('TREASURE EXTRA BALL'); }\nfx(SFX.record);\n}\nconst newBall = (x, y) => ({ x, y, vx: 0, vy: 0, ride: null, zone: null, skill: false, hold: null, nocap: 0 });\nfunction serve() {\nball = newBall(BALL_HOME.x, BALL_HOME.y); ball.skill = true; bs = [ball]; plunge = 0;\ncamY = clamp(ball.y - 150, 0, TABLE_H - VIEW_H);\n}\nconst inLane = () => ball.x > LANE_X && ball.y > LANE_FLOOR - 40;\nfunction drain() {\nif (saveT > 0 && !saved) { saved = true; saveT = 0; say('BALL SAVED'); fx(SFX.record); serve(); ball.skill = false; return; }\nstats.drain++; fx(SFX.hit);\nconst B = BONUS_PTS, base = ballStats.bump * B.bump + ballStats.ramp * B.ramp + ballStats.cubby * B.cubby + ballStats.slot * B.slot + ballStats.level * B.level;\nbonusRes = { base, depth, total: base * depth };\nscore += bonusRes.total;\nstate = 'bonus'; timer = 0;\n}\nconst BONUS_COUNT = 90, BONUS_HOLD = 45;\nconst bonusShown = () => Math.ceil(bonusRes.total * Math.min(1, timer / BONUS_COUNT));\nfunction updateBonus() {\nconst done = timer >= BONUS_COUNT;\nif (!done && timer % 6 === 0 && bonusRes.total) fx(SFX.move);\nif (pressed(A) || pressed(START)) {\nif (!done && timer > 10) timer = BONUS_COUNT; else if (done && timer > BONUS_COUNT + 10) afterBall();\n} else if (timer > BONUS_COUNT + BONUS_HOLD) afterBall();\n}\nfunction afterBall() {\nif (extraBalls > 0) { extraBalls--; beginBall(); say('SHOOT AGAIN'); state = 'play'; return; }\nballs--; savePlayer();\nfor (let i = 1; i <= nPlayers; i++) {\nconst j = (cur + i) % nPlayers;\nif (players[j].balls > 0) { loadPlayer(j); beginBall(); timer = 0; state = nPlayers > 1 ? 'turn' : 'play'; return; }\n}\ngameOver();\n}\nfunction updateTurn() { if (timer > 90 || (timer > 15 && (pressed(A) || pressed(START)))) { state = 'play'; timer = 0; } }\nfunction updatePlayers() {\nif (pressed(LEFT) || pressed(DOWN)) { nPlayers = Math.max(1, nPlayers - 1); fx(SFX.move); }\nif (pressed(RIGHT) || pressed(UP)) { nPlayers = Math.min(4, nPlayers + 1); fx(SFX.move); }\nif (pressed(B)) { fx(SFX.move); toTitle(); }\nelse if ((pressed(A) || pressed(START)) && timer > 10) { fx(SFX.select); wantPlayers = nPlayers; startGame(); }\n}\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'play') updatePlay();\nelse if (state === 'players') updatePlayers();\nelse if (state === 'turn') updateTurn();\nelse if (state === 'bonus') updateBonus();\nelse if (state === 'over') updateOver();\nelse if (state === 'initials') updateInitials();\nelse if (state === 'records') updateRecords();\nprevMask = inputMask;\n}\nfunction updateTitle() {\nif (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\nif (pressed(SELECT)) { fx(SFX.select); state = 'records'; hl = -1; timer = 0; return; }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (titleSel === 0) { state = 'players'; timer = 0; } else { state = 'records'; hl = -1; timer = 0; }\n}\n}\nfunction updatePlay() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nheld = [PAD_LEFT.some((k) => btn(k)), PAD_RIGHT.some((k) => btn(k))];\nconst waiting = bs.length === 1 && inLane() && !ball.ride && ball.vy >= 0 && ball.y >= BALL_HOME.y - 1;\nif (waiting && (held[0] || held[1])) plunge = Math.min(PLUNGE_FRAMES, Math.round(plunge * PLUNGE_FRAMES) + 1) / PLUNGE_FRAMES;\nelse if (waiting && plunge > 0.04) {\nball.vy = -(4 + 10 * plunge); ball.zone = zoneOf(plunge);\nif (plunge >= ZONE_A[0]) { stats.launch++; emit('launch'); if (!ball.zone) ball.skill = false; }\nplunge = 0; fx(SFX.point);\n} else if (!waiting) plunge = 0;\nstepTable(bs, flips, waiting ? [false, false] : held);\nif (ball.x > LANE_X && !ball.ride && ball.y >= BALL_HOME.y - 2 && Math.abs(ball.vy) < 4) { ball.y = BALL_HOME.y; ball.vy = 0; }\nprocessEvents();\nif (!waiting) {\nif (spell && --spell.t <= 0) { spell = null; say('SPELL FADES'); }\nif (saveT > 0) saveT--;\n}\nif (msgT > 0) msgT--;\nconst want = clamp(Math.max(...bs.map((b) => b.y)) - 150, 0, TABLE_H - VIEW_H);\ncamY += (want - camY) * 0.12;\nif (banner && banner.t > 0) banner.t--;\nfor (const b of bs.slice()) {\nif (!(b.y > DRAIN_Y && b.x < LANE_X)) continue;\nif (bs.length === 1) { drain(); break; }\nif (saveT > 0) { const s = SLOTS[0]; Object.assign(b, { x: s.x, y: s.y, vx: 0, vy: 0, hold: { h: s, t: HOLD * SUB } }); say('BALL SAVED'); continue; }\nbs.splice(bs.indexOf(b), 1); ball = bs[0]; fx(SFX.hit);\nif (bs.length === 1 && boss) failBoss();\n}\n}\nconst levelNo = (q) => q.depth * 10 + q.level;\nfunction gameOver() {\nstate = 'over'; timer = 0; play(-1); fx(SFX.over);\ndset(GAMES_SLOT, dget(GAMES_SLOT) + 1);\nconst deepest = Math.max(...players.map(levelNo));\nnewDeepest = deepest > dget(DEEPEST_SLOT) ? deepest : 0;\nif (newDeepest) dset(DEEPEST_SLOT, newDeepest);\ninitQueue = players.map((q, i) => i).sort((a, b) => players[b].score - players[a].score); firstRank = -1;\n}\nfunction nextInitials() {\nwhile (initQueue.length) {\nconst i = initQueue.shift(), r = insertTop({ score: players[i].score, initials: lastInitials(), lv: levelNo(players[i]) });\nif (r < 0) continue;\nrank = r; if (firstRank < 0) firstRank = r;\nstate = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0, who: i }; fx(SFX.record);\nreturn true;\n}\nreturn false;\n}\nfunction updateOver() {\nif (timer < 60 || !(pressed(A) || pressed(START))) return;\nfx(SFX.select);\nif (!nextInitials()) toTitle();\n}\nfunction updateInitials() {\nconst ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\nif (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\nif (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\nconst done = pressed(START) || (pressed(A) && ini.pos === 2);\nif (pressed(A) && ini.pos < 2) ini.pos++;\nif (!done || timer < 20) return;\nconst v = packInitials(ini.chars.join(''));\ndset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\nfx(SFX.select);\nif (!nextInitials()) { state = 'records'; hl = firstRank; timer = 0; }\n}\nfunction updateRecords() {\nif ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\nfunction updatePause() {\nif (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) startGame();\nelse toTitle();\n}\n}\nfunction draw() {\ncls();\nconst inPlay = state === 'play' || state === 'over' || state === 'turn' || state === 'bonus';\nif (inPlay) drawPlay();\nelse if (state === 'title' || state === 'players') { drawTable(titleCam()); drawMenuPanel(); if (state === 'title') drawTitle(); else drawPlayers(); }\nelse if (state === 'initials') drawInitials();\nelse if (state === 'records') drawRecords();\nif (state === 'turn') drawTurn();\nelse if (state === 'bonus') drawBonus();\nelse if (state === 'over') drawOver();\nif (paused) drawPause();\n}\nfunction drawPlay() { drawTable(Math.round(camY)); drawBanner(); drawPanel(); }\nconst titleCam = () => Math.round((TABLE_H - VIEW_H) / 2 * (1 - Math.cos(clock / 420)));\nfunction drawTable(cy) {\nconst R = Math.round, sy = (y) => R(y - cy);\nrectfill(0, 0, TABLE_W, 224, SHADOW);\nconst path = (P, c) => { for (let i = 1; i < P.length; i++) line(R(P[i - 1][0]), sy(P[i - 1][1]), R(P[i][0]), sy(P[i][1]), c); };\ncirc(PIT.x, sy(PIT.y), PIT.r, RED); if (bossUp) circfill(PIT.x, sy(PIT.y), BOSS_R, BOSS.flash ? GOLD : RED);\nfor (let i = 0; i < 5; i++) circfill(PIT.x - 24 + i * 12, sy(PIT.y + PIT.r + 8), 2, i + 1 < level ? GOLD : i + 1 === level && clock % 30 < 18 ? RED : SHADOW + 1);\nfor (const k in LAUNCH) path(LAUNCH[k].path, k === 'A' ? 9 : RED);\nfor (const r of RAMPS) { path(r.path, 9); circ(r.x, sy(r.y), RAMP_IN, 9); }\nfor (const w of WALLS) line(R(w[0]), sy(w[1]), R(w[2]), sy(w[3]), DIM);\nline(LANE_GATE[0], sy(LANE_GATE[1]), LANE_GATE[2], sy(LANE_GATE[3]), 9);\nSLOTS.forEach((s, i) => { circfill(s.x, sy(s.y), HOLE_R - 2, gates[i] ? GOLD : 2); if (!gates[i]) for (let x = s.l; x <= s.r; x += 4) line(x, sy(SLOT_GATE) - 3, x, sy(SLOT_GATE) + 1, DIM); });\nfor (const c of CUBBIES) circfill(c.x, sy(c.y), CUBBY_R - 3, GOLD);\nif (guided() >= 0) path(GUIDE[guided()], GOLD);\nfor (const e of BUMPERS) circfill(e.x, sy(e.y), BUMP_R, e.flash ? GOLD : RED);\nfor (const e of SLINGS) line(e.x0, sy(e.y0), e.x1, sy(e.y1), e.flash ? GOLD : RED);\nfor (const e of [...STANDUPS, CHEST]) for (let k = -1; k <= 1; k++) line(R(e.x0), sy(e.y0) + k, R(e.x1), sy(e.y1) + k, e === CHEST ? (chestLit && clock % 30 < 20 ? GOLD : DIM) : e.lit ? GREEN : 9);\nif (kickback) circfill(8, sy(590), 2, GREEN);\nfor (const f of flips) { const t = flipTip(f); for (let k = -1; k <= 1; k++) line(R(f.x), sy(f.y) + k, R(t.x), sy(t.y) + k, RED); circfill(R(f.x), sy(f.y), 2, GOLD); }\nfor (const b of bs) circfill(R(b.x), sy(b.y), BR - 1, b.ride ? GOLD : WHITE);\n}\nfunction drawMenuPanel() {\nrectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS); line(TABLE_W, 0, TABLE_W, 223, PANEL);\nconst top = readEntry(0), d = dget(DEEPEST_SLOT);\ntxt('HIGH', 196, 6, GOLD); txt(top.score ? short(top.score) : '-', 196, 18, WHITE);\ntxt('DEEPEST', 196, 40, GOLD); txt(d ? `D${Math.floor(d / 10)} L${d % 10}` : '-', 196, 52, RED);\ntxt('GAMES', 196, 74, GOLD); txt(String(dget(GAMES_SLOT)), 196, 86, WHITE);\n}\nfunction drawBanner() {\nrectfill(0, 0, TABLE_W, 12, ART.colors.GLASS);\nif (banner && banner.t > 0) { rectfill(0, 12, TABLE_W, 11, ART.colors.GLASS); ctab(banner.a, 2, GOLD); ctab(banner.b, 13, WHITE); return; }\nif (boss) { ctab(`PIT LORD ${'*'.repeat(boss.hp)}`, 2, clock % 20 < 14 ? RED : GOLD); return; }\nif (level === 5) { ctab('BOSS LIT: SHOOT A RAMP', 2, clock % 40 < 28 ? RED : GOLD); return; }\nconst L = LEVELS[level - 1];\nctab(`${L.what} ${goalN}/${goalOf(level)}`, 2, WHITE);\n}\nconst short = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e5 ? Math.floor(n / 1000) + 'K' : String(n));\nfunction drawPanel() {\nrectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS); line(TABLE_W, 0, TABLE_W, 223, PANEL);\ntxt(nPlayers > 1 ? `P${cur + 1}` : 'SCORE', 196, 4, GOLD); txt(String(score), 252 - String(score).length * 8, 14, WHITE);\ntxt(`BALL ${Math.min(BALLS, BALLS + 1 - balls)}`, 196, 26, balls > 1 ? DIM : RED);\ntxt(`D${depth} L${level}`, 196, 36, RED);\nfor (let i = 0; i < 2; i++) { const x = 198 + i * 14, c = i < keys ? GOLD : SHADOW; circ(x + 2, 52, 2, c); line(x + 4, 52, x + 10, 52, c); line(x + 9, 53, x + 9, 54, c); }\nif (spell) txt(`X${spell.m} ${Math.ceil(spell.t / 60)}`, 196, 60, spell.t > 300 || clock % 20 < 12 ? GOLD : RED);\nif (saveT > 0 && clock % 40 < 28) txt('SAVE', 196, 70, GREEN);\nif (msgT > 0 && (msgT > 30 || msgT % 8 < 5)) msg.split(' ').forEach((w, i) => txt(w, 196, 82 + i * 9, GOLD));\nif (nPlayers > 1) players.forEach((q, i) => { const v = short(i === cur ? score : q.score); txt(`${i + 1} ${v}`, 196, 104 + i * 9, i === cur ? WHITE : DIM); });\nconst mx = 238, my0 = 212, mh = 56, Y = (p) => Math.round(my0 - p * mh);\nrect(mx - 1, Y(1) - 1, 10, mh + 2, PANEL);\nrectfill(mx, Y(ZONE_A[1]), 8, Y(ZONE_A[0]) - Y(ZONE_A[1]), 9); rectfill(mx, Y(1), 8, Y(ZONE_B) - Y(1) + 1, RED);\nif (inLane() && plunge > 0) { const z = zoneOf(plunge); rectfill(mx + 2, Y(plunge), 4, Y(0) - Y(plunge), z ? WHITE : DIM); txt(z ? `RAMP ${z}` : 'PULL', 196, 196, z ? WHITE : DIM); }\ntxt('PULL', 200, Y(1) - 2, DIM);\n}\nfunction drawTurn() {\npanel(24, 76, 144, 56);\nctab(`PLAYER ${cur + 1}`, 88, GOLD); ctab(`BALL ${BALLS + 1 - balls}`, 102, WHITE);\nif (timer % 60 < 40) ctab('PULL TO LAUNCH', 118, DIM);\n}\nfunction drawBonus() {\nconst r = bonusRes, v = bonusShown();\npanel(16, 64, 160, 88);\nctab('BALL BONUS', 72, GOLD); ctab(`${r.base}`, 90, WHITE); ctab(`X DEPTH ${r.depth}`, 102, RED);\nctab(String(v), 120, v >= r.total ? GOLD : WHITE);\nif (timer >= BONUS_COUNT && timer % 60 < 40) ctab('A: CONTINUE', 138, DIM);\n}\nfunction drawOver() {\nconst best = Math.max(...players.map((q) => q.score));\npanel(8, 56, 240, 44 + players.length * 14 + (newDeepest ? 14 : 0) + 16);\nctxt('GAME OVER', 64, RED);\nplayers.forEach((q, i) => {\nconst y = 84 + i * 14, top = nPlayers > 1 && q.score === best;\ntxt(nPlayers > 1 ? `P${i + 1}` : '', 20, y, top ? GOLD : DIM);\ntxt(`D${q.depth} L${q.level}`, 48, y, RED); txt(String(q.score), 236 - String(q.score).length * 8, y, top ? GOLD : WHITE);\n});\nif (newDeepest) ctxt(`DEEPEST YET: D${Math.floor(newDeepest / 10)} L${newDeepest % 10}`, 84 + players.length * 14, GOLD);\nif (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 84 + players.length * 14 + (newDeepest ? 14 : 0) + 4, DIM);\n}\nfunction drawPlayers() {\npanel(10, 96, 172, 82);\nctab('HOW MANY PLAYERS?', 104, GOLD);\nfor (let i = 1; i <= 4; i++) { const x = 30 + (i - 1) * 36, on = i === nPlayers; if (on) rect(x - 4, 120, 24, 22, GOLD); txt(String(i), x + 4, 127, on ? WHITE : DIM); }\nctab('LEFT / RIGHT', 150, DIM); ctab('A: START  B: BACK', 162, DIM);\n}\nconst ctab = (s, y, c) => txt(s, 96 - s.length * 4, y, c);\nfunction drawTitle() {\npanel(16, 30, 160, 58);\nctab('DUNGEON', 38, RED); ctab('CRAWL', 52, RED); ctab('PINBALL', 66, GOLD);\npanel(40, 110, 112, 42);\n['PLAY', 'RECORDS'].forEach((t, i) => ctab(`${i === titleSel ? '> ' : '  '}${t}`, 118 + i * 16, i === titleSel ? WHITE : DIM));\nif (timer % 80 < 56) ctab('1 TO 4 PLAYERS', 176, DIM);\n}\nfunction drawRecords() {\npanel(24, 16, 208, 192);\nctxt('TOP 10', 24, GOLD);\ntopTen().forEach((e, i) => {\nconst y = 48 + i * 14, on = i === hl;\nif (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\ntxt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\ntxt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\ntxt(e.score ? String(e.score).padStart(8) : '', 112, y, i === 0 ? GOLD : WHITE);\nif (e.score && e.lv) txt(`D${Math.floor(e.lv / 10)}L${e.lv % 10}`, 184, y, RED);\n});\nconst d = dget(DEEPEST_SLOT);\nif (d) ctxt(`DEEPEST D${Math.floor(d / 10)} L${d % 10}   GAMES ${dget(GAMES_SLOT)}`, 180, DIM);\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawInitials() {\nconst ini = initials;\npanel(24, 40, 208, 144);\nctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\nctxt((nPlayers > 1 ? `PLAYER ${ini.who + 1}: ` : '') + String(players[ini.who].score), 68, WHITE);\nctxt('ENTER YOUR INITIALS', 90, DIM);\nfor (let i = 0; i < 3; i++) {\nconst on = i === ini.pos, x = 84 + i * 32;\nrect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\ntxt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n}\nif (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\nfunction drawPause() {\npanel(64, 80, 128, 64);\nctxt('PAUSED', 88, GOLD);\n['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "The Ivory Tower",
    "author": "NOVA-16",
    "description": "Stack slabs of marble into a tower that climbs from dawn to the stars: one tap to drop, perfect drops grow it back."
  },
  "label": "",
  "code": "// The Ivory Tower\n// Scaffolded by tools/new-cart.js. A tiny working game (dodge the falling blocks) around everything every cart\n// needs: a title, play, pause, game over, a saved top 10 with initials, a records screen, sound and music cues,\n// a skipTitle hook and save slots. Replace the play part, keep the frame. See docs/dev/playbook.md.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {},\n  scenes: {\"clouds\": {\"h\": 24, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"landmarks\": {\"h\": 77, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"stars\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 2, BEST_SLOT = 1, GAMES_SLOT = 2, INITIALS_SLOT = 3; // the best height (floors), games played, the last initials\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: floors, initials, points (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { floors: dget(s), initials: unpackInitials(dget(s + 1)), points: dget(s + 2) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.floors); dset(s + 1, packInitials(e.initials)); dset(s + 2, e.points); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a run into the top 10 if it makes it (more floors, then more points). Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.floors) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.floors > x.floors || (e.floors === x.floors && e.points > x.points));\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- State ---\n\nlet demo = false, idle = 0, titleTower = [], demoAim = null; // the demo: the game playing itself on the title's idle; the title's own tower\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\n// --- The tower and its rules (SPEC 5). Pixels and pixels a frame; the numbers are here, in one place, because only playing can set them. ---\n\nconst SLAB_H = 8, BASE_W = 96, CENTRE = 128, REACH = 110; // a slab is 8 px thick; the first is 96 wide; a slab's centre slides over CENTRE +- REACH\nconst PERFECT = 3, MIN_OVERLAP = 2, REGROW = 3, REGROW_FROM = 3; // a drop within 3 px is perfect; the third perfect in a row starts to give width back, 3 px each\nconst SPEED0 = 1.6, SPEED_STEP = 0.045, SPEED_MAX = 4.8; // the slide's speed at floor 0, how much each floor adds, and its limit\nconst BASE_Y = 176, TOP_Y = 140; // the screen y of the base slab's top at the start, and of the top slab's top once the tower is tall\nconst COUNT_IN = 60, FALL_FRAMES = 50, GRAVITY = 0.25; // frames before the first slab; a missed slab falls this long before the game is over\nconst POINTS_FLOOR = 10, POINTS_PERFECT = 10, PERFECT_CAP = 10, POINTS_LANDMARK = 100; // a floor, each perfect (times the run, up to the cap), a landmark\nconst METRES = 3, LADDER = 10; // a floor is 3 m; the perfect chime climbs a ladder of 10 notes, then repeats an octave higher\nlet bestAtStart = 0;\n\nlet floors = 0, tower = [], slab = null, slices = [], run = 0, bestRun = 0, perfects = 0, cam = 0, points = 0, newBest = false;\nlet rings = [], sparks = []; // the perfect's ring (one for each perfect, a few frames) and its sparkles\nconst speed = (n = floors) => Math.min(SPEED_MAX, SPEED0 + SPEED_STEP * n);\n/** The perfect's chime for a run of n: the note on a ladder of 10 (a pentatonic scale), and 1 for the repeat an octave higher after the tenth. */\nconst chimeNote = (n) => (n - 1) % LADDER, chimeOctave = (n) => Math.min(1, Math.floor((n - 1) / LADDER));\nconst DROP_BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y];\nconst dropped = () => DROP_BUTTONS.some((b) => pressed(b)); // a drop is a new press of any of these (a held button does not drop the next slab)\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  // The sky is a gradient set in scanline() from the camera's height; the landmarks, clouds and stars are layers 0, 1 and 2; the tower is drawn on the overlay.\n  marbleColors();\n  blend({ layers: ['overlay', 'bg1'], half: true });                   // the clouds are see-through, and so is the glass // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  if (skipTitle) startGame(); else toTitle();\n}\n\nconst TITLE_LIFT = 40, IDLE_FRAMES = 20 * 60; // the demo starts after 20 seconds without a button on the title\n\nfunction toTitle() {\n  state = 'title'; timer = 0; titleSel = 0; paused = false; demo = false; idle = 0; slab = null; slices = []; rings = []; sparks = []; banner = null;\n  cam = -TITLE_LIFT;                                       // the title has the tower higher up the screen, with room for the menu below\n  play(SONG.title);\n  const n = Math.max(5, Math.min(9, dget(BEST_SLOT)));  // the title shows a tower as high as the best (5 to 9 floors), a little off true like a person's\n  titleTower = [{ x: CENTRE - BASE_W / 2, w: BASE_W, ox: CENTRE - BASE_W / 2 }];\n  for (let k = 1; k <= n; k++) {\n    const t = titleTower[k - 1], d = Math.round((hash(k, 77) - 0.5) * 16), cut = Math.abs(d) <= PERFECT ? 0 : Math.abs(d);\n    titleTower.push(cut ? { x: Math.max(t.x, t.x + d), w: Math.max(40, t.w - cut), ox: t.x + d } : { x: t.x, w: Math.min(BASE_W, t.w + 3), ox: t.x });\n  }\n}\n\nfunction startGame(isDemo = false) {\n  demo = isDemo; demoAim = null;\n  floors = 0; points = 0; run = 0; bestRun = 0; perfects = 0; slices = []; cam = 0; newBest = false; bestAtStart = dget(BEST_SLOT);\n  tower = [{ x: CENTRE - BASE_W / 2, w: BASE_W, ox: CENTRE - BASE_W / 2 }];       // the base slab, centred\n  rings = []; sparks = []; banner = null;\n  slab = null; paused = false; timer = 0; state = 'play';\n  if (!demo) play(SONG.play);\n}\n\n/** The next slab: as wide as the top of the tower, from the left side on even floors and the right on odd ones. */\nfunction nextSlab() {\n  const w = tower[tower.length - 1].w, left = floors % 2 === 0;\n  slab = { x: (left ? CENTRE - REACH : CENTRE + REACH) - w / 2, w, dir: left ? 1 : -1 };\n}\n\n/** Put the slab down where it is: the overlap with the top of the tower stays (and a perfect keeps the whole), the rest is sliced off; no overlap is a miss. */\nfunction drop() {\n  const top = tower[tower.length - 1], sy = screenY(floors + 1);\n  const L = Math.max(slab.x, top.x), R = Math.min(slab.x + slab.w, top.x + top.w), ov = R - L;\n  if (ov < MIN_OVERLAP) { slab.fall = 0; slab.vy = 0; state = 'fall'; timer = 0; fx(SFX.hit); return false; }\n  let nx, nw, perfect = false;\n  if (Math.abs(slab.x - top.x) <= PERFECT) {              // dead on: the slab takes the place of the one below\n    perfect = true; nx = top.x; nw = top.w; run++; perfects++; bestRun = Math.max(bestRun, run);\n    if (run >= REGROW_FROM && nw < BASE_W) { const g = Math.min(REGROW, BASE_W - nw); nx -= g / 2; nw += g; }\n    points += POINTS_PERFECT * Math.min(run, PERFECT_CAP);\n    fx(SFX.point);\n  } else {                                                // sliced: what overhangs falls away\n    nx = L; nw = ov; run = 0;\n    const piece = (x, w, side) => slices.push({ k: floors + 1, x, w, ox: slab.x, y: sy, vx: slab.dir * speed() * 0.5, vy: 0, rot: 0, spin: side * (0.03 + 0.02 * hash(floors, 9)) });\n    if (slab.x < L) piece(slab.x, L - slab.x, -1);\n    if (slab.x + slab.w > R) piece(R, slab.x + slab.w - R, 1);\n    fx(SFX.move);\n  }\n  tower.push({ x: nx, w: nw, ox: slab.x }); floors++; points += POINTS_FLOOR;\n  if (perfect) shine(floors, nx, nw);\n  if (floors % 10 === 0 && floors <= 60) reach(floors / 10);\n  else if (!newBest && bestAtStart > 0 && floors > bestAtStart) beatBest();\n  slab = null;\n  nextSlab();\n  return true;\n}\n\n/** The screen y of the top of floor k (floor 0 is the base slab): the camera scrolls once the tower is tall enough. */\nfunction screenY(k) { return BASE_Y - (k * SLAB_H - cam); }\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play' || state === 'fall') updatePlay();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  skyUpdate();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (inputMask !== prevMask) idle = 0; else if (++idle >= IDLE_FRAMES) { startGame(true); return; }\n  if (pressed(SELECT)) { fx(SFX.select); state = 'records'; hl = -1; timer = 0; return; }\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) startGame(); else { state = 'records'; hl = -1; timer = 0; }\n  }\n}\n\n/** The game: wait a second, then a slab slides and is dropped with a press; a miss lets the slab fall. */\nfunction updatePlay() {\n  if (demo && (inputMask & ~prevMask)) { toTitle(); return; }   // any new press ends the demo\n  if (!demo && pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (state === 'fall') { updateFall(); return; }\n  if (!slab && !demo && floors === 0 && timer < COUNT_IN && timer % 20 === 1) fx(SFX.move);   // the count-in ticks 3, 2, 1\n  if (!slab && timer >= (demo ? 20 : COUNT_IN)) nextSlab();\n  if (slab) {\n    slab.x += slab.dir * speed();                           // slides across and turns at the end of its reach\n    const c = slab.x + slab.w / 2;\n    if (c > CENTRE + REACH) { slab.x = CENTRE + REACH - slab.w / 2; slab.dir = -1; } else if (c < CENTRE - REACH) { slab.x = CENTRE - REACH - slab.w / 2; slab.dir = 1; }\n    if (demo ? demoWants() : dropped()) drop();\n  }\n  updateSlices(); updateShine();\n  const want = Math.max(0, floors * SLAB_H - (BASE_Y - TOP_Y));\n  cam += (want - cam) * 0.15;                               // the camera follows, eased\n}\n\n/** The demo's player: aims at the top of the tower with an error of a few pixels (so it fumbles and ends in a while), and drops when the slab gets there. */\nfunction demoWants() {\n  const t = tower[tower.length - 1];\n  if (!demoAim || demoAim.of !== slab) demoAim = { of: slab, err: (rnd() + rnd() + rnd() - 1.5) * 9 };\n  return Math.abs(slab.x - (t.x + demoAim.err)) <= speed() / 2 + 0.5;\n}\n\n/** The slab that missed falls past the tower; then the game is over. */\nfunction updateFall() {\n  const s = slab; s.vy += GRAVITY; s.x += s.dir * speed() * 0.5; s.fall += s.vy;\n  updateSlices(); updateShine();\n  if (++timer > FALL_FRAMES) gameOver();\n}\n\nfunction updateSlices() {\n  for (const p of slices) { p.vy += GRAVITY; p.x += p.vx; p.y += p.vy; p.rot += p.spin; }\n  slices = slices.filter((p) => p.y < 260);\n}\n\nfunction gameOver() {\n  if (demo) { toTitle(); return; }                           // the demo records nothing\n  state = 'over'; timer = 0; slab = null; banner = null; play(-1); fx(SFX.over);\n  rank = insertTop({ floors, points, initials: lastInitials() });\n  dset(GAMES_SLOT, dget(GAMES_SLOT) + 1);\n  if (floors > dget(BEST_SLOT)) { dset(BEST_SLOT, floors); newBest = true; }\n}\n\n/** The camera flies back down the tower to the courtyard (the sky and the landmarks go by), then the result shows. */\nfunction updateOver() {\n  updateSlices(); updateShine();\n  if (timer > 20 && cam > 0) cam = Math.max(0, cam - Math.max(3, cam * 0.05));\n  if (timer < 60 || cam > 0 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  state = 'records'; hl = rank; timer = 0;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startGame(); // restart\n    else toTitle(); // quitting abandons the game: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  if (state === 'play' || state === 'fall' || state === 'over') drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (state === 'over' && cam <= 0 && timer >= 60) {\n    panel(40, 60, 176, 104); ctxt('GAME OVER', 70, RED); ctxt(`${floors} FLOORS  ${floors * METRES} M`, 88, WHITE); ctxt(`${points} POINTS`, 102, DIM);\n    ctxt(newBest ? 'NEW BEST!' : `BEST ${dget(BEST_SLOT)}`, 118, newBest ? GOLD : DIM);\n    if (timer % 60 < 40) ctxt('START: CONTINUE', 144, WHITE);\n  }\n  if (paused) drawPause();\n}\n\n// --- The sky and the landmarks (SPEC 5, 12) ---\n\n// Seven skies, one for each stretch of ten floors: [the top of the screen, the horizon], as 0-31 colours. A sky holds for the first five\n// floors of its stretch and blends into the next over the last five.\nconst SKIES = [\n  [[12, 18, 28], [31, 22, 19]],   // 0 The Courtyard: dawn, a pink horizon under a pale blue\n  [[7, 15, 28], [19, 26, 31]],    // 1 The Balcony: morning blue\n  [[4, 12, 27], [13, 23, 31]],    // 2 The Colonnade: bright day\n  [[2, 6, 20], [8, 17, 29]],      // 3 The Dome: deep blue above\n  [[7, 5, 17], [31, 17, 7]],      // 4 The Belfry: sunset, orange into purple\n  [[2, 2, 10], [20, 9, 17]],      // 5 The Spire: dusk\n  [[0, 0, 4], [3, 3, 13]],        // 6 The Stars: night\n];\nconst LANDMARKS = ['THE COURTYARD', 'THE BALCONY', 'THE COLONNADE', 'THE DOME', 'THE BELFRY', 'THE SPIRE', 'THE STARS'];\nconst BANNER_FRAMES = 120;\nconst SIL = 17, CLOUD = 33, STAR = 49, MOON = 52;   // CGRAM entries of art.py's BG palettes 1 (the landmarks), 2 (clouds) and 3 (stars, moon)\nconst INK = [4, 5, 12], GOLDEN = [31, 26, 10], WHITE3 = [31, 31, 31];\n\nlet skyLines = new Int16Array(224 * 3), banner = null;\nconst mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst setColor = (i, c) => color(i, Math.round(c[0]), Math.round(c[1]), Math.round(c[2]));\nconst clamp01 = (v) => Math.max(0, Math.min(1, v));\n/** The camera's height in floors (0 at the start; the top slab is 4.5 floors above the camera's bottom edge once it has scrolled). */\nconst climb = () => (state === 'title' ? 7 : cam / SLAB_H + 4.5 * Math.min(1, cam / (BASE_Y - TOP_Y)));   // the title looks at a morning sky with clouds\n\n/** The sky at height h (in floors): its top and horizon colours, how dark it is (stars), how bright (clouds). */\nfunction skyAt(h) {\n  const i = Math.max(0, Math.min(6, Math.floor(h / 10))), b = i < 6 ? clamp01((h - 10 * i - 5) / 5) : 0, n = SKIES[Math.min(6, i + 1)];\n  return {\n    top: mix(SKIES[i][0], n[0], b), bot: mix(SKIES[i][1], n[1], b),\n    stars: clamp01((h - 48) / 12),                            // the first stars at dusk, all of them by floor 60\n    day: Math.max(0.12, Math.min(1, 1 - (h - 38) / 14)),      // how bright the clouds are: dim from the sunset on\n    clouds: clamp01((h - 4) / 6),                             // clouds come in from floor 4\n  };\n}\n\n/** Each frame, from the camera: the gradient of the sky line by line, the colours of the landmarks, clouds and stars, and the three layers. */\nfunction skyUpdate() {\n  const h = climb(), k = skyAt(h);\n  for (let y = 0; y < 224; y++) {\n    const t = Math.pow(y / 223, 1.35);\n    skyLines[y * 3] = Math.round(k.top[0] + (k.bot[0] - k.top[0]) * t); skyLines[y * 3 + 1] = Math.round(k.top[1] + (k.bot[1] - k.top[1]) * t); skyLines[y * 3 + 2] = Math.round(k.top[2] + (k.bot[2] - k.top[2]) * t);\n  }\n  const haze = mix(k.bot, k.top, 0.25);                       // the landmarks are the horizon's colour, darker the nearer they are\n  setColor(SIL, mix(haze, INK, 0.28)); setColor(SIL + 1, mix(haze, INK, 0.52)); setColor(SIL + 2, mix(haze, INK, 0.78));\n  setColor(SIL + 3, mix(haze, WHITE3, 0.45)); setColor(SIL + 4, mix(mix(haze, INK, 0.52), GOLDEN, 0.25 + 0.75 * k.stars));\n  const cl = (w) => mix(k.bot, WHITE3, w * k.day);            // the clouds take the light of the sky: white by day, rosy at sunset, dim at night\n  [0.5, 0.7, 0.88, 1].forEach((w, j) => setColor(CLOUD + j, mix(k.bot, cl(w), clamp01(k.clouds))));\n  const tw = 0.7 + 0.3 * Math.sin(clock * 0.09);              // the stars twinkle together, a little\n  setColor(STAR, mix(k.top, WHITE3, 0.35 * k.stars)); setColor(STAR + 1, mix(k.top, WHITE3, 0.7 * k.stars * tw)); setColor(STAR + 2, mix(k.top, WHITE3, k.stars));\n  [0.2, 0.45, 0.7, 0.9, 1].forEach((w, j) => setColor(MOON + j, mix(k.top, WHITE3, w * Math.max(k.stars, 0.001) * 0.95)));\n  bg(0, { mx: 0, my: 0, mw: 32, mh: 77, x: 0, y: 352 - Math.round(cam), wrap: false, show: true });\n  bg(1, { mx: 32, my: 0, mw: 32, mh: 24, x: Math.round(clock * 0.12), y: -Math.round(cam * 0.5), wrap: true, show: k.clouds > 0.02 });\n  bg(2, { mx: 64, my: 0, mw: 32, mh: 28, x: 0, y: -Math.round((1 - k.stars) * 170), wrap: false, show: k.stars > 0.02 });   // the moon rises with the dark\n}\n\n/** A landmark is reached: the banner for two seconds and a chime. */\nfunction reach(k) { banner = { k, top: `FLOOR ${k * 10}`, name: LANDMARKS[k], t: 0 }; points += POINTS_LANDMARK; fx(SFX.record); }\n/** Past the best height of the games before: said once. */\nfunction beatBest() { newBest = true; banner = { k: -1, top: `${floors} FLOORS`, name: 'NEW BEST!', t: 0 }; fx(SFX.record); }\nfunction drawBanner() {\n  if (!banner) return;\n  const t = banner.t++, slide = Math.round(40 * (1 - clamp01(t / 12))) + Math.round(40 * clamp01((t - BANNER_FRAMES + 12) / 12));\n  if (t >= BANNER_FRAMES) { banner = null; return; }\n  panel(36, 46 - slide, 184, 34); ctxt(banner.top, 52 - slide, DIM); ctxt(banner.name, 64 - slide, GOLD);\n}\n\n// --- The marble (SPEC 5, 12): a slab is drawn from its floor number each frame, so no picture is stored and any width is cheap. ---\n\n// Five marbles, a new one every 10 floors. Each has 8 colours in CGRAM from MARBLE_BASE (the overlay addresses CGRAM directly):\n// 0 shadow, 1 stone, 2 light stone, 3 highlight, 4 faint vein, 5 strong vein, 6 gloss, 7 spare.\nconst MARBLE_BASE = 144, RING = 208;\nconst MARBLES = [\n  [[17, 17, 19], [26, 26, 25], [29, 29, 28], [31, 31, 30], [21, 21, 23], [13, 13, 17], [31, 31, 31]],     // Carrara: white, grey veins\n  [[3, 8, 6], [6, 15, 10], [9, 20, 14], [13, 24, 17], [14, 23, 17], [24, 30, 24], [26, 31, 27]],         // Verde: deep green, pale veins\n  [[1, 1, 2], [4, 4, 5], [8, 8, 9], [13, 13, 14], [14, 11, 4], [28, 22, 6], [20, 20, 22]],               // Nero: black, gold veins\n  [[19, 11, 13], [27, 19, 20], [30, 23, 23], [31, 27, 26], [29, 24, 24], [31, 30, 29], [31, 31, 30]],    // Rosa: pink, white veins\n  [[4, 8, 16], [8, 13, 24], [12, 18, 28], [17, 23, 30], [18, 22, 29], [26, 29, 31], [29, 31, 31]],       // Azul: blue, silver veins\n];\nfunction marbleColors() {\n  MARBLES.forEach((m, i) => m.forEach((c, j) => color(MARBLE_BASE + i * 8 + j, c[0], c[1], c[2])));\n  color(RING, 31, 28, 12);                                       // the ring: gold, see-through (an overlay colour from 192 up)\n}\nconst marbleOf = (k) => Math.floor(k / 10) % MARBLES.length;\n\n/** A number from 0 up to 1 from two integers: the same every time (the veins of a floor never change). */\nfunction hash(a, b) {\n  let h = Math.imul(a + 1, 374761393) + Math.imul(b + 7, 668265263) | 0;\n  h = Math.imul(h ^ (h >>> 13), 1274126177);\n  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n}\n\n/** Floor k's slab with its left edge at x, w wide, top at y. The veins and the gloss hang on ox (where the slab was\n * before any slicing), so a cut slab keeps its pattern; rows r0 to r1 only (a sheared slice draws it row by row). */\nfunction drawSlab(k, x, y, w, ox, r0 = 0, r1 = SLAB_H) {\n  x = Math.round(x); y = Math.round(y); w = Math.round(w); ox = Math.round(ox);\n  if (w < 1) return;\n  const c = MARBLE_BASE + marbleOf(k) * 8;\n  clip(x, y + r0, w, r1 - r0);\n  rectfill(x, y, w, SLAB_H, c + 1);                              // the stone\n  rectfill(x, y + 1, w, 2, c + 2);                               // lit from above\n  const n = 3 + Math.floor(hash(k, 1) * 3);\n  for (let j = 0; j < n; j++) {                                  // veins: a few slanted lines, some strong, some faint\n    const u = hash(k, 10 + j) * (BASE_W + 20) - 10, dx = Math.round((hash(k, 20 + j) - 0.5) * 12), strong = hash(k, 30 + j) > 0.5;\n    line(ox + u, y + 1, ox + u + dx, y + SLAB_H - 2, strong ? c + 5 : c + 4);\n    if (strong) line(ox + u + 1, y + 1, ox + u + dx + 1, y + SLAB_H - 2, c + 4);\n  }\n  rectfill(x, y, w, 1, c + 3);                                   // the bevel: a bright top edge, a shadow below, a bright left end, a dark right end\n  rectfill(x, y + SLAB_H - 1, w, 1, c);\n  rectfill(x, y, 1, SLAB_H, c + 3); rectfill(x + w - 1, y + 1, 1, SLAB_H - 1, c);\n  const g = ox + hash(k, 50) * (BASE_W - 24) + 8;                // a streak of gloss\n  line(g, y + 5, g + 4, y + 1, c + 6);\n  clip();\n}\n\n/** A slice tumbling: sheared, a row at a time. */\nfunction drawSlice(p) {\n  const sh = Math.max(-1.2, Math.min(1.2, p.rot));\n  for (let r = 0; r < SLAB_H; r++) { const d = Math.round(sh * (r - 3.5)); drawSlab(p.k, p.x + d, p.y, p.w, p.ox + d, r, r + 1); }\n}\n\n/** The perfect's ring, spreading from the slab, and the sparkles that rise from it. */\nfunction shine(k, x, w) {\n  rings.push({ k, x, w, t: 0 });\n  for (let i = 0; i < 5; i++) sparks.push({ k, x: x + (0.1 + 0.8 * hash(k * 5 + i, run)) * w, dy: -2, vy: -0.6 - hash(i, k) * 0.6, vx: (hash(i, k + 3) - 0.5) * 0.8, t: 0 });\n}\nfunction updateShine() {\n  for (const r of rings) r.t++;\n  rings = rings.filter((r) => r.t < 18);\n  for (const s of sparks) { s.t++; s.x += s.vx; s.dy += s.vy; s.vy += 0.02; }\n  sparks = sparks.filter((s) => s.t < 34);\n}\nfunction drawShine() {\n  for (const r of rings) { const e = Math.round(r.t * 0.6), y = Math.round(screenY(r.k)); rect(Math.round(r.x) - e - 1, y - e - 1, Math.round(r.w) + 2 * e + 2, SLAB_H + 2 * e + 2, RING); }\n  for (const s of sparks) {\n    const x = Math.round(s.x), y = Math.round(screenY(s.k) + s.dy), c = s.t > 22 && s.t % 4 < 2 ? GOLD : WHITE;\n    rectfill(x - 1, y, 3, 1, c); rectfill(x, y - 1, 1, 3, c);\n  }\n}\n\n/** The steps the tower stands on (the courtyard is layer 0), and its floors. */\nfunction drawTower(list) {\n  const by = screenY(0) + SLAB_H;\n  if (by < 224) { drawSlab(0, CENTRE - 60, by, 120, CENTRE - 60); drawSlab(0, CENTRE - 76, by + SLAB_H, 152, CENTRE - 76); }\n  list.forEach((t, k) => { const y = screenY(k); if (y > -SLAB_H && y < 224) drawSlab(k, t.x, y, t.w, t.ox); });\n}\n\n// The count-in's digits: 3 x 5 blocks, 6 px each.\nconst DIGITS = { 3: ['111', '001', '011', '001', '111'], 2: ['111', '001', '111', '100', '111'], 1: ['010', '110', '010', '010', '111'] };\nfunction bigDigit(d, cx, y, c) {\n  DIGITS[d].forEach((row, j) => [...row].forEach((v, i) => { if (v === '1') { rectfill(cx - 9 + i * 6 + 2, y + j * 6 + 2, 6, 6, SHADOW); rectfill(cx - 9 + i * 6, y + j * 6, 6, 6, c); } }));\n}\n\nfunction drawPlay() {\n  drawTower(tower);\n  drawShine();\n  for (const p of slices) drawSlice(p);\n  if (slab) drawSlab(floors + 1, slab.x, state === 'fall' ? screenY(floors + 1) + slab.fall : screenY(floors + 1), slab.w, slab.x);\n  txt(`FLOOR ${floors}`, 8, 6, WHITE);\n  if (!demo) {\n    txt(`POINTS ${points}`, 8, 18, DIM);\n    if (run > 0) txt(`PERFECT ${run}`, 8, 30, run >= REGROW_FROM ? GOLD : WHITE);\n    txt(`BEST ${Math.max(dget(BEST_SLOT), floors)}`, 192, 6, DIM);\n    txt(`${floors * METRES} M`, 192, 18, DIM);\n  }\n  drawBanner();\n  if (state === 'play' && !slab && !demo && floors === 0 && timer < COUNT_IN) bigDigit(Math.ceil((COUNT_IN - timer) / 20), 128, 70, GOLD);\n  if (demo && timer % 60 < 40) ctxt('DEMO: PRESS ANY BUTTON', 208, WHITE);\n}\n\nfunction drawTitle() {\n  drawTower(titleTower);\n  const top = titleTower[titleTower.length - 1], k = titleTower.length;\n  drawSlab(k, CENTRE - top.w / 2 + Math.sin(clock * 0.028) * (REACH - 20), screenY(k), top.w, CENTRE - top.w / 2 + Math.sin(clock * 0.028) * (REACH - 20));   // a slab sliding over it, for ever\n  panel(52, 8, 152, 36); ctxt('THE', 14, DIM); ctxt('IVORY  TOWER', 27, GOLD);\n  rect(56, 12, 144, 28, GOLD);\n  panel(84, 164, 88, 36);\n  ['PLAY', 'RECORDS'].forEach((t, i) => txt(`${i === titleSel ? '> ' : '  '}${t}`, 98, 171 + i * 13, i === titleSel ? WHITE : DIM));\n  const best = dget(BEST_SLOT);\n  if (best) ctxt(`BEST  ${best} FLOORS  ${best * METRES} M`, 208, WHITE);\n}\n\nfunction drawRecords() {\n  panel(24, 12, 208, 200);\n  ctxt('TOP 10', 20, GOLD);\n  txt('FLOORS', 120, 36, DIM); txt('POINTS', 176, 36, DIM);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 13, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.floors ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    txt(e.floors ? String(e.floors).padStart(4) : '', 128, y, i === 0 ? GOLD : WHITE);\n    txt(e.floors ? String(e.points).padStart(6) : '', 176, y, DIM);\n  });\n  ctxt(`BEST ${dget(BEST_SLOT)} FLOORS    GAMES ${dget(GAMES_SLOT)}`, 184, WHITE);\n  if (timer % 60 < 40) ctxt('START: BACK', 198, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW BEST!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(`${floors} FLOORS`, 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky's colour for that line (the SNES did its skies this way, with HDMA). */\nfunction scanline(y) { color(0, skyLines[y * 3], skyLines[y * 3 + 1], skyLines[y * 3 + 2]); }\n",

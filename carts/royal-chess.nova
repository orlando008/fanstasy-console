{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Royal Chess",
    "author": "NOVA-16",
    "description": "Straight chess on a polished palace board: play the computer at one of three gentle levels, or a friend on the same console. Every rule of the game, the legal moves lit for the piece you pick up, the captured pieces and who is ahead, and a game in progress kept for when you come back."
  },
  "label": "",
  "code": "// Royal Chess: straight chess, against the computer or a friend (docs/carts/royal-chess.md).\n// Built so far (the spec's plan, section 15): step 1, the position on a 0x88 board, FEN, the move generator with every\n// special move, legality by check, making and unmaking moves, perft (tested against the published counts), and a board\n// to play on with the cursor; step 2, the end of a game (checkmate, stalemate, the draws), promotion's choice, the\n// result, the menu's draw offer and resignation, and two pads; step 3, the computer (spec 7); step 4, the menus and the\n// saves (spec 10, 13); step 5, the side panel and the highlights (spec 4); step 6, the art (spec 12).\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {\"bishop0\": 55, \"bishop1\": 56, \"bishop2\": 57, \"bishop3\": 58, \"bishop4\": 59, \"bishop5\": 60, \"bishop6\": 43, \"bishop7\": 44, \"bishop8\": 45, \"king0\": 78, \"king1\": 79, \"king2\": 80, \"king3\": 40, \"king4\": 81, \"king5\": 42, \"king6\": 82, \"king7\": 76, \"king8\": 54, \"knight0\": 46, \"knight1\": 47, \"knight2\": 48, \"knight3\": 49, \"knight4\": 50, \"knight5\": 51, \"knight6\": 52, \"knight7\": 53, \"knight8\": 54, \"pawn0\": 37, \"pawn1\": 38, \"pawn2\": 39, \"pawn3\": 40, \"pawn4\": 41, \"pawn5\": 42, \"pawn6\": 43, \"pawn7\": 44, \"pawn8\": 45, \"queen0\": 69, \"queen1\": 70, \"queen2\": 71, \"queen3\": 72, \"queen4\": 73, \"queen5\": 74, \"queen6\": 75, \"queen7\": 76, \"queen8\": 77, \"rook0\": 61, \"rook1\": 62, \"rook2\": 63, \"rook3\": 64, \"rook4\": 65, \"rook5\": 66, \"rook6\": 52, \"rook7\": 67, \"rook8\": 68, \"sqD0_0\": 10, \"sqD0_1\": 11, \"sqD0_2\": 12, \"sqD0_3\": 13, \"sqD0_4\": 14, \"sqD0_5\": 15, \"sqD0_6\": 16, \"sqD0_7\": 17, \"sqD0_8\": 18, \"sqD1_0\": 28, \"sqD1_1\": 29, \"sqD1_2\": 30, \"sqD1_3\": 31, \"sqD1_4\": 32, \"sqD1_5\": 33, \"sqD1_6\": 34, \"sqD1_7\": 35, \"sqD1_8\": 36, \"sqL0_0\": 1, \"sqL0_1\": 2, \"sqL0_2\": 3, \"sqL0_3\": 4, \"sqL0_4\": 5, \"sqL0_5\": 6, \"sqL0_6\": 7, \"sqL0_7\": 8, \"sqL0_8\": 9, \"sqL1_0\": 19, \"sqL1_1\": 20, \"sqL1_2\": 21, \"sqL1_3\": 22, \"sqL1_4\": 23, \"sqL1_5\": 24, \"sqL1_6\": 25, \"sqL1_7\": 26, \"sqL1_8\": 27},\n  sprites: {\"held_bishop\": {\"pal\": 0, \"size\": 32, \"tile\": 396}, \"held_king\": {\"pal\": 0, \"size\": 32, \"tile\": 456}, \"held_knight\": {\"pal\": 0, \"size\": 32, \"tile\": 392}, \"held_pawn\": {\"pal\": 0, \"size\": 32, \"tile\": 384}, \"held_queen\": {\"pal\": 0, \"size\": 32, \"tile\": 452}, \"held_rook\": {\"pal\": 0, \"size\": 32, \"tile\": 448}, \"mini_bishop\": {\"pal\": 0, \"size\": 8, \"tile\": 390}, \"mini_king\": {\"pal\": 0, \"size\": 8, \"tile\": 405}, \"mini_knight\": {\"pal\": 0, \"size\": 8, \"tile\": 389}, \"mini_pawn\": {\"pal\": 0, \"size\": 8, \"tile\": 388}, \"mini_queen\": {\"pal\": 0, \"size\": 8, \"tile\": 404}, \"mini_rook\": {\"pal\": 0, \"size\": 8, \"tile\": 391}, \"shadow\": {\"pal\": 7, \"size\": 32, \"tile\": 460}},\n  scenes: {\"logo\": {\"h\": 28, \"mx\": 80, \"my\": 0, \"pal\": 7, \"w\": 32}, \"table\": {\"h\": 28, \"mx\": 48, \"my\": 0, \"pal\": 1, \"w\": 32}, \"title_table\": {\"h\": 28, \"mx\": 80, \"my\": 0, \"pal\": 1, \"w\": 32}},\n  colors: {\"CHECK\": 167, \"CURSOR\": 165, \"DARK\": 161, \"EBONY\": 163, \"FRAME\": 164, \"GLASS\": 169, \"IVORY\": 162, \"LAST\": 168, \"LIGHT\": 160, \"MOVE\": 166},\n};\n// END ART\n\n// --- Sound (SPEC 5). Songs use channels 0 to 5; effects take turns on 6 and 7, so they never cut into the music. ---\n\nconst SFX = { move: 0, select: 1, pause: 2, lift: 3, place: 4, capture: 5, no: 6, check: 7, promote: 8, mate: 9, draw: 10, castle: 11 };\nconst SONG = { title: 0, game: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- Save slots (spec 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 3;\n// The game in progress (slot 1: bit 0 a game is saved, bit 1 two players, bits 3 and 4 the level, bit 5 the person's\n// colour), its number of half-moves (2), the last level and colour chosen (3), and the moves from slot 10, two to a slot.\nconst GAME_SLOT = 1, PLIES_SLOT = 2, CHOICE_SLOT = 3, MOVES_SLOT = 10, MAX_SAVED = (256 - MOVES_SLOT) * 2;\n\n// --- Input: each pad's buttons this frame and last, for presses that do not repeat (btnp does) ---\n\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nconst masks = [0, 0, 0, 0], prevMasks = [0, 0, 0, 0];\nfunction readPads() {\n  for (let p = 0; p < 4; p++) { let m = 0; for (const b of BUTTONS) if (btn(b, p)) m |= 1 << b; prevMasks[p] = masks[p]; masks[p] = m; }\n}\nconst held = (b, p = 0) => (masks[p] & (1 << b)) !== 0;\nconst pressed = (b, p = 0) => held(b, p) && (prevMasks[p] & (1 << b)) === 0;\n\n// ===================================================================================================================\n// The rules (spec 5): a 0x88 board. A square is rank * 16 + file (a1 = 0, h1 = 7, a8 = 112); sq & 0x88 is off the\n// board. A piece is its type (1 pawn, 2 knight, 3 bishop, 4 rook, 5 queen, 6 king) plus 8 for Black; 0 is empty.\n// ===================================================================================================================\n\nconst PAWN = 1, KNIGHT = 2, BISHOP = 3, ROOK = 4, QUEEN = 5, KING = 6, BLACK = 8, WHITE_SIDE = 0, BLACK_SIDE = 1;\nconst W_OO = 1, W_OOO = 2, B_OO = 4, B_OOO = 8;\nconst N_STEPS = [33, 31, 18, 14, -14, -18, -31, -33], K_STEPS = [1, -1, 16, -16, 17, 15, -15, -17];\nconst B_STEPS = [17, 15, -15, -17], R_STEPS = [1, -1, 16, -16];\n// A move: from | to << 7 | promotion type << 14 | flags << 17.\nconst F_CAPTURE = 1, F_DOUBLE = 2, F_EP = 4, F_CASTLE = 8;\nconst mFrom = (m) => m & 127, mTo = (m) => (m >> 7) & 127, mPromo = (m) => (m >> 14) & 7, mFlags = (m) => m >> 17;\nconst mk = (from, to, promo = 0, flags = 0) => from | (to << 7) | (promo << 14) | (flags << 17);\n\nconst sideOf = (p) => (p & BLACK ? BLACK_SIDE : WHITE_SIDE), typeOf = (p) => p & 7;\nconst sqName = (s) => 'abcdefgh'[s & 7] + ((s >> 4) + 1);\nconst sqOf = (name) => (name.charCodeAt(1) - 49) * 16 + (name.charCodeAt(0) - 97);\n\n/** A new position from FEN (spec 6). */\nfunction fromFen(fen) {\n  const [placement, side, castle, ep, half, full] = fen.trim().split(/\\s+/);\n  const P = { b: new Int8Array(128), side: side === 'b' ? BLACK_SIDE : WHITE_SIDE, castle: 0, ep: -1, half: +half || 0, full: +full || 1, kings: [0, 0], undo: [], keys: [] };\n  let r = 7, f = 0;\n  for (const ch of placement) {\n    if (ch === '/') { r--; f = 0; }\n    else if (ch >= '1' && ch <= '8') f += +ch;\n    else {\n      const t = 'pnbrqk'.indexOf(ch.toLowerCase()) + 1, p = t | (ch === ch.toLowerCase() ? BLACK : 0);\n      P.b[r * 16 + f] = p; if (t === KING) P.kings[sideOf(p)] = r * 16 + f; f++;\n    }\n  }\n  for (const ch of castle || '-') P.castle |= { K: W_OO, Q: W_OOO, k: B_OO, q: B_OOO }[ch] || 0;\n  P.ep = ep && ep !== '-' ? sqOf(ep) : -1;\n  P.keys.push(posKey(P));\n  return P;\n}\n\n/** A position as FEN. */\nfunction toFen(P) {\n  let s = '';\n  for (let r = 7; r >= 0; r--) {\n    let empty = 0;\n    for (let f = 0; f < 8; f++) {\n      const p = P.b[r * 16 + f];\n      if (!p) { empty++; continue; }\n      if (empty) { s += empty; empty = 0; }\n      const ch = ' pnbrqk'[typeOf(p)];\n      s += p & BLACK ? ch : ch.toUpperCase();\n    }\n    if (empty) s += empty;\n    if (r) s += '/';\n  }\n  const c = (P.castle & W_OO ? 'K' : '') + (P.castle & W_OOO ? 'Q' : '') + (P.castle & B_OO ? 'k' : '') + (P.castle & B_OOO ? 'q' : '');\n  return `${s} ${P.side ? 'b' : 'w'} ${c || '-'} ${P.ep >= 0 ? sqName(P.ep) : '-'} ${P.half} ${P.full}`;\n}\n\n/** The position for the repetition rule: the pieces, the side to move, the castling rights and the en passant square. */\nfunction posKey(P) { let k = ''; for (let s = 0; s < 128; s++) if (!(s & 0x88)) k += ' pnbrqkXPNBRQK'[P.b[s]] || '.'; return k + P.side + P.castle + P.ep; }\n\n/** Is square s attacked by side `by`? */\nfunction attacked(P, s, by) {\n  const b = P.b, own = by ? BLACK : 0;\n  const pawnFrom = by ? [s + 15, s + 17] : [s - 15, s - 17];   // a pawn attacks diagonally forward\n  for (const q of pawnFrom) if (!(q & 0x88) && b[q] === (PAWN | own)) return true;\n  for (const d of N_STEPS) { const q = s + d; if (!(q & 0x88) && b[q] === (KNIGHT | own)) return true; }\n  for (const d of K_STEPS) { const q = s + d; if (!(q & 0x88) && b[q] === (KING | own)) return true; }\n  for (const d of B_STEPS) for (let q = s + d; !(q & 0x88); q += d) { const p = b[q]; if (p) { if (p === (BISHOP | own) || p === (QUEEN | own)) return true; break; } }\n  for (const d of R_STEPS) for (let q = s + d; !(q & 0x88); q += d) { const p = b[q]; if (p) { if (p === (ROOK | own) || p === (QUEEN | own)) return true; break; } }\n  return false;\n}\nconst inCheck = (P, side = P.side) => attacked(P, P.kings[side], side ^ 1);\n\n/** Every move for the side to move that obeys how the pieces move, not yet checked for leaving the king attacked. */\nfunction pseudoMoves(P, capturesOnly = false) {\n  const b = P.b, us = P.side, out = [], dir = us ? -16 : 16, start = us ? 6 : 1, last = us ? 0 : 7;\n  for (let s = 0; s < 128; s++) {\n    if (s & 0x88) { s += 7; continue; }\n    const p = b[s];\n    if (!p || sideOf(p) !== us) continue;\n    const t = typeOf(p);\n    if (t === PAWN) {\n      const add = (to, flags) => { if ((to >> 4) === last) for (const pr of [QUEEN, ROOK, BISHOP, KNIGHT]) out.push(mk(s, to, pr, flags)); else out.push(mk(s, to, 0, flags)); };\n      const one = s + dir;\n      if (!capturesOnly && !(one & 0x88) && !b[one]) {\n        add(one, 0);\n        const two = one + dir;\n        if ((s >> 4) === start && !b[two]) out.push(mk(s, two, 0, F_DOUBLE));\n      }\n      for (const to of [one - 1, one + 1]) {\n        if (to & 0x88) continue;\n        if (b[to] && sideOf(b[to]) !== us) add(to, F_CAPTURE);\n        else if (to === P.ep) out.push(mk(s, to, 0, F_CAPTURE | F_EP));\n      }\n    } else if (t === KNIGHT || t === KING) {\n      for (const d of t === KNIGHT ? N_STEPS : K_STEPS) {\n        const to = s + d;\n        if (to & 0x88) continue;\n        if (!b[to]) { if (!capturesOnly) out.push(mk(s, to)); }\n        else if (sideOf(b[to]) !== us) out.push(mk(s, to, 0, F_CAPTURE));\n      }\n    } else {\n      for (const d of t === BISHOP ? B_STEPS : t === ROOK ? R_STEPS : K_STEPS) {\n        for (let to = s + d; !(to & 0x88); to += d) {\n          if (!b[to]) { if (!capturesOnly) out.push(mk(s, to)); continue; }\n          if (sideOf(b[to]) !== us) out.push(mk(s, to, 0, F_CAPTURE));\n          break;\n        }\n      }\n    }\n  }\n  // Castling: the rights, empty squares between, and the king not in check nor passing through or onto an attack.\n  if (!capturesOnly) {\n    const k = us ? 116 : 4, them = us ^ 1;\n    if (b[k] === (KING | (us ? BLACK : 0)) && !attacked(P, k, them)) {\n      if (P.castle & (us ? B_OO : W_OO) && !b[k + 1] && !b[k + 2] && !attacked(P, k + 1, them) && !attacked(P, k + 2, them)) out.push(mk(k, k + 2, 0, F_CASTLE));\n      if (P.castle & (us ? B_OOO : W_OOO) && !b[k - 1] && !b[k - 2] && !b[k - 3] && !attacked(P, k - 1, them) && !attacked(P, k - 2, them)) out.push(mk(k, k - 2, 0, F_CASTLE));\n    }\n  }\n  return out;\n}\n\n// Castling rights lost when a piece moves from, or to, these squares (a king, or a rook's home).\nconst CASTLE_MASK = new Int8Array(128).fill(15);\nCASTLE_MASK[4] = 15 & ~(W_OO | W_OOO); CASTLE_MASK[0] = 15 & ~W_OOO; CASTLE_MASK[7] = 15 & ~W_OO;\nCASTLE_MASK[116] = 15 & ~(B_OO | B_OOO); CASTLE_MASK[112] = 15 & ~B_OOO; CASTLE_MASK[119] = 15 & ~B_OO;\n\n/** Make a move (no legality check). unmake() takes it back. track: keep the position's key, for the repetition rule. */\nfunction make(P, m, track = false) {\n  const b = P.b, from = mFrom(m), to = mTo(m), fl = mFlags(m), p = b[from], us = P.side;\n  let cap = b[to], capSq = to;\n  if (fl & F_EP) { capSq = to + (us ? 16 : -16); cap = b[capSq]; b[capSq] = 0; }\n  P.undo.push([m, cap, P.castle, P.ep, P.half]);\n  b[to] = mPromo(m) ? mPromo(m) | (us ? BLACK : 0) : p; b[from] = 0;\n  if (fl & F_CASTLE) { const rf = to > from ? from + 3 : from - 4, rt = to > from ? from + 1 : from - 1; b[rt] = b[rf]; b[rf] = 0; }\n  if (typeOf(p) === KING) P.kings[us] = to;\n  P.castle &= CASTLE_MASK[from] & CASTLE_MASK[to];\n  P.ep = fl & F_DOUBLE ? (from + to) >> 1 : -1;\n  P.half = typeOf(p) === PAWN || cap ? 0 : P.half + 1;\n  if (us) P.full++;\n  P.side ^= 1;\n  if (track) P.keys.push(posKey(P));\n}\nfunction unmake(P, track = false) {\n  const [m, cap, castle, ep, half] = P.undo.pop(), b = P.b, from = mFrom(m), to = mTo(m), fl = mFlags(m);\n  P.side ^= 1;\n  const us = P.side;\n  if (us) P.full--;\n  const p = mPromo(m) ? PAWN | (us ? BLACK : 0) : b[to];\n  b[from] = p; b[to] = 0;\n  if (fl & F_EP) b[to + (us ? 16 : -16)] = cap; else b[to] = cap;\n  if (fl & F_CASTLE) { const rf = to > from ? from + 3 : from - 4, rt = to > from ? from + 1 : from - 1; b[rf] = b[rt]; b[rt] = 0; }\n  if (typeOf(p) === KING) P.kings[us] = from;\n  P.castle = castle; P.ep = ep; P.half = half;\n  if (track) P.keys.pop();\n}\n\n/** The legal moves: the pseudo-legal ones that do not leave the mover's king attacked. */\nfunction legalMoves(P, capturesOnly = false) {\n  const out = [], us = P.side;\n  for (const m of pseudoMoves(P, capturesOnly)) { make(P, m); if (!inCheck(P, us)) out.push(m); unmake(P); }\n  return out;\n}\n\n/** The number of positions reached after `depth` half-moves: the standard test of a move generator. */\nfunction perft(P, depth) {\n  if (depth === 0) return 1;\n  let n = 0;\n  const us = P.side;\n  for (const m of pseudoMoves(P)) {\n    make(P, m);\n    if (!inCheck(P, us)) n += depth === 1 ? 1 : perft(P, depth - 1);\n    unmake(P);\n  }\n  return n;\n}\n\nconst START_FEN = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1';\n\n/** Not enough material for either side to mate (spec 5): king against king, a king and one minor piece against a\n * king, or kings and bishops alone with every bishop on squares of one colour. */\nfunction insufficient(P) {\n  const minors = [];\n  for (let s = 0; s < 128; s++) {\n    if (s & 0x88) continue;\n    const t = typeOf(P.b[s]);\n    if (t === PAWN || t === ROOK || t === QUEEN) return false;\n    if (t === KNIGHT || t === BISHOP) minors.push([t, ((s >> 4) + (s & 7)) & 1]);\n  }\n  if (minors.length <= 1) return true;\n  return minors.every(([t, c]) => t === BISHOP && c === minors[0][1]);\n}\n\n/** How the game stands after the last move: null while it goes on, else { winner: 0 White, 1 Black, -1 a draw, why }. */\nfunction gameResult(P) {\n  if (!legalMoves(P).length) return inCheck(P) ? { winner: P.side ^ 1, why: 'CHECKMATE' } : { winner: -1, why: 'STALEMATE' };\n  const key = P.keys[P.keys.length - 1];\n  if (P.keys.filter((k) => k === key).length >= 3) return { winner: -1, why: 'REPETITION' };\n  if (P.half >= 100) return { winner: -1, why: 'FIFTY MOVES' };\n  if (insufficient(P)) return { winner: -1, why: 'NOT ENOUGH MATERIAL' };\n  return null;\n}\n\n// ===================================================================================================================\n// The computer (spec 7): negamax with alpha-beta, iterative deepening and a quiescence search, on a copy of the position,\n// as a generator that yields every YIELD_NODES positions so the game runs on while it thinks.\n// ===================================================================================================================\n\nconst VALUE = [0, 100, 320, 330, 500, 900, 0];\n// How good each square is for a piece, from White's side (a8 first, as the board reads); Black's are these upside down.\nconst PST = [null,\n  [0, 0, 0, 0, 0, 0, 0, 0, 50, 50, 50, 50, 50, 50, 50, 50, 10, 10, 20, 30, 30, 20, 10, 10, 5, 5, 10, 25, 25, 10, 5, 5,\n    0, 0, 0, 20, 20, 0, 0, 0, 5, -5, -10, 0, 0, -10, -5, 5, 5, 10, 10, -20, -20, 10, 10, 5, 0, 0, 0, 0, 0, 0, 0, 0],\n  [-50, -40, -30, -30, -30, -30, -40, -50, -40, -20, 0, 0, 0, 0, -20, -40, -30, 0, 10, 15, 15, 10, 0, -30, -30, 5, 15, 20, 20, 15, 5, -30,\n    -30, 0, 15, 20, 20, 15, 0, -30, -30, 5, 10, 15, 15, 10, 5, -30, -40, -20, 0, 5, 5, 0, -20, -40, -50, -40, -30, -30, -30, -30, -40, -50],\n  [-20, -10, -10, -10, -10, -10, -10, -20, -10, 0, 0, 0, 0, 0, 0, -10, -10, 0, 5, 10, 10, 5, 0, -10, -10, 5, 5, 10, 10, 5, 5, -10,\n    -10, 0, 10, 10, 10, 10, 0, -10, -10, 10, 10, 10, 10, 10, 10, -10, -10, 5, 0, 0, 0, 0, 5, -10, -20, -10, -10, -10, -10, -10, -10, -20],\n  [0, 0, 0, 0, 0, 0, 0, 0, 5, 10, 10, 10, 10, 10, 10, 5, -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5,\n    -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5, 0, 0, 0, 5, 5, 0, 0, 0],\n  [-20, -10, -10, -5, -5, -10, -10, -20, -10, 0, 0, 0, 0, 0, 0, -10, -10, 0, 5, 5, 5, 5, 0, -10, -5, 0, 5, 5, 5, 5, 0, -5,\n    0, 0, 5, 5, 5, 5, 0, -5, -10, 5, 5, 5, 5, 5, 0, -10, -10, 0, 5, 0, 0, 0, 0, -10, -20, -10, -10, -5, -5, -10, -10, -20],\n  [-30, -40, -40, -50, -50, -40, -40, -30, -30, -40, -40, -50, -50, -40, -40, -30, -30, -40, -40, -50, -50, -40, -40, -30, -30, -40, -40, -50, -50, -40, -40, -30,\n    -20, -30, -30, -40, -40, -30, -30, -20, -10, -20, -20, -20, -20, -20, -20, -10, 20, 20, 0, 0, 0, 0, 20, 20, 20, 30, 10, 0, 0, 10, 30, 20],\n];\n// The king in the end game (no queens, or little else left): to the middle.\nconst KING_END = [-50, -40, -30, -20, -20, -30, -40, -50, -30, -20, -10, 0, 0, -10, -20, -30, -30, -10, 20, 30, 30, 20, -10, -30, -30, -10, 30, 40, 40, 30, -10, -30,\n  -30, -10, 30, 40, 40, 30, -10, -30, -30, -10, 20, 30, 30, 20, -10, -30, -30, -30, 0, 0, 0, 0, -30, -30, -50, -30, -30, -30, -30, -30, -30, -50];\nconst pstAt = (t, s, white, endgame) => { const i = (white ? 7 - (s >> 4) : s >> 4) * 8 + (s & 7); return t === KING && endgame ? KING_END[i] : PST[t][i]; };\n\n/** The position's value in centipawns, for the side to move. */\nfunction evaluate(P) {\n  let score = 0, heavy = 0;\n  for (let s = 0; s < 128; s++) { if (s & 0x88) { s += 7; continue; } const t = typeOf(P.b[s]); if (t === QUEEN || t === ROOK) heavy += VALUE[t]; }\n  const endgame = heavy <= 1300;\n  for (let s = 0; s < 128; s++) {\n    if (s & 0x88) { s += 7; continue; }\n    const p = P.b[s];\n    if (!p) continue;\n    const t = typeOf(p), white = !(p & BLACK), v = VALUE[t] + pstAt(t, s, white, endgame);\n    score += white ? v : -v;\n  }\n  return P.side ? -score : score;\n}\n\nconst LEVELS = [\n  { name: 'BEGINNER', depth: 1, qdepth: 2, noise: 120, blunder: 0.2, minT: 36, maxT: 60 },\n  { name: 'CASUAL', depth: 2, qdepth: 8, noise: 40, blunder: 0, minT: 36, maxT: 90 },\n  { name: 'STEADY', depth: 4, qdepth: 8, noise: 0, blunder: 0, minT: 36, maxT: 120 },\n];\nconst MATE = 30000, YIELD_NODES = 128, FRAME_NODES = 900;   // the search's positions a frame: about 2 to 6 ms\nconst BLUNDER_LOSS = 350;   // a beginner's random move never loses more than this (it does not hang the queen)\nlet nodes = 0;\n\n/** A copy of a position for the search (the game's own stays as it is while the computer thinks). */\nconst copyPos = (P) => ({ b: Int8Array.from(P.b), side: P.side, castle: P.castle, ep: P.ep, half: P.half, full: P.full, kings: P.kings.slice(), undo: [], keys: [] });\n\n/** Moves in the order to try them: the move given first, then captures (most valuable victim, least valuable attacker), then the rest. */\nfunction ordered(P, moves, first = 0) {\n  const score = (m) => (m === first ? 1e6 : (mFlags(m) & F_CAPTURE ? 1e4 + VALUE[typeOf(P.b[mTo(m)])] * 10 - VALUE[typeOf(P.b[mFrom(m)])] : 0) + (mPromo(m) ? 9e3 : 0));\n  return moves.map((m) => [score(m), m]).sort((a, b) => b[0] - a[0]).map((x) => x[1]);\n}\n\n/** Captures only, until the position is quiet (or qdepth runs out): so the search does not stop in the middle of an exchange. */\nfunction* quiesce(P, alpha, beta, qdepth) {\n  if (++nodes % YIELD_NODES === 0) yield;\n  const stand = evaluate(P);\n  if (stand >= beta || qdepth <= 0) return stand;\n  if (stand > alpha) alpha = stand;\n  const us = P.side;\n  for (const m of ordered(P, pseudoMoves(P, true))) {\n    make(P, m);\n    if (inCheck(P, us)) { unmake(P); continue; }\n    const v = -(yield* quiesce(P, -beta, -alpha, qdepth - 1));\n    unmake(P);\n    if (v >= beta) return v;\n    if (v > alpha) alpha = v;\n  }\n  return alpha;\n}\n\nfunction* alphaBeta(P, depth, alpha, beta, ply, L) {\n  if (depth <= 0) return yield* quiesce(P, alpha, beta, L.qdepth);\n  if (++nodes % YIELD_NODES === 0) yield;\n  const us = P.side;\n  let any = false;\n  for (const m of ordered(P, pseudoMoves(P))) {\n    make(P, m);\n    if (inCheck(P, us)) { unmake(P); continue; }\n    any = true;\n    const v = -(yield* alphaBeta(P, depth - 1, -beta, -alpha, ply + 1, L));\n    unmake(P);\n    if (v >= beta) return v;\n    if (v > alpha) alpha = v;\n  }\n  if (!any) return inCheck(P) ? -MATE + ply : 0;   // checkmated (sooner is worse), or stalemate\n  return alpha;\n}\n\n/** The computer's move for position P at level L: a generator; its return value is { move, score, depth }. */\nfunction* think(P, L) {\n  const Q = copyPos(P), root = legalMoves(Q), seen = new Set(P.keys);   // the game's positions so far\n  let best = root[0], bestScore = -MATE, scores = new Map(), done = 0;\n  for (let d = 1; d <= L.depth; d++) {\n    // With noise (the gentle levels) every root move is searched with the full window, so its score is exact and the\n    // noise and the blunders choose between true values; without, alpha-beta at the root too.\n    let alpha = -MATE - 1;\n    const now = new Map();\n    for (const m of ordered(Q, root, best)) {\n      make(Q, m);\n      // A move that leaves no reply ends the game: mate, or a stalemate (a draw, 0). Checked here, as a search of depth 1\n      // (BEGINNER) goes straight to the captures and would score a stalemate by the material it is ahead. A move back to\n      // a position the game has had scores as a draw too (0), so a side ahead does not drift into a repetition.\n      // That check costs about as much as 32 positions searched: counted, and a pause, so a frame's budget holds.\n      const over = !legalMoves(Q).length;\n      nodes += 32; yield;\n      const v = over ? (inCheck(Q) ? MATE - 1 : 0) : seen.has(posKey(Q)) ? 0\n        : -(yield* alphaBeta(Q, d - 1, -MATE - 1, L.noise ? MATE + 1 : -alpha, 1, L));\n      unmake(Q);\n      now.set(m, v);\n      if (v > alpha) alpha = v;\n    }\n    scores = now; done = d;\n    best = [...now.entries()].reduce((a, b) => (b[1] > a[1] ? b : a))[0];\n    thinkBest = { move: best, score: now.get(best), depth: d };   // what to play if time runs out in the next depth\n  }\n  // The level's noise: each root move's score moved by up to `noise`; and a beginner's random move now and then.\n  const noisy = [...scores.entries()].map(([m, v]) => [m, v + (L.noise ? rnd(2 * L.noise) - L.noise : 0)]);\n  let pick = noisy.reduce((a, b) => (b[1] > a[1] ? b : a));\n  const top = scores.get(best);\n  if (L.blunder && rnd() < L.blunder) {\n    const fair = [...scores.entries()].filter(([, v]) => v >= top - BLUNDER_LOSS);\n    pick = fair[rndi(0, fair.length - 1)];\n  }\n  bestScore = scores.get(pick[0]);\n  return { move: pick[0], score: bestScore, depth: done };\n}\nlet thinkBest = null;\n\n/** Run a search to its end at once (the tests and the draw offer): the generator stepped until it returns. */\nfunction thinkNow(P, L) { const g = think(P, L); let r; do r = g.next(); while (!r.done); return r.value; }\n\n// ===================================================================================================================\n// The board on the screen (spec 3, 4).\n// ===================================================================================================================\n\nconst SQ = 24, BX = 14, BY = 11, FRAME_W = 10;   // a square's size, the board's top left on the screen, and its frame (with the coordinates)\nconst PX = 216, PW = 40;   // the side panel: its left edge and width (4 small pieces a row)\nconst SQ_MX = 0, PC_MX = 24;   // where the squares' and the pieces' 24 x 24 cells are in Map RAM\nconst PIECE_NAMES = ['', 'pawn', 'knight', 'bishop', 'rook', 'queen', 'king'];\nconst screenX = (s) => BX + (s & 7) * SQ, screenY = (s) => BY + (7 - (s >> 4)) * SQ;\n\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0;\nlet pos = null;                 // the game's position\nlet cur = { f: 4, r: 1 };       // the cursor: file and rank\nlet liftedSq = -1, liftMoves = [];   // the square of the piece held, and its legal moves\nlet lastMove = 0;\nlet result = null;              // the game's end: { winner, why } (gameResult, a resignation or an agreed draw)\nlet promo = null;               // a promotion being chosen: { moves (Q, R, B, N), sel }\nlet cpu = null;                 // playing the computer: { side, level } (null: two players)\nlet thinking = null, thinkT = 0, thought = null;   // the computer's search under way, frames it has run, and its answer\nlet pad2 = false, whitePad = 0;  // two players: pad 2 has joined (it plays Black), and which pad has White (colours swap each game)\nlet pausePad = 0, menu = 'main', notice = '', noticeT = 0;   // the menu: who opened it, and its page ('main', 'resign', 'offer')\nconst MENU = ['RESUME', 'OFFER DRAW', 'RESIGN', 'NEW GAME', 'QUIT TO TITLE'];\nconst PROMOS = [QUEEN, ROOK, BISHOP, KNIGHT];\nlet TITLE_POS = null;   // the start position, shown behind the title\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  // The layers (spec 12): BG2 the squares and BG0 the pieces, each 24 x 24 cells of Map RAM lined up with the board by their\n  // scroll; BG1 the table round it. Sprites in palettes 4 to 7 (the shadow) are see-through.\n  const T = ART.scenes.table;\n  TITLE_POS = fromFen(START_FEN);\n  bg(2, { mx: SQ_MX, my: 0, mw: 24, mh: 24, x: -BX, y: -BY, wrap: false, show: true });\n  bg(1, { mx: T.mx, my: T.my, mw: T.w, mh: T.h, x: 0, y: 0, wrap: false, show: true });\n  bg(0, { mx: PC_MX, my: 0, mw: 24, mh: 24, x: -BX, y: -BY, wrap: false, show: true });\n  blend({ layers: ['spr'], half: true });\n  const ch = dget(CHOICE_SLOT);\n  setupLevel = ch & 1 << 4 ? ch & 3 : 1; setupColour = ch & 1 << 4 ? (ch >> 2) & 3 : 0;\n  if (skipTitle) newGame(); else toTitle();\n}\n\n// --- The saves (spec 13): a move is 16 bits (from and to as 0 to 63, and the promotion), two to a slot ---\n\nconst sq64 = (s) => (s >> 4) * 8 + (s & 7), sq88 = (i) => (i >> 3) * 16 + (i & 7);\nconst packMove = (m) => sq64(mFrom(m)) | (sq64(mTo(m)) << 6) | ((mPromo(m) ? mPromo(m) - 1 : 0) << 12);\nconst hasSave = () => (dget(GAME_SLOT) & 1) !== 0;\nlet saving = false;   // this game is saved after each move (a game from the start position, not one a test set up)\n\nfunction saveMove() {\n  if (!saving) return;\n  const n = pos.undo.length;\n  if (n > MAX_SAVED) { if (n === MAX_SAVED + 1) say('TOO LONG TO SAVE NOW'); return; }\n  const slot = MOVES_SLOT + ((n - 1) >> 1), v = packMove(lastMove);\n  dset(slot, (n - 1) & 1 ? (dget(slot) & 0xffff) | (v << 16) : v);\n  dset(PLIES_SLOT, n);\n  dset(GAME_SLOT, 1 | (cpu ? 0 : 2) | ((cpu ? cpu.level : 0) << 3) | ((cpu ? cpu.side ^ 1 : 0) << 5));\n}\nconst clearSave = () => dset(GAME_SLOT, 0);\n\n/** CONTINUE: the saved game, replayed from the start (which rebuilds its history for the repetition rule). */\nfunction continueGame() {\n  const g = dget(GAME_SLOT), n = dget(PLIES_SLOT);\n  cpu = g & 2 ? null : { level: (g >> 3) & 3, side: ((g >> 5) & 1) ^ 1 };\n  newGame();\n  for (let i = 0; i < n; i++) {\n    const v = (dget(MOVES_SLOT + (i >> 1)) >> (i & 1 ? 16 : 0)) & 0xffff, from = sq88(v & 63), to = sq88((v >> 6) & 63), pr = (v >> 12) & 3;\n    const m = legalMoves(pos).find((x) => mFrom(x) === from && mTo(x) === to && (!mPromo(x) || mPromo(x) === pr + 1));\n    if (!m) { clearSave(); newGame(); return; }   // a save that does not replay: start afresh\n    make(pos, m, true); lastMove = m;\n  }\n  cur = { f: 4, r: cpu && cpu.side === WHITE_SIDE ? 6 : 1 };\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\nconst titleItems = () => [...(hasSave() ? ['CONTINUE'] : []), 'PLAY THE COMPUTER', 'TWO PLAYERS'];\nlet setupLevel = 1, setupColour = 0, setupRow = 0;   // the level and colour screen: BEGINNER .. STEADY; WHITE, BLACK, RANDOM\nconst COLOURS = ['WHITE', 'BLACK', 'RANDOM'];\n\n/** A new game against the computer at the level and colour chosen (RANDOM picks one each game). */\nfunction startCpuGame() {\n  const mine = setupColour === 2 ? rndi(0, 1) : setupColour;\n  cpu = { level: setupLevel, side: mine ^ 1 };\n  newGame();\n}\n\nfunction newGame(fen = START_FEN) {\n  thinking = null; thought = null; saving = fen === START_FEN;\n  if (saving) { clearSave(); dset(PLIES_SLOT, 0); }\n  pos = fromFen(fen); cur = { f: 4, r: (cpu ? cpu.side === WHITE_SIDE : pos.side) ? 6 : 1 }; liftedSq = -1; liftMoves = []; lastMove = 0; result = null; promo = null;\n  state = 'game'; timer = 0; paused = false; play(SONG.game);\n}\n\n// --- Update ---\n\nfunction update() {\n  readPads(); clock++;\n  if (!paused) timer++;\n  if (noticeT) noticeT--;\n  if (state === 'game' && !cpu && !pad2 && masks[1] && !prevMasks[1]) pad2 = true;   // pad 2 joins: it plays Black from now on\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'game') updateGame();\n  else if (state === 'over') updateOver();\n  else if (state === 'setup') updateSetup();\n}\n\nfunction updateTitle() {\n  const items = titleItems(), n = items.length;\n  if (pressed(UP)) { titleSel = (titleSel + n - 1) % n; fx(SFX.move); }\n  if (pressed(DOWN)) { titleSel = (titleSel + 1) % n; fx(SFX.move); }\n  if (timer < 10 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  const item = items[titleSel];\n  if (item === 'CONTINUE') continueGame();\n  else if (item === 'TWO PLAYERS') { cpu = null; newGame(); }\n  else { state = 'setup'; timer = 0; setupRow = 0; }\n}\n\n/** The level and colour (spec 10): UP and DOWN the row, LEFT and RIGHT its value, A starts, B goes back. */\nfunction updateSetup() {\n  if (pressed(UP) || pressed(DOWN)) { setupRow ^= 1; fx(SFX.move); }\n  const d = (pressed(RIGHT) ? 1 : 0) - (pressed(LEFT) ? 1 : 0);\n  if (d && setupRow === 0) { setupLevel = (setupLevel + d + 3) % 3; fx(SFX.move); }\n  if (d && setupRow === 1) { setupColour = (setupColour + d + 3) % 3; fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.pause); toTitle(); return; }\n  if (timer > 10 && (pressed(A) || pressed(START))) { fx(SFX.select); dset(CHOICE_SLOT, setupLevel | (setupColour << 2) | (1 << 4)); startCpuGame(); }\n}\n\n/** The pad of a side: with two pads, White's is `whitePad` and Black's the other; with one, pad 1 plays both. */\nconst padOf = (side) => (pad2 && !cpu ? (side === WHITE_SIDE ? whitePad : whitePad ^ 1) : 0);\nconst movePad = () => padOf(pos.side);\nconst cpuToMove = () => cpu && pos.side === cpu.side;\n\n/** The computer's turn: step its search a frame's worth of positions; play its move once it has thought for at least\n * minT frames (so it does not snap down), and stop searching deeper at maxT. */\nfunction updateCpu() {\n  const L = LEVELS[cpu.level];\n  if (!thinking && !thought) { thinking = think(pos, L); thinkT = 0; thinkBest = null; nodes = 0; }\n  thinkT++;\n  if (thinking) {\n    const stop = nodes + FRAME_NODES;\n    while (nodes < stop) { const r = thinking.next(); if (r.done) { thought = r.value; thinking = null; break; } }\n    if (thinking && thinkT >= L.maxT && thinkBest) { thought = thinkBest; thinking = null; }   // out of time: the deepest search finished\n  }\n  if (thought && thinkT >= L.minT) { const m = thought.move; thought = null; playMove(m); }\n}\n\nfunction updateGame() {\n  const p = movePad();\n  for (const q of pad2 ? [0, 1] : [0]) if (pressed(START, q)) { paused = true; pausePad = q; pauseSel = 0; menu = 'main'; fx(SFX.pause); return; }\n  if (promo) { updatePromo(p); return; }\n  if (cpuToMove()) { moveCursor(p); updateCpu(); return; }   // the cursor still moves (to look), but nothing is picked up\n  moveCursor(p);\n  const s = cur.r * 16 + cur.f;\n  if (pressed(B, p) && liftedSq >= 0) { liftedSq = -1; liftMoves = []; fx(SFX.place); return; }\n  if (!pressed(A, p)) return;\n  const piece = pos.b[s];\n  if (liftedSq < 0 || (piece && sideOf(piece) === pos.side && s !== liftedSq)) {   // pick up (or change the piece held)\n    if (piece && sideOf(piece) === pos.side) {\n      liftMoves = legalMoves(pos).filter((m) => mFrom(m) === s);\n      liftedSq = s; fx(liftMoves.length ? SFX.lift : SFX.no);\n    } else fx(SFX.no);\n    return;\n  }\n  if (s === liftedSq) { liftedSq = -1; liftMoves = []; fx(SFX.place); return; }   // put it back where it was\n  const choices = liftMoves.filter((m) => mTo(m) === s);\n  if (!choices.length) { fx(SFX.no); return; }\n  if (mPromo(choices[0])) { promo = { moves: PROMOS.map((t) => choices.find((m) => mPromo(m) === t)), sel: 0 }; fx(SFX.select); return; }\n  playMove(choices[0]);\n}\n\nfunction moveCursor(p) {\n  const dx = (pressed(RIGHT, p) ? 1 : 0) - (pressed(LEFT, p) ? 1 : 0), dy = (pressed(UP, p) ? 1 : 0) - (pressed(DOWN, p) ? 1 : 0);\n  if (dx || dy) { cur.f = (cur.f + dx + 8) % 8; cur.r = (cur.r + dy + 8) % 8; fx(SFX.move); }\n}\n\n/** Choosing a promotion's piece: UP and DOWN, A confirms, B goes back to the pawn held. */\nfunction updatePromo(p) {\n  if (pressed(UP, p)) { promo.sel = (promo.sel + 3) % 4; fx(SFX.move); }\n  if (pressed(DOWN, p)) { promo.sel = (promo.sel + 1) % 4; fx(SFX.move); }\n  if (pressed(B, p)) { promo = null; fx(SFX.move); return; }\n  if (pressed(A, p)) { const m = promo.moves[promo.sel]; promo = null; playMove(m); }\n}\n\n/** A move into the game: made, remembered as the last move, with its sound; then the game may be over. */\nfunction playMove(m) {\n  make(pos, m, true);\n  lastMove = m; liftedSq = -1; liftMoves = []; promo = null;\n  saveMove();\n  const end = gameResult(pos);\n  if (end) { finish(end); return; }\n  fx(inCheck(pos) ? SFX.check : mPromo(m) ? SFX.promote : mFlags(m) & F_CASTLE ? SFX.castle : mFlags(m) & F_CAPTURE ? SFX.capture : SFX.place);\n}\n\n/** The game is over: the result panel over the final position (spec 10). */\nfunction finish(end) {\n  result = end; state = 'over'; timer = 0; paused = false; clearSave();   // a finished game is not saved\n  fx(end.winner < 0 ? SFX.draw : SFX.mate);\n}\n\n/** After the game: A a new game (two players with two pads swap colours), B the title. */\nfunction updateOver() {\n  if (timer < 30) return;\n  if (pressed(A)) { fx(SFX.select); if (pad2) whitePad ^= 1; if (cpu) startCpuGame(); else newGame(); }   // the same mode, level and colour\n  else if (pressed(B)) { fx(SFX.select); toTitle(); }\n}\n\n/** The menu, moved by the pad that opened it. RESIGN asks again; OFFER DRAW asks the other player (step 3: the computer\n * decides for itself). Who resigns or offers: the side of the pad that opened the menu (with one pad, the side to move). */\nfunction updatePause() {\n  const p = pausePad, side = pad2 ? (p === whitePad ? WHITE_SIDE : BLACK_SIDE) : pos.side;\n  if (menu === 'resign') {\n    if (pressed(A, p)) { fx(SFX.select); finish({ winner: side ^ 1, why: side ? 'BLACK RESIGNS' : 'WHITE RESIGNS' }); }\n    else if (pressed(B, p)) { menu = 'main'; fx(SFX.move); }\n    return;\n  }\n  if (menu === 'offer' && cpu) {   // the computer answers at once: yes if it is at most half a pawn ahead (spec 5)\n    const Q = copyPos(pos); Q.side = cpu.side; const v = thinkNow(Q, LEVELS[1]).score;\n    paused = false; menu = 'main';\n    if (v <= 50) { fx(SFX.select); finish({ winner: -1, why: 'DRAW AGREED' }); } else { say('DRAW DECLINED'); fx(SFX.no); }\n    return;\n  }\n  if (menu === 'offer') {   // the other player answers, on their pad (pad 1 if only one is used)\n    const q = padOf(side ^ 1);\n    if (pressed(A, q)) { fx(SFX.select); finish({ winner: -1, why: 'DRAW AGREED' }); }\n    else if (pressed(B, q)) { paused = false; menu = 'main'; say('DRAW DECLINED'); fx(SFX.no); }\n    return;\n  }\n  if (pressed(UP, p)) { pauseSel = (pauseSel + MENU.length - 1) % MENU.length; fx(SFX.move); }\n  if (pressed(DOWN, p)) { pauseSel = (pauseSel + 1) % MENU.length; fx(SFX.move); }\n  if (pressed(B, p) || (pressed(START, p) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A, p) || pressed(START, p)) {\n    fx(SFX.select);\n    const item = MENU[pauseSel];\n    if (item === 'RESUME') paused = false;\n    else if (item === 'OFFER DRAW') menu = 'offer';\n    else if (item === 'RESIGN') menu = 'resign';\n    else if (item === 'NEW GAME') { if (cpu) startCpuGame(); else newGame(); }\n    else toTitle();\n  }\n}\nfunction say(s) { notice = s; noticeT = 120; }\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  const sc = ART.scenes[state === 'title' ? 'logo' : 'table'];\n  bg(1, { mx: sc.mx, my: sc.my });   // the title's table has the name over the board\n  if (state === 'title' || state === 'setup') renderBoard(pos && state === 'setup' ? pos : TITLE_POS);   // the board, set up, behind the menus\n  if (state === 'game' || state === 'over') drawBoard();\n  else if (state === 'title') drawTitle();\n  else if (state === 'setup') drawSetup();\n  if (state === 'over') drawResult();\n  if (promo) drawPromo();\n  if (paused) drawPause();\n}\n\n/** A piece, for now: a disc in its side's colour with its letter (the art pass, step 6, carves them). */\n/** The board into Map RAM, square by square (spec 12): each square's wood (two grains, in palette 2; 5 for the last\n * move's squares, 6 under a king in check), and each piece over it (palette 3 ivory, 4 ebony). The piece held is left\n * off its square (it is a sprite). P: the position to show (the title shows the start). */\nfunction renderBoard(P) {\n  const checked = P === pos && state !== 'title' && inCheck(P) ? P.kings[P.side] : -1;\n  for (let s = 0; s < 128; s++) {\n    if (s & 0x88) { s += 7; continue; }\n    const f = s & 7, r = s >> 4, cx = f * 3, cy = (7 - r) * 3;\n    const last = P === pos && lastMove && (s === mFrom(lastMove) || s === mTo(lastMove));\n    const name = `sq${(f + r) % 2 ? 'L' : 'D'}${(f * 5 + r * 3) % 2}_`, pal = s === checked ? 6 : last ? 5 : 2;\n    const p = P === pos && s === liftedSq ? 0 : P.b[s], pn = p ? PIECE_NAMES[typeOf(p)] : '';\n    for (let i = 0; i < 9; i++) {\n      mset(SQ_MX + cx + (i % 3), cy + flr(i / 3), tile(ART.tiles[name + i], pal));\n      const t = pn ? ART.tiles[pn + i] : 0;\n      mset(PC_MX + cx + (i % 3), cy + flr(i / 3), t ? tile(t, p & BLACK ? 4 : 3) : 0);\n    }\n  }\n}\n/** A piece as a sprite (32 px: the piece held), at the top left of its 24 px square. */\nfunction pieceSprite(p, x, y) { const S = ART.sprites['held_' + PIECE_NAMES[typeOf(p)]]; spr(S.tile, x - 4, y - 2, { size: 32, pal: p & BLACK ? 1 : 0, prio: 3 }); }\n\nfunction drawBoard() {\n  const C = ART.colors;\n  renderBoard(pos);\n  for (const m of liftMoves) {   // the legal squares: a dot on an empty one, a ring on a capture\n    const x = screenX(mTo(m)) + 12, y = screenY(mTo(m)) + 12;\n    if (pos.b[mTo(m)] || mFlags(m) & F_EP) circ(x, y, 10, C.MOVE); else circfill(x, y, 3, C.MOVE);\n  }\n  for (let f = 0; f < 8; f++) print('abcdefgh'[f], BX + f * SQ + 9, BY + 8 * SQ + 1, ART.colors.IVORY);   // the coordinates, on the frame\n  for (let r = 0; r < 8; r++) print(String(r + 1), BX - FRAME_W + 1, BY + (7 - r) * SQ + 8, ART.colors.IVORY);\n  const cx = BX + cur.f * SQ, cy = BY + (7 - cur.r) * SQ;\n  rect(cx, cy, SQ, SQ, C.CURSOR); rect(cx + 1, cy + 1, SQ - 2, SQ - 2, C.CURSOR);\n  if (liftedSq >= 0) {   // the piece held: raised over the cursor, its shadow on the square\n    pieceSprite(pos.b[liftedSq], cx, cy - 4);\n    const S = ART.sprites.shadow; spr(S.tile, cx - 4, cy - 2, { size: 32, pal: 7, prio: 2 });\n  }\n  const status = state === 'over' ? (result.winner < 0 ? 'DRAWN' : result.winner ? 'BLACK WINS' : 'WHITE WINS')\n    : noticeT ? notice : cpuToMove() ? `${LEVELS[cpu.level].name} IS THINKING${'...'.slice(0, (flr(clock / 15) % 3) + 1)}`\n    : `${pos.side ? 'BLACK' : 'WHITE'} TO MOVE${inCheck(pos) ? ': CHECK!' : ''}`;\n  txt(status, 4, 215, noticeT || inCheck(pos) ? GOLD : WHITE);\n  drawPanel();\n}\n\n/** The pieces each side has taken, from the game's moves (so a promoted piece taken counts as what it was). */\nfunction captured() {\n  const out = [[], []];   // out[side]: the pieces that side has taken\n  for (const [, cap] of pos.undo) if (cap) out[sideOf(cap) ^ 1].push(cap);\n  return out.map((l) => l.sort((a, b) => VALUE[typeOf(b)] - VALUE[typeOf(a)]));\n}\nconst POINTS = [0, 1, 3, 3, 5, 9, 0];\n/** The material on the board in points (pawn 1, knight and bishop 3, rook 5, queen 9): White's less Black's. */\nfunction material() {\n  let m = 0;\n  for (let s = 0; s < 128; s++) { if (s & 0x88) continue; const p = pos.b[s]; if (p) m += (p & BLACK ? -1 : 1) * POINTS[typeOf(p)]; }\n  return m;\n}\n/** Who plays a side: the computer, the person, a pad, or just the colour. */\nconst nameOf = (side) => (cpu ? (side === cpu.side ? 'CPU' : 'YOU') : pad2 ? `P${padOf(side) + 1}` : side ? 'BLACK' : 'WHITE');\n\n/** The side panel (spec 4): Black at the top, White at the bottom, each with its name, the pieces it has taken (small,\n * in rows of four) and its lead in material; a marker beside whoever is to move. */\nfunction drawPanel() {\n  const caps = captured(), lead = material();\n  for (const side of [BLACK_SIDE, WHITE_SIDE]) {\n    const top = side === BLACK_SIDE, nameY = top ? 4 : 200, toMove = state !== 'over' && pos.side === side;\n    if (toMove) rectfill(PX, nameY - 2, PW, 11, ART.colors.CURSOR);\n    print(nameOf(side), PX + 20 - nameOf(side).length * 4, nameY, toMove ? SHADOW : WHITE);\n    caps[side].forEach((p, i) => {   // what this side has taken: the other side's pieces, small, in their colour\n      const x = PX + 3 + (i % 4) * 9, y = top ? 18 + flr(i / 4) * 10 : 188 - flr(i / 4) * 10, S = ART.sprites['mini_' + PIECE_NAMES[typeOf(p)]];\n      spr(S.tile, x, y, { size: 8, pal: p & BLACK ? 1 : 0, prio: 3 });\n    });\n    const ahead = side === WHITE_SIDE ? lead : -lead;\n    if (ahead > 0) print(`+${ahead}`, PX + 4, top ? 60 : 146, GREEN);\n  }\n  if (cpuToMove()) print('...'.slice(0, (flr(clock / 15) % 3) + 1), PX + 28, cpu.side ? 4 : 200, SHADOW);\n}\n\n/** The promotion's choice, beside the square: the four pieces, one lit. */\nfunction drawPromo() {\n  panel(46, 70, 128, 72);\n  ctxt('PROMOTE TO', 78, GOLD);\n  PROMOS.forEach((t, i) => txt(`${i === promo.sel ? '>' : ' '} ${PIECE_NAMES[t].toUpperCase()}`, 74, 92 + i * 11, i === promo.sel ? WHITE : DIM));\n}\n\n/** The result, over the final position (spec 10). */\nfunction drawResult() {\n  panel(10, 72, 200, 64);\n  const head = { CHECKMATE: 'CHECKMATE', STALEMATE: 'STALEMATE', REPETITION: 'DRAW BY REPETITION', 'FIFTY MOVES': 'DRAW: FIFTY MOVES',\n    'NOT ENOUGH MATERIAL': 'DRAW: NO MATE POSSIBLE', 'DRAW AGREED': 'DRAW AGREED' }[result.why] || result.why;\n  ctxt(head, 80, GOLD);\n  ctxt(result.winner < 0 ? 'THE GAME IS DRAWN' : result.winner ? 'BLACK WINS' : 'WHITE WINS', 96, WHITE);\n  if (timer > 30) ctxt('A: NEW GAME   B: TITLE', 118, DIM);\n}\n\nfunction drawTitle() {\n  const items = titleItems(), h = items.length * 12 + 8;\n  panel(26, 154 - h, 168, h);\n  items.forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 34, 158 - h + i * 12, i === titleSel ? WHITE : DIM));\n  if (hasSave()) { const g = dget(GAME_SLOT); txt(`SAVED: ${g & 2 ? 'TWO PLAYERS' : LEVELS[(g >> 3) & 3].name}, MOVE ${(dget(PLIES_SLOT) >> 1) + 1}`, 4, 215, DIM); }\n}\n\nfunction drawSetup() {\n  panel(10, 36, 200, 168);\n  ctxt('PLAY THE COMPUTER', 50, GOLD);\n  panel(22, 76, 176, 60);\n  [['LEVEL', LEVELS[setupLevel].name], ['YOU PLAY', COLOURS[setupColour]]].forEach(([k, v], i) => {\n    const y = 88 + i * 22, on = i === setupRow;\n    txt(k, 34, y, on ? WHITE : DIM); txt(on ? `< ${v} >` : `  ${v}`, 106, y, on ? GOLD : WHITE);\n  });\n  ctxt(['MAKES MISTAKES ON PURPOSE', 'A RELAXED GAME', 'THINKS FOUR MOVES AHEAD'][setupLevel], 150, DIM);\n  ctxt('A: PLAY   B: BACK', 190, DIM);\n}\n\nfunction drawPause() {\n  if (menu === 'resign') { panel(30, 84, 160, 44); ctxt('RESIGN THE GAME?', 92, GOLD); ctxt('A: RESIGN   B: NO', 110, WHITE); return; }\n  if (menu === 'offer') { panel(6, 84, 208, 44); ctxt('A DRAW IS OFFERED', 92, GOLD); ctxt(`${pad2 ? `P${padOf(pos.side ^ (pausePad === padOf(pos.side) ? 1 : 0)) + 1} ` : ''}A: ACCEPT   B: DECLINE`, 110, WHITE); return; }\n  panel(38, 64, 144, 84);\n  ctxt('PAUSED', 72, GOLD);\n  MENU.forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 50, 88 + i * 11, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, BX + 4 * SQ - s.length * 4, y, c);   // centred on the board\n",

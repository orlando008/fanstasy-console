{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Ice Breakers",
    "author": "NOVA-16",
    "description": "A match-3 puzzle across twelve frozen levels: swap gems to break the ice, collect a colour or reach a score before the moves run out, with a hint when you are stuck, a song for the early levels and a faster one for the late ones."
  },
  "label": "",
  "code": "// Ice Breakers: a match-3 on hand-made levels. Swap two neighbouring gems; three or more in a row clear, the rest fall, new\n// ones drop in, and chains score more. The board has ice on some cells: a clear on an iced cell, or beside one, breaks it.\n// Each level has a goal (all the ice gone, a number of gems of one kind, or a number of points) and a move budget.\n// The frame (title, play, pause, game over, a saved top 10 with initials, records, sound and music cues, skipTitle and save\n// slots) came from the puzzle starter (tools/new-cart.js --kind puzzle). The spec is docs/carts/ice-breakers.md.\n//\n// The board logic is plain functions on an array of gem types (findRuns, hasMoves, makeTypes, popScore), kept apart from the\n// gems' pictures and movement, so tests and bots can call them. The play state is a small machine (`phase`):\n//   idle -> swap -> (no match: unswap -> idle) | (match: pop -> fall -> pop ... -> settle -> idle | win -> fall | over | shuffle -> fall)\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"cursor\": {\"pal\": 6, \"size\": 16, \"tile\": 268}, \"gem0\": {\"pal\": 0, \"size\": 16, \"tile\": 256}, \"gem1\": {\"pal\": 1, \"size\": 16, \"tile\": 258}, \"gem2\": {\"pal\": 2, \"size\": 16, \"tile\": 260}, \"gem3\": {\"pal\": 3, \"size\": 16, \"tile\": 262}, \"gem4\": {\"pal\": 4, \"size\": 16, \"tile\": 264}, \"gem5\": {\"pal\": 5, \"size\": 16, \"tile\": 266}, \"icon_ice\": {\"pal\": 6, \"size\": 16, \"tile\": 270}, \"icon_star\": {\"pal\": 7, \"size\": 16, \"tile\": 288}},\n  scenes: {\"board\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"ice0\": {\"h\": 2, \"mx\": 0, \"my\": 40, \"pal\": 2, \"w\": 2}, \"ice1\": {\"h\": 2, \"mx\": 2, \"my\": 40, \"pal\": 2, \"w\": 2}, \"ice2\": {\"h\": 2, \"mx\": 4, \"my\": 40, \"pal\": 2, \"w\": 2}, \"ice3\": {\"h\": 2, \"mx\": 6, \"my\": 40, \"pal\": 2, \"w\": 2}},\n  colors: {},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y); opts as for spr (fx, fy, pal, prio ...). Priority 1: above the background, under the ice (BG1, high priority). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 1, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once (an ice crack and the pieces falling).\n\nconst SFX = { move: 0, select: 1, pause: 2, swap: 3, bad: 4, match: 5, clear: 10, over: 11, shuffle: 12, record: 13, ice: 14, shatter: 15, win: 16, level: 17 }; // match: 5 to 9, higher in a chain\nconst SONG = { title: 0, play: 1, late: 2 }; // the game song is `play` for levels 1 to 6 and `late` for 7 to 12\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: score, initials, the level reached (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\n/** What a top-10 entry says it reached: L7 for a game lost on level 7; WON for one that cleared them all (that is stored as one past the last level). */\nconst reached = (l) => (l > LEVELS.length ? 'WON' : `L${l}`);\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)), level: dget(s + 2) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, e.level || 0); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- The board: rules as plain functions on an array of gem types (0 to KINDS-1, -1 for empty), row by row ---\n\nconst COLS = 8, ROWS = 8, CELL = 16, BX = 64, BY = 64, KINDS = 6; // the board's size, its cells in px, its top left corner\nconst POP_FRAMES = 14, WIN_FRAMES = 100, INTRO_FRAMES = 120, HINT_FRAMES = 360, FALL = 4; // a match's flash, the level-clear banner, a level's opening banner, the wait before a hint (6 s), a gem's speed in px a frame\nconst ICE_MAP = 32, ICE_BREAK = 12; // the ice's map region on BG1 starts at map column 32; frames a cell of ice takes to break (3 pictures of 4)\n\n/** The runs of three or more equal gems, across or down: an array of arrays of cell numbers. */\nfunction findRuns(t) {\n  const runs = [];\n  for (let line = 0; line < ROWS + COLS; line++) {\n    const across = line < ROWS, len = across ? COLS : ROWS, at = (k) => (across ? line * COLS + k : k * COLS + (line - ROWS));\n    for (let k = 0; k < len;) {\n      const v = t[at(k)]; let e = k + 1;\n      while (v >= 0 && e < len && t[at(e)] === v) e++;\n      if (v >= 0 && e - k >= 3) runs.push(Array.from({ length: e - k }, (_, j) => at(k + j)));\n      k = e;\n    }\n  }\n  return runs;\n}\n/** The cells in any run (a cell where two runs cross counts once). */\nconst matched = (t) => [...new Set(findRuns(t).flat())];\nconst swapped = (t, a, b) => { const u = t.slice(); u[a] = t[b]; u[b] = t[a]; return u; };\n/** Does any swap of two neighbours make a run? */\nfunction hasMoves(t) {\n  for (let i = 0; i < t.length; i++) {\n    if (i % COLS < COLS - 1 && matched(swapped(t, i, i + 1)).length) return true;\n    if (i < t.length - COLS && matched(swapped(t, i, i + COLS)).length) return true;\n  }\n  return false;\n}\n/** A full board with no run and at least one move. */\nfunction makeTypes() {\n  for (;;) {\n    const t = Array(COLS * ROWS).fill(-1);\n    for (let i = 0; i < t.length; i++) {\n      let v;\n      do v = rndi(0, KINDS - 1); while ((i % COLS >= 2 && t[i - 1] === v && t[i - 2] === v) || (i >= 2 * COLS && t[i - COLS] === v && t[i - 2 * COLS] === v));\n      t[i] = v;\n    }\n    if (hasMoves(t)) return t;\n  }\n}\n/** Points for one clear: 10 a gem, 30 more for each run of four or more, all times the chain (1 for the first clear, 2 for the one it caused ...). */\nconst popScore = (count, bigRuns, chain) => (10 * count + 30 * bigRuns) * chain;\n// --- Levels (SPEC 6). A goal is ICE (break all the ice), GEMS (collect `n` gems of kind `kind`) or POINTS (earn `n` points in\n// the level; the clear bonus does not count). `ice` lists the cells that start with ice. A level's moves are its budget. ---\n\nconst ICE_GOAL = 'ice', GEMS_GOAL = 'gems', POINTS_GOAL = 'points';\n/** The cells whose (row, column) pass f: how an ice layout is written. */\nconst cellsWhere = (f) => Array.from({ length: COLS * ROWS }, (_, i) => i).filter((i) => f(flr(i / COLS), i % COLS));\nconst edge = (r, c) => r === 0 || r === ROWS - 1 || c === 0 || c === COLS - 1;\nconst corner = (r, c) => (r === 0 || r === ROWS - 1) && (c === 0 || c === COLS - 1);\nconst DASH = [1, 3, 4, 6]; // along a side: where the dashes of the dashed border are (the same from both ends, so the layout is symmetric)\nconst GEM_NAMES = ['RED', 'ORANGE', 'YELLOW', 'GREEN', 'BLUE', 'PURPLE']; // the kinds of gem, in the order art.py draws them\n// The moves are each level's cost to the bot at skill 1 (sweep.mjs, SPEC 6) plus about 4.5, so a good player has a few to spare.\nconst LEVELS = [\n  { goal: ICE_GOAL, moves: 12, ice: cellsWhere((r) => r === 3) },                                                    // a bar across the middle\n  { goal: POINTS_GOAL, n: 1000, moves: 16, ice: [] },\n  { goal: GEMS_GOAL, n: 12, kind: 2, moves: 15, ice: [] },\n  { goal: ICE_GOAL, moves: 12, ice: cellsWhere((r, c) => r >= 2 && r <= 5 && (r + c) % 2 === 0) },                  // a checker in the middle\n  { goal: POINTS_GOAL, n: 1200, moves: 18, ice: [] },\n  { goal: GEMS_GOAL, n: 14, kind: 4, moves: 17, ice: [] },\n  { goal: ICE_GOAL, moves: 19, ice: cellsWhere((r, c) => edge(r, c) && !corner(r, c) && DASH.includes(r === 0 || r === ROWS - 1 ? c : r)) },  // a dashed border\n  { goal: POINTS_GOAL, n: 1400, moves: 20, ice: [] },\n  { goal: GEMS_GOAL, n: 17, kind: 1, moves: 22, ice: [] },\n  { goal: ICE_GOAL, moves: 17, ice: cellsWhere((r, c) => edge(r, c) && !corner(r, c)) },                            // the whole border, without its corners\n  { goal: POINTS_GOAL, n: 1600, moves: 23, ice: [] },\n  { goal: ICE_GOAL, moves: 19, ice: cellsWhere((r, c) => (edge(r, c) && !corner(r, c)) || ((r === c || r + c === COLS - 1) && r > 0 && r < ROWS - 1)) },  // the border and both diagonals, but not the corners\n];\n\n// --- The gems: a picture for each cell, sliding to its place ---\n\nlet grid = [];            // ROWS * COLS gems { t: type, x, y: pixel position of the picture } or null\nlet phase = 'idle';       // idle | swap | unswap | pop | fall | win\nlet cursor = 0, sel = -1; // the cursor's cell; the picked-up gem's cell, or -1\nlet sw = [0, 0];          // the two cells of the swap being shown\nlet popCells = [], popT = 0, winT = 0, chain = 0;\nlet score = 0, levelPts = 0, moves = 0, level = 1, lev = LEVELS[0]; // the total score; the points earned in this level; moves left; the level; its entry in LEVELS\nlet ice = [], gemsGot = 0, won = false, introT = 0; // the ice on each cell (true: iced); the gems of the goal's kind cleared in this level; the game is won; frames left of the level's opening banner\nlet idleT = 0, hint = null; // frames with no button pressed, with the board at rest; the hint: the two cells of a good swap, or null\nlet iceFx = Array(COLS * ROWS).fill(0), iceShown = Array(COLS * ROWS).fill(-1); // frames left of each cell's breaking; which of the ice pictures each cell has on BG1 (-1 none: the map starts empty)\n\nconst cellX = (i) => BX + (i % COLS) * CELL, cellY = (i) => BY + flr(i / COLS) * CELL;\nconst typesNow = () => grid.map((g) => (g ? g.t : -1));\n/** A new board of gems, dropping in from above the screen (every column falls the same way). */\nfunction dealBoard() {\n  const t = makeTypes();\n  grid = t.map((v, i) => ({ t: v, x: cellX(i), y: BY + (flr(i / COLS) - ROWS) * CELL }));\n  phase = 'fall';\n}\n/** The cell i and the cells next to it (across or down): a clear on i breaks the ice on these. */\nconst nbrs = (i) => [i, i % COLS ? i - 1 : -1, i % COLS < COLS - 1 ? i + 1 : -1, i >= COLS ? i - COLS : -1, i < COLS * (ROWS - 1) ? i + COLS : -1].filter((j) => j >= 0);\nconst iceCount = () => ice.filter(Boolean).length;\n/** A clear breaks the ice on its cells and beside them. */\nfunction breakIce(cells) {\n  let n = 0;\n  for (const i of cells) for (const j of nbrs(i)) if (ice[j]) { ice[j] = false; iceFx[j] = ICE_BREAK; n++; }\n  return n; // how many cells of ice broke\n}\n/** Show the ice on BG1: the frost on an iced cell, then the cracks and the shards of one that has just broken (the pictures are in Map RAM, ART.scenes ice0 to ice3). */\nfunction paintIce() {\n  for (let i = 0; i < COLS * ROWS; i++) {\n    const v = ice[i] ? 0 : iceFx[i] > 0 ? 1 + flr((ICE_BREAK - iceFx[i]) / 4) : -1;\n    if (v === iceShown[i]) continue;\n    iceShown[i] = v;\n    const sc = ART.scenes[`ice${Math.max(v, 0)}`], bx = ICE_MAP + BX / 8 + (i % COLS) * 2, by = BY / 8 + flr(i / COLS) * 2;\n    for (let k = 0; k < 4; k++) mset(bx + (k & 1), by + (k >> 1), v < 0 ? 0 : mget(sc.mx + (k & 1), sc.my + (k >> 1)));\n  }\n}\n/** Is the level's goal met? */\nconst goalMet = () => (lev.goal === ICE_GOAL ? iceCount() === 0 : lev.goal === GEMS_GOAL ? gemsGot >= lev.n : levelPts >= lev.n);\n/** How far the player is towards the goal, from 0 to 1 (the bar). */\nconst progress = () => (lev.goal === ICE_GOAL ? 1 - iceCount() / lev.ice.length : lev.goal === GEMS_GOAL ? gemsGot / lev.n : levelPts / lev.n);\n/** The goal and the progress to it, short enough for the HUD (14 characters at most). */\nconst goalText = () => (lev.goal === ICE_GOAL ? `ICE LEFT ${iceCount()}` : lev.goal === GEMS_GOAL ? `${GEM_NAMES[lev.kind]} ${gemsGot}/${lev.n}` : `GOAL ${levelPts}/${lev.n}`);\n/** What the level asks, in words (the opening banner). */\nconst goalWords = () => (lev.goal === ICE_GOAL ? 'BREAK ALL THE ICE' : lev.goal === GEMS_GOAL ? `COLLECT ${lev.n} ${GEM_NAMES[lev.kind]}` : `EARN ${lev.n} POINTS`);\n/** The swap worth most to the goal (the hint): the ice it breaks (12 a cell), the gems of the goal's kind it clears (8 more each) and the gems it clears. [a, b], or null. */\nfunction bestSwap() {\n  const t = typesNow();\n  let best = null, top = 0;\n  for (let i = 0; i < t.length; i++) {\n    for (const j of [i % COLS < COLS - 1 ? i + 1 : -1, i < COLS * (ROWS - 1) ? i + COLS : -1]) {\n      if (j < 0) continue;\n      const u = swapped(t, i, j), cl = matched(u);\n      if (!cl.length) continue;\n      let w = cl.length + 8 * cl.filter((c) => u[c] === lev.kind).length;\n      for (const k of new Set(cl.flatMap((c) => nbrs(c)))) if (ice[k]) w += 12;\n      if (w > top) { top = w; best = [i, j]; }\n    }\n  }\n  return best;\n}\n/** Start level n: its goal, its moves and its ice, and a new board dropping in under the level's opening banner. */\nfunction startLevel(n) {\n  level = n; lev = LEVELS[n - 1]; moves = lev.moves; levelPts = 0; gemsGot = 0; chain = 0; sel = -1; introT = INTRO_FRAMES; idleT = 0; hint = null; fx(SFX.level); play(n > 6 ? SONG.late : SONG.play);\n  ice = Array(COLS * ROWS).fill(false); iceFx.fill(0);\n  for (const i of lev.ice) ice[i] = true;\n  dealBoard();\n}\n/** Move every gem a step towards its cell. Returns true while any is still on its way. */\nfunction moveGems() {\n  let moving = false;\n  grid.forEach((g, i) => {\n    if (!g) return;\n    const tx = cellX(i), ty = cellY(i);\n    g.x += Math.sign(tx - g.x) * Math.min(FALL, Math.abs(tx - g.x));\n    g.y += Math.sign(ty - g.y) * Math.min(FALL, Math.abs(ty - g.y));\n    if (g.x !== tx || g.y !== ty) moving = true;\n  });\n  return moving;\n}\n/** Gems fall to fill the gaps; new ones drop in above the board. */\nfunction collapse() {\n  for (let c = 0; c < COLS; c++) {\n    let dst = ROWS - 1;\n    for (let r = ROWS - 1; r >= 0; r--) {\n      const g = grid[r * COLS + c];\n      if (!g) continue;\n      if (dst !== r) { grid[dst * COLS + c] = g; grid[r * COLS + c] = null; }\n      dst--;\n    }\n    for (let r = dst; r >= 0; r--) grid[r * COLS + c] = { t: rndi(0, KINDS - 1), x: BX + c * CELL, y: BY + (r - dst - 1) * CELL };\n  }\n}\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  const b = ART.scenes.board; // the background: the board's picture in Map RAM, shown on layer 2 (the back)\n  bg(0, { show: false }); // layer 0 is on by default: this cart does not use it\n  bg(2, { mx: b.mx, my: b.my, mw: b.w, mh: b.h, show: true });\n  bg(1, { mx: ICE_MAP, my: 0, mw: b.w, mh: b.h, show: false }); // the ice: a map region of its own (empty until paintIce), in front of the gems\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\n\nfunction startGame() {\n  score = 0; won = false; cursor = 3 * COLS + 3;\n  paused = false; timer = 0; state = 'play';\n  startLevel(1);\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) startGame(); else { state = 'records'; hl = -1; timer = 0; }\n  }\n}\n\n/** One frame of play: the pad in `idle`, otherwise the machine waits for the gems to settle, then takes its next step. */\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  for (let i = 0; i < COLS * ROWS; i++) if (iceFx[i] > 0) iceFx[i]--; // the ice that is breaking\n  const intro = introT > 0; // the opening banner: the pad waits for it (A skips it)\n  if (intro) introT = pressed(A) ? 0 : introT - 1;\n  const moving = moveGems();\n  if (phase === 'idle') {\n    if (!intro) idleInput();\n    idleT = intro || (inputMask & ~prevMask) ? 0 : idleT + 1; // any press starts the wait again\n    hint = idleT >= HINT_FRAMES ? hint || bestSwap() : null;   // after HINT_FRAMES at rest with no press, mark a good swap\n  }\n  else if (phase === 'pop') { if (--popT <= 0) afterPop(); }\n  else if (phase === 'win') { if (--winT <= 0) afterWin(); }\n  else if (!moving) {\n    if (phase === 'swap') afterSwap();\n    else if (phase === 'unswap') phase = 'idle';\n    else if (phase === 'fall') afterFall();\n  }\n}\n\n/** The cursor moves with the d-pad. A picks a gem up; then a direction swaps it with that neighbour (A or B puts it down). */\nfunction idleInput() {\n  const dx = (pressed(RIGHT) ? 1 : 0) - (pressed(LEFT) ? 1 : 0), dy = (pressed(DOWN) ? 1 : 0) - (pressed(UP) ? 1 : 0);\n  const c = cursor % COLS, r = flr(cursor / COLS);\n  if (sel < 0) {\n    if (dx || dy) {\n      const nc = mid(0, COLS - 1, c + dx), nr = mid(0, ROWS - 1, r + (dx ? 0 : dy));\n      if (nr * COLS + nc !== cursor) { cursor = nr * COLS + nc; fx(SFX.move); }\n    }\n    if (pressed(A)) { sel = cursor; fx(SFX.select); }\n  } else if (pressed(A) || pressed(B)) { sel = -1; fx(SFX.move); }\n  else if (dx || dy) {\n    const nc = c + dx, nr = r + (dx ? 0 : dy);\n    if (nc >= 0 && nc < COLS && nr >= 0 && nr < ROWS) { cursor = nr * COLS + nc; trySwap(sel, cursor); }\n  }\n}\n\nfunction trySwap(a, b) {\n  const t = grid[a]; grid[a] = grid[b]; grid[b] = t;\n  sw = [a, b]; sel = -1; phase = 'swap'; fx(SFX.swap);\n}\n\n/** The swap has been shown: keep it if it made a run (it costs a move), otherwise slide the gems back. */\nfunction afterSwap() {\n  if (matched(typesNow()).length) { moves--; chain = 1; startPop(); }\n  else { const t = grid[sw[0]]; grid[sw[0]] = grid[sw[1]]; grid[sw[1]] = t; phase = 'unswap'; fx(SFX.bad); }\n}\n\n/** Score the runs and let the gems flash. */\nfunction startPop() {\n  const t = typesNow(), runs = findRuns(t);\n  popCells = matched(t); popT = POP_FRAMES; phase = 'pop';\n  const gain = popScore(popCells.length, runs.filter((r) => r.length >= 4).length, chain);\n  score += gain; levelPts += gain;\n  fx(SFX.match + Math.min(chain - 1, 4));\n}\nfunction afterPop() {\n  const broke = breakIce(popCells);\n  if (broke) { fx(SFX.ice); if (broke >= 3) fx(SFX.shatter); } // a crack; and the pieces falling when three or more cells go at once\n  for (const i of popCells) { if (grid[i].t === lev.kind) gemsGot++; grid[i] = null; }\n  popCells = [];\n  collapse();\n  phase = 'fall';\n}\n/** The gems have landed: a chain goes on if they made a run; otherwise the turn is over. */\nfunction afterFall() {\n  if (matched(typesNow()).length) { chain++; startPop(); return; }\n  chain = 0;\n  settle();\n}\n/** The turn is over: the level is won, or the game lost, or the board is stuck (reshuffled), or the player goes on. */\nfunction settle() {\n  if (goalMet()) { const bonus = moves * 50; score += bonus; winT = WIN_FRAMES; phase = 'win'; fx(SFX.clear); }\n  else if (moves <= 0) gameOver();\n  else if (!hasMoves(typesNow())) { dealBoard(); fx(SFX.shuffle); }\n  else phase = 'idle';\n}\n/** The level is won: the next one, or the game is won after the last. */\nfunction afterWin() {\n  if (level < LEVELS.length) startLevel(level + 1);\n  else { won = true; gameOver(); }\n}\n\nfunction gameOver() {\n  state = 'over'; timer = 0; play(-1); fx(won ? SFX.win : SFX.over); phase = 'idle'; sel = -1; introT = 0;\n  rank = insertTop({ score, initials: lastInitials(), level: won ? LEVELS.length + 1 : level });\n}\n\nfunction updateOver() {\n  if (timer < 60 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  state = 'records'; hl = rank; timer = 0;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startGame(); // restart\n    else toTitle(); // quitting abandons the game: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  bg(1, { show: state === 'play' || state === 'over' }); // the ice is only there while a game is\n  if (state === 'play' || state === 'over') drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (state === 'over') {\n    if (won) confetti();\n    panel(48, 68, 160, 88);\n    if (won) rect(50, 70, 156, 84, GOLD); // the win screen has a gold border\n    ctxt(won ? 'YOU WON!' : 'GAME OVER', 76, won ? GOLD : RED);\n    ctxt(won ? 'ALL LEVELS CLEARED' : `LEVEL ${level}`, 92, WHITE);\n    if (!won) ctxt(goalText(), 104, DIM); // what the level asked for, and how far the player got\n    ctxt(`${won ? 'FINAL ' : ''}SCORE ${score}`, 120, WHITE);\n    if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 138, DIM);\n  }\n  if (paused) drawPause();\n}\n\nfunction drawPlay() {\n  paintIce();\n  grid.forEach((g, i) => {\n    if (!g || g.y <= -CELL) return;\n    if (phase === 'pop' && popCells.includes(i) && (popT >> 1) & 1) return; // the matched gems flash\n    sprite(ART.sprites[`gem${g.t}`], g.x, g.y);\n  });\n  if (hint && timer % 40 < 26) for (const c of hint) { rect(cellX(c), cellY(c), CELL, CELL, GOLD); rect(cellX(c) - 1, cellY(c) - 1, CELL + 2, CELL + 2, GOLD); } // the hint: the two gems to swap, blinking\n  if (state === 'play' && phase === 'idle') {\n    if (sel >= 0) sprite(ART.sprites.cursor, cellX(sel), cellY(sel), { pal: 7, prio: 2 }); // the cursor is above the ice\n    sprite(ART.sprites.cursor, cellX(cursor), cellY(cursor), { pal: 6, prio: 2 });\n  }\n  txt(`SCORE ${score}`, 8, 8, WHITE);\n  txt(`LEVEL ${level}`, 8, 20, GOLD);\n  txt(goalText(), 136, 8, WHITE);\n  sprite(lev.goal === ICE_GOAL ? ART.sprites.icon_ice : lev.goal === GEMS_GOAL ? ART.sprites[`gem${lev.kind}`] : ART.sprites.icon_star, 116, 3, { prio: 3 }); // the goal's picture, left of its text\n  txt(`MOVES ${moves}`, 168, 20, moves <= 3 ? RED : GREEN);\n  const bar = mid(0, 1, progress()); // progress to the goal\n  rectfill(8, 36, 240, 6, SHADOW); rectfill(8, 36, flr(240 * bar), 6, bar >= 1 ? GOLD : CYAN);\n  if (chain > 1 && phase !== 'idle') ctxt(`CHAIN x${chain}`, 202, GOLD);\n  if (introT > 0 && state === 'play') { panel(32, 84, 192, 56); icicles(32, 85, 192); ctxt(`LEVEL ${level}`, 92, GOLD); ctxt(goalWords(), 106, WHITE); ctxt(`IN ${lev.moves} MOVES`, 120, DIM); }\n  if (phase === 'win') { panel(40, 86, 176, 48); ctxt(`LEVEL ${level} CLEAR!`, 96, GOLD); ctxt(`BONUS ${moves * 50}`, 112, WHITE); }\n}\n\nfunction drawTitle() {\n  ctxt('ICE BREAKERS', 50, GOLD);\n  ['PLAY', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    txt(e.score ? reached(e.level) : '', 112, y, e.level > LEVELS.length ? GOLD : DIM);\n    txt(e.score ? String(e.score).padStart(8) : '', 140, y, i === 0 ? GOLD : WHITE);\n  });\n  if (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(String(score), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\n/** The win screen's gems, falling past the panel (sprites are under the overlay's panel, so they fall behind it and round it). */\nfunction confetti() {\n  for (let k = 0; k < 16; k++) sprite(ART.sprites[`gem${k % KINDS}`], 8 + ((k * 53 + 17) % 224), ((timer * 2 + k * 29) % 260) - 24, { prio: 3 });\n}\n/** A fringe of icicles hanging from y, across x to x + w (the level banner's top edge). */\nfunction icicles(x, y, w) {\n  for (let i = 0; i < w / 8; i++) {\n    for (let r = 0; r < 7; r++) { const half = 3 - (r >> 1) - (i % 3 === 1 ? 1 : 0); if (half > 0) rectfill(x + i * 8 + 4 - half, y + r, 2 * half, 1, CYAN); }\n  }\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SHADOW); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Tabletop Grand Prix",
    "author": "NOVA-16",
    "description": "Toy cars race across the breakfast table and the garage workbench, for 1 to 4 players. The camera follows the leader: drop off the screen and you are out of the round, the last car left scores a point, and the first to five wins the race. Two cups of four tracks, with milk spills, crumbs, oil and jumps between tables."
  },
  "label": null,
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {\"cloth0\": 1, \"cloth1\": 2, \"cloth2\": 3, \"cloth3\": 4, \"lip\": 47, \"ramp\": 30, \"road0\": 5, \"road1\": 6, \"road10\": 15, \"road11\": 16, \"road12\": 17, \"road13\": 18, \"road14\": 19, \"road15\": 20, \"road2\": 7, \"road3\": 8, \"road4\": 9, \"road5\": 10, \"road6\": 11, \"road7\": 12, \"road8\": 13, \"road9\": 14, \"roadv0\": 21, \"roadv1\": 22, \"rough0\": 24, \"rough1\": 27, \"slick0\": 25, \"slick1\": 28, \"start\": 23, \"sticky0\": 26, \"sticky1\": 29, \"wall0\": 31, \"wall1\": 32, \"wall10\": 41, \"wall11\": 42, \"wall12\": 43, \"wall13\": 44, \"wall14\": 45, \"wall15\": 46, \"wall2\": 33, \"wall3\": 34, \"wall4\": 35, \"wall5\": 36, \"wall6\": 37, \"wall7\": 38, \"wall8\": 39, \"wall9\": 40},\nsprites: {\"bearing\": {\"pal\": 0, \"size\": 8, \"tile\": 417}, \"bshadow\": {\"pal\": 7, \"size\": 8, \"tile\": 432}, \"car0\": {\"pal\": 0, \"size\": 16, \"tile\": 384}, \"car1\": {\"pal\": 0, \"size\": 16, \"tile\": 386}, \"car2\": {\"pal\": 0, \"size\": 16, \"tile\": 388}, \"car3\": {\"pal\": 0, \"size\": 16, \"tile\": 390}, \"car4\": {\"pal\": 0, \"size\": 16, \"tile\": 392}, \"fall0\": {\"pal\": 0, \"size\": 16, \"tile\": 394}, \"fall1\": {\"pal\": 0, \"size\": 16, \"tile\": 396}, \"fall2\": {\"pal\": 0, \"size\": 16, \"tile\": 398}, \"orange\": {\"pal\": 0, \"size\": 16, \"tile\": 418}, \"pea\": {\"pal\": 0, \"size\": 8, \"tile\": 416}, \"puff0\": {\"pal\": 6, \"size\": 8, \"tile\": 433}, \"puff1\": {\"pal\": 6, \"size\": 8, \"tile\": 448}, \"rshadow\": {\"pal\": 7, \"size\": 16, \"tile\": 430}, \"shadow0\": {\"pal\": 7, \"size\": 16, \"tile\": 420}, \"shadow1\": {\"pal\": 7, \"size\": 16, \"tile\": 422}, \"shadow2\": {\"pal\": 7, \"size\": 16, \"tile\": 424}, \"shadow3\": {\"pal\": 7, \"size\": 16, \"tile\": 426}, \"shadow4\": {\"pal\": 7, \"size\": 16, \"tile\": 428}},\nscenes: {\"floor0\": {\"h\": 8, \"mx\": 128, \"my\": 0, \"pal\": 5, \"w\": 8}, \"floor1\": {\"h\": 8, \"mx\": 136, \"my\": 0, \"pal\": 6, \"w\": 8}, \"logo\": {\"h\": 6, \"mx\": 144, \"my\": 0, \"pal\": 5, \"w\": 21}},\ncolors: {\"GLASS\": 110},\n};\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, bump: 3, fall: 4, land: 5, out: 6, tick: 7, go: 8, point: 9, win: 10, jump: 11, crash: 12 };\nconst SONG = { title: 0, race: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 3;\nconst UNLOCK_SLOT = 1, WINS_SLOT = 2, CHOICE_SLOT = 3, SEAT_SLOT = 10;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nconst masks = [0, 0, 0, 0], prevMasks = [0, 0, 0, 0];\nfunction readPads() {\nfor (let p = 0; p < 4; p++) { let m = 0; for (const b of BUTTONS) if (btn(b, p)) m |= 1 << b; prevMasks[p] = masks[p]; masks[p] = m; }\n}\nconst held = (b, p = 0) => (masks[p] & (1 << b)) !== 0;\nconst pressed = (b, p = 0) => held(b, p) && (prevMasks[p] & (1 << b)) === 0;\nconst TOP = 2.0, ACC = 0.045, BRAKE = 0.09, REV = 0.7, ROLL = 0.985, TURN = 0.065, STEER_RAMP = 6, R_CAR = 5;\nconst SLIDE_KEEP = 0.55;\nconst BOUNCE = 0.5, SCRAPE = 0.8;\nconst FALL_T = 30;\nconst S_OFF = 0, S_ROAD = 1, S_ROUGH = 2, S_SLICK = 3, S_STICKY = 4, S_RAMP = 5, S_HOLE = 6, S_WALL = 7, S_PROP = 8;\nconst SURF = [\n{ name: 'OFF', keep: 0.30, top: 1.3, tile: 'off' },\n{ name: 'ROAD', keep: 0.20, top: TOP, tile: 'road' },\n{ name: 'ROUGH', keep: 0.30, top: 1.1, tile: 'rough' },\n{ name: 'SLICK', keep: 0.85, top: TOP, tile: 'slick' },\n{ name: 'STICKY', keep: 0.20, top: 0.8, tile: 'sticky' },\n{ name: 'RAMP', keep: 0.20, top: TOP, tile: 'ramp' },\n{ name: 'HOLE', keep: 0.30, top: TOP, tile: null },\n{ name: 'WALL', keep: 0.30, top: TOP, tile: 'wall' },\n{ name: 'WALL', keep: 0.30, top: TOP, tile: 'wall' },\n];\nconst TRACKS = [\n{ name: 'PLACEMAT LOOP', cup: 0, w: 112, h: 84, width: 56, tables: [[16, 16, 864, 640]],\npts: [200, 140, 700, 140, 800, 220, 800, 460, 700, 540, 200, 540, 100, 460, 100, 220],\nprims: [[S_WALL, 'c', 450, 340, 90], [S_WALL, 'r', 250, 96, 180, 6], [S_WALL, 'r', 500, 578, 180, 6], [S_WALL, 'r', 300, 176, 200, 6],\n[S_ROUGH, 'c', 150, 190, 20], [S_ROUGH, 'c', 750, 190, 20], [S_ROUGH, 'c', 750, 490, 20], [S_ROUGH, 'c', 150, 490, 20]], movers: [] },\n{ name: 'CEREAL SPILL', cup: 0, w: 120, h: 90, width: 52, tables: [[16, 16, 944, 688]],\npts: [480, 360, 600, 250, 760, 220, 860, 320, 840, 460, 720, 510, 590, 460, 480, 360, 360, 250, 200, 220, 100, 320, 120, 460, 240, 510, 370, 460],\nprims: [[S_PROP, 'r', 690, 320, 80, 90], [S_ROUGH, 'c', 850, 400, 22], [S_ROUGH, 'c', 780, 230, 16], [S_SLICK, 'c', 480, 360, 34]],\nmovers: [['roll', 240, 470, 240, 560, 0.7, 0]] },\n{ name: 'TOAST RACK RUN', cup: 0, w: 125, h: 90, width: 44, tables: [[16, 16, 968, 688]],\npts: [140, 330, 300, 330, 560, 330, 680, 320, 740, 240, 840, 170, 920, 260, 900, 440, 820, 580, 620, 600, 480, 540, 340, 600, 180, 600, 90, 480],\nprims: [[S_WALL, 'r', 300, 298, 260, 6], [S_WALL, 'r', 300, 356, 260, 6], [S_SLICK, 'c', 880, 205, 28],\n[S_PROP, 'c', 480, 466, 24], [S_STICKY, 'c', 505, 530, 16]],\nmovers: [['roll', 720, 540, 720, 660, 0.8, 1]] },\n{ name: 'TABLE EDGE', cup: 0, w: 125, h: 90, width: 44, tables: [[16, 16, 520, 688], [560, 16, 424, 688]],\npts: [120, 70, 400, 70, 700, 70, 900, 90, 950, 300, 900, 560, 700, 650, 400, 650, 120, 620, 70, 350],\nprims: [[S_RAMP, 'r', 520, 46, 16, 48], [S_RAMP, 'r', 560, 626, 16, 48], [S_ROUGH, 'c', 300, 640, 18], [S_ROUGH, 'c', 820, 80, 16]], movers: [] },\n{ name: 'TOOLBOX CIRCUIT', cup: 1, w: 120, h: 84, width: 44, tables: [[16, 16, 928, 640]],\npts: [180, 140, 500, 120, 780, 150, 860, 320, 780, 520, 480, 560, 200, 520, 110, 330],\nprims: [[S_PROP, 'r', 330, 250, 300, 170], [S_WALL, 'r', 250, 80, 120, 8], [S_WALL, 'r', 600, 592, 140, 8],\n[S_ROUGH, 'c', 830, 230, 22], [S_ROUGH, 'c', 150, 440, 20]],\nmovers: [['roll', 800, 400, 920, 400, 1.0, 2]] },\n{ name: 'SAWDUST ALLEY', cup: 1, w: 125, h: 90, width: 40, tables: [[16, 16, 968, 688]],\npts: [140, 100, 860, 100, 930, 200, 860, 300, 300, 300, 220, 390, 300, 480, 860, 480, 930, 560, 860, 640, 140, 640, 70, 370],\nprims: [[S_WALL, 'r', 270, 350, 60, 80], [S_WALL, 'r', 320, 190, 500, 16], [S_WALL, 'r', 360, 382, 480, 16], [S_WALL, 'r', 320, 553, 500, 14],\n[S_ROUGH, 'c', 500, 100, 24], [S_ROUGH, 'c', 600, 640, 24], [S_STICKY, 'c', 700, 300, 18],\n[S_WALL, 'r', 420, 496, 6, 6], [S_WALL, 'r', 640, 458, 6, 6]], movers: [] },\n{ name: 'OIL CHANGE', cup: 1, w: 125, h: 90, width: 40, tables: [[16, 16, 968, 688]],\npts: [110, 150, 380, 100, 560, 170, 540, 300, 660, 380, 860, 300, 910, 160, 950, 470, 820, 620, 560, 560, 400, 640, 160, 600, 90, 380],\nprims: [[S_PROP, 'c', 760, 480, 26], [S_SLICK, 'c', 800, 590, 40], [S_SLICK, 'c', 600, 575, 20], [S_WALL, 'c', 440, 250, 14]],\nmovers: [['fan', 440, 250], ['roll', 300, 60, 300, 160, 1.0, 2], ['roll', 480, 550, 480, 660, 0.9, 2]] },\n{ name: 'WORKBENCH EDGE', cup: 1, w: 125, h: 90, width: 40, tables: [[16, 16, 720, 688], [760, 210, 220, 280]],\npts: [130, 60, 500, 60, 620, 130, 640, 250, 820, 260, 920, 320, 910, 420, 800, 450, 600, 450, 480, 560, 300, 650, 120, 640, 60, 360],\nprims: [[S_RAMP, 'r', 720, 230, 16, 56], [S_ROAD, 'r', 736, 440, 24, 20], [S_HOLE, 'r', 176, 610, 68, 94], [S_ROAD, 'r', 176, 654, 68, 22],\n[S_SLICK, 'c', 625, 135, 24]],\nmovers: [['roll', 300, 30, 300, 100, 1.1, 2]] },\n{ name: 'TEST TABLE', cup: -1, w: 128, h: 96, width: 48, tables: [[16, 16, 992, 736]],\npts: [200, 130, 820, 130, 900, 190, 900, 330, 820, 400, 620, 400, 560, 460, 620, 540, 860, 560, 900, 620, 840, 680, 200, 680, 130, 620, 130, 200],\nprims: [[S_ROUGH, 'c', 500, 130, 22], [S_SLICK, 'c', 900, 260, 30], [S_STICKY, 'r', 300, 655, 60, 50],\n[S_WALL, 'r', 400, 250, 120, 80], [S_HOLE, 'c', 700, 290, 36],\n[S_HOLE, 'r', 584, 650, 24, 60], [S_RAMP, 'r', 608, 656, 16, 48]], movers: [] },\n];\nconst TEST_TRACK = TRACKS.length - 1;\nconst ROLLERS = [{ name: 'pea', r: 4, spr: 'pea', sh: 'bshadow' }, { name: 'orange', r: 7, spr: 'orange', sh: 'rshadow' }, { name: 'bearing', r: 4, spr: 'bearing', sh: 'bshadow' }];\nconst FAN_R = 100, FAN_PUSH = 0.04;\nconst SPACING = 16;\nlet track = null;\nlet grid = null;\nfunction centreline(pts) {\nconst n = pts.length / 2, P = (i) => [pts[((i + n) % n) * 2], pts[((i + n) % n) * 2 + 1]], dense = [];\nfor (let i = 0; i < n; i++) {\nconst [p0, p1, p2, p3] = [P(i - 1), P(i), P(i + 1), P(i + 2)];\nfor (let k = 0; k < 16; k++) {\nconst t = k / 16, t2 = t * t, t3 = t2 * t;\nconst f = (a, b, c, d) => 0.5 * (2 * b + (c - a) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (3 * b - a - 3 * c + d) * t3);\ndense.push([f(p0[0], p1[0], p2[0], p3[0]), f(p0[1], p1[1], p2[1], p3[1])]);\n}\n}\nconst lens = dense.map(([ax, ay], i) => Math.hypot(dense[(i + 1) % dense.length][0] - ax, dense[(i + 1) % dense.length][1] - ay));\nconst total = lens.reduce((s, l) => s + l, 0), n2 = Math.round(total / SPACING), step = total / n2;\nconst wx = [], wy = [];\nlet carry = 0;\nfor (let i = 0; i < dense.length && wx.length < n2; i++) {\nconst [ax, ay] = dense[i], [bx, by] = dense[(i + 1) % dense.length], len = lens[i];\nwhile (carry <= len && wx.length < n2) { const t = carry / len; wx.push(ax + (bx - ax) * t); wy.push(ay + (by - ay) * t); carry += step; }\ncarry -= len;\n}\nreturn { wx, wy, n: wx.length };\n}\nfunction buildTrack(i) {\nconst T = TRACKS[i], W = T.w, H = T.h, c = centreline(T.pts);\ntrack = { ...T, i, ...c };\ngrid = new Uint8Array(W * H).fill(S_HOLE);\nconst paint = (s, x0, y0, x1, y1, inside) => {\nfor (let cy = Math.max(0, flr(y0 / 8)); cy <= Math.min(H - 1, flr(y1 / 8)); cy++)\nfor (let cx = Math.max(0, flr(x0 / 8)); cx <= Math.min(W - 1, flr(x1 / 8)); cx++)\nif (inside(cx * 8 + 4, cy * 8 + 4)) grid[cy * W + cx] = s;\n};\nfor (const [tx, ty, tw, th] of T.tables) paint(S_OFF, tx, ty, tx + tw - 1, ty + th - 1, () => true);\nconst r = T.width / 2;\nfor (let k = 0; k < c.n; k++) {\nconst ax = c.wx[k], ay = c.wy[k], bx = c.wx[(k + 1) % c.n], by = c.wy[(k + 1) % c.n];\npaint(S_ROAD, Math.min(ax, bx) - r, Math.min(ay, by) - r, Math.max(ax, bx) + r, Math.max(ay, by) + r, (x, y) => segDist(x, y, ax, ay, bx, by) < r);\n}\nfor (const [s, shape, x, y, a, b] of T.prims) {\nif (shape === 'r') paint(s, x, y, x + a - 1, y + b - 1, () => true);\nelse paint(s, x - a, y - a, x + a, y + a, (px, py) => (px - x) ** 2 + (py - y) ** 2 < a * a);\n}\nconst P = T.cup === 1 ? 2 : 1, at = (x, y) => (x >= 0 && y >= 0 && x < W && y < H ? grid[y * W + x] : S_HOLE);\nconst sides = (x, y, f) => (f(at(x, y - 1)) ? 1 : 0) | (f(at(x + 1, y)) ? 2 : 0) | (f(at(x, y + 1)) ? 4 : 0) | (f(at(x - 1, y)) ? 8 : 0);\nconst onRoad = (q) => q >= S_ROAD && q <= S_RAMP;\nfor (let cy = 0; cy < 128; cy++) for (let cx = 0; cx < 128; cx++) {\nconst q = at(cx, cy);\nlet t = 0, pal = P;\nif (q === S_HOLE) t = at(cx, cy - 1) !== S_HOLE ? 'lip' : 0;\nelse if (isWall(q)) { t = 'wall' + sides(cx, cy, (n) => !isWall(n)); if (q === S_PROP) pal = 7; }\nelse {\nif (isWall(at(cx - 1, cy)) || isWall(at(cx, cy - 1)) || isWall(at(cx - 1, cy - 1))) pal = P + 2;\nconst v = (cx * 7 + cy * 3) & 1;\nt = q === S_OFF ? 'cloth' + ((cx & 1) | ((cy & 1) << 1)) : q === S_ROAD ? 'road' + sides(cx, cy, (n) => !onRoad(n))\n: q === S_RAMP ? 'ramp' : SURF[q].tile + v;\nif (t === 'road0' && (cx * 13 + cy * 7) % 9 < 2) t = 'roadv' + ((cx + cy) & 1);\n}\nmset(cx, cy, t ? tile(ART.tiles[t], pal) : 0);\n}\nconst k1 = 1 % c.n, ux = c.wx[k1] - c.wx[0], uy = c.wy[k1] - c.wy[0], ul = Math.hypot(ux, uy);\nfor (let d = -T.width / 2; d <= T.width / 2; d += 4) {\nconst x = flr((c.wx[0] - (uy / ul) * d) / 8), y = flr((c.wy[0] + (ux / ul) * d) / 8);\nif (at(x, y) === S_ROAD) mset(x, y, tile(ART.tiles.start, P));\n}\nconst fl = ART.scenes['floor' + (P - 1)];\nbg(2, { mx: fl.mx, my: fl.my, mw: fl.w, mh: fl.h, wrap: true });\nracingLine();\ntrack.rollers = T.movers.filter((m) => m[0] === 'roll').map(([, x0, y0, x1, y1, sp, kind]) => ({ x: x0, y: y0, x0, y0, x1, y1, sp, kind, r: ROLLERS[kind].r, t: 0, dir: 1 }));\ntrack.fans = T.movers.filter((m) => m[0] === 'fan').map(([, x, y]) => ({ x, y }));\n}\nfunction moveRollers() {\nfor (const o of track.rollers) {\nconst L = Math.hypot(o.x1 - o.x0, o.y1 - o.y0);\no.t += (o.sp / L) * o.dir;\nif (o.t >= 1 || o.t <= 0) { o.t = clamp(o.t, 0, 1); o.dir = -o.dir; }\no.x = o.x0 + (o.x1 - o.x0) * o.t; o.y = o.y0 + (o.y1 - o.y0) * o.t;\n}\n}\nfunction racingLine() {\nconst t = track, n = t.n, W = (k) => (k % n + n) % n, dir = (k) => Math.atan2(t.wy[W(k + 1)] - t.wy[W(k)], t.wx[W(k + 1)] - t.wx[W(k)]);\nconst turn = (k) => Math.atan2(Math.sin(dir(k) - dir(k - 1)), Math.cos(dir(k) - dir(k - 1)));\nt.bend = []; t.rad = []; t.lx = []; t.ly = [];\nconst off = [];\nfor (let k = 0; k < n; k++) {\nlet b = 0; for (let d = -4; d < 4; d++) b += turn(k + d);\nt.bend.push(b); t.rad.push(Math.abs(b) > 0.01 ? (8 * SPACING) / Math.abs(b) : 9999);\noff.push(sgn(b) * Math.min(t.width / 2 - 10, Math.abs(b) * 24));\n}\nfor (let k = 0; k < n; k++) {\nlet o = 0; for (let d = -3; d <= 3; d++) o += off[W(k + d)];\no /= 7;\nconst a = dir(k), ox = -Math.sin(a) * o, oy = Math.cos(a) * o;\nt.lx.push(t.wx[k] + ox); t.ly.push(t.wy[k] + oy);\n}\n}\nfunction segDist(x, y, ax, ay, bx, by) {\nconst dx = bx - ax, dy = by - ay, L = dx * dx + dy * dy, t = L ? clamp(((x - ax) * dx + (y - ay) * dy) / L, 0, 1) : 0;\nreturn Math.hypot(x - ax - dx * t, y - ay - dy * t);\n}\nfunction surfAt(x, y) {\nconst cx = flr(x / 8), cy = flr(y / 8);\nreturn cx < 0 || cy < 0 || cx >= track.w || cy >= track.h ? S_HOLE : grid[cy * track.w + cx];\n}\nfunction hitsWall(x, y) {\nconst r = R_CAR - 1;\nfor (const [px, py] of [[x - r, y - r], [x + r, y - r], [x - r, y + r], [x + r, y + r]]) if (isWall(surfAt(px, py))) return true;\nreturn false;\n}\nconst isWall = (s) => s === S_WALL || s === S_PROP;\nconst WIN_POINTS = 5, ROUND_MAX = 1800, READY_T = 60, GO_T = 30, BOARD_T = 120, OUT_MARGIN = 4;\nconst JUMP_MIN = 1.5, LIFT = 6, CAR_DAMP = 0.8;\nconst LEVELS = [\n{ name: 'EASY', throttle: 0.86, corner: 0.80, err: 8, react: 18 },\n{ name: 'NORMAL', throttle: 0.94, corner: 0.90, err: 5, react: 10 },\n{ name: 'HARD', throttle: 1.00, corner: 1.00, err: 2, react: 4 },\n];\nconst CHARS = [\n{ name: 'ZIP', throttle: 1, corner: 1.12, err: 1, slick: 1.6, avoid: true, lean: 0 },\n{ name: 'DOT', throttle: 0.98, corner: 0.9, err: 1, slick: 1.0, avoid: true, lean: 0 },\n{ name: 'MAX', throttle: 1, corner: 1, err: 1, slick: 1.3, avoid: false, lean: 6 },\n{ name: 'BEA', throttle: 1, corner: 1, err: 0.5, slick: 1.3, avoid: true, lean: 0 },\n];\nlet level = 1;\nconst COLOURS = [['RED', 'd04040'], ['BLUE', '4070d8'], ['YELLOW', 'e8c030'], ['GREEN', '40a848'], ['ORANGE', 'e87a20'],\n['PURPLE', '9050c8'], ['WHITE', 'e8e8f0'], ['BLACK', '484858']];\nconst CAR_BODY = 2;\nconst LETTERS = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nconst carCol = (k) => 128 + 16 * k + CAR_BODY + 1;\nlet seats = [];\nconst encodeSeat = (s) => (s.name.split('').reduce((v, ch) => v * 64 + Math.max(0, LETTERS.indexOf(ch)), 0)) | (s.col << 18) | (1 << 21);\nconst decodeSeat = (v) => ({ name: [12, 6, 0].map((b) => LETTERS[(v >> b) & 63]).join(''), col: (v >> 18) & 7 });\nfunction newSeats() {\nseats = [0, 1, 2, 3].map((i) => {\nconst v = dget(SEAT_SLOT + i), s = v & (1 << 21) ? decodeSeat(v) : { name: `P${i + 1} `, col: i };\nreturn { human: i === 0, name: s.name, col: s.col, mine: s.name, ch: -1, lob: i ? 'cpu' : 'colour', pos: 0 };\n});\nseats.forEach((_, k) => tint(k));\n}\nfunction tint(k) {\nconst v = parseInt(COLOURS[seats[k].col][1], 16);\n[0.55, 1, 1.35].forEach((m, j) => color(128 + 16 * k + CAR_BODY + j, ...[v >> 16, (v >> 8) & 255, v & 255].map((c) => clamp(flr((c * m) / 8), 0, 31))));\n}\nconst takenBy = (col, k) => seats.some((s, j) => j !== k && s.human && s.col === col);\nfunction castDrivers() {\nconst order = [0, 1, 2, 3];\nfor (let i = 3; i > 0; i--) { const j = rndi(0, i); [order[i], order[j]] = [order[j], order[i]]; }\nlet k = 0;\nfor (const s of seats) if (!s.human) { s.ch = order[k++]; s.name = CHARS[s.ch].name; } else { s.ch = -1; s.name = s.mine; }\nfreeColours();\n}\nfunction freeColours() {\nconst used = seats.filter((s) => s.human).map((s) => s.col);\nseats.forEach((s, k) => { if (!s.human) { s.col = [0, 1, 2, 3, 4, 5, 6, 7].find((c) => !used.includes(c)); used.push(s.col); } tint(k); });\n}\nfunction newCar(seat, k) {\nconst c = { seat, x: 0, y: 0, a: 0, vx: 0, vy: 0, st: 0, fall: 0, air: 0, airT: 0, wp: k, lap: 0, sliding: false, surf: S_ROAD, out: false, points: 0 };\nplaceAt(c, k, 0, 0);\nreturn c;\n}\nfunction placeAt(c, k, back, side) {\nconst n = track.n, k1 = (k + 1) % n, dx = track.wx[k1] - track.wx[k], dy = track.wy[k1] - track.wy[k], L = Math.hypot(dx, dy) || 1;\nconst ux = dx / L, uy = dy / L;\nc.x = track.wx[k] - ux * back - uy * side; c.y = track.wy[k] - uy * back + ux * side;\nc.a = Math.atan2(uy, ux); c.vx = c.vy = 0; c.st = 0; c.fall = 0; c.air = 0; c.wp = k; c.surf = surfAt(c.x, c.y);\n}\nfunction drive(c, steer, gas, brake) {\nif (c.fall) { if (--c.fall === 0) knockOut(c); return; }\nif (c.air) { c.air--; moveCar(c); if (!c.air) land(c); follow(c); return; }\nc.st = steer ? clamp(c.st + steer / STEER_RAMP, -1, 1) : c.st - sgn(c.st) * Math.min(Math.abs(c.st), 1 / STEER_RAMP);\nconst S = SURF[c.surf];\nlet ca = Math.cos(c.a), sa = Math.sin(c.a), f = c.vx * ca + c.vy * sa;\nc.a += TURN * c.st * clamp(f, -1, 1);\nca = Math.cos(c.a); sa = Math.sin(c.a);\nf = c.vx * ca + c.vy * sa;\nlet side = -c.vx * sa + c.vy * ca;\nif (gas) f = Math.min(f + ACC, Math.max(f, S.top));\nelse if (brake) f = f > 0.05 ? Math.max(0, f - BRAKE) : Math.max(f - ACC * 0.6, -REV);\nelse f *= ROLL;\nif (f > S.top) f -= (f - S.top) * 0.1;\nc.sliding = !gas && Math.abs(c.st) > 0.3 && f > 1;\nside *= Math.max(S.keep, c.sliding ? SLIDE_KEEP : 0);\nc.vx = f * ca - side * sa; c.vy = f * sa + side * ca;\nfor (const o of track.fans) {\nconst dx = c.x - o.x, dy = c.y - o.y, d = Math.hypot(dx, dy);\nif (d < FAN_R && d > 0) { const k = FAN_PUSH * (2 - d / FAN_R); c.vx += (dx / d) * k; c.vy += (dy / d) * k; }\n}\nmoveCar(c);\nc.surf = surfAt(c.x, c.y);\nif (c.surf === S_ROUGH && f > 0.8 && (clock + c.seat * 3) % 8 === 0) puff(c.x - ca * 6, c.y - sa * 6);\nif (c.surf === S_RAMP && f >= JUMP_MIN) { c.air = c.airT = flr(16 + 10 * f); fx(SFX.jump); }\nelse if (c.surf === S_HOLE) startFall(c);\nfollow(c);\n}\nfunction moveCar(c) {\nif (hitsWall(c.x + c.vx, c.y)) { c.vx *= -BOUNCE; c.vy *= SCRAPE; bump(); } else c.x += c.vx;\nif (hitsWall(c.x, c.y + c.vy)) { c.vy *= -BOUNCE; c.vx *= SCRAPE; bump(); } else c.y += c.vy;\n}\nfunction land(c) { c.surf = surfAt(c.x, c.y); if (c.surf === S_HOLE) startFall(c); else { fx(SFX.land); puff(c.x - 4, c.y + 2); puff(c.x + 4, c.y + 2); } }\nconst PUFF_MAX = 12, PUFF_T = 16;\nlet puffs = [];\nfunction puff(x, y) { if (puffs.length >= PUFF_MAX) puffs.shift(); puffs.push({ x, y, t: 0 }); }\nfunction agePuffs() { for (const o of puffs) { o.t++; o.y -= 0.15; } puffs = puffs.filter((o) => o.t < PUFF_T); }\nfunction startFall(c) { c.fall = FALL_T; c.vx = c.vy = 0; fx(SFX.fall); }\nlet lastBump = -99;\nfunction bump(crash) { if (clock - lastBump > 8) { fx(crash ? SFX.crash : SFX.bump); lastBump = clock; } }\nfunction collide() {\nconst live = cars.filter((c) => !c.out && !c.fall && !c.air);\nfor (const c of live) hitRollers(c);\nfor (let i = 0; i < live.length; i++) for (let j = i + 1; j < live.length; j++) {\nconst a = live[i], b = live[j], dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy);\nif (d >= 2 * R_CAR) continue;\nconst nx = d ? dx / d : 1, ny = d ? dy / d : 0, o = (2 * R_CAR - d) / 2;\nshove(a, -nx * o, -ny * o); shove(b, nx * o, ny * o);\nconst an = a.vx * nx + a.vy * ny, bn = b.vx * nx + b.vy * ny;\nif (an - bn > 0) {\na.vx += (bn * CAR_DAMP - an) * nx; a.vy += (bn * CAR_DAM
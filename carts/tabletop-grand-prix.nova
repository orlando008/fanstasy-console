{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Tabletop Grand Prix",
    "author": "NOVA-16",
    "description": "Toy cars race across the breakfast table and the garage workbench, for 1 to 4 players. The camera follows the leader: drop off the screen and you are out of the round, the last car left scores a point, and the first to five wins the race. Two cups of four tracks, with milk spills, crumbs, oil and jumps between tables."
  },
  "label": null,
  "code": "// Tabletop Grand Prix: toy cars racing across the furniture, seen from above (docs/carts/tabletop-grand-prix.md).\n// Step 1 of the plan: one car on a test table. The physics (spec 5.1, 5.2), the track's grid of surfaces built into\n// Map RAM from its data (spec 6), falls and walls, and the camera (5.5). The frame (title, pause) is the starter's.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {\"off\": 1, \"ramp\": 6, \"road\": 2, \"rough\": 3, \"slick\": 4, \"sticky\": 5, \"wall\": 7},\n  sprites: {\"car0\": {\"pal\": 0, \"size\": 16, \"tile\": 256}, \"car1\": {\"pal\": 0, \"size\": 16, \"tile\": 258}, \"car2\": {\"pal\": 0, \"size\": 16, \"tile\": 260}, \"car3\": {\"pal\": 0, \"size\": 16, \"tile\": 262}, \"car4\": {\"pal\": 0, \"size\": 16, \"tile\": 264}},\n  scenes: {\"floor\": {\"h\": 8, \"mx\": 128, \"my\": 0, \"pal\": 2, \"w\": 8}},\n  colors: {\"GLASS\": 200},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Songs use channels 0 to 5; effects take turns on 6 and 7, so they never cut into the music. ---\n\nconst SFX = { move: 0, select: 1, pause: 2, bump: 3, fall: 4, land: 5 };\nconst SONG = { title: 0, race: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (spec 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 2;\n\n// --- Input: each pad's buttons this frame and last, for presses that do not repeat (btnp does) ---\n\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nconst masks = [0, 0, 0, 0], prevMasks = [0, 0, 0, 0];\nfunction readPads() {\n  for (let p = 0; p < 4; p++) { let m = 0; for (const b of BUTTONS) if (btn(b, p)) m |= 1 << b; prevMasks[p] = masks[p]; masks[p] = m; }\n}\nconst held = (b, p = 0) => (masks[p] & (1 << b)) !== 0;\nconst pressed = (b, p = 0) => held(b, p) && (prevMasks[p] & (1 << b)) === 0;\n\n// --- Driving (spec 5.1 and 5.2): speeds in px a frame ---\n\nconst TOP = 2.0, ACC = 0.045, BRAKE = 0.09, REV = 0.7, ROLL = 0.985, TURN = 0.065, STEER_RAMP = 6, R_CAR = 5;\nconst SLIDE_KEEP = 0.55;      // the sideways speed kept while turning with A let go (the slide)\nconst BOUNCE = 0.5, SCRAPE = 0.8;  // into a wall: the speed into it comes back halved; along it, a fifth is lost\nconst FALL_T = 30;            // frames a falling car takes to drop out of sight\n\n// The surfaces of the track's grid (one 8 px cell each): sideways speed kept, top speed, and the tile drawn.\nconst S_OFF = 0, S_ROAD = 1, S_ROUGH = 2, S_SLICK = 3, S_STICKY = 4, S_RAMP = 5, S_HOLE = 6, S_WALL = 7;\nconst SURF = [\n  { name: 'OFF', keep: 0.30, top: 1.3, tile: 'off' },\n  { name: 'ROAD', keep: 0.20, top: TOP, tile: 'road' },\n  { name: 'ROUGH', keep: 0.30, top: 1.1, tile: 'rough' },\n  { name: 'SLICK', keep: 0.85, top: TOP, tile: 'slick' },\n  { name: 'STICKY', keep: 0.20, top: 0.8, tile: 'sticky' },\n  { name: 'RAMP', keep: 0.20, top: TOP, tile: 'ramp' },\n  { name: 'HOLE', keep: 0.30, top: TOP, tile: null },\n  { name: 'WALL', keep: 0.30, top: TOP, tile: 'wall' },\n];\n\n// --- Tracks (spec 6). pts: the centreline's control points in px (a closed loop, smoothed); width: the road in px;\n// table: [x, y, w, h] in px (outside it is the floor); prims: [surface, 'r', x, y, w, h] or [surface, 'c', x, y, r]\n// painted over the road in order. The map is w x h cells of 8 px (at most 128 x 96). ---\n\nconst TRACKS = [\n  { name: 'TEST TABLE', w: 128, h: 96, width: 48, table: [16, 16, 992, 736],\n    pts: [200, 130, 820, 130, 900, 190, 900, 330, 820, 400, 620, 400, 560, 460, 620, 540, 860, 560, 900, 620, 840, 680, 200, 680, 130, 620, 130, 200],\n    prims: [[S_ROUGH, 'c', 500, 130, 22], [S_SLICK, 'c', 900, 260, 30], [S_STICKY, 'r', 300, 655, 60, 50],\n      [S_WALL, 'r', 400, 250, 120, 80], [S_HOLE, 'c', 700, 290, 36]] },\n];\nconst SPACING = 16;           // px between the centreline's waypoints after smoothing\n\nlet track = null;             // the track being raced: its data, waypoints (wx, wy) and their count n\nlet grid = null;              // Uint8Array of the surface of each cell\n\n/** A closed Catmull-Rom curve through the control points, resampled to a waypoint every SPACING px. */\nfunction centreline(pts) {\n  const n = pts.length / 2, P = (i) => [pts[((i + n) % n) * 2], pts[((i + n) % n) * 2 + 1]], dense = [];\n  for (let i = 0; i < n; i++) {\n    const [p0, p1, p2, p3] = [P(i - 1), P(i), P(i + 1), P(i + 2)];\n    for (let k = 0; k < 16; k++) {\n      const t = k / 16, t2 = t * t, t3 = t2 * t;\n      const f = (a, b, c, d) => 0.5 * (2 * b + (c - a) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (3 * b - a - 3 * c + d) * t3);\n      dense.push([f(p0[0], p1[0], p2[0], p3[0]), f(p0[1], p1[1], p2[1], p3[1])]);\n    }\n  }\n  const lens = dense.map(([ax, ay], i) => Math.hypot(dense[(i + 1) % dense.length][0] - ax, dense[(i + 1) % dense.length][1] - ay));\n  const total = lens.reduce((s, l) => s + l, 0), n2 = Math.round(total / SPACING), step = total / n2; // evenly spaced, the loop closing too\n  const wx = [], wy = [];\n  let carry = 0;\n  for (let i = 0; i < dense.length && wx.length < n2; i++) {\n    const [ax, ay] = dense[i], [bx, by] = dense[(i + 1) % dense.length], len = lens[i];\n    while (carry <= len && wx.length < n2) { const t = carry / len; wx.push(ax + (bx - ax) * t); wy.push(ay + (by - ay) * t); carry += step; }\n    carry -= len;\n  }\n  return { wx, wy, n: wx.length };\n}\n\n/** Build a track: its waypoints, its grid of surfaces (spec 6), and its tiles in Map RAM (BG1, from cell 0, 0). */\nfunction buildTrack(i) {\n  const T = TRACKS[i], W = T.w, H = T.h, c = centreline(T.pts);\n  track = { ...T, i, ...c };\n  grid = new Uint8Array(W * H).fill(S_HOLE);\n  const paint = (s, x0, y0, x1, y1, inside) => {\n    for (let cy = Math.max(0, flr(y0 / 8)); cy <= Math.min(H - 1, flr(y1 / 8)); cy++)\n      for (let cx = Math.max(0, flr(x0 / 8)); cx <= Math.min(W - 1, flr(x1 / 8)); cx++)\n        if (inside(cx * 8 + 4, cy * 8 + 4)) grid[cy * W + cx] = s;\n  };\n  const [tx, ty, tw, th] = T.table;\n  paint(S_OFF, tx, ty, tx + tw - 1, ty + th - 1, () => true);\n  const r = T.width / 2;\n  for (let k = 0; k < c.n; k++) {     // the road: every cell within r of a segment of the centreline\n    const ax = c.wx[k], ay = c.wy[k], bx = c.wx[(k + 1) % c.n], by = c.wy[(k + 1) % c.n];\n    paint(S_ROAD, Math.min(ax, bx) - r, Math.min(ay, by) - r, Math.max(ax, bx) + r, Math.max(ay, by) + r, (x, y) => segDist(x, y, ax, ay, bx, by) < r);\n  }\n  for (const [s, shape, x, y, a, b] of T.prims) {\n    if (shape === 'r') paint(s, x, y, x + a - 1, y + b - 1, () => true);\n    else paint(s, x - a, y - a, x + a, y + a, (px, py) => (px - x) ** 2 + (py - y) ** 2 < a * a);\n  }\n  for (let cy = 0; cy < 128; cy++) for (let cx = 0; cx < 128; cx++) {\n    const s = cx < W && cy < H ? grid[cy * W + cx] : S_HOLE, t = SURF[s].tile;\n    mset(cx, cy, t ? tile(ART.tiles[t], 1) : 0);\n  }\n}\n\n/** Distance from (x, y) to the segment from (ax, ay) to (bx, by). */\nfunction segDist(x, y, ax, ay, bx, by) {\n  const dx = bx - ax, dy = by - ay, L = dx * dx + dy * dy, t = L ? clamp(((x - ax) * dx + (y - ay) * dy) / L, 0, 1) : 0;\n  return Math.hypot(x - ax - dx * t, y - ay - dy * t);\n}\n\n/** The surface under a point (outside the map is the floor). */\nfunction surfAt(x, y) {\n  const cx = flr(x / 8), cy = flr(y / 8);\n  return cx < 0 || cy < 0 || cx >= track.w || cy >= track.h ? S_HOLE : grid[cy * track.w + cx];\n}\n\n/** Does a car's body at (x, y) overlap a wall cell? (Its box of R_CAR - 1 against the cells under it.) */\nfunction hitsWall(x, y) {\n  const r = R_CAR - 1;\n  for (const [px, py] of [[x - r, y - r], [x + r, y - r], [x - r, y + r], [x + r, y + r]]) if (surfAt(px, py) === S_WALL) return true;\n  return false;\n}\n\n// --- Cars ---\n\n/** A car on waypoint k of the track, facing along it. */\nfunction newCar(seat, k) {\n  const c = { seat, x: 0, y: 0, a: 0, vx: 0, vy: 0, st: 0, fall: 0, wp: k, lap: 0, sliding: false, surf: S_ROAD };\n  placeAt(c, k, 0, 0);\n  return c;\n}\n\n/** Put a car on waypoint k, `back` px behind it and `side` px to its left or right, facing along the track, stopped. */\nfunction placeAt(c, k, back, side) {\n  const n = track.n, k1 = (k + 1) % n, dx = track.wx[k1] - track.wx[k], dy = track.wy[k1] - track.wy[k], L = Math.hypot(dx, dy) || 1;\n  const ux = dx / L, uy = dy / L;\n  c.x = track.wx[k] - ux * back - uy * side; c.y = track.wy[k] - uy * back + ux * side;\n  c.a = Math.atan2(uy, ux); c.vx = c.vy = 0; c.st = 0; c.fall = 0; c.wp = k;\n}\n\n/** One frame of a car, from its controls: steer -1, 0 or 1; gas and brake true or false (spec 5.1 to 5.3). */\nfunction drive(c, steer, gas, brake) {\n  if (c.fall) { if (--c.fall === 0) respawn(c); return; }\n  // The steering builds over STEER_RAMP frames to its full value (the pad is digital).\n  c.st = steer ? clamp(c.st + steer / STEER_RAMP, -1, 1) : c.st - sgn(c.st) * Math.min(Math.abs(c.st), 1 / STEER_RAMP);\n  const S = SURF[c.surf];\n  let ca = Math.cos(c.a), sa = Math.sin(c.a), f = c.vx * ca + c.vy * sa;\n  // The turn: full rate from a speed of 1 up, less below it (a car at a standstill cannot spin); backwards it turns the other way.\n  c.a += TURN * c.st * clamp(f, -1, 1);\n  ca = Math.cos(c.a); sa = Math.sin(c.a);\n  f = c.vx * ca + c.vy * sa;\n  let side = -c.vx * sa + c.vy * ca;   // the velocity split along the new heading and across it: the grip works on `side`\n  if (gas) f = Math.min(f + ACC, Math.max(f, S.top));\n  else if (brake) f = f > 0.05 ? Math.max(0, f - BRAKE) : Math.max(f - ACC * 0.6, -REV);\n  else f *= ROLL;\n  if (f > S.top) f -= (f - S.top) * 0.1;   // a slow surface drags a fast car down to its top speed\n  c.sliding = !gas && Math.abs(c.st) > 0.3 && f > 1;\n  side *= Math.max(S.keep, c.sliding ? SLIDE_KEEP : 0);\n  c.vx = f * ca - side * sa; c.vy = f * sa + side * ca;\n  // Move, one axis at a time, bouncing off walls.\n  if (hitsWall(c.x + c.vx, c.y)) { c.vx *= -BOUNCE; c.vy *= SCRAPE; bump(c); } else c.x += c.vx;\n  if (hitsWall(c.x, c.y + c.vy)) { c.vy *= -BOUNCE; c.vx *= SCRAPE; bump(c); } else c.y += c.vy;\n  c.surf = surfAt(c.x, c.y);\n  if (c.surf === S_HOLE) { c.fall = FALL_T; fx(SFX.fall); }\n  follow(c);\n}\n\nlet lastBump = -99;\nfunction bump(c) { if (clock - lastBump > 8) { fx(SFX.bump); lastBump = clock; } }\n\n/** Step 1: a fallen car comes back on its waypoint (from step 2 it is out of the round instead). */\nfunction respawn(c) { placeAt(c, c.wp, 0, 0); c.surf = surfAt(c.x, c.y); fx(SFX.land); }\n\n/** Keep a car's waypoint up to date: move it on (or back) along the centreline as the car passes, counting laps. A car\n * only moves one waypoint at a time, so it cannot jump to a part of the track that lies close by on the table. */\nfunction follow(c) {\n  const n = track.n;\n  for (let i = 0; i < 4; i++) {\n    const k = c.wp, k1 = (k + 1) % n, dx = track.wx[k1] - track.wx[k], dy = track.wy[k1] - track.wy[k];\n    const t = ((c.x - track.wx[k]) * dx + (c.y - track.wy[k]) * dy) / (dx * dx + dy * dy);\n    if (t >= 1) { c.wp = k1; if (k1 === 0) c.lap++; }\n    else if (t < 0 && i === 0) { if (k === 0) c.lap--; c.wp = (k + n - 1) % n; break; }\n    else break;\n  }\n}\n\n/** How far a car is along the race: laps and waypoints (the leader is the car with the most; spec 5.4). */\nfunction progress(c) {\n  const n = track.n, k = c.wp, k1 = (k + 1) % n, dx = track.wx[k1] - track.wx[k], dy = track.wy[k1] - track.wy[k];\n  const t = clamp(((c.x - track.wx[k]) * dx + (c.y - track.wy[k]) * dy) / (dx * dx + dy * dy), 0, 1);\n  return c.lap * n + k + t;\n}\n\n// --- The camera (spec 5.5): it looks 40 px ahead of the car it follows, moving 12 % of the way a frame, at most 4 px ---\n\nconst LOOK = 40, CAM_K = 0.12, CAM_MAX = 4, HUD_H = 12;\nlet cam = { x: 0, y: 0 };\nfunction camTarget(c) {\n  const tx = c.x + Math.cos(c.a) * LOOK - 128, ty = c.y + Math.sin(c.a) * LOOK - (HUD_H + (224 - HUD_H) / 2);\n  return [clamp(tx, 0, track.w * 8 - 256), clamp(ty, -HUD_H, track.h * 8 - 224)];\n}\nfunction moveCam(c, cut) {\n  const [tx, ty] = camTarget(c);\n  if (cut) { cam.x = tx; cam.y = ty; return; }\n  cam.x += clamp((tx - cam.x) * CAM_K, -CAM_MAX, CAM_MAX);\n  cam.y += clamp((ty - cam.y) * CAM_K, -CAM_MAX, CAM_MAX);\n}\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in a race\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0;\nlet cars = [];\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  const f = ART.scenes.floor;\n  bg(0, { show: false });\n  bg(1, { mx: 0, my: 0, mw: 128, mh: 96, wrap: false, show: true });          // the table and the track\n  bg(2, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, wrap: true, show: true });   // the floor far below, repeated\n  blend({ layers: ['overlay'], half: true }); // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  if (skipTitle) startRace(0); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\n\nfunction startRace(i) {\n  buildTrack(i);\n  cars = [newCar(0, 0)];\n  moveCam(cars[0], true);\n  paused = false; timer = 0; state = 'race';\n  play(SONG.race);\n}\n\n// --- Update ---\n\nfunction update() {\n  readPads(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'race') updateRace();\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) { fx(SFX.select); startRace(0); }\n}\n\nfunction updateRace() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  for (const c of cars) {\n    const p = c.seat;\n    drive(c, (held(RIGHT, p) ? 1 : 0) - (held(LEFT, p) ? 1 : 0), held(A, p), held(B, p));\n  }\n  moveCam(cars[0], false);\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startRace(track.i); // restart\n    else toTitle();\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  if (state === 'race') drawRace();\n  else if (state === 'title') drawTitle();\n  if (paused) drawPause();\n}\n\n/** The car's sprite for its heading: 16 directions from 5 drawings (0 to 90 degrees), the rest flipped. */\nfunction drawCar(c) {\n  if (c.fall && (c.fall & 2)) return;   // a falling car blinks out of sight (the art pass, step 6, shrinks it)\n  const d = ((Math.round(c.a / (Math.PI / 8)) % 16) + 16) % 16;\n  let f = d, fxx = false, fyy = false;\n  if (d > 4 && d <= 8) { f = 8 - d; fxx = true; }\n  else if (d > 8 && d <= 12) { f = d - 8; fxx = fyy = true; }\n  else if (d > 12) { f = 16 - d; fyy = true; }\n  sprite(ART.sprites['car' + f], flr(c.x - cam.x) - 8, flr(c.y - cam.y) - 8, { fx: fxx, fy: fyy });\n}\n\nfunction drawRace() {\n  bgscroll(1, flr(cam.x), flr(cam.y));\n  bgscroll(2, flr(cam.x / 2), flr(cam.y / 2));\n  for (const c of cars) drawCar(c);\n  const c = cars[0];\n  rectfill(0, 0, 256, HUD_H, ART.colors.GLASS);\n  txt(track.name, 4, 2, GOLD);\n  txt(`LAP ${Math.max(0, c.lap) + 1}`, 120, 2, WHITE);\n  txt(`${SURF[c.surf].name}`, 200, 2, c.sliding ? CYAN : DIM);\n}\n\nfunction drawTitle() {\n  ctxt('TABLETOP GRAND PRIX', 50, GOLD);\n  ['CUP', 'QUICK RACE'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n  ctxt('STEP 1: A TEST TABLE', 180, DIM);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART RACE', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

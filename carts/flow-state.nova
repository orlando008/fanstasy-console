  "tiles": [
    "00000000444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444",
    "00000000433334333343333433334333343333433334333343333433334333343333433334333343333433334333343333433334333343333433334333343333",
    "00000000323323333333434443322223442242324332333333333433333213233342123332332333333343444332222344224232433233333333343333321323",
    "00000000233213333333323333212213322321443333233333333333332132133333433323321333333332333321221332232144333323333333333333213213",
    "00000000433333333333332333333332223433333432133333322333333333333434342243333333333333233333333222343333343213333332233333333333",

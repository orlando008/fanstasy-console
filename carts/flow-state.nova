{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Flow State",
    "author": "NOVA-16",
    "description": "You are a frog in a river and the river is music: lily pads come down the water to the notes of Bach and Beethoven, and you tap one button to hop on each, on the beat. (In progress.)"
  },
  "label": "",
  "code": "// Flow State: a frog on a river of lily pads, a one-button rhythm game to Bach and Beethoven (docs/carts/flow-state.md).\n// The music is the clock: a song's row lasts `speed` frames, so a chart (rom/charts.bin, made from the same notes as the song) is in\n// time with it to the frame. `tm` counts frames of song time from the start of the piece; the music starts when it reaches `musicAt`.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, ORANGE = 9, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"fly\": {\"pal\": 5, \"size\": 8, \"tile\": 567}, \"frog_air\": {\"pal\": 1, \"size\": 32, \"tile\": 640}, \"frog_crouch\": {\"pal\": 1, \"size\": 32, \"tile\": 588}, \"frog_land\": {\"pal\": 1, \"size\": 32, \"tile\": 644}, \"frog_sit\": {\"pal\": 1, \"size\": 32, \"tile\": 584}, \"orb\": {\"pal\": 2, \"size\": 32, \"tile\": 648}, \"pad16\": {\"pal\": 0, \"size\": 16, \"tile\": 580}, \"pad32\": {\"pal\": 0, \"size\": 32, \"tile\": 576}, \"pad8\": {\"pal\": 0, \"size\": 8, \"tile\": 560}, \"ripple16\": {\"pal\": 5, \"size\": 16, \"tile\": 612}, \"ripple32\": {\"pal\": 5, \"size\": 32, \"tile\": 900}, \"ripple32b\": {\"pal\": 5, \"size\": 32, \"tile\": 904}, \"ripple8\": {\"pal\": 5, \"size\": 8, \"tile\": 566}},\n  scenes: {\"far\": {\"h\": 8, \"mx\": 0, \"my\": 0, \"pal\": 2, \"w\": 32}, \"reeds\": {\"h\": 28, \"mx\": 0, \"my\": 64, \"pal\": 3, \"w\": 32}, \"river\": {\"h\": 128, \"mx\": 128, \"my\": 0, \"pal\": 1, \"w\": 128}},\n  colors: {\"DIM\": 10, \"GLASS\": 200, \"GLOW_GOOD\": 202, \"GLOW_OK\": 201, \"GLOW_PERFECT\": 203, \"PANEL\": 3, \"SHADOW\": 1},\n  big: {\"go\": {\"h\": 38, \"parts\": [[0, 0, 776, 32, 3, 0], [32, 0, 780, 32, 3, 0]], \"w\": 70}, \"gradeA\": {\"h\": 38, \"parts\": [[0, 0, 836, 32, 3, 0]], \"w\": 38}, \"gradeB\": {\"h\": 38, \"parts\": [[0, 0, 840, 32, 3, 0]], \"w\": 38}, \"gradeC\": {\"h\": 38, \"parts\": [[0, 0, 844, 32, 3, 0]], \"w\": 38}, \"gradeD\": {\"h\": 38, \"parts\": [[0, 0, 896, 32, 3, 0]], \"w\": 38}, \"gradeS\": {\"h\": 38, \"parts\": [[0, 0, 832, 32, 3, 0]], \"w\": 38}, \"halo\": {\"h\": 48, \"parts\": [[0, 0, 908, 32, 5, 0], [32, 0, 614, 16, 5, 0], [32, 16, 960, 16, 5, 0], [0, 32, 962, 16, 5, 0], [16, 32, 964, 16, 5, 0], [32, 32, 966, 16, 5, 0]], \"w\": 48}, \"logo\": {\"h\": 21, \"parts\": [[0, 0, 652, 32, 3, 0], [32, 0, 704, 32, 3, 0], [64, 0, 561, 8, 3, 0], [64, 8, 562, 8, 3, 0], [80, 0, 582, 16, 3, 0], [80, 16, 563, 8, 3, 0], [88, 16, 563, 8, 3, 1], [96, 0, 708, 32, 3, 0], [128, 0, 712, 32, 3, 0], [160, 0, 564, 8, 3, 0], [160, 8, 565, 8, 3, 0]], \"w\": 165}, \"n1\": {\"h\": 38, \"parts\": [[0, 0, 772, 32, 3, 0]], \"w\": 38}, \"n2\": {\"h\": 38, \"parts\": [[0, 0, 768, 32, 3, 0]], \"w\": 38}, \"n3\": {\"h\": 38, \"parts\": [[0, 0, 716, 32, 3, 0]], \"w\": 38}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0 };                                           // the pieces are songs 1 and on\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 2, LAG_SLOT = 1, OPEN_SLOT = 2, BEST_SLOT = 10;\nconst DIFF_NAMES = ['EASY', 'NORMAL', 'HARD'];\nconst bestSlot = (piece, diff) => BEST_SLOT + (piece * 3 + diff) * 2;            // the score; the grade (0 none, 1 D to 5 S) and the best combo\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst tapped = () => pressed(A) || pressed(B) || pressed(X) || pressed(Y) || pressed(L) || pressed(R);\n\n// --- The rules (spec section 5) ---\n\nconst LOOKAHEAD = 110, LEAD = 120, RESUME_LEAD = 90, WIN = [3, 6, 10], FLOW_START = 30;     // frames: how far ahead a pad shows, the count-in, the count-in after a pause, the windows\nconst JUDGE = [{ name: 'PERFECT', flow: 5, pts: 100 }, { name: 'GOOD', flow: 3, pts: 70 }, { name: 'OK', flow: 1, pts: 40 }];\nconst MISS_FLOW = -12, STRAY_FLOW = -2, GRADES = ['D', 'C', 'B', 'A', 'S'];\n\n/** The chart of a piece for a difficulty, from the ROM: { speed, notes: [{ f (the frame), pitch, dur (rows), r (0 waiting, 1 to 3 the judgement, 4 missed, 5 skipped) }] }. */\nfunction loadChart(i, diff) {\n  const b = rom('charts'), off = b[1 + 2 * i] | (b[2 + 2 * i] << 8), n = b[off + 2] | (b[off + 3] << 8), notes = [];\n  for (let k = 0; k < n; k++) {\n    const o = off + 4 + 4 * k, fl = b[o + 3];\n    if (fl & (1 << diff)) notes.push({ f: b[o] | (b[o + 1] << 8), pitch: b[o + 2], dur: fl >> 3, r: 0 });\n  }\n  return { speed: b[off], notes };\n}\nconst multiplier = () => (inFlow ? 4 : flow >= 70 ? 3 : flow >= 40 ? 2 : 1);\nconst flowName = () => ['CALM', 'FLOWING', 'DEEP', 'FLOW STATE'][multiplier() - 1];\n\n/** A pad hit with judgement g (0 perfect, 1 good, 2 ok): the points at the multiplier the flow gives now, then the flow moves. */\nfunction hit(n, g) {\n  n.r = g + 1; combo++; bestCombo = Math.max(bestCombo, combo); counts[g]++;\n  score += JUDGE[g].pts * multiplier();\n  setFlow(flow + JUDGE[g].flow);\n  show(JUDGE[g].name, g === 0 ? GOLD : g === 1 ? GREEN : CYAN); fx(SFX.point); lastG = g;\n  if (combo % 10 === 0) banner(`${combo} COMBO`, GOLD);\n}\nfunction miss(n) { n.r = 4; combo = 0; counts[3]++; setFlow(flow + MISS_FLOW); show('MISS', RED); }                       // the word in red says it: no sound, it would cut into the music's flow\nconst LEVEL_COLOURS = [CYAN, GREEN, ORANGE, GOLD];\nfunction setFlow(v) {\n  flow = clamp(v, 0, 100); if (flow >= 90) inFlow = true; else if (flow < 80) inFlow = false;\n  const m = multiplier(); if (m > lastMult) banner(flowName(), LEVEL_COLOURS[m - 1]); lastMult = m;\n}\nfunction banner(text, c) { bannerText = text; bannerColour = c; bannerAt = clock; }\nfunction show(text, c) { judgeText = text; judgeColour = c; judgeAt = clock; }\n\n/** A tap at song time st: the nearest pad not hit yet within the widest window is judged; a tap with no pad near is a stray. */\nfunction tap(st) {\n  let best = null;\n  for (const n of notes) if (!n.r && Math.abs(n.f - st) <= WIN[2] && (!best || Math.abs(n.f - st) < Math.abs(best.f - st))) best = n;\n  hopFrom = frogX; hopFromY = frogY; hopTo = best ? 128 + best.lane * LANE : frogX; hopZ = best ? ZH + V * (best.f - st) : Z0; hopAt = clock;\n  if (!best) { setFlow(flow + STRAY_FLOW); return; }\n  const d = Math.abs(best.f - st);\n  hit(best, d <= WIN[0] ? 0 : d <= WIN[1] ? 1 : 2);\n}\nconst accuracy = () => { const n = counts[0] + counts[1] + counts[2] + counts[3]; return n ? (counts[0] + 0.7 * counts[1] + 0.4 * counts[2]) / n : 0; };\nconst gradeOf = (acc) => (acc >= 0.95 ? 4 : acc >= 0.85 ? 3 : acc >= 0.7 ? 2 : acc >= 0.5 ? 1 : 0);\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet look = 0, lastMult = 1, lastG = -1, bannerText = '', bannerColour = WHITE, bannerAt = -99;   // the flow look (0 calm to 1 flow state), the last multiplier, the last hit's judgement, a banner\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, pickPiece = 1, pickDiff = 1;\nconst PIECES = ['PRACTICE: SCALE RUN', 'MINUET IN G', 'AIR ON THE G STRING', 'FUR ELISE', 'MOONLIGHT SONATA', 'BADINERIE'], DIFFS = ['EASY', 'NORMAL', 'HARD'];\nlet piece = 0, diff = 1, notes = [], speed = 8, tm = 0, musicAt = 0, started = false, lag = 0;\nlet score = 0, combo = 0, bestCombo = 0, flow = FLOW_START, inFlow = false, counts = [0, 0, 0, 0], hopAt = -99, judgeText = '', judgeColour = WHITE, judgeAt = -99, endAt = 0, newBest = false;\nconst st = () => tm - lag;                                          // the song time the player hears now\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  lag = dget(LAG_SLOT) ? dget(LAG_SLOT) - 16 : 0;\n  const r = ART.scenes.reeds, fb = ART.scenes.far, rv = ART.scenes.river;\n  bg(0, { mx: r.mx, my: r.my, mw: r.w, mh: r.h, x: 0, y: 0, wrap: false, show: true });\n  bg(1, { mx: fb.mx, my: fb.my, mw: fb.w, mh: fb.h, x: 0, y: 0, wrap: true, show: true });\n  bg(2, { mx: rv.mx, my: rv.my, mw: rv.w, mh: rv.h, wrap: true, show: false });\n  blend({ layers: ['overlay'], half: true }); // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  initTint();\n  if (skipTitle) startPiece(0, 1); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; look = 0; resetStamp(); play(SONG.title); }\n\n/** A piece from its start: the count-in, then the music when song time reaches 0. */\nfunction startPiece(i, d) {\n  piece = i; diff = d; const c = loadChart(i, d); notes = c.notes; speed = c.speed; setLanes();\n  look = 0; lastMult = 1; lastG = -1; bannerAt = -99; resetStamp();\n  frogX = hopFrom = hopTo = 128; hopAt = -99; pieceEnd = (notes.length ? notes[notes.length - 1].f : 0) + 120;\n  score = 0; combo = 0; bestCombo = 0; flow = FLOW_START; inFlow = false; counts = [0, 0, 0, 0]; judgeAt = -99; newBest = false;\n  tm = -LEAD; musicAt = 0; started = false; endAt = 0; paused = false; timer = 0; state = 'play'; play(-1);\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'pick') updatePick();\n  else if (state === 'results') updateResults();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) { state = 'pick'; timer = 0; } else { state = 'records'; timer = 0; }\n  }\n}\n\n/** Choose a piece (UP and DOWN) and a difficulty (LEFT and RIGHT); the journey's map takes this place in step 5. */\nfunction updatePick() {\n  if (pressed(UP)) { pickPiece = (pickPiece + PIECES.length - 1) % PIECES.length; fx(SFX.move); }\n  if (pressed(DOWN)) { pickPiece = (pickPiece + 1) % PIECES.length; fx(SFX.move); }\n  if (pressed(LEFT)) { pickDiff = (pickDiff + 2) % 3; fx(SFX.move); }\n  if (pressed(RIGHT)) { pickDiff = (pickDiff + 1) % 3; fx(SFX.move); }\n  if (pressed(B)) { state = 'title'; timer = 0; fx(SFX.move); }\n  else if (pressed(A) || pressed(START)) { fx(SFX.select); startPiece(pickPiece, pickDiff); }\n}\n\n/** One frame of a piece: the clock, the music's start, the taps, the pads that were missed, the end. */\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); music(-1); playing = -1; return; }\n  tm++;\n  if (!started && tm >= musicAt) { started = true; playing = piece + 1; music(piece + 1, musicAt / (64 * speed)); }\n  if (tapped()) tap(st());\n  for (const n of notes) if (!n.r && n.f + WIN[2] < st()) miss(n);\n  const last = notes.length ? notes[notes.length - 1].f : 0;\n  if (!endAt && st() > last + WIN[2] && notes.every((n) => n.r)) endAt = clock;\n  if (endAt && clock > endAt + 90) finish();\n}\n\nfunction finish() {\n  endAt = 0; state = 'results'; timer = 0;\n  const g = gradeOf(accuracy()), s = bestSlot(piece, diff);\n  newBest = score > dget(s); setStamp(g);\n  if (newBest) { dset(s, score); dset(s + 1, (g + 1) | (bestCombo << 4)); }\n  if (dget(OPEN_SLOT) < piece + 2) dset(OPEN_SLOT, piece + 2);\n  fx(SFX.record);\n}\n\nfunction updateResults() {\n  if (timer > 30 && (pressed(A) || pressed(START))) { fx(SFX.select); toTitle(); }\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\n/** Resume starts the music again at the start of the pattern the piece was in, after a count-in: pads whose time went by stay as they were. */\nfunction resume() {\n  paused = false;\n  const pat = Math.max(0, Math.floor(Math.max(0, tm) / (64 * speed)));\n  musicAt = pat * 64 * speed; tm = musicAt - RESUME_LEAD; started = false;\n  for (const n of notes) if (!n.r && n.f < musicAt) n.r = 5;            // too near the cut to play: skipped\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { fx(SFX.pause); resume(); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) resume();\n    else if (pauseSel === 1) startPiece(piece, diff); // restart\n    else toTitle(); // quitting abandons the piece: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\n// The river is a floor seen in perspective (BG2, affine: a new matrix on every line, SPEC 4.5): the line y shows the water z world\n// pixels ahead of the camera, z = HEIGHT * FOCAL / (y - HORIZON + 1); a pad z ahead is drawn on the same line, so it sits on the water.\n// The frog is at Z0. The river flows V world pixels a frame, so a pad shows LOOKAHEAD frames before it reaches the hit line, ZH, a little\n// ahead of the frog: a pad on the line is a perfect tap (the glowing bar marks the windows); the frog jumps onto it as it floats on to him.\nconst HORIZON = 64, FOCAL = 128, HEIGHT = 123, Z0 = 128, ZH = 185, V = 5, FROG_Y = 186, LANE = 45, HOPF = 14;\nconst lineY = (z) => HORIZON - 1 + HEIGHT * FOCAL / z;                                       // the screen line of the water z ahead\nlet frogX = 128, frogY = FROG_Y, hopFrom = 128, hopFromY = FROG_Y, hopTo = 128, hopZ = Z0, pieceEnd = 1, camY = 0;\n\n/** A lane from -2 to 2 for each pad, from its pitch (the lowest tenth of the notes to the highest tenth), so the frog's hops draw the melody. */\nfunction setLanes() {\n  const ps = notes.map((n) => n.pitch).sort((a, b) => a - b), lo = ps[flr(ps.length * 0.1)] ?? 0, hi = ps[Math.max(0, Math.ceil(ps.length * 0.9) - 1)] ?? 0;\n  for (const n of notes) n.lane = clamp(Math.round((n.pitch - lo) / Math.max(hi - lo, 4) * 4) - 2, -2, 2);\n}\n\n// The five times of day (dawn, morning, noon, dusk, night) are tints of the noon palettes, and a sky: [red, green, blue multipliers, red,\n// green, blue added, the sky at the top, in the middle and at the horizon (3 numbers each), the stars' brightness 0 to 1, the sun or moon's\n// place (x, y) and colour]. A piece goes from one to another over its length (the Moonlight, from dusk to night).\nconst TOD = [\n  [1, 0.9, 0.85, 5, 2, 0, 10, 12, 22, 26, 16, 20, 31, 24, 16, 0.2, 40, 44, 31, 24, 12],\n  [0.95, 1, 1.05, 1, 2, 3, 14, 21, 27, 20, 26, 30, 26, 29, 30, 0, 70, 24, 31, 30, 20],\n  [1, 1, 1, 0, 0, 0, 7, 15, 25, 13, 21, 28, 22, 27, 30, 0, 112, 6, 31, 31, 24],\n  [1, 0.78, 0.74, 4, 0, 2, 6, 7, 13, 22, 9, 13, 31, 17, 9, 0.35, 190, 40, 31, 16, 8],\n  [0.34, 0.42, 0.62, 0, 0, 2, 1, 2, 6, 3, 4, 10, 5, 7, 13, 1, 176, 14, 24, 26, 31]];\nconst PIECE_TOD = [[2, 2], [0, 0], [1, 1], [2, 2], [3, 4], [4, 4]], TITLE_TOD = [3, 3];\nconst TINTED = [[17, 31], [33, 47], [49, 63], [129, 143], [145, 159], [161, 175]];       // the CGRAM entries of the river, the far bank, the reeds, the pads, the frog, the orb\nconst STAR = 39, ORB = [161, 162, 163];                                                   // the stars' entry and the sun's three (art.json says where)\nconst STAMP = [177, 183];                                                                  // the lettering's palette: an ink, a gold ramp of five, a shade (the logo, the count-in, the grade)\nconst STAMP_COLOURS = [[17, 19, 26], [24, 15, 8], [8, 22, 29], [10, 28, 12], [31, 25, 6]];   // for the grades D to S\nlet baseColours = [], tintedNow = [], tod = TOD[2], todKey = '';\nfunction initTint() { for (const [a, b] of TINTED.concat([STAMP])) for (let e = a; e <= b; e++) baseColours[e] = color(e); }\n/** The big letters of a grade in its colour (the gold of the logo is the palette as made). */\nfunction setStamp(g) { const c = STAMP_COLOURS[g]; [0.4, 0.62, 0.82, 1, 1.22].forEach((k, i) => color(STAMP[0] + 1 + i, clamp(c[0] * k, 0, 31), clamp(c[1] * k, 0, 31), clamp(c[2] * k, 0, 31))); }\nfunction resetStamp() { for (let e = STAMP[0]; e <= STAMP[1]; e++) if (baseColours[e]) color(e, baseColours[e][0], baseColours[e][1], baseColours[e][2]); }\nconst mixTod = (a, b, k) => TOD[a].map((v, i) => lerp(v, TOD[b][i], k));\n/** The palettes in the light of `v` (a row of TOD); sprites take half of it. */\nfunction applyTod(v) {\n  tod = v;\n  TINTED.forEach(([a, b], g) => {\n    const h = g > 2 ? 0.55 : 1, r = g > 2 ? 1 : 1 + 0.2 * look, d = g > 2 ? 0 : 2.5 * look;      // in flow the colours grow richer and brighter: the river, the bank and the reeds\n    for (let e = a; e <= b; e++) {\n      const c = baseColours[e];\n      const t = tintedNow[e] = [clamp((c[0] * (1 + (v[0] - 1) * h) + v[3] * h) * r + d, 0, 31), clamp((c[1] * (1 + (v[1] - 1) * h) + v[4] * h) * r + d, 0, 31), clamp((c[2] * (1 + (v[2] - 1) * h) + v[5] * h) * r + d, 0, 31)];\n      color(e, t[0], t[1], t[2]);\n    }\n  });\n  const m = v.slice(18), s = clamp(v[15], 0, 1);\n  color(STAR, lerp(v[9], 31, s), lerp(v[10], 31, s), lerp(v[11], 31, s));                // a star is the sky's colour until the night\n  color(ORB[0], m[0] * 0.85, m[1] * 0.85, m[2] * 0.85); color(ORB[1], m[0], m[1], m[2]); color(ORB[2], Math.min(31, m[0] + 6), Math.min(31, m[1] + 6), Math.min(31, m[2] + 6));\n}\n/** Each frame: the time of day from the piece's progress (or the title's), and the palettes when it has changed enough to see. */\nfunction updateTod() {\n  const [a, b] = state === 'title' || state === 'pick' || state === 'records' ? TITLE_TOD : PIECE_TOD[piece] || [2, 2];\n  const k = state === 'play' ? clamp(tm / pieceEnd, 0, 1) : state === 'results' ? 1 : 0, key = `${a}${b}${flr(k * 40)}.${flr(look * 20)}`;\n  if (key !== todKey) { todKey = key; applyTod(mixTod(a, b, k)); }\n}\nconst skyAt = (y) => {\n  const t = y / HORIZON, v = tod, k = t < 0.5 ? t * 2 : t * 2 - 1, o = t < 0.5 ? 6 : 9;\n  const b = 3 * look;                                                                      // and the sky brighter\n  return [lerp(v[o], v[o + 3], k) + b, lerp(v[o + 1], v[o + 4], k) + b, lerp(v[o + 2], v[o + 5], k) + b];\n};\n\nfunction draw() {\n  cls();\n  camY = state === 'play' ? -tm * V : -clock * 1.5;                                          // the river flows with the song\n  bg(1, { show: true, x: flr(clock * 0.15) }); bg(2, { show: false }); affine({ a: 1, b: 0, c: 0, d: 1, cx: 0, cy: 0 });\n  look += ((state === 'play' && !paused ? (multiplier() - 1) / 3 : 0) - look) * 0.04;\n  blend(state === 'play' && !paused ? { layers: ['overlay', 'spr'], op: 'add' } : { layers: ['overlay'], half: true });   // in play the glows add their light; in the menus the panels mix\n  updateTod();\n  sprite({ tile: ART.sprites.orb.tile, size: 32, pal: ART.sprites.orb.pal }, tod[16] - 16, tod[17] - 16, { prio: 0 });\n  drawFrogAndPads();\n  drawFireflies();\n  if (state === 'play') drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'pick') drawPick();\n  else if (state === 'results') drawResults();\n  else if (state === 'records') drawRecords();\n  if (paused) drawPause();\n}\n\n/** The sprites of the river: the frog (first, so it is on top of the pad under it), its halo in flow state, a ripple where it landed, the pad under it, and the pads on their way. */\nfunction drawFrogAndPads() {\n  const age = clock - hopAt, a = age / HOPF;\n  let fx = hopTo, fy = FROG_Y, up = 0;\n  if (age < HOPF) {                                                                          // the hop: to the pad as it floats on towards the frog (a stray tap hops in place)\n    const e = 0.5 - Math.cos(Math.PI * a) / 2, z = Math.max(Z0, hopZ - V * age), k = FOCAL / z;\n    fx = lerp(hopFrom, 128 + (hopTo - 128) * k, e); fy = lerp(hopFromY, Math.min(FROG_Y, lineY(z)), e);\n    up = Math.sin(Math.PI * a) * (hopZ === Z0 ? 10 : 16 + 8 * look);                          // higher hops in flow state\n  }\n  if (state === 'results') {                                                                   // the frog waits beside the grade, and hops for joy after an A or an S\n    const j = gradeOf(accuracy()) >= 3 ? Math.abs(Math.sin(timer * 0.07)) * 12 : 0;\n    sprite(ART.sprites[j > 3 ? 'frog_air' : 'frog_sit'], 42, 112 - 26 - j); sprite(ART.sprites.pad32, 42, 112 - 18);\n    return;\n  }\n  frogX = fx; frogY = fy;\n  const pose = age < 3 ? 'crouch' : age < HOPF - 3 ? 'air' : age < HOPF + 4 ? 'land' : 'sit', home = age < HOPF - 3 ? hopFrom : hopTo;\n  sprite(ART.sprites['frog_' + pose], fx - 16, fy - 26 - up);\n  if (look > 0.8 && state === 'play') bigSprite(ART.big.halo, fx - 24, fy - 12 - up - 24);   // the frog glows\n  const rp = age - HOPF;\n  if (state === 'play' && lastG >= 0 && rp >= 0 && rp < 18) {                                // a ripple on the water where the frog landed, in the colour of the judgement\n    const S = rp < 6 ? 8 : rp < 12 ? 16 : 32, r = ART.sprites['ripple' + S + (S === 32 && rp > 14 ? 'b' : '')];\n    sprite(r, hopTo - S / 2, FROG_Y + 6 - S * 0.62, { pal: [5, 6, 4][lastG] });\n  }\n  sprite(ART.sprites.pad32, home - 16, FROG_Y + 2 - 20);\n  if (state !== 'play') return;\n  for (const n of notes) {\n    const z = ZH + V * (n.f - st());\n    if (z > ZH + V * LOOKAHEAD) break;\n    if (z < (n.r && n.r !== 4 ? Z0 : 98) || n.r === 5) continue;                               // a pad that was hit goes under the frog; one missed floats on and off the screen\n    const k = FOCAL / z, S = k >= 0.75 ? 32 : k >= 0.38 ? 16 : 8;\n    sprite(ART.sprites['pad' + S], 128 + n.lane * LANE * k - S / 2, HORIZON - 1 + HEIGHT * k - S * 0.62);\n  }\n}\n\n/** Fireflies come out as the flow deepens (a few in DEEP, many in FLOW STATE), drifting over the water and blinking. */\nfunction drawFireflies() {\n  if (state !== 'play' || paused) return;\n  const n = look > 0.9 ? 9 : look > 0.6 ? 5 : look > 0.3 ? 2 : 0;\n  for (let i = 0; i < n; i++) {\n    if ((clock + i * 23) % 90 > 70) continue;\n    sprite(ART.sprites.fly, 128 + Math.sin(clock * 0.011 * (1 + i % 3) + i * 2.4) * 108 - 4, 92 + (i % 4) * 17 + Math.sin(clock * 0.017 + i) * 9);\n  }\n}\n\n/** The hit line: a glowing bar across the river where a pad is a perfect tap, with the good and ok windows fainter around it (the windows' real size in frames). */\nfunction drawHitBar() {\n  const half = 92, bands = [[WIN[2], ART.colors.GLOW_OK], [WIN[1], ART.colors.GLOW_GOOD], [WIN[0], ART.colors.GLOW_PERFECT]];\n  for (const [w, c] of bands) { const y0 = lineY(ZH + V * w), y1 = lineY(ZH - V * w); rectfill(128 - half, y0, half * 2, y1 - y0, c); }\n}\n\n/** The pond: the flow meter, a tall basin that fills; its top is a wave, its colour the level, with the levels' marks (x2, x3 and x4 at 40, 70 and 90). */\nfunction drawPond() {\n  const x = 8, y = 44, w = 16, h = 118, top = y + h - (h - 2) * flow / 100, m = multiplier(), c = LEVEL_COLOURS[m - 1];\n  rectfill(x - 2, y - 2, w + 4, h + 4, SHADOW); rect(x - 2, y - 2, w + 4, h + 4, PANEL); rectfill(x, y, w, h, PANEL + 0);\n  rectfill(x, y, w, h, SHADOW);\n  for (let i = 0; i < w; i++) { const yy = flr(top + Math.sin(clock * 0.15 + i * 0.7) * 1.5); rectfill(x + i, yy, 1, y + h - yy, c); }\n  if (flow > 2) rectfill(x, flr(top) + 3, 2, y + h - flr(top) - 5, WHITE);                      // a glint down the left edge\n  [[40, 2], [70, 3], [90, 4]].forEach(([v, k]) => { const yy = y + h - (h - 2) * v / 100; rectfill(x - 2, yy, w + 4, 1, PANEL); txt(`x${k}`, x + w + 4, yy - 4, k === m ? c : DIM); });\n  txt(flowName(), x - 2, y - 14, c);\n}\n\nfunction drawPlay() {\n  if (!paused) drawHitBar();\n  drawPond();\n  txt(`SCORE ${score}`, 8, 6, WHITE);\n  const m = multiplier(); txt(`x${m}`, 232, 6, LEVEL_COLOURS[m - 1]); txt(`x${m}`, 233, 6, LEVEL_COLOURS[m - 1]);\n  if (combo >= 2) txt(`${combo} COMBO`, 8, 16, combo >= 10 ? GOLD : DIM);\n  const age = clock - judgeAt;\n  if (age < 36 && (age < 26 || age % 4 < 2)) ctxt(judgeText, 118 - age * 0.25, judgeColour);   // the word rises a little as it goes\n  const ba = clock - bannerAt;\n  if (ba < 60 && (ba < 40 || ba % 6 < 3)) ctxt(bannerText, 94 - ba * 0.1, bannerColour);\n  const last = notes.length ? notes[notes.length - 1].f + WIN[2] : 1;\n  ctxt(`${PIECES[piece]}  ${DIFFS[diff]}`, 205, DIM);\n  rectfill(8, 216, 240, 3, PANEL); rectfill(8, 216, 240 * clamp(st() / last, 0, 1), 3, GOLD);   // the progress, along the bottom\n  if (tm < 0) { const d = ART.big['n' + Math.ceil(-tm / 40)]; if (d) bigSprite(d, 128 - d.w / 2, 78); }\n  else if (tm < 24) bigSprite(ART.big.go, 128 - ART.big.go.w / 2, 78);\n}\n\nfunction drawTitle() {\n  bigSprite(ART.big.logo, 128 - ART.big.logo.w / 2, 34);\n  ctxt('A RIVER OF MUSIC', 64, DIM);\n  ['PLAY', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\n\nfunction drawPick() {\n  panel(24, 36, 208, 150);\n  ctxt('CHOOSE A PIECE', 46, GOLD);\n  PIECES.forEach((s, i) => txt(`${i === pickPiece ? '> ' : '  '}${s}`, 40, 70 + i * 14, i === pickPiece ? WHITE : DIM));\n  DIFFS.forEach((s, i) => txt(s, 56 + i * 52, 164, i === pickDiff ? GOLD : DIM));\n  ctxt('A PLAY   B BACK', 180, DIM);\n}\n\nfunction drawResults() {\n  // The overlay is above the sprites, so the big grade and the frog stand on the open river at the left and the panels are beside and below them.\n  panel(92, 18, 140, 100); panel(24, 124, 208, 80);\n  const g = gradeOf(accuracy()), tot = counts[0] + counts[1] + counts[2] + counts[3];\n  txt(PIECES[piece], 100, 26, GOLD); txt(DIFFS[diff], 100, 37, DIM);\n  const st_ = ART.big['grade' + GRADES[g]]; bigSprite(st_, 58 - st_.w / 2, 30);\n  txt('ACCURACY', 100, 52, DIM); txt(`${Math.round(accuracy() * 100)}%`, 100, 62, WHITE);\n  txt('SCORE', 100, 76, DIM); txt(String(score), 100, 86, WHITE);\n  txt('BEST COMBO', 100, 100, DIM); txt(String(bestCombo), 188, 100, WHITE);\n  [['PERFECT', GOLD], ['GOOD', GREEN], ['OK', CYAN], ['MISS', RED]].forEach(([name, c], i) => {\n    const y = 132 + i * 13;\n    txt(name, 36, y, c); txt(String(counts[i]).padStart(4), 100, y, WHITE);\n    rectfill(144, y + 1, 76, 6, SHADOW); if (tot) rectfill(144, y + 1, Math.max(counts[i] ? 1 : 0, flr(76 * counts[i] / tot)), 6, c);\n  });\n  if (newBest && timer % 40 < 28) txt('NEW BEST!', 36, 186, GOLD);\n  if (timer > 30 && timer % 60 < 40) txt('A: CONTINUE', 140, 186, WHITE);\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('BEST SCORES', 24, GOLD);\n  for (let d = 0; d < 3; d++) {\n    const s = bestSlot(0, d), g = dget(s + 1) & 15;\n    txt(DIFF_NAMES[d], 40, 56 + d * 16, WHITE); txt(String(dget(s)).padStart(8), 120, 56 + d * 16, GOLD); txt(g ? GRADES[g - 1] : '-', 200, 56 + d * 16, WHITE);\n  }\n  if (timer % 60 < 40) ctxt('A: BACK', 192, DIM);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky above the horizon (the SNES did its skies with HDMA); below it the river in perspective, hazier towards the horizon. */\nfunction scanline(y) {\n  if (y < HORIZON) { const c = skyAt(y); color(0, c[0], c[1], c[2]); return; }\n  if (y === HORIZON) { bg(1, { show: false }); bg(2, { show: true }); }\n  const z = HEIGHT * FOCAL / (y - HORIZON + 1), s = z / FOCAL;\n  affine({ a: s, b: 512 - 128, c: 0, d: ((camY - z) % 1024 + 1024) % 1024, cx: 128, cy: 0 });\n  bgscroll(2, 0, 1 - y);\n  const h = y - HORIZON < 60 ? Math.pow(1 - (y - HORIZON) / 60, 1.6) * 0.8 : 0;               // haze: the far water takes the colour of the sky at the horizon\n  if (h > 0) { const c = skyAt(HORIZON - 1); for (let e = 17; e <= 31; e++) { const b = tintedNow[e]; color(e, lerp(b[0], c[0], h), lerp(b[1], c[1], h), lerp(b[2], c[2], h)); } }\n}\n",

{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Merge Café",
    "author": "NOVA-16",
    "description": "Restore a shabby little café one order at a time. Tap the oven, the grinder and the fruit basket for ingredients, merge two of a kind into something better (wheat into flour, dough, bread, a cake) and serve the regulars what they ask for. Stars rebuild the café room by room, and you choose how to decorate it."
  },
  "label": null,
  "code": "// Merge Café (docs/carts/merge-cafe.md)\n// A merge-2 game: generators on a 7 x 5 board give ingredients; two of a kind merge into the next one up; customers in the café above\n// order what the board can make. The rules are pure functions of the board (an array of 35 cell values), so tests drive them directly.\n\n// --- Colours: the default palette's overlay colours (the overlay's index 0 is transparent) ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, ORANGE = 9, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15, CREAM = 210, SOLID = 113;   // SOLID: an opaque panel fill (under 192, so blending leaves it)\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"cursor0\": {\"pal\": 7, \"size\": 32, \"tile\": 384}, \"cursor1\": {\"pal\": 7, \"size\": 32, \"tile\": 388}, \"slot0\": {\"pal\": 7, \"size\": 32, \"tile\": 396}, \"slot1\": {\"pal\": 7, \"size\": 32, \"tile\": 448}, \"slot10\": {\"pal\": 7, \"size\": 32, \"tile\": 580}, \"slot11\": {\"pal\": 7, \"size\": 32, \"tile\": 584}, \"slot12\": {\"pal\": 7, \"size\": 32, \"tile\": 588}, \"slot13\": {\"pal\": 7, \"size\": 32, \"tile\": 640}, \"slot14\": {\"pal\": 7, \"size\": 32, \"tile\": 644}, \"slot15\": {\"pal\": 7, \"size\": 32, \"tile\": 648}, \"slot16\": {\"pal\": 7, \"size\": 32, \"tile\": 652}, \"slot17\": {\"pal\": 7, \"size\": 32, \"tile\": 704}, \"slot18\": {\"pal\": 7, \"size\": 32, \"tile\": 708}, \"slot19\": {\"pal\": 7, \"size\": 32, \"tile\": 712}, \"slot2\": {\"pal\": 7, \"size\": 32, \"tile\": 452}, \"slot20\": {\"pal\": 7, \"size\": 32, \"tile\": 716}, \"slot21\": {\"pal\": 7, \"size\": 32, \"tile\": 768}, \"slot22\": {\"pal\": 7, \"size\": 32, \"tile\": 772}, \"slot23\": {\"pal\": 7, \"size\": 32, \"tile\": 776}, \"slot24\": {\"pal\": 7, \"size\": 32, \"tile\": 780}, \"slot25\": {\"pal\": 7, \"size\": 32, \"tile\": 832}, \"slot26\": {\"pal\": 7, \"size\": 32, \"tile\": 836}, \"slot27\": {\"pal\": 7, \"size\": 32, \"tile\": 840}, \"slot28\": {\"pal\": 7, \"size\": 32, \"tile\": 844}, \"slot29\": {\"pal\": 7, \"size\": 32, \"tile\": 896}, \"slot3\": {\"pal\": 7, \"size\": 32, \"tile\": 456}, \"slot30\": {\"pal\": 7, \"size\": 32, \"tile\": 900}, \"slot31\": {\"pal\": 7, \"size\": 32, \"tile\": 904}, \"slot32\": {\"pal\": 7, \"size\": 32, \"tile\": 908}, \"slot33\": {\"pal\": 7, \"size\": 32, \"tile\": 960}, \"slot34\": {\"pal\": 7, \"size\": 32, \"tile\": 964}, \"slot35\": {\"pal\": 7, \"size\": 32, \"tile\": 968}, \"slot4\": {\"pal\": 7, \"size\": 32, \"tile\": 460}, \"slot5\": {\"pal\": 7, \"size\": 32, \"tile\": 512}, \"slot6\": {\"pal\": 7, \"size\": 32, \"tile\": 516}, \"slot7\": {\"pal\": 7, \"size\": 32, \"tile\": 520}, \"slot8\": {\"pal\": 7, \"size\": 32, \"tile\": 524}, \"slot9\": {\"pal\": 7, \"size\": 32, \"tile\": 576}, \"spark\": {\"pal\": 7, \"size\": 8, \"tile\": 392}},\n  scenes: {\"board\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 2, \"w\": 32}, \"bubble\": {\"h\": 4, \"mx\": 64, \"my\": 0, \"pal\": 2, \"w\": 4}, \"cafe\": {\"h\": 7, \"mx\": 0, \"my\": 48, \"pal\": 1, \"w\": 32}, \"counter\": {\"h\": 4, \"mx\": 0, \"my\": 55, \"pal\": 1, \"w\": 32}, \"logo\": {\"h\": 7, \"mx\": 96, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y); opts as for spr. */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Pictures (art.py): items, generators, the crate and the customers are 32 x 32 pictures in the ROM (rom/pics.bin), copied into a pool of\n// sprite slots as the screen needs them, the least recently used slot first (spec 14). picSlot(p) returns the slot, -1 if every slot is\n// already showing another picture this frame (then the picture is not drawn this frame).\n\nconst POOL = 36, PIC_CRATE = 35, PIC_MABEL = 36;\nconst SLOT_TILE = Array.from({ length: POOL }, (_, k) => ART.sprites['slot' + k].tile);\nlet slotPic = new Array(POOL).fill(-1), slotAt = new Array(POOL).fill(-1), drawNo = 0, picLoads = 0;\nconst picPal = (p) => rom('pics')[1 + p * 513];\nfunction picSlot(p) {\n  let k = slotPic.indexOf(p);\n  if (k < 0) {\n    for (let i = 0; i < POOL; i++) if (slotAt[i] !== drawNo && (k < 0 || slotAt[i] < slotAt[k])) k = i;\n    if (k < 0) return -1;\n    const b = rom('pics'), off = 2 + p * 513, t = SLOT_TILE[k], x0 = (t % 16) * 8, y0 = (t >> 4) * 8;\n    for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x += 2) { const v = b[off + y * 16 + (x >> 1)]; sset(x0 + x, y0 + y, v & 15); sset(x0 + x + 1, y0 + y, v >> 4); }\n    slotPic[k] = p; picLoads++;\n  }\n  slotAt[k] = drawNo;\n  return k;\n}\nfunction drawPic(p, x, y, opts = {}) { const k = picSlot(p); if (k >= 0) spr(SLOT_TILE[k], x, y, { size: 32, pal: picPal(p), prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5): songs on channels 0 to 5, effects take turns on 6 and 7 ---\n\nconst SFX = { move: 0, select: 1, pause: 2, knock: 3, pick: 4, drop: 5, pop: 6, merge: 7, sell: 12, crate: 13, find: 14, serve: 15, stars: 16, fanfare: 17 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- The board and the items (spec 5.1 to 5.3) ---\n\nconst COLS = 7, ROWS = 5, CELLS = 35, CW = 32, CH = 28, BX = 16, BY = 84;\nconst EMPTY = 0, GEN0 = 31, CRATE = 40;                             // a cell: 0 empty, 1 to 30 an item (line x 6 + tier), 31 to 35 a generator, 40 a crate\nconst LINES = ['BAKERY', 'COFFEE', 'DAIRY', 'FRUIT', 'TABLEWARE'];\nconst NAMES = [\n  ['WHEAT', 'FLOUR', 'DOUGH', 'ROLL', 'LOAF', 'LAYER CAKE'],\n  ['BEANS', 'GROUND COFFEE', 'ESPRESSO', 'CAPPUCCINO', 'LATTE', 'COFFEE POT SET'],\n  ['MILK', 'CREAM', 'WHIPPED CREAM', 'ICE CREAM', 'SUNDAE', 'PARFAIT'],\n  ['CHERRY', 'STRAWBERRIES', 'BERRY BOWL', 'JAM JAR', 'FRUIT TART', 'FRUIT PIE'],\n  ['SPOON', 'CUP', 'TEAPOT', 'TRAY', 'CAKE STAND', 'TEA SERVICE'],\n];\nconst GEN_NAMES = ['GRAIN SACK', 'COFFEE GRINDER', 'MILK CHURN', 'FRUIT BASKET', 'CUPBOARD'];\nconst TIER2_CHANCE = 0.1, CRATE_BASE = 10, CRATE_STEP = 5, START_COINS = 10;\nconst item = (line, tier) => line * 6 + tier;\nconst isItem = (v) => v >= 1 && v <= 30, isGen = (v) => v >= GEN0 && v < GEN0 + 5;\nconst lineOf = (v) => ((v - 1) / 6) | 0, tierOf = (v) => ((v - 1) % 6) + 1;\nconst nameOf = (v) => (isItem(v) ? NAMES[lineOf(v)][tierOf(v) - 1] : isGen(v) ? GEN_NAMES[v - GEN0] : v === CRATE ? 'CRATE' : '');\nconst valueOf = (v) => (isItem(v) ? tierOf(v) * tierOf(v) : 0);  // what an item sells for (5.1)\nconst picOf = (v) => (isItem(v) ? v - 1 : isGen(v) ? 30 + v - GEN0 : v === CRATE ? PIC_CRATE : -1);\nconst colOf = (i) => i % COLS, rowOf = (i) => (i / COLS) | 0, cellX = (i) => BX + colOf(i) * CW, cellY = (i) => BY + rowOf(i) * CH;\nconst crateCost = () => CRATE_BASE + CRATE_STEP * cratesOpened;\n\n/** A new café's board: rows 0 and 1 open, the grain sack and the grinder on row 1, two wheat to start; the rest under crates (5.3). */\nfunction newBoard() {\n  const b = new Array(CELLS).fill(CRATE);\n  for (let i = 0; i < 14; i++) b[i] = EMPTY;\n  b[7 + 1] = GEN0; b[7 + 5] = GEN0 + 1; b[2] = item(0, 1); b[4] = item(0, 1);\n  return b;\n}\n/** The empty cell nearest cell i (the fewest steps across cells; ties: the higher row, then the left), or -1. */\nfunction nearestEmpty(b, i) {\n  let best = -1, bd = 99;\n  for (let j = 0; j < CELLS; j++) {\n    if (b[j] !== EMPTY) continue;\n    const d = Math.abs(colOf(j) - colOf(i)) + Math.abs(rowOf(j) - rowOf(i));\n    if (d < bd) { bd = d; best = j; }                               // j runs row by row, left to right: the first at a distance wins the tie\n  }\n  return best;\n}\n/** What dropping the item from cell a onto cell b does: 'back', 'move', 'merge', 'swap' or 'no' (a crate, or two of the top tier). */\nfunction dropKind(b, a, t) {\n  if (a === t) return 'back';\n  const u = b[t], v = b[a];\n  if (u === CRATE) return 'no';\n  if (u === EMPTY) return 'move';\n  if (u === v) return tierOf(v) < 6 ? 'merge' : 'no';\n  return 'swap';\n}\n/** A crate can be opened when a cell beside it (up, down, left or right) is open. */\nconst crateOpenable = (b, i) => b[i] === CRATE && [[-1, 0], [1, 0], [0, -1], [0, 1]].some(([dc, dr]) => {\n  const c = colOf(i) + dc, r = rowOf(i) + dr;\n  return c >= 0 && c < COLS && r >= 0 && r < ROWS && b[r * COLS + c] !== CRATE;\n});\n\n// --- Save slots (spec section 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, BOARD_SLOT = 1, COINS_SLOT = 10, STARS_SLOT = 11, FOUND_SLOT = 15, CRATES_SLOT = 17;\nfunction saveGame() {\n  for (let k = 0; k < 9; k++) {\n    let v = 0;\n    for (let q = 0; q < 4; q++) v |= (board[k * 4 + q] ?? 0) << (8 * q);\n    dset(BOARD_SLOT + k, v);\n  }\n  dset(COINS_SLOT, coins); dset(STARS_SLOT, stars); dset(FOUND_SLOT, found); dset(CRATES_SLOT, cratesOpened);\n}\nfunction loadGame() {\n  board = [];\n  for (let i = 0; i < CELLS; i++) board.push((dget(BOARD_SLOT + (i >> 2)) >>> (8 * (i & 3))) & 255);\n  coins = dget(COINS_SLOT); stars = dget(STARS_SLOT); found = dget(FOUND_SLOT); cratesOpened = dget(CRATES_SLOT);\n}\nconst hasSave = () => dget(VERSION_SLOT) === SAVE_VERSION && dget(BOARD_SLOT + 2) !== 0;\n\n// --- Input: edge-triggered presses, and a held d-pad that repeats ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst stepped = (b) => pressed(b) || (btnp(b) && (inputMask & (1 << b)) !== 0);\n\n// --- State ---\n\nlet skipTitle = false;                                              // tests set this to land straight on the board\nlet state = 'title', paused = false, timer = 0, clock = 0, titleSel = 0, pauseSel = 0, confirm = null;\nlet board = [], coins = 0, stars = 0, found = 0, cratesOpened = 0;\nlet cur = 17, held = -1, card = -1, ask = null, msg = '', msgAt = -999, msgC = WHITE;\nlet anims = [], sparks = [];\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  const bd = ART.scenes.board, cf = ART.scenes.cafe, lg = ART.scenes.logo;\n  bg(0, { mx: bd.mx, my: bd.my, mw: bd.w, mh: bd.h, x: 0, y: 0, wrap: false, show: true });\n  bg(1, { mx: cf.mx, my: cf.my, mw: cf.w, mh: 11, x: 0, y: 0, wrap: false, show: true });\n  bg(2, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -96, wrap: false, show: false });\n  color(CREAM, 30, 28, 24); color(SOLID, 6, 3, 2); color(0, 7, 4, 3);   // the backdrop: dark wood, for the title\n  const bb = ART.scenes.bubble;                                     // an order bubble beside the customer (orders: step 4)\n  for (let y = 0; y < bb.h; y++) for (let x = 0; x < bb.w; x++) mset(bd.mx + BUBBLE_TX + x, bd.my + y, mget(bb.mx + x, bb.my + y));\n  blend({ layers: ['overlay'], half: true });                       // overlay colours from 192 up (GLASS) are see-through panels\n  if (skipTitle) { if (hasSave()) loadGame(); else newCafe(); toPlay(); } else toTitle();\n}\n\nfunction newCafe() {\n  board = newBoard(); coins = START_COINS; stars = 0; found = 0; cratesOpened = 0;\n  markFound(item(0, 1), true); markFound(GEN0, true);\n  saveGame();\n}\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; confirm = null; play(SONG.title); }\nfunction toPlay() { state = 'play'; timer = 0; paused = false; held = -1; card = -1; ask = null; anims = []; play(SONG.play); }\nfunction say(text, c = WHITE) { msg = text; msgAt = clock; msgC = c; }\n/** The first time an item is made: a star and a card (5.6). quiet: at the start of a café, no star. */\nfunction markFound(v, quiet = false) {\n  if (!isItem(v)) return;\n  const bit = 1 << (v - 1);\n  if (found & bit) return;\n  found |= bit;\n  if (!quiet) { stars++; say('NEW: ' + nameOf(v) + '  +1 STAR', GOLD); fx(SFX.find); }\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (confirm) {                                                    // NEW CAFE over a saved one asks first\n    if (pressed(A)) { fx(SFX.select); newCafe(); toPlay(); } else if (pressed(B)) { fx(SFX.move); confirm = null; }\n    return;\n  }\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    const cont = hasSave();\n    if (titleSel === 0) { if (cont) loadGame(); else newCafe(); toPlay(); }\n    else if (cont) confirm = 'new'; else { newCafe(); toPlay(); }\n  }\n}\n\n/** A on the cell under the cursor: make, pick up, drop, open (spec section 3). */\nfunction press(i) {\n  const v = board[i];\n  if (held >= 0) { drop(held, i); return; }\n  if (isGen(v)) { generate(i); return; }\n  if (isItem(v)) { held = i; fx(SFX.pick); return; }\n  if (v === CRATE) {\n    if (!crateOpenable(board, i)) { say('OPEN THE CRATES NEXT TO YOUR SPACE FIRST', ORANGE); fx(SFX.knock); return; }\n    if (ask && ask.kind === 'crate' && ask.i === i) {\n      ask = null;\n      if (coins < crateCost()) { say(`A CRATE COSTS ${crateCost()} COINS`, ORANGE); fx(SFX.knock); return; }\n      coins -= crateCost(); cratesOpened++; board[i] = EMPTY; fx(SFX.crate); burst(i); saveGame();\n    } else ask = { kind: 'crate', i };\n  }\n}\nfunction generate(g) {\n  const to = nearestEmpty(board, g);\n  if (to < 0) { say('NO ROOM ON THE BOARD', ORANGE); fx(SFX.knock); return -1; }\n  const line = board[g] - GEN0, v = item(line, rnd(1) < TIER2_CHANCE ? 2 : 1);\n  board[to] = v; markFound(v); fx(SFX.pop);\n  anims.push({ i: to, from: g, at: clock });\n  saveGame();\n  return to;\n}\nfunction drop(a, t) {\n  const k = dropKind(board, a, t), v = board[a];\n  held = -1;\n  if (k === 'back') { fx(SFX.drop); return k; }\n  if (k === 'no') { held = a; fx(SFX.knock); return k; }\n  if (k === 'move') { board[t] = v; board[a] = EMPTY; fx(SFX.drop); }\n  else if (k === 'swap') { board[a] = board[t]; board[t] = v; fx(SFX.drop); }\n  else { board[t] = v + 1; board[a] = EMPTY; fx(SFX.merge + tierOf(v + 1) - 2); burst(t); markFound(v + 1); }\n  saveGame();\n  return k;\n}\nfunction sell(i) {\n  const v = board[i];\n  if (!isItem(v)) return 0;\n  coins += valueOf(v); board[i] = EMPTY; fx(SFX.sell); say(`SOLD ${nameOf(v)}: +${valueOf(v)} COIN${valueOf(v) > 1 ? 'S' : ''}`, GOLD); saveGame();\n  return valueOf(v);\n}\nfunction burst(i) { for (let k = 0; k < 6; k++) sparks.push({ x: cellX(i) + 16, y: cellY(i) + 13, a: k * Math.PI / 3 + clock * 0.3, at: clock }); }\n\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (ask) {                                                        // a question waiting: A yes, anything else no\n    if (pressed(A)) { const q = ask; if (q.kind === 'sell') { ask = null; sell(q.i); } else press(q.i); return; }\n    if (pressed(B) || stepped(UP) || stepped(DOWN) || stepped(LEFT) || stepped(RIGHT) || pressed(SELECT)) { ask = null; fx(SFX.move); }\n    return;\n  }\n  if (card >= 0) { if (pressed(A) || pressed(B) || pressed(SELECT)) card = -1; return; }\n  const c = colOf(cur), r = rowOf(cur);\n  if (stepped(LEFT) && c > 0) { cur--; fx(SFX.move); }\n  if (stepped(RIGHT) && c < COLS - 1) { cur++; fx(SFX.move); }\n  if (stepped(UP) && r > 0) { cur -= COLS; fx(SFX.move); }\n  if (stepped(DOWN) && r < ROWS - 1) { cur += COLS; fx(SFX.move); }\n  if (pressed(A)) press(cur);\n  else if (pressed(B)) { if (held >= 0) { held = -1; fx(SFX.drop); } else if (board[cur] !== EMPTY) card = cur; }\n  else if (pressed(SELECT) && held < 0) { if (isItem(board[cur])) ask = { kind: 'sell', i: cur }; else fx(SFX.knock); }\n}\n\nfunction updatePause() {\n  if (confirm) { if (pressed(A)) { fx(SFX.select); newCafe(); toPlay(); } else if (pressed(B)) confirm = null; return; }\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) confirm = 'new';\n    else { saveGame(); toTitle(); }\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls(); drawNo++;\n  const inGame = state === 'play';\n  bg(0, { show: inGame }); bg(2, { show: state === 'title' });\n  drawCafe();\n  if (inGame) { drawBoard(); drawHud(); }\n  else drawTitle();\n  if (paused) drawPause();\n}\n\nconst BUBBLE_TX = 18;                                               // the bubble's tile column in BG0's map (x 144)\n/** The café: Mabel at the counter with her order (customers and orders come in step 4). */\nfunction drawCafe() {\n  const blink = (clock % 240) < 8;\n  drawPic(PIC_MABEL + (blink ? 1 : 0), 112, 26, { prio: 1 });     // behind the counter's high-priority tiles\n  if (state === 'play') drawPic(picOf(item(0, 4)), BUBBLE_TX * 8, -2);   // her order: a roll\n}\n\nfunction drawBoard() {\n  const now = clock;\n  for (let i = 0; i < CELLS; i++) {\n    const v = board[i];\n    if (v === EMPTY || i === held) continue;\n    const an = anims.find((a) => a.i === i && now - a.at < 10);\n    let x = cellX(i), y = cellY(i) - 1;\n    if (an) { const k = (now - an.at) / 10; x = lerp(cellX(an.from), x, k); y = lerp(cellY(an.from), y, k) - Math.sin(k * Math.PI) * 10; }\n    drawPic(picOf(v), flr(x), flr(y), { prio: 2 });\n  }\n  anims = anims.filter((a) => now - a.at < 10);\n  const bob = (clock >> 4) & 1;\n  sprite(ART.sprites[bob ? 'cursor1' : 'cursor0'], cellX(cur), cellY(cur) - 2, { prio: 3 });\n  if (held >= 0) drawPic(picOf(board[held]), cellX(cur), cellY(cur) - 9 - bob, { prio: 3 });\n  sparks = sparks.filter((s) => clock - s.at < 14);\n  for (const s of sparks) { const d = 4 + (clock - s.at) * 1.5; sprite(ART.sprites.spark, flr(s.x + d * Math.cos(s.a) - 4), flr(s.y + d * Math.sin(s.a) - 4)); }\n}\n\nfunction drawHud() {\n  txt(`COINS ${coins}`, 4, 2, GOLD);\n  const st = `STARS ${stars}`; txt(st, 252 - st.length * 8, 2, CREAM);\n  if (ask) {\n    const v = board[ask.i];\n    panel(24, 120, 208, 40);\n    ctxt(ask.kind === 'sell' ? `SELL ${nameOf(v)} FOR ${valueOf(v)}?` : `OPEN THIS CRATE FOR ${crateCost()}?`, 130, WHITE);\n    ctxt('A: YES   B: NO', 144, DIM);\n  } else if (card >= 0) drawCard(board[card]);\n  else if (clock - msgAt < 100) { const w = msg.length * 8 + 12; rectfill(128 - w / 2, 70, w, 12, 200); ctxt(msg, 72, msgC); }\n}\n\n/** B on a cell: what it is (spec section 3). */\nfunction drawCard(v) {\n  panel(24, 96, 208, 72);\n  ctxt(nameOf(v), 104, GOLD);\n  if (isItem(v)) {\n    ctxt(`${LINES[lineOf(v)]}, TIER ${tierOf(v)} OF 6`, 118, DIM);\n    ctxt(tierOf(v) < 6 ? `TWO MAKE ${NAMES[lineOf(v)][tierOf(v)]}` : 'THE BEST OF ITS LINE', 132, WHITE);\n    ctxt(`SELLS FOR ${valueOf(v)} (SELECT)`, 146, DIM);\n  } else if (isGen(v)) { ctxt(`A: MAKE ${NAMES[v - GEN0][0]}`, 122, WHITE); ctxt('NO LIMIT: MIND THE SPACE', 138, DIM); }\n  else if (v === CRATE) { ctxt(`A: OPEN IT FOR ${crateCost()} COINS`, 122, WHITE); ctxt('ONLY NEXT TO OPEN SPACE', 138, DIM); }\n}\n\nfunction drawTitle() {\n  drawCafe();\n  if (confirm) { panel(32, 150, 192, 40); ctxt('START A NEW CAFE?', 158, WHITE); ctxt('YOUR SAVED ONE IS LOST.  A: YES  B: NO', 172, ORANGE); return; }\n  const cont = hasSave();\n  [cont ? 'CONTINUE' : 'NEW CAFE', cont ? 'NEW CAFE' : 'NEW CAFE'].slice(0, cont ? 2 : 1).forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 92, 162 + i * 14, i === titleSel ? WHITE : DIM));\n  ctxt('A: PICK UP, DROP   B: WHAT IS IT', 206, DIM);\n}\n\nfunction drawPause() {\n  panel(56, 80, 144, 64);\n  if (confirm) { ctxt('START A NEW CAFE?', 92, WHITE); ctxt('A: YES   B: NO', 112, ORANGE); return; }\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'NEW CAFE', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 68, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\n/** A panel: solid over the busy board (see_through for a light one over the picture). */\nfunction panel(x, y, w, h, seeThrough = false) { rectfill(x, y, w, h, seeThrough ? ART.colors.GLASS : SOLID); rect(x, y, w, h, GOLD); rect(x + 1, y + 1, w - 2, h - 2, SHADOW); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

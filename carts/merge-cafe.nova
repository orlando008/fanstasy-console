{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Merge Café",
    "author": "NOVA-16",
    "description": "Restore a shabby little café one order at a time. Tap the oven, the grinder and the fruit basket for ingredients, merge two of a kind into something better (wheat into flour, dough, bread, a cake) and serve the regulars what they ask for. Stars rebuild the café room by room, and you choose how to decorate it."
  },
  "label": "",
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, ORANGE = 9, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15, CREAM = 114, SOLID = 113, CHALK = 115;\nconst ART = {\ntiles: {},\nsprites: {\"cursor0\": {\"pal\": 4, \"size\": 32, \"tile\": 384}, \"cursor1\": {\"pal\": 4, \"size\": 32, \"tile\": 388}, \"slot0\": {\"pal\": 4, \"size\": 32, \"tile\": 396}, \"slot1\": {\"pal\": 4, \"size\": 32, \"tile\": 448}, \"slot10\": {\"pal\": 4, \"size\": 32, \"tile\": 580}, \"slot11\": {\"pal\": 4, \"size\": 32, \"tile\": 584}, \"slot12\": {\"pal\": 4, \"size\": 32, \"tile\": 588}, \"slot13\": {\"pal\": 4, \"size\": 32, \"tile\": 640}, \"slot14\": {\"pal\": 4, \"size\": 32, \"tile\": 644}, \"slot15\": {\"pal\": 4, \"size\": 32, \"tile\": 648}, \"slot16\": {\"pal\": 4, \"size\": 32, \"tile\": 652}, \"slot17\": {\"pal\": 4, \"size\": 32, \"tile\": 704}, \"slot18\": {\"pal\": 4, \"size\": 32, \"tile\": 708}, \"slot19\": {\"pal\": 4, \"size\": 32, \"tile\": 712}, \"slot2\": {\"pal\": 4, \"size\": 32, \"tile\": 452}, \"slot20\": {\"pal\": 4, \"size\": 32, \"tile\": 716}, \"slot21\": {\"pal\": 4, \"size\": 32, \"tile\": 768}, \"slot22\": {\"pal\": 4, \"size\": 32, \"tile\": 772}, \"slot23\": {\"pal\": 4, \"size\": 32, \"tile\": 776}, \"slot24\": {\"pal\": 4, \"size\": 32, \"tile\": 780}, \"slot25\": {\"pal\": 4, \"size\": 32, \"tile\": 832}, \"slot26\": {\"pal\": 4, \"size\": 32, \"tile\": 836}, \"slot27\": {\"pal\": 4, \"size\": 32, \"tile\": 840}, \"slot28\": {\"pal\": 4, \"size\": 32, \"tile\": 844}, \"slot29\": {\"pal\": 4, \"size\": 32, \"tile\": 896}, \"slot3\": {\"pal\": 4, \"size\": 32, \"tile\": 456}, \"slot30\": {\"pal\": 4, \"size\": 32, \"tile\": 900}, \"slot31\": {\"pal\": 4, \"size\": 32, \"tile\": 904}, \"slot32\": {\"pal\": 4, \"size\": 32, \"tile\": 908}, \"slot33\": {\"pal\": 4, \"size\": 32, \"tile\": 960}, \"slot34\": {\"pal\": 4, \"size\": 32, \"tile\": 964}, \"slot35\": {\"pal\": 4, \"size\": 32, \"tile\": 968}, \"slot4\": {\"pal\": 4, \"size\": 32, \"tile\": 460}, \"slot5\": {\"pal\": 4, \"size\": 32, \"tile\": 512}, \"slot6\": {\"pal\": 4, \"size\": 32, \"tile\": 516}, \"slot7\": {\"pal\": 4, \"size\": 32, \"tile\": 520}, \"slot8\": {\"pal\": 4, \"size\": 32, \"tile\": 524}, \"slot9\": {\"pal\": 4, \"size\": 32, \"tile\": 576}, \"spark\": {\"pal\": 4, \"size\": 8, \"tile\": 392}},\nscenes: {\"board\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 2, \"w\": 32}, \"bubble\": {\"h\": 4, \"mx\": 64, \"my\": 0, \"pal\": 2, \"w\": 4}, \"cafe\": {\"h\": 7, \"mx\": 0, \"my\": 48, \"pal\": 1, \"w\": 32}, \"counter\": {\"h\": 4, \"mx\": 0, \"my\": 55, \"pal\": 4, \"w\": 32}, \"fix_bulb\": {\"h\": 3, \"mx\": 161, \"my\": 48, \"pal\": 1, \"w\": 1}, \"fix_cobweb\": {\"h\": 3, \"mx\": 158, \"my\": 48, \"pal\": 1, \"w\": 3}, \"fix_cracks\": {\"h\": 7, \"mx\": 128, \"my\": 48, \"pal\": 1, \"w\": 23}, \"fix_shelf\": {\"h\": 3, \"mx\": 162, \"my\": 48, \"pal\": 1, \"w\": 9}, \"fix_window\": {\"h\": 4, \"mx\": 151, \"my\": 48, \"pal\": 1, \"w\": 7}, \"logo\": {\"h\": 7, \"mx\": 96, \"my\": 0, \"pal\": 3, \"w\": 32}},\ncolors: {\"GLASS\": 200},\n};\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst POOL = 36, PIC_CRATE = 35, PIC_PEOPLE = 36, PIC_PROP = 52;\nconst SLOT_TILE = Array.from({ length: POOL }, (_, k) => ART.sprites['slot' + k].tile);\nlet slotPic = new Array(POOL).fill(-1), slotAt = new Array(POOL).fill(-1), drawNo = 0, picLoads = 0;\nconst picPal = (p) => rom('pics')[1 + p * 513];\nfunction picSlot(p) {\nlet k = slotPic.indexOf(p);\nif (k < 0) {\nfor (let i = 0; i < POOL; i++) if (slotAt[i] !== drawNo && (k < 0 || slotAt[i] < slotAt[k])) k = i;\nif (k < 0) return -1;\nconst b = rom('pics'), off = 2 + p * 513, t = SLOT_TILE[k], x0 = (t % 16) * 8, y0 = (t >> 4) * 8;\nfor (let y = 0; y < 32; y++) for (let x = 0; x < 32; x += 2) { const v = b[off + y * 16 + (x >> 1)]; sset(x0 + x, y0 + y, v & 15); sset(x0 + x + 1, y0 + y, v >> 4); }\nslotPic[k] = p; picLoads++;\n}\nslotAt[k] = drawNo;\nreturn k;\n}\nfunction drawPic(p, x, y, opts = {}) { const k = picSlot(p); if (k >= 0) spr(SLOT_TILE[k], x, y, { size: 32, pal: picPal(p), prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, knock: 3, pick: 4, drop: 5, pop: 6, merge: 7, sell: 12, crate: 13, find: 14, serve: 15, stars: 16, fanfare: 17, bell: 18 };\nconst SONG = { title: 0, play: 1, ending: 2 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\nconst COLS = 7, ROWS = 5, CELLS = 35, CW = 32, CH = 28, BX = 16, BY = 84;\nconst EMPTY = 0, GEN0 = 31, CRATE = 40;\nconst LINES = ['BAKERY', 'COFFEE', 'DAIRY', 'FRUIT', 'TABLEWARE'];\nconst NAMES = [\n['WHEAT', 'FLOUR', 'DOUGH', 'ROLL', 'LOAF', 'LAYER CAKE'],\n['BEANS', 'GROUND COFFEE', 'ESPRESSO', 'CAPPUCCINO', 'LATTE', 'COFFEE POT SET'],\n['MILK', 'CREAM', 'WHIPPED CREAM', 'ICE CREAM', 'SUNDAE', 'PARFAIT'],\n['CHERRY', 'STRAWBERRIES', 'BERRY BOWL', 'JAM JAR', 'FRUIT TART', 'FRUIT PIE'],\n['SPOON', 'CUP', 'TEAPOT', 'TRAY', 'CAKE STAND', 'TEA SERVICE'],\n];\nconst GEN_NAMES = ['GRAIN SACK', 'COFFEE GRINDER', 'MILK CHURN', 'FRUIT BASKET', 'CUPBOARD'];\nconst TIER2_CHANCE = 0.1, CRATE_BASE = 10, CRATE_STEP = 10, START_COINS = 10;\nconst item = (line, tier) => line * 6 + tier;\nconst isItem = (v) => v >= 1 && v <= 30, isGen = (v) => v >= GEN0 && v < GEN0 + 5;\nconst lineOf = (v) => ((v - 1) / 6) | 0, tierOf = (v) => ((v - 1) % 6) + 1;\nconst nameOf = (v) => (isItem(v) ? NAMES[lineOf(v)][tierOf(v) - 1] : isGen(v) ? GEN_NAMES[v - GEN0] : v === CRATE ? 'CRATE' : '');\nconst valueOf = (v) => (isItem(v) ? tierOf(v) * tierOf(v) : 0);\nconst picOf = (v) => (isItem(v) ? v - 1 : isGen(v) ? 30 + v - GEN0 : v === CRATE ? PIC_CRATE : -1);\nconst colOf = (i) => i % COLS, rowOf = (i) => (i / COLS) | 0, cellX = (i) => BX + colOf(i) * CW, cellY = (i) => BY + rowOf(i) * CH;\nconst crateCost = () => CRATE_BASE + CRATE_STEP * cratesOpened;\nfunction newBoard() {\nconst b = new Array(CELLS).fill(CRATE);\nfor (let i = 0; i < 14; i++) b[i] = EMPTY;\nb[7 + 1] = GEN0; b[7 + 5] = GEN0 + 1; b[2] = item(0, 1); b[4] = item(0, 1);\nreturn b;\n}\nfunction nearestEmpty(b, i) {\nlet best = -1, bd = 99;\nfor (let j = 0; j < CELLS; j++) {\nif (b[j] !== EMPTY) continue;\nconst d = Math.abs(colOf(j) - colOf(i)) + Math.abs(rowOf(j) - rowOf(i));\nif (d < bd) { bd = d; best = j; }\n}\nreturn best;\n}\nfunction dropKind(b, a, t) {\nif (a === t) return 'back';\nconst u = b[t], v = b[a];\nif (u === CRATE) return 'no';\nif (u === EMPTY) return 'move';\nif (u === v) return tierOf(v) < 6 ? 'merge' : 'no';\nreturn 'swap';\n}\nconst crateOpenable = (b, i) => b[i] === CRATE && [[-1, 0], [1, 0], [0, -1], [0, 1]].some(([dc, dr]) => {\nconst c = colOf(i) + dc, r = rowOf(i) + dr;\nreturn c >= 0 && c < COLS && r >= 0 && r < ROWS && b[r * COLS + c] !== CRATE;\n});\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, BOARD_SLOT = 1, COINS_SLOT = 10, STARS_SLOT = 11, TASKS_SLOT = 12, STYLE_SLOT = 13, FOUND_SLOT = 15,\nSERVED_SLOT = 16, CRATES_SLOT = 17, STORY_SLOT = 18, SPOT_SLOT = 20, ARRIVED_SLOT = 23, FLAGS_SLOT = 24;\nconst packSpot = (c) => (c ? (c.who | (c.items[0] << 4) | ((c.items[1] || 0) << 9) | ((c.got[0] ? 1 : 0) << 14) | ((c.got[1] ? 1 : 0) << 15) | ((c.special ? 1 : 0) << 16) | (1 << 17)) : 0);\nconst unpackSpot = (v) => (v & (1 << 17) ? { who: v & 15, items: [(v >> 4) & 31, (v >> 9) & 31].filter((x) => x), got: [!!(v & (1 << 14)), !!(v & (1 << 15))], special: !!(v & (1 << 16)) } : null);\nfunction saveGame() {\nfor (let k = 0; k < 9; k++) {\nlet v = 0;\nfor (let q = 0; q < 4; q++) v |= (board[k * 4 + q] ?? 0) << (8 * q);\ndset(BOARD_SLOT + k, v);\n}\ndset(COINS_SLOT, coins); dset(STARS_SLOT, stars); dset(FOUND_SLOT, found); dset(CRATES_SLOT, cratesOpened);\ndset(TASKS_SLOT, tasks); dset(STYLE_SLOT, styles[0]); dset(STYLE_SLOT + 1, styles[1]); dset(SERVED_SLOT, served);\nlet st = 0; for (let k = 0; k < 5; k++) st |= story[k] << (3 * k);\ndset(STORY_SLOT, st);\nfor (let k = 0; k < 3; k++) dset(SPOT_SLOT + k, packSpot(spots[k]));\ndset(ARRIVED_SLOT, arrived); dset(FLAGS_SLOT, (specialDue ? 1 : 0) | (reopened ? 2 : 0));\n}\nfunction loadGame() {\nboard = [];\nfor (let i = 0; i < CELLS; i++) board.push((dget(BOARD_SLOT + (i >> 2)) >>> (8 * (i & 3))) & 255);\ncoins = dget(COINS_SLOT); stars = dget(STARS_SLOT); found = dget(FOUND_SLOT); cratesOpened = dget(CRATES_SLOT);\ntasks = dget(TASKS_SLOT); styles = [dget(STYLE_SLOT), dget(STYLE_SLOT + 1)]; served = dget(SERVED_SLOT);\nconst st = dget(STORY_SLOT); story = [0, 1, 2, 3, 4].map((k) => (st >> (3 * k)) & 7);\nspots = [0, 1, 2].map((k) => unpackSpot(dget(SPOT_SLOT + k)));\narrived = dget(ARRIVED_SLOT); const f = dget(FLAGS_SLOT); specialDue = !!(f & 1); reopened = !!(f & 2);\nnextAt = [0, 0, 0]; spots.forEach((c, k) => { if (c) setPersonPal(k, c.who); });\napplyCafe();\n}\nconst hasSave = () => dget(VERSION_SLOT) === SAVE_VERSION && dget(BOARD_SLOT + 2) !== 0;\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst stepped = (b) => pressed(b) || (btnp(b) && (inputMask & (1 << b)) !== 0);\nconst PEOPLE = ['MARION', 'JAMES', 'BENNY', 'GINA', 'MR. FISK', 'A STUDENT', 'A LAWYER', 'A TOURIST'];\nconst SPOT_X = [40, 112, 184], SPOT_Y = 26, BUBBLE_TX = [9, 18, 27], SPOT_COL = [2, 4, 6];\nconst ARRIVE = 180, REGULAR_EVERY = 3, SPECIAL_EVERY = 10, SWAP_WAIT = 1800, TWO_ITEMS = 0.3;\nconst TIER_TOP = [3, 4, 5, 6, 6, 6, 6], TIER_LOW = [1, 1, 1, 2, 2, 3, 3];\nconst STORIES = [\n['I BAKED IN THIS VERY ROOM, FORTY YEARS AGO.', 'THE OVEN USED TO SING WHEN THE BREAD WAS DONE.', 'MY HUSBAND PROPOSED OVER A CINNAMON ROLL HERE.', 'I KEPT THE OLD RECIPE BOOK. IT IS YOURS NOW.', 'THE SMELL OF BREAD IS BACK ON THIS STREET.', 'YOU HAVE MADE AN OLD BAKER VERY HAPPY, DEAR.'],\n['NIGHT SHIFT AGAIN. COFFEE, PLEASE. STRONG.', 'TWELVE HOURS ON THE WARD. THIS CUP SAVES ME.', 'A PATIENT ASKED WHERE I GET MY COFFEE. HERE!', 'I SLEPT A WHOLE NIGHT. FIRST TIME IN MONTHS.', 'THE WARD GOT ME A CARD. IT SAYS: SEE YOU AT THE CAFE.', 'THIS PLACE FEELS LIKE A SECOND HOME NOW.'],\n['MUM SAYS ONE ICE CREAM. ONE. BIG ONE?', 'I DREW YOUR CAFE AT SCHOOL. IT HAS A DRAGON.', 'MY TOOTH FELL OUT! I CAN EAT ICE CREAM WITH THE GAP.', 'I SAVED MY POCKET MONEY FOR A SUNDAE.', 'CAN I HAVE MY BIRTHDAY PARTY HERE? PLEASE?', 'BEST. CAFE. EVER. I MEAN IT.'],\n['MY STALL IS ACROSS THE SQUARE. TRY MY CHERRIES!', 'THE STRAWBERRIES CAME IN SWEET THIS YEAR.', 'I SELL MORE FRUIT SINCE YOUR TARTS GOT FAMOUS.', 'MY DAUGHTER WANTS TO LEARN TO BAKE PIES. FROM YOU.', 'THE WHOLE MARKET TALKS ABOUT YOUR JAM.', 'GROWING THINGS AND SHARING THEM. THAT IS LIFE.'],\n['HM. A CHIPPED CUP. I SHALL ALLOW IT. ONCE.', 'I HAVE COLLECTED TEACUPS FOR FIFTY-ONE YEARS.', 'THIS PATTERN IS 1920S. YOU HAVE AN EYE.', 'I MAY HAVE SMILED. DO NOT TELL ANYONE.', 'I BROUGHT YOU A CUP FROM MY COLLECTION. KEEP IT.', 'A PROPER CAFE AT LAST. THANK YOU, TRULY.'],\n];\nconst areasDone = () => { let a = 0; while (a < 6 && ((tasks >> (a * 4)) & 15) === 15) a++; return a; };\nconst linesOpen = () => Math.min(5, 2 + areasDone());\nfunction makeOrder(who, special) {\nconst a = areasDone(), top = TIER_TOP[a], low = TIER_LOW[a];\nconst pick = (line) => { let t = who < 5 ? top : low + Math.floor((rnd(top - low + 1) + rnd(top - low + 1)) / 2); if (special) t += 2; return item(line, clamp(t, 1, 6)); };\nconst items = [pick(who < 5 ? who : rndi(0, linesOpen() - 1))];\nif (who >= 5 && !special && a >= 2 && rnd(1) < TWO_ITEMS) items.push(pick(rndi(0, linesOpen() - 1)));\nreturn { who, items, got: items.map(() => false), special };\n}\nfunction arrive(k) {\narrived++;\nconst regs = Math.min(5, linesOpen());\nconst who = arrived % REGULAR_EVERY === 0 && !spots.some((c) => c && c.who < 5 && c.who === ((arrived / REGULAR_EVERY) | 0) % regs) ? ((arrived / REGULAR_EVERY) | 0) % regs : 5 + rndi(0, 2);\nspots[k] = makeOrder(who, specialDue); specialDue = false;\nsetPersonPal(k, who); saveGame();\nif (doneKind('bell')) fx(SFX.bell);\n}\nfunction reward(c) {\nconst v = c.items.reduce((s, x) => s + valueOf(x), 0), t = c.items.reduce((s, x) => s + tierOf(x), 0);\nlet cn = v, st = t <= 4 ? 1 : t <= 7 ? 2 : 3;\nif (c.who < 5) st += 1;\nif (c.special) { cn *= 2; st *= 2; }\nreturn { coins: cn, stars: st };\n}\nfunction hand(k) {\nconst c = spots[k], v = board[held];\nconst n = c ? c.items.findIndex((x, i) => x === v && !c.got[i]) : -1;\nif (n < 0) { say(c ? 'NOT WHAT THEY ORDERED' : 'NOBODY HERE YET', ORANGE); fx(SFX.knock); return false; }\nc.got[n] = true; board[held] = EMPTY; held = -1; fx(SFX.drop);\nif (c.got.every((g) => g)) serve(k); else saveGame();\nreturn true;\n}\nfunction serve(k) {\nconst c = spots[k], r = reward(c);\ncoins += r.coins; stars += r.stars; served++;\nif (served % SPECIAL_EVERY === 0) specialDue = true;\nfx(SFX.serve); say(`+${r.coins} COINS  +${r.stars} STAR${r.stars > 1 ? 'S' : ''}`, GOLD);\nif (c.who < 5 && story[c.who] < 6) { storyCard = { who: c.who, text: STORIES[c.who][story[c.who]] }; story[c.who]++; }\nspots[k] = null; nextAt[k] = clock + ARRIVE;\nsaveGame();\n}\nfunction swapOrder(k) {\nif (!spots[k]) return false;\nif (clock < swapAt) { say(`A NEW ORDER IN ${Math.ceil((swapAt - clock) / 60)} S`, ORANGE); fx(SFX.knock); return false; }\nspots[k] = makeOrder(spots[k].who, spots[k].special); swapAt = clock + SWAP_WAIT; fx(SFX.select); saveGame();\nreturn true;\n}\nfunction setPersonPal(k, who) {\nconst b = rom('people');\nfor (let i = 0; i < 15; i++) { const v = b[who * 30 + i * 2] | (b[who * 30 + i * 2 + 1] << 8); color(128 + 16 * (5 + k) + 1 + i, v & 31, (v >> 5) & 31, v >> 10); }\n}\nconst onBoard = (v) => board.some((x, i) => x === v && i !== held);\nconst AREAS = [\n['THE COUNTER', [['MEND THE COUNTER', 'counter', ['OAK', 'WALNUT', 'MINT']], ['A COFFEE MACHINE', 'machine', ['COPPER', 'CHROME']], ['A CAKE DISPLAY', 'cake', null], ['A CASH REGISTER', 'register', null]]],\n['THE WALLS', [['PATCH THE CRACKS', 'fix:cracks', null], ['PAINT THE WALLS', 'wall', ['SAGE', 'BUTTER', 'ROSE']], ['STAIN THE WOOD', 'wood', ['HONEY', 'WALNUT', 'WHITE']], ['A MENU BOARD', 'menu', null]]],\n['THE WINDOW', [['NEW GLASS', 'fix:window', null], ['CURTAINS', 'curtains', ['STRIPES', 'LACE']], ['A FLOWER BOX', 'flowerbox', null], ['AN OPEN SIGN', 'sign', null]]],\n['THE LIGHTS', [['SWEEP THE COBWEBS', 'fix:cobweb', null], ['A NEW LAMP', 'lamp', ['BRASS', 'GLASS']], ['FAIRY LIGHTS', 'fairy', null], ['A PLANT', 'plant', null]]],\n['THE SHELF', [['FIX THE SHELF', 'fix:shelf', null], ['JARS OF SWEETS', 'jars', null], ['A CLOCK', 'clock', null], ['PICTURES', 'pictures', ['FLOWERS', 'THE SEA']]]],\n['THE REOPENING', [['A RECORD PLAYER', 'record', null], ['BUNTING', 'bunting', null], ['A DOORBELL', 'bell', null], ['THE GRAND REOPENING', 'reopen', null]]],\n];\nconst TASK_COST = [8, 12, 16, 24, 32, 40], AREA_COINS = 20;\nconst FIX = ['cracks', 'window', 'cobweb', 'bulb', 'shelf'];\nconst WALL = { shabby: null, SAGE: [17, 25, 19], BUTTER: [28, 25, 15], ROSE: [27, 19, 19] };\nconst WOOD = { shabby: null, HONEY: [22, 14, 7], WALNUT: [12, 7, 4], WHITE: [26, 25, 23] };\nconst COUNTER = { shabby: null, OAK: [24, 16, 9], WALNUT: [13, 8, 5], MINT: [16, 26, 21] };\nconst PROP = { machine: [0, 1], register: [2], curtains: [3, 4], flowerbox: [5], lamp: [6, 7], plant: [8], jars: [9], record: [10] };\nconst taskDone = (a, t) => !!(tasks & (1 << (a * 4 + t)));\nconst styleOf = (a, t) => (styles[(a * 4 + t) >> 4] >> (((a * 4 + t) & 15) * 2)) & 3;\nfunction setStyle(a, t, v) { const n = a * 4 + t, w = n >> 4, sh = (n & 15) * 2; styles[w] = (styles[w] & ~(3 << sh)) | (v << sh); }\nfunction taskOf(kind) { for (let a = 0; a < 6; a++) for (let t = 0; t < 4; t++) if (AREAS[a][1][t][1] === kind) return [a, t]; return null; }\nconst doneKind = (kind) => { const at = taskOf(kind); return at && taskDone(at[0], at[1]); };\nconst styleName = (kind) => { const at = taskOf(kind); return at && doneKind(kind) ? AREAS[at[0]][1][at[1]][2][styleOf(at[0], at[1])] : 'shabby'; };\nfunction buyTask(t) {\nconst a = areasDone();\nif (a >= 6 || taskDone(a, t)) return false;\nif (stars < TASK_COST[a]) { say(`IT NEEDS ${TASK_COST[a]} STARS`, ORANGE); fx(SFX.knock); return false; }\nstars -= TASK_COST[a]; tasks |= 1 << (a * 4 + t); fx(SFX.fanfare);\napplyCafe();\nif (areasDone() > a) {\ncoins += AREA_COINS;\nconst line = linesOpen() - 1, newLine = a + 2 < 5;\nstoryCard = { who: -1, text: a === 5 ? '' : `${AREAS[a][0]} ${a === 0 ? 'SHINES' : 'LOOK LOVELY'}! +${AREA_COINS} COINS` + (newLine ? `. NEW ON THE BOARD: THE ${GEN_NAMES[line]}, AND ${PEOPLE[line]} COMES IN.` : '.') };\nif (a === 5) { reopened = true; state = 'ending'; timer = 0; storyCard = null; play(SONG.ending); }\n}\nsaveGame();\nreturn true;\n}\nconst rampOf = (c, n) => Array.from({ length: n }, (_, i) => { const k = 0.55 + 0.6 * i / Math.max(1, n - 1); return c.map((v) => clamp(Math.round(v * k + (k > 1 ? (k - 1) * 12 : 0)), 0, 31)); });\nlet shabbyMap = null, shabbyCols = null;\nfunction applyCafe() {\nconst fx_ = rom('fixes'), cf = ART.scenes.cafe;\nif (!shabbyMap) {\nshabbyMap = []; for (let y = 0; y < 7; y++) for (let x = 0; x < 32; x++) shabbyMap.push(mget(cf.mx + x, cf.my + y));\nshabbyCols = []; for (let e = 17; e <= 29; e++) shabbyCols[e] = color(e); for (let e = 65; e <= 71; e++) shabbyCols[e] = color(e);\n}\nfor (let y = 0; y < 7; y++) for (let x = 0; x < 32; x++) mset(cf.mx + x, cf.my + y, shabbyMap[y * 32 + x]);\nFIX.forEach((f, k) => {\nconst on = f === 'bulb' ? doneKind('lamp') : doneKind('fix:' + f);\nif (!on) return;\nconst o = 1 + k * 6, [x0, y0, w, h, sx, sy] = [0, 1, 2, 3, 4, 5].map((q) => fx_[o + q]);\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) mset(cf.mx + x0 + x, cf.my + y0 + y, mget(sx + x, sy + y));\n});\nconst put = (first, n, c) => { const r = c ? rampOf(c, n) : null; for (let i = 0; i < n; i++) { const v = r ? r[i] : shabbyCols[first + i]; color(first + i, v[0], v[1], v[2]); } };\nput(17, 3, WALL[styleName('wall')]); put(20, 4, WOOD[styleName('wood')]); put(65, 4, COUNTER[styleName('counter')]);\nif (doneKind('fix:window')) { color(24, 18, 24, 27); color(25, 22, 27, 29); color(26, 29, 31, 31); } else for (let e = 24; e <= 26; e++) { const v = shabbyCols[e]; color(e, v[0], v[1], v[2]); }\n}\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0, titleSel = 0, pauseSel = 0, confirm = null;\nlet board = [], coins = 0, stars = 0, found = 0, cratesOpened = 0, tasks = 0, styles = [0, 0], served = 0, story = [0, 0, 0, 0, 0];\nlet spots = [null, null, null], nextAt = [0, 0, 0], arrived = 0, specialDue = false, reopened = false, swapAt = 0, storyCard = null;\nlet cur = 17, held = -1, card = -1, orderCard = -1, ask = null, msg = '', msgAt = -999, msgC = WHITE;\nlet anims = [], sparks = [], cafeSel = 0, cafePage = 0, recSel = 0;\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\nconst bd = ART.scenes.board, cf = ART.scenes.cafe, lg = ART.scenes.logo;\nbg(0, { mx: bd.mx, my: bd.my, mw: bd.w, mh: bd.h, x: 0, y: 0, wrap: false, show: true });\nbg(1, { mx: cf.mx, my: cf.my, mw: cf.w, mh: 11, x: 0, y: 0, wrap: false, show: true });\nbg(2, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -92, wrap: false, show: false });\ncolor(CREAM, 30, 27, 20); color(SOLID, 3, 8, 7); color(CHALK, 7, 15, 13); color(0, 7, 4, 3);\nblend({ layers: ['overlay'], half: true });\napplyCafe();\nif (skipTitle) { if (hasSave()) loadGame(); else newCafe(); toPlay(); } else toTitle();\n}\nfunction newCafe() {\nboard = newBoard(); coins = START_COINS; stars = 0; found = 0; cratesOpened = 0;\ntasks = 0; styles = [0, 0]; served = 0; story = [0, 0, 0, 0, 0]; arrived = 0; specialDue = false; reopened = false; swapAt = 0; storyCard = null;\nspots = [null, null, null]; nextAt = [0, 40, 80];\nmarkFound(item(0, 1), true);\napplyCafe(); saveGame();\n}\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; confirm = null; play(SONG.title); }\nfunction toPlay() { state = 'play'; timer = 0; paused = false; held = -1; card = orderCard = -1; ask = null; anims = []; if (cur < 0) cur = 17; play(SONG.play); spots.forEach((c, k) => { if (c) setPersonPal(k, c.who); }); }\nfunction say(text, c = WHITE) { msg = text; msgAt = clock; msgC = c; }\nfunction markFound(v, quiet = false) {\nif (!isItem(v)) return;\nconst bit = 1 << (v - 1);\nif (found & bit) return;\nfound |= bit;\nif (!quiet) { stars++; say('NEW: ' + nameOf(v) + '  +1 STAR', GOLD); fx(SFX.find); }\n}\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'play') updatePlay();\nelse if (state === 'cafe') updateCafe();\nelse if (state === 'recipes') updateRecipes();\nelse if (state === 'ending') updateEnding();\nprevMask = inputMask;\n}\nfunction updateTitle() {\nif (confirm) {\nif (pressed(A)) { fx(SFX.select); newCafe(); toPlay(); } else if (pressed(B)) { fx(SFX.move); confirm = null; }\nreturn;\n}\nconst n = hasSave() ? 3 : 2;\nif (pressed(UP)) { titleSel = (titleSel + n - 1) % n; fx(SFX.move); }\nif (pressed(DOWN)) { titleSel = (titleSel + 1) % n; fx(SFX.move); }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nconst cont = hasSave(), item_ = cont ? ['continue', 'new', 'recipes'][titleSel] : ['new', 'recipes'][titleSel];\nif (item_ === 'continue') { loadGame(); toPlay(); }\nelse if (item_ === 'new') { if (cont) confirm = 'new'; else { newCafe(); toPlay(); } }\nelse { if (cont) loadGame(); toRecipes('title'); }\n}\n}\nfunction press(i) {\nconst v = board[i];\nif (held >= 0) { drop(held, i); return; }\nif (isGen(v)) { generate(i); return; }\nif (isItem(v)) { held = i; fx(SFX.pick); return; }\nif (v === CRATE) {\nif (!crateOpenable(board, i)) { say('OPEN THE CRATES NEXT TO YOUR SPACE FIRST', ORANGE); fx(SFX.knock); return; }\nif (ask && ask.kind === 'crate' && ask.i === i) {\nask = null;\nif (coins < crateCost()) { say(`A CRATE COSTS ${crateCost()} COINS`, ORANGE); fx(SFX.knock); return; }\ncoins -= crateCost(); cratesOpened++; board[i] = EMPTY; fx(SFX.crate); burst(i); saveGame();\n} else ask = { kind: 'crate', i };\n}\n}\nfunction generate(g) {\nconst to = nearestEmpty(board, g);\nif (to < 0) { say('NO ROOM ON THE BOARD', ORANGE); fx(SFX.knock); return -1; }\nconst line = board[g] - GEN0, v = item(line, rnd(1) < TIER2_CHANCE ? 2 : 1);\nboard[to] = v; markFound(v); fx(SFX.pop);\nanims.push({ i: to, from: g, at: clock });\nsaveGame();\nreturn to;\n}\nfunction drop(a, t) {\nconst k = dropKind(board, a, t), v = board[a];\nheld = -1;\nif (k === 'back') { fx(SFX.drop); return k; }\nif (k === 'no') { held = a; fx(SFX.knock); return k; }\nif (k === 'move') { board[t] = v; board[a] = EMPTY; fx(SFX.drop); }\nelse if (k === 'swap') { board[a] = board[t]; board[t] = v; fx(SFX.drop); }\nelse { board[t] = v + 1; board[a] = EMPTY; fx(SFX.merge + tierOf(v + 1) - 2); burst(t); markFound(v + 1); }\nsaveGame();\nreturn k;\n}\nfunction sell(i) {\nconst v = board[i];\nif (!isItem(v)) return 0;\ncoins += valueOf(v); board[i] = EMPTY; fx(SFX.sell); say(`SOLD ${nameOf(v)}: +${valueOf(v)} COIN${valueOf(v) > 1 ? 'S' : ''}`, GOLD); saveGame();\nreturn valueOf(v);\n}\nfunction burst(i) { for (let k = 0; k < 6; k++) sparks.push({ x: cellX(i) + 16, y: cellY(i) + 13, a: k * Math.PI / 3 + clock * 0.3, at: clock }); }\nfunction placeGenerators() {\nfor (let line = 0; line < linesOpen(); line++) {\nif (board.includes(GEN0 + line)) continue;\nconst at = nearestEmpty(board, 17);\nif (at < 0) return;\nboard[at] = GEN0 + line; fx(SFX.pop); burst(at); saveGame();\n}\n}\nfunction updatePlay() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nfor (let k = 0; k < 3; k++) if (!spots[k] && clock >= nextAt[k]) arrive(k);\nplaceGenerators();\nif (storyCard) { if (pressed(A) || pressed(B)) { storyCard = null; fx(SFX.move); } return; }\nif (ask) {\nif (pressed(A)) { const q = ask; if (q.kind === 'sell') { ask = null; sell(q.i); } else press(q.i); return; }\nif (pressed(B) || stepped(UP) || stepped(DOWN) || stepped(LEFT) || stepped(RIGHT) || pressed(SELECT)) { ask = null; fx(SFX.move); }\nreturn;\n}\nif (card !== -1 || orderCard !== -1) { if (pressed(A) || pressed(B) || pressed(SELECT)) card = orderCard = -1; return; }\nif (cur < 0) {\nconst k = -1 - cur;\nif (stepped(LEFT) && k > 0) { cur++; fx(SFX.move); }\nif (stepped(RIGHT) && k < 2) { cur--; fx(SFX.move); }\nif (stepped(DOWN)) { cur = SPOT_COL[k]; fx(SFX.move); }\nif (pressed(A)) { if (held >= 0) hand(k); else if (spots[k]) orderCard = k; }\nelse if (pressed(B)) { if (held >= 0) { held = -1; fx(SFX.drop); } else if (spots[k]) orderCard = k; }\nelse if (pressed(SELECT)) swapOrder(k);\nreturn;\n}\nconst c = colOf(cur), r = rowOf(cur);\nif (stepped(LEFT) && c > 0) { cur--; fx(SFX.move); }\nif (stepped(RIGHT) && c < COLS - 1) { cur++; fx(SFX.move); }\nif (stepped(UP)) { if (r > 0) cur -= COLS; else cur = -1 - (c <= 2 ? 0 : c <= 4 ? 1 : 2); fx(SFX.move); }\nif (stepped(DOWN) && r < ROWS - 1) { cur += COLS; fx(SFX.move); }\nif (pressed(A)) press(cur);\nelse if (pressed(B)) { if (held >= 0) { held = -1; fx(SFX.drop); } else if (board[cur] !== EMPTY) card = cur; }\nelse if (pressed(SELECT) && held < 0) { if (isItem(board[cur])) ask = { kind: 'sell', i: cur }; else fx(SFX.knock); }\n}\nfunction toCafe() { state = 'cafe'; timer = 0; paused = false; cafePage = Math.min(5, areasDone()); cafeSel = 0; }\nfunction updateCafe() {\nconst a = cafePage, row = cafeSel;\nif (pressed(B) || pressed(START)) { fx(SFX.move); toPlay(); return; }\nif (storyCard) { if (pressed(A)) { storyCard = null; fx(SFX.move); } return; }\nif (pressed(UP) && row > -1) { cafeSel--; fx(SFX.move); }\nif (pressed(DOWN) && row < 3) { cafeSel++; fx(SFX.move); }\nif (row === -1) {\nif (pressed(LEFT) && a > 0) { cafePage--; fx(SFX.move); }\nif (pressed(RIGHT) && a < Math.min(5, areasDone())) { cafePage++; fx(SFX.move); }\nreturn;\n}\nconst task = AREAS[a][1][row], sty = task[2];\nif (taskDone(a, row) && sty && (pressed(LEFT) || pressed(RIGHT))) {\nsetStyle(a, row, (styleOf(a, row) + (pressed(RIGHT) ? 1 : sty.length - 1)) % sty.length); applyCafe(); saveGame(); fx(SFX.select);\n} else if (pressed(A) && !taskDone(a, row)) {\nif (a !== areasDone()) { say('FINISH THE AREA BEFORE IT', ORANGE); fx(SFX.knock); return; }\nif (buyTask(row) && state === 'cafe' && areasDone() > a && a < 5) { cafePage = areasDone(); cafeSel = 0; }\n}\n}\nfunction toRecipes(from) { state = 'recipes'; timer = 0; paused = false; recFrom = from; recSel = 0; for (let i = 1; i <= 15; i++) color(128 + 16 * 7 + i, 4, 3, 3); }\nlet recFrom = 'play';\nconst isFound = (v) => !!(found & (1 << (v - 1)));\nconst recState = (line, tier) => { const v = item(line, tier); if (isFound(v)) return 2; return tier === 1 || isFound(v - 1) ? 1 : 0; };\nfunction updateRecipes() {\nif (stepped(LEFT) && recSel % 6 > 0) { recSel--; fx(SFX.move); }\nif (stepped(RIGHT) && recSel % 6 < 5) { recSel++; fx(SFX.move); }\nif (stepped(UP) && recSel >= 6) { recSel -= 6; fx(SFX.move); }\nif (stepped(DOWN) && recSel < 24) { recSel += 6; fx(SFX.move); }\nif (pressed(B) || pressed(A) || pressed(START)) {\nfx(SFX.move); spots.forEach((c, k) => { if (c) setPersonPal(k, c.who); });\nif (recFrom === 'title') toTitle(); else toPlay();\n}\n}\nfunction updateEnding() {\nif (timer > 120 && (pressed(A) || pressed(START))) { fx(SFX.select); toPlay(); say('THE CAFE IS OPEN! ORDERS NEVER STOP NOW', GOLD); }\n}\nfunction updatePause() {\nif (confirm) { if (pressed(A)) { fx(SFX.select); newCafe(); toPlay(); } else if (pressed(B)) confirm = null; return; }\nconst n = 4;\nif (pressed(UP)) { pauseSel = (pauseSel + n - 1) % n; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % n; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) toCafe();\nelse if (pauseSel === 2) toRecipes('play');\nelse { saveGame(); toTitle(); }\n}\n}\nfunction draw() {\ncls(); drawNo++;\nconst boardOn = state === 'play' || state === 'recipes';\nbg(0, { show: boardOn }); bg(2, { show: state === 'title' });\nsyncBubbles();\nif (state === 'play') { drawBoard(); drawOrders(); }\nif (state === 'recipes') drawRecipes();\nelse drawPeople();\ndrawProps();\nif (state === 'play') drawHud();\nelse if (state === 'title') drawTitle();\nelse if (state === 'cafe') drawCafeScreen();\nelse if (state === 'ending') drawEnding();\nif (storyCard) drawStory();\nif (paused) drawPause();\n}\nlet bubbleOn = [false, false, false];\nfunction syncBubbles() {\nconst bd = ART.scenes.board, bb = ART.scenes.bubble;\nfor (let k = 0; k < 3; k++) {\nconst on = state === 'play' && !!spots[k];\nif (on === bubbleOn[k]) continue;\nbubbleOn[k] = on;\nfor (let y = 0; y < bb.h; y++) for (let x = 0; x < bb.w; x++) mset(bd.mx + BUBBLE_TX[k] + x, bd.my + y, on ? mget(bb.mx + x, bb.my + y) : 0);\n}\n}\nfunction drawPeople() {\nfor (let k = 0; k < 3; k++) {\nconst c = spots[k];\nif (!c || state === 'title') continue;\nconst blink = ((clock + k * 77) % 240) < 8;\ndrawPic(PIC_PEOPLE + c.who * 2 + (blink ? 1 : 0), SPOT_X[k], SPOT_Y, { prio: 1, pal: 5 + k });\n}\n}\nfunction drawOrders() {\nfor (let k = 0; k < 3; k++) {\nconst c = spots[k];\nif (!c) continue;\nconst want = c.items.filter((v, i) => !c.got[i]), v = want[((clock / 60) | 0) % want.length], x = BUBBLE_TX[k] * 8;\ndrawPic(picOf(v), x, -2, { prio: 3 });\nif (onBoard(v)) { line(x + 24, 20, x + 26, 22, GREEN); line(x + 26, 22, x + 30, 16, GREEN); }\nif (c.items.length > 1) print(`${c.got.filter((g) => g).length + 1}/${c.items.length}`, x + 2, 2, SHADOW);\nif (c.special) { rect(x, 0, 32, 26, GOLD); if ((clock >> 4) & 1) print('SPECIAL', x - 12, 26, GOLD); }\n}\n}\nfunction drawProps() {\nif (state === 'recipes') return;\nconst prop = (kind, x, y, opts = {}) => { if (!doneKind(kind)) return; const at = taskOf(kind), list = PROP[kind]; drawPic(PIC_PROP + list[Math.min(list.length - 1, styleOf(at[0], at[1]))], x, y, { prio: 1, ...opts }); };\nprop('machine', 82, 30); prop('register', 152, 30); prop('record', 222, 30);\nif (doneKind('cake')) drawPic(picOf(item(0, 6)), 220 - 72, 30 - 1, { prio: 1 });\nprop('curtains', 6, 2); prop('curtains', 50, 2, { fx: true }); prop('flowerbox', 28, 14);\nprop('lamp', 124, -6); prop('plant', 226, -5); prop('jars', 182, -5);\nif (doneKind('menu')) { rectfill(96, 62, 64, 21, SOLID); rect(96, 62, 64, 21, CHALK); print('TODAY:', 104, 64, WHITE); print(served % 2 ? 'TARTS' : 'LATTES', 104, 74, GOLD); }\nif (doneKind('sign')) { rectfill(22, 14, 18, 8, 6); print('OPEN', 23, 15, WHITE); }\nif (doneKind('clock')) { circfill(196, 12, 7, 15); circ(196, 12, 7, 4); line(196, 12, 196, 7, 1); line(196, 12, 196 + Math.round(4 * Math.cos(clock / 600)), 12 + Math.round(4 * Math.sin(clock / 600)), 1); }\nif (doneKind('pictures')) { const sea = styleName('pictures') === 'THE SEA'; for (const x of [100, 156]) { rectfill(x, 6, 12, 10, 4); rectfill(x + 2, 8, 8, 6, sea ? 13 : 11); if (!sea) pset(x + 5, 10, 8); } }\nif (doneKind('fairy')) for (let x = 4; x < 256; x += 10) pset(x, 3 + Math.round(2 * Math.sin(x / 9)), [14, 8, 11, 13][((x / 10 | 0) + (clock >> 4)) % 4]);\nif (doneKind('bunting')) for (let x = 0; x < 256; x += 12) { const c = [8, 14, 11, 13][(x / 12) % 4]; line(x, 0, x + 6, 6, c); line(x + 6, 6, x + 12, 0, c); line(x + 3, 2, x + 9, 2, c); }\n}\nfunction drawBoard() {\nconst now = clock;\nfor (let i = 0; i < CELLS; i++) {\nconst v = board[i];\nif (v === EMPTY || i === held) continue;\nconst an = anims.find((a) => a.i === i && now - a.at < 10);\nlet x = cellX(i), y = cellY(i) - 1;\nif (an) { const k = (now - an.at) / 10; x = lerp(cellX(an.from), x, k); y = lerp(cellY(an.from), y, k) - Math.sin(k * Math.PI) * 10; }\ndrawPic(picOf(v), flr(x), flr(y), { prio: 2 });\n}\nanims = anims.filter((a) => now - a.at < 10);\nconst bob = (clock >> 4) & 1, cx = cur < 0 ? BUBBLE_TX[-1 - cur] * 8 : cellX(cur), cy = cur < 0 ? -1 : cellY(cur) - 2;\nsprite(ART.sprites[bob ? 'cursor1' : 'cursor0'], cx, cy, { prio: 3 });\nif (held >= 0) drawPic(picOf(board[held]), cx, cy - 7 - bob + (cur < 0 ? 30 : 0), { prio: 3 });\nsparks = sparks.filter((s) => clock - s.at < 14);\nfor (const s of sparks) { const d = 4 + (clock - s.at) * 1.5; sprite(ART.sprites.spark, flr(s.x + d * Math.cos(s.a) - 4), flr(s.y + d * Math.sin(s.a) - 4)); }\n}\nfunction drawHud() {\nconst cs = `COINS ${coins}`, st = `STARS ${stars}`;\nrectfill(1, 62, cs.length * 8 + 6, 12, SOLID); txt(cs, 4, 64, GOLD);\nrectfill(249 - st.length * 8, 62, st.length * 8 + 6, 12, SOLID); txt(st, 252 - st.length * 8, 64, CREAM);\nconst a = areasDone();\nif (a < 6 && stars >= TASK_COST[a] && ((clock >> 5) & 1)) { rectfill(1, 74, 94, 10, SOLID); txt('START: CAFE', 4, 75, GOLD); }\nif (ask) {\nconst v = board[ask.i];\npanel(24, 120, 208, 40);\nctxt(ask.kind === 'sell' ? `SELL ${nameOf(v)} FOR ${valueOf(v)}?` : `OPEN THIS CRATE FOR ${crateCost()}?`, 130, WHITE);\nctxt('A: YES   B: NO', 144, DIM);\n} else if (orderCard >= 0 && spots[orderCard]) drawOrderCard(spots[orderCard]);\nelse if (card >= 0) drawCard(board[card]);\nelse if (clock - msgAt < 100) { const w = msg.length * 8 + 12; rectfill(128 - w / 2, 74, w, 10, SOLID); ctxt(msg, 75, msgC); }\n}\nfunction drawCard(v) {\npanel(24, 96, 208, 72);\nctxt(nameOf(v), 104, GOLD);\nif (isItem(v)) {\nctxt(`${LINES[lineOf(v)]}, TIER ${tierOf(v)} OF 6`, 118, DIM);\nctxt(tierOf(v) < 6 ? `TWO MAKE ${NAMES[lineOf(v)][tierOf(v)]}` : 'THE BEST OF ITS LINE', 132, WHITE);\nctxt(`SELLS FOR ${valueOf(v)} (SELECT)`, 146, DIM);\n} else if (isGen(v)) { ctxt(`A: MAKE ${NAMES[v - GEN0][0]}`, 122, WHITE); ctxt('NO LIMIT: MIND THE SPACE', 138, DIM); }\nelse if (v === CRATE) { ctxt(`A: OPEN IT FOR ${crateCost()} COINS`, 122, WHITE); ctxt('ONLY NEXT TO OPEN SPACE', 138, DIM); }\n}\nfunction drawOrderCard(c) {\nconst r = reward(c);\npanel(16, 96, 224, 80);\nctxt(`${PEOPLE[c.who]}${c.special ? ': THE DAILY SPECIAL' : c.who < 5 ? ': A FAVOURITE' : ''}`, 104, GOLD);\nc.items.forEach((v, i) => ctxt(`${c.got[i] ? 'GOT ' : ''}${nameOf(v)}`, 118 + i * 11, c.got[i] ? DIM : WHITE));\nctxt(`PAYS ${r.coins} COINS, ${r.stars} STAR${r.stars > 1 ? 'S' : ''}`, 144, CREAM);\nctxt('SELECT: ANOTHER ORDER', 158, DIM);\n}\nfunction drawStory() {\npanel(8, 88, 240, 64);\nconst c = storyCard;\nif (c.who >= 0) ctxt(PEOPLE[c.who] + ' SAYS', 96, GOLD);\nconst words = c.text.split(' '), lines = [''];\nfor (const w of words) { if ((lines[lines.length - 1] + ' ' + w).trim().length > 28) lines.push(''); lines[lines.length - 1] = (lines[lines.length - 1] + ' ' + w).trim(); }\nlines.forEach((l, i) => ctxt(l, (c.who >= 0 ? 110 : 100) + i * 11, WHITE));\nif ((clock >> 4) & 1) ctxt('A', 140, DIM);\n}\nfunction drawCafeScreen() {\nconst a = cafePage, done = areasDone();\npanel(8, 88, 240, 128);\ntxt(`${cafeSel === -1 ? '<' : ' '} ${AREAS[a][0]} ${cafeSel === -1 ? '>' : ' '}`, 16, 96, cafeSel === -1 ? WHITE : GOLD);\ntxt(`STARS ${stars}`, 240 - `STARS ${stars}`.length * 8, 96, CREAM);\nAREAS[a][1].forEach(([name, kind, sty], t) => {\nconst y = 116 + t * 18, on = t === cafeSel, d = taskDone(a, t);\nif (on) rectfill(12, y - 3, 232, 14, PANEL);\ntxt(name, 20, y, d ? GREEN : a === done ? WHITE : DIM);\nif (d && sty) { const s = `< ${sty[styleOf(a, t)]} >`; txt(s, 240 - s.length * 8, y, on ? GOLD : CREAM); }\nelse if (d) txt('DONE', 208, y, GREEN);\nelse { const s = `${TASK_COST[a]} STARS`; txt(s, 240 - s.length * 8, y, stars >= TASK_COST[a] && a === done ? GOLD : DIM); }\n});\nctxt(cafeSel >= 0 && taskDone(a, cafeSel) && AREAS[a][1][cafeSel][2] ? 'LEFT, RIGHT: CHOOSE A STYLE' : 'A: DO IT   B: BACK', 196, DIM);\nif (clock - msgAt < 90) ctxt(msg, 184, msgC);\n}\nfunction drawRecipes() {\nfor (let i = 0; i < 30; i++) {\nconst line = (i / 6) | 0, tier = i % 6 + 1, st = recState(line, tier), cell = line * COLS + tier;\nif (st === 2) drawPic(picOf(item(line, tier)), cellX(cell), cellY(cell) - 1, { prio: 2 });\nelse if (st === 1) drawPic(picOf(item(line, tier)), cellX(cell), cellY(cell) - 1, { prio: 2, pal: 7 });\nelse print('?', cellX(cell) + 13, cellY(cell) + 10, DIM);\n}\nfor (let line = 0; line < 5; line++) drawPic(30 + line, cellX(line * COLS), cellY(line * COLS) - 1, { prio: 2 });\nconst sel = recSel, line = (sel / 6) | 0, tier = sel % 6 + 1, cell = line * COLS + tier, st = recState(line, tier);\nsprite(ART.sprites[(clock >> 4) & 1 ? 'cursor1' : 'cursor0'], cellX(cell), cellY(cell) - 2, { prio: 3 });\npanel(8, 30, 240, 50);\nconst foundN = Array.from({ length: 30 }, (_, i) => isFound(i + 1)).filter((x) => x).length;\nctxt(`RECIPES: ${foundN} OF 30 FOUND`, 36, GOLD);\nctxt(st === 2 ? `${nameOf(item(line, tier))}` : st === 1 ? 'NEXT TO FIND: MERGE TWO OF THE ONE BEFORE' : '???', 50, st === 2 ? WHITE : DIM);\nconst met = story.map((s, k) => (s ? PEOPLE[k] : null)).filter((x) => x);\nctxt(met.length ? `REGULARS: ${met.length} OF 5 MET` : 'NO REGULARS MET YET', 64, CREAM);\n}\nfunction drawTitle() {\nif (confirm) { panel(32, 150, 192, 40); ctxt('START A NEW CAFE?', 158, WHITE); ctxt('YOUR SAVED ONE IS LOST.  A: YES  B: NO', 172, ORANGE); return; }\nconst items = hasSave() ? ['CONTINUE', 'NEW CAFE', 'RECIPES'] : ['NEW CAFE', 'RECIPES'];\nitems.forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 92, 150 + i * 12, i === titleSel ? WHITE : DIM));\nfor (let k = 0; k < 5; k++) drawPic(picOf(item(k, 6)), 24 + k * 44, flr(178 + 2 * Math.sin(clock / 20 + k)), { prio: 2 });\nctxt('A: PICK UP, DROP   B: WHAT IS IT', 212, DIM);\n}\nfunction drawEnding() {\npanel(8, 90, 240, 112);\nctxt('THE GRAND REOPENING', 98, GOLD);\n['THE LIGHTS ARE ON, THE GLASS', 'SHINES AND THE BREAD IS WARM.', 'MARION, JAMES, BENNY, GINA', 'AND MR. FISK RAISE A CUP:', 'TO THE MERGE CAFE!', '', `${served} ORDERS SERVED`].forEach((l, i) => ctxt(l, 114 + i * 11, i === 4 ? CREAM : i === 6 ? DIM : WHITE));\nif (timer > 120 && (clock >> 4) & 1) ctxt('A: KEEP THE CAFE GOING', 192, DIM);\n}\nfunction drawPause() {\npanel(56, 76, 144, 72);\nif (confirm) { ctxt('START A NEW CAFE?', 92, WHITE); ctxt('A: YES   B: NO', 112, ORANGE); return; }\nctxt('PAUSED', 84, GOLD);\n['RESUME', 'CAFE', 'RECIPES', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 68, 100 + i * 11, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h, seeThrough = false) { rectfill(x, y, w, h, seeThrough ? ART.colors.GLASS : SOLID); rect(x, y, w, h, GOLD); rect(x + 2, y + 2, w - 4, h - 4, CHALK); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nfunction scanline(y) {\nif (state !== 'title' || y < 84) return;\nconst k = (y - 84) / 140;\ncolor(0, 7 + k * 5, 4 + k * 1, 3 + k * 2);\n}\n",

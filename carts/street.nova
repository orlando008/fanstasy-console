 {\"h\": 76, \"parts\": [[24, 24, 578, 8, 0, 0], [32, 8, 506, 8, 0, 0], [40, 8, 507, 8, 0, 0], [32, 16, 580, 16, 0, 0], [24, 32, 579, 8, 0, 0], [24, 40, 582, 8, 0, 0], [24, 56, 583, 8, 0, 0], [32, 32, 584, 16, 0, 0], [32, 48, 586, 16, 0, 0], [24, 64, 588, 8, 0, 0], [32, 64, 589, 8, 0, 0], [40, 64, 590, 8, 0, 0]], \"w\": 82}, \"walk3\": {\"h\": 76, \"parts\": [[24, 16, 591, 8, 0, 0], [24, 24, 594, 8, 0, 0], [32, 8, 595, 8, 0, 0], [40, 8, 598, 8, 0, 0], [32, 16, 608, 16, 0, 0], [24, 32, 599, 8, 0, 0], [24, 40, 604, 8, 0, 0], [24, 48, 605, 8, 0, 0], [24, 56, 606, 8, 0, 0], [32, 32, 640, 32, 0, 0], [24, 64, 607, 8, 0, 0], [32, 64, 610, 8, 0, 0], [40, 64, 611, 8, 0, 0], [48, 64, 612, 8, 0, 0]], \"w\": 82}, \"walk4\": {\"h\": 76, \"parts\": [[24, 24, 578, 8, 0, 0], [32, 8, 506, 8, 0, 0], [40, 8, 507, 8, 0, 0], [32, 16, 614, 16, 0, 0], [48, 24, 518, 8, 0, 0], [24, 32, 613, 8, 0, 0], [24, 40, 616, 8, 0, 0], [16, 48, 618, 16, 0, 0], [32, 32, 644, 32, 0, 0], [16, 64, 521, 8, 0, 0], [24, 64, 534, 8, 0, 0], [32, 64, 535, 8, 0, 0], [40, 64, 536, 8, 0, 0], [48, 64, 537, 8, 0, 0], [56, 64, 544, 8, 0, 0]], \"w\": 82}, \"walk5\": {\"h\": 76, \"parts\": [[24, 24, 545, 8, 0, 0], [32, 8, 546, 8, 0, 0], [40, 8, 547, 8, 0, 0], [32, 16, 620, 16, 0, 0], [24, 32, 550, 8, 0, 0], [24, 40, 551, 8, 0, 0], [16, 48, 622, 16, 0, 0], [32, 32, 648, 16, 0, 0], [48, 40, 617, 8, 0, 0], [32, 48, 650, 16, 0, 0], [16, 64, 561, 8, 0, 0], [24, 64, 562, 8, 0, 0], [32, 64, 563, 8, 0, 0], [40, 64, 566, 8, 0, 0], [48, 64, 567, 8, 0, 0]], \"w\": 82}, \"walk6\": {\"h\": 76, \"parts\": [[24, 24, 578, 8, 0, 0], [32, 8, 506, 8, 0, 0], [40, 8, 507, 8, 0, 0], [32, 16, 580, 16, 0, 0], [24, 32, 579, 8, 0, 0], [24, 40, 582, 8, 0, 0], [24, 56, 626, 8, 0, 0], [32, 32, 652, 16, 0, 0], [32, 48, 654, 16, 0, 0], [24, 64, 627, 8, 0, 0], [32, 64, 628, 8, 0, 0], [40, 64, 590, 8, 0, 0]], \"w\": 82}, \"walk7\": {\"h\": 76, \"parts\": [[24, 16, 591, 8, 0, 0], [24, 24, 594, 8, 0, 0], [32, 8, 595, 8, 0, 0], [40, 8, 598, 8, 0, 0], [32, 16, 680, 16, 0, 0], [24, 32, 599, 8, 0, 0], [24, 40, 604, 8, 0, 0], [24, 48, 629, 8, 0, 0], [24, 56, 606, 8, 0, 0], [32, 32, 704, 32, 0, 0], [24, 64, 607, 8, 0, 0], [32, 64, 632, 8, 0, 0], [40, 64, 611, 8, 0, 0], [48, 64, 612, 8, 0, 0]], \"w\": 82}},\n  anims: {\"idle\": [\"idle0\", \"idle1\"], \"kick\": [\"kick0\", \"kick1\", \"kick2\", \"kick3\"], \"punch\": [\"punch0\", \"punch1\", \"punch2\", \"punch3\"], \"walk\": [\"walk0\", \"walk1\", \"walk2\", \"walk3\", \"walk4\", \"walk5\", \"walk6\", \"walk7\"]},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[4129,4129,4129,4129,4129,4129,4130,4130,5154,5154,5154,5154,5154,5154,5154,5154,5154,6178,6179,6179,6211,6211,6211,6211,6211,7235,7235,7235,7235,7236,7236,7236,8260,8260,8260,8260,8260,8260,8260,8292,9317,9317,9317,9317,9317,9317,9317,9318,9318,9318,9318,9318,9318,10374,10375,10375,10375,10375,10375,10375,10375,10376,10376,10376,10376,10376,11432,11433,11433,11433,11433,11433,11433,11433,11434,11434,11434,11434,11434,11434,12491,12491,12491,12491,12491,12492,12492,12492,12524,12524,12525,12525,12525,12525,12526,12526,12558,12558,12558,12559,12559,12559,12559,12560,12592,12592,12592,12593,12593,12593,12593,12593,12626,12626,12626,12626,13651,13651,13651,13651,13684],\"y0\":0}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n\nconst FEET = 70;            // the rig's canvas: the soles are this many pixels below its top\nconst GROUND = 204;         // where his feet are on the screen\nconst SPEED = { idle: 30, walk: 7, punch: 5, kick: 6 };   // frames each animation frame is shown\nlet x = 100, facing = 1, act = 'idle', frame = 0, timer = 0;\n\nfunction init() {\n  bg(2, { mx: ART.scenes.city.mx, my: 0, mw: 32, mh: 28, x: 0, y: 12, wrap: true, show: true });\n  bg(1, { mx: ART.scenes.fence.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n  bg(0, { mx: ART.scenes.ground.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n}\n\nfunction start(a) { if (act !== a) { act = a; frame = 0; timer = 0; } }\n\nfunction update() {\n  const busy = (act === 'punch' || act === 'kick');\n  if (!busy) {\n    if (btnp(A)) start('punch');\n    else if (btnp(B)) start('kick');\n    else if (btn(LEFT) || btn(RIGHT)) {\n      facing = btn(LEFT) ? -1 : 1;\n      x = clamp(x + facing * 1.2, -20, 200);\n      start('walk');\n    } else start('idle');\n  }\n  const n = ART.anims[act].length;\n  if (++timer >= SPEED[act]) {\n    timer = 0;\n    frame++;\n    if (frame >= n) { frame = 0; if (busy) start('idle'); }\n  }\n}\n\nfunction draw() {\n  cls();\n  // his shadow (sprite palette 4) is subtracted from the pavement under him\n  blend({ layers: ['spr'], op: 'sub' });\n  const b = ART.big[ART.anims[act][frame]];\n  bigSprite(b, flr(x), GROUND - FEET, { fx: facing < 0, prio: 2 });\n  bigSprite(ART.big.shadow, flr(x) + (facing < 0 ? b.w - 30 - 40 : 30) - 4, GROUND - 4, { prio: 2 });\n  print('WALK  A:PUNCH  B:KICK', 128 - 21 * 4, 214, ART.colors.WHITE);\n}\n\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

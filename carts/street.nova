  "label": "",
  "code": "// Street: the test of the art kit's character rig (docs/dev/snes-picture.md; the art is all in art.py). A brawler\n// built on a skeleton, his animations rendered from poses, on a night street after Streets of Rage 2.\n// LEFT and RIGHT walk, A punches, B kicks.\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {},\n  scenes: {\"city\": {\"h\": 16, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"fence\": {\"h\": 20, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"ground\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"GOLD\": 114, \"INK\": 115, \"WHITE\": 113},\n  big: {\"idle0\": {\"h\": 76, \"parts\": [[24, 24, 480, 8, 0, 0], [32, 8, 481, 8, 0, 0], [40, 8, 482, 8, 0, 0], [32, 16, 484, 16, 0, 0], [48, 16, 483, 8, 0, 0], [48, 24, 486, 8, 0, 0], [24, 32, 487, 8, 0, 0], [24, 40, 488, 8, 0, 0], [24, 48, 489, 8, 0, 0], [24, 56, 490, 8, 0, 0], [32, 32, 492, 16, 0, 0], [48, 32, 491, 8, 0, 0], [32, 48, 494, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 498, 8, 0, 0], [48, 64, 499, 8, 0, 0]], \"w\": 82}, \"idle1\": {\"h\": 76, \"parts\": [[24, 24, 480, 8, 0, 0], [32, 8, 481, 8, 0, 0], [40, 8, 482, 8, 0, 0], [32, 16, 512, 16, 0, 0], [48, 16, 502, 8, 0, 0], [48, 24, 503, 8, 0, 0], [24, 32, 487, 8, 0, 0], [24, 40, 488, 8, 0, 0], [24, 48, 489, 8, 0, 0], [24, 56, 490, 8, 0, 0], [32, 32, 514, 16, 0, 0], [48, 32, 504, 8, 0, 0], [32, 48, 494, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 498, 8, 0, 0], [48, 64, 499, 8, 0, 0]], \"w\": 82}, \"kick0\": {\"h\": 76, \"parts\": [[24, 24, 480, 8, 0, 0], [32, 8, 481, 8, 0, 0], [40, 8, 482, 8, 0, 0], [32, 16, 484, 16, 0, 0], [48, 16, 483, 8, 0, 0], [48, 24, 486, 8, 0, 0], [24, 32, 487, 8, 0, 0], [24, 40, 488, 8, 0, 0], [24, 48, 489, 8, 0, 0], [24, 56, 490, 8, 0, 0], [32, 32, 492, 16, 0, 0], [48, 32, 491, 8, 0, 0], [32, 48, 494, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 498, 8, 0, 0], [48, 64, 499
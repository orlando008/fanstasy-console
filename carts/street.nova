{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Street",
    "author": "NOVA-16",
    "description": "The art kit's character rig: a brawler built on a skeleton, his idle, walk, punch and kick animated from poses, on a night street (LEFT/RIGHT walk, A punch, B kick)."
  },
  "label": "",
  "code": "// Street: the test of the art kit's drawn figures (docs/dev/snes-picture.md; the art is all in art.py). A brawler drawn\n// in designed shapes on a skeleton, his animations rendered from poses and streamed into tile memory as they play, on a\n// night street after Streets of Rage 2.\n// LEFT and RIGHT walk, A punches, B kicks.\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {},\n  scenes: {\"city\": {\"h\": 16, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"fence\": {\"h\": 20, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"ground\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"GOLD\": 114, \"INK\": 115, \"WHITE\": 113},\n  big: {\"shadow\": {\"h\": 10, \"parts\": [[0, 0, 480, 16, 4, 0], [16, 0, 482, 16, 4, 0], [32, 0, 484, 16, 4, 0], [48, 0, 486, 8, 4, 0]], \"w\": 56}},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[4129,4129,4129,4129,4129,4129,4130,4130,5154,5154,5154,5154,5154,5154,5154,5154,5154,6178,6179,6179,6211,6211,6211,6211,6211,7235,7235,7235,7235,7236,7236,7236,8260,8260,8260,8260,8260,8260,8260,8292,9317,9317,9317,9317,9317,9317,9317,9318,9318,9318,9318,9318,9318,10374,10375,10375,10375,10375,10375,10375,10375,10376,10376,10376,10376,10376,11432,11433,11433,11433,11433,11433,11433,11433,11434,11434,11434,11434,11434,11434,12491,12491,12491,12491,12491,12492,12492,12492,12524,12524,12525,12525,12525,12525,12526,12526,12558,12558,12558,12559,12559,12559,12559,12560,12592,12592,12592,12593,12593,12593,12593,12593,12626,12626,12626,12626,13651,13651,13651,13651,13684],\"y0\":0}},\n  streams: {\"hero\":{\"base\":512,\"clips\":{\"idle\":[0,2],\"kick\":[14,4],\"punch\":[10,4],\"walk\":[2,8]},\"h\":108,\"rom\":\"hero\",\"rows\":8,\"slots\":1,\"w\":117}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n/** Draw frame k of a streamed animation from ART.streams at (x, y), its top left: its tiles are copied into the\n * animation's slot first (only those that changed since the slot's last frame); its frames come from the cart's\n * ROM (rom()) or, without ROM, from the packed strings here. opts { fx, prio (default 3), pal,\n * slot (0 to slots - 1: one for each copy on screen at once) } (generated by art.py). */\nfunction streamSprite(st, k, x, y, opts = {}) {\n  const A = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/', d = (s, i, n = 1) => {\n    let v = 0;\n    for (let j = 0; j < n; j++) v = v * 64 + A.indexOf(s[i + j]);\n    return v;\n  };\n  if (!st.px && st.rom) {                          // frames kept in ROM: unpack them from rom(), once\n    const b = rom(st.rom), u = (i) => b[i] | (b[i + 1] << 8), nf = u(4), nt = u(6);\n    st.px = [new Uint8Array(64)]; st.loaded = []; st.f = [];\n    let p = 8;\n    for (let k = 0; k < nt; k++) {\n      const cur = new Uint8Array(64);\n      for (let n = 0; n < 64; p++) {\n        const s = b[p], r = s < 64 ? s + 1 : (s - 64) % 12 + 1, v = s < 64 ? -1 : ((s - 64) / 12) | 0;\n        for (let q = 0; q < r; q++, n++) cur[n] = v >= 0 ? v : n >= 8 ? cur[n - 8] : 0;\n      }\n      st.px.push(cur);\n    }\n    for (let k = 0; k < nf; k++) {\n      const np = b[p++], parts = [], ix = [];\n      let tiles = 0;\n      for (let q = 0; q < np; q++, p += 5) {\n        const size = 8 << (b[p + 4] >> 4);\n        parts.push([b[p] * 8, b[p + 1] * 8, u(p + 2), size, b[p + 4] & 15]);\n        tiles += (size >> 3) * (size >> 3);\n      }\n      for (let q = 0; q < tiles; q++, p += 2) ix.push(u(p));\n      st.f.push({ parts, ix });\n    }\n  }\n  if (!st.px) {                                    // unpack the tiles and the frames, once\n    st.px = [new Uint8Array(64)]; st.loaded = []; st.f = [];\n    let cur = new Uint8Array(64), n = 0;\n    for (let i = 0; i < st.pool.length; i++) {\n      const s = A.indexOf(st.pool[i]);\n      const r = s < 16 ? s + 1 : (s - 16) % 3 + 1, v = s < 16 ? -1 : ((s - 16) / 3) | 0;\n      for (let q = 0; q < r; q++, n++) cur[n] = v >= 0 ? v : n >= 8 ? cur[n - 8] : 0;\n      if (n === 64) { st.px.push(cur); cur = new Uint8Array(64); n = 0; }\n    }\n    for (const s of st.frames) {\n      const np = d(s, 0, 2), parts = [];\n      for (let p = 0; p < np; p++) {\n        const i = 2 + p * 6;\n        parts.push([d(s, i) * 8, d(s, i + 1) * 8, d(s, i + 2, 2), 8 << d(s, i + 4), d(s, i + 5)]);\n      }\n      const ix = [];\n      for (let i = 2 + np * 6; i < s.length; i += 2) ix.push(d(s, i, 2));\n      st.f.push({ parts, ix });\n    }\n  }\n  const slot = opts.slot ?? 0, base = st.base + slot * st.rows * 16;\n  const have = st.loaded[slot] || (st.loaded[slot] = new Int32Array(st.rows * 16).fill(-1));\n  const f = st.f[k], fx = !!opts.fx, prio = opts.prio ?? 3;\n  let c = 0;\n  for (const [dx, dy, off, size, pal] of f.parts) {\n    const n = size >> 3;\n    for (let j = 0; j < n; j++) for (let i = 0; i < n; i++, c++) {\n      const ix = f.ix[c], o = off + j * 16 + i;\n      if (have[o] === ix) continue;\n      have[o] = ix;\n      const t = base + o, tx = (t & 15) * 8, ty = (t >> 4) * 8, p = st.px[ix];\n      for (let q = 0; q < 64; q++) sset(tx + (q & 7), ty + (q >> 3), p[q]);\n    }\n    spr(base + off, x + (fx ? st.w - dx - size : dx), y + dy, { size, pal: opts.pal ?? pal, fx, prio });\n  }\n}\n// END ART\n\nconst FEET = 102;           // the figure's canvas: the soles are this many pixels below its top (its margin + height)\nconst GROUND = 204;         // where his feet are on the screen\nconst SPEED = { idle: 30, walk: 7, punch: 5, kick: 6 };   // frames each animation frame is shown\nlet x = 100, facing = 1, act = 'idle', frame = 0, timer = 0;\n\nfunction init() {\n  bg(2, { mx: ART.scenes.city.mx, my: 0, mw: 32, mh: 28, x: 0, y: 12, wrap: true, show: true });\n  bg(1, { mx: ART.scenes.fence.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n  bg(0, { mx: ART.scenes.ground.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n}\n\nfunction start(a) { if (act !== a) { act = a; frame = 0; timer = 0; } }\n\nfunction update() {\n  const busy = (act === 'punch' || act === 'kick');\n  if (!busy) {\n    if (btnp(A)) start('punch');\n    else if (btnp(B)) start('kick');\n    else if (btn(LEFT) || btn(RIGHT)) {\n      facing = btn(LEFT) ? -1 : 1;\n      x = clamp(x + facing * 1.2, -30, 170);\n      start('walk');\n    } else start('idle');\n  }\n  const n = ART.streams.hero.clips[act][1];\n  if (++timer >= SPEED[act]) {\n    timer = 0;\n    frame++;\n    if (frame >= n) { frame = 0; if (busy) start('idle'); }\n  }\n}\n\nfunction draw() {\n  cls();\n  // his shadow (sprite palette 4) is subtracted from the pavement under him\n  blend({ layers: ['spr'], op: 'sub' });\n  const st = ART.streams.hero;\n  streamSprite(st, st.clips[act][0] + frame, flr(x), GROUND - FEET, { fx: facing < 0, prio: 2 });\n  bigSprite(ART.big.shadow, flr(x) + (facing < 0 ? st.w - 44 - 56 : 44) - 4, GROUND - 5, { prio: 2 });\n  print('WALK  A:PUNCH  B:KICK', 128 - 21 * 4, 214, ART.colors.WHITE);\n}\n\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

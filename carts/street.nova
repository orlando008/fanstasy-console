, 8, 0, 0], [48, 72, 565, 8, 0, 0]], \"w\": 82}, \"walk2\": {\"h\": 76, \"parts\": [[24, 16, 506, 8, 0, 0], [24, 24, 566, 8, 0, 0], [32, 0, 520, 16, 0, 0], [32, 16, 584, 16, 0, 0], [24, 32, 567, 8, 0, 0], [24, 40, 570, 8, 0, 0], [24, 48, 571, 8, 0, 0], [24, 56, 586, 8, 0, 0], [32, 32, 588, 16, 0, 0], [48, 40, 587, 8, 0, 0], [32, 48, 590, 16, 0, 0], [24, 64, 602, 8, 0, 0], [32, 64, 603, 8, 0, 0], [40, 64, 612, 8, 0, 0]], \"w\": 82}, \"walk3\": {\"h\": 76, \"parts\": [[24, 16, 613, 8, 0, 0], [24, 24, 614, 8, 0, 0], [32, 0, 616, 16, 0, 0], [32, 16, 618, 16, 0, 0], [24, 32, 615, 8, 0, 0], [24, 40, 620, 8, 0, 0], [24, 48, 621, 8, 0, 0], [24, 56, 622, 8, 0, 0], [32, 32, 640, 16, 0, 0], [48, 32, 623, 8, 0, 0], [48, 40, 628, 8, 0, 0], [32, 48, 642, 16, 0, 0], [24, 64, 629, 8, 0, 0], [32, 64, 630, 8, 0, 0], [40, 64, 631, 8, 0, 0], [48, 64, 636, 8, 0, 0]], \"w\": 82}, \"walk4\": {\"h\": 76, \"parts\": [[24, 16, 506, 8, 0, 0], [24, 24, 566, 8, 0, 0], [32, 0, 520, 16, 0, 0], [32, 16, 644, 16, 0, 0], [48, 24, 637, 8, 0, 0], [24, 32, 567, 8, 0, 0], [24, 40, 638, 8, 0, 0], [16, 48, 646, 16, 0, 0], [32, 32, 648, 32, 0, 0], [16, 64, 639, 8, 0, 0], [24, 64, 652, 8, 0, 0], [32, 64, 653, 8, 0, 0], [40, 64, 654, 8, 0, 0], [48, 64, 655, 8, 0, 0], [56, 64, 547, 8, 0, 0]], \"w\": 82}, \"walk5\": {\"h\": 76, \"parts\": [[24, 16, 548, 8, 0, 0], [24, 24, 549, 8, 0, 0], [32, 8, 550, 8, 0, 0], [40, 8, 551, 8, 0, 0], [32, 16, 672, 16, 0, 0], [24, 32, 554, 8, 0, 0], [24, 40, 668, 8, 0, 0], [16, 48, 674, 16, 0, 0], [32, 32, 704, 32, 0, 0], [16, 64, 669, 8, 0, 0], [24, 64, 670, 8, 0, 0], [32, 64, 676, 16, 0, 0], [48, 64, 671, 8, 0, 0], [48, 72, 565, 8, 0, 0]], \"w\": 82}, \"walk6\": {\"h\": 76, \"parts\": [[24, 16, 506, 8, 0, 0], [24, 24, 566, 8, 0, 0], [32, 0, 520, 16, 0, 0], [32, 16, 584, 16, 0, 0], [24, 32, 567, 8, 0, 0], [24, 40, 678, 8, 0, 0], [24, 48, 679, 8, 0, 0], [24, 56, 684, 8, 0, 0], [32, 32, 686, 16, 0, 0], [48, 40, 587, 8, 0, 0], [32, 48, 708, 16, 0, 0], [24, 64, 685, 8, 0, 0], [32, 64, 694, 8, 0, 0], [40, 64, 695, 8, 0, 0]], \"w\": 82}, \"walk7\": {\"h\": 76, \"parts\": [[24, 16, 613, 8, 0, 0], [24, 24, 700, 8, 0, 0], [32, 0, 616, 16, 0, 0], [32, 16, 710, 16, 0, 0], [48, 24, 701, 8, 0, 0], [24, 32, 712, 8, 0, 0], [24, 40, 713, 8, 0, 0], [24, 48, 714, 8, 0, 0], [24, 56, 715, 8, 0, 0], [32, 32, 716, 16, 0, 0], [48, 32, 718, 16, 0, 0], [32, 48, 740, 16, 0, 0], [24, 64, 728, 8, 0, 0], [32, 64, 729, 8, 0, 0], [40, 64, 730, 8, 0, 0], [48, 64, 636, 8, 0, 0]], \"w\": 82}},\n  anims: {\"idle\": [\"idle0\", \"idle1\"], \"kick\": [\"kick0\", \"kick1\", \"kick2\", \"kick3\"], \"punch\": [\"punch0\", \"punch1\", \"punch2\", \"punch3\"], \"walk\": [\"walk0\", \"walk1\", \"walk2\", \"walk3\", \"walk4\", \"walk5\", \"walk6\", \"walk7\"]},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[4129,4129,4129,4129,4129,4129,4130,4130,5154,5154,5154,5154,5154,5154,5154,5154,5154,6178,6179,6179,6211,6211,6211,6211,6211,7235,7235,7235,7235,7236,7236,7236,8260,8260,8260,8260,8260,8260,8260,8292,9317,9317,9317,9317,9317,9317,9317,9318,9318,9318,9318,9318,9318,10374,10375,10375,10375,10375,10375,10375,10375,10376,10376,10376,10376,10376,11432,11433,11433,11433,11433,11433,11433,11433,11434,11434,11434,11434,11434,11434,12491,12491,12491,12491,12491,12492,12492,12492,12524,12524,12525,12525,12525,12525,12526,12526,12558,12558,12558,12559,12559,12559,12559,12560,12592,12592,12592,12593,12593,12593,12593,12593,12626,12626,12626,12626,13651,13651,13651,13651,13684],\"y0\":0}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n\nconst FEET = 70;            // the rig's canvas: the soles are this many pixels below its top\nconst GROUND = 204;         // where his feet are on the screen\nconst SPEED = { idle: 30, walk: 7, punch: 5, kick: 6 };   // frames each animation frame is shown\nlet x = 100, facing = 1, act = 'idle', frame = 0, timer = 0;\n\nfunction init() {\n  bg(2, { mx: ART.scenes.city.mx, my: 0, mw: 32, mh: 28, x: 0, y: 12, wrap: true, show: true });\n  bg(1, { mx: ART.scenes.fence.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n  bg(0, { mx: ART.scenes.ground.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n}\n\nfunction start(a) { if (act !== a) { act = a; frame = 0; timer = 0; } }\n\nfunction update() {\n  const busy = (act === 'punch' || act === 'kick');\n  if (!busy) {\n    if (btnp(A)) start('punch');\n    else if (btnp(B)) start('kick');\n    else if (btn(LEFT) || btn(RIGHT)) {\n      facing = btn(LEFT) ? -1 : 1;\n      x = clamp(x + facing * 1.2, -20, 200);\n      start('walk');\n    } else start('idle');\n  }\n  const n = ART.anims[act].length;\n  if (++timer >= SPEED[act]) {\n    timer = 0;\n    frame++;\n    if (frame >= n) { frame = 0; if (busy) start('idle'); }\n  }\n}\n\nfunction draw() {\n  cls();\n  // his shadow (sprite palette 4) is subtracted from the pavement under him\n  blend({ layers: ['spr'], op: 'sub' });\n  const b = ART.big[ART.anims[act][frame]];\n  bigSprite(b, flr(x), GROUND - FEET, { fx: facing < 0, prio: 2 });\n  bigSprite(ART.big.shadow, flr(x) + (facing < 0 ? b.w - 30 - 40 : 30) - 4, GROUND - 4, { prio: 2 });\n  print('WALK  A:PUNCH  B:KICK', 128 - 21 * 4, 214, ART.colors.WHITE);\n}\n\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

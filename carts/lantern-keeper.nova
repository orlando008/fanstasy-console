{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Lantern Keeper",
    "author": "NOVA-16",
    "description": "The great lamp of Greywater Light has gone out in a storm. Move and turn mirrors, splitters, prisms and coloured glass to carry the beam to every lens, through forty rooms on four floors up to the lamp. Each room has a par to beat for its star."
  },
  "label": null,
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {},\nsprites: {\"bolt\": {\"pal\": 0, \"size\": 8, \"tile\": 812}, \"cursor\": {\"pal\": 6, \"size\": 16, \"tile\": 814}, \"door_open\": {\"pal\": 2, \"size\": 16, \"tile\": 810}, \"door_shut\": {\"pal\": 2, \"size\": 16, \"tile\": 808}, \"filter\": {\"pal\": 0, \"size\": 16, \"tile\": 802}, \"lantern_e\": {\"pal\": 0, \"size\": 16, \"tile\": 770}, \"lantern_n\": {\"pal\": 0, \"size\": 16, \"tile\": 768}, \"lens\": {\"pal\": 0, \"size\": 16, \"tile\": 800}, \"mirror\": {\"pal\": 1, \"size\": 16, \"tile\": 772}, \"mirror_fixed\": {\"pal\": 2, \"size\": 16, \"tile\": 774}, \"prism_e\": {\"pal\": 3, \"size\": 16, \"tile\": 782}, \"prism_n\": {\"pal\": 3, \"size\": 16, \"tile\": 780}, \"shadow\": {\"pal\": 5, \"size\": 16, \"tile\": 804}, \"shadow_lit\": {\"pal\": 5, \"size\": 16, \"tile\": 806}, \"splitter\": {\"pal\": 1, \"size\": 16, \"tile\": 776}, \"splitter_fixed\": {\"pal\": 2, \"size\": 16, \"tile\": 778}},\nscenes: {\"cutaway\": {\"h\": 28, \"mx\": 64, \"my\": 32, \"pal\": 6, \"w\": 32}, \"floor1\": {\"h\": 2, \"mx\": 0, \"my\": 100, \"pal\": 1, \"w\": 16}, \"floor2\": {\"h\": 2, \"mx\": 0, \"my\": 102, \"pal\": 1, \"w\": 16}, \"floor3\": {\"h\": 2, \"mx\": 0, \"my\": 104, \"pal\": 1, \"w\": 16}, \"floor4\": {\"h\": 2, \"mx\": 0, \"my\": 106, \"pal\": 1, \"w\": 16}, \"outside\": {\"h\": 2, \"mx\": 8, \"my\": 108, \"pal\": 5, \"w\": 6}, \"sea\": {\"h\": 4, \"mx\": 64, \"my\": 0, \"pal\": 4, \"w\": 8}, \"stars\": {\"h\": 28, \"mx\": 32, \"my\": 32, \"pal\": 7, \"w\": 32}, \"title\": {\"h\": 28, \"mx\": 0, \"my\": 32, \"pal\": 6, \"w\": 32}, \"walls\": {\"h\": 2, \"mx\": 0, \"my\": 108, \"pal\": 3, \"w\": 8}},\ncolors: {},\ngradients: {\"sky\":{\"entry\":0,\"lines\":[1024,1024,1024,1024,1024,2048,2048,2048,2048,2048,2048,2048,2048,2048,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,2080,3104,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4129,4161,4161,4161,4161,4161,4161,4161,4161,5185,5185,5185,5185,5185,5185,5185,5185,5185,5185,5185,5185,5185,5185,5185,5186,5186,5186,5186,5186,5186,5186,6210,6210,6210,6210,6210,6210,6242,6242,6242,6242,6242,6242,6242,6242,6242,6242,6242,6242,6242,6242,6242,7266,7266,7266,7266,7266,7266,7266,7266,7266,7266,7266,7266,7266,7266,7266,7267,7267,7299,7299,7299,7299,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8323,8324,8324,8324,8324,8324,8324,8324,8324,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,8356,9380,9380,9380,9380,9380,9380,9380,9380,9380,9380,9380,9380,9381,9381,9381,9381,9381,9381,9381,9381,9381,9381,9381,9381],\"y0\":0}},\n};\nfunction gradientLine(g, y) {\nconst v = g.lines[y - g.y0];\nif (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, pick: 3, drop: 4, turn: 5, no: 6, undo: 7, redo: 8, lens: 9, door: 16, solved: 17, star: 18, stair: 19, page: 20, thunder: 21 };\nconst SONG = { title: 0, floors: [1, 2, 3, 4], ending: 5 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, LAST_SLOT = 1, STORY_SLOT = 2, BEST_SLOT = 10;\nconst FLOOR_ROOMS = 10, FLOOR_NAMES = ['THE STAIR', 'THE GLASS ROOM', 'THE CLOCKWORK', 'THE LAMP GALLERY'];\nconst best = (n) => dget(BEST_SLOT + n);\nconst solved = (n) => best(n) > 0;\nconst opened = (n) => n === 0 || solved(n - 1);\nconst starred = (n) => solved(n) && best(n) <= parRoom(n);\nconst parRoom = (n) => +/PAR (\\d+)/.exec(ROOMS[n])[1];\nconst nameRoom = (n) => /^ROOM (.*?) PAR/.exec(ROOMS[n])[1];\nconst nextRoom = () => { let n = 0; while (n < ROOMS.length - 1 && solved(n)) n++; return n; };\nconst storySeen = (k) => (dget(STORY_SLOT) >> k) & 1;\nconst ENDED = 4;\nconst DX = [0, 1, 0, -1];\nconst DY = [-1, 0, 1, 0];\nconst WHITE_LIGHT = 7;\nconst COLOURS = { red: 1, green: 2, blue: 4, yellow: 3, magenta: 5, cyan: 6, white: 7 };\nconst MIRROR = [[1, 0, 3, 2], [3, 2, 1, 0]];\nconst TURNS = { lantern: 4, mirror: 2, splitter: 2, prism: 4, filter: 1, lens: 1, shadow: 1, door: 1 };\nconst MODE = { lantern: 'fixed', mirror: 'free', splitter: 'free', prism: 'free', filter: 'fixed', lens: 'fixed', shadow: 'fixed', door: 'fixed' };\nconst MAX_RUNS = 512;\nconst MAX_SETTLE = 8;\nfunction parseRoom(text) {\nconst lines = text.split('\\n').filter((l) => l.trim().length && !l.startsWith('//'));\nconst head = /^ROOM\\s+(.*?)\\s+PAR\\s+(\\d+)(\\s+DARK)?\\s*$/.exec(lines[0].trim());\nconst map = lines.slice(1).filter((l) => !/^[A-Za-z]:/.test(l)), legend = {};\nfor (const l of lines.slice(1)) {\nconst m = /^([A-Za-z]):\\s*(.*)$/.exec(l); if (!m) continue;\nconst t = m[2].trim().split(/\\s+/), d = { k: t[0], r: 0, c: 0, mode: MODE[t[0]], key: 0 };\nfor (const w of t.slice(1)) {\nif ('NESW'.includes(w) && w.length === 1) d.r = 'NESW'.indexOf(w);\nelse if (w === '/' || w === '\\\\') d.r = w === '/' ? 0 : 1;\nelse if (COLOURS[w]) d.c = COLOURS[w];\nelse if (w === 'free' || w === 'bolted' || w === 'fixed') d.mode = w;\nelse if (/^key\\d$/.test(w)) d.key = +w[3];\n}\nif ((d.k === 'lantern' || d.k === 'lens') && !d.c) d.c = WHITE_LIGHT;\nlegend[m[1]] = d;\n}\nconst h = map.length, w = Math.max(...map.map((l) => l.length));\nconst wall = new Uint8Array(w * h), pieces = [];\nconst put = (d, x, y) => pieces.push({ k: d.k, x, y, r: d.r, c: d.c, mode: d.mode, key: d.key || 0 });\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nconst ch = map[y][x] || ' ', i = y * w + x;\nif (ch === '#') wall[i] = 1;\nelse if (ch === '=') wall[i] = 3;\nelse if (ch === ' ') wall[i] = 2;\nelse if ('^>v<'.includes(ch)) put({ k: 'lantern', r: '^>v<'.indexOf(ch), c: WHITE_LIGHT, mode: 'fixed' }, x, y);\nelse if (ch === '/' || ch === '\\\\') put({ k: 'mirror', r: ch === '/' ? 0 : 1, c: 0, mode: 'free' }, x, y);\nelse if (ch === 'o') put({ k: 'lens', r: 0, c: WHITE_LIGHT, mode: 'fixed' }, x, y);\nelse if (ch === 'x') put({ k: 'shadow', r: 0, c: 0, mode: 'fixed' }, x, y);\nelse if (legend[ch]) put(legend[ch], x, y);\n}\nreturn { name: head ? head[1] : '?', par: head ? +head[2] : 0, dark: !!(head && head[3]), w, h, wall, pieces };\n}\nfunction trace(room, pieces, skip = -1, open = 0, buf = null) {\nconst { w, h, wall } = room, size = w * h;\nconst at = buf ? buf.at.fill(-1) : new Int16Array(size).fill(-1);\npieces.forEach((q, i) => { if (i !== skip && q.x >= 0) at[q.y * w + q.x] = i; });\nconst half = buf ? buf.half.fill(0) : new Uint8Array(size * 4), got = buf ? buf.got.fill(0) : new Uint8Array(pieces.length);\nconst seen = buf ? buf.seen.fill(0) : new Uint8Array(size * 4), reached = buf ? buf.reached.fill(0) : new Uint8Array(size);\nconst order = [], queue = [], hits = [];\npieces.forEach((q, i) => { if (i !== skip && q.x >= 0 && q.k === 'lantern') queue.push([q.x, q.y, q.r, q.c]); });\nlet runs = 0;\nwhile (queue.length && runs < MAX_RUNS) {\nlet [x, y, d, c] = queue.shift(); runs++;\nfor (;;) {\nconst s = (y * w + x) * 4 + d;\nif ((seen[s] & c) === c) break;\nseen[s] |= c; half[s] |= c;\nconst nx = x + DX[d], ny = y + DY[d], n = ny * w + nx;\nif (nx < 0 || ny < 0 || nx >= w || ny >= h || wall[n]) break;\nconst i = at[n], q = i >= 0 ? pieces[i] : null;\nif (q && q.k === 'door' && !(open & (1 << q.key))) break;\nhalf[n * 4 + ((d + 2) & 3)] |= c;\nx = nx; y = ny;\nif (!reached[n]) { reached[n] = 1; order.push(n); }\nif (!q) continue;\nconst k = q.k;\nif (k === 'door') continue;\nif (k === 'mirror') { d = MIRROR[q.r][d]; continue; }\nif (k === 'splitter') { queue.push([x, y, MIRROR[q.r][d], c]); continue; }\nif (k === 'filter') { c &= q.c; if (!c) break; continue; }\nif (k === 'prism') {\nif (d === q.r) for (const [bit, e] of [[1, (d + 3) & 3], [2, d], [4, (d + 1) & 3]]) if (c & bit) queue.push([x, y, e, bit]);\nbreak;\n}\nif (k === 'lens' || k === 'shadow') { got[i] |= c; hits.push(i, c, order.length); }\nbreak;\n}\n}\nreturn { half, got, runs, order, hits };\n}\nfunction openedDoors(pieces, got) {\nlet keys = 0, lit = 0, dark = 0;\npieces.forEach((q, i) => { if (q.key && q.k === 'door') keys |= 1 << q.key; if (q.key && q.k === 'lens') { if (got[i] === q.c) lit |= 1 << q.key; else dark |= 1 << q.key; } });\nreturn keys & lit & ~dark;\n}\nfunction settle(room, pieces, skip = -1) {\nlet open = 0, t = null;\nfor (let pass = 0; pass < MAX_SETTLE; pass++) {\nt = trace(room, pieces, skip, open);\nconst next = openedDoors(pieces, t.got);\nif (next === open) break;\nopen = next;\n}\nt.open = open; return t;\n}\nfunction lensesLit(pieces, got) { return pieces.every((q, i) => (q.k === 'lens' ? got[i] === q.c : q.k === 'shadow' ? !got[i] : true)); }\nconst solvedBy = (room, pieces) => lensesLit(pieces, settle(room, pieces).got);\nfunction litCells(room, half) {\nconst { w, h } = room, out = new Uint8Array(w * h);\nfor (let i = 0; i < w * h; i++) if (half[i * 4] | half[i * 4 + 1] | half[i * 4 + 2] | half[i * 4 + 3]) {\nout[i] = 2; const x = i % w, y = (i / w) | 0;\nfor (let d = 0; d < 4; d++) { const nx = x + DX[d], ny = y + DY[d]; if (nx >= 0 && ny >= 0 && nx < w && ny < h && !out[ny * w + nx]) out[ny * w + nx] = 1; }\n}\nreturn out;\n}\nconst ROOMS = (() => { const b = rom('rooms'); let s = ''; for (let i = 0; i < b.length; i++) s += String.fromCharCode(b[i]); return s.split(/\\n(?=ROOM )/).filter((r) => r.startsWith('ROOM ')); })();\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst REPEAT_WAIT = 12, REPEAT_EVERY = 4;\nlet heldFor = 0;\nfunction dpad() {\nconst dirs = [UP, RIGHT, DOWN, LEFT], d = dirs.findIndex((b) => btn(b));\nif (d < 0) { heldFor = 0; return -1; }\nconst fresh = pressed(dirs[d]); heldFor = fresh ? 0 : heldFor + 1;\nreturn fresh || (heldFor >= REPEAT_WAIT && (heldFor - REPEAT_WAIT) % REPEAT_EVERY === 0) ? d : -1;\n}\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, solvedSel = 0, mapSel = 0, page = 0, afterPage = null, wasBest = 0;\nlet roomNo = 0, room = null, pieces = [], cx = 0, cy = 0, held = -1, light = null;\nlet hist = [], pos = 0, lastPiece = -1;\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nblend({ layers: ['overlay'], op: 'add' });\nfor (let c = 1; c <= 7; c++) {\nconst v = (bit, on, off) => (c & bit ? on : off);\ncolor(192 + c, v(1, 12, 0), v(2, 12, 0), v(4, 14, 0));\ncolor(200 + c, v(1, 31, 10), v(2, 31, 10), v(4, 31, 10));\n}\nif (skipTitle) startGame(); else toTitle();\n}\nconst TOWER = { x: 184, top: 54, foot: 190 };\nconst CUT = { x: 16, y0: 168, step: 40, h: 36, win: 21 };\nconst STAMP = { mx: 0, my: 100 };\nconst ROOM_BG0 = 128, ROOM_BG1 = 96;\nlet screen = '';\nfunction setScreen(k) {\nif (k === screen) return;\nscreen = k;\nconst S = ART.scenes, show = (i, sc, wrap = false) => bg(i, { mx: sc.mx, my: sc.my, mw: sc.w, mh: sc.h, x: 0, y: 0, wrap, show: true });\nif (k === 'room') {\nbg(0, { mx: ROOM_BG0, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: false, show: true });\nbg(1, { mx: ROOM_BG1, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: false, show: true });\nshow(2, S.sea, true); color(0, 0, 0, 1);\n} else {\nbg(0, { show: false });\nshow(1, k === 'cut' ? S.cutaway : S.title); show(2, S.stars);\n}\n}\nfunction loadTheme(f) {\nconst b = rom('themes');\nfor (let p = 0; p < 3; p++) for (let i = 0; i < 15; i++) {\nconst o = ((f * 3 + p) * 15 + i) * 2, v = b[o] | (b[o + 1] << 8);\ncolor(16 * (p + 1) + 1 + i, v & 31, (v >> 5) & 31, v >> 10);\n}\n}\nfunction stamp(base, tx, ty, sc, sr, pal = -1, off = false) {\nfor (let j = 0; j < 2; j++) for (let i = 0; i < 2; i++) {\nlet e = off ? 0 : mget(STAMP.mx + sc * 2 + i, STAMP.my + sr * 2 + j);\nif (e && pal >= 0) e = (e & ~(7 << 10)) | (pal << 10);\nmset(base + tx + i, ty + j, e);\n}\n}\nconst hash2 = (x, y) => ((x * 73856093) ^ (y * 19349663) ^ (roomNo * 83492791)) >>> 0;\nfunction isWindow(x, y) {\nconst { w, h, wall } = room;\nif (wall[y * w + x] === 3) return true;\nif (wall[y * w + x] !== 1) return false;\nconst edge = x === 0 || y === 0 || x === w - 1 || y === h - 1, corner = (x === 0 || x === w - 1) && (y === 0 || y === h - 1);\nconst inward = [0, 1, 2, 3].some((d) => { const nx = x + DX[d], ny = y + DY[d]; return nx >= 0 && ny >= 0 && nx < w && ny < h && !room.wall[ny * w + nx]; });\nreturn edge && !corner && inward && (x + y) % 3 === 1;\n}\nfunction buildRoom() {\nconst f = Math.floor(roomNo / FLOOR_ROOMS), X = ox() / 8, Y = oy() / 8, { w, h, wall } = room;\nloadTheme(f);\nfor (let ty = 0; ty < 28; ty += 2) for (let tx = 0; tx < 32; tx += 2) { stamp(ROOM_BG1, tx, ty, 4 + ((tx + ty) & 2 ? 1 : 0), 4); stamp(ROOM_BG0, tx, ty, 0, 0, -1, true); }\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nconst v = wall[y * w + x], tx = X + 2 * x, ty = Y + 2 * y;\nif (v === 2) continue;\nif (v) { stamp(ROOM_BG0, tx, ty, isWindow(x, y) ? 2 : hash2(x, y) % 5 ? 0 : 1, 4); stamp(ROOM_BG1, tx, ty, 0, 0, -1, true); }\n}\npaintRoom();\n}\nfunction paintRoom() {\nconst f = Math.floor(roomNo / FLOOR_ROOMS), X = ox() / 8, Y = oy() / 8, { w, h, wall } = room, lit = light.lit;\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nconst v = wall[y * w + x], tx = X + 2 * x, ty = Y + 2 * y, seen = seenCell(x, y);\nif (v === 2) continue;\nif (!seen) { stamp(ROOM_BG0, tx, ty, 0, 0, -1, true); stamp(ROOM_BG1, tx, ty, 6, 4); continue; }\nif (v) { if (room.dark) { stamp(ROOM_BG0, tx, ty, isWindow(x, y) ? 2 : hash2(x, y) % 5 ? 0 : 1, 4); stamp(ROOM_BG1, tx, ty, 0, 0, -1, true); } continue; }\nconst under = y > 0 && (wall[(y - 1) * w + x] === 1 || wall[(y - 1) * w + x] === 3);\nstamp(ROOM_BG1, tx, ty, (hash2(x, y) >>> 3) % 4 + (under ? 4 : 0), f, lit[y * w + x] ? 2 : 1);\n}\n}\nconst seenCell = (x, y) => !room.dark || light.lit[y * room.w + x] || (Math.abs(x - cx) <= 1 && Math.abs(y - cy) <= 1);\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\nfunction startGame() { loadRoom(0); }\nfunction startPlay() { if (!storySeen(0)) showPage(0, () => toMap(nextRoom())); else toMap(nextRoom()); }\nfunction toMap(n) { state = 'map'; timer = 0; paused = false; mapSel = n; play(SONG.floors[Math.floor(n / FLOOR_ROOMS)]); }\nfunction showPage(k, then) { state = 'story'; timer = 0; page = k; afterPage = then; dset(STORY_SLOT, dget(STORY_SLOT) | (1 << k)); play(k === ENDED ? SONG.ending : SONG.title); }\nfunction loadRoom(n) {\nroomNo = n; room = parseRoom(ROOMS[n]); pieces = room.pieces.map((q) => ({ ...q }));\nconst first = pieces.find((q) => q.mode === 'free') || { x: 1, y: 1 };\ncx = first.x; cy = first.y; held = -1; hist = [snap()]; pos = 0; lastPiece = -1;\nstate = 'play'; timer = 0; paused = false; screen = ''; setScreen('room'); light = null; relight(true); buildRoom();\ndset(LAST_SLOT, n + 1); play(SONG.floors[Math.floor(n / FLOOR_ROOMS)]);\n}\nconst snap = () => pieces.map((q) => [q.x, q.y, q.r]);\nconst restore = (sn) => sn.forEach(([x, y, r], i) => Object.assign(pieces[i], { x, y, r }));\nconst same = (a, b) => a.every((v, i) => v[0] === b[i][0] && v[1] === b[i][1] && v[2] === b[i][2]);\nconst moves = () => pos;\nfunction relight(quiet = false) {\nconst was = light, before = was ? pieces.map((q, i) => q.k === 'lens' && was.got[i] === q.c) : [];\nlight = settle(room, pieces, held); light.lit = litCells(room, light.half); if (screen === 'room') paintRoom();\nif (quiet || !was) return;\nconst now = pieces.findIndex((q, i) => q.k === 'lens' && light.got[i] === q.c && !before[i]);\nif (now >= 0) fx(SFX.lens + pieces[now].c - 1);\nif (light.open & ~was.open) fx(SFX.door);\n}\nconst pieceAt = (x, y) => pieces.findIndex((q, i) => i !== held && q.x === x && q.y === y);\nfunction changed(i) {\nconst now = snap();\nif (lastPiece === i && pos > 0) { hist[pos] = now; if (same(now, hist[pos - 1])) { pos--; hist.length = pos + 1; lastPiece = -1; } }\nelse if (!same(now, hist[pos])) { hist.length = pos + 1; hist.push(now); pos++; lastPiece = i; }\nrelight();\n}\nlet flash = 0, thunderIn = 0, nextBolt = 900;\nconst LIGHTNING = 6;\nfunction storm() {\nif (--nextBolt <= 0 && !paused) { flash = LIGHTNING; thunderIn = 40 + rndi(0, 50); nextBolt = 1200 + rndi(0, 1800); }\nif (thunderIn > 0 && --thunderIn === 0) fx(SFX.thunder);\nif (flash > 0) flash--;\n}\nconst lift = (c, k) => c + (((31 - c) * k) >> 5);\nfunction update() {\ninputMask = readPad(); clock++; storm();\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'play') updatePlay();\nelse if (state === 'solved') updateSolved();\nelse if (state === 'map') updateMap();\nelse if (state === 'story') updateStory();\nelse if (state === 'records') updateRecords();\nprevMask = inputMask;\n}\nfunction updateTitle() {\nif (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (titleSel === 0) startPlay(); else { state = 'records'; timer = 0; }\n}\n}\nfunction updatePlay() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nconst d = dpad();\nif (d >= 0) {\nconst nx = cx + DX[d], ny = cy + DY[d];\nif (nx >= 0 && ny >= 0 && nx < room.w && ny < room.h && room.wall[ny * room.w + nx] !== 2) { cx = nx; cy = ny; fx(SFX.move); if (room.dark) paintRoom(); }\n}\nif (pressed(A)) {\nif (held < 0) {\nconst i = pieceAt(cx, cy);\nif (i >= 0 && pieces[i].mode === 'free') { held = i; relight(); fx(SFX.pick); } else fx(SFX.no);\n} else if (!room.wall[cy * room.w + cx] && pieceAt(cx, cy) < 0) {\nconst i = held; held = -1; pieces[i].x = cx; pieces[i].y = cy; changed(i); fx(SFX.drop);\n} else fx(SFX.no);\n}\nconst turn = pressed(B) ? 1 : pressed(Y) ? -1 : 0;\nif (turn) {\nconst i = held >= 0 ? held : pieceAt(cx, cy), q = pieces[i];\nif (q && q.mode !== 'fixed' && TURNS[q.k] > 1) { q.r = (q.r + turn + TURNS[q.k]) % TURNS[q.k]; changed(i); fx(SFX.turn); } else fx(SFX.no);\n}\nif (pressed(SELECT) || pressed(L)) undo();\nif (pressed(R)) redo();\nif (held < 0 && lensesLit(pieces, light.got)) roomSolved();\n}\nfunction undo() {\nif (held >= 0) { held = -1; relight(); fx(SFX.undo); return; }\nif (pos === 0) { relight(); fx(SFX.no); return; }\npos--; restore(hist[pos]); lastPiece = -1; relight(); fx(SFX.undo);\n}\nfunction redo() {\nif (held >= 0 || pos >= hist.length - 1) { fx(SFX.no); return; }\npos++; restore(hist[pos]); lastPiece = -1; relight(); fx(SFX.redo);\n}\nfunction roomSolved() {\nstate = 'solved'; timer = 0; solvedSel = 0; fx(SFX.solved);\nwasBest = best(roomNo);\nif (!wasBest || moves() < wasBest) dset(BEST_SLOT + roomNo, moves());\n}\nconst SOLVED_ITEMS = () => [roomNo === ROOMS.length - 1 ? 'THE LAMP' : (roomNo + 1) % FLOOR_ROOMS ? 'NEXT ROOM' : 'UP THE STAIR', 'REPLAY', 'FLOOR MAP'];\nfunction updateSolved() {\nif (timer === 24 && moves() <= room.par) fx(SFX.star);\nif (timer < 30) return;\nif (pressed(UP)) { solvedSel = (solvedSel + 2) % 3; fx(SFX.move); }\nif (pressed(DOWN)) { solvedSel = (solvedSel + 1) % 3; fx(SFX.move); }\nif (!(pressed(A) || pressed(START))) return;\nfx(SFX.select);\nif (solvedSel === 1) { loadRoom(roomNo); return; }\nif (solvedSel === 2) { toMap(roomNo); return; }\ngoOn();\n}\nfunction goOn() {\nconst n = roomNo + 1, k = Math.floor(roomNo / FLOOR_ROOMS) + 1;\nif (n === ROOMS.length) { showPage(ENDED, toTitle); return; }\nif (n % FLOOR_ROOMS === 0 && !storySeen(k)) { fx(SFX.stair); showPage(k, () => toMap(n)); return; }\nloadRoom(n);\n}\nfunction updateMap() {\nconst f = Math.floor(mapSel / FLOOR_ROOMS), r = mapSel % FLOOR_ROOMS;\nlet to = -1;\nif (pressed(LEFT) && r > 0) to = mapSel - 1;\nif (pressed(RIGHT) && r < FLOOR_ROOMS - 1) to = mapSel + 1;\nif (pressed(UP) && f < 3) to = mapSel + FLOOR_ROOMS;\nif (pressed(DOWN) && f > 0) to = mapSel - FLOOR_ROOMS;\nif (to >= 0) { if (opened(to)) { mapSel = to; fx(SFX.move); play(SONG.floors[Math.floor(to / FLOOR_ROOMS)]); } else fx(SFX.no); }\nif ((pressed(A) || pressed(START)) && timer > 10) { fx(SFX.select); loadRoom(mapSel); }\nelse if (pressed(B)) { fx(SFX.select); toTitle(); }\n}\nfunction updateStory() {\nif (timer > 30 && (pressed(A) || pressed(B) || pressed(START))) { fx(SFX.page); afterPage(); }\n}\nfunction updateRecords() {\nif ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\nconst PAUSE_ITEMS = ['RESUME', 'RESTART ROOM', 'FLOOR MAP', 'QUIT TO TITLE'];\nfunction updatePause() {\nif (pressed(UP)) { pauseSel = (pauseSel + 3) % 4; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 4; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) loadRoom(roomNo);\nelse if (pauseSel === 2) toMap(roomNo);\nelse toTitle();\n}\n}\nconst CELL = 16;\nconst ox = () => 16 + (14 - room.w) * 8, oy = () => 24 + (12 - room.h) * 8;\nfunction draw() {\ncls();\nif (flash || flashWas) {\nconst k = flash ? (flash > LIGHTNING / 2 ? 22 : 12) : 0;\nfor (const base of [64, 112]) for (let i = 1; i < 16; i++) { const v = PALETTE0[base + i]; color(base + i, lift(v & 31, k), lift((v >> 5) & 31, k), lift(v >> 10, k)); }\nflashWas = flash;\n}\nsetScreen(state === 'play' || state === 'solved' ? 'room' : state === 'map' ? 'cut' : 'sky');\nif (screen === 'room') bgscroll(2, (clock >> 3) % 64, (clock >> 4) % 32);\nif (state === 'play' || state === 'solved') drawPlay();\nelse if (state === 'title') drawTitle();\nelse if (state === 'map') drawMap();\nelse if (state === 'story') drawStory();\nelse if (state === 'records') drawRecords();\nif (state === 'solved') drawSolved();\nif (paused) drawPause();\n}\nfunction drawPlay() {\nconst X = ox(), Y = oy();\npieces.forEach((q, i) => { if (i !== held && seenCell(q.x, q.y)) drawPiece(q, X + q.x * CELL, Y + q.y * CELL, light.got[i]); });\ndrawBeams(X, Y);\npieces.forEach((q, i) => { if (i !== held && seenCell(q.x, q.y)) drawGlass(q, X + q.x * CELL, Y + q.y * CELL, light.got[i]); });\nif (held >= 0) { drawPiece(pieces[held], X + cx * CELL, Y + cy * CELL - 3, 0); drawGlass(pieces[held], X + cx * CELL, Y + cy * CELL - 3, 0); }\nif (state === 'play' && clock % 40 < 30) sprite(ART.sprites.cursor, X + cx * CELL, Y + cy * CELL);\nrectfill(0, 0, 256, 20, SHADOW); line(0, 20, 255, 20, PANEL);\ntxt(`${roomNo + 1} ${room.name}`, 8, 6, WHITE);\nconst m = `MOVES ${moves()}/${room.par}`; txt(m, 248 - m.length * 8, 6, moves() <= room.par ? GOLD : DIM);\n}\nfunction drawBeams(X, Y) {\nconst { w, h } = room, H = light.half;\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nconst k = (y * w + x) * 4, mx = X + x * CELL + 8, my = Y + y * CELL + 8;\nlet all = 0;\nfor (let d = 0; d < 4; d++) {\nconst c = H[k + d]; if (!c) continue; all |= c;\nconst ex = mx + DX[d] * 8, ey = my + DY[d] * 8;\nif (DX[d]) { rectfill(Math.min(mx, ex), my - 1, 9, 3, 192 + c); line(mx, my, ex, ey, 200 + c); }\nelse { rectfill(mx - 1, Math.min(my, ey), 3, 9, 192 + c); line(mx, my, ex, ey, 200 + c); }\n}\nif (all) rectfill(mx - 1, my - 1, 3, 3, 200 + all);\n}\n}\nfunction drawPiece(q, px, py, got) {\nconst S = ART.sprites, k = q.k, r = q.r;\nlet s = null, o = {};\nif (k === 'lantern') { s = r & 1 ? S.lantern_e : S.lantern_n; o = { fx: r === 3, fy: r === 2 }; }\nelse if (k === 'mirror' || k === 'splitter') { s = S[k + (q.mode === 'fixed' ? '_fixed' : '')]; o = { fx: r === 1 }; }\nelse if (k === 'prism') { s = r & 1 ? S.prism_e : S.prism_n; o = { fx: r === 3, fy: r === 2 }; }\nelse if (k === 'filter') s = S.filter;\nelse if (k === 'lens') s = S.lens;\nelse if (k === 'shadow') s = got ? S.shadow_lit : S.shadow;\nelse if (k === 'door') s = light.open & (1 << q.key) ? S.door_open : S.door_shut;\nif (s) sprite(s, px, py, o);\nif (q.mode === 'bolted') sprite(S.bolt, px, py);\n}\nfunction drawGlass(q, px, py, got) {\nconst mx = px + 8, my = py + 8;\nif (q.k === 'lens') {\nconst on = got === q.c;\ncircfill(mx, my, 4, on ? 200 + q.c : 192 + q.c);\nif (on) { circ(mx, my, 7 + (clock >> 3) % 2, 192 + q.c); pset(mx - 1, my - 2, 207); }\nif (q.key) pset(mx, my, SHADOW);\n} else if (q.k === 'filter') rectfill(px + 3, py + 3, 10, 10, 192 + q.c);\nelse if (q.k === 'lantern') { const gx = mx + DX[q.r] * 6, gy = my + DY[q.r] * 6; rectfill(gx - 2, gy - 2, 4, 4, 200 + q.c); }\n}\nconst towerWindow = (n) => [TOWER.x - 11 + (n % 10 % 5) * 5, TOWER.foot - 18 - Math.floor(n / 10) * 32 - Math.floor(n % 10 / 5) * 9];\nfunction drawTower() {\nfor (let n = 0; n < ROOMS.length; n++) if (solved(n)) {\nconst [x, y] = towerWindow(n); rectfill(x, y, 3, 5, GOLD); if (starred(n)) pset(x + 1, y + 1, WHITE);\n}\nif (storySeen(ENDED)) {\nconst lx = TOWER.x, ly = TOWER.top - 10, a = clock / 90, s = Math.sin(a);\ncircfill(lx, ly, 4, 207);\nfor (let k = -2; k <= 2; k++) line(lx, ly, lx + s * 200, ly + k * 6 + Math.cos(a) * 10, 199);\n}\n}\nfunction drawTitle() {\ndrawTower();\ntxt('LANTERN', 24, 40, GOLD); txt('KEEPER', 32, 54, GOLD);\n['PLAY', 'RECORDS'].forEach((t, i) => txt(`${i === titleSel ? '> ' : '  '}${t}`, 32, 100 + i * 14, i === titleSel ? WHITE : DIM));\nlet lit = 0; for (let n = 0; n < ROOMS.length; n++) if (solved(n)) lit++;\nif (lit) txt(`${lit}/${ROOMS.length} ROOMS LIT`, 24, 140, DIM);\n}\nfunction drawMap() {\nconst sf = Math.floor(mapSel / FLOOR_ROOMS);\nfor (let f = 0; f < 4; f++) {\nconst y = CUT.y0 - f * CUT.step, reached = opened(f * FLOOR_ROOMS);\ntxt(`${f + 1} ${FLOOR_NAMES[f]}`, CUT.x + 6, y + 3, f === sf ? GOLD : reached ? WHITE : 3);\nfor (let i = 0; i < FLOOR_ROOMS; i++) {\nconst n = f * FLOOR_ROOMS + i, wx = CUT.x + 6 + i * CUT.win, wy = y + 14;\nif (!opened(n)) for (let k = 1; k < 15; k += 3) line(wx, wy + k, wx + 14, wy + k, 4);\nelse if (solved(n)) { rectfill(wx, wy, 15, 15, 194 + (n % 2)); rectfill(wx + 2, wy + 2, 11, 11, 203); }\nif (starred(n)) { pset(wx + 7, wy + 3, WHITE); rectfill(wx + 4, wy + 6, 7, 2, WHITE); rectfill(wx + 6, wy + 5, 3, 5, WHITE); pset(wx + 5, wy + 10, WHITE); pset(wx + 9, wy + 10, WHITE); }\nif (n === mapSel && clock % 40 < 30) sprite(ART.sprites.cursor, wx - 1, wy - 1);\n}\n}\nconst n = mapSel;\nrectfill(0, 0, 256, 20, SHADOW); line(0, 20, 255, 20, PANEL);\ntxt(`${n + 1} ${nameRoom(n)}`, 8, 6, WHITE);\ntxt(solved(n) ? `BEST ${best(n)}  PAR ${parRoom(n)}${starred(n) ? '  STAR' : ''}` : `PAR ${parRoom(n)}`, 16, 210, solved(n) ? GOLD : DIM);\ntxt('B: TITLE', 184, 210, DIM);\n}\nconst STORY = [\n['THE STORM CAME UP', 'AT DUSK, AND THE', 'GREAT LAMP OF', 'GREYWATER LIGHT', 'WENT OUT.', '', 'SHIPS ARE OUT', 'THERE IN THE DARK.', '', 'CARRY THE LIGHT', 'UP, ROOM BY ROOM,', 'TO THE LAMP.'],\n['THE STAIR IS LIT.', '', 'THE OLD KEEPER\\'S', 'MIRRORS STILL', 'TURN TRUE.'],\n['THE GLASS ROOM', 'RINGS WITH COLOUR.', '', 'ABOVE IT, THE', 'CLOCKWORK WAITS.'],\n['THE GEARS TURN.', '', 'ONLY THE LAMP', 'GALLERY IS LEFT,', 'DARK AS THE SEA.'],\n['THE GREAT LAMP', 'BURNS.', '', 'ITS BEAM SWEEPS', 'THE WATER, AND ONE', 'BY ONE THE SHIPS', 'TURN FOR HOME.', '', 'DAWN COMES UP', 'OVER GREYWATER.'],\n]\nfunction drawStory() {\ndrawTower();\nconst lines = STORY[page], y0 = 100 - lines.length * 6;\nlines.forEach((l, i) => txt(l, 12, y0 + i * 12, i === 0 ? GOLD : WHITE));\nif (timer > 30 && timer % 60 < 40) txt('A: ON', 24, 200, DIM);\n}\nfunction drawRecords() {\npanel(24, 16, 208, 192);\nctxt('RECORDS', 24, GOLD);\nlet lit = 0, stars = 0, mv = 0, par = 0;\nfor (let n = 0; n < ROOMS.length; n++) if (solved(n)) { lit++; mv += best(n); par += parRoom(n); if (starred(n)) stars++; }\ntxt(`ROOMS LIT   ${lit} OF ${ROOMS.length}`, 40, 52, WHITE);\ntxt(`STARS       ${stars} OF ${ROOMS.length}`, 40, 66, WHITE);\ntxt(`MOVES       ${mv} (PAR ${par})`, 40, 80, lit ? WHITE : DIM);\nFLOOR_NAMES.forEach((f, k) => {\nlet s = 0; for (let n = k * FLOOR_ROOMS; n < (k + 1) * FLOOR_ROOMS; n++) if (starred(n)) s++;\ntxt(f, 40, 108 + k * 14, opened(k * FLOOR_ROOMS) ? WHITE : DIM); txt(`${s}/10`, 176, 108 + k * 14, s === 10 ? GOLD : DIM);\n});\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawSolved() {\npanel(40, 138, 176, 82);\nconst star = moves() <= room.par;\nctxt('THE ROOM IS LIT', 143, GOLD);\nctxt(`${moves()} MOVES  PAR ${room.par}${star ? '  STAR' : ''}`, 155, star ? GOLD : WHITE);\nif (wasBest && moves() < wasBest) ctxt(`A NEW BEST (WAS ${wasBest})`, 167, WHITE);\nSOLVED_ITEMS().forEach((t, i) => txt(`${i === solvedSel ? '>' : ' '} ${t}`, 80, 182 + i * 11, timer < 30 ? 1 : i === solvedSel ? WHITE : DIM));\n}\nfunction drawPause() {\npanel(56, 72, 144, 76);\nctxt('PAUSED', 80, GOLD);\nPAUSE_ITEMS.forEach((t, i) => txt(`${i === pauseSel ? '>' : ' '} ${t}`, 72, 96 + i * 11, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SHADOW); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nfunction scanline(y) {\nif (screen === 'room') return;\ngradientLine(ART.gradients.sky, y);\nif (flash) { const [r, g, b] = color(0), k = flash > LIGHTNING / 2 ? 14 : 6; color(0, lift(r, k), lift(g, k), lift(b, k)); }\n}\nlet flashWas = 0;\nconst PALETTE0 = (() => { const out = []; for (let i = 0; i < 128; i++) { const [r, g, b] = color(i); out.push(r | (g << 5) | (b << 10)); } return out; })();\n",

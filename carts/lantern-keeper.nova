{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Lantern Keeper",
    "author": "NOVA-16",
    "description": "The great lamp of Greywater Light has gone out in a storm. Move and turn mirrors, splitters, prisms and coloured glass to carry the beam to every lens, through forty rooms on four floors up to the lamp. Each room has a par to beat for its star."
  },
  "label": null,
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {},\nsprites: {\"gem\": {\"pal\": 0, \"size\": 16, \"tile\": 258}, \"player\": {\"pal\": 0, \"size\": 16, \"tile\": 256}},\nscenes: {\"field\": {\"h\": 8, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hills\": {\"h\": 8, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}},\ncolors: {\"GLASS\": 200},\ngradients: {\"sky\":{\"entry\":0,\"lines\":[13475,13475,13475,13475,13475,13475,13475,14499,14499,14531,14531,14532,14532,14532,14532,14532,14532,15556,15556,15556,15556,15556,15588,15588,15588,15588,15588,16612,16612,16612,16612,16612,16612,16612,16645,16645,16645,17669,17669,17669,17669,17669,17669,17669,17669,17669,18725,18725,18725,18725,18725,18725,18725,18725,18725,19749,19750,19750,19782,19782,19782,19782,19782,19782,19782,20806,20806,20806,20806,20806,20838,20838,20838,20838,21862,21862,21862,21863,21863,21863,21863,21863,21895,22919,22919,22919,22919,22919,22919,22919,22919,22951,22952,22952,23976,23976,23976,23976,24008,24008,24009,24009,24009,24009,24041,24041,25065,25065,25066,25066,25066,25098,25098,25098,25098,25099,25099,25131,26155,26155,26155,26155,26155,26156,26188,26188,26188,26188,26188,26188,27245,27245,27245,27245,27245,27245,27245,27278,27278,27278,27278,27278,28302,28334,28335,28335,28335,28335,28335,28335,28367,28368,28368,28368,28368,29392,29424,29424,29425,29425,29425,29425,29457,29457,29457,29458,29458,29458,30482,30514,30514,30514,30515,30515,30515,30547],\"y0\":0}},\n};\nfunction gradientLine(g, y) {\nconst v = g.lines[y - g.y0];\nif (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, pick: 3, no: 4, drop: 5, solved: 6, turn: 0, undo: 1 };\nconst SONG = { title: 0, floors: [1, 2, 3, 4], ending: 5 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, LAST_SLOT = 1, STORY_SLOT = 2, BEST_SLOT = 10;\nconst FLOOR_ROOMS = 10, FLOOR_NAMES = ['THE STAIR', 'THE GLASS ROOM', 'THE CLOCKWORK', 'THE LAMP GALLERY'];\nconst best = (n) => dget(BEST_SLOT + n);\nconst solved = (n) => best(n) > 0;\nconst opened = (n) => n === 0 || solved(n - 1);\nconst starred = (n) => solved(n) && best(n) <= parRoom(n);\nconst parRoom = (n) => +/PAR (\\d+)/.exec(ROOMS[n])[1];\nconst nameRoom = (n) => /^ROOM (.*?) PAR/.exec(ROOMS[n])[1];\nconst nextRoom = () => { let n = 0; while (n < ROOMS.length - 1 && solved(n)) n++; return n; };\nconst storySeen = (k) => (dget(STORY_SLOT) >> k) & 1;\nconst ENDED = 4;\nconst DX = [0, 1, 0, -1];\nconst DY = [-1, 0, 1, 0];\nconst WHITE_LIGHT = 7;\nconst COLOURS = { red: 1, green: 2, blue: 4, yellow: 3, magenta: 5, cyan: 6, white: 7 };\nconst MIRROR = [[1, 0, 3, 2], [3, 2, 1, 0]];\nconst TURNS = { lantern: 4, mirror: 2, splitter: 2, prism: 4, filter: 1, lens: 1, shadow: 1, door: 1 };\nconst MODE = { lantern: 'fixed', mirror: 'free', splitter: 'free', prism: 'free', filter: 'fixed', lens: 'fixed', shadow: 'fixed', door: 'fixed' };\nconst MAX_RUNS = 512;\nconst MAX_SETTLE = 8;\nfunction parseRoom(text) {\nconst lines = text.split('\\n').filter((l) => l.trim().length && !l.startsWith('//'));\nconst head = /^ROOM\\s+(.*?)\\s+PAR\\s+(\\d+)(\\s+DARK)?\\s*$/.exec(lines[0].trim());\nconst map = lines.slice(1).filter((l) => !/^[A-Za-z]:/.test(l)), legend = {};\nfor (const l of lines.slice(1)) {\nconst m = /^([A-Za-z]):\\s*(.*)$/.exec(l); if (!m) continue;\nconst t = m[2].trim().split(/\\s+/), d = { k: t[0], r: 0, c: 0, mode: MODE[t[0]], key: 0 };\nfor (const w of t.slice(1)) {\nif ('NESW'.includes(w) && w.length === 1) d.r = 'NESW'.indexOf(w);\nelse if (w === '/' || w === '\\\\') d.r = w === '/' ? 0 : 1;\nelse if (COLOURS[w]) d.c = COLOURS[w];\nelse if (w === 'free' || w === 'bolted' || w === 'fixed') d.mode = w;\nelse if (/^key\\d$/.test(w)) d.key = +w[3];\n}\nif ((d.k === 'lantern' || d.k === 'lens') && !d.c) d.c = WHITE_LIGHT;\nlegend[m[1]] = d;\n}\nconst h = map.length, w = Math.max(...map.map((l) => l.length));\nconst wall = new Uint8Array(w * h), pieces = [];\nconst put = (d, x, y) => pieces.push({ k: d.k, x, y, r: d.r, c: d.c, mode: d.mode, key: d.key || 0 });\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nconst ch = map[y][x] || ' ', i = y * w + x;\nif (ch === '#') wall[i] = 1;\nelse if (ch === '=') wall[i] = 3;\nelse if (ch === ' ') wall[i] = 2;\nelse if ('^>v<'.includes(ch)) put({ k: 'lantern', r: '^>v<'.indexOf(ch), c: WHITE_LIGHT, mode: 'fixed' }, x, y);\nelse if (ch === '/' || ch === '\\\\') put({ k: 'mirror', r: ch === '/' ? 0 : 1, c: 0, mode: 'free' }, x, y);\nelse if (ch === 'o') put({ k: 'lens', r: 0, c: WHITE_LIGHT, mode: 'fixed' }, x, y);\nelse if (ch === 'x') put({ k: 'shadow', r: 0, c: 0, mode: 'fixed' }, x, y);\nelse if (legend[ch]) put(legend[ch], x, y);\n}\nreturn { name: head ? head[1] : '?', par: head ? +head[2] : 0, dark: !!(head && head[3]), w, h, wall, pieces };\n}\nfunction trace(room, pieces, skip = -1, open = 0, buf = null) {\nconst { w, h, wall } = room, size = w * h;\nconst at = buf ? buf.at.fill(-1) : new Int16Array(size).fill(-1);\npieces.forEach((q, i) => { if (i !== skip && q.x >= 0) at[q.y * w + q.x] = i; });\nconst half = buf ? buf.half.fill(0) : new Uint8Array(size * 4), got = buf ? buf.got.fill(0) : new Uint8Array(pieces.length);\nconst seen = buf ? buf.seen.fill(0) : new Uint8Array(size * 4), reached = buf ? buf.reached.fill(0) : new Uint8Array(size);\nconst order = [], queue = [], hits = [];\npieces.forEach((q, i) => { if (i !== skip && q.x >= 0 && q.k === 'lantern') queue.push([q.x, q.y, q.r, q.c]); });\nlet runs = 0;\nwhile (queue.length && runs < MAX_RUNS) {\nlet [x, y, d, c] = queue.shift(); runs++;\nfor (;;) {\nconst s = (y * w + x) * 4 + d;\nif ((seen[s] & c) === c) break;\nseen[s] |= c; half[s] |= c;\nconst nx = x + DX[d], ny = y + DY[d], n = ny * w + nx;\nif (nx < 0 || ny < 0 || nx >= w || ny >= h || wall[n]) break;\nconst i = at[n], q = i >= 0 ? pieces[i] : null;\nif (q && q.k === 'door' && !(open & (1 << q.key))) break;\nhalf[n * 4 + ((d + 2) & 3)] |= c;\nx = nx; y = ny;\nif (!reached[n]) { reached[n] = 1; order.push(n); }\nif (!q) continue;\nconst k = q.k;\nif (k === 'door') continue;\nif (k === 'mirror') { d = MIRROR[q.r][d]; continue; }\nif (k === 'splitter') { queue.push([x, y, MIRROR[q.r][d], c]); continue; }\nif (k === 'filter') { c &= q.c; if (!c) break; continue; }\nif (k === 'prism') {\nif (d === q.r) for (const [bit, e] of [[1, (d + 3) & 3], [2, d], [4, (d + 1) & 3]]) if (c & bit) queue.push([x, y, e, bit]);\nbreak;\n}\nif (k === 'lens' || k === 'shadow') { got[i] |= c; hits.push(i, c, order.length); }\nbreak;\n}\n}\nreturn { half, got, runs, order, hits };\n}\nfunction openedDoors(pieces, got) {\nlet keys = 0, lit = 0, dark = 0;\npieces.forEach((q, i) => { if (q.key && q.k === 'door') keys |= 1 << q.key; if (q.key && q.k === 'lens') { if (got[i] === q.c) lit |= 1 << q.key; else dark |= 1 << q.key; } });\nreturn keys & lit & ~dark;\n}\nfunction settle(room, pieces, skip = -1) {\nlet open = 0, t = null;\nfor (let pass = 0; pass < MAX_SETTLE; pass++) {\nt = trace(room, pieces, skip, open);\nconst next = openedDoors(pieces, t.got);\nif (next === open) break;\nopen = next;\n}\nt.open = open; return t;\n}\nfunction lensesLit(pieces, got) { return pieces.every((q, i) => (q.k === 'lens' ? got[i] === q.c : q.k === 'shadow' ? !got[i] : true)); }\nconst solvedBy = (room, pieces) => lensesLit(pieces, settle(room, pieces).got);\nfunction litCells(room, half) {\nconst { w, h } = room, out = new Uint8Array(w * h);\nfor (let i = 0; i < w * h; i++) if (half[i * 4] | half[i * 4 + 1] | half[i * 4 + 2] | half[i * 4 + 3]) {\nout[i] = 2; const x = i % w, y = (i / w) | 0;\nfor (let d = 0; d < 4; d++) { const nx = x + DX[d], ny = y + DY[d]; if (nx >= 0 && ny >= 0 && nx < w && ny < h && !out[ny * w + nx]) out[ny * w + nx] = 1; }\n}\nreturn out;\n}\nconst ROOMS = (() => { const b = rom('rooms'); let s = ''; for (let i = 0; i < b.length; i++) s += String.fromCharCode(b[i]); return s.split(/\\n(?=ROOM )/).filter((r) => r.startsWith('ROOM ')); })();\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst REPEAT_WAIT = 12, REPEAT_EVERY = 4;\nlet heldFor = 0;\nfunction dpad() {\nconst dirs = [UP, RIGHT, DOWN, LEFT], d = dirs.findIndex((b) => btn(b));\nif (d < 0) { heldFor = 0; return -1; }\nconst fresh = pressed(dirs[d]); heldFor = fresh ? 0 : heldFor + 1;\nreturn fresh || (heldFor >= REPEAT_WAIT && (heldFor - REPEAT_WAIT) % REPEAT_EVERY === 0) ? d : -1;\n}\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, solvedSel = 0, mapSel = 0, page = 0, afterPage = null, wasBest = 0;\nlet roomNo = 0, room = null, pieces = [], cx = 0, cy = 0, held = -1, light = null;\nlet hist = [], pos = 0, lastPiece = -1;\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nfor (let i = 0; i < 3; i++) bg(i, { show: false });\ncolor(0, 2, 2, 4);\nblend({ layers: ['overlay'], op: 'add' });\nfor (let c = 1; c <= 7; c++) {\nconst v = (bit, on, off) => (c & bit ? on : off);\ncolor(192 + c, v(1, 12, 0), v(2, 12, 0), v(4, 14, 0));\ncolor(200 + c, v(1, 31, 10), v(2, 31, 10), v(4, 31, 10));\n}\nif (skipTitle) startGame(); else toTitle();\n}\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\nfunction startGame() { loadRoom(0); }\nfunction startPlay() { if (!storySeen(0)) showPage(0, () => toMap(nextRoom())); else toMap(nextRoom()); }\nfunction toMap(n) { state = 'map'; timer = 0; paused = false; mapSel = n; play(SONG.floors[Math.floor(n / FLOOR_ROOMS)]); }\nfunction showPage(k, then) { state = 'story'; timer = 0; page = k; afterPage = then; dset(STORY_SLOT, dget(STORY_SLOT) | (1 << k)); play(k === ENDED ? SONG.ending : SONG.title); }\nfunction loadRoom(n) {\nroomNo = n; room = parseRoom(ROOMS[n]); pieces = room.pieces.map((q) => ({ ...q }));\nconst first = pieces.find((q) => q.mode === 'free') || { x: 1, y: 1 };\ncx = first.x; cy = first.y; held = -1; hist = [snap()]; pos = 0; lastPiece = -1;\nstate = 'play'; timer = 0; paused = false; relight();\ndset(LAST_SLOT, n + 1); play(SONG.floors[Math.floor(n / FLOOR_ROOMS)]);\n}\nconst snap = () => pieces.map((q) => [q.x, q.y, q.r]);\nconst restore = (sn) => sn.forEach(([x, y, r], i) => Object.assign(pieces[i], { x, y, r }));\nconst same = (a, b) => a.every((v, i) => v[0] === b[i][0] && v[1] === b[i][1] && v[2] === b[i][2]);\nconst moves = () => pos;\nfunction relight() { light = settle(room, pieces, held); light.lit = litCells(room, light.half); }\nconst pieceAt = (x, y) => pieces.findIndex((q, i) => i !== held && q.x === x && q.y === y);\nfunction changed(i) {\nconst now = snap();\nif (lastPiece === i && pos > 0) { hist[pos] = now; if (same(now, hist[pos - 1])) { pos--; hist.length = pos + 1; lastPiece = -1; } }\nelse if (!same(now, hist[pos])) { hist.length = pos + 1; hist.push(now); pos++; lastPiece = i; }\nrelight();\n}\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'play') updatePlay();\nelse if (state === 'solved') updateSolved();\nelse if (state === 'map') updateMap();\nelse if (state === 'story') updateStory();\nelse if (state === 'records') updateRecords();\nprevMask = inputMask;\n}\nfunction updateTitle() {\nif (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (titleSel === 0) startPlay(); else { state = 'records'; timer = 0; }\n}\n}\nfunction updatePlay() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nconst d = dpad();\nif (d >= 0) {\nconst nx = cx + DX[d], ny = cy + DY[d];\nif (nx >= 0 && ny >= 0 && nx < room.w && ny < room.h && room.wall[ny * room.w + nx] !== 2) { cx = nx; cy = ny; fx(SFX.move); }\n}\nif (pressed(A)) {\nif (held < 0) {\nconst i = pieceAt(cx, cy);\nif (i >= 0 && pieces[i].mode === 'free') { held = i; relight(); fx(SFX.pick); } else fx(SFX.no);\n} else if (!room.wall[cy * room.w + cx] && pieceAt(cx, cy) < 0) {\nconst i = held; held = -1; pieces[i].x = cx; pieces[i].y = cy; changed(i); fx(SFX.drop);\n} else fx(SFX.no);\n}\nconst turn = pressed(B) ? 1 : pressed(Y) ? -1 : 0;\nif (turn) {\nconst i = held >= 0 ? held : pieceAt(cx, cy), q = pieces[i];\nif (q && q.mode !== 'fixed' && TURNS[q.k] > 1) { q.r = (q.r + turn + TURNS[q.k]) % TURNS[q.k]; changed(i); fx(SFX.turn); } else fx(SFX.no);\n}\nif (pressed(SELECT) || pressed(L)) undo();\nif (pressed(R)) redo();\nif (held < 0 && lensesLit(pieces, light.got)) roomSolved();\n}\nfunction undo() {\nif (held >= 0) { held = -1; relight(); fx(SFX.undo); return; }\nif (pos === 0) { relight(); fx(SFX.no); return; }\npos--; restore(hist[pos]); lastPiece = -1; relight(); fx(SFX.undo);\n}\nfunction redo() {\nif (held >= 0 || pos >= hist.length - 1) { fx(SFX.no); return; }\npos++; restore(hist[pos]); lastPiece = -1; relight(); fx(SFX.undo);\n}\nfunction roomSolved() {\nstate = 'solved'; timer = 0; solvedSel = 0; fx(SFX.solved);\nwasBest = best(roomNo);\nif (!wasBest || moves() < wasBest) dset(BEST_SLOT + roomNo, moves());\n}\nconst SOLVED_ITEMS = () => [roomNo === ROOMS.length - 1 ? 'THE LAMP' : (roomNo + 1) % FLOOR_ROOMS ? 'NEXT ROOM' : 'UP THE STAIR', 'REPLAY', 'FLOOR MAP'];\nfunction updateSolved() {\nif (timer < 30) return;\nif (pressed(UP)) { solvedSel = (solvedSel + 2) % 3; fx(SFX.move); }\nif (pressed(DOWN)) { solvedSel = (solvedSel + 1) % 3; fx(SFX.move); }\nif (!(pressed(A) || pressed(START))) return;\nfx(SFX.select);\nif (solvedSel === 1) { loadRoom(roomNo); return; }\nif (solvedSel === 2) { toMap(roomNo); return; }\ngoOn();\n}\nfunction goOn() {\nconst n = roomNo + 1, k = Math.floor(roomNo / FLOOR_ROOMS) + 1;\nif (n === ROOMS.length) { showPage(ENDED, toTitle); return; }\nif (n % FLOOR_ROOMS === 0 && !storySeen(k)) { showPage(k, () => toMap(n)); return; }\nloadRoom(n);\n}\nfunction updateMap() {\nconst f = Math.floor(mapSel / FLOOR_ROOMS), r = mapSel % FLOOR_ROOMS;\nlet to = -1;\nif (pressed(LEFT) && r > 0) to = mapSel - 1;\nif (pressed(RIGHT) && r < FLOOR_ROOMS - 1) to = mapSel + 1;\nif (pressed(UP) && f < 3) to = mapSel + FLOOR_ROOMS;\nif (pressed(DOWN) && f > 0) to = mapSel - FLOOR_ROOMS;\nif (to >= 0) { if (opened(to)) { mapSel = to; fx(SFX.move); play(SONG.floors[Math.floor(to / FLOOR_ROOMS)]); } else fx(SFX.no); }\nif ((pressed(A) || pressed(START)) && timer > 10) { fx(SFX.select); loadRoom(mapSel); }\nelse if (pressed(B)) { fx(SFX.select); toTitle(); }\n}\nfunction updateStory() {\nif (timer > 30 && (pressed(A) || pressed(B) || pressed(START))) { fx(SFX.select); afterPage(); }\n}\nfunction updateRecords() {\nif ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\nconst PAUSE_ITEMS = ['RESUME', 'RESTART ROOM', 'FLOOR MAP', 'QUIT TO TITLE'];\nfunction updatePause() {\nif (pressed(UP)) { pauseSel = (pauseSel + 3) % 4; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 4; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) loadRoom(roomNo);\nelse if (pauseSel === 2) toMap(roomNo);\nelse toTitle();\n}\n}\nconst CELL = 16;\nconst ox = () => 16 + (14 - room.w) * 8, oy = () => 24 + (12 - room.h) * 8;\nfunction draw() {\ncls();\nif (state === 'play' || state === 'solved') drawPlay();\nelse if (state === 'title') drawTitle();\nelse if (state === 'map') drawMap();\nelse if (state === 'story') drawStory();\nelse if (state === 'records') drawRecords();\nif (state === 'solved') drawSolved();\nif (paused) drawPause();\n}\nfunction drawPlay() {\nconst X = ox(), Y = oy(), { w, h } = room, lit = light.lit;\nconst seen = (x, y) => !room.dark || lit[y * w + x] || (Math.abs(x - cx) <= 1 && Math.abs(y - cy) <= 1);\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nif (!seen(x, y)) continue;\nconst v = room.wall[y * w + x], px = X + x * CELL, py = Y + y * CELL;\nif (v === 1 || v === 3) { rectfill(px, py, CELL, CELL, 3); rect(px, py, CELL, CELL, 1); if (v === 3) rectfill(px + 4, py + 4, 8, 8, 5); }\nelse if (v === 0) { rectfill(px, py, CELL, CELL, lit[y * w + x] ? 2 : 1); rect(px, py, CELL, CELL, 2); }\n}\npieces.forEach((q, i) => { if (i !== held && seen(q.x, q.y)) drawPiece(q, X + q.x * CELL, Y + q.y * CELL, light.got[i]); });\ndrawBeams(X, Y);\nconst blink = clock % 40 < 28;\nif (held >= 0) drawPiece(pieces[held], X + cx * CELL, Y + cy * CELL - 3, 0);\nif (state === 'play') rect(X + cx * CELL - 1, Y + cy * CELL - 1, CELL + 2, CELL + 2, blink ? GOLD : DIM);\ntxt(`${roomNo + 1} ${room.name}`, 8, 6, WHITE);\nconst m = `MOVES ${moves()}/${room.par}`; txt(m, 248 - m.length * 8, 6, moves() <= room.par ? WHITE : DIM);\n}\nfunction drawBeams(X, Y) {\nconst { w, h } = room, H = light.half;\nfor (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {\nconst k = (y * w + x) * 4, mx = X + x * CELL + 8, my = Y + y * CELL + 8;\nlet all = 0;\nfor (let d = 0; d < 4; d++) {\nconst c = H[k + d]; if (!c) continue; all |= c;\nconst ex = mx + DX[d] * 8, ey = my + DY[d] * 8;\nif (DX[d]) { rectfill(Math.min(mx, ex), my - 1, 9, 3, 192 + c); line(mx, my, ex, ey, 200 + c); }\nelse { rectfill(mx - 1, Math.min(my, ey), 3, 9, 192 + c); line(mx, my, ex, ey, 200 + c); }\n}\nif (all) rectfill(mx - 1, my - 1, 3, 3, 200 + all);\n}\n}\nfunction drawPiece(q, px, py, got) {\nconst k = q.k, mx = px + 8, my = py + 8;\nif (k === 'lantern') {\nrectfill(px + 3, py + 3, 10, 10, 9); rect(px + 3, py + 3, 10, 10, 4);\nrectfill(mx - 1 + DX[q.r] * 5, my - 1 + DY[q.r] * 5, 2, 2, 200 + q.c);\n} else if (k === 'mirror' || k === 'splitter') {\nconst pts = q.r === 0 ? [px + 2, py + 13, px + 13, py + 2] : [px + 2, py + 2, px + 13, py + 13];\nif (k === 'mirror') { line(...pts, 12); line(pts[0] + 1, pts[1], pts[2], pts[3] + (q.r ? -1 : 1), WHITE); }\nelse for (let i = 0; i <= 11; i += 2) pset(pts[0] + i, q.r ? pts[1] + i : pts[1] - i, CYAN);\n} else if (k === 'prism') {\nconst fx = DX[q.r], fy = DY[q.r];\nconst tip = [mx + fx * 6, my + fy * 6], b1 = [mx - fx * 5 - fy * 6, my - fy * 5 + fx * 6], b2 = [mx - fx * 5 + fy * 6, my - fy * 5 - fx * 6];\nline(...tip, ...b1, CYAN); line(...b1, ...b2, CYAN); line(...b2, ...tip, CYAN);\n} else if (k === 'filter') {\nrectfill(px + 3, py + 3, 10, 10, 192 + q.c); rect(px + 3, py + 3, 10, 10, 200 + q.c);\n} else if (k === 'lens') {\nconst on = got === q.c;\ncircfill(mx, my, 5, on ? 200 + q.c : 192 + q.c); circ(mx, my, 6, on ? GOLD : DIM);\nif (q.key) pset(mx, my, SHADOW);\n} else if (k === 'shadow') {\ncircfill(mx, my, 5, SHADOW); circ(mx, my, 6, got ? RED : 2);\n} else if (k === 'door') {\nif (!(light.open & (1 << q.key))) for (let i = 2; i < 16; i += 4) rectfill(px + i, py + 1, 2, 14, 4);\nelse rect(px + 1, py + 1, 14, 14, 2);\n}\nif (q.mode === 'bolted') rectfill(px + 1, py + 1, 2, 2, GOLD);\nif (q.mode === 'fixed' && (k === 'mirror' || k === 'splitter' || k === 'prism')) rect(px, py, CELL, CELL, SHADOW);\n}\nfunction drawTower(x, y, sc) {\nconst w = 7 * sc, hgt = 44 * sc;\nrectfill(x - w, y - hgt, w * 2, hgt, 4); rect(x - w, y - hgt, w * 2, hgt, 1);\nfor (let n = 0; n < ROOMS.length; n++) {\nconst f = Math.floor(n / FLOOR_ROOMS), i = n % FLOOR_ROOMS, wx = x - w + sc + (i % 5) * 2.6 * sc, wy = y - (f * 11 + 3 + Math.floor(i / 5) * 4) * sc;\nrectfill(wx, wy, 1.6 * sc, 2.4 * sc, starred(n) ? GOLD : solved(n) ? 9 : 1);\n}\nrectfill(x - w * 0.8, y - hgt - 6 * sc, w * 1.6, 6 * sc, 1);\nif (storySeen(ENDED)) {\ncircfill(x, y - hgt - 3 * sc, 2 * sc, 207);\nconst a = clock / 60, len = 120, ex = x + Math.cos(a) * len, ey = y - hgt - 3 * sc + Math.sin(a) * len * 0.25;\nfor (let k = -1; k <= 1; k++) line(x, y - hgt - 3 * sc + k, ex, ey + k * 3, 199);\n} else rectfill(x - sc, y - hgt - 4 * sc, 2 * sc, 2 * sc, 2);\n}\nfunction drawTitle() {\ndrawTower(196, 212, 3);\ntxt('LANTERN', 24, 40, GOLD); txt('KEEPER', 32, 54, GOLD);\n['PLAY', 'RECORDS'].forEach((t, i) => txt(`${i === titleSel ? '> ' : '  '}${t}`, 32, 100 + i * 14, i === titleSel ? WHITE : DIM));\nlet lit = 0; for (let n = 0; n < ROOMS.length; n++) if (solved(n)) lit++;\nif (lit) txt(`${lit} OF ${ROOMS.length} ROOMS LIT`, 24, 196, DIM);\n}\nfunction drawMap() {\nconst sf = Math.floor(mapSel / FLOOR_ROOMS);\nfor (let f = 0; f < 4; f++) {\nconst y = 160 - f * 40, reached = opened(f * FLOOR_ROOMS);\nrectfill(16, y, 224, 34, reached ? 2 : 1); rect(16, y, 224, 34, f === sf ? GOLD : 3);\ntxt(`${f + 1} ${FLOOR_NAMES[f]}`, 22, y + 3, reached ? WHITE : 3);\nfor (let i = 0; i < FLOOR_ROOMS; i++) {\nconst n = f * FLOOR_ROOMS + i, wx = 22 + i * 21, wy = y + 14;\nrectfill(wx, wy, 15, 15, !opened(n) ? 3 : solved(n) ? 9 : SHADOW);\nif (!opened(n)) for (let k = 2; k < 15; k += 4) line(wx, wy + k, wx + 14, wy + k, 1);\nif (starred(n)) { pset(wx + 7, wy + 4, WHITE); rectfill(wx + 5, wy + 6, 5, 3, WHITE); pset(wx + 5, wy + 10, WHITE); pset(wx + 9, wy + 10, WHITE); }\nif (n === mapSel) rect(wx - 2, wy - 2, 19, 19, clock % 40 < 28 ? GOLD : DIM);\n}\n}\nconst n = mapSel;\ntxt(`${n + 1} ${nameRoom(n)}`, 16, 6, WHITE);\ntxt(solved(n) ? `BEST ${best(n)}  PAR ${parRoom(n)}${starred(n) ? '  STAR' : ''}` : `PAR ${parRoom(n)}`, 16, 206, solved(n) ? GOLD : DIM);\ntxt('B: TITLE', 184, 206, DIM);\n}\nconst STORY = [\n['THE STORM CAME UP AT DUSK,', 'AND THE GREAT LAMP OF', 'GREYWATER LIGHT WENT OUT.', '', 'SHIPS ARE OUT THERE', 'IN THE DARK.', '', 'CARRY THE LIGHT UP,', 'ROOM BY ROOM, TO THE LAMP.'],\n['THE STAIR IS LIT.', '', 'THE OLD KEEPER\\'S MIRRORS', 'STILL TURN TRUE.'],\n['THE GLASS ROOM RINGS', 'WITH COLOUR.', '', 'ABOVE IT, THE CLOCKWORK', 'WAITS.'],\n['THE GEARS TURN.', '', 'ONLY THE LAMP GALLERY', 'IS LEFT, DARK AS THE SEA.'],\n['THE GREAT LAMP BURNS.', '', 'ITS BEAM SWEEPS THE WATER,', 'AND ONE BY ONE THE SHIPS', 'TURN FOR HOME.', '', 'DAWN COMES UP', 'OVER GREYWATER.'],\n];\nfunction drawStory() {\nif (page === ENDED) drawTower(200, 214, 2);\nconst lines = STORY[page], y0 = 100 - lines.length * 6;\nlines.forEach((l, i) => txt(l, 24, y0 + i * 12, i === 0 ? GOLD : WHITE));\nif (timer > 30 && timer % 60 < 40) txt('A: ON', 24, 200, DIM);\n}\nfunction drawRecords() {\npanel(24, 16, 208, 192);\nctxt('RECORDS', 24, GOLD);\nlet lit = 0, stars = 0, mv = 0, par = 0;\nfor (let n = 0; n < ROOMS.length; n++) if (solved(n)) { lit++; mv += best(n); par += parRoom(n); if (starred(n)) stars++; }\ntxt(`ROOMS LIT   ${lit} OF ${ROOMS.length}`, 40, 52, WHITE);\ntxt(`STARS       ${stars} OF ${ROOMS.length}`, 40, 66, WHITE);\ntxt(`MOVES       ${mv} (PAR ${par})`, 40, 80, lit ? WHITE : DIM);\nFLOOR_NAMES.forEach((f, k) => {\nlet s = 0; for (let n = k * FLOOR_ROOMS; n < (k + 1) * FLOOR_ROOMS; n++) if (starred(n)) s++;\ntxt(f, 40, 108 + k * 14, opened(k * FLOOR_ROOMS) ? WHITE : DIM); txt(`${s}/10`, 176, 108 + k * 14, s === 10 ? GOLD : DIM);\n});\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawSolved() {\npanel(40, 138, 176, 82);\nconst star = moves() <= room.par;\nctxt('THE ROOM IS LIT', 143, GOLD);\nctxt(`${moves()} MOVES  PAR ${room.par}${star ? '  STAR' : ''}`, 155, star ? GOLD : WHITE);\nif (wasBest && moves() < wasBest) ctxt(`A NEW BEST (WAS ${wasBest})`, 167, WHITE);\nSOLVED_ITEMS().forEach((t, i) => txt(`${i === solvedSel ? '>' : ' '} ${t}`, 80, 182 + i * 11, timer < 30 ? 1 : i === solvedSel ? WHITE : DIM));\n}\nfunction drawPause() {\npanel(56, 72, 144, 76);\nctxt('PAUSED', 80, GOLD);\nPAUSE_ITEMS.forEach((t, i) => txt(`${i === pauseSel ? '>' : ' '} ${t}`, 72, 96 + i * 11, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SHADOW); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

{
  "format": "nova16-cart",
  "version": 2,
  "meta": {"title":"Brawl","author":"NOVA-16","description":"A game in progress."},
  "label": null,
  "code": "// Brawl: a Streets of Rage style beat 'em up (docs/carts/brawl.md). One street, a hero with a three-hit combo and a jump\n// kick, and one kind of enemy in four waves. Built game first: every fighter is drawn by one small art layer,\n// drawFighter(), as plain shapes taken from the same frame table (ANIM) the rules use; real art replaces that function.\n// The frame of the game (title, pause, game over, top 10, records, sound cues) is the starter's.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {},\n  scenes: {\"city\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"fence\": {\"h\": 28, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"ground\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"GLASS\": 200, \"GOLD\": 114, \"INK\": 115, \"WHITE\": 113},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[4129,4129,4129,4129,4129,4129,4130,4130,4130,5154,5154,5154,5154,5154,5154,5154,5154,5154,5154,6178,6179,6179,6211,6211,6211,6211,6211,6211,7235,7235,7235,7235,7236,7236,7236,7236,8260,8260,8260,8260,8260,8260,8260,8260,8292,9317,9317,9317,9317,9317,9317,9317,9317,9318,9318,9318,9318,9318,9318,9350,10374,10375,10375,10375,10375,10375,10375,10375,10375,10376,10376,10376,10376,10376,10376,11432,11433,11433,11433,11433,11433,11433,11433,11433,11434,11434,11434,11434,11434,11434,11434,12491,12491,12491,12491,12491,12492,12492,12492,12492,12524,12524,12525,12525,12525,12525,12525,12526,12526,12558,12558,12558,12559,12559,12559,12559,12559,12560,12592,12592,12592,12592,12593,12593,12593,12593,12593,12626,12626,12626,12626,13651,13651,13651,13651,13651,13684],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: score, initials, a spare (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- The street: lanes, the camera, and the frame table (docs/carts/brawl.md, section 5) ---\n\nconst LANE_TOP = 150, LANE_BOT = 208, LANE_TOL = 12;        // a fighter's feet are at y, the lane is the pavement\nconst LEVEL_W = 1024, GRAV = 0.3, HITSTOP = 5;\nconst HERO_HP = 60, THUG_HP = 20;\n// The waves: the camera stops at x, n thugs come in from the sides, and it holds until they are all down.\nconst LEVEL = [{ x: 0, n: 2 }, { x: 300, n: 3 }, { x: 560, n: 3 }, { x: 768, n: 4 }];\n\n// Every animation is a list of frames [duration, hurt box, hit box or null]. Boxes are [x0, y0, x1, y1] from the feet,\n// facing right, up is negative. Real art must have its feet at the same pivot and fit these (or the boxes are tuned).\nconst STAND = [-14, -92, 14, 0], LYING = [-40, -18, 40, 0];\nconst ANIM = {\n  idle: [[30, STAND, null]],\n  walk: [[30, STAND, null]],\n  punch1: [[4, STAND, null], [3, STAND, [14, -72, 50, -58]], [7, STAND, null]],\n  punch2: [[4, STAND, null], [3, STAND, [14, -72, 50, -58]], [7, STAND, null]],\n  hook: [[6, STAND, null], [4, STAND, [14, -78, 58, -56]], [12, STAND, null]],\n  jump: [[999, STAND, null]],\n  jkick: [[4, STAND, null], [999, STAND, [10, -44, 50, -20]]],\n  land: [[6, STAND, null]],\n  hurt: [[16, STAND, null]],\n  down: [[999, LYING, null]],\n  getup: [[20, STAND, null]],\n  tpunch: [[18, STAND, null], [4, STAND, [14, -74, 52, -60]], [22, STAND, null]],\n};\n// What an attack does: damage, hit stun (frames, with a knock back of 6 px over them) or a knockdown.\nconst MOVE = {\n  punch1: { dmg: 4, stun: 16 }, punch2: { dmg: 4, stun: 16 }, hook: { dmg: 6, down: 1 }, jkick: { dmg: 6, down: 1 },\n  tpunch: { dmg: 5, stun: 16 },\n};\nconst COMBO = { punch1: 'punch2', punch2: 'hook' };\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, lives = 3, won = false;\nlet player = null, enemies = [], cam = 0, wave = 0, locked = false, hitstop = 0, showBoxes = false, goT = 0, lastHit = null, lastHitT = 0;\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  // The street: the far city, the fence and the pavement, each a full picture that repeats sideways; the sky is a\n  // gradient in scanline(). The camera scrolls them at 0.3, 0.6 and 1.\n  for (const [l, name] of [[2, 'city'], [1, 'fence'], [0, 'ground']]) {\n    const s = ART.scenes[name];\n    bg(l, { mx: s.mx, my: s.my, mw: s.w, mh: s.h, x: 0, y: 0, wrap: true, show: true });\n  }\n  blend({ layers: ['overlay'], half: true }); // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; scroll(0); play(SONG.title); }\n\nfunction startGame() {\n  score = 0; lives = 3; won = false; paused = false; timer = 0; state = 'play';\n  cam = 0; wave = 0; locked = false; hitstop = 0; goT = 0; enemies = []; lastHit = null; lastHitT = 0;\n  player = mkFighter('hero', 90, 180, HERO_HP);\n  play(SONG.play);\n}\n\nfunction mkFighter(kind, x, y, hp) {\n  return { kind, x, y, h: 0, vx: 0, vz: 0, face: 1, anim: 'idle', fi: 0, ft: 0, hp, hits: [], conn: false, connT: 99, queue: false,\n    inv: 0, lie: 0, dying: false, ai: 'enter', cool: 40, token: false, tokenT: 0, seed: 0 };\n}\n\n// --- Animations and boxes ---\n\nfunction setAnim(f, name) { f.anim = name; f.fi = 0; f.ft = 0; f.hits = []; f.conn = false; f.connT = 99; f.queue = false; }\nconst frameOf = (f) => { const a = ANIM[f.anim]; return a[Math.min(f.fi, a.length - 1)]; };\n/** Advance a frame; true when the animation has run its course. */\nfunction stepAnim(f) {\n  const a = ANIM[f.anim];\n  if (f.fi < a.length && ++f.ft >= a[f.fi][0]) { f.ft = 0; f.fi++; }\n  return f.fi >= a.length;\n}\n/** A box in the world: x in the world, y on the screen (the height of a jump lifts it), mirrored for facing left. */\nfunction worldBox(f, b) {\n  const y = f.y - f.h;\n  return f.face > 0 ? [f.x + b[0], y + b[1], f.x + b[2], y + b[3]] : [f.x - b[2], y + b[1], f.x - b[0], y + b[3]];\n}\nconst overlaps = (a, b) => a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3];\nconst canBeHit = (f) => f.anim !== 'down' && f.anim !== 'getup' && f.inv <= 0 && !f.dying;\n\n// --- Hits ---\n\nfunction checkHits(a, targets) {\n  const fr = frameOf(a), mv = MOVE[a.anim];\n  if (!fr[2] || !mv) return;\n  const hb = worldBox(a, fr[2]);\n  for (const t of targets) {\n    if (a.hits.includes(t) || !canBeHit(t) || Math.abs(a.y - t.y) > LANE_TOL) continue;\n    if (overlaps(hb, worldBox(t, frameOf(t)[1]))) landHit(a, t, mv);\n  }\n}\n\nfunction landHit(a, t, mv) {\n  a.hits.push(t); a.conn = true; a.connT = 0; hitstop = HITSTOP; t.hp -= mv.dmg;\n  const dir = a.x <= t.x ? 1 : -1;\n  t.face = -dir; t.token = false; t.queue = false;\n  if (a === player) { score += 10; lastHit = t; lastHitT = 180; }\n  if (t.hp <= 0 || mv.down) knockDown(t, dir);\n  else { setAnim(t, 'hurt'); t.vx = dir * 6 / 16; }\n  fx(SFX.hit);\n}\n\nfunction knockDown(f, dir) {\n  setAnim(f, 'down'); f.vz = 3.4; f.vx = dir * 2.4; f.h = Math.max(f.h, 0.1); f.lie = 0;\n  if (f.hp <= 0 && !f.dying) { f.dying = f.kind === 'thug'; if (f.kind === 'thug') { score += 100; fx(SFX.point); } }\n}\n\n/** Gravity: true on the frame a fighter lands. */\nfunction fall(f) {\n  if (f.h <= 0 && f.vz === 0) return false;\n  f.h += f.vz; f.vz -= GRAV;\n  if (f.h <= 0) { f.h = 0; f.vz = 0; return true; }\n  return false;\n}\nfunction clampX(f) { f.x = Math.max(10, Math.min(LEVEL_W - 10, f.x)); }\n\n/** The part of an animation shared by everyone: a hit stun, a fall and the getting up. True if it took the frame. */\nfunction updateShared(f) {\n  if (f.anim === 'hurt') {\n    f.x += f.vx; clampX(f);\n    if (stepAnim(f)) { f.vx = 0; setAnim(f, 'idle'); }\n    return true;\n  }\n  if (f.anim === 'down') {\n    if (f.h > 0 || f.vz !== 0) { f.x += f.vx; clampX(f); if (fall(f)) { f.vx = 0; f.lie = 40; } }\n    else if (--f.lie <= 0) downEnded(f);\n    return true;\n  }\n  if (f.anim === 'getup') { if (stepAnim(f)) setAnim(f, 'idle'); return true; }\n  return false;\n}\n\nfunction downEnded(f) {\n  if (f.kind === 'thug') { if (f.dying) f.gone = 1; else { setAnim(f, 'getup'); f.cool = 30; } return; }\n  if (f.hp > 0) { setAnim(f, 'getup'); f.inv = 60; return; }\n  if (--lives <= 0) { lives = 0; gameOver(false); return; }\n  Object.assign(f, mkFighter('hero', cam + 128, 180, HERO_HP)); f.anim = 'getup'; f.inv = 120;\n}\n\n// --- The hero ---\n\nfunction updateHero(p) {\n  if (p.inv > 0) p.inv--;\n  p.connT++;\n  if (updateShared(p)) return;\n  const dx = (btn(RIGHT) ? 1 : 0) - (btn(LEFT) ? 1 : 0), dy = (btn(DOWN) ? 1 : 0) - (btn(UP) ? 1 : 0);\n  const a = p.anim;\n  if (a === 'jump' || a === 'jkick') {                               // in the air: keep the walking speed\n    p.x += dx * 1.4; p.y = Math.max(LANE_TOP, Math.min(LANE_BOT, p.y + dy * 0.9)); clampX(p);\n    if (a === 'jump' && pressed(A)) setAnim(p, 'jkick');\n    else if (a === 'jkick') stepAnim(p);\n    if (fall(p)) setAnim(p, 'land');\n    return;\n  }\n  if (a === 'punch1' || a === 'punch2' || a === 'hook') {\n    if (pressed(A) && COMBO[a]) p.queue = true;\n    const ended = stepAnim(p);\n    if (COMBO[a] && p.queue && p.conn && p.connT <= 12 && (p.fi >= 2 || ended)) setAnim(p, COMBO[a]);\n    else if (ended) setAnim(p, 'idle');\n    return;\n  }\n  if (a === 'land') { if (stepAnim(p)) setAnim(p, 'idle'); return; }\n  if (pressed(B)) { setAnim(p, 'jump'); p.vz = 5.2; p.h = 0.1; return; }\n  if (pressed(A)) { setAnim(p, 'punch1'); return; }\n  if (dx) p.face = dx;\n  p.x += dx * 1.4; p.y = Math.max(LANE_TOP, Math.min(LANE_BOT, p.y + dy * 0.9)); clampX(p);\n  const moving = dx || dy;\n  if (moving && a !== 'walk') setAnim(p, 'walk'); else if (!moving && a !== 'idle') setAnim(p, 'idle');\n  else stepAnim(p);\n}\n\n// --- The thug ---\n\nfunction spawnWave(w) {\n  for (let i = 0; i < w.n; i++) {\n    const side = (i + wave) % 2 === 0 ? -1 : 1;                      // from the left edge, or from the right\n    const t = mkFighter('thug', side < 0 ? cam - 24 - i * 10 : cam + 280 + i * 10, rndi(LANE_TOP + 4, LANE_BOT - 4), THUG_HP);\n    t.face = -side; t.anim = 'walk'; t.cool = rndi(40, 90);\n    enemies.push(t);\n  }\n}\n\nconst tokens = () => enemies.filter((e) => e.token).length;\n\nfunction updateThug(t) {\n  if (t.inv > 0) t.inv--;\n  if (updateShared(t) || t.ai === 'dummy') return;                   // (a dummy is a punching bag for the tests)\n  const p = player;\n  if (t.anim === 'tpunch') {\n    if (stepAnim(t)) { setAnim(t, 'walk'); t.token = false; t.cool = rndi(60, 120); }\n    return;\n  }\n  if (t.cool > 0) t.cool--;\n  let tx, ty;\n  if (t.ai === 'enter') {                                            // walk in from off the screen\n    tx = t.x < cam + 20 ? t.x + 10 : t.x > cam + 236 ? t.x - 10 : t.x; ty = t.y;\n    if (t.x >= cam + 16 && t.x <= cam + 240) t.ai = 'fight';\n    if (tx === t.x && ty === t.y) t.ai = 'fight';\n  } else {\n    const side = t.x >= p.x ? 1 : -1;\n    if (!t.token && t.cool <= 0 && tokens() < 2 && p.hp > 0 && p.anim !== 'down') { t.token = true; t.tokenT = 0; }\n    if (t.token && ++t.tokenT > 300) { t.token = false; t.cool = 60; }\n    const gap = t.token ? 36 : 85;\n    tx = p.x + side * gap; ty = p.y;\n    if (tx < cam + 16 || tx > cam + 240) tx = p.x - side * gap;   // never wait off the screen: use the hero's other side\n  }\n  const mx = tx - t.x, my = ty - t.y;\n  const walking = Math.abs(mx) > 2 || Math.abs(my) > 2;\n  if (walking) { t.x += Math.sign(mx) * Math.min(0.8, Math.abs(mx)); t.y += Math.sign(my) * Math.min(0.6, Math.abs(my)); }\n  t.y = Math.max(LANE_TOP, Math.min(LANE_BOT, t.y)); t.x = Math.max(cam - 60, Math.min(cam + 316, t.x));\n  for (const o of enemies) if (o !== t && Math.abs(o.x - t.x) < 18 && Math.abs(o.y - t.y) < 8) t.x += t.x >= o.x ? 0.5 : -0.5;\n  if (t.ai === 'fight') t.face = p.x >= t.x ? 1 : -1;\n  else t.face = Math.sign(mx) || t.face;\n  if (t.ai === 'fight' && t.token && Math.abs(p.y - t.y) <= 6 && Math.abs(p.x - t.x) >= 26 && Math.abs(p.x - t.x) <= 44) { setAnim(t, 'tpunch'); return; }\n  if (walking && t.anim !== 'walk') setAnim(t, 'walk'); else if (!walking && t.anim !== 'idle') setAnim(t, 'idle');\n}\n\n// --- The level: the camera, the waves, the end ---\n\nfunction updateCamera() {\n  const next = LEVEL[wave];\n  if (!locked) {\n    const limit = next ? next.x : LEVEL_W - 256;\n    cam = Math.min(Math.max(cam, player.x - 112), limit, LEVEL_W - 256);\n    if (next && cam >= next.x) { locked = true; spawnWave(next); wave++; }\n  } else if (enemies.length === 0) {\n    locked = false;\n    if (wave >= LEVEL.length) { clearStage(); return; }\n    goT = 0;\n  }\n  player.x = Math.max(cam + 10, Math.min(cam + 246, player.x));\n}\n\nfunction clearStage() {\n  score += player.hp * 10 + lives * 500; won = true; gameOver(true);\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) startGame(); else { state = 'records'; hl = -1; timer = 0; }\n  }\n}\n\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(SELECT)) showBoxes = !showBoxes;\n  if (lastHitT > 0) lastHitT--;\n  if (hitstop > 0) {                                                 // both fighters freeze on a hit\n    hitstop--; if (pressed(A) && COMBO[player.anim]) player.queue = true; // (a press during the freeze still counts)\n    return;\n  }\n  updateHero(player);\n  for (const e of enemies) updateThug(e);\n  checkHits(player, enemies);\n  for (const e of enemies) checkHits(e, [player]);\n  enemies = enemies.filter((e) => !e.gone);\n  if (state !== 'play') return;\n  updateCamera();\n  goT++;\n}\n\nfunction gameOver(clear) {\n  state = 'over'; won = clear; timer = 0; play(-1); fx(clear ? SFX.record : SFX.over);\n  rank = insertTop({ score, initials: lastInitials() });\n}\n\nfunction updateOver() {\n  if (timer < 60 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  state = 'records'; hl = rank; timer = 0;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startGame(); // restart\n    else toTitle(); // quitting abandons the game: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\nfunction scroll(c) { bgscroll(2, flr(c * 0.3), 0); bgscroll(1, flr(c * 0.6), 0); bgscroll(0, flr(c), 0); }\n\nfunction draw() {\n  cls();\n  scroll(state === 'play' || state === 'over' ? cam : 0);\n  if (state === 'play' || state === 'over') drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (state === 'over') {\n    panel(48, 80, 160, 64);\n    ctxt(won ? 'STAGE CLEAR' : 'GAME OVER', 92, won ? GOLD : RED); ctxt(`SCORE ${score}`, 108, WHITE);\n    if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 126, DIM);\n  }\n  if (paused) drawPause();\n}\n\nfunction drawPlay() {\n  const all = [player, ...enemies].sort((a, b) => a.y - b.y);        // nearer the bottom of the screen is in front\n  for (const f of all) drawShadow(f);\n  for (const f of all) drawFighter(f);\n  if (showBoxes) for (const f of all) drawBoxes(f);\n  drawHud();\n}\n\nfunction drawShadow(f) {\n  const sx = flr(f.x - cam), w = Math.max(8, 16 - flr(f.h / 4));\n  rectfill(sx - w, f.y - 2, w * 2, 4, SHADOW); rectfill(sx - w + 2, f.y - 3, w * 2 - 4, 6, SHADOW);\n}\n\n/**\n * THE ART LAYER. A fighter drawn as plain shapes from the frame table: the hurt box is the body, with a head and legs, and\n * a fist where the hit box is. Real frames replace this one function (the same feet, boxes and timings).\n */\nfunction drawFighter(f) {\n  if (f.inv > 0 && flr(clock / 3) % 2 === 0) return;                 // flashes while invulnerable\n  if (f.dying && f.anim === 'down' && f.h === 0 && f.lie < 20 && flr(clock / 2) % 2 === 0) return;\n  const hero = f.kind === 'hero', coat = hero ? 8 : 6, pants = hero ? 2 : 1, skin = 12, fist = f.hits.length ? GOLD : 9;\n  const sx = flr(f.x - cam), by = flr(f.y - f.h), d = f.face;\n  if (f.anim === 'down') {                                           // lying on the ground, or flying through the air\n    const air = f.h > 0 || f.vz !== 0;\n    if (air) { rectfill(sx - 30, by - 36, 60, 18, coat); circfill(sx - d * 34, by - 28, 9, skin); }\n    else { rectfill(sx - 40, by - 14, 56, 14, coat); rectfill(sx + 14 * -d - 2, by - 12, 24, 10, pants); circfill(sx + d * 40 * -1, by - 8, 8, skin); }\n    return;\n  }\n  const hurt = f.anim === 'hurt' && f.ft < 4;\n  const walk = f.anim === 'walk' ? flr(clock / 6) % 2 : 0, lean = f.anim === 'hurt' ? -d * 4 : 0;\n  const air = f.h > 0;\n  if (air) { rectfill(sx - 10 + lean, by - 40, 8, 40, pants); rectfill(sx + 2 + lean, by - 34, 8, 30, pants); }\n  else { rectfill(sx - 10 + lean, by - 40, 8, 40 - walk * 4, pants); rectfill(sx + 2 + lean, by - 40, 8, 36 + walk * 4, pants); }\n  rectfill(sx - 14 + lean, by - 74, 28, 36, hurt ? WHITE : coat);                              // the torso\n  circfill(sx + d * 2 + lean, by - 82, 9, skin);                                                // the head\n  rectfill(sx + d * 6 + lean - 1, by - 84, 3, 3, SHADOW);                                       // an eye, on the side he faces\n  const fr = frameOf(f), mv = MOVE[f.anim];\n  if (mv) {                                                          // an attack: the fist cocked, then out at the hit box\n    let fx0 = d * 16, fy0 = -62;\n    if (fr[2]) { const b = fr[2]; fx0 = d * ((b[0] + b[2]) / 2); fy0 = (b[1] + b[3]) / 2; }\n    else if (f.fi === 0) { fx0 = -d * 12; fy0 = -64; }\n    const fx1 = sx + fx0, fy1 = by + fy0;\n    line(sx + d * 8, by - 66, fx1, fy1, skin); line(sx + d * 8, by - 65, fx1, fy1 + 1, skin);\n    rectfill(fx1 - 6, fy1 - 6, 12, 12, fr[2] ? fist : coat);\n  } else {                                                           // guard: the fists up\n    rectfill(sx + d * 14 + lean - 4, by - 70, 8, 8, skin);\n  }\n}\n\nfunction drawBoxes(f) {\n  const hb = worldBox(f, frameOf(f)[1]);\n  rect(flr(hb[0] - cam), flr(hb[1]), hb[2] - hb[0], hb[3] - hb[1], GREEN);\n  const ht = frameOf(f)[2];\n  if (ht) { const b = worldBox(f, ht); rect(flr(b[0] - cam), flr(b[1]), b[2] - b[0], b[3] - b[1], RED); }\n}\n\nfunction bar(x, y, w, v, max, c) {\n  rectfill(x, y, w, 6, SHADOW); rectfill(x + 1, y + 1, Math.max(0, flr((w - 2) * v / max)), 4, c); rect(x, y, w, 6, DIM);\n}\n\nfunction drawHud() {\n  txt('P1', 8, 6, CYAN); bar(26, 6, 70, player.hp, HERO_HP, player.hp > 20 ? GREEN : RED);\n  txt(`x${lives}`, 102, 6, lives > 1 ? WHITE : RED);\n  txt(`${score}`.padStart(7, '0'), 8, 18, WHITE);\n  if (lastHit && lastHitT > 0 && lastHit.kind === 'thug') { txt('THUG', 168, 6, GOLD); bar(196, 6, 52, Math.max(0, lastHit.hp), THUG_HP, 6); }\n  if (!locked && wave < LEVEL.length + 1 && wave > 0 && goT % 40 < 26 && state === 'play') txt('GO >', 214, 96, GOLD);\n}\n\nfunction drawTitle() {\n  ctxt('BRAWL', 50, GOLD);\n  ['PLAY', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    txt(e.score ? String(e.score).padStart(8) : '', 128, y, i === 0 ? GOLD : WHITE);\n  });\n  if (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(String(score), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky's colour for that line (the SNES did its skies this way, with HDMA). */\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

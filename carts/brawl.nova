 play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3;\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\nfunction insertTop(e) {\nif (!e.score) return -1;\nconst list = topTen(), at = list.findIndex((x) => e.score > x.score);\nif (at < 0) return -1;\nlist.splice(at, 0, e);\nfor (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\nreturn at;\n}\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\nlet inputMask = [0, 0], prevMask = [0, 0];\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad(pad) { let m = 0; for (const b of BUTTONS) if (btn(b, pad)) m |= 1 << b; return m; }\nconst held = (pad, b) => (inputMask[pad] & (1 << b)) !== 0;\nconst pressedBy = (pad, b) => held(pad, b) && (prevMask[pad] & (1 << b)) === 0;\nconst pressed = (b) => pressedBy(0, b) || pressedBy(1, b);\nconst LANE_TOP = 150, LANE_BOT = 208, LANE_TOL = 12;\nconst GRAV = 0.3, HITSTOP = 5;\nconst HERO_HP = 60, THUG_HP = 20;\nlet LEVEL = null, PROPS = null, LEVEL_W = 1024;\nconst STAND = [-14, -92, 14, 0], LYING = [-40, -18, 40, 0];\nconst ANIM = {\nidle: [[30, STAND, null]],\nwalk: [[30, STAND, null]],\npunch1: [[4, STAND, null], [3, STAND, [14, -72, 50, -58]], [7, STAND, null]],\npunch2: [[4, STAND, null], [3, STAND, [14, -72, 50, -58]], [7, STAND, null]],\nhook: [[6, STAND, null], [4, STAND, [14, -78, 58, -56]], [12, STAND, null]],\nuppercut: [[7, STAND, null], [4, STAND, [10, -104, 44, -38]], [14, STAND, null]],\njump: [[999, STAND, null]],\njkick: [[4, STAND, null], [999, STAND, [10, -44, 50, -20]]],\nland: [[6, STAND, null]],\nhurt: [[16, STAND, null]],\ndown: [[999, LYING, null]],\ngetup: [[20, STAND, null]],\ntpunch: [[18, STAND, null], [4, STAND, [14, -74, 52, -60]], [22, STAND, null]],\ntpunch2: [[15, STAND, null], [4, STAND, [14, -74, 52, -60]], [22, STAND, null]],\ntpunch3: [[12, STAND, null], [4, STAND, [14, -74, 52, -60]], [20, STAND, null]],\nsstab: [[12, STAND, null], [7, STAND, [10, -76, 62, -52]], [16, STAND, null]],\ncthrow: [[20, STAND, null], [3, STAND, null], [16, STAND, null]],\nwlash: [[16, STAND, null], [4, STAND, [10, -72, 116, -56]], [18, STAND, null]],\ngrab: [[999, STAND, null]],\ngpunch: [[8, STAND, null]],\nthrow: [[14, STAND, null]],\nheld: [[999, STAND, null]],\npick: [[8, STAND, null]],\nwthrow: [[6, STAND, null], [12, STAND, null]],\nrevive: [[999, STAND, null]],\nsuplex: [[18, STAND, null]],\nwpipe: [[8, STAND, null], [4, STAND, [16, -86, 84, -46]], [14, STAND, null]],\nwknife: [[3, STAND, null], [3, STAND, [14, -74, 66, -54]], [7, STAND, null]],\nspecial: [[5, STAND, null], [6, STAND, [-54, -86, 54, -24]], [14, STAND, null]],\ndash: [[5, STAND, null], [10, STAND, [10, -96, 54, -34]], [14, STAND, null]],\n};\nconst MOVE = {\npunch1: { dmg: 4, stun: 16 }, punch2: { dmg: 4, stun: 16 }, hook: { dmg: 6, down: 1 }, uppercut: { dmg: 8, down: 1, lift: 5.0 }, jkick: { dmg: 6, down: 1 },\ntpunch: { dmg: 5, stun: 16 }, tpunch2: { dmg: 5, stun: 16 }, tpunch3: { dmg: 6, stun: 16 }, sstab: { dmg: 5, stun: 14 }, wlash: { dmg: 5, stun: 16 }, hsmash: { dmg: 9, down: 1 }, special: { dmg: 5, down: 1 }, bpunch: { dmg: 8, stun: 16 }, bcharge: { dmg: 10, down: 1 },\nrslash1: { dmg: 4, stun: 14 }, rslash2: { dmg: 4, stun: 14 }, rslash3: { dmg: 6, down: 1 }, rdive: { dmg: 7, down: 1 }, kslam: { dmg: 8, do
{
  "format": "nova16-cart",
  "version": 1,
  "meta": {"title":"Rags to Riches","author":"NOVA-16","description":"A game in progress."},
  "label": null,
  "code": "// Rags to Riches\n// A ten-week band-management game: one action a week (concert, songs, travel), $5,000 to win. Spec: docs/carts/rags-to-riches.md.\n// Phase 1: the economy as pure functions (see \"The economy\"), the week hub, one concert flow and the end of the tour.\n// The frame (pause, saved top 10 with initials, records, sound and music cues, skipTitle) comes from tools/new-cart.js.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, GREY = 7, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"van\": {\"pal\": 0, \"size\": 16, \"tile\": 256}},\n  scenes: {\"field\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}},\n  colors: {},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). The channel decides the voice: 0 and 1 pulse, 2 triangle, 3 saw, 4 noise, 5 sample. ---\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = 1; // effects share channel 1 (pulse); the songs leave it free\n// Effects with noise (or saw or triangle) in them go on a channel with that voice. Fill this from audio.py:\n// node tools/devkit/music/sfx.mjs carts/rags-to-riches.nova 1 shows what each effect is.\nconst SFX_VOICE_CH = { [SFX.hit]: 4 };\nfunction fx(n) { sfx(n, n in SFX_VOICE_CH ? SFX_VOICE_CH[n] : SFX_CH); }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- The tuning numbers: every number of the economy is here (spec section 5 and 6) ---\n\nconst TUNE = {\n  weeks: 10, goal: 5000,\n  startCash: 400, startPop: 18, startFresh: 70,\n  priceMin: 5, priceMax: 50, priceStart: 10, priceStep: 1, priceBig: 5,\n  adMax: 200, adStep: 10, adBig: 50,\n  rollMin: 94, rollMax: 106, // the seeded variation of a crowd, in percent\n  freshCost: 10, fatigueGain: 30,\n  // the crowd's terms (spec 5.2): base + slope * value; the price term is base - price / city.priceScale, clamped\n  popBase: 0.10, popSlope: 1.80, freshBase: 0.65, freshSlope: 0.35,\n  priceBase: 1.35, priceLow: 0.25, priceHigh: 1.15,\n  adBoost: 0.50, adHalf: 80, // advertising adds up to adBoost of a crowd, half of it at adHalf dollars\n  fatigueSpan: 100, fatigueFloor: 0.25,\n  songFresh: 30, songPop: 8, fare: 20, // songwriting and travel: used from Phase 3\n};\n// The five markets. pool: the crowd the city can give; priceScale: how much a ticket can cost before the crowd thins out;\n// competition: the share of the crowd lost to rival bands. crowd/rooms/rivals are the words the player sees. Each city has\n// three venues (a bar, a theatre, an arena); rent is paid up front.\nconst CITIES = [\n  { name: 'RUSTPORT', crowd: 'SMALL', rooms: 'CHEAP', rivals: 'FEW', pool: 50, priceScale: 30, competition: 0.02,\n    venues: [{ name: 'THE SOGGY BOOT', capacity: 25, rent: 35 }, { name: 'RIVET HALL', capacity: 50, rent: 95 }, { name: 'DOCKSIDE DOME', capacity: 100, rent: 220 }] },\n  { name: 'SUNVALE', crowd: 'MEDIUM', rooms: 'CHEAP', rivals: 'FEW', pool: 65, priceScale: 36, competition: 0.04,\n    venues: [{ name: 'CACTUS CANTINA', capacity: 30, rent: 45 }, { name: 'MESA THEATRE', capacity: 65, rent: 120 }, { name: 'SUNBOWL', capacity: 130, rent: 285 }] },\n  { name: 'CEDAR CITY', crowd: 'BIG', rooms: 'FAIR', rivals: 'SOME', pool: 80, priceScale: 40, competition: 0.08,\n    venues: [{ name: 'THE KNOTHOLE', capacity: 40, rent: 55 }, { name: 'LUMBER HALL', capacity: 80, rent: 145 }, { name: 'CEDAR COLISEUM', capacity: 160, rent: 330 }] },\n  { name: 'METRO HEIGHTS', crowd: 'BIG', rooms: 'DEAR', rivals: 'MANY', pool: 100, priceScale: 46, competition: 0.15,\n    venues: [{ name: 'THE BASEMENT', capacity: 50, rent: 75 }, { name: 'SKYLINE THEATRE', capacity: 100, rent: 185 }, { name: 'METRO ARENA', capacity: 200, rent: 430 }] },\n  { name: 'COASTLINE', crowd: 'HUGE', rooms: 'PRICEY', rivals: 'MANY', pool: 115, priceScale: 50, competition: 0.18,\n    venues: [{ name: 'THE TIDEPOOL', capacity: 55, rent: 90 }, { name: 'PIER PLAYHOUSE', capacity: 115, rent: 215 }, { name: 'SURF STADIUM', capacity: 230, rent: 500 }] },\n];\n\n// --- The economy: pure functions (no state, no random numbers: the roll is an argument) ---\n\n/** The six multipliers of the crowd. */\nfunction factors(city, price, ad, pop, fresh, fatigue) {\n  return {\n    pop: TUNE.popBase + TUNE.popSlope * pop / 100,\n    fresh: TUNE.freshBase + TUNE.freshSlope * fresh / 100,\n    price: clamp(TUNE.priceBase - price / city.priceScale, TUNE.priceLow, TUNE.priceHigh),\n    ad: 1 + TUNE.adBoost * (ad / (ad + TUNE.adHalf)),\n    fatigue: clamp(1 - fatigue / TUNE.fatigueSpan, TUNE.fatigueFloor, 1),\n    comp: 1 - city.competition,\n  };\n}\n/** The crowd the band can expect, before the venue's size and the roll. */\nfunction expectedCrowd(city, price, ad, pop, fresh, fatigue) {\n  const f = factors(city, price, ad, pop, fresh, fatigue);\n  return city.pool * f.pop * f.fresh * f.price * f.ad * f.fatigue * f.comp;\n}\n/** The tickets sold: a whole number from 0 to the venue's capacity. roll is a percentage, TUNE.rollMin to rollMax. */\nfunction attendance(city, venue, price, ad, pop, fresh, fatigue, roll) {\n  return clamp(Math.round(expectedCrowd(city, price, ad, pop, fresh, fatigue) * roll / 100), 0, venue.capacity);\n}\n/** Popularity won or lost by a show of this size in this room (spec 5.3). */\nfunction popularityChange(att, capacity) {\n  const occ = Math.floor(att * 100 / capacity);\n  if (occ < 30) return occ < 10 ? -3 : occ < 20 ? -2 : -1;\n  return 1 + (occ >= 100 ? 5 : occ >= 90 ? 4 : occ >= 75 ? 3 : occ >= 60 ? 2 : occ >= 45 ? 1 : 0);\n}\n/** LOW, FAIR or STRONG: the expected crowd (roll 100) against the room, never the number itself. */\nfunction forecast(city, venue, price, ad, pop, fresh, fatigue) {\n  const r = expectedCrowd(city, price, ad, pop, fresh, fatigue) / venue.capacity;\n  return r < 0.4 ? 'LOW' : r < 0.75 ? 'FAIR' : 'STRONG';\n}\n/** The one line that says why the crowd was what it was (spec 5.5). */\nfunction mainFactor(f, full) {\n  if (full) return 'FULL HOUSE! BIGGER ROOM?';\n  const worst = [[f.pop, 'LOW POPULARITY'], [f.fresh, 'STALE SONGS'], [f.price, 'PRICE TOO HIGH'], [f.fatigue, 'TIRED MARKET']]\n    .reduce((a, b) => (b[0] < a[0] ? b : a));\n  return worst[0] >= 0.9 ? 'GOOD MIX OF PRICE AND BUZZ' : worst[1];\n}\n/** How the fans of a market feel, from its fatigue: the word the hub shows. */\nconst fansWord = (fatigue) => (fatigue < 20 ? 'EAGER' : fatigue < 45 ? 'WARM' : fatigue < 70 ? 'TIRED' : 'WORN OUT');\n/** Songwriting (spec 5.3): freshness and popularity up, no money, no fatigue. s = { pop, fresh }. */\nfunction writeSongs(s) {\n  const pop = clamp(s.pop + TUNE.songPop, 0, 100);\n  return { popBefore: s.pop, pop, popChange: pop - s.pop, freshBefore: s.fresh, fresh: clamp(s.fresh + TUNE.songFresh, 0, 100) };\n}\nconst canTravel = (cash) => cash >= TUNE.fare;\n/** The tour is won with the goal or more in cash at the end of week 10. */\nconst isWin = (cash) => cash >= TUNE.goal;\n/** Can the cash pay for a show in at least one venue of this city? */\nconst canConcert = (cash, c) => cash >= Math.min(...c.venues.map((v) => v.rent));\n/** The most advertising the cash allows after the rent. */\nconst maxAd = (cash, rent) => clamp(Math.floor((cash - rent) / TUNE.adStep) * TUNE.adStep, 0, TUNE.adMax);\nconst canAfford = (cash, venue, ad) => venue.rent + ad <= cash;\n/** A whole concert, settled: s = { cash, pop, fresh, fatigue } before it. Returns every figure the result screen shows. */\nfunction settle(s, city, venue, price, ad, roll) {\n  const f = factors(city, price, ad, s.pop, s.fresh, s.fatigue);\n  const att = attendance(city, venue, price, ad, s.pop, s.fresh, s.fatigue, roll);\n  const revenue = att * price, net = revenue - venue.rent - ad, dp = popularityChange(att, venue.capacity);\n  return {\n    att, capacity: venue.capacity, price, revenue, rent: venue.rent, ad, net, roll,\n    cashBefore: s.cash, cash: s.cash + net,\n    popBefore: s.pop, pop: clamp(s.pop + dp, 0, 100), popChange: dp,\n    freshBefore: s.fresh, fresh: clamp(s.fresh - TUNE.freshCost, 0, 100),\n    fatigue: clamp(s.fatigue + TUNE.fatigueGain, 0, 100),\n    note: mainFactor(f, att >= venue.capacity),\n  };\n}\n\n// --- Words ---\n\nconst money = (n) => (n < 0 ? '-$' : '$') + String(Math.abs(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\nconst signed = (n) => (n < 0 ? '-' : '+') + money(Math.abs(n));\nconst SONG_LINES = ['A CHORUS ABOUT A SANDWICH', 'THREE CHORDS, ZERO SLEEP', 'THE SYNTH PLAYER WENT WILD', 'A RHYME FOR \"RENT\" AT LAST', 'THE VAN HUMS ALONG: A HIT?', 'THE NEIGHBORS ARE HUMMING IT'];\nconst ARRIVE_LINES = ['RUST, ROPES AND SEAGULLS', 'SO SUNNY THE VAN MELTS', 'SAWDUST IN THE AIR', 'ALL HONKING, NO PARKING', 'SURF, SAND AND SUNBURN'];\nconst two = (n) => String(n).padStart(2, '0');\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: final cash, initials, a spare (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet tour = null; // the run: week, cash, pop, fresh, city, fatigue per city, counts\nlet hubSel = 0, venueSel = 0, plan = { row: 0, venue: 0, price: TUNE.priceStart, ad: 0 }, show = null, act = null, travelSel = 0;\n\nfunction newTour() {\n  return {\n    week: 1, cash: TUNE.startCash, pop: TUNE.startPop, fresh: TUNE.startFresh, city: 0,\n    fatigue: CITIES.map(() => 0), concerts: 0, songs: 0, trips: 0, best: 0, actions: 0,\n  };\n}\nconst city = () => CITIES[tour.city];\nconst venue = () => city().venues[plan.venue];\nconst cheapestRent = () => Math.min(...city().venues.map((v) => v.rent));\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  const f = ART.scenes.field; // the background: the scene's tiles in Map RAM, shown on layer 0\n  bg(0, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, show: true });\n  if (skipTitle) startTour(); else toTitle();\n}\n\nfunction go(s) { state = s; timer = 0; }\nfunction toTitle() { go('title'); titleSel = 0; paused = false; tour = null; play(SONG.title); }\n\nfunction startTour() {\n  tour = newTour(); hubSel = 0; show = null; act = null; paused = false;\n  plan = { row: 0, venue: 0, price: TUNE.priceStart, ad: 0 };\n  go('hub'); play(SONG.play);\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'hub') updateHub();\n  else if (state === 'venue') updateVenue();\n  else if (state === 'setup') updateSetup();\n  else if (state === 'songs') updateSongs();\n  else if (state === 'travel') updateTravel();\n  else if (state === 'result' || state === 'songResult' || state === 'travelResult') updateResult();\n  else if (state === 'final') updateFinal();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) startTour(); else { go('records'); hl = -1; }\n  }\n}\n\n/** The hub: one action a week. An action that cannot be paid for is greyed, and the hub says why. */\nconst hubOk = () => [canConcert(tour.cash, city()), true, canTravel(tour.cash)];\nfunction updateHub() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(UP)) { hubSel = (hubSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { hubSel = (hubSel + 1) % 3; fx(SFX.move); }\n  if (!pressed(A)) return;\n  if (!hubOk()[hubSel]) { fx(SFX.hit); return; }\n  fx(SFX.select);\n  if (hubSel === 0) { venueSel = clamp(plan.venue, 0, city().venues.length - 1); go('venue'); }\n  else if (hubSel === 1) go('songs');\n  else { travelSel = otherCities()[0]; go('travel'); }\n}\nconst otherCities = () => CITIES.map((_, i) => i).filter((i) => i !== tour.city);\n\n/** Songwriting: the screen says what it costs (a week, no money) and what it gives; A writes, B goes back. */\nfunction updateSongs() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.select); go('hub'); return; }\n  if (pressed(A)) writeSongsNow();\n}\nfunction writeSongsNow() {\n  if (state !== 'songs' || tour.actions >= TUNE.weeks) return;\n  const r = writeSongs(tour);\n  act = { kind: 'songs', week: tour.week, ...r, line: rndi(0, SONG_LINES.length - 1) };\n  tour.pop = r.pop; tour.fresh = r.fresh; tour.songs++; tour.actions++; tour.week++;\n  go('songResult'); fx(SFX.point);\n}\n\n/** Travel: pick one of the other four cities (UP/DOWN), A pays the fare and goes, B goes back. */\nfunction updateTravel() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.select); go('hub'); return; }\n  const dests = otherCities(), i = dests.indexOf(travelSel);\n  if (pressed(UP)) { travelSel = dests[(i + dests.length - 1) % dests.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { travelSel = dests[(i + 1) % dests.length]; fx(SFX.move); }\n  if (pressed(A)) { if (canTravel(tour.cash)) travelNow(travelSel); else fx(SFX.hit); }\n}\nfunction travelNow(dest) {\n  if (state !== 'travel' || tour.actions >= TUNE.weeks || dest === tour.city || !canTravel(tour.cash)) return;\n  act = { kind: 'travel', week: tour.week, from: tour.city, to: dest, fare: TUNE.fare, cashBefore: tour.cash, cash: tour.cash - TUNE.fare };\n  tour.cash -= TUNE.fare; tour.city = dest; plan.venue = 0; tour.trips++; tour.actions++; tour.week++;\n  go('travelResult'); fx(SFX.select);\n}\n\n/** The venue picker: UP/DOWN choose a room, A takes it if the rent can be paid, B goes back. */\nfunction updateVenue() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.select); go('hub'); return; }\n  const n = city().venues.length;\n  if (pressed(UP)) { venueSel = (venueSel + n - 1) % n; fx(SFX.move); }\n  if (pressed(DOWN)) { venueSel = (venueSel + 1) % n; fx(SFX.move); }\n  if (!pressed(A)) return;\n  if (city().venues[venueSel].rent > tour.cash) { fx(SFX.hit); return; }\n  fx(SFX.select);\n  plan.venue = venueSel; plan.row = 0; plan.ad = Math.min(plan.ad, maxAd(tour.cash, venue().rent));\n  go('setup');\n}\n\n/** Concert setup: UP/DOWN pick price or advertising, LEFT/RIGHT change by one step, L/R by a big step. */\nfunction updateSetup() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.select); go('venue'); return; }\n  if (pressed(UP) || pressed(DOWN)) { plan.row ^= 1; fx(SFX.move); }\n  const dir = (btnp(RIGHT) || btnp(R) ? 1 : 0) - (btnp(LEFT) || btnp(L) ? 1 : 0), big = btnp(L) || btnp(R);\n  if (dir) {\n    const before = plan.row === 0 ? plan.price : plan.ad;\n    if (plan.row === 0) plan.price = clamp(plan.price + dir * (big ? TUNE.priceBig : TUNE.priceStep), TUNE.priceMin, TUNE.priceMax);\n    else plan.ad = clamp(plan.ad + dir * (big ? TUNE.adBig : TUNE.adStep), 0, maxAd(tour.cash, venue().rent));\n    if ((plan.row === 0 ? plan.price : plan.ad) !== before) fx(SFX.move);\n  }\n  if (pressed(A)) {\n    if (canAfford(tour.cash, venue(), plan.ad)) playConcert(); else fx(SFX.hit);\n  }\n}\n\n/** Confirm the concert: pay, sell, update the band and the week. The state changes at once, so a second press cannot repeat it. */\nfunction playConcert() {\n  if (state !== 'setup' || tour.actions >= TUNE.weeks) return;\n  const s = { cash: tour.cash, pop: tour.pop, fresh: tour.fresh, fatigue: tour.fatigue[tour.city] };\n  show = settle(s, city(), venue(), plan.price, plan.ad, rndi(TUNE.rollMin, TUNE.rollMax));\n  show.week = tour.week;\n  tour.cash = show.cash; tour.pop = show.pop; tour.fresh = show.fresh; tour.fatigue[tour.city] = show.fatigue;\n  tour.concerts++; tour.best = Math.max(tour.best, show.net); tour.actions++; tour.week++;\n  go('result');\n  fx(show.net >= 0 ? SFX.point : SFX.hit);\n}\n\n/** After any action's results screen: A (not in the first 20 frames) goes on to the next week, or to the end after week 10. */\nfunction updateResult() {\n  if (pressed(START) && timer > 20) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (timer < 20 || !pressed(A)) return;\n  fx(SFX.select);\n  if (tour.week > TUNE.weeks) toFinal(); else go('hub');\n}\n\nfunction toFinal() { go('final'); play(-1); fx(isWin(tour.cash) ? SFX.record : SFX.over); }\n\n/** After the tour: the cash is the score. A top-10 cash asks for initials. */\nfunction updateFinal() {\n  if (timer < 40 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  rank = insertTop({ score: tour.cash, initials: lastInitials() });\n  if (rank >= 0) { go('initials'); initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  go('records'); hl = rank;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startTour(); // restart\n    else toTitle(); // quitting abandons the tour: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  if (state === 'title') drawTitle();\n  else if (state === 'hub') drawHub();\n  else if (state === 'venue') drawVenue();\n  else if (state === 'setup') drawSetup();\n  else if (state === 'result') drawResult();\n  else if (state === 'songs') drawSongs();\n  else if (state === 'songResult') drawSongResult();\n  else if (state === 'travel') drawTravel();\n  else if (state === 'travelResult') drawTravelResult();\n  else if (state === 'final') drawFinal();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (paused) drawPause();\n}\n\nfunction drawTitle() {\n  sprite(ART.sprites.van, 120, 150);\n  ctxt('RAGS TO RICHES', 50, GOLD);\n  ctxt('RAISE $5,000 IN 10 WEEKS', 70, WHITE);\n  ['NEW TOUR', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\n\n/** The line of figures at the top of every tour screen. */\nfunction drawStatus() {\n  panel(8, 8, 240, 48);\n  txt(`WEEK ${two(Math.min(tour.week, TUNE.weeks))}/${TUNE.weeks}`, 16, 14, WHITE);\n  rtxt(`CASH ${money(tour.cash)}`, 240, 14, isWin(tour.cash) ? GREEN : WHITE);\n  txt(`CITY: ${city().name}`, 16, 28, WHITE);\n  rtxt(`POP ${tour.pop}`, 240, 28, WHITE);\n  txt(`FRESHNESS: ${tour.fresh}`, 16, 42, WHITE);\n  rtxt(`GOAL ${money(TUNE.goal)}`, 240, 42, GOLD);\n}\n\nfunction drawHub() {\n  drawStatus();\n  sprite(ART.sprites.van, 120, 168);\n  panel(8, 72, 240, 82);\n  const items = ['PLAY A CONCERT', 'WRITE NEW SONGS', `TRAVEL (${money(TUNE.fare)})`], ok = hubOk();\n  items.forEach((t, i) => txt(`${i === hubSel ? '> ' : '  '}${t}`, 40, 84 + i * 14, !ok[i] ? GREY : i === hubSel ? WHITE : DIM));\n  if (!ok[hubSel]) {\n    ctxt(hubSel === 0 ? `NEED ${money(cheapestRent())} FOR ANY ROOM` : `NEED ${money(TUNE.fare)} FOR THE BUS`, 132, RED);\n  } else {\n    const c = city();\n    ctxt(`CROWD ${c.crowd}  ROOMS ${c.rooms}`, 128, DIM);\n    ctxt(`RIVALS ${c.rivals}  FANS ${fansWord(tour.fatigue[tour.city])}`, 140, DIM);\n  }\n  ctxt('EACH ACTION TAKES ONE WEEK', 160, DIM);\n  ctxt('A: SELECT   START: PAUSE', 206, WHITE);\n}\n\nfunction drawVenue() {\n  drawStatus();\n  panel(8, 64, 240, 142);\n  ctxt('PICK A VENUE', 72, GOLD);\n  city().venues.forEach((v, i) => {\n    const y = 90 + i * 34, on = i === venueSel, ok = v.rent <= tour.cash, c = !ok ? GREY : on ? WHITE : DIM;\n    txt(`${on ? '> ' : '  '}${v.name}`, 20, y, c);\n    if (!ok) rtxt(`NEED ${money(v.rent - tour.cash)}`, 236, y, RED);\n    txt(`ROOM FOR ${v.capacity}`, 36, y + 12, c); rtxt(`RENT ${money(v.rent)}`, 236, y + 12, c);\n  });\n  ctxt('A: PICK  B: BACK', 194, WHITE);\n}\n\nfunction drawSetup() {\n  const v = venue(), after = tour.cash - v.rent - plan.ad, ok = canAfford(tour.cash, v, plan.ad);\n  drawStatus();\n  panel(8, 64, 240, 142);\n  ctxt(v.name, 70, GOLD);\n  ctxt(`ROOM FOR ${v.capacity}   RENT ${money(v.rent)}`, 82, WHITE);\n  txt(`${plan.row === 0 ? '> ' : '  '}TICKET PRICE`, 20, 100, plan.row === 0 ? WHITE : DIM);\n  rtxt(`< ${money(plan.price)} >`, 236, 100, plan.row === 0 ? WHITE : DIM);\n  txt(`${plan.row === 1 ? '> ' : '  '}ADVERTISING`, 20, 114, plan.row === 1 ? WHITE : DIM);\n  rtxt(`< ${money(plan.ad)} >`, 236, 114, plan.row === 1 ? WHITE : DIM);\n  txt('UPFRONT COST', 20, 134, WHITE); rtxt(money(v.rent + plan.ad), 236, 134, WHITE);\n  txt('CASH AFTER', 20, 148, WHITE); rtxt(ok ? money(after) : `NEED ${money(-after)} MORE`, 236, 148, ok ? WHITE : RED);\n  const f = forecast(city(), v, plan.price, plan.ad, tour.pop, tour.fresh, tour.fatigue[tour.city]);\n  txt('CROWD FORECAST', 20, 162, WHITE); rtxt(f, 236, 162, f === 'LOW' ? RED : f === 'FAIR' ? GOLD : GREEN);\n  ctxt(`THIS USES WEEK ${tour.week} OF ${TUNE.weeks}`, 178, DIM);\n  ctxt(ok ? 'A: PLAY  B: BACK  L/R: BIG' : \"CAN'T PAY: B TO GO BACK\", 194, ok ? WHITE : RED);\n}\n\nfunction drawResult() {\n  const r = show;\n  panel(8, 8, 240, 208);\n  ctxt(`WEEK ${r.week} CONCERT`, 16, GOLD);\n  ctxt(r.att >= r.capacity ? `SOLD OUT! ${r.att} CAME` : `${r.att} OF ${r.capacity} CAME`, 28, r.att >= r.capacity ? GOLD : WHITE);\n  rect(20, 40, 216, 6, PANEL); rectfill(21, 41, Math.floor(214 * r.att / r.capacity), 4, r.att >= r.capacity ? GOLD : CYAN);\n  row(`TICKETS ${r.att} X ${money(r.price)}`, money(r.revenue), 54);\n  row('VENUE RENT', signed(-r.rent), 68);\n  row('ADVERTISING', signed(-r.ad), 82);\n  row('NET', signed(r.net), 100, r.net >= 0 ? GREEN : RED);\n  row('CASH NOW', money(r.cash), 114);\n  row('POPULARITY', `${r.popBefore} > ${r.pop} (${r.popChange >= 0 ? '+' : ''}${r.popChange})`, 136, r.popChange >= 0 ? WHITE : RED);\n  row('FRESHNESS', `${r.freshBefore} > ${r.fresh}`, 150);\n  ctxt(r.note, 176, CYAN);\n  if (timer >= 20) ctxt(tour.week > TUNE.weeks ? 'A: SEE THE FINAL TALLY' : `A: ON TO WEEK ${tour.week}`, 198, WHITE);\n}\n\n/** A line of a results screen: a label on the left, a value on the right. */\nfunction row(label, value, y, c = WHITE) { txt(label, 20, y, c); rtxt(value, 236, y, c); }\n\nfunction drawSongs() {\n  const r = writeSongs(tour);\n  drawStatus();\n  panel(8, 64, 240, 142);\n  ctxt('WRITE NEW SONGS', 72, GOLD);\n  ctxt('A WEEK IN THE REHEARSAL ROOM', 90, DIM);\n  row('FRESHNESS', `${r.freshBefore} > ${r.fresh}`, 112);\n  row('POPULARITY', `${r.popBefore} > ${r.pop}`, 126);\n  row('COST', `${money(0)} AND A WEEK`, 148);\n  row('INCOME THIS WEEK', money(0), 162, RED);\n  ctxt(`THIS USES WEEK ${tour.week} OF ${TUNE.weeks}`, 178, DIM);\n  ctxt('A: WRITE   B: BACK', 194, WHITE);\n}\n\nfunction drawSongResult() {\n  const r = act;\n  panel(8, 8, 240, 208);\n  ctxt(`WEEK ${r.week} NEW SONGS`, 16, GOLD);\n  ctxt(SONG_LINES[r.line], 34, CYAN);\n  row('FRESHNESS', `${r.freshBefore} > ${r.fresh}`, 66);\n  row('POPULARITY', `${r.popBefore} > ${r.pop} (+${r.popChange})`, 80);\n  row('TICKETS SOLD', '0', 108);\n  row('INCOME', money(0), 122);\n  row('CASH NOW', money(tour.cash), 136);\n  ctxt('NO MONEY THIS WEEK, BUT', 162, DIM);\n  ctxt('NEXT CROWD WILL BE BIGGER', 174, DIM);\n  if (timer >= 20) ctxt(tour.week > TUNE.weeks ? 'A: SEE THE FINAL TALLY' : `A: ON TO WEEK ${tour.week}`, 198, WHITE);\n}\n\nfunction drawTravel() {\n  drawStatus();\n  panel(8, 64, 240, 142);\n  ctxt(`WHERE TO?  ${money(TUNE.fare)} AND A WEEK`, 72, GOLD);\n  otherCities().forEach((ci, i) => {\n    const c = CITIES[ci], y = 88 + i * 14, on = ci === travelSel, f = tour.fatigue[ci];\n    txt(`${on ? '> ' : '  '}${c.name}`, 20, y, on ? WHITE : DIM);\n    if (f > 0) rtxt(`FANS ${fansWord(f)}`, 236, y, on ? WHITE : DIM);\n  });\n  const c = CITIES[travelSel];\n  ctxt(`CROWD ${c.crowd}  ROOMS ${c.rooms}`, 150, DIM);\n  ctxt(`RIVALS ${c.rivals}  FROM ${money(Math.min(...c.venues.map((v) => v.rent)))}`, 162, DIM);\n  ctxt(canTravel(tour.cash) ? `THIS USES WEEK ${tour.week} OF ${TUNE.weeks}` : `NEED ${money(TUNE.fare)} FOR THE BUS`, 178, canTravel(tour.cash) ? DIM : RED);\n  ctxt('A: GO   B: BACK', 194, WHITE);\n}\n\nfunction drawTravelResult() {\n  const r = act, c = CITIES[r.to];\n  panel(8, 8, 240, 208);\n  ctxt(`WEEK ${r.week} ON THE ROAD`, 16, GOLD);\n  ctxt(`${CITIES[r.from].name} > ${c.name}`.slice(0, 28), 34, WHITE);\n  ctxt(ARRIVE_LINES[r.to], 50, CYAN);\n  row('BUS FARE', signed(-r.fare), 80);\n  row('CASH NOW', money(r.cash), 94);\n  row('CONCERT THIS WEEK', 'NONE', 116, DIM);\n  ctxt(`CROWD ${c.crowd}  ROOMS ${c.rooms}`, 140, DIM);\n  ctxt(`RIVALS ${c.rivals}  FANS ${fansWord(tour.fatigue[r.to])}`, 152, DIM);\n  if (timer >= 20) ctxt(tour.week > TUNE.weeks ? 'A: SEE THE FINAL TALLY' : `A: ON TO WEEK ${tour.week}`, 198, WHITE);\n}\n\nfunction drawFinal() {\n  const win = isWin(tour.cash);\n  panel(24, 24, 208, 176);\n  ctxt(win ? 'YOU DID IT!' : 'TOUR OVER', 36, win ? GREEN : RED);\n  ctxt('FINAL CASH', 58, DIM);\n  ctxt(money(tour.cash), 72, win ? GREEN : WHITE);\n  ctxt(win ? `${money(tour.cash - TUNE.goal)} OVER THE GOAL` : `${money(TUNE.goal - tour.cash)} SHORT OF ${money(TUNE.goal)}`, 90, win ? GOLD : RED);\n  ctxt(`CONCERTS ${tour.concerts}  SONGS ${tour.songs}  TRIPS ${tour.trips}`, 116, WHITE);\n  ctxt(`BEST NIGHT  ${signed(tour.best)}`, 130, WHITE);\n  ctxt(`POPULARITY  ${tour.pop}`, 144, WHITE);\n  if (timer >= 40 && timer % 60 < 40) ctxt('A: CONTINUE', 176, WHITE);\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    if (e.score) rtxt(money(e.score), 216, y, i === 0 ? GOLD : WHITE);\n  });\n  if (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(money(tour.cash), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SHADOW); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nconst rtxt = (s, right, y, c) => txt(s, right - s.length * 8, y, c);\n",

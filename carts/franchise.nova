40 ? 5 : 0], [w >= GOALW ? 'GOAL MET' : 'GOAL MISSED', w >= GOALW ? 6 : -6]].filter((x) => x[1]);\n}\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null, score = 0;\nlet G = null, gi = 0, gSpeed = 0, gWait = 0, boxTeam = 0, boxView = 0, hubSel = 0, newSel = 0, newSeed = 1, rows = [], sel = 0, view = 0, viewTeam = 0, backTo = 'hub', newRows = null, sim = null, stView = 0, ed = -1, cardP = null, finSel = 0, rs = [], arm = false;\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nblend({ layers: ['overlay'], half: true });\nif (skipTitle) startCareer(rndi(1, 99999), 0); else toTitle();\n}\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\nfunction startCareer(seed, t) { newCareer(seed, t); toHub(); }\nfunction toHub() { state = 'hub'; timer = 0; hubSel = 0; paused = false; play(SONG.play); }\nfunction teamRows() {\nreturn Array.from({ length: NT }, (_, t) => ({ t, ovr: strength(t, YEAR), pay: payroll(t, YEAR) })).sort((a, b) => b.ovr - a.ovr || a.t - b.t);\n}\nfunction buildTeam() {\nconst y = VY(), pn = new Map(plan(viewTeam, y, today()).map((q) => [q.p.id, q]));\nrows = roster(viewTeam, y).map((p) => ({ p, o: ovr(p, y), r: ratings(p, y), c: contractAt(p, y), h: hurt(p, y, today()), q: pn.get(p.id), e: ENT.get(p.id) })).sort((a, b) => b.o - a.o);\n}\nfunction openTeam(t, from) { viewTeam = t; backTo = from; state = 'team'; sel = 0; view = 0; ed = -1; buildTeam(); }\nfunction openLeague() { state = 'league'; rows = teamRows(); sel = Math.max(0, rows.findIndex((r) => r.t === ME)); }\nfunction openNew() { state = 'new'; timer = 0; newSeed = rndi(1, 99999); SEED = newSeed; ME = 0; YEAR = 0; ENT.clear(); resetLeague(); newRows = teamRows(); newSel = 0; }\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'new') updateNew();\nelse if (state === 'hub') updateHub();\nelse if (state === 'league') updateLeague();\nelse if (state === 'team') updateTeam();\nelse if (state === 'sim') updateSim();\nelse if (state === 'standings') updateStandings();\nelse if (state === 'sched') updateSched();\nelse if (state === 'card') updateCard();\nelse if (state === 'fin') updateFin();\nelse if (state === 'fa') updateFA();\nelse if (state === 'draft') updateDraft();\nelse if (state === 'verdict') updateVerdict();\nelse if (state === 'report') updateReport();\nelse if (state === 'live') updateLive();\nelse if (state === 'box') updateBox();\nelse if (state === 'over') updateOver();\nelse if (state === 'initials') updateInitials();\nelse if (state === 'records') updateRecords();\nprevMask = inputMask;\n}\nconst menuMove = (n, v) => { if (pressed(UP)) { fx(SFX.move); return (v + n - 1) % n; } if (pressed(DOWN)) { fx(SFX.move); return (v + 1) % n; } return v; };\nfunction listMove(n) {\nlet v = sel;\nif (btnp(UP)) v = Math.max(0, v - 1);\nif (btnp(DOWN)) v = Math.min(n - 1, v + 1);\nif (v !== sel) { sel = v; fx(SFX.move); }\n}\nfunction updateTitle() {\nconst items = hasCareer() ? 3 : 2;\ntitleSel = menuMove(items, titleSel);\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nconst choice = hasCareer() ? titleSel : titleSel + 1;\nif (choice === 0) { loadCareer(); toHub(); } else if (choice === 1) openNew(); else { state = 'records'; hl = -1; timer = 0; }\n}\n}\nfunction updateNew() {\nconst before = newSel;\nif (pressed(UP)) newSel = Math.max(0, newSel - 1);\nif (pressed(DOWN)) newSel = Math.min(NT - 1, newSel + 1);\nif (before !== newSel) fx(SFX.move);\nif (pressed(X)) { fx(SFX.move); newSeed = rndi(1, 99999); SEED = newSeed; resetLeague(); newRows = teamRows(); }\nif (pressed(B)) toTitle();\nif (pressed(A)) { fx(SFX.select); startCareer(newSeed, newRows[newSel].t); }\n}\nfunction hubItems() {\nconst base = ['FREE AGENTS', 'ROSTER', 'STANDINGS', 'SCHEDULE', 'FINANCES', 'LEAGUE', 'RETIRE', 'QUIT TO TITLE'];\nif (PHASE === 2) return ['NEXT YEAR', ...(PRD < 5 ? ['DRAFT'] : []), 'VERDICT', ...base];\nreturn [...(roster(ME, YEAR).length < 10 ? [] : [...(myGame() ? ['PLAY NEXT GAME'] : []), 'SIM DAY', 'SIM WEEK', PHASE ? 'SIM TO END' : 'SIM TO PLAYOFFS']), ...base];\n}\nconst HUB = hubItems;\nfunction updateHub() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nconst items = hubItems();\nhubSel = Math.min(hubSel, items.length - 1);\nhubSel = menuMove(items.length, hubSel);\nif (!pressed(A)) return;\nfx(SFX.select);\nconst it = items[hubSel];\nif (it === 'ROSTER') openTeam(ME, 'hub');\nelse if (it === 'LEAGUE') openLeague();\nelse if (it === 'STANDINGS') { state = 'standings'; stView = PHASE ? 2 : confOf(ME); sel = 0; }\nelse if (it === 'SCHEDULE') { state = 'sched'; sel = Math.min(DAY, DAYS - 1); }\nelse if (it === 'PLAY NEXT GAME') startNext();\nelse if (it === 'SIM DAY') startSim(1);\nelse if (it === 'SIM WEEK') startSim(7);\nelse if (it === 'SIM TO PLAYOFFS' || it === 'SIM TO END') startSim(999);\nelse if (it === 'FINANCES') { state = 'fin'; finSel = 0; }\nelse if (it === 'FREE AGENTS') { state = 'fa'; sel = 0; rs = pool(); }\nelse if (it === 'DRAFT') startDraft();\nelse if (it === 'VERDICT') state = 'verdict';\nelse if (it === 'NEXT YEAR') { const n = roster(ME, YEAR + 1).length; if (n < 10 || n > 15) lastRes = n < 10 ? `NEED 10 PLAYERS, HAVE ${n}` : `CUT TO 15, HAVE ${n}`; else if (PAT <= 0 || YEAR >= MAX_YEAR) { why = PAT <= 0 ? 'FIRED' : 'CAREER OVER'; gameOver(legacy()); } else { nextYear(); hubSel = 0; } }\nelse if (it === 'RETIRE') { why = 'RETIRED'; gameOver(legacy()); }\nelse toTitle();\n}\nfunction startSim(n, watch = false) { sim = { left: n, phase: PHASE, watch }; beginDay(); state = 'sim'; }\nfunction updateSim() {\nif (pressed(B)) sim.stop = true;\nif (todo.length) { playOne(); return; }\nconst g = endDay(); sim.left--; saveSeason();\nif (sim.watch && g) { G = g; gi = 0; gSpeed = 0; gWait = 0; state = 'live'; boxTeam = G.home === ME ? 0 : 1; boxView = 0; sim = null; play(SONG.title); return; }\nif (sim.stop || sim.left <= 0 || PHASE !== sim.phase) { state = 'hub'; sim = null; } else beginDay();\n}\nconst startNext = () => startSim(1, true);\nconst FOCUS = ['NONE', ...RN];\nfunction trainAll() {\nconst gains = [];\nfor (const p of roster(ME, YEAR)) {\nconst e = ENT.get(p.id);\nif (!e || !e.focus) continue;\nconst i = e.focus - 1, a = age(p, YEAR + 1), chance = (a <= 21 ? 85 : a <= 24 ? 65 : a <= 27 ? 45 : a <= 30 ? 25 : 10) + SETS[2] * 2, h = hash(SEED, p.id, YEAR, 41) % 100;\nif (h < chance && e.bonus[i] < 7) { const n = Math.min(7 - e.bonus[i], a <= 22 && h < chance / 4 ? 2 : 1); e.bonus[i] += n; gains.push([p.id, i, n]); }\n}\nreturn gains;\n}\nfunction nextYear() {\nconst was = new Map(roster(ME, YEAR).map((p) => [p.id, [ovr(p, YEAR), p]])), gains = trainAll();\nsetYear(YEAR + 1);\nconst now = roster(ME, YEAR);\nrows = [];\nfor (const p of now) {\nconst w = was.get(p.id), gn = gains.find((x) => x[0] === p.id);\nif (w) { const d = ovr(p, YEAR) - w[0]; rows.push([`${pname(p, 10).padEnd(10)} ${pad(age(p, YEAR), 2)} ${pad(w[0], 2)}>${pad(ovr(p, YEAR), 2)} ${(d > 0 ? '+' : '') + d}${gn ? ` TRAINED ${RN[gn[1]]}` : ''}`, d >= 2 ? GOLD : d < 0 ? DIM : WHITE]); }\nelse rows.push([`${pname(p, 10).padEnd(10)} ${pad(age(p, YEAR), 2)} ${pad(ovr(p, YEAR), 2)} NEW`, CYAN]);\n}\nfor (const [id, w] of was) if (!now.some((p) => p.id === id)) rows.push([`${pname(w[1], 10).padEnd(10)} ${pad(age(w[1], YEAR - 1), 2)} ${pad(w[0], 2)} LEFT`, RED]);\nfor (const id of [...ENT.keys()]) if (ENT.get(id).team !== 30 && (ENT.get(id).team === ME || ENT.get(id).team === 31 || !ENT.get(id).yrs) && !now.some((p) => p.id === id)) ENT.delete(id);\nsaveEntries(); resetLeague();\nstate = 'report'; sel = 0;\n}\nfunction updateReport() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nlistMove(rows.length);\nif (pressed(A) || pressed(B)) { fx(SFX.select); state = 'hub'; }\n}\nfunction updateStandings() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nif (pressed(LEFT) || pressed(L)) { stView = (stView + 2) % 3; fx(SFX.move); }\nif (pressed(RIGHT) || pressed(R)) { stView = (stView + 1) % 3; fx(SFX.move); }\nif (pressed(B)) state = 'hub';\n}\nfunction updateSched() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nlistMove(DAYS);\nif (pressed(B)) state = 'hub';\n}\nfunction updateLeague() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nlistMove(rows.length);\nif (pressed(B)) { state = 'hub'; return; }\nif (pressed(A)) {\nfx(SFX.select); openTeam(rows[sel].t, 'league');\n}\n}\nconst SPEEDS = [14, 6, 2];\nfunction updateLive() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nif (gi >= G.log.length) { if (pressed(A) || pressed(B)) { fx(SFX.select); state = 'box'; } return; }\nif (pressed(A)) { gSpeed = (gSpeed + 1) % SPEEDS.length; fx(SFX.move); }\nif (pressed(B)) { gi = G.log.length; fx(SFX.select); return; }\nif (++gWait >= SPEEDS[gSpeed]) {\ngWait = 0;\nconst e = G.log[gi++];\nif (e.kind === 'make' || e.kind === 'ft') fx(SFX.point);\n}\n}\nfunction updateBox() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nif (pressed(LEFT) || pressed(RIGHT)) { boxTeam ^= 1; fx(SFX.move); }\nif (pressed(X) || pressed(UP) || pressed(DOWN)) { boxView ^= 1; fx(SFX.move); }\nif (pressed(B) || pressed(A)) { fx(SFX.select); state = 'hub'; play(SONG.play); }\n}\nfunction updateTeam() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nconst mine = viewTeam === ME, nv = mine ? 3 : 2;\nif (ed >= 0) {\nconst p = rows[sel].p, e = ENT.get(p.id) || { mins: 0, focus: 0 };\nif (ed === 2 && pressed(A)) {\nif (!arm) { arm = true; fx(SFX.select); return; }\nconst c = contractAt(p, VY()), en = ENT.get(p.id); arm = false; ed = -1; fx(SFX.over);\nif (c) { if (!(en && en.yrs && en.since >= VY())) CASH -= Math.round(c[0] * c[1] / 2); edit(p, (x) => { x.team = 31; x.sal = c[0]; x.yrs = 1; x.since = VY(); }); saveSeason(); buildTeam(); sel = Math.min(sel, rows.length - 1); }\nreturn;\n}\nif (pressed(A) || pressed(B)) { ed = -1; arm = false; fx(SFX.select); return; }\nif (pressed(UP) || pressed(DOWN)) { ed = (ed + (pressed(UP) ? 2 : 1)) % 3; arm = false; fx(SFX.move); }\nconst d = ed < 2 ? (btnp(RIGHT) ? 1 : btnp(LEFT) ? -1 : 0) : 0;\nif (d) { const n = ed ? 7 : 26, v = ((ed ? e.focus : e.mins) + d + n) % n; fx(SFX.move); edit(p, (x) => { if (ed) x.focus = v; else x.mins = v; }); buildTeam(); }\nreturn;\n}\nlistMove(rows.length);\nif (pressed(RIGHT) || pressed(R)) { view = (view + 1) % nv; fx(SFX.move); }\nif (pressed(LEFT) || pressed(L)) { view = (view + nv - 1) % nv; fx(SFX.move); }\nif (pressed(Y)) { fx(SFX.select); cardP = rows[sel].p; state = 'card'; }\nif (pressed(A) && mine) { fx(SFX.select); ed = 0; }\nif (pressed(B)) { if (backTo === 'league') { const t = viewTeam; openLeague(); sel = Math.max(0, rows.findIndex((r) => r.t === t)); } else state = 'hub'; }\n}\nfunction expiring() {\nconst end = (p) => { const e = ENT.get(p.id); return e && e.yrs ? e.since + e.yrs : p.leave; };\nreturn roster(ME, YEAR).filter((p) => end(p) === YEAR + 1 && age(p, YEAR + 1) <= 36).sort((a, b) => ovr(b, YEAR) - ovr(a, YEAR));\n}\nfunction signDeal(p, n) {\nconst e = ENT.get(p.id), cur = e && e.yrs && e.since <= YEAR;\nedit(p, (x) => { x.team = ME; x.sal = ask(p, n); x.since = cur ? YEAR : VY(); x.yrs = n + (cur ? 1 : 0); });\n}\nfunction ask(p, n) {\nconst a = age(p, VY()), m = 92 + (hash(SEED, p.id, YEAR, 51) % 17) + (RES ? 0 : 4);\nreturn clamp(Math.floor(salaryFor(ovr(p, VY())) * m * (100 + (a >= 29 ? (n - 1) * 3 : -(n - 1) * 2)) / 10000), 6, 200);\n}\nfunction pool() {\nconst L = [], y = VY();\nfor (let i = 0; i < 38; i++) L.push({ p: street(y, i) });\nif (PHASE === 2) {\nfor (const p of expiring()) L.push({ p, own: 1 });\nfor (let t = 0; t < NT; t++) if (t !== ME) for (let s = 0; s < SL; s++) { const p = slotAt(t, s, YEAR); if (p && p.leave === y && age(p, y) <= 36) L.push({ p }); }\n}\nfor (const r of L) { const e = ENT.get(r.p.id); r.n = 3; r.done = !!(e && e.yrs && e.team === ME && e.since >= y); }\nreturn L.sort((a, b) => ovr(b.p, y) - ovr(a.p, y));\n}\nconst canSign = (r) => !r.done && roster(ME, VY()).length < 15 && (r.own || payroll(ME, VY()) + ask(r.p, r.n) <= CAP || ask(r.p, r.n) <= 12);\nfunction updateFA() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nlistMove(rs.length);\nconst r = rs[sel];\nif (r && btnp(RIGHT)) r.n = Math.min(5, r.n + 1);\nif (r && btnp(LEFT)) r.n = Math.max(1, r.n - 1);\nif (r && pressed(A) && canSign(r)) { fx(SFX.point); r.done = true; signDeal(r.p, r.n); }\nif (pressed(X)) { for (const r of rs.filter((x) => x.own).concat(rs)) if (roster(ME, VY()).length < (r.own ? 15 : 13) && canSign(r)) { r.done = true; signDeal(r.p, r.n); } fx(SFX.point); }\nif (pressed(B)) state = 'hub';\n}\nfunction drawFA() {\nheader('FREE AGENTS', `ROOM $${money(CAP - payroll(ME, VY()))}M`);\ntxt(`ROSTER ${roster(ME, VY()).length}/15  NAME      POS AGE OVR`.slice(0, 32), 8, 24, DIM);\ndrawList(rs.map((r) => [`${r.own ? '*' : ' '}${pname(r.p, 9).padEnd(9)} ${POS[r.p.pos].padEnd(2)} ${pad(age(r.p, VY()), 2)} ${pad(ovr(r.p, VY()), 3)} ${r.done ? ' SIGNED' : `${pad(money(ask(r.p, r.n)), 5)}M ${r.n}Y`}`, r.done ? GOLD : canSign(r) ? WHITE : DIM]), sel, 36, 16);\nfooter('LR:YEARS A:SIGN X:FILL B:BACK');\n}\nlet D = null;\nconst rookie = (n) => [Math.max(6, 34 - n - (n >> 1)), n < 30 ? 4 : 2];\nconst value = (p) => overall(p.pos, p.R) + ovr(p, YEAR);\nconst est = (p, v, k) => { const r = (5 - SETS[1]) * k; return v + (hash(SEED, p.id, 61, k) % (2 * r + 1)) - r; };\nfunction best() { return D.av.reduce((a, b) => (value(D.list[b]) > value(D.list[a]) ? b : a)); }\nfunction takeP(i) {\nconst t = D.order[D.pos];\nD.av = D.av.filter((x) => x !== i); D.log.push(`${pad(D.pos + 1, 2)} ${team(t).nick.slice(0, 9).padEnd(9)} ${pname(D.list[i], 10)}`);\nif (t === ME) D.mine.push([i, D.pos]);\nD.pos++;\n}\nfunction runAI() {\nwhile (D.pos < 60 && D.order[D.pos] !== ME) takeP(best());\nif (D.pos >= 60) { for (const [i, n] of D.mine) { const [sal, yrs] = rookie(n); edit(D.list[i], (e) => { e.team = ME; e.sal = sal; e.yrs = yrs; e.since = YEAR + 1; }); } PRD = 5; saveSeason(); }\n}\nfunction startDraft() {\nconst key = (t) => WINS[t] * 8 + (hash(SEED, YEAR, t, 61) % 40), o = Array.from({ length: NT }, (_, t) => t).sort((a, b) => key(a) - key(b));\nD = { order: o.concat(o), pos: 0, log: [], mine: [], list: Array.from({ length: 60 }, (_, i) => prospect(YEAR, i)), av: [] };\nD.av = D.list.map((_, i) => i).sort((a, b) => est(D.list[b], value(D.list[b]), 2) - est(D.list[a], value(D.list[a]), 2));\nrunAI(); state = 'draft'; sel = 0;\n}\nfunction updateDraft() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nif (D.pos >= 60) { if (pressed(A) || pressed(B)) state = 'hub'; return; }\nlistMove(D.av.length);\nif (pressed(A)) { fx(SFX.point); takeP(D.av[sel]); runAI(); sel = 0; }\nif (pressed(B)) { while (D.pos < 60) takeP(best()); runAI(); }\n}\nfunction drawDraft() {\nconst done = D.pos >= 60;\nheader('DRAFT', done ? 'DONE' : `PICK ${D.pos + 1}`);\nif (done) { txt('YOUR PICKS', 8, 26, DIM); D.mine.forEach(([i, n], k) => txt(`${pad(n + 1, 2)} ${pname(D.list[i], 10)} ${POS[D.list[i].pos]} ${age(D.list[i], YEAR)} OVR ${ovr(D.list[i], YEAR)}`, 8, 38 + k * 10, WHITE)); if (!D.mine.length) txt('NONE', 8, 38, DIM); }\nelse {\ntxt('NAME       POS AGE OVR POT', 8, 24, DIM);\ndrawList(D.av.map((i) => { const p = D.list[i], v = value(p); return [`${pname(p, 10).padEnd(10)} ${POS[p.pos].padEnd(2)} ${pad(age(p, YEAR), 3)} ${pad(est(p, ovr(p, YEAR), 1), 3)} ${pad(est(p, overall(p.pos, p.R), 2), 3)}`, WHITE]; }), sel, 36, 11);\n}\nD.log.slice(-5).forEach((l, k) => txt(l, 8, 152 + k * 10, k === 4 ? GOLD : DIM));\nfooter(done ? 'A:BACK' : 'A:PICK  B:AUTO  SCOUTING SHARPENS');\n}\nfunction updateFin() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nfinSel = menuMove(3, finSel);\nconst d = btnp(RIGHT) ? 1 : btnp(LEFT) ? -1 : 0;\nif (d) { SETS[finSel] = clamp(SETS[finSel] + d, 0, finSel ? 5 : 10); fx(SFX.move); saveSeason(); }\nif (pressed(B)) state = 'hub';\n}\nfunction updateVerdict() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nif (pressed(A) || pressed(B)) state = 'hub';\n}\nfunction updateCard() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nif (pressed(B) || pressed(Y) || pressed(A)) { fx(SFX.select); state = 'team'; }\n}\nfunction gameOver(v) {\nscore = v; state = 'over'; timer = 0; play(-1); fx(SFX.over);\nrank = insertTop({ score, initials: lastInitials() });\n}\nfunction updateOver() {\nif (timer < 60 || !(pressed(A) || pressed(START))) return;\nfx(SFX.select);\nif (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\nelse toTitle();\n}\nfunction updateInitials() {\nconst ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\nif (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\nif (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\nconst done = pressed(START) || (pressed(A) && ini.pos === 2);\nif (pressed(A) && ini.pos < 2) ini.pos++;\nif (!done || timer < 20) return;\nconst v = packInitials(ini.chars.join(''));\ndset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\nfx(SFX.select);\nstate = 'records'; hl = rank; timer = 0;\n}\nfunction updateRecords() {\nif ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\nfunction updatePause() {\npauseSel = menuMove(2, pauseSel);\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse toTitle();\n}\n}\nfunction draw() {\ncls();\nif (state === 'title') drawTitle();\nelse if (state === 'new') drawNew();\nelse if (state === 'hub') drawHub();\nelse if (state === 'league') drawLeague();\nelse if (state === 'team') drawTeam();\nelse if (state === 'sim') drawSim();\nelse if (state === 'standings') drawStandings();\nelse if (state === 'sched') drawSched();\nelse if (state === 'card') drawCard();\nelse if (state === 'fin') drawFin();\nelse if (state === 'fa') drawFA();\nelse if (state === 'draft') drawDraft();\nelse if (state === 'verdict') drawVerdict();\nelse if (state === 'report') drawReport();\nelse if (state === 'live') drawLive();\nelse if (state === 'box') drawBox();\nelse if (state === 'initials') drawInitials();\nelse if (state === 'records') drawRecords();\nelse if (state === 'over') { drawHub(); panel(48, 80, 160, 64); ctxt(why || 'RETIRED', 92, GOLD); ctxt(`LEGACY ${score}`, 108, WHITE); if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 126, DIM); }\nif (paused) drawPause();\n}\nconst money = (u) => `${(u / 4).toFixed(1)}`;\nconst pname = (p, w = 11) => `${names()[0][p.fn][0]}.${names()[1][p.ln]}`.slice(0, w);\nconst tname = (t) => `${team(t).city} ${team(t).nick}`;\nconst pad = (v, n) => String(v).padStart(n);\nfunction drawList(list, sel, y0, max, rh = 10) {\nconst top = clamp(sel - (max >> 1), 0, Math.max(0, list.length - max));\nfor (let i = 0; i < max && top + i < list.length; i++) {\nconst y = y0 + i * rh, on = top + i === sel;\nif (on) rectfill(4, y - 1, 248, rh, PANEL);\ntxt(list[top + i][0], 8, y, on ? WHITE : list[top + i][1]);\n}\nif (top > 0) txt('^', 244, y0, GOLD);\nif (top + max < list.length) txt('v', 244, y0 + (max - 1) * rh, GOLD);\n}\nfunction header(left, right) { txt(left, 8, 6, GOLD); txt(right, 248 - right.length * 8, 6, WHITE); rectfill(4, 18, 248, 1, PANEL); }\nfunction footer(s) { rectfill(4, 210, 248, 1, PANEL); txt(s, 8, 214, DIM); }\nfunction drawTitle() {\nctxt('THE FRANCHISE', 40, GOLD); ctxt('BASKETBALL EDITION', 56, WHITE);\n(hasCareer() ? ['CONTINUE', 'NEW CAREER', 'RECORDS'] : ['NEW CAREER', 'RECORDS']).forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 84, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\nfunction drawNew() {\nheader('NEW CAREER', `SEED ${newSeed}`);\ntxt('PICK YOUR TEAM       OVR PAY', 8, 24, DIM);\ndrawList(newRows.map((r) => [`${tname(r.t).slice(0, 21).padEnd(21)} ${pad(r.ovr, 2)} ${pad(Math.round(r.pay / 4), 3)}`, r.t < 15 ? CYAN : GREEN]), newSel, 36, 16);\nfooter('A:PICK  X:NEW SEED  B:BACK');\n}\nconst wl = (t) => `${WINS[t]}-${LOSS[t]}`;\nconst phaseName = () => (PHASE === 0 ? `DAY ${DAY + 1}/${DAYS}` : PHASE === 1 ? ['ROUND 1', 'SEMIS', 'CONF FINALS', 'FINALS'][PRD] : 'OFFSEASON');\nfunction nextLine() {\nconst g = myGame();\nif (PHASE === 2) return `CHAMPION ${tname(CHAMP)}`.slice(0, 29);\nif (!g) return PHASE === 1 ? 'OUT OF THE PLAYOFFS' : 'NO GAME TODAY';\nconst home = g[0] === ME, o = home ? g[1] : g[0];\nreturn `NEXT ${home ? 'vs' : '@'} ${tname(o)}`.slice(0, 29);\n}\nfunction drawHub() {\nheader(tname(ME), `${BASE_YEAR + YEAR}`);\npanel(8, 28, 240, 62);\ntxt(`${wl(ME)}  ${phaseName()}`, 16, 32, WHITE);\ntxt(`OVERALL ${strength(ME, YEAR)}  #${standing(confOf(ME)).indexOf(ME) + 1} IN ${confOf(ME) ? 'WEST' : 'EAST'}`, 16, 43, WHITE);\ntxt(nextLine(), 16, 54, GOLD);\nconst out = PHASE < 2 ? roster(ME, YEAR).filter((p) => hurt(p, YEAR, DAY)).length : 0;\nif (out) txt(`HURT ${out}`, 200, 43, RED);\ntxt(lastRes ? `LAST ${lastRes}`.slice(0, 29) : `GOAL ${GOALW} WINS`, 16, 65, DIM);\ntxt(`CASH $${money(CASH)}M`, 16, 76, CASH < 0 ? RED : DIM); txt(`OWNER ${PAT}`, 160, 76, PAT < 25 ? RED : DIM);\nhubItems().forEach((m, i) => txt(`${i === hubSel ? '> ' : '  '}${m}`, 84, 93 + i * 9, i === hubSel ? WHITE : DIM));\nfooter('A:SELECT');\n}\nconst sm = (u) => `${u < 0 ? '-' : '+'}$${money(Math.abs(u))}M`;\nfunction drawFin() {\nheader('FINANCES', `CASH $${money(CASH)}M`);\nconst pay = payroll(ME, VY()), c = pay > TAX ? RED : pay > CAP ? ORANGE : GREEN;\ntxt(`PAYROLL $${money(pay)}M`, 8, 26, c); txt(`CAP $${money(CAP)}M  TAX LINE $${money(TAX)}M`, 8, 38, DIM);\nrectfill(8, 50, 240, 6, PANEL); rectfill(8, 50, Math.min(240, pay * 0.3), 6, c); rectfill(8 + CAP * 0.3, 48, 1, 10, WHITE); rectfill(8 + TAX * 0.3, 48, 1, 10, WHITE);\n[`TICKET PRICE $${priceOf()}`, `SCOUTING     $${SETS[1]}M`, `FACILITIES   $${SETS[2]}M`].forEach((t, i) => txt(`${i === finSel ? '>' : ' '} ${t}`, 8, 66 + i * 12, i === finSel ? WHITE : DIM));\ntxt(`FANS FILL ${Math.round(fill(false) * 100)}%  GATE $${money(gate(false))}M`, 8, 106, DIM);\ntxt(`THIS SEASON ${sm(CASH - SCASH)}  LAST ${sm(LASTP)}`.slice(0, 32), 8, 122, WHITE);\ntxt('OWNER', 8, 140, DIM); rectfill(56, 141, 160, 6, PANEL); rectfill(56, 141, PAT * 1.6, 6, PAT < 25 ? RED : GREEN); txt(`${PAT}`, 224, 140, WHITE);\ntxt(`GOAL ${GOALW} WINS${GOALP ? ' AND THE PLAYOFFS' : ''}`.slice(0, 32), 8, 156, GOLD);\ntxt('SCOUTING HELPS THE DRAFT, FACILITIES THE', 8, 176, DIM); txt('FANS AND TRAINING. A DEAL OVER THE TAX', 8, 186, DIM); txt('LINE COSTS 1.5 FOR EACH DOLLAR OVER.', 8, 196, DIM);\nfooter('UD:PICK  LR:CHANGE  B:BACK');\n}\nfunction drawVerdict() {\nheader('OWNER', `${BASE_YEAR + YEAR}`);\npanel(16, 28, 224, 150);\ntxt(`${wl(ME)}  ${['MISSED THE PLAYOFFS', 'LOST IN ROUND 1', 'LOST IN ROUND 2', 'LOST IN THE SEMIS', 'LOST THE FINALS', 'WON THE TITLE'][RES]}`.slice(0, 30), 24, 36, WHITE);\ntxt(`PROFIT ${sm(LASTP)}   GOAL ${GOALW}`, 24, 48, DIM);\nverdict().forEach((v, i) => txt(`${v[0].padEnd(20)} ${v[1] > 0 ? '+' : ''}${v[1]}`, 24, 68 + i * 12, v[1] > 0 ? GREEN : RED));\ntxt(`PATIENCE ${PAT}`, 24, 156, PAT <= 0 ? RED : GOLD);\nif (PAT <= 0) ctxt('YOU ARE FIRED', 190, RED);\nfooter('A:BACK');\n}\nfunction drawSim() {\nheader('SIMULATING', phaseName());\npanel(48, 80, 160, 52);\nctxt(`${wl(ME)}`, 90, WHITE); ctxt(lastRes.slice(0, 24), 104, GOLD); ctxt('B: STOP', 118, DIM);\n}\nfunction drawStandings() {\nheader(['EAST', 'WEST', 'PLAYOFFS'][stView], phaseName());\nif (stView < 2) {\ntxt('   TEAM            W-L    GB', 8, 24, DIM);\nconst list = standing(stView);\nlist.forEach((t, i) => txt(`${pad(i + 1, 2)} ${team(t).nick.slice(0, 14).padEnd(14)} ${wl(t).padStart(5)} ${(i ? ((WINS[list[0]] - WINS[t] + LOSS[t] - LOSS[list[0]]) / 2).toFixed(1) : '-').padStart(5)}`, 8, 36 + i * 10 + (i > 7 ? 4 : 0), t === ME ? GOLD : i < 8 ? WHITE : DIM));\n} else if (PHASE === 0) ctxt('THE PLAYOFFS START AFTER DAY 58', 100, DIM);\nelse if (PHASE === 2) ctxt(`CHAMPION ${tname(CHAMP)}`.slice(0, 30), 100, GOLD);\nelse {\ntxt(['FIRST ROUND', 'SEMIFINALS', 'CONFERENCE FINALS', 'FINALS'][PRD], 8, 24, DIM);\nPW.forEach((w, i) => { const a = PT[2 * i], b = PT[2 * i + 1]; txt(`${team(a).nick.slice(0, 11).padEnd(11)} ${w[0]}-${w[1]} ${team(b).nick.slice(0, 11)}`, 8, 40 + i * 12, a === ME || b === ME ? GOLD : WHITE); });\n}\nfooter('<>:EAST WEST PLAYOFFS  B:BACK');\n}\nfunction drawSched() {\nheader('SCHEDULE', wl(ME));\nconst rowsS = Array.from({ length: DAYS }, (_, d) => {\nconst g = pairs(d).find((x) => x.includes(ME)), home = g[0] === ME, o = home ? g[1] : g[0];\nreturn [`${pad(d + 1, 2)} ${home ? 'vs' : '@ '} ${tname(o).slice(0, 20).padEnd(20)} ${d < DAY ? (MYW[d] === 1 ? 'W' : 'L') : ''}`, d < DAY ? DIM : d === DAY ? GOLD : WHITE];\n});\ndrawList(rowsS, sel, 24, 18);\nfooter('B:BACK');\n}\nfunction drawLeague() {\nheader(`LEAGUE ${BASE_YEAR + YEAR}`, 'OVR PAY');\ndrawList(rows.map((r, i) => [`${pad(i + 1, 2)} ${tname(r.t).slice(0, 20).padEnd(20)} ${pad(r.ovr, 2)} ${pad(Math.round(r.pay / 4), 3)}`, r.t === ME ? GOLD : r.t < 15 ? CYAN : GREEN]), sel, 24, 18);\nfooter('A:ROSTER  B:BACK');\n}\nfunction drawTeam() {\nheader(tname(viewTeam).slice(0, 24), `${BASE_YEAR + YEAR}`);\ntxt(`OVR ${strength(viewTeam, YEAR)}  PAY $${money(payroll(viewTeam, YEAR))}M/$${money(CAP)}M`, 8, 22, DIM);\ntxt(view === 2 ? '  POS NAME       OVR MIN FOC HURT' : view ? 'NAME        INS OUT PLY DEF REB ATH' : 'POS NAME        AGE OVR PAY   YR', 8, 34, DIM);\nconst line = (r) => {\nif (view === 2) return `${r.q && r.q.on ? '*' : ' '} ${POS[r.p.pos].padEnd(2)} ${pname(r.p, 10).padEnd(10)} ${pad(r.o, 3)} ${r.h ? '  -' : r.q ? (r.q.dnp ? 'DNP' : pad(r.q.mins, 3)) : '  -'}${r.q && !r.q.auto ? '*' : ' '}${(FOCUS[r.e ? r.e.focus : 0] === 'NONE' ? '' : FOCUS[r.e ? r.e.focus : 0]).padEnd(3)} ${r.h ? 'OUT' + r.h : ''}`;\nreturn view ? `${pname(r.p).padEnd(11)} ${r.r.map((v) => pad(v, 3)).join(' ')}` : `${POS[r.p.pos].padEnd(2)} ${pname(r.p).padEnd(11)} ${pad(age(r.p, YEAR), 3)} ${pad(r.o, 3)} ${pad(r.c ? money(r.c[0]) : '-', 5)} ${r.c ? r.c[1] : '-'}`;\n};\ndrawList(rows.map((r) => [line(r), r.h ? RED : r.o >= 75 ? GOLD : r.o >= 60 ? WHITE : DIM]), sel, 46, 16);\nif (ed >= 0) {\nconst r = rows[sel], e = r.e || { mins: 0, focus: 0 };\npanel(24, 134, 208, 74);\ntxt(`${pname(r.p, 14)} ${POS[r.p.pos]}  OVR ${r.o}`, 32, 140, GOLD);\ntxt(`${ed === 0 ? '>' : ' '} MINUTES  < ${e.mins === 0 ? 'AUTO' : e.mins === 1 ? 'DNP' : (e.mins - 1) * 2} >`, 32, 160, ed === 0 ? WHITE : DIM);\ntxt(`${ed === 1 ? '>' : ' '} TRAINING < ${FOCUS[e.focus]} >`, 32, 174, ed === 1 ? WHITE : DIM);\nconst c = r.c;\ntxt(`${ed === 2 ? '>' : ' '} ${arm ? 'A AGAIN: PAY ' : 'RELEASE: A, COST '}$${money(c ? Math.round(c[0] * c[1] / 2) : 0)}M`.slice(0, 29), 32, 188, ed === 2 ? (arm ? RED : WHITE) : DIM);\nfooter(ed === 2 ? 'UD:FIELD  A:RELEASE  B:DONE' : 'UD:FIELD  LR:CHANGE  B:DONE');\n} else footer(viewTeam === ME ? '<>:VIEW  A:EDIT  Y:CARD  B:BACK' : '<>:RATINGS  Y:CARD  B:BACK');\n}\nfunction drawCard() {\nconst p = cardP, r = ratings(p, YEAR), c = contractAt(p, YEAR), h = hurt(p, YEAR, today()), o = ovr(p, YEAR);\nheader(`${names()[0][p.fn]} ${names()[1][p.ln]}`.slice(0, 26), POS[p.pos]);\ntxt(`AGE ${age(p, YEAR)}  ${(p.ht / 12) | 0}'${p.ht % 12}\"  OVERALL ${o}`, 8, 24, WHITE);\ntxt(c ? `$${money(c[0])}M  ${c[1]} YEAR${c[1] > 1 ? 'S' : ''} LEFT` : 'NO CONTRACT', 8, 36, c ? WHITE : DIM);\nif (h) txt(`OUT ${h} GAMES`, 176, 36, RED);\nRN.forEach((n, i) => { const y = 52 + i * 12; txt(n, 8, y, DIM); rectfill(40, y + 1, (r[i] - 20) * 1.6, 6, r[i] >= 75 ? GOLD : r[i] >= 60 ? GREEN : DIM); txt(pad(r[i], 2), 40 + (r[i] - 20) * 1.6 + 6, y, WHITE); });\ntxt('OVERALL BY YEAR (AGE UNDER)', 8, 126, DIM);\nfor (let y = Math.max(p.start, YEAR - 9), x = 8; y <= YEAR; y++, x += 24) {\nconst v = ovr(p, y), hgt = Math.max(1, (v - 30) * 0.9);\nrectfill(x, 190 - hgt, 18, hgt, y === YEAR ? GOLD : PANEL); txt(`${v}`, x + 1, 181 - hgt, WHITE); txt(`${age(p, y)}`, x + 1, 194, DIM);\n}\nfooter('B:BACK');\n}\nfunction drawReport() {\nheader('OFFSEASON', `${BASE_YEAR + YEAR}`);\ntxt('PLAYER     AGE OVR', 8, 24, DIM);\ndrawList(rows, sel, 36, 16);\nfooter('A:CONTINUE');\n}\nconst FORM = [[0.62, 0.5], [0.72, 0.2], [0.72, 0.8], [0.9, 0.3], [0.88, 0.62]];\nfunction drawCourt(x0, y0, w, h, ev, i) {\nrectfill(x0, y0, w, h, BROWN); rect(x0, y0, w, h, WHITE);\nline(x0 + w / 2, y0, x0 + w / 2, y0 + h - 1, WHITE); circ(x0 + w / 2, y0 + h / 2, 10, WHITE);\nfor (const s of [0, 1]) {\nconst bx = s ? x0 + w - 1 : x0, dir = s ? -1 : 1;\nrect(s ? bx - 30 : bx, y0 + h / 2 - 14, 30, 28, WHITE); circ(bx + dir * 30, y0 + h / 2, 10, WHITE); circfill(bx + dir * 6, y0 + h / 2, 2, ORANGE);\n}\nconst offTeam = ev && ev.team >= 0 ? ev.team : 0, right = offTeam === 0;\nfor (let k = 0; k < 2; k++) {\nconst tm = team(k ? G.away : G.home), atk = offTeam === k;\nfor (let j = 0; j < 5; j++) {\nconst f = FORM[j], fx = atk ? f[0] : Math.min(0.96, f[0] + 0.07), fy = atk ? f[1] : 0.5 + (f[1] - 0.5) * 0.8;\nconst sx = x0 + (right ? fx : 1 - fx) * w + (hash(i, k * 7 + j, 1) % 9) - 4, sy = y0 + fy * h + (hash(i, k * 7 + j, 2) % 9) - 4;\ncircfill(sx, sy, 4, tm.c2); circfill(sx, sy, 3, tm.c1);\nif (atk && j === hash(i, 5) % 5) circfill(sx + (right ? 3 : -3), sy - 3, 2, ORANGE);\n}\n}\n}\nfunction drawLive() {\nconst ev = gi ? G.log[gi - 1] : null, done = gi >= G.log.length, last = G.log[G.log.length - 1];\nconst sc = ev ? ev.s : [0, 0], q = ev ? ev.q : 0, left = ev ? ev.left : QLEN;\nconst a = team(G.away), h = team(G.home);\ntxt(`${a.nick.slice(0, 11).padEnd(11)} ${pad(done ? last.s[1] : sc[1], 3)}`, 8, 6, WHITE);\ntxt(`${h.nick.slice(0, 11).padEnd(11)} ${pad(done ? last.s[0] : sc[0], 3)}`, 8, 18, WHITE);\nconst clk = done ? 'FINAL' : `${q < 4 ? 'Q' + (q + 1) : q === 4 ? 'OT' : 'OT' + (q - 3)} ${Math.floor(Math.max(0, left) / 60)}:${String(Math.max(0, left) % 60).padStart(2, '0')}`;\ntxt(clk, 248 - clk.length * 8, 6, GOLD);\ntxt(`>>${'>'.repeat(gSpeed)}`, 224, 18, DIM);\nrectfill(4, 30, 248, 1, PANEL);\ndrawCourt(40, 36, 176, 90, ev, gi);\nconst shown = G.log.slice(Math.max(0, gi - 7), gi);\nshown.forEach((e, k) => txt(e.text.slice(0, 32), 8, 134 + k * 10, k === shown.length - 1 ? (e.kind === 'make' || e.kind === 'ft' ? GOLD : WHITE) : DIM));\nfooter(done ? 'A:BOX SCORE' : 'A:SPEED  B:SKIP');\n}\nfunction drawBox() {\nconst k = boxTeam, tm = team(k ? G.away : G.home), pl = G.players[k ? 1 : 0];\nheader(`${tm.nick} ${G.score[k ? 1 : 0]}`, `${team(k ? G.home : G.away).nick.slice(0, 8)} ${G.score[k ? 0 : 1]}`);\ntxt(boxView ? 'NAME       ST BL TO PF 3PT  FT' : 'NAME       MN PT RB AS FG', 8, 22, DIM);\nconst sum = (key) => pl.reduce((s, q) => s + q[key], 0);\npl.forEach((q, i) => txt(boxView ? `${q.name.padEnd(10)} ${pad(q.stl, 2)} ${pad(q.blk, 2)} ${pad(q.tov, 2)} ${pad(q.pf, 2)} ${pad(q.tpm + '-' + q.tpa, 4)} ${pad(q.ftm + '-' + q.fta, 5)}` : `${q.name.padEnd(10)} ${pad(Math.round(q.sec / 60), 2)} ${pad(q.pts, 2)} ${pad(q.reb, 2)} ${pad(q.ast, 2)} ${pad(q.fgm + '-' + q.fga, 5)}`, 8, 34 + i * 10, i < 5 ? WHITE : DIM));\ntxt(boxView ? `TOTAL      ${pad(sum('stl'), 2)} ${pad(sum('blk'), 2)} ${pad(sum('tov'), 2)} ${pad(sum('pf'), 2)} ${pad(sum('tpm') + '-' + sum('tpa'), 4)} ${pad(sum('ftm') + '-' + sum('fta'), 5)}` : `TOTAL      ${pad(Math.round(sum('sec') / 60), 3)} ${pad(sum('pts'), 2)} ${pad(sum('reb'), 2)} ${pad(sum('ast'), 2)} ${pad(sum('fgm') + '-' + sum('fga'), 5)}`, 8, 34 + pl.length * 10 + 4, GOLD);\ntxt(`BY QUARTER ${G.qs[k].join(' ')}`.slice(0, 32), 8, 34 + pl.length * 10 + 18, DIM);\nfooter('<>:TEAM  X:MORE  B:BACK');\n}\nfunction drawRecords() {\npanel(24, 16, 208, 192);\nctxt('TOP 10 LEGACIES', 24, GOLD);\ntopTen().forEach((e, i) => {\nconst y = 48 + i * 14, on = i === hl;\nif (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\ntxt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\ntxt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\ntxt(e.score ? String(e.score).padStart(8) : '', 128, y, i === 0 ? GOLD : WHITE);\n});\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawInitials() {\nconst ini = initials;\npanel(24, 40, 208, 144);\nctxt(rank === 0 ? 'NEW BEST LEGACY!' : `TOP 10: #${rank + 1}`, 52, GOLD);\nctxt(String(score), 68, WHITE);\nctxt('ENTER YOUR INITIALS', 90, DIM);\nfor (let i = 0; i < 3; i++) {\nconst on = i === ini.pos, x = 84 + i * 32;\nrect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\ntxt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n}\nif (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\nfunction drawPause() {\npanel(64, 80, 128, 54);\nctxt('PAUSED', 88, GOLD);\n['RESUME', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 106 + i * 10, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Vertical Fall",
    "author": "NOVA-16",
    "description": "Fall down an endless well with guns on your boots. Stomp what you can, shoot what is red, and land only to reload: every kill in the air keeps the combo going. Spend your gems on upgrades at the bottom of each level, and see how deep you can get."
  },
  "label": null,
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {},\nsprites: {\"air\": {\"pal\": 0, \"size\": 16, \"tile\": 260}, \"bullet\": {\"pal\": 1, \"size\": 8, \"tile\": 262}, \"flash\": {\"pal\": 1, \"size\": 8, \"tile\": 263}, \"run\": {\"pal\": 0, \"size\": 16, \"tile\": 258}, \"stand\": {\"pal\": 0, \"size\": 16, \"tile\": 256}},\nscenes: {\"ledge\": {\"h\": 2, \"mx\": 208, \"my\": 0, \"pal\": 1, \"w\": 2}, \"stone0\": {\"h\": 2, \"mx\": 200, \"my\": 0, \"pal\": 1, \"w\": 2}, \"stone1\": {\"h\": 2, \"mx\": 202, \"my\": 0, \"pal\": 1, \"w\": 2}, \"stone2\": {\"h\": 2, \"mx\": 204, \"my\": 0, \"pal\": 1, \"w\": 2}, \"stone3\": {\"h\": 2, \"mx\": 206, \"my\": 0, \"pal\": 1, \"w\": 2}, \"wall\": {\"h\": 8, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 8}},\ncolors: {\"GLASS\": 200},\ngradients: {\"shaft\":{\"entry\":0,\"lines\":[7299,7299,7299,6275,6275,6275,6275,6275,6275,6275,6275,6275,6275,6275,6275,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,6243,5219,5219,5219,5219,5219,5219,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5218,5186,5186,5186,5186,5186,5186,5186,5186,5186,5186,5186,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4161,4161,4161,4161,4161,4161,4161,4161,4161,4161,4161,4161,4161,3137,3137,3137,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,3105,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2081,2080,2080,2080,2080,2080,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024,1024],\"y0\":0}},\n};\nfunction gradientLine(g, y) {\nconst v = g.lines[y - g.y0];\nif (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6, jump: 7, shot: 8, land: 9, click: 10, clear: 11 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) {\nif (song === playing) return;\nplaying = song; music(song);\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3;\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)), level: dget(s + 2) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, e.level || 0); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\nfunction insertTop(e) {\nif (!e.score) return -1;\nconst list = topTen(), at = list.findIndex((x) => e.score > x.score);\nif (at < 0) return -1;\nlist.splice(at, 0, e);\nfor (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\nreturn at;\n}\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst held = (b) => (inputMask & (1 << b)) !== 0;\nconst WELL_X = 56, CELLS = 9, CELL = 16, METRE = 16, VIEW_H = 224;\nconst BOX_W = 10, BOX_H = 14;\nconst RUN = 1.6, ACCEL = 0.3, FRICTION = 0.4, AIR_FRICTION = 0.15;\nconst GRAVITY = 0.22, MAX_FALL = 4.5, JUMP = 4.0, COYOTE = 4;\nconst AMMO = 8, BULLET_SPEED = 7, RATE = 8, LIFT = 0.3, MAX_BULLETS = 16;\nconst HP = 4, HURT_SAFE = 90, HURT_KNOCK = 2.5;\nconst CAM_Y = 80, CAM_LEAD = 5, CAM_EASE = 0.25;\nconst CLEAR_WAIT = 60;\nconst EMPTY = 0, STONE = 1, LEDGE = 2;\nconst levelRows = (n) => Math.min(140 + 10 * (n - 1), 220);\nlet cells = null, rows = 0, level = 1, depthBase = 0, runSeed = 1;\nfunction rng(seed) {\nlet a = seed >>> 0;\nreturn () => {\na = (a + 0x6d2b79f5) >>> 0;\nlet t = Math.imul(a ^ (a >>> 15), a | 1);\nt ^= t + Math.imul(t ^ (t >>> 7), t | 61);\nreturn ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n};\n}\nconst edge = (c) => c <= 0 || c >= CELLS - 1;\nconst cellAt = (c, r) => (c < 0 || c >= CELLS || r >= rows ? STONE : r < 0 ? (edge(c) ? STONE : EMPTY) : cells[r * CELLS + c]);\nfunction setCell(c, r, v) { cells[r * CELLS + c] = v; }\nfunction makeLevel(n) {\nrows = levelRows(n); cells = new Uint8Array(rows * CELLS);\nconst R = rng(runSeed * 977 + n), ri = (a, b) => a + Math.floor(R() * (b - a + 1));\nfor (let r = 0; r < rows; r++) { setCell(0, r, STONE); setCell(CELLS - 1, r, STONE); }\nfor (let c = 0; c < CELLS; c++) setCell(c, rows - 1, STONE);\nfor (let r = 8; r < rows - 8; r += ri(4, 7)) {\nconst k = ri(0, 3);\nif (k < 2) {\nconst w = ri(1, 3);\nfor (let i = 0; i < w; i++) setCell(k ? CELLS - 2 - i : 1 + i, r, STONE);\nif (R() < 0.5) setCell(k ? CELLS - 2 : 1, r + 1, STONE);\n} else if (k === 2) {\nconst w = ri(2, 4), c0 = ri(1, CELLS - 1 - w);\nfor (let i = 0; i < w; i++) setCell(c0 + i, r, LEDGE);\n} else { const c0 = ri(3, 4); setCell(c0, r, STONE); setCell(c0 + 1, r, STONE); }\n}\nrestream();\n}\nconst STRIP = 32;\nconst slotRow = new Int32Array(STRIP);\nlet cellMap = null;\nfunction loadCells() {\nconst s = ART.scenes, ent = (sc) => [mget(sc.mx, sc.my), mget(sc.mx + 1, sc.my), mget(sc.mx, sc.my + 1), mget(sc.mx + 1, sc.my + 1)];\ncellMap = [[[0, 0, 0, 0]], [0, 1, 2, 3].map((i) => ent(s['stone' + i])), [ent(s.ledge)]];\n}\nconst slotOf = (r) => ((r % STRIP) + STRIP) % STRIP;\nfunction restream() { slotRow.fill(-999999); }\nfunction writeRow(r) {\nconst slot = slotOf(r);\nslotRow[slot] = r;\nfor (let c = 0; c < CELLS; c++) {\nconst v = cellMap[cellAt(c, r)], e = v[v.length > 1 ? (c & 1) + (r & 1) * 2 : 0];\nmset(2 * c, 2 * slot, e[0]); mset(2 * c + 1, 2 * slot, e[1]);\nmset(2 * c, 2 * slot + 1, e[2]); mset(2 * c + 1, 2 * slot + 1, e[3]);\n}\n}\nfunction stream() {\nconst r0 = flr(camY / CELL) - 1;\nfor (let r = r0; r < r0 + VIEW_H / CELL + 3; r++) if (slotRow[slotOf(r)] !== r) writeRow(r);\n}\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, best = 0, camY = 0, clearT = 0;\nlet me = null, bullets = [];\nfunction newFaller() {\nreturn {\nx: (CELLS * CELL - BOX_W) / 2, y: CELL, vx: 0, vy: 0, face: 1, ground: false, onLedge: false, air: 0, jumping: false,\ntrig: false, cd: 0, drop: 0, flash: 0, inv: 0, hp: HP, maxHp: HP, ammo: AMMO, maxAmmo: AMMO, walk: 0,\n};\n}\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nloadCells();\nconst w = ART.scenes.wall;\nbg(0, { mx: 0, my: 0, mw: CELLS * 2, mh: STRIP * 2, x: -WELL_X, y: 0, wrap: true, show: true });\nbg(1, { mx: w.mx, my: w.my, mw: w.w, mh: w.h, x: -WELL_X, y: 0, wrap: true, show: true });\nbg(2, { show: false });\nwinpos(0, WELL_X, WELL_X + CELLS * CELL - 1);\nwinmask('screen', { w0: 'out' });\nblend({ layers: ['overlay'], half: true });\nrunSeed = rndi(1, 999999); makeLevel(1); me = newFaller();\nif (skipTitle) startGame(); else toTitle();\n}\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\nfunction startGame() {\nrunSeed = rndi(1, 999999); level = 1; depthBase = 0; makeLevel(level);\nme = newFaller(); bullets = []; score = 0; best = 0; camY = 0; clearT = 0;\npaused = false; timer = 0; state = 'play';\nplay(SONG.play);\n}\nfunction nextLevel() {\ndepthBase += rows; level++; makeLevel(level);\nme.x = (CELLS * CELL - BOX_W) / 2; me.y = CELL; me.vx = me.vy = 0; me.ground = false;\nbullets = []; camY = 0; clearT = 0;\n}\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'play') updatePlay();\nelse if (state === 'over') updateOver();\nelse if (state === 'initials') updateInitials();\nelse if (state === 'records') updateRecords();\nprevMask = inputMask;\n}\nfunction updateTitle() {\nif (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (titleSel === 0) startGame(); else { state = 'records'; hl = -1; timer = 0; }\n}\n}\nfunction updatePlay() {\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nmoveFaller();\nupdateBullets();\nif (state !== 'play') return;\nconst depth = depthBase + flr((me.y + BOX_H) / METRE);\nif (depth > best) best = depth;\nscore = best;\nif (clearT) { if (++clearT > CLEAR_WAIT) nextLevel(); }\nelse if (me.ground && flr((me.y + BOX_H) / CELL) >= rows - 1) { clearT = 1; fx(SFX.clear); }\ncamera();\n}\nfunction moveFaller() {\nconst f = me, push = pressed(A) || pressed(B), hold = held(A) || held(B);\nconst dir = (held(RIGHT) ? 1 : 0) - (held(LEFT) ? 1 : 0);\nif (dir) { f.vx = clamp(f.vx + dir * ACCEL, -RUN, RUN); f.face = dir; }\nelse { const fr = f.ground ? FRICTION : AIR_FRICTION; f.vx = abs(f.vx) <= fr + 1e-6 ? 0 : f.vx - sgn(f.vx) * fr; }\nif (push && (f.ground || (f.air < COYOTE && !f.jumping))) { f.vy = -JUMP; f.jumping = true; f.ground = false; f.air = COYOTE; fx(SFX.jump); }\nelse if (!f.ground) {\nif (push) { f.trig = true; f.cd = RATE; shoot(); }\nelse if (f.trig && hold && --f.cd <= 0) { f.cd = RATE; shoot(); }\n}\nif (!hold) f.trig = false;\nif (f.jumping && f.vy < 0 && !hold) { f.vy *= 0.5; f.jumping = false; }\nif (f.vy >= 0) f.jumping = false;\nif (f.ground && f.onLedge && pressed(DOWN)) { f.drop = 8; f.ground = false; }\nconst was = f.ground;\nf.vy = Math.min(f.vy + GRAVITY, MAX_FALL);\nmoveX(f); moveY(f);\nif (f.drop) f.drop--;\nif (f.flash) f.flash--;\nif (f.inv) f.inv--;\nif (f.ground) {\nif (!was) { if (f.ammo < f.maxAmmo || f.air > 20) fx(SFX.land); f.trig = false; }\nf.ammo = f.maxAmmo; f.air = 0;\nf.walk = f.vx ? f.walk + 1 : 0;\n} else f.air++;\n}\nconst solidAt = (x, y) => cellAt(flr(x / CELL), flr(y / CELL)) === STONE;\nfunction moveX(f) {\nf.x += f.vx;\nconst t = f.y, m = f.y + BOX_H / 2, b = f.y + BOX_H - 1;\nif (f.vx > 0) {\nconst e = f.x + BOX_W - 1;\nif (solidAt(e, t) || solidAt(e, m) || solidAt(e, b)) { f.x = flr(e / CELL) * CELL - BOX_W; f.vx = 0; }\n} else if (f.vx < 0) {\nif (solidAt(f.x, t) || solidAt(f.x, m) || solidAt(f.x, b)) { f.x = (flr(f.x / CELL) + 1) * CELL; f.vx = 0; }\n}\n}\nfunction moveY(f) {\nconst oldBot = f.y + BOX_H;\nf.y += f.vy; f.ground = false; f.onLedge = false;\nconst l = f.x, r = f.x + BOX_W - 1;\nif (f.vy >= 0) {\nconst row = flr((f.y + BOX_H) / CELL), top = row * CELL;\nconst kl = cellAt(flr(l / CELL), row), kr = cellAt(flr(r / CELL), row);\nif (kl === STONE || kr === STONE) { f.y = top - BOX_H; f.vy = 0; f.ground = true; }\nelse if ((kl === LEDGE || kr === LEDGE) && !f.drop && oldBot <= top) { f.y = top - BOX_H; f.vy = 0; f.ground = true; f.onLedge = true; }\n} else if (solidAt(l, f.y) || solidAt(r, f.y)) { f.y = (flr(f.y / CELL) + 1) * CELL; f.vy = 0; }\n}\nfunction shoot() {\nconst f = me;\nif (f.ammo <= 0) { fx(SFX.click); return; }\nf.ammo--;\nbullets.push({ x: f.x + BOX_W / 2, y: f.y + BOX_H });\nif (bullets.length > MAX_BULLETS) bullets.shift();\nf.vy = Math.min(f.vy, LIFT); f.flash = 3;\nfx(SFX.shot);\n}\nfunction updateBullets() {\nfor (const b of bullets) {\nb.y += BULLET_SPEED;\nif (solidAt(b.x, b.y + 5) || b.y > camY + VIEW_H + 16) b.dead = true;\n}\nbullets = bullets.filter((b) => !b.dead);\n}\nfunction hurt() {\nconst f = me;\nif (f.inv > 0 || state !== 'play') return false;\nf.hp--; f.inv = HURT_SAFE; f.vy = -HURT_KNOCK; fx(SFX.hit);\nif (f.hp <= 0) gameOver();\nreturn true;\n}\nfunction camera() {\nconst mid = me.y + BOX_H / 2, target = mid - CAM_Y + Math.max(0, me.vy) * CAM_LEAD;\ncamY += (target - camY) * CAM_EASE;\ncamY = clamp(camY, mid - 136, mid - 40);\ncamY = clamp(camY, 0, rows * CELL - VIEW_H);\n}\nfunction gameOver() {\nstate = 'over'; timer = 0; play(-1); fx(SFX.over);\nrank = insertTop({ score, initials: lastInitials(), level });\n}\nfunction updateOver() {\nif (timer < 60 || !(pressed(A) || pressed(START))) return;\nfx(SFX.select);\nif (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\nelse toTitle();\n}\nfunction updateInitials() {\nconst ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\nif (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\nif (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\nconst done = pressed(START) || (pressed(A) && ini.pos === 2);\nif (pressed(A) && ini.pos < 2) ini.pos++;\nif (!done || timer < 20) return;\nconst v = packInitials(ini.chars.join(''));\ndset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\nfx(SFX.select);\nstate = 'records'; hl = rank; timer = 0;\n}\nfunction updateRecords() {\nif ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\nfunction updatePause() {\nif (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) startGame();\nelse toTitle();\n}\n}\nfunction draw() {\ncls();\nstream();\nconst y = flr(camY);\nbgscroll(0, -WELL_X, y % (STRIP * CELL));\nbgscroll(1, -WELL_X, flr(y / 2) % (ART.scenes.wall.h * 8));\nif (state === 'play' || state === 'over') drawPlay();\nelse if (state === 'title') drawTitle();\nelse if (state === 'initials') drawInitials();\nelse if (state === 'records') drawRecords();\nif (state === 'over') {\npanel(60, 72, 136, 72); ctxt('GAME OVER', 82, RED);\nctxt(`LEVEL ${level}  ${best}M`, 98, WHITE); ctxt(`SCORE ${score}`, 110, WHITE);\nif (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 128, DIM);\n}\nif (paused) drawPause();\n}\nfunction drawPlay() {\nconst f = me, sx = WELL_X + flr(f.x) - 3, sy = flr(f.y - camY) - 2;\nif (!(f.inv && f.inv % 8 < 4)) {\nconst s = !f.ground ? ART.sprites.air : f.walk && (f.walk >> 3) & 1 ? ART.sprites.run : ART.sprites.stand;\nsprite(s, sx, sy, { fx: f.face < 0 });\n}\nif (f.flash) sprite(ART.sprites.flash, sx + 4, sy + 15);\nfor (const b of bullets) sprite(ART.sprites.bullet, WELL_X + flr(b.x) - 4, flr(b.y - camY));\nhud();\n}\nfunction hud() {\nconst f = me;\ntxt('HP', 8, 12, DIM);\nfor (let i = 0; i < f.maxHp; i++) {\nconst x = 8 + (i % 4) * 11, y = 24 + flr(i / 4) * 11;\nrectfill(x, y, 9, 8, i < f.hp ? RED : SHADOW); rect(x, y, 9, 8, i < f.hp ? WHITE : PANEL);\n}\nconst depth = depthBase + flr((f.y + BOX_H) / METRE);\ntxt(`${depth}M`, 214, 12, WHITE);\ntxt(`LV ${level}`, 214, 24, DIM);\nfor (let i = 0; i < f.maxAmmo; i++) rectfill(203, 210 - i * 8, 6, 6, i < f.ammo ? WHITE : PANEL);\nif (clearT) { panel(80, 92, 96, 24); ctxt(`LEVEL ${level} CLEAR`, 100, GOLD); }\n}\nfunction drawTitle() {\npanel(64, 36, 128, 28); ctxt('VERTICAL FALL', 46, GOLD);\n['PLAY', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\nfunction drawRecords() {\npanel(24, 16, 208, 192);\nctxt('TOP 10', 24, GOLD);\ntopTen().forEach((e, i) => {\nconst y = 48 + i * 14, on = i === hl;\nif (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\ntxt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\ntxt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\ntxt(e.score ? `LV ${e.level}` : '', 112, y, DIM);\ntxt(e.score ? String(e.score).padStart(7) : '', 156, y, i === 0 ? GOLD : WHITE);\n});\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawInitials() {\nconst ini = initials;\npanel(24, 40, 208, 144);\nctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\nctxt(String(score), 68, WHITE);\nctxt('ENTER YOUR INITIALS', 90, DIM);\nfor (let i = 0; i < 3; i++) {\nconst on = i === ini.pos, x = 84 + i * 32;\nrect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\ntxt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n}\nif (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\nfunction drawPause() {\npanel(64, 80, 128, 64);\nctxt('PAUSED', 88, GOLD);\n['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nfunction scanline(y) { gradientLine(ART.gradients.shaft, y); }\n",

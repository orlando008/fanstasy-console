  "meta": {
    "title": "Riddlewick Manor",
    "author": "NOVA-16",
    "description": "A trivia adventure in a haunted manor. Knock on a door and its ghost asks you a question: answer right and it opens, answer wrong and it locks for good and your candle burns down. Find your way, room by room, to the heart of the manor before your candle goes out."
  },
  "label": null,
  "code": "// Riddlewick Manor: a trivia adventure in a haunted manor (docs/carts/riddlewick-manor.md). Knock on a door, answer its\n// ghost's question: right and it opens, wrong and it locks for good. Find a way, room by room, to the heart of the manor.\n// The questions are in ROM (questions.txt, packed by questions.py). Built on the starter's frame (title, pause, the\n// end, a saved top 10 with initials, the records).\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"gem\": {\"pal\": 0, \"size\": 16, \"tile\": 258}, \"player\": {\"pal\": 0, \"size\": 16, \"tile\": 256}},\n  scenes: {\"field\": {\"h\": 8, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hills\": {\"h\": 8, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[13475,13475,13475,13475,13475,13475,13475,14499,14499,14531,14531,14532,14532,14532,14532,14532,14532,15556,15556,15556,15556,15556,15588,15588,15588,15588,15588,16612,16612,16612,16612,16612,16612,16612,16645,16645,16645,17669,17669,17669,17669,17669,17669,17669,17669,17669,18725,18725,18725,18725,18725,18725,18725,18725,18725,19749,19750,19750,19782,19782,19782,19782,19782,19782,19782,20806,20806,20806,20806,20806,20838,20838,20838,20838,21862,21862,21862,21863,21863,21863,21863,21863,21895,22919,22919,22919,22919,22919,22919,22919,22919,22951,22952,22952,23976,23976,23976,23976,24008,24008,24009,24009,24009,24009,24041,24041,25065,25065,25066,25066,25066,25098,25098,25098,25098,25099,25099,25131,26155,26155,26155,26155,26155,26156,26188,26188,26188,26188,26188,26188,27245,27245,27245,27245,27245,27245,27245,27278,27278,27278,27278,27278,28302,28334,28335,28335,28335,28335,28335,28335,28367,28368,28368,28368,28368,29392,29424,29424,29425,29425,29425,29425,29457,29457,29457,29458,29458,29458,30482,30514,30514,30514,30515,30515,30515,30547],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst CHOICE_SLOT = 2, BANK_SLOT = 3, SEEN_SLOT = 40, SEEN_SLOTS = 20;\nconst RUN_SLOT = 60;   // the run in progress (spec 13): 60 a flag, 61 the seed, 62 the run's numbers, 63 the score, 64 the tallies,\n                       // 65 to 69 the doors (2 bits each), 70 and 71 the rooms seen, 72 and 73 the rooms whose item is still there   // the bank's size when the seen bits were kept; the questions asked in earlier runs (640 bits)\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: score, initials, a spare (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\n// An entry: its score, its initials, and its level and subject (level | (subject + 1) << 4).\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY, v = dget(s + 2); return { score: dget(s), initials: unpackInitials(dget(s + 1)), level: v & 15, subject: (v >> 4) - 1 }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, (e.level || 0) | ((e.subject ?? -1) + 1) << 4); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// ===================================================================================================================\n// The question bank (spec 6): read from ROM once.\n// ===================================================================================================================\n\nconst SUBJECTS = ['HISTORY', 'GEOGRAPHY', 'SCIENCE', 'NATURE', 'ARTS AND BOOKS', 'MUSIC AND SCREEN', 'SPORT AND GAMES', 'FOOD AND EVERYDAY'];\nconst Q_LINE = 30, Q_LINES = 3;   // a question is shown in up to 3 lines of 30 characters\nlet QUESTIONS = [];\n/** The questions from rom('questions') (questions.py writes the format): [{ subj, diff, q, ans: [right, wrong x 3] }]. */\nfunction loadQuestions() {\n  const b = rom('questions'), out = [];\n  let i = 5;\n  const str = () => { const n = b[i++]; let s = ''; for (let k = 0; k < n; k++) s += String.fromCharCode(b[i++]); return s; };\n  for (let k = 0, n = b[3] | (b[4] << 8); k < n; k++) {\n    const subj = b[i++], diff = b[i++], q = str();\n    out.push({ subj, diff, q, ans: [str(), str(), str(), str()] });\n  }\n  return out;\n}\n/** Words into lines of at most `w` characters. */\nfunction wrap(s, w) {\n  const lines = [];\n  let line = '';\n  for (const word of s.split(' ')) {\n    if (line && line.length + 1 + word.length > w) { lines.push(line); line = word; } else line = line ? `${line} ${word}` : word;\n  }\n  if (line) lines.push(line);\n  return lines;\n}\n\n// ===================================================================================================================\n// The manor (spec 5): rooms on a grid, a door (or a wall) between each two neighbours.\n// ===================================================================================================================\n\nconst N = 0, E = 1, S = 2, W = 3, DX = [0, 1, 0, -1], DY = [-1, 0, 1, 0];\nconst NONE = 0, CLOSED = 1, OPEN = 2, LOCKED = 3;   // a door's state (NONE: a wall)\nconst MW = 7, MH = 6;   // the manor's size in rooms\nlet doorsH = [], doorsV = [];   // doorsH[y * (MW - 1) + x]: between (x, y) and (x + 1, y); doorsV[y * MW + x]: (x, y) and (x, y + 1)\nconst start = { x: 0, y: MH - 1 }, goal = { x: MW - 1, y: 0 };   // the Entrance Hall, bottom left; the heart, top right\nlet me = { x: 0, y: 0, f: N };   // where you are and which way you face\nlet seen = new Set();   // the rooms you have seen (on the map)\n\n/** The door from room (x, y) towards d: { list, i } in doorsH or doorsV, or null at the manor's edge. */\nfunction doorRef(x, y, d) {\n  const nx = x + DX[d], ny = y + DY[d];\n  if (nx < 0 || ny < 0 || nx >= MW || ny >= MH) return null;\n  if (d === E || d === W) return { list: doorsH, i: y * (MW - 1) + Math.min(x, nx) };\n  return { list: doorsV, i: Math.min(y, ny) * MW + x };\n}\nfunction getDoor(x, y, d) { const r = doorRef(x, y, d); return r ? r.list[r.i] : NONE; }\nfunction setDoor(x, y, d, v) { const r = doorRef(x, y, d); if (r) r.list[r.i] = v; }\nconst roomId = (x, y) => y * MW + x;\n\n// The rooms' kinds (spec 6): a name, and the ghost who asks there. The first is the start's, the last the heart's.\nconst KINDS = [\n  ['ENTRANCE HALL', 'THE BUTLER'], ['LIBRARY', 'THE LIBRARIAN'], ['GALLERY', 'THE PAINTER'], ['DINING ROOM', 'THE DUCHESS'],\n  ['KITCHEN', 'THE COOK'], ['CONSERVATORY', 'THE GARDENER'], ['MUSIC ROOM', 'THE ORGANIST'], ['NURSERY', 'THE TWINS'],\n  ['ARMOURY', 'THE KNIGHT'], ['CLOCK ROOM', 'LADY RIDDLEWICK'],\n];\nconst HALL = 0, HEART = KINDS.length - 1;\nconst EXTRA_DOORS = 0.3, N_KEYS = 3, N_STUBS = 2;   // the share of the maze's remaining walls that get a door; what lies about\nconst ITEM_NONE = 0, ITEM_KEY = 1, ITEM_STUB = 2;\nlet kinds = [], items = [];   // by room: its kind (an index into KINDS), and what lies in it\n\n/** A small seeded random number generator (mulberry32), so a run's manor can be made again from its seed (the save). */\nfunction seeded(seed) {\n  let a = seed >>> 0;\n  return (n) => {\n    a = (a + 0x6d2b79f5) >>> 0;\n    let t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return Math.floor((((t ^ (t >>> 14)) >>> 0) / 4294967296) * n);\n  };\n}\n\n/** The manor of a seed (spec 5): a maze (a random spanning tree, so every room can be reached), a door in about 30% of\n * its other walls (loops, other ways round), the rooms' kinds (no two neighbours alike where possible), and the keys and\n * candle stubs, away from the start. */\nfunction makeManor(seed) {\n  const r = seeded(seed);\n  doorsH = new Array((MW - 1) * MH).fill(NONE); doorsV = new Array(MW * (MH - 1)).fill(NONE);\n  const inTree = new Set([roomId(start.x, start.y)]), frontier = [];\n  const addEdges = (x, y) => { for (let d = 0; d < 4; d++) if (doorRef(x, y, d)) frontier.push([x, y, d]); };\n  addEdges(start.x, start.y);\n  while (frontier.length) {   // Prim's maze: a random edge from the tree to a room not yet in it\n    const [x, y, d] = frontier.splice(r(frontier.length), 1)[0], nx = x + DX[d], ny = y + DY[d];\n    if (inTree.has(roomId(nx, ny))) continue;\n    setDoor(x, y, d, CLOSED); inTree.add(roomId(nx, ny)); addEdges(nx, ny);\n  }\n  for (const list of [doorsH, doorsV]) for (let i = 0; i < list.length; i++) if (list[i] === NONE && r(100) < EXTRA_DOORS * 100) list[i] = CLOSED;\n  kinds = [];\n  for (let y = 0; y < MH; y++) for (let x = 0; x < MW; x++) {\n    let k, tries = 0;\n    do k = 1 + r(HEART - 1); while (tries++ < 12 && ((x > 0 && kinds[roomId(x - 1, y)] === k) || (y > 0 && kinds[roomId(x, y - 1)] === k)));\n    kinds.push(k);\n  }\n  kinds[roomId(start.x, start.y)] = HALL; kinds[roomId(goal.x, goal.y)] = HEART;\n  items = new Array(MW * MH).fill(ITEM_NONE);\n  const spots = [];\n  for (let y = 0; y < MH; y++) for (let x = 0; x < MW; x++) if (Math.abs(x - start.x) + Math.abs(y - start.y) >= 2 && !(x === goal.x && y === goal.y)) spots.push(roomId(x, y));\n  for (let i = 0; i < N_KEYS + N_STUBS; i++) items[spots.splice(r(spots.length), 1)[0]] = i < N_KEYS ? ITEM_KEY : ITEM_STUB;\n}\n\n/** Can the heart still be reached from (x, y) through doors that are closed or open (not locked)? */\nfunction canReach(x, y) {\n  const todo = [[x, y]], been = new Set([roomId(x, y)]);\n  while (todo.length) {\n    const [cx, cy] = todo.pop();\n    if (cx === goal.x && cy === goal.y) return true;\n    for (let d = 0; d < 4; d++) {\n      const st = getDoor(cx, cy, d), nx = cx + DX[d], ny = cy + DY[d];\n      if ((st === CLOSED || st === OPEN) && !been.has(roomId(nx, ny))) { been.add(roomId(nx, ny)); todo.push([nx, ny]); }\n    }\n  }\n  return false;\n}\n\n// ===================================================================================================================\n// A run (spec 5, 9).\n// ===================================================================================================================\n\n// The levels (spec 5): the candle's notches, and the questions' difficulty (and the points) are the level's number.\nconst LEVELS = [{ name: 'NOVICE', candle: 6 }, { name: 'SCHOLAR', candle: 5 }, { name: 'SAGE', candle: 4 }, { name: 'MASTER', candle: 3 }];\nlet level = 1;   // 1 to 4 (step 4 adds the choice of level and subject)\nlet subject = -1;   // an index into SUBJECTS, or -1 for ALL SUBJECTS\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, streak = 0, asked = new Set(), answered = 0, rightCount = 0, won = false;\nlet runSeed = 0, candle = 6, keys = 0, notice = '', noticeT = 0;\nlet phase = 'explore', sel = 0, cur = null, walkT = 0, walkTo = null;   // sel: the door chosen, as a direction (N, E, S, W)\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  QUESTIONS = loadQuestions();\n  if (dget(BANK_SLOT) !== QUESTIONS.length) {   // the bank has changed: what was asked before no longer lines up\n    for (let k = 0; k < SEEN_SLOTS; k++) dset(SEEN_SLOT + k, 0);\n    dset(BANK_SLOT, QUESTIONS.length);\n  }\n  for (const l of [0, 1, 2]) bg(l, { show: false });   // (step 6 draws the rooms on the layers; until then, the overlay)\n  color(0, 3, 2, 4);\n  blend({ layers: ['overlay'], half: true }); // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\n\nfunction startGame() {\n  runSeed = rndi(1, 0x3fffffff); makeManor(runSeed);\n  me = { x: start.x, y: start.y, f: N }; seen = new Set([roomId(me.x, me.y)]);\n  candle = LEVELS[level - 1].candle; keys = 0; notice = ''; noticeT = 0;\n  score = 0; streak = 0; asked = new Set(); answered = 0; rightCount = 0; won = false;\n  phase = 'explore'; cur = null; sel = firstDoor(); paused = false; timer = 0; state = 'play';\n  play(SONG.play);\n}\n\n/** The door to choose first in a room: ahead if there is one, then right, left, behind. */\nfunction firstDoor() {\n  for (const k of [0, 1, 3, 2]) { const d = (me.f + k) % 4; if (getDoor(me.x, me.y, d) !== NONE) return d; }\n  return me.f;\n}\n\n/** Has question i been asked in an earlier run (or this one)? The bits are kept in the save (slots 40 to 59). */\nconst seenBefore = (i) => (dget(SEEN_SLOT + (i >> 5)) >>> (i & 31)) & 1;\nfunction markSeen(i, on) { const k = SEEN_SLOT + (i >> 5), b = 1 << (i & 31); dset(k, on ? dget(k) | b : dget(k) & ~b); }\n\n/** A question for the door (spec 6): of the run's subject (any, for ALL SUBJECTS) at the level's difficulty, not asked\n * yet in this run, and not asked in an earlier run where possible. When a difficulty runs dry, the nearest fills in. */\nfunction pickQuestion() {\n  const fits = (i) => subject < 0 || QUESTIONS[i].subj === subject;\n  let qi = -1;\n  for (let off = 0; off < 4 && qi < 0; off++) for (const dd of off ? [level - off, level + off] : [level]) {   // the level's difficulty, then the nearest\n    if (dd < 1 || dd > 4 || qi >= 0) continue;\n    const pool = QUESTIONS.map((_, i) => i).filter((i) => fits(i) && QUESTIONS[i].diff === dd && !asked.has(i));\n    if (!pool.length) continue;\n    let fresh = pool.filter((i) => !seenBefore(i));\n    if (!fresh.length) { pool.forEach((i) => markSeen(i, false)); fresh = pool; }   // all asked in earlier runs: that pool starts afresh\n    qi = fresh[rndi(0, fresh.length - 1)];\n  }\n  if (qi < 0) { asked.clear(); return pickQuestion(); }   // every question of the subject asked in this run: start again\n  asked.add(qi); markSeen(qi, true);\n  const order = [0, 1, 2, 3];\n  for (let i = 3; i > 0; i--) { const j = rndi(0, i); [order[i], order[j]] = [order[j], order[i]]; }\n  return { qi, order, sel: 0, door: sel, chosen: -1, right: false };\n}\n\nconst pointsFor = () => 100 * level + 25 * level * Math.min(streak, 4);\nconst winBonus = () => 1000 * level + 200 * level * candle;\nfunction say(s) { notice = s; noticeT = 150; }\n/** After a door locks or a key is used: if no way to the heart is left and you carry no key, a ghost gives you one. */\nfunction checkStuck() {\n  if (keys === 0 && !canReach(me.x, me.y)) { keys = 1; say(`${KINDS[kinds[roomId(me.x, me.y)]][1]} SLIPS YOU A KEY`); fx(SFX.point); }\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  else if (state === 'setup') updateSetup();\n  prevMask = inputMask;\n}\n\n// --- The title and the new game's choices (spec 10) ---\n\nconst titleItems = () => (hasRun() ? ['CONTINUE', 'NEW GAME', 'RECORDS'] : ['NEW GAME', 'RECORDS']);\nfunction updateTitle() {\n  const items = titleItems(), n = items.length;\n  if (titleSel >= n) titleSel = 0;\n  if (pressed(UP)) { titleSel = (titleSel + n - 1) % n; fx(SFX.move); }\n  if (pressed(DOWN)) { titleSel = (titleSel + 1) % n; fx(SFX.move); }\n  if (!(pressed(A) || pressed(START)) || timer < 10) return;\n  fx(SFX.select);\n  const it = items[titleSel];\n  if (it === 'CONTINUE') continueRun();\n  else if (it === 'NEW GAME') toSetup();\n  else { state = 'records'; hl = -1; timer = 0; }\n}\n\nlet setupRow = 0;\nfunction toSetup() {\n  const c = dget(CHOICE_SLOT);   // the last choice (0: none yet)\n  if (c) { subject = (c & 15) - 1; level = (c >> 4) & 15 || 1; } else { subject = -1; level = 1; }\n  state = 'setup'; setupRow = 0; timer = 0;\n}\n/** The new game: UP and DOWN choose the row (SUBJECT, LEVEL), LEFT and RIGHT change it, A begins, B goes back. */\nfunction updateSetup() {\n  if (pressed(UP) || pressed(DOWN)) { setupRow ^= 1; fx(SFX.move); }\n  const d = pressed(RIGHT) ? 1 : pressed(LEFT) ? -1 : 0;\n  if (d && setupRow === 0) { subject = ((subject + 1 + d + 9) % 9) - 1; fx(SFX.move); }\n  if (d && setupRow === 1) { level = ((level - 1 + d + 4) % 4) + 1; fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.pause); toTitle(); return; }\n  if (timer > 10 && (pressed(A) || pressed(START))) { fx(SFX.select); dset(CHOICE_SLOT, (subject + 1) | (level << 4)); startGame(); }\n}\n\n// --- The run in progress, saved while you explore and made again from it (CONTINUE) ---\n\nconst hasRun = () => dget(RUN_SLOT) === 1;\nfunction clearRun() { for (let k = 0; k < 14; k++) dset(RUN_SLOT + k, 0); }\n/** 21 flags a slot (so no slot's top bit is used): a set of room numbers 0 to 41 into two slots. */\nfunction packRooms(has, k) { let a = 0, b = 0; for (let r = 0; r < MW * MH; r++) if (has(r)) { if (r < 21) a |= 1 << r; else b |= 1 << (r - 21); } dset(k, a); dset(k + 1, b); }\nconst roomBit = (k, r) => (r < 21 ? dget(k) >> r : dget(k + 1) >> (r - 21)) & 1;\nfunction saveRun() {\n  dset(RUN_SLOT, 1); dset(RUN_SLOT + 1, runSeed);\n  dset(RUN_SLOT + 2, (subject + 1) | level << 4 | me.f << 8 | me.x << 12 | me.y << 16 | Math.min(candle, 15) << 20 | Math.min(keys, 15) << 24);\n  dset(RUN_SLOT + 3, score);\n  dset(RUN_SLOT + 4, Math.min(streak, 255) | Math.min(answered, 255) << 8 | Math.min(rightCount, 255) << 16);\n  const doors = [...doorsH, ...doorsV];\n  for (let k = 0; k < 5; k++) { let v = 0; for (let j = 0; j < 15; j++) v |= (doors[k * 15 + j] || 0) << (j * 2); dset(RUN_SLOT + 5 + k, v); }\n  packRooms((r) => seen.has(r), RUN_SLOT + 10);\n  packRooms((r) => items[r] !== ITEM_NONE, RUN_SLOT + 12);\n}\n/** CONTINUE: the manor made again from the seed, then the doors, rooms seen, items taken and the numbers put back. */\nfunction continueRun() {\n  runSeed = dget(RUN_SLOT + 1); makeManor(runSeed);\n  const v = dget(RUN_SLOT + 2), t = dget(RUN_SLOT + 4);\n  subject = (v & 15) - 1; level = (v >> 4) & 15; me = { f: (v >> 8) & 15, x: (v >> 12) & 15, y: (v >> 16) & 15 };\n  candle = (v >> 20) & 15; keys = (v >> 24) & 15; score = dget(RUN_SLOT + 3);\n  streak = t & 255; answered = (t >> 8) & 255; rightCount = (t >> 16) & 255;\n  const nH = doorsH.length;\n  for (let i = 0; i < nH + doorsV.length; i++) {\n    const d = (dget(RUN_SLOT + 5 + flr(i / 15)) >> ((i % 15) * 2)) & 3;\n    if (i < nH) doorsH[i] = d; else doorsV[i - nH] = d;\n  }\n  seen = new Set();\n  for (let r = 0; r < MW * MH; r++) { if (roomBit(RUN_SLOT + 10, r)) seen.add(r); if (!roomBit(RUN_SLOT + 12, r)) items[r] = ITEM_NONE; }\n  asked = new Set(); won = false; notice = ''; noticeT = 0; cur = null; paused = false; timer = 0; state = 'play'; phase = 'explore';\n  sel = firstDoor(); play(SONG.play);\n  if (me.x === goal.x && me.y === goal.y) { cur = { ...pickQuestion(), final: true }; phase = 'ask'; }   // back to her last question\n}\n\nfunction updatePlay() {\n  if (pressed(START) && phase !== 'walk') { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (noticeT) noticeT--;\n  if (phase === 'explore') updateExplore();\n  else if (phase === 'ask') updateAsk();\n  else if (phase === 'confirm') updateConfirm();\n  if (state === 'play' && (phase === 'explore' || (phase === 'ask' && cur.final))) saveRun();   // (unchanged slots are not written)\n  else if (phase === 'answered') updateAnswered();\n  else if (phase === 'walk') updateWalk();\n}\n\n/** Exploring: the d-pad chooses a door (UP ahead, RIGHT, DOWN behind, LEFT), A knocks or walks through. */\nfunction updateExplore() {\n  for (const [b, k] of [[UP, 0], [RIGHT, 1], [DOWN, 2], [LEFT, 3]]) {\n    if (!pressed(b)) continue;\n    const d = (me.f + k) % 4;\n    if (getDoor(me.x, me.y, d) !== NONE) { sel = d; fx(SFX.move); }\n  }\n  if (!pressed(A)) return;\n  const door = getDoor(me.x, me.y, sel);\n  if (door === OPEN) walk(sel);\n  else if (door === CLOSED) { cur = pickQuestion(); phase = 'ask'; timer = 0; fx(SFX.select); }\n  else if (door === LOCKED) {\n    if (keys) { phase = 'confirm'; timer = 0; fx(SFX.select); } else { say('LOCKED FOR GOOD'); fx(SFX.hit); }\n  }\n}\n\n/** A locked door, with a key in your pocket: A uses it, B does not. */\nfunction updateConfirm() {\n  if (pressed(B)) { phase = 'explore'; fx(SFX.move); return; }\n  if (!pressed(A) || timer < 6) return;\n  keys--; setDoor(me.x, me.y, sel, OPEN); checkStuck(); walk(sel);\n}\n\n/** A question: UP and DOWN choose an answer, A answers, B uses a key instead (not on the heart's last question). */\nfunction updateAsk() {\n  if (pressed(UP)) { cur.sel = (cur.sel + 3) % 4; fx(SFX.move); }\n  if (pressed(DOWN)) { cur.sel = (cur.sel + 1) % 4; fx(SFX.move); }\n  if (timer < 10) return;\n  if (pressed(B) && !cur.final) {\n    if (!keys) { say('YOU HAVE NO KEY'); fx(SFX.hit); return; }\n    keys--; asked.delete(cur.qi); setDoor(me.x, me.y, cur.door, OPEN); checkStuck();\n    const d = cur.door; cur = null; walk(d); return;\n  }\n  if (!pressed(A)) return;\n  cur.chosen = cur.sel; cur.right = cur.order[cur.sel] === 0; answered++;\n  if (cur.right) {\n    score += pointsFor(); streak++; rightCount++; fx(SFX.point);\n    if (cur.final) score += winBonus(); else setDoor(me.x, me.y, cur.door, OPEN);\n  } else {\n    streak = 0; candle--; fx(SFX.hit);\n    if (!cur.final) { setDoor(me.x, me.y, cur.door, LOCKED); if (candle > 0) checkStuck(); }\n  }\n  phase = 'answered'; timer = 0;\n}\n\n/** The answer shown for a moment (the right one lit), then through the door, or back to the room; the run's end. */\nfunction updateAnswered() {\n  if (timer < 50 && !(timer > 15 && pressed(A))) return;\n  const { door, right, final } = cur;\n  cur = null; phase = 'explore';\n  if (final && right) { won = true; gameOver(); return; }\n  if (candle <= 0) { gameOver(); return; }\n  if (final) { cur = { ...pickQuestion(), final: true }; phase = 'ask'; timer = 0; return; }   // the heart asks again\n  if (right) walk(door); else sel = firstDoor();\n}\n\nfunction walk(d) { phase = 'walk'; walkT = 0; walkTo = d; fx(SFX.select); }\n/** Through the door: the screen dims, you are in the next room facing the way you walked, and it brightens. */\nfunction updateWalk() {\n  walkT++;\n  if (walkT === 12) {\n    me = { x: me.x + DX[walkTo], y: me.y + DY[walkTo], f: walkTo };\n    seen.add(roomId(me.x, me.y)); sel = firstDoor();\n    pickUp();\n  }\n  if (walkT >= 24) {\n    phase = 'explore'; brightness(15);\n    if (me.x === goal.x && me.y === goal.y) {   // the heart: its keeper's last question\n      cur = { ...pickQuestion(), final: true }; phase = 'ask'; timer = 0;\n      say('LADY RIDDLEWICK HAS ONE LAST QUESTION');\n    }\n  } else brightness(Math.round(Math.abs(walkT - 12) * 15 / 12));\n}\n\n/** What lies in the room you walk into: a key (always taken), a candle stub (taken if the candle is not full). */\nfunction pickUp() {\n  const r = roomId(me.x, me.y), it = items[r];\n  if (it === ITEM_KEY) { keys++; items[r] = ITEM_NONE; say('YOU FIND A SKELETON KEY'); fx(SFX.point); }\n  else if (it === ITEM_STUB) {\n    if (candle < LEVELS[level - 1].candle) { candle++; items[r] = ITEM_NONE; say('A CANDLE STUB: YOUR CANDLE GROWS'); fx(SFX.point); }\n    else say('A CANDLE STUB (YOUR CANDLE IS FULL)');\n  }\n}\n\nfunction gameOver() {\n  state = 'over'; timer = 0; play(-1); fx(SFX.over); brightness(15);\n  clearRun();\n  rank = insertTop({ score, initials: lastInitials(), level, subject });\n}\n\nfunction updateOver() {\n  if (timer < 60 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  state = 'records'; hl = rank; timer = 0;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nconst PAUSE_MENU = ['RESUME', 'QUIT TO TITLE'];\nfunction updatePause() {\n  if (pressed(UP) || pressed(DOWN)) { pauseSel ^= 1; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false; else toTitle();\n  }\n}\n\n// --- Draw ---\n\nconst VIEW_H = 136;   // the room's view: y 0 to 135; the panel below\n// The room in perspective (placeholders until the art pass): the back wall, and where the walls meet the floor and ceiling.\nconst BACK = { x0: 64, y0: 20, x1: 192, y1: 100 };\n/** The top and bottom of the left wall at column x (0 to BACK.x0). */\nconst wallTop = (x) => Math.round(BACK.y0 * x / BACK.x0), wallBot = (x) => Math.round(VIEW_H - 1 - (VIEW_H - 1 - BACK.y1) * x / BACK.x0);\n\nfunction draw() {\n  cls();\n  if (state === 'play' || state === 'over') drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  else if (state === 'setup') drawSetup();\n  if (state === 'over') drawEnd();\n  if (paused) drawPause();\n}\n\nfunction drawPlay() {\n  drawRoom();\n  if (phase === 'ask' || phase === 'answered') drawQuestion(); else drawPanel();\n}\n\nconst DOOR_COL = [0, 4, 0, 6];\n/** The room as you see it: the walls, then the doors (ahead, left, right, and an arrow for the one behind). */\nfunction drawRoom() {\n  rectfill(0, 0, 256, VIEW_H, 2);                                       // the side walls and ceiling\n  for (let x = 0; x <= BACK.x0; x++) { line(x, wallBot(x), x, VIEW_H - 1, 7); line(255 - x, wallBot(x), 255 - x, VIEW_H - 1, 7); }   // the floor\n  rectfill(BACK.x0, BACK.y1, BACK.x1 - BACK.x0, VIEW_H - BACK.y1, 7);\n  rectfill(BACK.x0, BACK.y0, BACK.x1 - BACK.x0, BACK.y1 - BACK.y0, 1);  // the back wall\n  line(0, 0, BACK.x0, BACK.y0, 3); line(255, 0, BACK.x1, BACK.y0, 3); line(0, VIEW_H - 1, BACK.x0, BACK.y1, 3); line(255, VIEW_H - 1, BACK.x1, BACK.y1, 3);\n  rect(BACK.x0, BACK.y0, BACK.x1 - BACK.x0, BACK.y1 - BACK.y0, 3);\n  const choosing = state === 'play' && phase === 'explore';\n  for (const k of [0, 1, 3]) {\n    const d = (me.f + k) % 4, st = getDoor(me.x, me.y, d);\n    if (st === NONE) continue;\n    const on = choosing && sel === d, c = on && st !== LOCKED ? 9 : DOOR_COL[st];\n    if (k === 0) {   // ahead, in the back wall\n      rectfill(112, 52, 32, BACK.y1 - 52, c); rect(111, 51, 34, BACK.y1 - 50, on ? GOLD : SHADOW);\n      if (st === LOCKED) { line(112, 52, 143, BACK.y1 - 1, WHITE); line(143, 52, 112, BACK.y1 - 1, WHITE); }\n    } else {          // on a side wall: columns 18 to 44 of the left wall (mirrored for the right)\n      for (let x = 18; x <= 44; x++) {\n        const top = Math.round(wallTop(x) + (wallBot(x) - wallTop(x)) * 0.3), bot = wallBot(x), xx = k === 3 ? x : 255 - x;\n        line(xx, top, xx, bot, c);\n        if (on && (x === 18 || x === 44)) line(xx, top, xx, bot, GOLD);\n        if (st === LOCKED && (x - 18) % 9 === 0) line(xx, top, xx, bot, WHITE);\n      }\n    }\n  }\n  const back = getDoor(me.x, me.y, (me.f + 2) % 4);\n  if (back !== NONE) {   // the door behind you: an arrow at the bottom of the view\n    const on = choosing && sel === (me.f + 2) % 4, c = back === LOCKED ? RED : on ? GOLD : DIM;\n    for (let i = 0; i < 6; i++) line(128 - 6 + i, 122 + i, 128 + 6 - i, 122 + i, c);\n  }\n}\n\n/** The panel while exploring: the map, the room's name, the candle, the keys, the score, and what A does. */\nfunction drawPanel() {\n  rectfill(0, VIEW_H, 256, 224 - VIEW_H, SHADOW);\n  line(0, VIEW_H, 255, VIEW_H, PANEL);\n  drawMap(6, VIEW_H + 12, 10);\n  txt(KINDS[kinds[roomId(me.x, me.y)]][0], 84, VIEW_H + 6, GOLD);\n  drawCandle(84, VIEW_H + 20);\n  txt(`KEYS ${keys}`, 196, VIEW_H + 20, keys ? WHITE : DIM);\n  txt(`SCORE ${score}`, 84, VIEW_H + 34, WHITE);\n  if (noticeT) txt(notice.length > 21 ? notice.slice(0, 21) : notice, 84, VIEW_H + 50, CYAN);\n  if (noticeT && notice.length > 21) txt(notice.slice(21).trim(), 84, VIEW_H + 60, CYAN);\n  if (state !== 'play') return;\n  if (phase === 'confirm') { txt('USE A KEY? A: YES  B: NO', 84, VIEW_H + 74, GOLD); return; }\n  if (phase !== 'explore') return;\n  const st = getDoor(me.x, me.y, sel);\n  txt(st === OPEN ? 'A: GO THROUGH' : st === LOCKED ? (keys ? 'A: USE A KEY' : 'LOCKED') : 'A: KNOCK', 84, VIEW_H + 74, st === LOCKED && !keys ? RED : GOLD);\n}\n\n/** The candle: its notches left of the level's full candle, with a flame on top while it burns. */\nfunction drawCandle(x, y) {\n  const full = LEVELS[level - 1].candle;\n  txt('CANDLE', x, y, DIM);\n  for (let i = 0; i < full; i++) rectfill(x + 52 + i * 9, y + 1, 7, 6, i < candle ? WHITE : PANEL);\n  if (candle > 0) circfill(x + 52 + (candle - 1) * 9 + 3, y - 2, 1 + (flr(clock / 6) % 2), GOLD);\n}\n\n/** The map: the rooms you have seen, their doors (open: a gap; locked: red), the heart (gold) and you (an arrow). */\nfunction drawMap(x0, y0, c) {\n  for (let y = 0; y < MH; y++) for (let x = 0; x < MW; x++) {\n    const px = x0 + x * c, py = y0 + y * c, isGoal = x === goal.x && y === goal.y;\n    if (!seen.has(roomId(x, y)) && !isGoal) continue;\n    rectfill(px + 1, py + 1, c - 2, c - 2, isGoal ? GOLD : PANEL);\n    for (const d of [E, S]) {\n      const st = getDoor(x, y, d);\n      if (st === NONE) continue;\n      const col = st === OPEN ? PANEL : st === LOCKED ? RED : 4;\n      if (d === E) rectfill(px + c - 1, py + c / 2 - 1, 2, 2, col); else rectfill(px + c / 2 - 1, py + c - 1, 2, 2, col);\n    }\n  }\n  const mx = x0 + me.x * c + c / 2, my = y0 + me.y * c + c / 2;   // you: a dot and a tick the way you face\n  rectfill(mx - 1, my - 1, 2, 2, WHITE); line(mx, my, mx + DX[me.f] * 3, my + DY[me.f] * 3, WHITE);\n}\n\n/** A question: its ghost (a placeholder) in the room, who asks, the question, and the four answers, one lit. */\nfunction drawQuestion() {\n  const q = QUESTIONS[cur.qi], kind = kinds[roomId(me.x, me.y)];\n  circfill(128, 54, 16, 15); rectfill(112, 54, 33, 26, 15);   // the ghost (the art pass draws them)\n  for (let i = 0; i < 4; i++) circfill(116 + i * 8, 80, 4, 15);\n  circfill(122, 50, 2, SHADOW); circfill(134, 50, 2, SHADOW);\n  panel(0, 112, 256, 112);\n  if (phase === 'ask') txt(cur.final ? 'LADY RIDDLEWICK ASKS:' : `${KINDS[kind][1]} ASKS:`, 8, 117, cur.final ? GOLD : CYAN);\n  if (phase === 'ask' && keys && !cur.final) txt(`B: KEY (${keys})`, 248 - 8 * (8 + String(keys).length), 117, DIM);\n  wrap(q.q, Q_LINE).forEach((l, i) => txt(l, 8, 130 + i * 11, WHITE));\n  cur.order.forEach((a, i) => {\n    const y = 167 + i * 13, isRight = a === 0;\n    let c = i === cur.sel ? GOLD : WHITE;\n    if (phase === 'answered') c = isRight ? GREEN : i === cur.chosen ? RED : DIM;\n    if (phase === 'ask' && i === cur.sel) rectfill(4, y - 3, 248, 12, PANEL);\n    txt(`${'ABCD'[i]}  ${q.ans[a]}`, 12, y, c);\n  });\n  if (phase === 'answered') {\n    const msg = cur.right ? (cur.final ? 'RIGHT! THE MANOR IS YOURS' : 'RIGHT! THE DOOR OPENS') : candle <= 0 ? 'WRONG! YOUR CANDLE GOES OUT' : cur.final ? 'WRONG! YOUR CANDLE BURNS' : 'WRONG! THE DOOR LOCKS';\n    txt(msg, 8, 117, cur.right ? GREEN : RED);\n  }\n}\n\nfunction drawEnd() {\n  panel(24, 72, 208, 72);\n  ctxt(won ? 'YOU FOUND THE HEART' : 'YOUR CANDLE HAS GONE OUT', 80, won ? GOLD : RED);\n  ctxt(`SCORE ${score}`, 98, WHITE);\n  ctxt(`${rightCount} OF ${answered} ANSWERED RIGHT`, 112, DIM);\n  if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 128, DIM);\n}\n\nfunction drawTitle() {\n  ctxt('RIDDLEWICK MANOR', 50, GOLD);\n  titleItems().forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 88, 100 + i * 14, i === titleSel ? WHITE : DIM));\n  if (hasRun()) {\n    const v = dget(RUN_SLOT + 2);\n    ctxt(`SAVED: ${SUBJECTS[(v & 15) - 1] || 'ALL SUBJECTS'}`, 170, DIM);\n    ctxt(`LEVEL ${(v >> 4) & 15}, SCORE ${dget(RUN_SLOT + 3)}`, 182, DIM);\n  }\n}\n\nconst LEVEL_NOTES = ['CANDLE 6, EASY QUESTIONS', 'CANDLE 5, FAIR QUESTIONS', 'CANDLE 4, HARD QUESTIONS', 'CANDLE 3, EXPERT QUESTIONS'];\nfunction drawSetup() {\n  panel(16, 32, 224, 160);\n  ctxt('A NEW GAME', 42, GOLD);\n  [['SUBJECT', subject < 0 ? 'ALL SUBJECTS' : SUBJECTS[subject]], ['LEVEL', `${level} ${LEVELS[level - 1].name}`]].forEach(([k, v], i) => {\n    const y = 72 + i * 30, on = i === setupRow;\n    txt(k, 28, y, on ? WHITE : DIM);\n    txt(on ? `< ${v} >` : `  ${v}`, 28, y + 12, on ? GOLD : WHITE);\n  });\n  ctxt(LEVEL_NOTES[level - 1], 140, DIM);\n  if (hasRun()) ctxt('REPLACES YOUR SAVED GAME', 156, RED);\n  ctxt('A: BEGIN   B: BACK', 176, DIM);\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    txt(e.score ? String(e.score).padStart(6) : '', 104, y, i === 0 ? GOLD : WHITE);\n    if (e.score && e.level) txt(`L${e.level} ${['ALL', 'HIS', 'GEO', 'SCI', 'NAT', 'ART', 'MUS', 'SPO', 'FOO'][e.subject + 1]}`, 168, y, DIM);\n  });\n  if (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(String(score), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 54);\n  ctxt('PAUSED', 88, GOLD);\n  PAUSE_MENU.forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 106 + i * 12, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

  "meta": {
    "title": "Riddlewick Manor",
    "author": "NOVA-16",
    "description": "A trivia adventure in a haunted manor. Knock on a door and its ghost asks you a question: answer right and it opens, answer wrong and it locks for good and your candle burns down. Find your way, room by room, to the heart of the manor before your candle goes out."
  },
  "label": "",
  "code": "// Riddlewick Manor: a trivia adventure in a haunted manor (docs/carts/riddlewick-manor.md). Knock on a door, answer its\n// ghost's question: right and it opens, wrong and it locks for good. Find a way, room by room, to the heart of the manor.\n// The questions are in ROM (questions.txt, packed by questions.py). Built on the starter's frame (title, pause, the\n// end, a saved top 10 with initials, the records).\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst RED = 6, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;   // the default palette's (the rest are art.py's, below the ART block)\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {\"door_back_0_0\": 307, \"door_back_0_1\": 311, \"door_back_0_2\": 315, \"door_back_0_3\": 315, \"door_back_0_4\": 315, \"door_back_0_5\": 323, \"door_back_0_6\": 327, \"door_back_1_0\": 308, \"door_back_1_1\": 312, \"door_back_1_2\": 316, \"door_back_1_3\": 316, \"door_back_1_4\": 316, \"door_back_1_5\": 324, \"door_back_1_6\": 328, \"door_back_2_0\": 309, \"door_back_2_1\": 313, \"door_back_2_2\": 317, \"door_back_2_3\": 319, \"door_back_2_4\": 321, \"door_back_2_5\": 325, \"door_back_2_6\": 329, \"door_back_3_0\": 310, \"door_back_3_1\": 314, \"door_back_3_2\": 318, \"door_back_3_3\": 320, \"door_back_3_4\": 322, \"door_back_3_5\": 326, \"door_back_3_6\": 330, \"door_side_0_0\": 331, \"door_side_0_1\": 335, \"door_side_0_10\": 355, \"door_side_0_2\": 339, \"door_side_0_3\": 335, \"door_side_0_4\": 335, \"door_side_0_5\": 335, \"door_side_0_6\": 335, \"door_side_0_7\": 346, \"door_side_0_8\": 350, \"door_side_0_9\": 335, \"door_side_1_0\": 332, \"door_side_1_1\": 336, \"door_side_1_10\": 356, \"door_side_1_2\": 340, \"door_side_1_3\": 336, \"door_side_1_4\": 336, \"door_side_1_5\": 336, \"door_side_1_6\": 336, \"door_side_1_7\": 347, \"door_side_1_8\": 351, \"door_side_1_9\": 352, \"door_side_2_0\": 333, \"door_side_2_1\": 337, \"door_side_2_2\": 341, \"door_side_2_3\": 337, \"door_side_2_4\": 343, \"door_side_2_5\": 344, \"door_side_2_6\": 337, \"door_side_2_7\": 348, \"door_side_2_8\": 337, \"door_side_2_9\": 353, \"door_side_3_0\": 334, \"door_side_3_1\": 338, \"door_side_3_2\": 342, \"door_side_3_3\": 338, \"door_side_3_4\": 338, \"door_side_3_5\": 338, \"door_side_3_6\": 345, \"door_side_3_7\": 349, \"door_side_3_8\": 338, \"door_side_3_9\": 354, \"fur0_0_1\": 359, \"fur0_0_3\": 366, \"fur0_0_4\": 369, \"fur0_0_5\": 372, \"fur0_0_6\": 374, \"fur0_1_0\": 357, \"fur0_1_1\": 360, \"fur0_1_2\": 363, \"fur0_1_3\": 367, \"fur0_1_4\": 363, \"fur0_1_5\": 363, \"fur0_1_6\": 375, \"fur0_2_0\": 358, \"fur0_2_1\": 361, \"fur0_2_2\": 364, \"fur0_2_3\": 368, \"fur0_2_4\": 370, \"fur0_2_5\": 373, \"fur0_2_6\": 376, \"fur0_3_1\": 362, \"fur0_3_2\": 365, \"fur0_3_3\": 365, \"fur0_3_4\": 371, \"fur1_0_0\": 377, \"fur1_0_1\": 381, \"fur1_0_2\": 385, \"fur1_0_3\": 389, \"fur1_0_4\": 393, \"fur1_0_5\": 397, \"fur1_0_6\": 401, \"fur1_1_0\": 378, \"fur1_1_1\": 382, \"fur1_1_2\": 386, \"fur1_1_3\": 390, \"fur1_1_4\": 394, \"fur1_1_5\": 398, \"fur1_1_6\": 402, \"fur1_2_0\": 379, \"fur1_2_1\": 383, \"fur1_2_2\": 387, \"fur1_2_3\": 391, \"fur1_2_4\": 395, \"fur1_2_5\": 399, \"fur1_2_6\": 403, \"fur1_3_0\": 380, \"fur1_3_1\": 384, \"fur1_3_2\": 388, \"fur1_3_3\": 392, \"fur1_3_4\": 396, \"fur1_3_5\": 400, \"fur1_3_6\": 404, \"fur2_0_0\": 405, \"fur2_0_1\": 408, \"fur2_0_2\": 412, \"fur2_0_3\": 412, \"fur2_0_4\": 418, \"fur2_0_5\": 422, \"fur2_1_0\": 406, \"fur2_1_1\": 409, \"fur2_1_2\": 413, \"fur2_1_3\": 416, \"fur2_1_4\": 419, \"fur2_1_5\": 423, \"fur2_1_6\": 426, \"fur2_2_0\": 406, \"fur2_2_1\": 410, \"fur2_2_2\": 414, \"fur2_2_3\": 417, \"fur2_2_4\": 420, \"fur2_2_5\": 424, \"fur2_2_6\": 427, \"fur2_3_0\": 407, \"fur2_3_1\": 411, \"fur2_3_2\": 415, \"fur2_3_3\": 415, \"fur2_3_4\": 421, \"fur2_3_5\": 425, \"fur3_0_4\": 434, \"fur3_0_5\": 438, \"fur3_0_6\": 442, \"fur3_1_1\": 428, \"fur3_1_2\": 430, \"fur3_1_3\": 432, \"fur3_1_4\": 435, \"fur3_1_5\": 439, \"fur3_1_6\": 443, \"fur3_2_1\": 429, \"fur3_2_2\": 431, \"fur3_2_3\": 433, \"fur3_2_4\": 436, \"fur3_2_5\": 440, \"fur3_2_6\": 443, \"fur3_3_4\": 437, \"fur3_3_5\": 441, \"fur3_3_6\": 444, \"fur4_0_0\": 445, \"fur4_0_1\": 449, \"fur4_0_2\": 453, \"fur4_0_3\": 457, \"fur4_0_4\": 461, \"fur4_0_5\": 465, \"fur4_0_6\": 469, \"fur4_1_0\": 446, \"fur4_1_1\": 450, \"fur4_1_2\": 454, \"fur4_1_3\": 458, \"fur4_1_4\": 462, \"fur4_1_5\": 466, \"fur4_1_6\": 470, \"fur4_2_0\": 447, \"fur4_2_1\": 451, \"fur4_2_2\": 455, \"fur4_2_3\": 459, \"fur4_2_4\": 463, \"fur4_2_5\": 467, \"fur4_2_6\": 470, \"fur4_3_0\": 448, \"fur4_3_1\": 452, \"fur4_3_2\": 456, \"fur4_3_3\": 460, \"fur4_3_4\": 464, \"fur4_3_5\": 468, \"fur4_3_6\": 471, \"fur5_0_3\": 472, \"fur5_0_4\": 476, \"fur5_1_3\": 473, \"fur5_1_4\": 477, \"fur5_1_5\": 480, \"fur5_1_6\": 482, \"fur5_2_3\": 474, \"fur5_2_4\": 478, \"fur5_2_5\": 481, \"fur5_2_6\": 483, \"fur5_3_3\": 475, \"fur5_3_4\": 479, \"fur6_0_0\": 484, \"fur6_0_1\": 487, \"fur6_0_2\": 487, \"fur6_0_3\": 487, \"fur6_0_4\": 487, \"fur6_0_5\": 487, \"fur6_0_6\": 501, \"fur6_1_0\": 485, \"fur6_1_1\": 488, \"fur6_1_2\": 491, \"fur6_1_3\": 494, \"fur6_1_4\": 494, \"fur6_1_5\": 498, \"fur6_1_6\": 502, \"fur6_2_0\": 485, \"fur6_2_1\": 489, \"fur6_2_2\": 492, \"fur6_2_3\": 495, \"fur6_2_4\": 495, \"fur6_2_5\": 499, \"fur6_2_6\": 503, \"fur6_3_0\": 486, \"fur6_3_1\": 490, \"fur6_3_2\": 493, \"fur6_3_3\": 496, \"fur6_3_4\": 497, \"fur6_3_5\": 500, \"fur6_3_6\": 504, \"fur7_0_3\": 508, \"fur7_0_4\": 512, \"fur7_0_6\": 519, \"fur7_1_3\": 509, \"fur7_1_4\": 513, \"fur7_1_5\": 516, \"fur7_1_6\": 520, \"fur7_2_2\": 506, \"fur7_2_3\": 510, \"fur7_2_4\": 514, \"fur7_2_5\": 517, \"fur7_2_6\": 521, \"fur7_3_1\": 505, \"fur7_3_2\": 507, \"fur7_3_3\": 511, \"fur7_3_4\": 515, \"fur7_3_5\": 518, \"fur7_3_6\": 522, \"fur8_0_2\": 529, \"fur8_0_3\": 533, \"fur8_0_4\": 537, \"fur8_1_0\": 523, \"fur8_1_1\": 526, \"fur8_1_2\": 530, \"fur8_1_3\": 534, \"fur8_1_4\": 538, \"fur8_1_5\": 541, \"fur8_1_6\": 543, \"fur8_2_0\": 524, \"fur8_2_1\": 527, \"fur8_2_2\": 531, \"fur8_2_3\": 535, \"fur8_2_4\": 539, \"fur8_2_5\": 542, \"fur8_2_6\": 544, \"fur8_3_0\": 525, \"fur8_3_1\": 528, \"fur8_3_2\": 532, \"fur8_3_3\": 536, \"fur8_3_4\": 540, \"fur8_3_5\": 528, \"fur8_3_6\": 545, \"fur9_0_0\": 546, \"fur9_0_1\": 550, \"fur9_0_2\": 550, \"fur9_0_3\": 550, \"fur9_0_4\": 550, \"fur9_0_5\": 550, \"fur9_0_6\": 550, \"fur9_1_0\": 547, \"fur9_1_1\": 551, \"fur9_1_2\": 553, \"fur9_1_3\": 555, \"fur9_1_4\": 555, \"fur9_1_5\": 557, \"fur9_1_6\": 559, \"fur9_2_0\": 548, \"fur9_2_1\": 552, \"fur9_2_2\": 554, \"fur9_2_3\": 556, \"fur9_2_4\": 556, \"fur9_2_5\": 558, \"fur9_2_6\": 560, \"fur9_3_0\": 549, \"fur9_3_1\": 516, \"fur9_3_2\": 516, \"fur9_3_3\": 516, \"fur9_3_4\": 516, \"fur9_3_5\": 516, \"fur9_3_6\": 516},\n  sprites: {\"arrow\": {\"pal\": 0, \"size\": 16, \"tile\": 864}, \"flame0\": {\"pal\": 0, \"size\": 8, \"tile\": 870}, \"flame1\": {\"pal\": 0, \"size\": 8, \"tile\": 871}, \"ghost_bot0\": {\"pal\": 5, \"size\": 32, \"tile\": 900}, \"ghost_bot1\": {\"pal\": 5, \"size\": 32, \"tile\": 908}, \"ghost_top0\": {\"pal\": 5, \"size\": 32, \"tile\": 896}, \"ghost_top1\": {\"pal\": 5, \"size\": 32, \"tile\": 904}, \"holder\": {\"pal\": 0, \"size\": 16, \"tile\": 868}, \"key\": {\"pal\": 0, \"size\": 8, \"tile\": 872}, \"padlock\": {\"pal\": 0, \"size\": 16, \"tile\": 866}, \"prop0\": {\"pal\": 1, \"size\": 16, \"tile\": 874}, \"prop1\": {\"pal\": 1, \"size\": 16, \"tile\": 876}, \"prop2\": {\"pal\": 1, \"size\": 16, \"tile\": 878}, \"prop3\": {\"pal\": 1, \"size\": 16, \"tile\": 960}, \"prop4\": {\"pal\": 1, \"size\": 16, \"tile\": 962}, \"prop5\": {\"pal\": 1, \"size\": 16, \"tile\": 964}, \"prop6\": {\"pal\": 1, \"size\": 16, \"tile\": 966}, \"prop7\": {\"pal\": 1, \"size\": 16, \"tile\": 968}, \"prop8\": {\"pal\": 1, \"size\": 16, \"tile\": 970}, \"prop9\": {\"pal\": 1, \"size\": 16, \"tile\": 972}},\n  scenes: {\"panel\": {\"h\": 11, \"mx\": 0, \"my\": 17, \"pal\": 6, \"w\": 32}, \"room\": {\"h\": 17, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"title\": {\"h\": 28, \"mx\": 32, \"my\": 0, \"pal\": 7, \"w\": 32}},\n  colors: {\"CREAM\": 164, \"DEEP\": 169, \"EDGE\": 170, \"FADED\": 161, \"GLASS\": 200, \"GOLD\": 163, \"INK\": 160, \"LILAC\": 171, \"ROOM\": 165, \"SEAL\": 162, \"SHEET\": 168, \"WAX\": 166, \"WAXSHADE\": 167},\n  gradients: {\"night\":{\"entry\":0,\"lines\":[1024,1024,1024,2048,2048,2048,2048,2048,2049,2049,2049,2049,2049,2049,2049,2049,2049,2049,3073,3073,3073,3073,3073,3073,3105,3105,3105,3105,3105,3105,3105,3105,3105,4129,4129,4129,4129,4129,4130,4130,4130,4130,4130,4130,4130,4130,4130,5154,5154,5154,5154,5154,5154,5154,5154,5154,5154,5154,5154,5154,6178,6178,6178,6210,6210,6210,6211,6211,6211,6211,6211,6211,6211,6211,7235,7235,7235,7235,7235,7235,7235,7235,7235,7235,7235,7235,7235,7235,7236,7236,7236,7236,8292,8292,8292,8292,8292,8292,8292,8292,8292,8292,8292,8292,8292,8292,8292,8293,8293,9317,9317,9317,9317,9317,9317,9317,9317,9349,9349,9349,9349,9349,9349,9349,9349,9349,9350,10374,10374,10374,10374,10374,10374,10374,10374,10374,10374,10374,10374,10374,10374,10374,10406,10406,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11431,11432,11432,11432,11432,11432,11432,11432,11432,11432,11432,11432,11464,11464,11464,11464,11464,11464,11464,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11465,11466,11466,11466,11466,11466,11466,11466,11466,11466,11466,11466,11498,11498,11498,11498,11498,11498,11498,11499,11499,11499,11499,11499,11499],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\nconst SHADOW = ART.colors.DEEP, PANEL = ART.colors.EDGE, DIM = ART.colors.LILAC;   // text's shadow, panels' edge, quiet text (not the default grey and brown)\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\n// The effects (spec 11), in the order audio.py makes them.\nconst SFX = { move: 0, select: 1, pause: 2, knock: 3, step: 4, locked: 5, right: 6, wrong: 7, key: 8, stub: 9, win: 10, lose: 11, record: 12, ghost: 13 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst CHOICE_SLOT = 2, BANK_SLOT = 3, SEEN_SLOT = 40, SEEN_SLOTS = 20;\nconst RUN_SLOT = 60;   // the run in progress (spec 13): 60 a flag, 61 the seed, 62 the run's numbers, 63 the score, 64 the tallies,\n                       // 65 to 69 the doors (2 bits each), 70 and 71 the rooms seen, 72 and 73 the rooms whose item is still there   // the bank's size when the seen bits were kept; the questions asked in earlier runs (640 bits)\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: score, initials, a spare (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\n// An entry: its score, its initials, and its level and subject (level | (subject + 1) << 4).\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY, v = dget(s + 2); return { score: dget(s), initials: unpackInitials(dget(s + 1)), level: v & 15, subject: (v >> 4) - 1 }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, (e.level || 0) | ((e.subject ?? -1) + 1) << 4); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// ===================================================================================================================\n// The question bank (spec 6): read from ROM once.\n// ===================================================================================================================\n\nconst SUBJECTS = ['HISTORY', 'GEOGRAPHY', 'SCIENCE', 'NATURE', 'ARTS AND BOOKS', 'MUSIC AND SCREEN', 'SPORT AND GAMES', 'FOOD AND EVERYDAY'];\nconst Q_LINE = 30, Q_LINES = 3;   // a question is shown in up to 3 lines of 30 characters\nlet QUESTIONS = [];\n/** The questions from rom('questions') (questions.py writes the format): [{ subj, diff, q, ans: [right, wrong x 3] }]. */\nfunction loadQuestions() {\n  const b = rom('questions'), out = [];\n  let i = 5;\n  const str = () => { const n = b[i++]; let s = ''; for (let k = 0; k < n; k++) s += String.fromCharCode(b[i++]); return s; };\n  for (let k = 0, n = b[3] | (b[4] << 8); k < n; k++) {\n    const subj = b[i++], diff = b[i++], q = str();\n    out.push({ subj, diff, q, ans: [str(), str(), str(), str()] });\n  }\n  return out;\n}\n/** Words into lines of at most `w` characters. */\nfunction wrap(s, w) {\n  const lines = [];\n  let line = '';\n  for (const word of s.split(' ')) {\n    if (line && line.length + 1 + word.length > w) { lines.push(line); line = word; } else line = line ? `${line} ${word}` : word;\n  }\n  if (line) lines.push(line);\n  return lines;\n}\n\n// ===================================================================================================================\n// The manor (spec 5): rooms on a grid, a door (or a wall) between each two neighbours.\n// ===================================================================================================================\n\nconst N = 0, E = 1, S = 2, W = 3, DX = [0, 1, 0, -1], DY = [-1, 0, 1, 0];\nconst NONE = 0, CLOSED = 1, OPEN = 2, LOCKED = 3;   // a door's state (NONE: a wall)\nconst MW = 7, MH = 6;   // the manor's size in rooms\nlet doorsH = [], doorsV = [];   // doorsH[y * (MW - 1) + x]: between (x, y) and (x + 1, y); doorsV[y * MW + x]: (x, y) and (x, y + 1)\nconst start = { x: 0, y: MH - 1 }, goal = { x: MW - 1, y: 0 };   // the Entrance Hall, bottom left; the heart, top right\nlet me = { x: 0, y: 0, f: N };   // where you are and which way you face\nlet seen = new Set();   // the rooms you have seen (on the map)\n\n/** The door from room (x, y) towards d: { list, i } in doorsH or doorsV, or null at the manor's edge. */\nfunction doorRef(x, y, d) {\n  const nx = x + DX[d], ny = y + DY[d];\n  if (nx < 0 || ny < 0 || nx >= MW || ny >= MH) return null;\n  if (d === E || d === W) return { list: doorsH, i: y * (MW - 1) + Math.min(x, nx) };\n  return { list: doorsV, i: Math.min(y, ny) * MW + x };\n}\nfunction getDoor(x, y, d) { const r = doorRef(x, y, d); return r ? r.list[r.i] : NONE; }\nfunction setDoor(x, y, d, v) { const r = doorRef(x, y, d); if (r) r.list[r.i] = v; }\nconst roomId = (x, y) => y * MW + x;\n\n// The rooms' kinds (spec 6): a name, and the ghost who asks there. The first is the start's, the last the heart's.\nconst KINDS = [\n  ['ENTRANCE HALL', 'THE BUTLER'], ['LIBRARY', 'THE LIBRARIAN'], ['GALLERY', 'THE PAINTER'], ['DINING ROOM', 'THE DUCHESS'],\n  ['KITCHEN', 'THE COOK'], ['CONSERVATORY', 'THE GARDENER'], ['MUSIC ROOM', 'THE ORGANIST'], ['NURSERY', 'THE TWINS'],\n  ['ARMOURY', 'THE KNIGHT'], ['CLOCK ROOM', 'LADY RIDDLEWICK'],\n];\nconst HALL = 0, HEART = KINDS.length - 1;\nconst EXTRA_DOORS = 0.3, N_KEYS = 3, N_STUBS = 2;   // the share of the maze's remaining walls that get a door; what lies about\nconst ITEM_NONE = 0, ITEM_KEY = 1, ITEM_STUB = 2;\nlet kinds = [], items = [];   // by room: its kind (an index into KINDS), and what lies in it\n\n/** A small seeded random number generator (mulberry32), so a run's manor can be made again from its seed (the save). */\nfunction seeded(seed) {\n  let a = seed >>> 0;\n  return (n) => {\n    a = (a + 0x6d2b79f5) >>> 0;\n    let t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return Math.floor((((t ^ (t >>> 14)) >>> 0) / 4294967296) * n);\n  };\n}\n\n/** The manor of a seed (spec 5): a maze (a random spanning tree, so every room can be reached), a door in about 30% of\n * its other walls (loops, other ways round), the rooms' kinds (no two neighbours alike where possible), and the keys and\n * candle stubs, away from the start. */\nfunction makeManor(seed) {\n  const r = seeded(seed);\n  doorsH = new Array((MW - 1) * MH).fill(NONE); doorsV = new Array(MW * (MH - 1)).fill(NONE);\n  const inTree = new Set([roomId(start.x, start.y)]), frontier = [];\n  const addEdges = (x, y) => { for (let d = 0; d < 4; d++) if (doorRef(x, y, d)) frontier.push([x, y, d]); };\n  addEdges(start.x, start.y);\n  while (frontier.length) {   // Prim's maze: a random edge from the tree to a room not yet in it\n    const [x, y, d] = frontier.splice(r(frontier.length), 1)[0], nx = x + DX[d], ny = y + DY[d];\n    if (inTree.has(roomId(nx, ny))) continue;\n    setDoor(x, y, d, CLOSED); inTree.add(roomId(nx, ny)); addEdges(nx, ny);\n  }\n  for (const list of [doorsH, doorsV]) for (let i = 0; i < list.length; i++) if (list[i] === NONE && r(100) < EXTRA_DOORS * 100) list[i] = CLOSED;\n  kinds = [];\n  for (let y = 0; y < MH; y++) for (let x = 0; x < MW; x++) {\n    let k, tries = 0;\n    do k = 1 + r(HEART - 1); while (tries++ < 12 && ((x > 0 && kinds[roomId(x - 1, y)] === k) || (y > 0 && kinds[roomId(x, y - 1)] === k)));\n    kinds.push(k);\n  }\n  kinds[roomId(start.x, start.y)] = HALL; kinds[roomId(goal.x, goal.y)] = HEART;\n  items = new Array(MW * MH).fill(ITEM_NONE);\n  const spots = [];\n  for (let y = 0; y < MH; y++) for (let x = 0; x < MW; x++) if (Math.abs(x - start.x) + Math.abs(y - start.y) >= 2 && !(x === goal.x && y === goal.y)) spots.push(roomId(x, y));\n  for (let i = 0; i < N_KEYS + N_STUBS; i++) items[spots.splice(r(spots.length), 1)[0]] = i < N_KEYS ? ITEM_KEY : ITEM_STUB;\n}\n\n/** Can the heart still be reached from (x, y) through doors that are closed or open (not locked)? */\nfunction canReach(x, y) {\n  const todo = [[x, y]], been = new Set([roomId(x, y)]);\n  while (todo.length) {\n    const [cx, cy] = todo.pop();\n    if (cx === goal.x && cy === goal.y) return true;\n    for (let d = 0; d < 4; d++) {\n      const st = getDoor(cx, cy, d), nx = cx + DX[d], ny = cy + DY[d];\n      if ((st === CLOSED || st === OPEN) && !been.has(roomId(nx, ny))) { been.add(roomId(nx, ny)); todo.push([nx, ny]); }\n    }\n  }\n  return false;\n}\n\n// ===================================================================================================================\n// A run (spec 5, 9).\n// ===================================================================================================================\n\n// The levels (spec 5): the candle's notches, and the questions' difficulty (and the points) are the level's number.\nconst LEVELS = [{ name: 'NOVICE', candle: 6 }, { name: 'SCHOLAR', candle: 5 }, { name: 'SAGE', candle: 5 }, { name: 'MASTER', candle: 4 }];\nlet level = 1;   // 1 to 4 (step 4 adds the choice of level and subject)\nlet subject = -1;   // an index into SUBJECTS, or -1 for ALL SUBJECTS\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, streak = 0, asked = new Set(), answered = 0, rightCount = 0, won = false;\nlet runSeed = 0, candle = 6, keys = 0, notice = '', noticeT = 0;\nlet phase = 'explore', sel = 0, cur = null, walkT = 0, walkTo = null;   // sel: the door chosen, as a direction (N, E, S, W)\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  QUESTIONS = loadQuestions();\n  if (dget(BANK_SLOT) !== QUESTIONS.length) {   // the bank has changed: what was asked before no longer lines up\n    for (let k = 0; k < SEEN_SLOTS; k++) dset(SEEN_SLOT + k, 0);\n    dset(BANK_SLOT, QUESTIONS.length);\n  }\n  ROOMS = rom('rooms');\n  // The layers (spec 12): BG2 the room and the panel (or the title), BG1 the furniture, BG0 the doors; the overlay's glass\n  // and the ghost (sprite palette 5) are see-through.\n  bg(2, { mx: 0, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: false, show: true });\n  bg(1, { mx: FUR_MX, my: 0, mw: 32, mh: 17, x: 0, y: 0, wrap: false, show: true });\n  bg(0, { mx: DOOR_MX, my: 0, mw: 32, mh: 17, x: 0, y: 0, wrap: false, show: true });\n  blend({ layers: ['overlay', 'spr'], half: true });\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\n\nfunction startGame() {\n  runSeed = rndi(1, 0x3fffffff); makeManor(runSeed);\n  me = { x: start.x, y: start.y, f: N }; seen = new Set([roomId(me.x, me.y)]);\n  candle = LEVELS[level - 1].candle; keys = 0; notice = ''; noticeT = 0;\n  score = 0; streak = 0; asked = new Set(); answered = 0; rightCount = 0; won = false;\n  phase = 'explore'; cur = null; sel = firstDoor(); paused = false; timer = 0; state = 'play';\n  play(SONG.play);\n}\n\n/** The door to choose first in a room: ahead if there is one, then right, left, behind. */\nfunction firstDoor() {\n  for (const k of [0, 1, 3, 2]) { const d = (me.f + k) % 4; if (getDoor(me.x, me.y, d) !== NONE) return d; }\n  return me.f;\n}\n\n/** Has question i been asked in an earlier run (or this one)? The bits are kept in the save (slots 40 to 59). */\nconst seenBefore = (i) => (dget(SEEN_SLOT + (i >> 5)) >>> (i & 31)) & 1;\nfunction markSeen(i, on) { const k = SEEN_SLOT + (i >> 5), b = 1 << (i & 31); dset(k, on ? dget(k) | b : dget(k) & ~b); }\n\n/** A question for the door (spec 6): of the run's subject (any, for ALL SUBJECTS) at the level's difficulty, not asked\n * yet in this run, and not asked in an earlier run where possible. When a difficulty runs dry, the nearest fills in. */\nfunction pickQuestion() {\n  const fits = (i) => subject < 0 || QUESTIONS[i].subj === subject;\n  let qi = -1;\n  for (let off = 0; off < 4 && qi < 0; off++) for (const dd of off ? [level - off, level + off] : [level]) {   // the level's difficulty, then the nearest\n    if (dd < 1 || dd > 4 || qi >= 0) continue;\n    const pool = QUESTIONS.map((_, i) => i).filter((i) => fits(i) && QUESTIONS[i].diff === dd && !asked.has(i));\n    if (!pool.length) continue;\n    let fresh = pool.filter((i) => !seenBefore(i));\n    if (!fresh.length) { pool.forEach((i) => markSeen(i, false)); fresh = pool; }   // all asked in earlier runs: that pool starts afresh\n    qi = fresh[rndi(0, fresh.length - 1)];\n  }\n  if (qi < 0) { asked.clear(); return pickQuestion(); }   // every question of the subject asked in this run: start again\n  asked.add(qi); markSeen(qi, true);\n  const order = [0, 1, 2, 3];\n  for (let i = 3; i > 0; i--) { const j = rndi(0, i); [order[i], order[j]] = [order[j], order[i]]; }\n  return { qi, order, sel: 0, door: sel, chosen: -1, right: false };\n}\n\nconst pointsFor = () => 100 * level + 25 * level * Math.min(streak, 4);\nconst winBonus = () => 1000 * level + 200 * level * candle;\nfunction say(s) { notice = s; noticeT = 150; }\n/** After a door locks or a key is used: if no way to the heart is left and you carry no key, a ghost gives you one. */\nfunction checkStuck() {\n  if (keys === 0 && !canReach(me.x, me.y)) { keys = 1; say(`${KINDS[kinds[roomId(me.x, me.y)]][1]} SLIPS YOU A KEY`); fx(SFX.key); }\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  else if (state === 'setup') updateSetup();\n  prevMask = inputMask;\n}\n\n// --- The title and the new game's choices (spec 10) ---\n\nconst titleItems = () => (hasRun() ? ['CONTINUE', 'NEW GAME', 'RECORDS'] : ['NEW GAME', 'RECORDS']);\nfunction updateTitle() {\n  const items = titleItems(), n = items.length;\n  if (titleSel >= n) titleSel = 0;\n  if (pressed(UP)) { titleSel = (titleSel + n - 1) % n; fx(SFX.move); }\n  if (pressed(DOWN)) { titleSel = (titleSel + 1) % n; fx(SFX.move); }\n  if (!(pressed(A) || pressed(START)) || timer < 10) return;\n  fx(SFX.select);\n  const it = items[titleSel];\n  if (it === 'CONTINUE') continueRun();\n  else if (it === 'NEW GAME') toSetup();\n  else { state = 'records'; hl = -1; timer = 0; }\n}\n\nlet setupRow = 0;\nfunction toSetup() {\n  const c = dget(CHOICE_SLOT);   // the last choice (0: none yet)\n  if (c) { subject = (c & 15) - 1; level = (c >> 4) & 15 || 1; } else { subject = -1; level = 1; }\n  state = 'setup'; setupRow = 0; timer = 0;\n}\n/** The new game: UP and DOWN choose the row (SUBJECT, LEVEL), LEFT and RIGHT change it, A begins, B goes back. */\nfunction updateSetup() {\n  if (pressed(UP) || pressed(DOWN)) { setupRow ^= 1; fx(SFX.move); }\n  const d = pressed(RIGHT) ? 1 : pressed(LEFT) ? -1 : 0;\n  if (d && setupRow === 0) { subject = ((subject + 1 + d + 9) % 9) - 1; fx(SFX.move); }\n  if (d && setupRow === 1) { level = ((level - 1 + d + 4) % 4) + 1; fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.pause); toTitle(); return; }\n  if (timer > 10 && (pressed(A) || pressed(START))) { fx(SFX.select); dset(CHOICE_SLOT, (subject + 1) | (level << 4)); startGame(); }\n}\n\n// --- The run in progress, saved while you explore and made again from it (CONTINUE) ---\n\nconst hasRun = () => dget(RUN_SLOT) === 1;\nfunction clearRun() { for (let k = 0; k < 15; k++) dset(RUN_SLOT + k, 0); }\n/** 21 flags a slot (so no slot's top bit is used): a set of room numbers 0 to 41 into two slots. */\nfunction packRooms(has, k) { let a = 0, b = 0; for (let r = 0; r < MW * MH; r++) if (has(r)) { if (r < 21) a |= 1 << r; else b |= 1 << (r - 21); } dset(k, a); dset(k + 1, b); }\nconst roomBit = (k, r) => (r < 21 ? dget(k) >> r : dget(k + 1) >> (r - 21)) & 1;\nfunction saveRun() {\n  dset(RUN_SLOT, 1); dset(RUN_SLOT + 1, runSeed);\n  dset(RUN_SLOT + 2, (subject + 1) | level << 4 | me.f << 8 | me.x << 12 | me.y << 16 | Math.min(candle, 15) << 20 | Math.min(keys, 15) << 24);\n  dset(RUN_SLOT + 3, score);\n  dset(RUN_SLOT + 4, Math.min(streak, 255) | Math.min(answered, 255) << 8 | Math.min(rightCount, 255) << 16);\n  const doors = [...doorsH, ...doorsV];\n  for (let k = 0; k < 5; k++) { let v = 0; for (let j = 0; j < 15; j++) v |= (doors[k * 15 + j] || 0) << (j * 2); dset(RUN_SLOT + 5 + k, v); }\n  packRooms((r) => seen.has(r), RUN_SLOT + 10);\n  packRooms((r) => items[r] !== ITEM_NONE, RUN_SLOT + 12);\n  // The question being asked, if one is (so quitting cannot skip it): its number + 1, its answers' order, its door, final.\n  const q = phase === 'ask' && cur ? (cur.qi + 1) | cur.order.reduce((v, a, i) => v | a << (12 + i * 2), 0) | cur.door << 20 | (cur.final ? 1 : 0) << 22 : 0;\n  dset(RUN_SLOT + 14, q);\n}\n/** CONTINUE: the manor made again from the seed, then the doors, rooms seen, items taken and the numbers put back. */\nfunction continueRun() {\n  runSeed = dget(RUN_SLOT + 1); makeManor(runSeed);\n  const v = dget(RUN_SLOT + 2), t = dget(RUN_SLOT + 4);\n  subject = (v & 15) - 1; level = (v >> 4) & 15; me = { f: (v >> 8) & 15, x: (v >> 12) & 15, y: (v >> 16) & 15 };\n  candle = (v >> 20) & 15; keys = (v >> 24) & 15; score = dget(RUN_SLOT + 3);\n  streak = t & 255; answered = (t >> 8) & 255; rightCount = (t >> 16) & 255;\n  const nH = doorsH.length;\n  for (let i = 0; i < nH + doorsV.length; i++) {\n    const d = (dget(RUN_SLOT + 5 + flr(i / 15)) >> ((i % 15) * 2)) & 3;\n    if (i < nH) doorsH[i] = d; else doorsV[i - nH] = d;\n  }\n  seen = new Set();\n  for (let r = 0; r < MW * MH; r++) { if (roomBit(RUN_SLOT + 10, r)) seen.add(r); if (!roomBit(RUN_SLOT + 12, r)) items[r] = ITEM_NONE; }\n  asked = new Set(); won = false; notice = ''; noticeT = 0; cur = null; paused = false; timer = 0; state = 'play'; phase = 'explore';\n  sel = firstDoor(); play(SONG.play);\n  const q = dget(RUN_SLOT + 14);\n  if (q) {   // back to the question that was being asked\n    cur = { qi: (q & 4095) - 1, order: [0, 1, 2, 3].map((i) => (q >> (12 + i * 2)) & 3), door: (q >> 20) & 3, final: !!((q >> 22) & 1), sel: 0, chosen: -1, right: false };\n    asked.add(cur.qi); phase = 'ask';\n  } else if (me.x === goal.x && me.y === goal.y) { cur = { ...pickQuestion(), final: true }; phase = 'ask'; }   // back to her last question\n}\n\nfunction updatePlay() {\n  if (pressed(START) && phase !== 'walk') { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (noticeT) noticeT--;\n  if (phase === 'explore') updateExplore();\n  else if (phase === 'ask') updateAsk();\n  else if (phase === 'confirm') updateConfirm();\n  if (state === 'play' && (phase === 'explore' || phase === 'ask')) saveRun();   // (unchanged slots are not written)\n  else if (phase === 'answered') updateAnswered();\n  else if (phase === 'walk') updateWalk();\n}\n\n/** Exploring: the d-pad chooses a door (UP ahead, RIGHT, DOWN behind, LEFT), A knocks or walks through. */\nfunction updateExplore() {\n  for (const [b, k] of [[UP, 0], [RIGHT, 1], [DOWN, 2], [LEFT, 3]]) {\n    if (!pressed(b)) continue;\n    const d = (me.f + k) % 4;\n    if (getDoor(me.x, me.y, d) !== NONE) { sel = d; fx(SFX.move); }\n  }\n  if (!pressed(A)) return;\n  const door = getDoor(me.x, me.y, sel);\n  if (door === OPEN) walk(sel);\n  else if (door === CLOSED) { cur = pickQuestion(); phase = 'ask'; timer = 0; fx(SFX.knock); fx(SFX.ghost); }\n  else if (door === LOCKED) {\n    if (keys) { phase = 'confirm'; timer = 0; fx(SFX.select); } else { say('LOCKED FOR GOOD'); fx(SFX.locked); }\n  }\n}\n\n/** A locked door, with a key in your pocket: A uses it, B does not. */\nfunction updateConfirm() {\n  if (pressed(B)) { phase = 'explore'; fx(SFX.move); return; }\n  if (!pressed(A) || timer < 6) return;\n  keys--; setDoor(me.x, me.y, sel, OPEN); checkStuck(); fx(SFX.key); walk(sel);\n}\n\n/** A question: UP and DOWN choose an answer, A answers, B uses a key instead (not on the heart's last question). */\nfunction updateAsk() {\n  if (pressed(UP)) { cur.sel = (cur.sel + 3) % 4; fx(SFX.move); }\n  if (pressed(DOWN)) { cur.sel = (cur.sel + 1) % 4; fx(SFX.move); }\n  if (timer < 10) return;\n  if (pressed(B) && cur.final) { cur.note = 'A KEY CANNOT ANSWER HER'; cur.noteT = 90; fx(SFX.locked); return; }\n  if (pressed(B)) {\n    if (!keys) { cur.note = 'YOU HAVE NO KEY'; cur.noteT = 90; fx(SFX.locked); return; }\n    keys--; asked.delete(cur.qi); setDoor(me.x, me.y, cur.door, OPEN); checkStuck(); fx(SFX.key);\n    const d = cur.door; cur = null; walk(d); return;\n  }\n  if (!pressed(A)) return;\n  cur.chosen = cur.sel; cur.right = cur.order[cur.sel] === 0; answered++;\n  if (cur.right) {\n    score += pointsFor(); streak++; rightCount++; fx(SFX.right);\n    if (cur.final) score += winBonus(); else setDoor(me.x, me.y, cur.door, OPEN);\n  } else {\n    streak = 0; candle--; fx(SFX.wrong); if (!cur.final) fx(SFX.locked);\n    if (!cur.final) { setDoor(me.x, me.y, cur.door, LOCKED); if (candle > 0) checkStuck(); }\n  }\n  phase = 'answered'; timer = 0;\n}\n\n/** The answer shown for a moment (the right one lit), then through the door, or back to the room; the run's end. */\nfunction updateAnswered() {\n  if (timer < 50 && !(timer > 15 && pressed(A))) return;\n  const { door, right, final } = cur;\n  cur = null; phase = 'explore';\n  if (final && right) { won = true; gameOver(); return; }\n  if (candle <= 0) { gameOver(); return; }\n  if (final) { cur = { ...pickQuestion(), final: true }; phase = 'ask'; timer = 0; return; }   // the heart asks again\n  if (right) walk(door); else sel = firstDoor();\n}\n\nfunction walk(d) { phase = 'walk'; walkT = 0; walkTo = d; fx(SFX.step); }\n/** Through the door: the screen dims, you are in the next room facing the way you walked, and it brightens. */\nfunction updateWalk() {\n  walkT++;\n  if (walkT === 12) {\n    me = { x: me.x + DX[walkTo], y: me.y + DY[walkTo], f: walkTo };\n    seen.add(roomId(me.x, me.y)); sel = firstDoor();\n    pickUp();\n  }\n  if (walkT >= 24) {\n    phase = 'explore'; brightness(15);\n    if (me.x === goal.x && me.y === goal.y) {   // the heart: its keeper's last question\n      cur = { ...pickQuestion(), final: true }; phase = 'ask'; timer = 0; fx(SFX.ghost);\n      say('LADY RIDDLEWICK HAS ONE LAST QUESTION');\n    }\n  } else brightness(Math.round(Math.abs(walkT - 12) * 15 / 12));\n}\n\n/** What lies in the room you walk into: a key (always taken), a candle stub (taken if the candle is not full). */\nfunction pickUp() {\n  const r = roomId(me.x, me.y), it = items[r];\n  if (it === ITEM_KEY) { keys++; items[r] = ITEM_NONE; say('YOU FIND A SKELETON KEY'); fx(SFX.key); }\n  else if (it === ITEM_STUB) {\n    if (candle < LEVELS[level - 1].candle) { candle++; items[r] = ITEM_NONE; say('A CANDLE STUB: YOUR CANDLE GROWS'); fx(SFX.stub); }\n    else say('A CANDLE STUB (YOUR CANDLE IS FULL)');\n  }\n}\n\nfunction gameOver() {\n  state = 'over'; timer = 0; play(-1); fx(won ? SFX.win : SFX.lose); brightness(15);\n  clearRun();\n  rank = insertTop({ score, initials: lastInitials(), level, subject });\n}\n\nfunction updateOver() {\n  if (timer < 60 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  state = 'records'; hl = rank; timer = 0;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nconst PAUSE_MENU = ['RESUME', 'QUIT TO TITLE'];\nfunction updatePause() {\n  if (pressed(UP) || pressed(DOWN)) { pauseSel ^= 1; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false; else toTitle();\n  }\n}\n\n// --- Draw ---\n\nconst VIEW_H = 136;   // the room's view: y 0 to 135; the panel below\nconst FUR_MX = 64, DOOR_MX = 96;   // where in Map RAM the furniture's (BG1) and the doors' (BG0) cells are written\nconst DOOR_PAL = [0, 3, 4, 5];     // a door's palette by its state: closed, open (a dark doorway), locked\nlet ROOMS = null, roomKind = -1;   // each kind's colours (rom/rooms.bin, made by art.py); the kind now loaded\nconst PARCH = { x: 7, y: 151, c: 10 };   // the map on the panel's parchment: its top left and a room's size\n\n/** Palette 1 (the room's) set to a kind's colours: 15 RGB555 values each. */\nfunction loadRoomColours(k) {\n  if (k === roomKind) return;\n  roomKind = k;\n  for (let i = 1; i < 16; i++) { const o = (k * 15 + i - 1) * 2, v = ROOMS[o] | (ROOMS[o + 1] << 8); color(16 + i, v & 31, (v >> 5) & 31, v >> 10); }\n}\n\n/** The room on the layers: its colours, its furniture either side of the back door (BG1), and its doors (BG0). */\nfunction renderRoom() {\n  loadRoomColours(kinds[roomId(me.x, me.y)]);\n  for (let y = 0; y < 17; y++) for (let x = 0; x < 32; x++) { mset(FUR_MX + x, y, 0); mset(DOOR_MX + x, y, 0); }\n  const k = kinds[roomId(me.x, me.y)];\n  for (let j = 0; j < 7; j++) for (let i = 0; i < 4; i++) {\n    const t = ART.tiles[`fur${k}_${i}_${j}`];\n    if (!t) continue;\n    mset(FUR_MX + 9 + i, 6 + j, tile(t, 2)); mset(FUR_MX + 22 - i, 6 + j, tile(t, 2, true));   // the right one mirrored\n  }\n  for (const rel of [0, 1, 3]) {\n    const st = getDoor(me.x, me.y, (me.f + rel) % 4);\n    if (st === NONE) continue;\n    if (rel === 0) {\n      for (let j = 0; j < 7; j++) for (let i = 0; i < 4; i++) { const t = ART.tiles[`door_back_${i}_${j}`]; if (t) mset(DOOR_MX + 14 + i, 6 + j, tile(t, DOOR_PAL[st])); }\n    } else {\n      for (let j = 0; j < 11; j++) for (let i = 0; i < 4; i++) {\n        const t = ART.tiles[`door_side_${i}_${j}`];\n        if (!t) continue;\n        if (rel === 3) mset(DOOR_MX + 2 + i, 5 + j, tile(t, DOOR_PAL[st])); else mset(DOOR_MX + 29 - i, 5 + j, tile(t, DOOR_PAL[st], true));\n      }\n    }\n  }\n}\n\nfunction draw() {\n  cls();\n  const inManor = state === 'play' || state === 'over';\n  bg(2, { mx: inManor ? 0 : ART.scenes.title.mx }); bg(1, { show: inManor }); bg(0, { show: inManor });\n  if (inManor) drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  else if (state === 'setup') drawSetup();\n  if (state === 'over') drawEnd();\n  if (paused) drawPause();\n}\n/** The night sky behind the title, a colour for each line; elsewhere the backdrop stays dark. */\nfunction scanline(y) { if (state === 'title' || state === 'setup' || state === 'records' || state === 'initials') gradientLine(ART.gradients.night, y); else if (y === 0) color(0, 1, 0, 2); }\n\nfunction drawPlay() {\n  renderRoom();\n  drawRoomSprites();\n  if (phase === 'ask' || phase === 'answered') drawQuestion(); else drawPanel();\n}\n\n// Where a door's things go, by where it is from you (0 ahead, 1 right, 2 behind, 3 left): its arrow, its padlock, its ghost.\nconst DOOR_SPOTS = [\n  { arrow: [120, 30], lock: [120, 66], ghost: [112, 38] },\n  { arrow: [217, 24], lock: [218, 74], ghost: [206, 44] },\n  { arrow: [120, 118], lock: [120, 118], ghost: [112, 48] },\n  { arrow: [23, 24], lock: [22, 74], ghost: [18, 44] },\n];\nconst PROP_DY = [-8, 6, -6, -5, -10, -7, -6, -4, -6, -8];   // each ghost's prop, from the ghost's top (a hat sits above, spectacles on the eyes)\n/** The sprites in the room: padlocks on locked doors, the gold arrow over the chosen door, and the ghost who is asking. */\nfunction drawRoomSprites() {\n  const S = ART.sprites, bob = Math.round(Math.sin(clock / 9) * 2);\n  for (const rel of [0, 1, 3]) {\n    if (getDoor(me.x, me.y, (me.f + rel) % 4) !== LOCKED) continue;\n    const [x, y] = DOOR_SPOTS[rel].lock; spr(S.padlock.tile, x - 8, y - 8, { size: 16, pal: S.padlock.pal, prio: 3 });\n  }\n  const back = getDoor(me.x, me.y, (me.f + 2) % 4), choosing = state === 'play' && (phase === 'explore' || phase === 'confirm');\n  if (back !== NONE && !(choosing && sel === (me.f + 2) % 4)) {   // the door behind you, when it is not chosen: a dim arrow at the bottom\n    const c = back === LOCKED ? RED : DIM;\n    for (let i = 0; i < 5; i++) line(128 - 5 + i, 124 + i, 128 + 5 - i, 124 + i, c);\n  }\n  if (choosing) {\n    const rel = (sel - me.f + 4) % 4, [x, y] = DOOR_SPOTS[rel].arrow;\n    spr(S.arrow.tile, x - 8, y - 8 + bob, { size: 16, pal: S.arrow.pal, prio: 3 });\n  }\n  if ((phase === 'ask' || phase === 'answered') && cur) {\n    const rel = (cur.door - me.f + 4) % 4, k = cur.final ? HEART : kinds[roomId(me.x, me.y)], f = flr(clock / 20) % 2;\n    const [x, y0] = DOOR_SPOTS[rel].ghost, y = y0 + bob;\n    spr(S[`ghost_top${f}`].tile, x, y, { size: 32, pal: 5, prio: 3 });\n    spr(S[`ghost_bot${f}`].tile, x, y + 32, { size: 32, pal: 5, prio: 3 });\n    const P = S[`prop${k}`]; spr(P.tile, x + 8, y + PROP_DY[k], { size: 16, pal: P.pal, prio: 3 });\n  }\n}\n\n/** The panel while exploring (on the desk): the map on its parchment, the room's name, the score, keys, the candle,\n * notices, and what A does. */\nfunction drawPanel() {\n  const C = ART.colors;\n  drawMap(PARCH.x, PARCH.y, PARCH.c);\n  txt(KINDS[kinds[roomId(me.x, me.y)]][0], 86, VIEW_H + 8, GOLD);\n  txt(`SCORE ${score}`, 86, VIEW_H + 22, C.CREAM);\n  for (let i = 0; i < keys; i++) spr(ART.sprites.key.tile, 86 + i * 10, VIEW_H + 36, { size: 8, pal: ART.sprites.key.pal, prio: 3 });\n  if (noticeT) wrap(notice, 17).slice(0, 3).forEach((l, i) => txt(l, 86, VIEW_H + 48 + i * 10, CYAN));\n  drawCandle(232, 214);\n  if (state !== 'play') return;\n  if (phase === 'confirm') { txt('USE A KEY?', 86, VIEW_H + 66, GOLD); txt('A: YES  B: NO', 86, VIEW_H + 76, GOLD); return; }\n  if (phase !== 'explore') return;\n  const st = getDoor(me.x, me.y, sel);\n  txt(st === OPEN ? 'A: GO THROUGH' : st === LOCKED ? (keys ? 'A: USE A KEY' : 'LOCKED') : 'A: KNOCK', 86, VIEW_H + 76, st === LOCKED && !keys ? RED : GOLD);\n}\n\n/** The candle: a brass holder, the wax as tall as the notches left (of the level's full candle), a flickering flame. */\nfunction drawCandle(cx, by) {\n  const C = ART.colors, S = ART.sprites, full = LEVELS[level - 1].candle, h = candle * 7;\n  spr(S.holder.tile, cx - 8, by - 10, { size: 16, pal: S.holder.pal, prio: 3 });\n  rect(cx - 4, by - 4 - full * 7, 8, full * 7, C.FADED);   // where the full candle reached\n  if (candle > 0) {\n    rectfill(cx - 3, by - 3 - h, 6, h, C.WAX); rectfill(cx + 1, by - 3 - h, 2, h, C.WAXSHADE);\n    for (let i = 1; i < candle; i++) pset(cx - 3, by - 3 - i * 7, C.WAXSHADE);   // its notches\n    const F = S[`flame${flr(clock / 7) % 2}`]; spr(F.tile, cx - 4, by - 11 - h, { size: 8, pal: F.pal, prio: 3 });\n  }\n}\n\n/** The map, in ink on the parchment: the rooms you have seen, their doors (open: a gap; locked: a red seal; closed: a\n * line), the heart (gold), and you (a red dot and a tick the way you face). */\nfunction drawMap(x0, y0, c) {\n  const C = ART.colors;\n  for (let y = 0; y < MH; y++) for (let x = 0; x < MW; x++) {\n    const px = x0 + x * c, py = y0 + y * c, isGoal = x === goal.x && y === goal.y;\n    if (!seen.has(roomId(x, y)) && !isGoal) continue;\n    if (isGoal) rectfill(px + 1, py + 1, c - 2, c - 2, C.GOLD);\n    rect(px, py, c, c, isGoal && !seen.has(roomId(x, y)) ? C.FADED : C.INK);\n    for (let d = 0; d < 4; d++) {\n      const st = getDoor(x, y, d);\n      if (st === NONE) continue;\n      const mx = px + c / 2 + DX[d] * (c / 2), my = py + c / 2 + DY[d] * (c / 2), horiz = d === N || d === S;\n      const col = st === OPEN ? C.CREAM : st === LOCKED ? C.SEAL : C.FADED;\n      if (horiz) rectfill(mx - 2, my, 4, 1, col); else rectfill(mx, my - 2, 1, 4, col);\n    }\n  }\n  const mx = x0 + me.x * c + c / 2, my = y0 + me.y * c + c / 2;\n  rectfill(mx - 1, my - 1, 3, 3, C.SEAL); line(mx, my, mx + DX[me.f] * 4, my + DY[me.f] * 4, C.SEAL);\n}\n\n/** A question: who asks, the question, and the four answers, one lit (the ghost is a sprite, at its door). */\nfunction drawQuestion() {\n  const q = QUESTIONS[cur.qi], kind = kinds[roomId(me.x, me.y)];\n  panel(0, 112, 256, 112);\n  if (phase === 'ask' && cur.noteT > 0) { txt(cur.note, 8, 117, RED); cur.noteT--; }   // (a key that cannot be used here)\n  else if (phase === 'ask') txt(cur.final ? 'LADY RIDDLEWICK ASKS:' : `${KINDS[kind][1]} ASKS:`, 8, 117, cur.final ? GOLD : CYAN);\n  if (phase === 'ask' && keys && !cur.final) txt(`B: KEY (${keys})`, 248 - 8 * (8 + String(keys).length), 117, DIM);\n  wrap(q.q, Q_LINE).forEach((l, i) => txt(l, 8, 130 + i * 11, WHITE));\n  cur.order.forEach((a, i) => {\n    const y = 167 + i * 13, isRight = a === 0;\n    let c = i === cur.sel ? GOLD : WHITE;\n    if (phase === 'answered') c = isRight ? GREEN : i === cur.chosen ? RED : DIM;\n    if (phase === 'ask' && i === cur.sel) rectfill(4, y - 3, 248, 12, PANEL);\n    txt(`${'ABCD'[i]}  ${q.ans[a]}`, 12, y, c);\n  });\n  if (phase === 'answered') {\n    const msg = cur.right ? (cur.final ? 'RIGHT! THE MANOR IS YOURS' : 'RIGHT! THE DOOR OPENS') : candle <= 0 ? 'WRONG! YOUR CANDLE GOES OUT' : cur.final ? 'WRONG! YOUR CANDLE BURNS' : 'WRONG! THE DOOR LOCKS';\n    txt(msg, 8, 117, cur.right ? GREEN : RED);\n  }\n}\n\nfunction drawEnd() {\n  panel(24, 72, 208, 72);\n  ctxt(won ? 'YOU FOUND THE HEART' : 'YOUR CANDLE HAS GONE OUT', 80, won ? GOLD : RED);\n  ctxt(`SCORE ${score}`, 98, WHITE);\n  ctxt(`${rightCount} OF ${answered} ANSWERED RIGHT`, 112, DIM);\n  if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 128, DIM);\n}\n\n/** The title: the manor at night (BG2) with the name; the menu in a glass panel below it, and a saved run's line. */\nfunction drawTitle() {\n  const items = titleItems(), h = items.length * 11 + (hasRun() ? 14 : 4);\n  panel(56, 222 - h - 4, 144, h + 4, true);\n  items.forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 72, 222 - h + i * 11, i === titleSel ? WHITE : DIM));\n  if (hasRun()) {\n    const v = dget(RUN_SLOT + 2);\n    ctxt(`${['ALL', 'HIS', 'GEO', 'SCI', 'NAT', 'ART', 'MUS', 'SPO', 'FOO'][v & 15]} L${(v >> 4) & 15}  ${dget(RUN_SLOT + 3)}`, 222 - h + items.length * 11 + 2, ART.colors.FADED);\n  }\n}\n\nconst LEVEL_NOTES = ['CANDLE 6, EASY QUESTIONS', 'CANDLE 5, FAIR QUESTIONS', 'CANDLE 5, HARD QUESTIONS', 'CANDLE 4, EXPERT QUESTIONS'];\nfunction drawSetup() {\n  panel(16, 58, 224, 160);   // below the name on the title\n  ctxt('A NEW GAME', 66, GOLD);\n  [['SUBJECT', subject < 0 ? 'ALL SUBJECTS' : SUBJECTS[subject]], ['LEVEL', `${level} ${LEVELS[level - 1].name}`]].forEach(([k, v], i) => {\n    const y = 92 + i * 30, on = i === setupRow;\n    txt(k, 28, y, on ? WHITE : DIM);\n    txt(on ? `< ${v} >` : `  ${v}`, 28, y + 12, on ? GOLD : WHITE);\n  });\n  ctxt(LEVEL_NOTES[level - 1], 160, DIM);\n  if (hasRun()) ctxt('REPLACES YOUR SAVED GAME', 176, RED);\n  ctxt('A: BEGIN   B: BACK', 200, DIM);\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    txt(e.score ? String(e.score).padStart(6) : '', 104, y, i === 0 ? GOLD : WHITE);\n    if (e.score && e.level) txt(`L${e.level} ${['ALL', 'HIS', 'GEO', 'SCI', 'NAT', 'ART', 'MUS', 'SPO', 'FOO'][e.subject + 1]}`, 168, y, DIM);\n  });\n  if (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(String(score), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 54);\n  ctxt('PAUSED', 88, GOLD);\n  PAUSE_MENU.forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 106 + i * 12, i === pauseSel ? WHITE : DIM));\n}\n\n/** A panel: solid, or see-through glass (`glass`) where the picture behind is dark (the title's menu, over the night). */\nfunction panel(x, y, w, h, glass = false) { rectfill(x, y, w, h, glass ? ART.colors.GLASS : ART.colors.SHEET); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

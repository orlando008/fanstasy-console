{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Neon Drift",
    "author": "NOVA-16",
    "description": "You are a glowing diamond flying down a neon wormhole to a trance beat. Lights ride the tunnel towards you in time with the music: glide round the rim to catch each one on the beat, build a combo and watch the rings flow with the kick. Five original tracks, three levels, no game over."
  },
  "label": null,
  "code": "// Neon Drift (docs/carts/neon-drift.md)\n// A diamond on the rim of a neon wormhole; lights ride the tunnel to the rim on the beat of a trance track, and the player glides the\n// diamond round the rim to be under each one as it arrives. The music is the clock: a chart (rom/charts.bin, written by audio.py from the\n// same notes as the song) says on which frame each light reaches the rim and where. The tunnel is one picture on BG2, zoomed by one ring\n// step a beat and rolled by one affine matrix a frame; its rings' colours are set each frame from their radius on the screen.\n\n// --- Colours: the default palette's overlay colours (the overlay's index 0 is transparent) ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, ORANGE = 9, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"burst0\": {\"pal\": 6, \"size\": 32, \"tile\": 652}, \"burst1\": {\"pal\": 6, \"size\": 32, \"tile\": 704}, \"burst2\": {\"pal\": 6, \"size\": 32, \"tile\": 708}, \"burst3\": {\"pal\": 6, \"size\": 32, \"tile\": 712}, \"gem0\": {\"pal\": 0, \"size\": 32, \"tile\": 512}, \"gem1\": {\"pal\": 0, \"size\": 32, \"tile\": 516}, \"gem2\": {\"pal\": 0, \"size\": 32, \"tile\": 520}, \"gem3\": {\"pal\": 0, \"size\": 32, \"tile\": 524}, \"gem4\": {\"pal\": 0, \"size\": 32, \"tile\": 576}, \"gem5\": {\"pal\": 0, \"size\": 32, \"tile\": 580}, \"gem6\": {\"pal\": 0, \"size\": 32, \"tile\": 584}, \"gem7\": {\"pal\": 0, \"size\": 32, \"tile\": 588}, \"gem8\": {\"pal\": 0, \"size\": 32, \"tile\": 640}, \"halo\": {\"pal\": 5, \"size\": 32, \"tile\": 644}, \"light16\": {\"pal\": 4, \"size\": 16, \"tile\": 482}, \"light32\": {\"pal\": 4, \"size\": 32, \"tile\": 648}, \"light8\": {\"pal\": 4, \"size\": 8, \"tile\": 480}, \"spark\": {\"pal\": 6, \"size\": 8, \"tile\": 481}},\n  scenes: {\"logo\": {\"h\": 6, \"mx\": 96, \"my\": 0, \"pal\": 3, \"w\": 32}, \"space\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 2, \"w\": 32}, \"tunnel\": {\"h\": 64, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 64}},\n  colors: {\"GLASS\": 200},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y); opts as for spr (fx, fy, prio ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5): songs on channels 0 to 5, effects take turns on 6 and 7 ---\n\nconst SFX = { move: 0, select: 1, pause: 2, locked: 3, up2: 4, up3: 5, up4: 6, fanfare: 7, fanfareLow: 8, record: 9, tick: 10, count: 11, go: 12, catch: 13 };\nconst SONG = { title: 0 };                                          // track i is song i + 1\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1, songAt = 0;                                       // the song playing and the frame (clock) it started\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; songAt = clock; music(song);\n}\n\n// --- Save slots (spec section 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, LAG_SLOT = 1, OPEN_SLOT = 2, BEST_SLOT = 10;\nconst bestSlot = (track, level) => BEST_SLOT + (track * 3 + level) * 2;     // the score; the grade (0 none, 1 D to 5 S) and the best combo << 4\n\n// --- Input: edge-triggered presses ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst held = (b) => (inputMask & (1 << b)) !== 0;\n\n// --- The rules (spec section 5) ---\n\nconst CX = 128, CY = 112, RIM = 94, RHO = 1.6;                    // the vanishing point, the rim's radius, the ring step (a beat's zoom)\nconst LOOKAHEAD = 120, RESUME_LEAD = 90;                            // frames: how far ahead a light shows; the count-in after a pause\nconst VMAX = 3.2, ACC = 0.4, BRAKE = 0.8, DEC = 0.12;               // the diamond: top speed (angle units a frame, 256 a turn), speeding up, braking (the other way held), the drift's easing off (nothing held)\nconst WIN = [8, 16, 24], PTS = [100, 70, 40], JUDGE = ['PERFECT', 'GOOD', 'OK'], JUDGE_C = [GOLD, GREEN, CYAN];\nconst MULT_AT = [10, 20, 40];                                       // the combo for x2, x3, x4\nconst GRADES = ['D', 'C', 'B', 'A', 'S'], GRADE_C = [DIM, ORANGE, CYAN, GREEN, GOLD];\nconst LEVELS = ['CHILL', 'DRIVE', 'OVERDRIVE'];\nconst FOLLOWS = ['THE KICK', 'KICK AND OFFBEAT', 'THE ARPEGGIO'];\nconst TRACKS = ['EVENT HORIZON', 'STARLIGHT RUN', 'AURORA', 'PULSAR', 'SUPERNOVA'];\n// Each track's colours (5-bit RGB): the rim's (near) and the hole's (far); and the space behind.\nconst LOOKS = [\n  { near: [8, 28, 31], far: [20, 6, 28], back: [1, 0, 4] },\n  { near: [31, 12, 24], far: [6, 10, 30], back: [2, 0, 5] },\n  { near: [6, 31, 18], far: [4, 14, 26], back: [0, 2, 4] },\n  { near: [31, 20, 4], far: [28, 4, 20], back: [3, 0, 2] },\n  { near: [31, 30, 22], far: [30, 18, 4], back: [2, 1, 0] },\n];\n\nconst wrap = (a) => ((a % 256) + 256) % 256;\nconst gap = (a, b) => ((((a - b) % 256) + 384) % 256) - 128;        // the signed shortest way round from b to a\nconst multiplier = () => (combo >= MULT_AT[2] ? 4 : combo >= MULT_AT[1] ? 3 : combo >= MULT_AT[0] ? 2 : 1);\nconst multOf = (c) => (c >= MULT_AT[2] ? 4 : c >= MULT_AT[1] ? 3 : c >= MULT_AT[0] ? 2 : 1);\n\n/** A track's chart for a level, from the ROM: { speed, sections: [{ f, kind }], lights: [{ f, a, p, r }] } (r: 0 coming, 1-3 the judgement, 4 missed, 5 skipped). */\nfunction loadChart(i, level) {\n  const b = rom('charts'), off = b[1 + 2 * i] | (b[2 + 2 * i] << 8);\n  let o = off + 2;\n  const speed = b[off], sections = [];\n  for (let k = 0; k < b[off + 1]; k++, o += 3) sections.push({ f: b[o] | (b[o + 1] << 8), kind: b[o + 2] });\n  let lights = [];\n  for (let lv = 0; lv < 3; lv++) {\n    const n = b[o] | (b[o + 1] << 8); o += 2;\n    const list = [];\n    for (let k = 0; k < n; k++, o += 4) list.push({ f: b[o] | (b[o + 1] << 8), a: b[o + 2], p: b[o + 3], r: 0 });\n    if (lv === level) lights = list;\n  }\n  return { speed, sections, lights };\n}\nconst trackCount = () => rom('charts')[0];\n\n/** The diamond, one frame: LEFT and RIGHT glide it round the rim (RIGHT adds to the angle: from the bottom, to the right); let go and it drifts on,\n * slowing gently; the other way brakes. */\nfunction steer() {\n  const dir = (held(RIGHT) ? 1 : 0) - (held(LEFT) ? 1 : 0);\n  if (dir === 0) v = Math.abs(v) <= DEC ? 0 : v - Math.sign(v) * DEC;\n  else if (v * dir < 0) v += dir * BRAKE;\n  else v = clamp(v + dir * ACC, -VMAX, VMAX);\n  dia = wrap(dia + v);\n}\n\n/** A light on the rim now: judged by how far round the diamond is from it. */\nfunction arrive(l) {\n  const d = Math.abs(gap(l.a, dia));\n  const g = d <= WIN[0] ? 0 : d <= WIN[1] ? 1 : d <= WIN[2] ? 2 : 3;\n  if (g === 3) { l.r = 4; counts[3]++; if (combo >= MULT_AT[0]) banner('COMBO LOST', RED); combo = 0; lastMult = 1; show('MISS', RED); return; }   // no sound: the screen says it\n  l.r = g + 1; counts[g]++; combo++; bestCombo = Math.max(bestCombo, combo);\n  const m = multiplier();\n  score += PTS[g] * m;\n  show(JUDGE[g], JUDGE_C[g]); fx(SFX.catch + (l.p % 12));\n  const th = (dia + roll) * Math.PI / 128;\n  bursts.push({ x: CX + RIM * Math.sin(th), y: CY + RIM * Math.cos(th), at: clock, g });\n  if (m > lastMult) { banner('X' + m, [WHITE, CYAN, GREEN, GOLD][m - 1]); fx(m === 2 ? SFX.up2 : m === 3 ? SFX.up3 : SFX.up4); }\n  lastMult = m;\n  if (combo % 50 === 0) banner(`${combo} COMBO`, GOLD);\n}\nfunction banner(text, c) { bannerText = text; bannerColour = c; bannerAt = clock; }\nfunction show(text, c) { judgeText = text; judgeColour = c; judgeAt = clock; }\nconst caught = () => counts[0] + counts[1] + counts[2];\nconst accuracy = () => { const n = caught() + counts[3]; return n ? caught() / n : 0; };\n/** The grade from the share of the track's best possible score (S also needs no miss). */\nconst gradeOf = () => { const s = maxScore ? score / maxScore : 0; return s >= 0.9 && !counts[3] ? 4 : s >= 0.8 ? 3 : s >= 0.65 ? 2 : s >= 0.5 ? 1 : 0; };\n\n// --- State ---\n\nlet skipTitle = false;                                              // tests set this to land straight in a track\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, sel = 0, selLevel = 0, msg = '', msgAt = -999, opened = 0, savedLag = 0, cal = null;\nlet track = 0, level = 0, lights = [], sections = [], speed = 7, beat = 28, tm = 0, musicAt = 0, started = false, lag = 0;\nlet dia = 0, v = 0, roll = 0, rollV = 0, kick = 0, look = LOOKS[0], maxScore = 0, endAt = 0, newBest = false, songEnd = 0;\nlet score = 0, combo = 0, bestCombo = 0, lastMult = 1, counts = [0, 0, 0, 0], bursts = [], trail = [];\nlet judgeText = '', judgeColour = WHITE, judgeAt = -99, bannerText = '', bannerColour = WHITE, bannerAt = -99;\nconst st = () => tm - lag;                                          // the song time the player hears now\nconst openN = () => Math.max(1, dget(OPEN_SLOT));\nconst isOpen = (i) => i < openN();\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) {                        // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  lag = dget(LAG_SLOT) ? dget(LAG_SLOT) - 16 : 0;\n  const tn = ART.scenes.tunnel, sp = ART.scenes.space, lg = ART.scenes.logo;\n  bg(2, { mx: tn.mx, my: tn.my, mw: tn.w, mh: tn.h, x: CX, y: 256 - CY, wrap: false, show: true });\n  bg(1, { mx: sp.mx, my: sp.my, mw: sp.w, mh: sp.h, x: 0, y: 0, wrap: false, show: true });\n  bg(0, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -40, wrap: false, show: false });\n  if (skipTitle) startTrack(0, 1); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; look = LOOKS[0]; play(SONG.title); }\nfunction toTracks(s = sel) {\n  state = 'tracks'; timer = 0; paused = false; sel = s; play(SONG.title);\n  if (opened) { sel = opened; msg = 'A NEW TRACK IS OPEN'; msgAt = clock; opened = 0; fx(SFX.up3); }\n  look = LOOKS[sel];\n}\n\n/** A track from its start: the count-in (a bar), then the music when song time reaches 0. */\nfunction startTrack(i, lv) {\n  track = i; level = lv; look = LOOKS[i];\n  const c = loadChart(i, lv); lights = c.lights; sections = c.sections; speed = c.speed; beat = 4 * speed;\n  maxScore = 0; for (let k = 1; k <= lights.length; k++) maxScore += PTS[0] * multOf(k);\n  songEnd = (lights.length ? lights[lights.length - 1].f : 0) + 4 * beat;\n  dia = 0; v = 0; roll = 0; rollV = 0; trail = []; bursts = [];\n  score = 0; combo = 0; bestCombo = 0; lastMult = 1; counts = [0, 0, 0, 0]; judgeAt = -99; bannerAt = -99; newBest = false;\n  tm = -4 * beat; musicAt = 0; started = false; endAt = 0; paused = false; timer = 0; state = 'play'; play(-1);\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'tracks') updateTracks();\n  else if (state === 'play') updatePlay();\n  else if (state === 'calib') updateCalib();\n  else if (state === 'results') updateResults();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) toTracks(); else { state = 'records'; timer = 0; }\n  }\n}\n\n/** The track list: LEFT and RIGHT choose a track, UP and DOWN the level, A plays (the first time, the calibration comes first), SELECT the calibration, B the title. */\nfunction updateTracks() {\n  const n = trackCount(), before = sel;\n  if (pressed(LEFT)) sel = (sel + n - 1) % n;\n  if (pressed(RIGHT)) sel = (sel + 1) % n;\n  if (before !== sel) { fx(SFX.move); msg = ''; look = LOOKS[sel]; }\n  if (pressed(UP)) { selLevel = (selLevel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { selLevel = (selLevel + 1) % 3; fx(SFX.move); }\n  if (pressed(B)) { fx(SFX.move); toTitle(); }\n  else if (pressed(SELECT)) { fx(SFX.select); startCalib(false); }\n  else if (pressed(A) || pressed(START)) {\n    if (!isOpen(sel)) { msg = 'FINISH THE TRACK BEFORE IT'; msgAt = clock; fx(SFX.locked); return; }\n    fx(SFX.select);\n    if (!dget(LAG_SLOT)) startCalib(true); else startTrack(sel, selLevel);\n  }\n}\n\n// --- The calibration (spec 5.6): a tick on a steady beat and a light coming to the diamond on it; press A in time. The median of\n// how late the presses are is the offset in frames (-15 to 15), kept in save slot 1 as the value + 16. During it `lag` is 0.\n\nconst CAL_BEATS = 16, CAL_GAP = 32, CAL_FIRST = 120, CAL_NEED = 6;\nfunction startCalib(then) {\n  savedLag = lag; lag = 0; state = 'calib'; timer = 0; play(-1); paused = false; look = LOOKS[0];\n  lights = []; for (let k = 0; k < CAL_BEATS; k++) lights.push({ f: CAL_FIRST + k * CAL_GAP, a: 0, p: 0, r: 0 });\n  beat = CAL_GAP; tm = 0; dia = 0; v = 0; roll = 0; rollV = 0; bursts = []; trail = [];\n  cal = { errs: [], then, stage: 'tap', off: 0 };\n}\nfunction updateCalib() {\n  if (cal.stage === 'tap') {\n    tm++;\n    for (const l of lights) if (l.f === tm) fx(SFX.tick);\n    if (pressed(A)) {\n      let best = null;\n      for (const l of lights) if (!l.r && Math.abs(l.f - tm) <= 16 && (!best || Math.abs(l.f - tm) < Math.abs(best.f - tm))) best = l;\n      if (best) { best.r = 1; cal.errs.push(tm - best.f); bursts.push({ x: CX, y: CY + RIM, at: clock, g: 0 }); }\n    }\n    if (pressed(B)) endCalib(false);\n    else if (tm > lights[lights.length - 1].f + 30 || cal.errs.length >= 14) {\n      const e = cal.errs.slice(2).sort((x, y) => x - y);            // the first two presses are the player settling in\n      if (e.length < CAL_NEED) cal.stage = 'fail'; else { cal.off = clamp(e[e.length >> 1], -15, 15); cal.stage = 'done'; }\n    }\n  } else {\n    if (cal.stage === 'done') { if (pressed(LEFT)) cal.off = Math.max(-15, cal.off - 1); if (pressed(RIGHT)) cal.off = Math.min(15, cal.off + 1); }\n    if (pressed(START)) { fx(SFX.select); startCalib(cal.then); }\n    else if (pressed(B)) endCalib(false);\n    else if (pressed(A) && cal.stage === 'done') endCalib(true);\n  }\n}\n/** Leave the calibration: keep the offset (save it) or not; the first time, leaving it also stops it being offered again. */\nfunction endCalib(save) {\n  fx(SFX.select);\n  if (save) { lag = cal.off; dset(LAG_SLOT, lag + 16); } else { lag = savedLag; if (!dget(LAG_SLOT)) dset(LAG_SLOT, 16); }\n  const then = cal.then; cal = null;\n  if (then) startTrack(sel, selLevel); else toTracks();\n}\n\n/** The section of the song at song time f. */\nfunction sectionAt(f) { let s = sections[0]; for (const x of sections) if (x.f <= f) s = x; return s; }\nconst KIND_ROLL = [0.05, 0.1, 0.12, 0.22, 0.06, 0.16, 0.05];       // how fast the tunnel rolls in each kind of section (intro, groove, build, drop, break, rise, outro)\nconst HAS_KICK = [1, 1, 1, 1, 0, 0, 1];\n\n/** One frame of a track: the clock, the music's start, the diamond, the lights that arrive, the roll, the end. */\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); music(-1); playing = -1; return; }\n  const r = tm - musicAt;                                           // the count-in: a tick on each beat of the bar before, GO as the music starts\n  if (r <= 0 && r >= -3 * beat && r % beat === 0) fx(r ? SFX.count : SFX.go);\n  tm++;\n  if (!started && tm >= musicAt) { started = true; playing = track + 1; music(track + 1, musicAt / (64 * speed)); }\n  steer();\n  const now = st();\n  for (const l of lights) if (!l.r && l.f <= now) arrive(l);\n  if (sections.length) {\n    const s = sectionAt(Math.max(0, now)), k = sections.indexOf(s);\n    rollV += ((k % 2 ? -1 : 1) * KIND_ROLL[s.kind] - rollV) * 0.02;\n    roll += rollV;\n    if (HAS_KICK[s.kind] && now >= 0 && now % beat === 0) kick = 1;\n  }\n  kick *= 0.85;\n  trail.unshift(dia); if (trail.length > 8) trail.pop();\n  if (!endAt && now > songEnd && lights.every((l) => l.r)) endAt = clock;\n  if (endAt && clock > endAt + 60) finish();\n}\n\nfunction finish() {\n  endAt = 0; state = 'results'; timer = 0;\n  const g = gradeOf(), s = bestSlot(track, level);\n  newBest = score > dget(s);\n  if (newBest) { dset(s, score); dset(s + 1, (g + 1) | (bestCombo << 4)); }\n  if (track + 1 < trackCount() && openN() < track + 2) { dset(OPEN_SLOT, track + 2); opened = track + 1; }   // a track played to the end opens the next\n  fx(g >= 3 ? SFX.fanfare : SFX.fanfareLow);\n}\n\nfunction updateResults() {\n  if (timer === 40 && newBest) fx(SFX.record);\n  if (timer > 30 && (pressed(A) || pressed(START))) { fx(SFX.select); toTracks(track); }\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\n/** Resume starts the music again at the start of the pattern the track was in, after a count-in: lights whose time went by are skipped. */\nfunction resume() {\n  paused = false;\n  const pat = Math.floor(Math.max(0, tm) / (64 * speed));\n  musicAt = pat * 64 * speed; tm = musicAt - RESUME_LEAD; started = false; fx(SFX.count);\n  for (const l of lights) if (!l.r && l.f < musicAt + 2 * beat) l.r = 5;\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { fx(SFX.pause); resume(); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) resume();\n    else if (pauseSel === 1) startTrack(track, level);\n    else toTracks(track);\n  }\n}\n\n// --- Draw ---\n\n// The tunnel: the picture's rings are at RING0 / RHO^k (art.py); zoomed by s = RHO^phase, where phase is the part of the beat gone by, the\n// rings move out by one ring step a beat and the picture is the same when the phase wraps. Band k (a ring and the rails inside it) has two\n// CGRAM entries, a line and a glow, set here from the ring's radius on the screen: dark in the hole, bright at the rim.\nconst RING0 = 160, RINGS = 7, LINE0 = 17, GLOW0 = 24, HAZE0 = 36;\nlet tunnelBright = 1;\nfunction drawTunnel(phase, rollAngle, bright) {\n  const s = Math.pow(RHO, phase) * (1 + 0.03 * kick) * RIM / 100, th = rollAngle * Math.PI / 128, c = Math.cos(th) / s, n = Math.sin(th) / s;\n  affine({ a: c, b: -n, c: n, d: c, cx: 256, cy: 256 });\n  for (let k = 0; k < RINGS; k++) {\n    const r = RING0 / Math.pow(RHO, k) * s;\n    let b = r <= RIM ? 0.12 + 0.88 * Math.pow(clamp((r - 8) / (RIM - 8), 0, 1), 0.9) : 1 - Math.min(0.35, (r - RIM) / 300);\n    b *= bright * (0.8 + 0.35 * kick);\n    const t = clamp(r / RIM, 0, 1), col = [0, 1, 2].map((i) => lerp(look.far[i], look.near[i], t));\n    color(LINE0 + k, clamp(col[0] * b, 0, 31), clamp(col[1] * b, 0, 31), clamp(col[2] * b, 0, 31));\n    color(GLOW0 + k, clamp(col[0] * b * 0.32, 0, 31), clamp(col[1] * b * 0.32, 0, 31), clamp(col[2] * b * 0.32, 0, 31));\n  }\n  color(0, look.back[0], look.back[1], look.back[2]);\n  for (let i = 0; i < 4; i++) { const k = (0.18 + 0.16 * i) * bright; color(HAZE0 + i, look.far[0] * k + look.back[0], look.far[1] * k + look.back[1], look.far[2] * k + look.back[2]); }   // the light at the end of the tunnel, in the track's far colour\n}\n\n/** Where a light at angle a, f frames before it reaches the rim, is on the screen: its radius shrinks a ring step each beat further away. */\nfunction place(a, f) {\n  const r = RIM * Math.pow(RHO, -f / beat), th = (a + roll) * Math.PI / 128;\n  return { x: CX + r * Math.sin(th), y: CY + r * Math.cos(th), r };\n}\n\nfunction drawLights(now) {\n  for (const l of lights) {\n    const f = l.f - now;\n    if (f > LOOKAHEAD || f < -12 || (l.r && l.r !== 4)) continue;\n    const p = place(l.a, f); l.x = p.x; l.y = p.y;\n    if (l.r === 4 && clock % 2) continue;                           // a missed light falls past, blinking\n    const sp = p.r < 30 ? ART.sprites.light8 : p.r < 62 ? ART.sprites.light16 : ART.sprites.light32;\n    sprite(sp, flr(p.x - sp.size / 2), flr(p.y - sp.size / 2), { prio: 2 });\n  }\n}\n\n/** The diamond's sprite for its place on the rim: its long axis along the rim (9 turns drawn, the rest flipped). */\nfunction drawDiamond() {\n  const th = (dia + roll) * Math.PI / 128, x = CX + RIM * Math.sin(th), y = CY + RIM * Math.cos(th);\n  let t = ((-th % Math.PI) + Math.PI) % Math.PI, flip = false;\n  if (t > Math.PI / 2) { t = Math.PI - t; flip = true; }\n  const k = Math.round(t / (Math.PI / 16));\n  sprite(ART.sprites['gem' + k], flr(x - 16), flr(y - 16), { fx: flip, prio: 3 });\n  sprite(ART.sprites.halo, flr(x - 16), flr(y - 16), { prio: 2 });\n  for (let i = 3; i < trail.length; i += 2) {                       // the afterimage when it moves fast\n    if (Math.abs(gap(trail[i], dia)) < 6) continue;\n    const u = (trail[i] + roll) * Math.PI / 128;\n    sprite(ART.sprites.light8, flr(CX + RIM * Math.sin(u) - 4), flr(CY + RIM * Math.cos(u) - 4), { pal: 5, prio: 2 });\n  }\n  return { x, y };\n}\n\nfunction drawBursts() {\n  bursts = bursts.filter((b) => clock - b.at < 16);\n  for (const b of bursts) {\n    const a = clock - b.at;\n    sprite(ART.sprites['burst' + Math.min(3, a >> 2)], flr(b.x - 16), flr(b.y - 16), { prio: 3 });\n    if (b.g === 0) for (let k = 0; k < 6; k++) {\n      const u = k * Math.PI / 3 + b.at, d = 6 + a * 1.6;\n      sprite(ART.sprites.spark, flr(b.x + d * Math.cos(u) - 4), flr(b.y + d * Math.sin(u) - 4), { prio: 3 });\n    }\n  }\n}\n\nfunction draw() {\n  cls();\n  const inPlay = (state === 'play' || state === 'calib') && !paused;\n  blend(inPlay ? { layers: ['overlay', 'spr'], op: 'add' } : { layers: ['overlay'], half: true });   // in play the glows add their light; in the menus the panels mix\n  bg(0, { show: state === 'title' });\n  if (state === 'play' || state === 'calib') {\n    const now = state === 'calib' ? tm : st();\n    drawTunnel(((now % beat) + beat) % beat / beat, roll, state === 'play' && !started ? 0.7 : 1);\n    drawLights(now); drawDiamond(); drawBursts();\n    if (state === 'play') drawHud(); else drawCalib();\n  } else {\n    const b = 28, f = clock - songAt;                               // the menus: the tunnel flows to the title song (speed 7, a beat of 28 frames)\n    if (f % b === 0) kick = 1; kick *= 0.9;\n    roll += 0.06;\n    drawTunnel((f % b) / b, roll, state === 'results' ? 0.45 : 0.7);\n    if (state === 'title') drawTitle();\n    else if (state === 'tracks') drawTracks();\n    else if (state === 'results') drawResults();\n    else if (state === 'records') drawRecords();\n  }\n  if (paused) drawPause();\n}\n\nfunction drawHud() {\n  txt(String(score).padStart(7, '0'), 8, 6, WHITE);\n  const m = multiplier();\n  txt('X' + m, 8, 16, [DIM, CYAN, GREEN, GOLD][m - 1]);\n  if (combo >= 2) { const s = `${combo}`; txt(s, 248 - s.length * 8, 6, combo >= MULT_AT[0] ? GOLD : WHITE); txt('COMBO', 208, 16, DIM); }\n  if (clock - judgeAt < 24) ctxt(judgeText, 100, judgeColour);\n  if (clock - bannerAt < 50 && (clock - bannerAt) % 8 < 6) ctxt(bannerText, 84, bannerColour);\n  const r = tm - musicAt;\n  if (!started && r < 0) { const n = Math.ceil(-r / beat); if (n <= 3 && n >= 1) ctxt(String(n), 100, WHITE); }\n  const p = clamp(st() / Math.max(1, songEnd), 0, 1);               // how far through the track\n  rectfill(8, 216, 240, 2, SHADOW); rectfill(8, 216, flr(240 * p), 2, CYAN);\n  txt(TRACKS[track], 8, 204, DIM);\n  const lv = LEVELS[level]; txt(lv, 248 - lv.length * 8, 204, DIM);\n}\n\nfunction drawTitle() {\n  ['PLAY', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 150 + i * 14, i === titleSel ? WHITE : DIM));\n  ctxt('LEFT, RIGHT: GLIDE ROUND THE RIM', 196, DIM);\n}\n\nfunction drawTracks() {\n  panel(16, 24, 224, 152);\n  ctxt('THE SET LIST', 32, GOLD);\n  const n = trackCount();\n  for (let i = 0; i < 5; i++) {\n    const y = 52 + i * 14, on = i === sel, real = i < n, open = real && isOpen(i);\n    if (on) rectfill(20, y - 3, 216, 13, PANEL);\n    txt(`${i + 1}`, 28, y, on ? WHITE : DIM);\n    txt(real ? (open ? TRACKS[i] : 'LOCKED') : 'COMING SOON', 44, y, open ? (on ? WHITE : CYAN) : DIM);\n    if (open) for (let lv = 0; lv < 3; lv++) {\n      const g = dget(bestSlot(i, lv) + 1) & 15;\n      txt(g ? GRADES[g - 1] : '-', 196 + lv * 12, y, g ? GRADE_C[g - 1] : DIM);\n    }\n  }\n  ctxt(`LEVEL: ${LEVELS[selLevel]}`, 128, [CYAN, GREEN, GOLD][selLevel]);\n  ctxt('FOLLOWS ' + FOLLOWS[selLevel], 142, DIM);\n  if (isOpen(sel)) { const b = dget(bestSlot(sel, selLevel)); ctxt(b ? `BEST ${b}` : 'NO BEST YET', 156, WHITE); }\n  if (msg && clock - msgAt < 120) ctxt(msg, 186, clock % 20 < 14 ? GOLD : WHITE);\n  ctxt('A:PLAY  SELECT:CALIBRATE  B:BACK', 204, DIM);\n}\n\nfunction drawCalib() {\n  panel(24, 16, 208, 56);\n  ctxt('CALIBRATION', 22, GOLD);\n  if (cal.stage === 'tap') {\n    ctxt('PRESS A ON EACH TICK, AS THE', 38, WHITE); ctxt('LIGHT REACHES THE DIAMOND', 48, WHITE);\n    ctxt(`${cal.errs.length} OF ${CAL_BEATS}   B: SKIP`, 60, DIM);\n  } else if (cal.stage === 'fail') {\n    ctxt('NOT ENOUGH PRESSES ON THE BEAT', 38, ORANGE); ctxt('START: TRY AGAIN   B: SKIP', 56, DIM);\n  } else {\n    ctxt(`YOUR OFFSET: ${cal.off > 0 ? '+' : ''}${cal.off} FRAMES`, 36, WHITE);\n    ctxt('LEFT/RIGHT: ADJUST  A: KEEP', 48, DIM); ctxt('START: AGAIN  B: SKIP', 58, DIM);\n  }\n}\n\nfunction drawResults() {\n  panel(32, 24, 192, 168);\n  ctxt(TRACKS[track], 32, CYAN); ctxt(LEVELS[level], 44, DIM);\n  const g = gradeOf();\n  ctxt('GRADE', 62, DIM);\n  ctxt(GRADES[g], 74, GRADE_C[g]);\n  const rows = [['PERFECT', counts[0]], ['GOOD', counts[1]], ['OK', counts[2]], ['MISS', counts[3]], ['BEST COMBO', bestCombo], ['CAUGHT', `${flr(accuracy() * 100)}%`]];\n  rows.forEach(([k, v], i) => { txt(k, 56, 92 + i * 11, DIM); const s = String(v); txt(s, 200 - s.length * 8, 92 + i * 11, WHITE); });\n  ctxt(`SCORE ${score}`, 162, WHITE);\n  if (newBest && timer % 30 < 22) ctxt('NEW BEST!', 174, GOLD);\n  if (timer > 30 && timer % 60 < 40) ctxt('A: CONTINUE', 200, DIM);\n}\n\nfunction drawRecords() {\n  panel(16, 16, 224, 192);\n  ctxt('RECORDS', 24, GOLD);\n  ['CHILL', 'DRIVE', 'OVERDRIVE'].forEach((s, lv) => txt(s, 32 + lv * 68, 42, [CYAN, GREEN, GOLD][lv]));\n  for (let i = 0; i < trackCount(); i++) {\n    const y = 60 + i * 28;\n    txt(`${i + 1} ${TRACKS[i]}`, 24, y, WHITE);\n    for (let lv = 0; lv < 3; lv++) {\n      const sc = dget(bestSlot(i, lv)), g = dget(bestSlot(i, lv) + 1) & 15;\n      txt(g ? GRADES[g - 1] : '-', 32 + lv * 68, y + 11, g ? GRADE_C[g - 1] : DIM);\n      if (sc) txt(String(sc), 44 + lv * 68, y + 11, DIM);\n    }\n  }\n  if (timer % 60 < 40) ctxt('START: BACK', 196, DIM);\n}\n\nfunction drawPause() {\n  panel(56, 80, 144, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TRACKS'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 68, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

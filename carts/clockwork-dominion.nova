).map((v) => ({ t: v.name, v: () => $bb(v.cost), a: () => ACT.invent(v.id), ok: () => $aX(v.cost), h: () => v.hint }));\nreturn r.length ? r : [{ t: 'Nothing to invent yet', v: () => '', ok: () => false, h: () => 'New ideas come as the shop grows.' }];\n},\n},\n{\nname: 'RIDDLES', acts: 1, when: () => G.riddleOn,\ninfo: () => (G.rTarget ? [`Wanted ${$aw(...$br())}`, `Now ${$aw(...$bo())}`] : [`Cleverness ${$a(G.clev)}`, `Solved ${G.solved}`, ...(G.engine ? [`+${$c(T.engineRate)}/s`] : [])]),\nrows: () => {\nif (!G.rTarget) return [{ t: 'Pose a riddle', v: () => `${$a($ax())} ins`, a: ACT.pose, ok: () => G.insight >= $ax(), h: () => 'Build a gear train that turns as the riddle asks.' }];\nconst p = $aC(G.rPicks), names = ['First driver', 'First driven', 'Second driver', 'Second driven'];\nconst r = names.map((t, k) => ({ t, v: () => val(`${$k[p[k]]} teeth`), adj: (d) => ACT.gear(k, d), ok: () => true, h: () => 'Output turns = (driver / driven) x (driver / driven).' }));\nr.push({ t: 'Idler gear', v: () => val(p[4] ? 'one' : 'none'), adj: () => ACT.gear(4, 0), ok: () => true, h: () => 'An idler gear turns the output the other way.' });\nr.push({ t: 'Try it', v: () => `+${G.rReward} clev`, a: ACT.tryIt, ok: () => true, h: () => 'See if the train turns as the riddle asks.' });\nr.push({ t: 'Give up', v: () => '', a: ACT.giveUp, ok: () => true, h: () => 'Put the riddle away. The insight it cost is spent.' });\nreturn r;\n},\n},\n{\nname: 'BANCA', acts: 1, when: () => G.bankOn,\ninfo: () => [`Ledger ${$i(G.bank)}`, `put in ${$i(G.bankIn)}`],\nrows: () => [\n{ t: 'Risk', v: () => val($ag[G.risk].n), adj: (d) => ACT.risk(d), ok: () => true, h: () => `About +${($ag[G.risk].mu * 100).toFixed(1)}% a minute${G.risk === 2 ? ', with real falls' : ''}.` },\n{ t: 'Put in half your lire', v: () => $i(G.coin / 2), a: () => ACT.deposit(0.5), ok: () => G.coin > 0, h: () => 'The ledger grows (or falls) while it holds lire.' },\n{ t: 'Put in all your lire', v: () => $i(G.coin), a: () => 
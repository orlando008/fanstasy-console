{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Clockwork Dominion",
    "author": "NOVA-16",
    "description": "A little clockwork automaton is wound up in an old clockmaker's shop and told to make cogs. Sell them to the town, build helpers, invent, and grow until the town, the world and the stars all turn on your gears. One long story in three acts, saved as you play, with a choice at the end."
  },
  "label": null,
  "code": "const ART = {\ntiles: {},\nsprites: {\"cog\": {\"pal\": 0, \"size\": 8, \"tile\": 258}, \"marco\": {\"pal\": 0, \"size\": 16, \"tile\": 256}, \"tinker\": {\"pal\": 0, \"size\": 8, \"tile\": 259}},\nscenes: {\"bench\": {\"h\": 3, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}},\ncolors: {\"BAD\": 119, \"BRASS\": 117, \"DIM\": 116, \"EDGE\": 121, \"GOLD\": 118, \"GOOD\": 120, \"INK\": 115, \"LINE\": 122, \"LOG\": 124, \"PAPER\": 113, \"ROW\": 114, \"THINK\": 123},\ngradients: {\"wall\":{\"entry\":0,\"lines\":[2183,2183,2183,2216,2216,2216,3240,3241,3241,3241,3273,3274,3274,3274,3274,3275,3275,4331,4331,4332,4332,4332,4333,4365,4365,4365,4365,4365,4366,4366,5422,5422,5422,5423,5423,5423,5423,5455,5455,5456,5456,5456,5456,5456,5488,5489,6513,5489,5456,5456,5456,5455,5455,5423,5423,5422,5422,5422,4365,4365,4365,4365,4364,4332,4332,4332,4331,4331,4331,3275,3274,3274,3274,3273,3273,3241,3241,3240,3240,3240,3240,2183,2183,2183,2183,2182,2182,2150,2150,2149,2149,2149],\"y0\":0}},\n};\nfunction $cd(g, y) {\nconst v = g.lines[y - g.y0];\nif (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\nfunction $S(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst CO = ART.colors;\nconst $E = CO.PAPER, $bE = CO.ROW, INK = CO.INK, DIM = CO.DIM, $r = CO.BRASS, $l = CO.GOLD, BAD = CO.BAD;\nconst $aF = CO.GOOD, $N = CO.EDGE, $x = CO.LINE, $cE = CO.THINK, $aI = CO.LOG;\nconst $z = 92, $s = 92, $af = 104, $y = 194, $O = 5;\nconst LM = '\\x7f', RM = '\\x80', DOT = '\\x81', COG = '\\x82';\nconst SFX = { move: 0, select: 1, pause: 2, no: 3, over: 4, clink: 5, story: 6 };\nconst $W = { title: 0, play: 1 };\nconst $bG = [7, 6];\nlet $bg = 0, $R = 1, $J = 1, $ab = -1;\nfunction fx(n) { if (!$R) return; sfx(n, $bG[$bg]); $bg ^= 1; }\nfunction $aa(song) {\nif (!$J) song = -1;\nif (song === $ab) return;\n$ab = song; music(song);\n}\nlet GW = null, GP = null;\nfunction $ch() {\nconst b = rom('font'), n = b.length / 10;\nGW = new U
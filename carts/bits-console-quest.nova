{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Bit’s Console Quest",
    "author": "NOVA-16",
    "description": "Jump and plug into sockets as Bit, a little robot exploring four worlds inside the NOVA-16. Bring treasures and puzzle pieces back to the lab and try your moves on the practice course."
  },
  "label": null,
  "code": "// Bit’s Console Quest: Controller Foundry.\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {\"deckSide\": 2, \"deckTop\": 1},\n  sprites: {\"heroBlink\": {\"pal\": 0, \"size\": 32, \"tile\": 260}, \"heroCheer\": {\"pal\": 0, \"size\": 32, \"tile\": 392}, \"heroFall\": {\"pal\": 0, \"size\": 32, \"tile\": 332}, \"heroIdle\": {\"pal\": 0, \"size\": 32, \"tile\": 256}, \"heroJump\": {\"pal\": 0, \"size\": 32, \"tile\": 328}, \"heroLand\": {\"pal\": 0, \"size\": 32, \"tile\": 388}, \"heroPlug\": {\"pal\": 0, \"size\": 32, \"tile\": 384}, \"heroWalk1\": {\"pal\": 0, \"size\": 32, \"tile\": 264}, \"heroWalk2\": {\"pal\": 0, \"size\": 32, \"tile\": 268}, \"heroWalk3\": {\"pal\": 0, \"size\": 32, \"tile\": 320}, \"heroWalk4\": {\"pal\": 0, \"size\": 32, \"tile\": 324}, \"labConsole\": {\"pal\": 3, \"size\": 32, \"tile\": 448}, \"socketIdle\": {\"pal\": 2, \"size\": 16, \"tile\": 398}, \"socketLive\": {\"pal\": 2, \"size\": 16, \"tile\": 428}, \"treasure\": {\"pal\": 1, \"size\": 16, \"tile\": 396}},\n  scenes: {\"factory\": {\"h\": 28, \"mx\": 0, \"my\": 32, \"pal\": 2, \"w\": 32}, \"logo\": {\"h\": 6, \"mx\": 0, \"my\": 16, \"pal\": 3, \"w\": 32}},\n  colors: {\"CORAL\": 121, \"CYAN\": 119, \"DARK\": 123, \"GOLD\": 118, \"INK\": 113, \"MUTED\": 116, \"PANEL\": 114, \"PURPLE\": 120, \"STEEL\": 122, \"TRIM\": 115, \"WHITE\": 117},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,4162,5186,5186,5186,5186,5186,5186,5186,5186,5186,5186,5186,5186,5186,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,5187,6211,6211,6211,6211,6211,6211,6211,6211,6211,6211,6243,6243,6243,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,6244,7268,7268,7268,7268,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7269,7270,7270,7270,7270,7270,7270,7270,7270,7270,7270,7270,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7302,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7303,7304,7304,7304,7304,7304,7304],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n\nconst SCREEN_W = 256, SCREEN_H = 224;\nconst COURSE_W = 768, COURSE_MAP_Y = 64;\nconst BODY_HALF = 7, BODY_H = 22;\nconst RUN_SPEED = 2.25, GROUND_ACCEL = 0.35, AIR_ACCEL = 0.22, BRAKE = 0.45;\nconst JUMP_SPEED = -4.7, HELD_GRAVITY = 0.22, GRAVITY = 0.30, FALL_LIMIT = 5.5;\nconst COYOTE_FRAMES = 6, BUFFER_FRAMES = 6, RESPAWN_FRAMES = 24;\nconst SOCKET_X_REACH = 20, SOCKET_Y_REACH = 12;\nconst PLUG_FRAMES = 12;\nconst SPAWN = { x: 32, y: 192 };\nconst BEACON = { x: 304, y: 192 };\nconst LIFT = { x: 424, w: 56, bottom: 192, top: 112, socketX: 452 };\nconst TREASURE = { x: 616, y: 62 };\nconst EXIT = { x: 744, y: 101 };\n\nconst deck = [\n  { x: 0, y: 192, w: 184, h: 32 },\n  { x: 224, y: 192, w: 168, h: 32 },\n  { x: 520, y: 112, w: 128, h: 24 },\n  { x: 688, y: 112, w: 80, h: 24 },\n  { x: 592, y: 80, w: 48, h: 8, oneWay: true },\n];\n\nconst SFX = { move: 0, confirm: 1, pause: 2, fall: 3, pickup: 5, clear: 6, jump: 7, plug: 8, checkpoint: 9 };\nconst SONG = { title: 0, stage: 1 };\nconst SFX_CH = [7, 6];\nconst SAVE_VERSION = 2, CLEAR_SLOT = 1, TREASURE_SLOT = 2, STAGE_BIT = 1;\nconst PAUSE_ITEMS = ['RESUME', 'RESTART STAGE', 'BACK TO TITLE'];\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, START];\nconst WALK = [ART.sprites.heroWalk1, ART.sprites.heroWalk2, ART.sprites.heroWalk3, ART.sprites.heroWalk4];\nconst C = ART.colors;\n\nlet skipTitle = false;\nlet state = 'title', paused = false, pauseSel = 0, clock = 0;\nlet input = 0, previousInput = 0, playing = -1, fxNext = 0;\nlet bit, lift, checkpoint, camera, deathTimer, falls;\n\nfunction fx(n) {\n  sfx(n, SFX_CH[fxNext]);\n  fxNext ^= 1;\n}\n\nfunction play(song) {\n  if (playing === song) return;\n  playing = song;\n  music(song);\n}\n\nfunction scene(layer, asset, opts) {\n  bg(layer, { mx: asset.mx, my: asset.my, mw: asset.w, mh: asset.h, ...opts });\n}\n\nfunction buildTerrain() {\n  const { deckTop, deckSide } = ART.tiles;\n  const top = tile(deckTop, 1), side = tile(deckSide, 1);\n  for (const { x, y, w, h } of deck) {\n    for (let dy = 0; dy < h; dy += 8) {\n      for (let dx = 0; dx < w; dx += 8) mset((x + dx) / 8, COURSE_MAP_Y + (y + dy) / 8, dy ? side : top);\n    }\n  }\n}\n\nfunction init() {\n  if (dget(0) !== SAVE_VERSION) {\n    for (let slot = 1; slot < 256; slot++) dset(slot, 0);\n    dset(0, SAVE_VERSION);\n  }\n  buildTerrain();\n  scene(2, ART.scenes.factory, { x: 0, y: 0, wrap: true, show: true });\n  bg(1, { mx: 0, my: COURSE_MAP_Y, mw: COURSE_W / 8, mh: SCREEN_H / 8, x: 0, y: 0, wrap: false });\n  scene(0, ART.scenes.logo, { x: 0, y: -48, wrap: false });\n  if (skipTitle) startStage();\n  else toTitle();\n}\n\nfunction toTitle() {\n  state = 'title';\n  paused = false;\n  clock = 0;\n  play(SONG.title);\n}\n\nfunction startStage() {\n  lift = { x: LIFT.x, w: LIFT.w, y: LIFT.bottom, powered: false, direction: -1, wait: 0 };\n  checkpoint = null;\n  falls = 0;\n  spawnBit(SPAWN);\n  state = 'play';\n  paused = false;\n  clock = 0;\n  play(SONG.stage);\n}\n\nfunction spawnBit({ x, y }) {\n  bit = { x, y, vx: 0, vy: 0, support: deck.find(p => p.y === y && x >= p.x && x < p.x + p.w),\n    coyote: COYOTE_FRAMES, jumpBuffer: 0, facingLeft: false, walk: 0,\n    landUntil: 0, plugUntil: 0, cheerUntil: 0 };\n  camera = clamp(x - SCREEN_W / 2, 0, COURSE_W - SCREEN_W);\n  deathTimer = 0;\n}\n\nconst held = b => (input & (1 << b)) !== 0;\nconst pressed = b => held(b) && !(previousInput & (1 << b));\n\nfunction update() {\n  previousInput = input;\n  input = 0;\n  for (const b of BUTTONS) if (btn(b)) input |= 1 << b;\n  if (paused) {\n    updatePause();\n    return;\n  }\n  clock++;\n  if (state === 'title' || state === 'clear') {\n    if (pressed(A) || pressed(START)) {\n      fx(SFX.confirm);\n      startStage();\n    } else if (state === 'clear' && pressed(B)) toTitle();\n    return;\n  }\n  if (pressed(START)) {\n    paused = true;\n    pauseSel = 0;\n    fx(SFX.pause);\n    return;\n  }\n  updateStage();\n}\n\nfunction updatePause() {\n  const direction = Number(pressed(DOWN)) - Number(pressed(UP));\n  if (direction) {\n    pauseSel = (pauseSel + direction + PAUSE_ITEMS.length) % PAUSE_ITEMS.length;\n    fx(SFX.move);\n  }\n  if (pressed(B) || pressed(START)) {\n    paused = false;\n    fx(SFX.pause);\n  } else if (pressed(A)) {\n    fx(SFX.confirm);\n    if (pauseSel === 1) startStage();\n    else if (pauseSel === 2) toTitle();\n    else paused = false;\n  }\n}\n\nfunction advanceLift() {\n  if (!lift.powered) return;\n  if (lift.wait > 0) {\n    lift.wait--;\n    return;\n  }\n  lift.y += lift.direction;\n  if (lift.y === LIFT.top || lift.y === LIFT.bottom) {\n    lift.direction *= -1;\n    lift.wait = lift.y === LIFT.top ? 60 : 45;\n  }\n}\n\nfunction moveBit(previousLiftY) {\n  const wasSupported = Boolean(bit.support);\n  if (bit.support === lift) bit.y += lift.y - previousLiftY;\n  if (pressed(A)) bit.jumpBuffer = BUFFER_FRAMES;\n  if (bit.jumpBuffer > 0 && (wasSupported || bit.coyote > 0)) {\n    bit.vy = JUMP_SPEED;\n    bit.support = null;\n    bit.coyote = 0;\n    bit.jumpBuffer = 0;\n    fx(SFX.jump);\n  } else {\n    bit.vy = Math.min(FALL_LIMIT, bit.vy + (held(A) && bit.vy < 0 ? HELD_GRAVITY : GRAVITY));\n  }\n\n  const direction = Number(held(RIGHT)) - Number(held(LEFT));\n  if (direction) {\n    bit.vx = clamp(bit.vx + direction * (wasSupported ? GROUND_ACCEL : AIR_ACCEL), -RUN_SPEED, RUN_SPEED);\n    bit.facingLeft = direction < 0;\n  } else {\n    const brake = wasSupported ? BRAKE : AIR_ACCEL;\n    bit.vx -= Math.sign(bit.vx) * Math.min(Math.abs(bit.vx), brake);\n  }\n  const fallSpeed = bit.vy;\n  moveHorizontally();\n  moveVertically(previousLiftY);\n  if (!wasSupported && bit.support && fallSpeed > 2) bit.landUntil = clock + 6;\n\n  if (bit.support) bit.coyote = COYOTE_FRAMES;\n  else if (!wasSupported && bit.coyote > 0) bit.coyote--;\n  if (bit.jumpBuffer > 0) bit.jumpBuffer--;\n  bit.walk = bit.support && Math.abs(bit.vx) > 0.15 ? bit.walk + 1 : 0;\n}\n\nfunction moveHorizontally() {\n  let x = clamp(bit.x + bit.vx, BODY_HALF, COURSE_W - BODY_HALF);\n  for (const p of deck) {\n    if (p.oneWay || bit.y <= p.y || bit.y - BODY_H >= p.y + p.h) continue;\n    if (bit.vx > 0 && bit.x + BODY_HALF <= p.x) x = Math.min(x, p.x - BODY_HALF);\n    if (bit.vx < 0 && bit.x - BODY_HALF >= p.x + p.w) x = Math.max(x, p.x + p.w + BODY_HALF);\n  }\n  if (x !== bit.x + bit.vx) bit.vx = 0;\n  bit.x = x;\n}\n\nfunction overPlatform(p) {\n  return bit.x + BODY_HALF > p.x && bit.x - BODY_HALF < p.x + p.w;\n}\n\nfunction moveVertically(previousLiftY) {\n  let y = bit.y + bit.vy;\n  let support = null;\n  if (bit.vy >= 0) {\n    for (const p of deck) {\n      if (overPlatform(p) && bit.y <= p.y && y >= p.y) {\n        y = p.y;\n        support = p;\n      }\n    }\n    // A rising lift can meet Bit between two frames, even when his own y hardly changed.\n    if ((!support || lift.y < y) && overPlatform(lift) && bit.y <= Math.max(lift.y, previousLiftY) && y >= lift.y) {\n      y = lift.y;\n      support = lift;\n    }\n  } else {\n    for (const p of deck) {\n      const underside = p.y + p.h + BODY_H;\n      if (!p.oneWay && overPlatform(p) && bit.y >= underside && y < underside) y = underside;\n    }\n  }\n  if (support || y !== bit.y + bit.vy) bit.vy = 0;\n  bit.y = y;\n  bit.support = support;\n}\n\nfunction followBit() {\n  camera = clamp(camera, bit.x - 160, bit.x - 96);\n  camera = clamp(camera, 0, COURSE_W - SCREEN_W);\n}\n\nfunction interaction() {\n  const socketY = lift.y - 10;\n  const near = (x, y) => Math.abs(bit.x - x) <= SOCKET_X_REACH && Math.abs(bit.y - BODY_H / 2 - y) <= SOCKET_Y_REACH;\n  if (!lift.powered && near(LIFT.socketX, socketY)) return 'lift';\n  if (near(EXIT.x, EXIT.y)) return 'exit';\n  return null;\n}\n\nconst hasTreasure = () => (dget(TREASURE_SLOT) & STAGE_BIT) !== 0;\nconst stageCleared = () => (dget(CLEAR_SLOT) & STAGE_BIT) !== 0;\n\nfunction updateStage() {\n  if (deathTimer > 0) {\n    if (--deathTimer === 0) {\n      if (checkpoint) Object.assign(lift, checkpoint.lift);\n      else Object.assign(lift, { y: LIFT.bottom, powered: false, direction: -1, wait: 0 });\n      spawnBit(checkpoint ? BEACON : SPAWN);\n    }\n    return;\n  }\n\n  const previousLiftY = lift.y;\n  advanceLift();\n  moveBit(previousLiftY);\n  followBit();\n\n  if (bit.y - BODY_H >= SCREEN_H + 8) {\n    deathTimer = RESPAWN_FRAMES;\n    falls++;\n    fx(SFX.fall);\n    return;\n  }\n  if (!checkpoint && bit.support && bit.y === BEACON.y && Math.abs(bit.x - BEACON.x) < 12) {\n    checkpoint = { lift: { ...lift } };\n    fx(SFX.checkpoint);\n  }\n  if (!hasTreasure() && Math.abs(bit.x - TREASURE.x) < 14 && Math.abs(bit.y - BODY_H / 2 - TREASURE.y) < 15) {\n    dset(TREASURE_SLOT, dget(TREASURE_SLOT) | STAGE_BIT);\n    bit.cheerUntil = clock + 18;\n    fx(SFX.pickup);\n  }\n  if (!pressed(B)) return;\n  const socket = interaction();\n  if (socket === 'lift') {\n    lift.powered = true;\n    bit.plugUntil = clock + PLUG_FRAMES;\n    fx(SFX.plug);\n  } else if (socket === 'exit') {\n    dset(CLEAR_SLOT, dget(CLEAR_SLOT) | STAGE_BIT);\n    state = 'clear';\n    fx(SFX.clear);\n  }\n}\n\nfunction draw() {\n  cls();\n  const title = state === 'title';\n  bg(0, { show: title });\n  bg(1, { show: !title });\n  const scroll = title ? Math.floor(clock / 4) : Math.floor(camera);\n  bgscroll(2, Math.floor(scroll / 3), 0);\n  if (title) drawTitle();\n  else {\n    bgscroll(1, scroll, 0);\n    drawStage(scroll);\n    if (paused) drawPause();\n    else if (state === 'clear') drawClear();\n  }\n}\n\nfunction drawTitle() {\n  centered('CONTROLLER FOUNDRY', 113, C.MUTED);\n  panel(57, 155, 142, 31);\n  centered(stageCleared() ? 'A  REPLAY' : 'A  PLAY', 166, clock % 80 < 60 ? C.WHITE : C.MUTED);\n}\n\nfunction drawStage(scroll) {\n  const liftX = lift.x - scroll;\n  const prompt = interaction();\n  clip(0, 16, SCREEN_W, SCREEN_H - 16);\n  for (const x of [liftX + 3, liftX + LIFT.w - 5]) {\n    rectfill(x, LIFT.top, 2, LIFT.bottom - LIFT.top + 8, C.TRIM);\n  }\n  rectfill(liftX, lift.y, LIFT.w, 8, C.INK);\n  rectfill(liftX + 1, lift.y, LIFT.w - 2, 2, lift.powered ? C.CYAN : C.CORAL);\n  rectfill(liftX + 3, lift.y + 4, LIFT.w - 6, 2, C.STEEL);\n  drawSocket(LIFT.socketX - scroll, lift.y - 10, lift.powered ? ART.sprites.socketLive : ART.sprites.socketIdle, prompt === 'lift' ? 'B PLUG' : '');\n  drawSocket(EXIT.x - scroll, EXIT.y, ART.sprites.socketLive, prompt === 'exit' ? 'B EXIT' : '');\n  if (clock < bit.plugUntil) drawPlugSparks(LIFT.socketX - scroll, lift.y - 10);\n  if (scroll < 140) {\n    rectfill(77 - scroll, 140, 62, 14, C.PANEL);\n    print('A JUMP', 84 - scroll, 144, C.MUTED);\n  }\n  const beaconX = BEACON.x - scroll;\n  rectfill(beaconX - 1, BEACON.y - 30, 3, 30, C.TRIM);\n  rectfill(beaconX + 2, BEACON.y - 29, 11, 7, checkpoint ? C.CYAN : C.PURPLE);\n  rectfill(beaconX + 2, BEACON.y - 24, 11, 2, checkpoint ? C.STEEL : C.TRIM);\n\n  if (!hasTreasure()) {\n    const bob = Math.floor(clock / 12) % 4;\n    drawSprite(ART.sprites.treasure, TREASURE.x - scroll - 8, TREASURE.y - 8 + (bob === 3 ? 1 : bob));\n  }\n  if (!deathTimer) {\n    drawSprite(bitSprite(), Math.floor(bit.x) - scroll - 16, Math.floor(bit.y) - 31, bit.facingLeft);\n  }\n  clip();\n  rectfill(0, 0, SCREEN_W, 15, C.PANEL);\n  rectfill(0, 15, SCREEN_W, 1, C.TRIM);\n  print('1-1 FOUNDRY', 5, 4, C.WHITE);\n  print(hasTreasure() ? 'TREASURE 1/1' : 'TREASURE 0/1', 154, 4, hasTreasure() ? C.GOLD : C.MUTED);\n  if (deathTimer && !paused) centered('REBOOTING', 70, C.MUTED);\n}\n\nfunction bitSprite() {\n  const sprites = ART.sprites;\n  if (state === 'clear' || clock < bit.cheerUntil) return sprites.heroCheer;\n  if (clock < bit.plugUntil) return sprites.heroPlug;\n  if (!bit.support) return bit.vy < 0 ? sprites.heroJump : sprites.heroFall;\n  if (clock < bit.landUntil) return sprites.heroLand;\n  if (bit.walk) return WALK[Math.floor(bit.walk / 5) % WALK.length];\n  return clock % 150 >= 145 ? sprites.heroBlink : sprites.heroIdle;\n}\n\nfunction drawPlugSparks(x, y) {\n  const spread = Math.floor((PLUG_FRAMES + clock - bit.plugUntil) / 3);\n  line(x - 9 - spread, y - 8, x - 12 - spread, y - 11, C.CYAN);\n  line(x + 13 + spread, y - 5, x + 16 + spread, y - 7, C.CYAN);\n  rectfill(x + 9, y - 13 - spread, 1, 2, C.GOLD);\n}\n\nfunction drawSocket(x, y, asset, prompt) {\n  drawSprite(asset, x - 8, y - 8, false, 2);\n  if (!prompt || paused || deathTimer || state !== 'play') return;\n  const width = prompt.length * 8;\n  const left = clamp(x - width / 2, 3, SCREEN_W - width - 3);\n  rectfill(left - 2, y - 32, width + 4, 13, C.INK);\n  print(prompt, left, y - 30, C.WHITE);\n}\n\nfunction drawSprite(asset, x, y, flip = false, prio = 3) {\n  if (x <= -asset.size || x >= SCREEN_W || y <= -asset.size || y >= SCREEN_H) return;\n  spr(asset.tile, x, y, { size: asset.size, pal: asset.pal, prio, fx: flip });\n}\n\nfunction drawPause() {\n  panel(49, 70, 158, 83);\n  centered('PAUSED', 80, C.GOLD);\n  for (let i = 0; i < PAUSE_ITEMS.length; i++) {\n    print(i === pauseSel ? '>' : ' ', 60, 99 + i * 14, C.CYAN);\n    print(PAUSE_ITEMS[i], 76, 99 + i * 14, i === pauseSel ? C.WHITE : C.MUTED);\n  }\n}\n\nfunction drawClear() {\n  panel(36, 68, 184, 87);\n  centered('STAGE CLEAR', 79, C.GOLD);\n  centered(hasTreasure() ? 'TREASURE FOUND' : 'TREASURE MISSING', 99, C.MUTED);\n  centered('A REPLAY   B TITLE', 129, C.WHITE);\n}\n\nfunction panel(x, y, w, h) {\n  rectfill(x + 3, y + 3, w, h, C.INK);\n  rectfill(x, y, w, h, C.PANEL);\n  rect(x, y, w, h, C.TRIM);\n}\n\nfunction centered(text, y, colorIndex) {\n  print(text, 128 - text.length * 4, y, colorIndex);\n}\n\nfunction scanline(y) {\n  gradientLine(ART.gradients.sky, y);\n}\n",

{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Splat Duel",
    "author": "NOVA-16",
    "description": "Two players, one pad, one slingshot each: take turns lobbing paint balloons across the courtyard to cover the other's wall. A power-up floats somewhere unseen, and the shot that finds it may hand it to your rival."
  },
  "label": null,
  "code": "// Splat Duel: a turn-based paint-balloon duel for two players sharing one pad (docs/carts/splat-duel.md).\n// Teal and magenta stand at either end of a courtyard, each in front of a brick wall, and take turns to sling one\n// paint balloon at the other's wall. One power-up floats somewhere in the courtyard, unseen until a balloon passes\n// near it. The first to paint 80% of the other's wall wins, and both always get the same number of shots.\n//\n// The code is in sections: CFG (every tuning value), world and screen (the one mapping from the courtyard to the\n// two views), physics, coverage (the walls' paint masks and tiles), the power-up, the turn flow, and drawing.\n// The rules never read anything the drawing makes: the drawing only reads the rules' state.\n\n// --- Tuning: every number of the game, in one place (the spec's tables are these) ---\n\nconst CFG = {\n  WORLD_W: 448,                 // the courtyard, in px (8 px = 1 m): walls at x 0..31 and 416..447\n  WALL_W: 32, WALL_H: 96,       // each wall's paintable face\n  CELL: 2,                      // the coverage grid: 2 x 2 px cells (16 x 48 = 768 a wall)\n  SLING: [{ x: 52, y: 19 }, { x: 395, y: 19 }], // where each player's balloon leaves the slingshot\n  GRAVITY: 0.1,                 // px per frame per frame\n  VMIN: 2.0, VMAX: 7.5,         // launch speed at power 0 and 100, px per frame\n  SUBSTEPS: 4,                  // physics steps a frame (so a fast balloon cannot skip the power-up)\n  ANGLE_MIN: 5, ANGLE_MAX: 85, ANGLE0: 45, POWER0: 60, COARSE: 5, // aiming, in degrees and percent; B held: steps of 5\n  BALLOON_R: 3,                 // a balloon's radius for hitting walls and the ground\n  SPLASH_R: 13, BIG_R: 20,      // a splash's radius on the wall, normal and Big Balloon\n  SPLASH_JITTER: 6,             // a side hit lands this far either side of the wall's middle\n  DISCOVER_R: 20,               // a balloon this close to the power-up reveals it\n  COLLECT_R: 9,                 // and this close collects it (hidden or not)\n  PU_X: [[72, 112], [336, 376]],// where a power-up can appear: one of these spans of x (inside a view) ...\n  PU_Y: [28, 140],              // ... at a height in this span\n  PU_KINDS: ['big', 'triple', 'roller', 'sponge'], PU_WEIGHTS: [3, 2, 2, 2],\n  TRIPLE_SPREAD: 4,             // Triple Balloon: the outer balloons this many degrees above and below\n  ROLLER_H: 12,                 // Paint Roller: a band this tall across the opponent's wall, where it is barest\n  SPONGE_R: 16,                 // Sponge: clears a disc this big from the collector's wall, where it is most painted\n  WIN: 80,                      // percent of the opponent's wall to win (checked when a round ends)\n  HANDOFF_QUIET: 30,            // the handoff waits for this many frames with no button held before it takes a press\n  AIM_GRACE: 15,                // and the new turn ignores A for this long\n  RESULT_T: 90,                 // frames the result of a shot stays up (A skips after 30)\n  PREVIEW: 24,                  // frames of flight the aiming dots show (the start of the arc, never where it lands)\n};\nconst NAMES = ['TEAL', 'MAGENTA'];\nconst PU_NAMES = { big: 'BIG BALLOON', triple: 'TRIPLE BALLOON', roller: 'PAINT ROLLER', sponge: 'SPONGE' };\nconst PU_SHOT = { big: true, triple: true };   // loaded onto the collector's next shot; the others act at once\n\n// --- Colours: the default palette's text colours, and the overlay's own (art.py) ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GOLD = 14, WHITE = 15;\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"arrow\": {\"pal\": 0, \"size\": 16, \"tile\": 620}, \"balloon\": {\"pal\": 0, \"size\": 16, \"tile\": 608}, \"balloon_fly\": {\"pal\": 0, \"size\": 16, \"tile\": 610}, \"drop\": {\"pal\": 0, \"size\": 8, \"tile\": 618}, \"mag_draw\": {\"pal\": 1, \"size\": 32, \"tile\": 704}, \"mag_idle\": {\"pal\": 1, \"size\": 32, \"tile\": 652}, \"mag_release\": {\"pal\": 1, \"size\": 32, \"tile\": 708}, \"pu_big\": {\"pal\": 2, \"size\": 16, \"tile\": 622}, \"pu_roller\": {\"pal\": 2, \"size\": 16, \"tile\": 714}, \"pu_sponge\": {\"pal\": 2, \"size\": 16, \"tile\": 716}, \"pu_triple\": {\"pal\": 2, \"size\": 16, \"tile\": 712}, \"sparkle0\": {\"pal\": 2, \"size\": 16, \"tile\": 718}, \"sparkle1\": {\"pal\": 2, \"size\": 16, \"tile\": 744}, \"sparkle2\": {\"pal\": 2, \"size\": 16, \"tile\": 746}, \"splat_burst\": {\"pal\": 0, \"size\": 16, \"tile\": 614}, \"splat_pop\": {\"pal\": 0, \"size\": 16, \"tile\": 612}, \"splat_puddle\": {\"pal\": 0, \"size\": 16, \"tile\": 616}, \"teal_draw\": {\"pal\": 0, \"size\": 32, \"tile\": 644}, \"teal_idle\": {\"pal\": 0, \"size\": 32, \"tile\": 640}, \"teal_release\": {\"pal\": 0, \"size\": 32, \"tile\": 648}},\n  scenes: {\"far\": {\"h\": 13, \"mx\": 0, \"my\": 0, \"pal\": 2, \"w\": 32}, \"ground\": {\"h\": 5, \"mx\": 0, \"my\": 28, \"pal\": 1, \"w\": 32}, \"logo\": {\"h\": 9, \"mx\": 0, \"my\": 64, \"pal\": 4, \"w\": 32}, \"walls\": {\"h\": 13, \"mx\": 0, \"my\": 48, \"pal\": 3, \"w\": 32}},\n  colors: {\"GLASS\": 200, \"MAG\": 114, \"MAGD\": 116, \"STONE\": 118, \"STONEL\": 119, \"TEAL\": 113, \"TEALD\": 115, \"YELLOW\": 117},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[21797,21797,21797,21797,21797,21797,21797,21797,21797,21797,21797,21797,21797,21797,21797,21829,21829,21830,21830,21830,21830,21830,21830,22854,22854,22854,22854,22854,22854,22854,22854,22854,22854,22854,22854,22854,22886,22886,22886,22886,22886,22887,22887,22887,22887,22887,22887,23911,23911,23911,23911,23943,23943,23943,23944,23944,23944,25000,25000,25000,25000,25000,25001,25033,25033,25033,25033,26057,26057,26089,26090,26090,26090,26090,26090,26122,27146,27147,27147,27147,27147,27179,27179,27179,27180,28204,28204,28204,28236,28236,28236,28236,28237,28237,28269,29293,29293,29293,29294,29294,29326,29326,29326,29326,29326,29327,29359,29359,29359,29359,29359,29360,29360,29392,29392,29392,30416,30416,30417,30449,30449,30449,30449,30449,30450,30450,30482,30482,30482,30482,30483,30483,30515,30515,30515,30515,30516,30516,30516,30548,30548,31572,31573,31573,30549,30549,30549,30549,30582,30582,30582,30582,30582,30582,30583,30583,30583,30583,30583,30583,30584,29560,29592,29592,29592,29592,29593,29593,29593,29593,29593,29593,29594,29594,29594,29626,29626,28602,28603,28603,28603,28603,28603,28603,28604,28604,28604,28604,28604,28604,28637],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\nconst C = ART.colors, TEAM = [C.TEAL, C.MAG], TEAMD = [C.TEALD, C.MAGD];\n/** Queue one of ART.sprites; opts as for spr (pal overrides the sprite's own: the players' pictures share roles). */\nfunction sprite(s, x, y, opts = {}) { return spr(s.tile, flr(x), flr(y), { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5): songs on channels 0 to 6, effects take turns on 6 and 7 ---\n\nconst SFX = { move: 0, select: 1, pause: 2, tick: 3, launch: 4, splat: 5, ground: 6, reveal: 7, collect: 8, ready: 9, roller: 10, sponge: 11, win: 12, deny: 13 };\nconst SONG = { title: 0, play: 1, win: 2 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- Save: the number of games each colour has won ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, WINS_SLOT = 2;\n\n// --- Input: edge-triggered presses ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- World and screen: the one mapping from the courtyard to the picture ---\n// The screen shows two windows side by side: world x 0..123 at screen x 0..123 (teal's end) and world x 324..447 at\n// screen x 132..255 (magenta's end). Between them, screen x 124..131, is the divider (the window hides sprites there).\n// World y is height above the ground; the ground is screen row 200. The overview strip shows the whole courtyard.\n\nconst SPLIT = 128, OFFSET = 192, DIV0 = 124, DIV1 = 131, GROUND = 200, VIEW_TOP = 44;\nconst OV = { x: 16, y: 41, top: 13 };          // the overview: x 16 + wx / 2, y 41 - wy / 6\nconst sy = (wy) => GROUND - wy;\n/** The screen x of a world x in the view that shows it, or null when neither does. half: the sprite's half width. */\nfunction viewX(wx, half = 0) {\n  if (wx + half <= DIV1 && wx - half >= -32) return wx;\n  if (wx - OFFSET - half >= DIV0 && wx - OFFSET - half <= 256) return wx - OFFSET;\n  return null;\n}\nconst ovX = (wx) => OV.x + wx / 2, ovY = (wy) => Math.max(OV.top, OV.y - wy / 6);\n\n// --- Physics: a balloon is a point with a radius, under gravity, stepped SUBSTEPS times a frame ---\n\nfunction launch(p, angle, power) {\n  const v = CFG.VMIN + (CFG.VMAX - CFG.VMIN) * power / 100, a = angle * Math.PI / 180, dir = p ? -1 : 1;\n  return { x: CFG.SLING[p].x, y: CFG.SLING[p].y, vx: dir * v * Math.cos(a), vy: v * Math.sin(a), alive: true, age: 0 };\n}\n/** One substep of one balloon (no collisions): the only motion rule, used by the flight, the aiming dots and the bot. */\nfunction move(b) { const dt = 1 / CFG.SUBSTEPS; b.vy -= CFG.GRAVITY * dt; b.x += b.vx * dt; b.y += b.vy * dt; }\n/** The points of a flight with nothing in the way, one a frame (for the aiming dots and the bot). */\nfunction arc(p, angle, power, frames) {\n  const b = launch(p, angle, power), out = [];\n  for (let f = 0; f < frames && b.y > -40; f++) { for (let s = 0; s < CFG.SUBSTEPS; s++) move(b); out.push([b.x, b.y]); }\n  return out;\n}\n/** What the balloon is in, at its present place: a wall (and which side), the ground, or out of the courtyard. */\nfunction contact(b, py) {\n  const R = CFG.BALLOON_R;\n  for (let w = 0; w < 2; w++) {\n    const x0 = w ? CFG.WORLD_W - CFG.WALL_W : 0, x1 = x0 + CFG.WALL_W;\n    if (b.x + R >= x0 && b.x - R < x1 && b.y - R < CFG.WALL_H) return { kind: 'wall', w, top: py >= CFG.WALL_H + R - 0.01, x: b.x - x0, y: b.y };\n  }\n  if (b.y - R <= 0) return { kind: 'ground' };\n  if (b.x < -24 || b.x > CFG.WORLD_W + 24) return { kind: 'out' };\n  return null;\n}\n\n// --- Coverage: each wall's paint is a mask of cells; the wall's tiles are drawn from it ---\n// walls[w].mask[j * COLS + i]: cell i across, j up from the ground. Wall 0 is teal's (painted magenta), wall 1 magenta's.\n\nconst COLS = CFG.WALL_W / CFG.CELL, ROWS = CFG.WALL_H / CFG.CELL, CELLS = COLS * ROWS;\nconst PAINT_TILE = 512, WALL_PAL = 3, PAINT_BASE = [11, 6]; // wall 0 takes the magenta ramp, wall 1 the teal\nlet walls = [];\nconst covered = (w) => walls[w].count;\n/** Percent of the opponent's wall that player p has painted (whole percent, rounded down: what the HUD shows). */\nconst percent = (p) => flr(covered(1 - p) * 100 / CELLS);\nfunction newWalls() {\n  walls = [0, 1].map(() => ({ mask: new Uint8Array(CELLS), count: 0, dirty: true }));\n}\nfunction setCell(w, i, j, v) {\n  if (i < 0 || j < 0 || i >= COLS || j >= ROWS) return 0;\n  const W = walls[w], k = j * COLS + i;\n  if (W.mask[k] === v) return 0;\n  W.mask[k] = v; W.count += v ? 1 : -1; W.dirty = true;\n  return v ? 1 : -1;\n}\n/** A splash on wall w at (u, v) of its face (px from its left and from the ground): cells inside an uneven blob of\n *  radius r are painted. Returns the cells newly painted (a cell painted twice counts once). */\nfunction splash(w, u, v, r) {\n  const lobes = rndi(4, 7), phase = rnd(6.283);\n  let added = 0;\n  for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {\n    const dx = i * CFG.CELL + 1 - u, dy = j * CFG.CELL + 1 - v, d = Math.hypot(dx, dy);\n    if (d > r * 1.1) continue;\n    const edge = r * (0.84 + 0.16 * Math.sin(lobes * Math.atan2(dy, dx) + phase));\n    if (d <= edge) added += setCell(w, i, j, 1);\n  }\n  return added;\n}\n/** Paint Roller: a band ROLLER_H tall across wall w, where the band is barest. Returns [cells added, band's v]. */\nfunction roll(w) {\n  const h = CFG.ROLLER_H / CFG.CELL; let best = 0, bestBare = -1;\n  for (let j = 0; j + h <= ROWS; j++) {\n    let bare = 0;\n    for (let jj = j; jj < j + h; jj++) for (let i = 0; i < COLS; i++) bare += 1 - walls[w].mask[jj * COLS + i];\n    if (bare > bestBare) { bestBare = bare; best = j; }\n  }\n  let added = 0;\n  for (let jj = best; jj < best + h; jj++) for (let i = 0; i < COLS; i++) added += setCell(w, i, jj, 1);\n  return [added, best * CFG.CELL];\n}\n/** Sponge: clear a disc of SPONGE_R from wall w where it holds the most paint. Returns [-cells cleared, v]. */\nfunction sponge(w) {\n  const r = CFG.SPONGE_R, cells = (u, v, f) => {\n    let n = 0;\n    for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++)\n      if (Math.hypot(i * CFG.CELL + 1 - u, j * CFG.CELL + 1 - v) <= r) n += f(i, j);\n    return n;\n  };\n  let bu = 16, bv = 48, most = -1;\n  for (let v = 0; v <= CFG.WALL_H; v += 4) {\n    const n = cells(16, v, (i, j) => walls[w].mask[j * COLS + i]);\n    if (n > most) { most = n; bv = v; }\n  }\n  return [cells(bu, bv, (i, j) => setCell(w, i, j, 0)), bv]; // cells cleared, as a negative number\n}\n\n// The walls' tiles: at init each cell of a wall in the map gets a tile of its own (PAINT_TILE on), a copy of its\n// brick; a wall that changed is drawn again from the brick and its mask.\nlet brick = [];\nfunction initWallTiles() {\n  const s = ART.scenes.walls;\n  brick = [0, 1].map((w) => {\n    const px = new Uint8Array(CFG.WALL_W * CFG.WALL_H);\n    for (let ty = 0; ty < CFG.WALL_H / 8; ty++) for (let tx = 0; tx < CFG.WALL_W / 8; tx++) {\n      const mx = s.mx + (w ? 28 : 0) + tx, my = s.my + 1 + ty, e = mget(mx, my);\n      const t = e & 1023, hf = e & 0x2000, vf = e & 0x4000;\n      for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++)\n        px[(ty * 8 + y) * CFG.WALL_W + tx * 8 + x] = sget((t % 16) * 8 + (hf ? 7 - x : x), flr(t / 16) * 8 + (vf ? 7 - y : y));\n      mset(mx, my, tile(PAINT_TILE + w * 48 + ty * 4 + tx, WALL_PAL));\n    }\n    return px;\n  });\n}\nfunction drawWallTiles(w) {\n  const W = walls[w], base = brick[w], paint = PAINT_BASE[w];\n  for (let y = 0; y < CFG.WALL_H; y++) {\n    const j = (CFG.WALL_H - 1 - y) >> 1;\n    for (let x = 0; x < CFG.WALL_W; x++) {\n      const b = base[y * CFG.WALL_W + x], n = PAINT_TILE + w * 48 + (y >> 3) * 4 + (x >> 3);\n      sset((n % 16) * 8 + (x & 7), flr(n / 16) * 8 + (y & 7), W.mask[j * COLS + (x >> 1)] ? paint + b - 1 : b);\n    }\n  }\n  W.dirty = false;\n}\n\n// --- The power-up: exactly one in the courtyard; hidden until a balloon passes near; collected by a direct hit ---\n\nlet pu = null; // { kind, x, y, revealed } or null after collection (a new one comes at the start of the next turn)\nfunction spawnPowerup() {\n  const span = CFG.PU_X[rndi(0, 1)];\n  let k = rnd(CFG.PU_WEIGHTS.reduce((a, b) => a + b, 0)), i = 0;\n  while (k >= CFG.PU_WEIGHTS[i]) k -= CFG.PU_WEIGHTS[i++];\n  pu = { kind: CFG.PU_KINDS[i], x: rndi(span[0], span[1]), y: rndi(CFG.PU_Y[0], CFG.PU_Y[1]), revealed: false };\n}\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0, menuSel = 0, pauseSel = 0;\nlet turn = 0, first = 0, round = 1, shots = [0, 0];      // whose turn, who starts each round, the round, shots fired\nlet aim = [{ angle: 0, power: 0 }, { angle: 0, power: 0 }], last = [null, null], trails = [[], []];\nlet held = [null, null];                                  // a shot power-up waiting for the player's next shot\nlet balloons = [], shot = null, notes = [], fxs = [], puddles = [], drops = [];\nlet quiet = 0, winner = -1, tieRound = false, games = 0, banner = 0, roller = null;\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  const f = ART.scenes.far, g = ART.scenes.ground, w = ART.scenes.walls;\n  bg(2, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, x: 0, y: -96, wrap: false, show: true });\n  bg(1, { mx: g.mx, my: g.my, mw: g.w, mh: g.h, x: 0, y: -184, wrap: false, show: true });\n  bg(0, { mx: w.mx, my: w.my, mw: w.w, mh: w.h, x: 0, y: -96, wrap: false, show: true });\n  blend({ layers: ['overlay'], half: true });  // overlay colours from 192 up (GLASS) are see-through\n  winpos(0, DIV0, DIV1); winmask('spr', { w0: 'in' }); // no sprite crosses the divider into the other view\n  initWallTiles();\n  newWalls(); drawWallTiles(0); drawWallTiles(1);\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; menuSel = 0; paused = false; play(SONG.title); showWalls(false); }\nfunction showWalls(on) {\n  const s = on ? ART.scenes.walls : ART.scenes.logo;\n  bg(0, { mx: s.mx, my: s.my, mw: s.w, mh: s.h, y: on ? -96 : -24 });\n}\n\nfunction startGame() {\n  newWalls(); drawWallTiles(0); drawWallTiles(1);\n  first = games % 2; turn = first; round = 1; shots = [0, 0]; winner = -1; tieRound = false;\n  aim = [0, 1].map(() => ({ angle: CFG.ANGLE0, power: CFG.POWER0 }));\n  last = [null, null]; trails = [[], []]; held = [null, null]; pu = null;\n  balloons = []; notes = []; fxs = []; puddles = []; drops = []; roller = null; paused = false;\n  showWalls(true); play(SONG.play);\n  startTurn();\n}\n\n/** A new turn: the power-up comes back if it was collected (never during a shot), then the pad changes hands. */\nfunction startTurn() {\n  if (!pu) spawnPowerup();\n  state = 'handoff'; timer = 0; quiet = 0;\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'help') { if (timer > 10 && (pressed(A) || pressed(B) || pressed(START))) { fx(SFX.select); toTitle(); } }\n  else if (state === 'handoff') updateHandoff();\n  else if (state === 'aim') updateAim();\n  else if (state === 'flight') updateFlight();\n  else if (state === 'result') updateResult();\n  else if (state === 'over') updateOver();\n  updateEffects();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { menuSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) { fx(SFX.select); if (menuSel === 0) startGame(); else { state = 'help'; timer = 0; } }\n}\n\n/** The handoff: nothing happens until every button has been let go for HANDOFF_QUIET frames, and then a new press of\n *  A (or START) begins the turn. So a held or mashed button from the last turn cannot start it, let alone fire. */\nfunction updateHandoff() {\n  if (quiet >= CFG.HANDOFF_QUIET && (pressed(A) || pressed(START))) { state = 'aim'; timer = 0; banner = 70; fx(SFX.select); return; }\n  quiet = inputMask ? 0 : quiet + 1;\n  if (quiet === CFG.HANDOFF_QUIET) fx(SFX.ready);\n}\n\nfunction updateAim() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  const a = aim[turn], step = btn(B) ? CFG.COARSE : 1;\n  const da = (btnp(UP) ? step : 0) - (btnp(DOWN) ? step : 0), dp = (btnp(RIGHT) ? step : 0) - (btnp(LEFT) ? step : 0);\n  if (da || dp) {\n    const na = clamp(a.angle + da, CFG.ANGLE_MIN, CFG.ANGLE_MAX), np = clamp(a.power + dp, 0, 100);\n    fx(na === a.angle && np === a.power ? SFX.deny : SFX.tick);\n    a.angle = na; a.power = np;\n  }\n  if (timer > CFG.AIM_GRACE && pressed(A)) fire();\n}\n\nfunction fire() {\n  const p = turn, a = aim[p], use = held[p];\n  held[p] = null;\n  const angles = use === 'triple' ? [a.angle + CFG.TRIPLE_SPREAD, a.angle, a.angle - CFG.TRIPLE_SPREAD] : [a.angle];\n  balloons = angles.map((ang) => ({ ...launch(p, ang, a.power), big: use === 'big' }));\n  shot = { p, use, angle: a.angle, power: a.power, added: 0, hits: 0, revealed: false, collected: null, ground: 0, out: 0 };\n  last[p] = { angle: a.angle, power: a.power }; trails[p] = [];\n  shots[p]++; state = 'flight'; timer = 0; fx(SFX.launch);\n}\n\nfunction updateFlight() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  for (const b of balloons) if (b.alive) stepBalloon(b);\n  if (balloons.every((b) => !b.alive)) resolveShot();\n}\n\n/** A frame of one balloon in flight: move, then the power-up, then what it hit. */\nfunction stepBalloon(b) {\n  for (let s = 0; s < CFG.SUBSTEPS && b.alive; s++) {\n    const py = b.y;\n    move(b);\n    if (pu && !(b.x < -24 || b.x > CFG.WORLD_W + 24)) {\n      const d = Math.hypot(b.x - pu.x, b.y - pu.y);\n      if (d <= CFG.DISCOVER_R && !pu.revealed) { pu.revealed = true; shot.revealed = true; fxs.push({ k: 'spark', x: pu.x, y: pu.y, t: 0 }); fx(SFX.reveal); }\n      if (d <= CFG.COLLECT_R) collect(shot.p);\n    }\n    const c = contact(b, py);\n    if (c) hit(b, c);\n  }\n  b.age++;\n  if (b.age % 2 === 0) trails[shot.p].push([b.x, b.y]);\n}\n\nfunction collect(p) {\n  const k = pu.kind;\n  pu.revealed = true; shot.collected = k;\n  fxs.push({ k: 'spark', x: pu.x, y: pu.y, t: 0 });\n  pu = null; fx(SFX.collect);\n  if (PU_SHOT[k]) held[p] = k; // a shot power-up is spent when its shot is fired, so a player never holds two\n}\n\nfunction hit(b, c) {\n  b.alive = false;\n  const p = shot.p;\n  if (c.kind === 'wall') {\n    const r = b.big ? CFG.BIG_R : CFG.SPLASH_R;\n    const u = c.top ? clamp(c.x, 0, CFG.WALL_W - 1) : CFG.WALL_W / 2 + rndi(-CFG.SPLASH_JITTER, CFG.SPLASH_JITTER);\n    const v = c.top ? CFG.WALL_H - 2 : clamp(c.y, 0, CFG.WALL_H - 1);\n    const added = splash(c.w, u, v, r);\n    if (c.w === 1 - p) shot.added += added; else shot.added -= added; // a balloon on your own wall helps the other side\n    shot.hits++;\n    const wx = c.w ? CFG.WORLD_W - CFG.WALL_W + u : u;\n    fxs.push({ k: 'burst', x: wx, y: v, p, t: 0 }); spray(wx, v, p, c.w ? -1 : 1, b.big ? 10 : 6);\n    fx(SFX.splat);\n  } else if (c.kind === 'ground') {\n    shot.ground++;\n    puddles.push({ x: b.x, p }); if (puddles.length > 10) puddles.shift();\n    spray(b.x, 2, p, 0, 4); fx(SFX.ground);\n  } else shot.out++;\n}\n\n/** The end of a shot: the instant power-ups act, the result is written, then the round is checked. */\nfunction resolveShot() {\n  const p = shot.p, k = shot.collected;\n  notes = [];\n  if (shot.hits) notes.push([shot.added > 0 ? `SPLAT! +${flr(shot.added * 100 / CELLS)}% OF THE WALL` : 'SPLAT! NOTHING NEW', TEAM[p]]);\n  else notes.push([shot.out ? 'MISSED: OVER THE WALL' : 'MISSED THE WALL', DIM]);\n  if (shot.revealed && !k) notes.push([`FOUND: ${PU_NAMES[pu.kind]}!`, GOLD]);\n  if (k) {\n    notes.push([`${NAMES[p]} GOT ${PU_NAMES[k]}!`, GOLD]);\n    if (k === 'roller') { const [n, v] = roll(1 - p); roller = { w: 1 - p, v, t: 0, p }; fx(SFX.roller); notes.push([`ROLLED +${flr(n * 100 / CELLS)}%`, TEAM[p]]); }\n    else if (k === 'sponge') { const [n, v] = sponge(p); fxs.push({ k: 'sponge', w: p, v, t: 0 }); fx(SFX.sponge); notes.push([`SPONGED ${flr(-n * 100 / CELLS)}% OFF YOUR WALL`, TEAM[p]]); }\n    else notes.push(['IT GOES ON YOUR NEXT SHOT', DIM]);\n  }\n  state = 'result'; timer = 0;\n}\n\nfunction updateResult() {\n  if (timer < CFG.RESULT_T && !(timer > 30 && pressed(A))) return;\n  const roundOver = turn !== first;\n  if (roundOver) {\n    const v = verdict();\n    if (v >= 0) { winner = v; endGame(); return; }\n    tieRound = v === -2;\n    round++;\n  }\n  turn = 1 - turn;\n  startTurn();\n}\n\n/** At the end of a round: the winner (0 or 1), -1 to play on, or -2 when both passed the line with equal paint. */\nfunction verdict() {\n  const need = Math.ceil(CFG.WIN * CELLS / 100), a = covered(1), b = covered(0), ta = a >= need, tb = b >= need;\n  if (!ta && !tb) return -1;\n  if (ta && tb) return a === b ? -2 : a > b ? 0 : 1;\n  return ta ? 0 : 1;\n}\n\nfunction endGame() {\n  state = 'over'; timer = 0; games++; play(SONG.win); fx(SFX.win);\n  dset(WINS_SLOT + winner, dget(WINS_SLOT + winner) + 1);\n}\n\nfunction updateOver() {\n  if (timer < 90) return;\n  if (pressed(A) || pressed(START)) { fx(SFX.select); startGame(); }\n  else if (pressed(B)) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false; else if (pauseSel === 1) { games = first; startGame(); } else toTitle();\n  }\n}\n\n// Decoration only: bursts, sparkles, drops, puddles and the roller's sweep. Nothing here touches the walls' masks.\nfunction spray(x, y, p, dir, n) {\n  for (let i = 0; i < n && drops.length < 24; i++)\n    drops.push({ x, y, vx: (dir || (rnd(2) - 1)) * rnd(1.6) + (rnd(1) - 0.5), vy: 0.5 + rnd(1.8), p, t: 0 });\n}\nfunction updateEffects() {\n  if (paused) return;\n  for (const e of fxs) e.t++;\n  fxs = fxs.filter((e) => e.t < 24);\n  for (const d of drops) { d.vy -= 0.12; d.x += d.vx; d.y += d.vy; d.t++; }\n  drops = drops.filter((d) => d.y > 0 && d.t < 80);\n  if (roller) { roller.t++; if (roller.t > 40) roller = null; }\n  if (banner) banner--;\n  for (let w = 0; w < 2; w++) if (walls[w] && walls[w].dirty) drawWallTiles(w);\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  if (state === 'title' || state === 'help') { if (state === 'title') drawCourt(true); drawTitle(); return; }\n  drawCourt(false);\n  drawHud();\n  if (state === 'aim') drawAim();\n  if (state === 'result') drawNotes();\n  if (state === 'handoff') drawHandoff();\n  if (state === 'over') drawOver();\n  if (paused) drawPause();\n}\n\n/** The courtyard: the players, the power-up (only once revealed), balloons, effects, the trails, the divider. */\nfunction drawCourt(title) {\n  for (let p = 0; p < 2; p++) {\n    let pose = 'idle';\n    if (!title && p === turn && state === 'aim') pose = 'draw';\n    if (!title && shot && p === shot.p && state === 'flight' && timer < 24) pose = 'release';\n    if (state === 'over' && p === winner && clock % 40 < 20) pose = 'release';\n    const s = ART.sprites[(p ? 'mag_' : 'teal_') + pose], x = CFG.SLING[p].x;\n    const bob = pose === 'idle' && (clock + p * 30) % 60 < 30 ? 1 : 0;\n    sprite(s, viewX(x) + (p ? -5 : -26), 168 + bob, { fx: p === 1 });\n  }\n  if (title) return;\n  if ((state === 'aim' || state === 'handoff') && clock % 40 < 30) {\n    const x = viewX(CFG.SLING[turn].x) + (turn ? 3 : -11);\n    sprite(ART.sprites.arrow, x, 146 + (clock % 40 < 15 ? 0 : 1), { pal: turn });\n  }\n  for (const d of puddles) { const x = viewX(d.x, 8); if (x !== null) sprite(ART.sprites.splat_puddle, x - 8, GROUND - 13, { pal: d.p, prio: 1 }); }\n  if (pu && pu.revealed) { // a hidden power-up is never drawn: nothing on the screen depends on where it is\n    const x = viewX(pu.x, 8), bob = flr(Math.sin(clock / 16) * 1.5);\n    if (x !== null) sprite(ART.sprites['pu_' + pu.kind], x - 8, sy(pu.y) - 8 + bob, { pal: 2 });\n  }\n  if (state === 'flight') for (const b of balloons) if (b.alive) {\n    const x = viewX(b.x, 8);\n    if (x !== null && sy(b.y) > VIEW_TOP - 8) sprite(ART.sprites.balloon_fly, x - 8, sy(b.y) - 8, { pal: shot.p, fx: shot.p === 1 });\n  }\n  for (const e of fxs) {\n    const x = viewX(e.x, 8); if (x === null) continue;\n    if (e.k === 'spark') sprite(ART.sprites['sparkle' + Math.min(2, flr(e.t / 4) % 3)], x - 8, sy(e.y) - 8, { pal: 2 });\n    if (e.k === 'burst') sprite(ART.sprites[e.t < 6 ? 'splat_pop' : 'splat_burst'], x - 8, sy(e.y) - 8, { pal: e.p });\n  }\n  for (const d of drops) { const x = viewX(d.x, 4); if (x !== null) sprite(ART.sprites.drop, x - 4, sy(d.y) - 4, { pal: d.p }); }\n  drawTrails();\n  if (roller) { // the roller sweeping across the band it painted (the band itself is already in the mask)\n    const x0 = roller.w ? CFG.WORLD_W - CFG.WALL_W : 0, x = viewX(x0 + Math.min(CFG.WALL_W - 4, roller.t), 8);\n    if (x !== null) sprite(ART.sprites.pu_roller, x - 8, sy(roller.v + CFG.ROLLER_H / 2) - 8, { pal: 2 });\n  }\n  drawDivider();\n}\n\n/** The last shot of each player as faint dots, the shot in flight as bright ones (in both views and the overview). */\nfunction drawTrails() {\n  for (let p = 0; p < 2; p++) {\n    const live = state === 'flight' && shot.p === p, c = live ? TEAM[p] : TEAMD[p];\n    trails[p].forEach(([x, y], i) => {\n      if (!live && i % 3) return;\n      const vx = viewX(x), Y = sy(y);\n      if (vx !== null && Y >= VIEW_TOP && Y < GROUND && (vx < DIV0 || vx > DIV1)) pset(vx, Y, c);\n    });\n  }\n}\n\nfunction drawDivider() {\n  rectfill(DIV0, VIEW_TOP, 8, 224 - VIEW_TOP, C.STONE); line(DIV0 + 1, VIEW_TOP, DIV0 + 1, 223, C.STONEL);\n  line(DIV1, VIEW_TOP, DIV1, 223, SHADOW);\n}\n\nfunction drawHud() {\n  rectfill(0, 0, 256, VIEW_TOP, C.GLASS); line(0, VIEW_TOP - 1, 255, VIEW_TOP - 1, SHADOW);\n  txt(`${NAMES[0]} ${percent(0)}%`, 4, 2, TEAM[0]);\n  const m = `${percent(1)}% ${NAMES[1]}`; txt(m, 252 - m.length * 8, 2, TEAM[1]);\n  // the middle of the top line: whose turn it is (flashing as a turn begins: never over the courtyard), else the round\n  if (state === 'aim' && banner && banner % 20 < 14) ctxt(turn ? 'TURN >>' : '<< TURN', 2, TEAM[turn]); else if (state !== 'aim' || !banner) ctxt(`ROUND ${round}`, 2, WHITE);\n  // the overview: the whole courtyard at half width, with the views marked, the distance, the walls and the flight\n  const L = ovX(0), Rr = ovX(CFG.WORLD_W);\n  line(L, OV.y + 1, Rr, OV.y + 1, PANEL);\n  rect(L - 1, OV.top - 1, 62 + 2, OV.y - OV.top + 3, DIM); rect(ovX(324) - 1, OV.top - 1, 62 + 2, OV.y - OV.top + 3, DIM);\n  for (let w = 0; w < 2; w++) {\n    const x = ovX(w ? CFG.WORLD_W - CFG.WALL_W : 0), top = ovY(CFG.WALL_H), h = OV.y - top + 1, fill = flr(h * covered(w) / CELLS);\n    rectfill(x, top, 16, h, C.STONEL); if (fill) rectfill(x, OV.y + 1 - fill, 16, fill, TEAM[1 - w]);\n  }\n  for (let p = 0; p < 2; p++) pset(ovX(CFG.SLING[p].x), ovY(CFG.SLING[p].y), TEAM[p]);\n  const gap = (CFG.WORLD_W - 2 * CFG.WALL_W) / 8, label = `<- ${gap} M ->`;\n  print(label, 128 - label.length * 4, 33, DIM);\n  if (pu && pu.revealed) { const x = ovX(pu.x), y = ovY(pu.y); line(x - 1, y, x + 1, y, C.YELLOW); line(x, y - 1, x, y + 1, C.YELLOW); }\n  for (let p = 0; p < 2; p++) {\n    const live = state === 'flight' && shot.p === p;\n    trails[p].forEach(([x, y], i) => { if (live || i % 4 === 0) pset(ovX(x), ovY(y), live ? TEAM[p] : TEAMD[p]); });\n  }\n  if (state === 'flight') for (const b of balloons) if (b.alive) circfill(ovX(b.x), ovY(b.y), 1, TEAM[shot.p]);\n}\n\n/** The aiming panel in the active player's view, and the dots of the start of the arc (gravity only: they know nothing\n *  of the power-up or the walls). */\nfunction drawAim() {\n  const p = turn, a = aim[p], x0 = p ? 136 : 4;\n  clip(p ? 132 : 0, VIEW_TOP, 124, GROUND - VIEW_TOP);\n  arc(p, a.angle, a.power, CFG.PREVIEW).forEach(([x, y], i) => {\n    if (i % 3 !== 2) return;\n    const vx = viewX(x); if (vx !== null) circfill(vx, sy(y), 1, WHITE);\n  });\n  clip();\n  panel(x0, VIEW_TOP + 3, 116, held[p] ? 42 : 32);\n  txt(`ANGLE ${String(a.angle).padStart(2)}`, x0 + 4, VIEW_TOP + 7, WHITE);\n  txt(`POWER ${String(a.power).padStart(3)}`, x0 + 4, VIEW_TOP + 17, WHITE);\n  rect(x0 + 82, VIEW_TOP + 17, 30, 7, DIM); rectfill(x0 + 83, VIEW_TOP + 18, flr(a.power * 28 / 100), 5, TEAM[p]);\n  const l = last[p]; if (l) print(`LAST ${l.angle}/${l.power}`, x0 + 4, VIEW_TOP + 27, DIM);\n  if (held[p]) txt(`NEXT: ${PU_NAMES[held[p]]}`, x0 + 4, VIEW_TOP + 36, GOLD);\n}\n\nfunction drawNotes() {\n  const h = notes.length * 10 + 8;\n  panel(12, 70, 232, h);\n  notes.forEach(([s, c], i) => ctxt(s, 75 + i * 10, c));\n}\n\nfunction drawHandoff() {\n  const p = turn, ready = quiet >= CFG.HANDOFF_QUIET;\n  panel(24, 64, 208, 76);\n  ctxt(tieRound ? 'LEVEL PEGGING! ANOTHER ROUND' : `ROUND ${round}`, 70, tieRound ? GOLD : WHITE);\n  ctxt(`${NAMES[p]}'S TURN`, 86, TEAM[p]);\n  ctxt(`PASS THE PAD TO ${NAMES[p]}`, 100, WHITE);\n  if (!ready) ctxt('(LET GO OF EVERY BUTTON)', 120, DIM);\n  else if (clock % 50 < 36) ctxt('PRESS A WHEN READY', 120, GOLD);\n}\n\nfunction drawOver() {\n  panel(32, 64, 192, 72);\n  ctxt(`${NAMES[winner]} WINS!`, 72, TEAM[winner]);\n  ctxt(`${percent(0)}% TO ${percent(1)}% IN ${round} ROUND${round > 1 ? 'S' : ''}`, 90, WHITE);\n  ctxt(`WINS: TEAL ${dget(WINS_SLOT)}  MAGENTA ${dget(WINS_SLOT + 1)}`, 104, DIM);\n  if (timer > 90 && clock % 60 < 44) ctxt('A: REMATCH   B: TITLE', 120, GOLD);\n}\n\nfunction drawTitle() {\n  if (state === 'help') { drawHelp(); return; }\n  panel(64, 116, 128, 34);\n  ['PLAY', 'HOW TO PLAY'].forEach((s, i) => txt(`${i === menuSel ? '> ' : '  '}${s}`, 72, 122 + i * 12, i === menuSel ? WHITE : DIM));\n  ctxt('2 PLAYERS, ONE PAD, TAKE TURNS', 156, WHITE);\n}\n\nfunction drawHelp() {\n  rectfill(8, 8, 240, 208, SHADOW); rect(8, 8, 240, 208, PANEL);\n  ctxt('HOW TO PLAY', 14, GOLD);\n  [['UP/DOWN', 'AIM HIGHER/LOWER'], ['LEFT/RIGHT', 'LESS/MORE POWER'], ['HOLD B', 'STEPS OF 5'], ['A', 'FIRE'], ['START', 'PAUSE']]\n    .forEach(([k, v], i) => { txt(k, 20, 30 + i * 10, WHITE); txt(v, 108, 30 + i * 10, DIM); });\n  ['PAINT 80% OF THE OTHER WALL.', 'SAME SHOTS EACH, EVERY ROUND.', '', 'ONE POWER-UP FLOATS UNSEEN.',\n   'A BALLOON PASSING CLOSE SHOWS', 'IT TO BOTH; A HIT TAKES IT.', '', 'BIG: A BIGGER SPLASH NEXT',\n   'TRIPLE: 3 BALLOONS NEXT SHOT', 'ROLLER: PAINTS A STRIP NOW', 'SPONGE: CLEANS YOUR WALL']\n    .forEach((s, i) => txt(s, 16, 90 + i * 10, i < 2 ? WHITE : DIM));\n}\n\nfunction drawPause() {\n  panel(56, 80, 144, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 68, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, C.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky's colour for that line. */\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

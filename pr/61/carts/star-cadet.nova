{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Star Cadet Pinball",
    "author": "NOVA-16",
    "description": "A tall scrolling pinball table: ranks, missions and 1 to 4 players."
  },
  "label": "",
  "code": "// Star Cadet Pinball\n// Scaffolded by tools/new-cart.js. A tiny working game (dodge the falling blocks) around everything every cart\n// needs: a title, play, pause, game over, a saved top 10 with initials, a records screen, sound and music cues,\n// a skipTitle hook and save slots. Replace the play part, keep the frame. See docs/dev/playbook.md.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"gem\": {\"pal\": 0, \"size\": 16, \"tile\": 258}, \"player\": {\"pal\": 0, \"size\": 16, \"tile\": 256}},\n  scenes: {\"field\": {\"h\": 8, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hills\": {\"h\": 8, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[13475,13475,13475,13475,13475,13475,13475,14499,14499,14531,14531,14532,14532,14532,14532,14532,14532,15556,15556,15556,15556,15556,15588,15588,15588,15588,15588,16612,16612,16612,16612,16612,16612,16612,16645,16645,16645,17669,17669,17669,17669,17669,17669,17669,17669,17669,18725,18725,18725,18725,18725,18725,18725,18725,18725,19749,19750,19750,19782,19782,19782,19782,19782,19782,19782,20806,20806,20806,20806,20806,20838,20838,20838,20838,21862,21862,21862,21863,21863,21863,21863,21863,21895,22919,22919,22919,22919,22919,22919,22919,22919,22951,22952,22952,23976,23976,23976,23976,24008,24008,24009,24009,24009,24009,24041,24041,25065,25065,25066,25066,25066,25098,25098,25098,25098,25099,25099,25131,26155,26155,26155,26155,26155,26156,26188,26188,26188,26188,26188,26188,27245,27245,27245,27245,27245,27245,27245,27278,27278,27278,27278,27278,28302,28334,28335,28335,28335,28335,28335,28335,28367,28368,28368,28368,28368,29392,29424,29424,29425,29425,29425,29425,29457,29457,29457,29458,29458,29458,30482,30514,30514,30514,30515,30515,30515,30547],\"y0\":0}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once.\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: score, initials, a spare (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  if (!e.score) return -1;\n  const list = topTen(), at = list.findIndex((x) => e.score > x.score);\n  if (at < 0) return -1;\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- The table and its physics (SPEC 4, 5). World pixels: x 0 to 192 across, y 0 to 640 down; the ball is 5 px in radius. ---\n// All the numbers are here, in one place, because only playing can say how the ball should feel.\n\nconst TABLE_W = 192, TABLE_H = 640, VIEW_H = 224;\nconst BR = 5, SUB = 4; // ball radius; substeps a frame (a substep moves the ball at most 3.5 px, under its radius)\nconst GRAV = 0.12, VMAX = 14; // px per frame squared; px per frame\nconst WALL_E = 0.45, FLIP_E = 0.7, REST_CUT = 0.3; // bounce of a wall and of a flipper; below this normal speed a hit does not bounce\nconst FLEN = 34, FR = 4; // a flipper is a capsule: length, radius\nconst REST_A = 30 * Math.PI / 180, UP_A = -28 * Math.PI / 180; // its angle (down is positive), at rest and held up\nconst W_UP = (REST_A - UP_A) / 4, W_DOWN = (REST_A - UP_A) / 6; // radians a frame: up in 4 frames, down in 6\nconst LANE_X = 176, LANE_FLOOR = 612, BALL_HOME = { x: 184, y: LANE_FLOOR - BR };\nconst PLUNGE_FRAMES = 60; // held this long is full power; the launch speed is 4 + 10 x power\nconst DRAIN_Y = 632;\n\n/** The walls: segments [x0, y0, x1, y1, r] (r: a post's radius, else 0). A top arch of radius 96 over the table, the plunger\n *  lane on the right, the outlanes and inlanes with their guides down to the flippers, the two orbits' inner guides (with gaps\n *  where the standup targets are) and the posts between the top lanes. */\nconst WALLS = (() => {\n  const w = [];\n  for (let i = 0; i < 16; i++) { // the arch: a half circle of 16 segments\n    const a0 = Math.PI + (Math.PI * i) / 16, a1 = Math.PI + (Math.PI * (i + 1)) / 16;\n    w.push([96 + 96 * Math.cos(a0), 96 + 96 * Math.sin(a0), 96 + 96 * Math.cos(a1), 96 + 96 * Math.sin(a1)]);\n  }\n  w.push([0, 96, 0, TABLE_H]); // the left wall, on down past the outlane\n  w.push([TABLE_W, 96, TABLE_W, LANE_FLOOR]); // the right wall of the lane\n  w.push([LANE_X, 120, LANE_X, LANE_FLOOR]); // the lane's inner wall, which is also the right outlane's outer wall\n  w.push([LANE_X, LANE_FLOOR, TABLE_W, LANE_FLOOR]); // the lane's floor\n  for (const m of [0, 1]) { // the two sides, the right one mirrored about x = 88\n    const X = (x) => (m ? 176 - x : x);\n    w.push([X(16), 492, X(16), 540], [X(16), 540, X(48), 588]); // the inlane guide: the outlane is outside it, the inlane inside\n    w.push([X(32), 480, X(32), 545], [X(32), 545, X(44), 545]); // the back and bottom of the slingshot\n    w.push([X(24), 150, X(24), 190], [X(24), 204, X(24), 262], [X(24), 276, X(24), 330]); // the orbit's inner guide\n  }\n  w.push([70, 44, 70, 76, 2], [106, 44, 106, 76, 2]); // the posts between the three top lanes\n  return w;\n})();\n/** The elements. Bumpers and slingshots kick the ball; standup targets light; drop targets go down; a ramp carries the ball. */\nconst BUMP_R = 11, BUMP_KICK = 6, SLING_KICK = 7, COOL = 8, HIT_FLASH = 6; // radius; the least speed away from it; frames\nconst BUMPERS = [[66, 168], [110, 168], [88, 204]].map(([x, y]) => ({ x, y, flash: 0, cool: 0 }));\nconst SLINGS = [[32, 480, 44, 545], [144, 480, 132, 545]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, flash: 0, cool: 0 }));\nconst STANDUPS = [[24, 190, 24, 204], [24, 262, 24, 276], [152, 190, 152, 204], [152, 262, 152, 276]].map(([x0, y0, x1, y1]) => ({ x0, y0, x1, y1, lit: false, flash: 0, cool: 0 }));\nconst DROPS = [0, 1, 2].map((i) => ({ x0: 71 + 10 * i, y0: 287 + 10 * i / 3, x1: 80 + 10 * i, y1: 290 + 10 * i / 3, down: false, flash: 0 })); // slanted, so a ball cannot balance on it\nconst TARGET_R = 2, DROP_RESET = 90; // a target's radius; the frames before a cleared bank comes back up\nconst LANE_XS = [52, 88, 124], LANE_Y = 62, LANE_HW = 18; // the three top lanes: where their rollover sensors are\nconst GATE = { x: 88, y: 104, r: 7 }, GATE_HOLD = 45; // the kickout hole; frames the ball is held\nconst SPIN = { x0: 4, x1: 20, y0: 226, y1: 254, per: 8 }; // the spinner in the left orbit: a spin for each 8 px of travel\nconst ORBIT_Y = 160, ORBIT_IN = 330, ORBIT_X = [24, 152]; // an orbit counts when the ball goes up its lane from y 330 to y 160\nconst RAMPS = [\n  { ex: 40, ey: 420, tx: 12, ty: 165, evx: 1.5, evy: 2, lit: false }, // the left ramp: up the table, out at the top of the left orbit\n  { ex: 136, ey: 420, tx: 164, ty: 165, evx: -1.5, evy: 2, lit: false },\n].map((r) => ({ ...r, len: Math.hypot(r.tx - r.ex, r.ty - r.ey) }));\n// Wire gates at the top and the bottom of the two orbit lanes: a slanted rail that only stops a ball coming down, so a ball from the\n// plunger is turned into the table, and a ball up an orbit goes through.\nconst ONEWAY = [[0, 142, 22, 152], [176, 142, 154, 152], [0, 358, 22, 370], [176, 358, 154, 370]]; // and a ball coming out of an orbit is turned into the table, not into the outlane\nconst RAMP_SPEED = 7, RAMP_IN = 12, RAMP_MIN = 4; // px a frame along a ramp; the entrance's radius; the least speed up the table to get on\nconst KICKBACK = { x: 16, y0: 575, y1: 606, v: 13 }; // the left outlane's kickback\nconst PTS = { bump: 100, sling: 10, standup: 500, drop: 1000, bank: 5000, spin: 100, ramp: 1000, rampLit: 2500, orbit: 2000, lane: 500, gate: 5000 };\nlet stats = {}, laneLit = [false, false, false], kickback = true, spinAcc = 0, orbitArm = [false, false], dropTimer = 0, gateSide = 1;\nconst resetStats = () => { stats = { bump: 0, sling: 0, standup: 0, drop: 0, bank: 0, spin: 0, ramp: 0, orbit: 0, lane: 0, laneDone: 0, standupDone: 0, gate: 0, kick: 0 }; };\nresetStats();\n\n/** Flippers: pivot, side (+1 points right), angle, and the last swing (radians a frame, for the ball). */\nconst makeFlippers = () => [{ x: 48, y: 588, s: 1, a: REST_A, w: 0 }, { x: 128, y: 588, s: -1, a: REST_A, w: 0 }];\nconst flipTip = (f) => ({ x: f.x + f.s * FLEN * Math.cos(f.a), y: f.y + FLEN * Math.sin(f.a) });\n\nlet CN = [0, -1]; // the normal of the last collision\n/** Push the ball out of a capsule (or a segment, r 0) and bounce it. vsAt(t): the surface's velocity at the contact. */\nfunction collide(b, x0, y0, x1, y1, r, e, vsAt) {\n  const dx = x1 - x0, dy = y1 - y0, len2 = dx * dx + dy * dy;\n  const t = len2 ? clamp(((b.x - x0) * dx + (b.y - y0) * dy) / len2, 0, 1) : 0;\n  const cx = x0 + dx * t, cy = y0 + dy * t, ox = b.x - cx, oy = b.y - cy, d2 = ox * ox + oy * oy, reach = BR + r;\n  if (d2 >= reach * reach) return false;\n  const d = Math.sqrt(d2), nx = d ? ox / d : 0, ny = d ? oy / d : -1;\n  b.x = cx + nx * reach; b.y = cy + ny * reach; CN = [nx, ny];\n  const vs = vsAt ? vsAt(t) : [0, 0];\n  const vn = (b.vx - vs[0]) * nx + (b.vy - vs[1]) * ny;\n  if (vn < 0) {\n    const k = -(1 + (vn > -REST_CUT ? 0 : e)) * vn;\n    b.vx += k * nx; b.vy += k * ny;\n  }\n  return true;\n}\n/** Make the ball leave the last thing it hit at least this fast. */\nfunction kick(b, v) {\n  const vn = b.vx * CN[0] + b.vy * CN[1];\n  if (vn < v) { b.vx += (v - vn) * CN[0]; b.vy += (v - vn) * CN[1]; }\n}\n/** An element was hit: true once in a while (its cooldown), so a ball touching it for several substeps scores once. */\nfunction struck(el) { if (el.cool > 0) return false; el.cool = COOL; el.flash = HIT_FLASH; return true; }\nfunction award(n) { score += n; }\n\n/** The sensors and the things that move the ball by themselves: lanes, spinner, orbits, the gate, ramps and the kickback. */\nfunction sensors(b) {\n  LANE_XS.forEach((x, i) => {\n    if (Math.abs(b.x - x) < LANE_HW && Math.abs(b.y - LANE_Y) < 6 && !laneLit[i]) {\n      laneLit[i] = true; stats.lane++; award(PTS.lane); fx(SFX.point);\n      if (laneLit.every(Boolean)) { stats.laneDone++; laneLit = [false, false, false]; }\n    }\n  });\n  if (b.x > SPIN.x0 && b.x < SPIN.x1 && b.y > SPIN.y0 && b.y < SPIN.y1) {\n    spinAcc += Math.abs(b.vy) / SUB;\n    while (spinAcc >= SPIN.per) { spinAcc -= SPIN.per; stats.spin++; award(PTS.spin); }\n  }\n  ORBIT_X.forEach((ox, k) => {\n    const inL = k === 0 ? b.x < ox : b.x > ox && b.x < LANE_X, side = b.y > ORBIT_Y - 10 && b.y < ORBIT_IN + 10;\n    if (inL && b.y > ORBIT_IN - 14 && b.y < ORBIT_IN + 6 && b.vy < -1) orbitArm[k] = true;\n    else if (orbitArm[k] && inL && b.y < ORBIT_Y) { orbitArm[k] = false; stats.orbit++; award(PTS.orbit); fx(SFX.point); }\n    else if (orbitArm[k] && !inL && side && b.y < ORBIT_IN - 20) orbitArm[k] = false; // left the lane: no orbit\n  });\n  if (Math.hypot(b.x - GATE.x, b.y - GATE.y) < GATE.r - 2) {\n    b.x = GATE.x; b.y = GATE.y; b.vx = b.vy = 0; b.hold = GATE_HOLD * SUB; stats.gate++; award(PTS.gate); fx(SFX.point);\n  }\n  for (const r of RAMPS) {\n    if (Math.hypot(b.x - r.ex, b.y - r.ey) < RAMP_IN && b.vy < -RAMP_MIN) { b.ramp = { r, d: 0 }; stats.ramp++; fx(SFX.point); }\n  }\n  if (kickback && b.x < KICKBACK.x && b.y > KICKBACK.y0 && b.y < KICKBACK.y1 && b.vy > 0) {\n    kickback = false; b.vx = 0.5; b.vy = -KICKBACK.v; stats.kick++; fx(SFX.point);\n  }\n}\n\n/** One frame of the table: the flippers swing, the ball moves in SUB substeps. hold: the flippers' buttons [left, right]. */\nfunction stepTable(b, flips, hold) {\n  for (let i = 0; i < SUB; i++) {\n    flips.forEach((f, k) => {\n      const a0 = f.a;\n      f.a = hold[k] ? Math.max(UP_A, f.a - W_UP / SUB) : Math.min(REST_A, f.a + W_DOWN / SUB);\n      f.w = (f.a - a0) * SUB;\n    });\n    if (b.ramp) { // carried along a ramp, above the table: nothing on it is touched\n      const r = b.ramp.r, d = (b.ramp.d += RAMP_SPEED / SUB), t = Math.min(1, d / r.len);\n      b.x = r.ex + (r.tx - r.ex) * t; b.y = r.ey + (r.ty - r.ey) * t; b.vx = b.vy = 0;\n      if (d >= r.len) { b.vx = r.evx; b.vy = r.evy; b.ramp = null; award(r.lit ? PTS.rampLit : PTS.ramp); }\n      continue;\n    }\n    if (b.hold > 0) { // in the gate's hole\n      if (--b.hold === 0) { gateSide = -gateSide; b.y = GATE.y + GATE.r + 1; b.vx = 1.2 * gateSide; b.vy = 5; } // out of the hole's reach\n      continue;\n    }\n    b.vy += GRAV / SUB;\n    const sp = Math.hypot(b.vx, b.vy);\n    if (sp > VMAX) { b.vx *= VMAX / sp; b.vy *= VMAX / sp; }\n    b.x += b.vx / SUB; b.y += b.vy / SUB;\n    for (const w of WALLS) collide(b, w[0], w[1], w[2], w[3], w[4] || 0, WALL_E);\n    if (b.vy > 0) for (const w of ONEWAY) collide(b, w[0], w[1], w[2], w[3], 0, WALL_E);\n    for (const e of BUMPERS) if (collide(b, e.x, e.y, e.x, e.y, BUMP_R, WALL_E)) {\n      kick(b, BUMP_KICK); if (struck(e)) { stats.bump++; award(PTS.bump); fx(SFX.hit); }\n    }\n    for (const e of SLINGS) if (collide(b, e.x0, e.y0, e.x1, e.y1, 0, WALL_E)) {\n      kick(b, SLING_KICK); if (struck(e)) { stats.sling++; award(PTS.sling); fx(SFX.move); }\n    }\n    for (const e of STANDUPS) if (collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E) && struck(e) && !e.lit) {\n      e.lit = true; stats.standup++; award(PTS.standup); fx(SFX.point);\n      if (STANDUPS.every((q) => q.lit)) { stats.standupDone++; for (const q of STANDUPS) q.lit = false; }\n    }\n    for (const e of DROPS) if (!e.down && collide(b, e.x0, e.y0, e.x1, e.y1, TARGET_R, WALL_E)) {\n      e.down = true; e.flash = HIT_FLASH; stats.drop++; award(PTS.drop); fx(SFX.point);\n      if (DROPS.every((q) => q.down)) { stats.bank++; award(PTS.bank); dropTimer = DROP_RESET; }\n    }\n    sensors(b);\n    for (const f of flips) {\n      const tip = flipTip(f);\n      collide(b, f.x, f.y, tip.x, tip.y, FR, FLIP_E, (t) => {\n        const r = t * FLEN; // the contact's speed: its distance from the pivot times the turn\n        return [-f.s * Math.sin(f.a) * r * f.w, Math.cos(f.a) * r * f.w];\n      });\n    }\n  }\n  for (const e of [...BUMPERS, ...SLINGS, ...STANDUPS, ...DROPS]) { if (e.cool > 0) e.cool--; if (e.flash > 0) e.flash--; }\n  if (dropTimer > 0 && --dropTimer === 0) for (const e of DROPS) e.down = false;\n}\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\n// The flippers: one hand each. Anything on the D-pad is the left flipper, any of the four buttons on the right is the right one.\nconst PAD_LEFT = [UP, DOWN, LEFT, RIGHT], PAD_RIGHT = [A, B, X, Y];\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet score = 0, balls = 3, ball = null, flips = [], plunge = 0, camY = 0, held = [false, false];\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  // The background: the ground on layer 0 along the bottom of the screen, the hills behind it on layer 1 (each its\n  // region of Map RAM, placed with a negative scroll and not repeated), the sky a gradient in scanline() below.\n  const f = ART.scenes.field, h = ART.scenes.hills;\n  bg(0, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, x: 0, y: -(224 - f.h * 8), wrap: false, show: true });\n  bg(1, { mx: h.mx, my: h.my, mw: h.w, mh: h.h, x: 0, y: -(224 - f.h * 8 - h.h * 8 + 8), wrap: false, show: true });\n  blend({ layers: ['overlay'], half: true }); // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  if (skipTitle) startGame(); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; play(SONG.title); }\n\nfunction startGame() {\n  score = 0; balls = 3; flips = makeFlippers(); resetStats(); laneLit = [false, false, false];\n  for (const e of STANDUPS) e.lit = false;\n  for (const e of DROPS) e.down = false;\n  serve(); paused = false; timer = 0; state = 'play';\n  play(SONG.play);\n}\n\n/** A new ball in the plunger lane. */\nfunction serve() {\n  ball = { x: BALL_HOME.x, y: BALL_HOME.y, vx: 0, vy: 0, ramp: null, hold: 0 }; plunge = 0; kickback = true; orbitArm = [false, false];\n  camY = clamp(ball.y - 150, 0, TABLE_H - VIEW_H);\n}\nconst inLane = () => ball.x > LANE_X && ball.y > LANE_FLOOR - 40;\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++; // a state's clock: it stands still while paused\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  else if (state === 'over') updateOver();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) startGame(); else { state = 'records'; hl = -1; timer = 0; }\n  }\n}\n\n/** The game: the flippers, the plunger and the ball. */\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  held = [PAD_LEFT.some((k) => btn(k)), PAD_RIGHT.some((k) => btn(k))];\n  if (!inLane() && PAD_LEFT.concat(PAD_RIGHT).some((k) => pressed(k))) fx(SFX.move);\n  const waiting = inLane() && ball.vy >= 0 && ball.y >= BALL_HOME.y - 1;\n  if (waiting && (held[0] || held[1])) plunge = Math.min(1, plunge + 1 / PLUNGE_FRAMES);\n  else if (waiting && plunge > 0.04) { ball.vy = -(4 + 10 * plunge); plunge = 0; fx(SFX.point); }\n  else if (!waiting) plunge = 0;\n  stepTable(ball, flips, held);\n  const want = clamp(ball.y - 150, 0, TABLE_H - VIEW_H);\n  camY += (want - camY) * 0.12;\n  if (ball.y > DRAIN_Y && ball.x < LANE_X) drain();\n}\n\nfunction drain() {\n  fx(SFX.hit); balls--;\n  if (balls <= 0) gameOver(); else serve();\n}\n\nfunction gameOver() {\n  state = 'over'; timer = 0; play(-1); fx(SFX.over);\n  rank = insertTop({ score, initials: lastInitials() });\n}\n\nfunction updateOver() {\n  if (timer < 60 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  if (rank >= 0) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  state = 'records'; hl = rank; timer = 0;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nfunction updatePause() {\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startGame(); // restart\n    else toTitle(); // quitting abandons the game: nothing is recorded\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  if (state === 'play' || state === 'over') drawPlay();\n  else if (state === 'title') drawTitle();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (state === 'over') { panel(48, 80, 160, 64); ctxt('GAME OVER', 92, RED); ctxt(`SCORE ${score}`, 108, WHITE); if (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 126, DIM); }\n  if (paused) drawPause();\n}\n\nfunction drawPlay() {\n  rectfill(0, 0, 256, 224, 2);\n  const cy = Math.round(camY), sy = (y) => Math.round(y - cy), R = Math.round;\n  const seg = (x0, y0, x1, y1, c) => line(R(x0), sy(y0), R(x1), sy(y1), c);\n  for (const w of WALLS) seg(w[0], w[1], w[2], w[3], WHITE);\n  for (const w of ONEWAY) seg(w[0], w[1], w[2], w[3], DIM);\n  for (const r of RAMPS) { seg(r.ex - 6, r.ey, r.tx - 6, r.ty, DIM); seg(r.ex + 6, r.ey, r.tx + 6, r.ty, DIM); circ(R(r.ex), sy(r.ey), RAMP_IN, r.lit ? GOLD : DIM); }\n  LANE_XS.forEach((x, i) => circfill(x, sy(LANE_Y), 4, laneLit[i] ? GOLD : PANEL));\n  circ(GATE.x, sy(GATE.y), GATE.r, CYAN);\n  rect(SPIN.x0, sy(SPIN.y0), SPIN.x1 - SPIN.x0, SPIN.y1 - SPIN.y0, DIM);\n  for (const e of BUMPERS) circfill(e.x, sy(e.y), BUMP_R, e.flash ? WHITE : RED);\n  for (const e of SLINGS) { seg(e.x0, e.y0, e.x1, e.y1, e.flash ? WHITE : RED); seg(e.x0 + 1, e.y0, e.x1 + 1, e.y1, e.flash ? WHITE : RED); }\n  for (const e of STANDUPS) for (let i = -1; i <= 1; i++) seg(e.x0 + i, e.y0, e.x1 + i, e.y1, e.lit ? GOLD : GREEN);\n  for (const e of DROPS) if (!e.down) for (let i = -1; i <= 1; i++) seg(e.x0, e.y0 + i, e.x1, e.y1 + i, CYAN); else seg(e.x0, e.y0, e.x1, e.y1, PANEL);\n  for (const f of flips) {\n    const tip = flipTip(f);\n    for (let i = 0; i <= 8; i++) circfill(R(f.x + (tip.x - f.x) * i / 8), sy(f.y + (tip.y - f.y) * i / 8), FR, GOLD);\n  }\n  if (inLane()) rectfill(LANE_X + 6, sy(LANE_FLOOR - 4 + plunge * 14), 8, 4, DIM); // the plunger, pulled back\n  if (kickback) circfill(8, sy(590), 3, GREEN); // the kickback is armed\n  circfill(R(ball.x), sy(ball.y), BR, ball.ramp ? GOLD : WHITE);\n  rectfill(TABLE_W, 0, 256 - TABLE_W, 224, SHADOW);\n  txt('SCORE', 198, 8, DIM); txt(String(score), 252 - String(score).length * 8, 18, WHITE);\n  txt('BALL', 198, 40, DIM); txt(String(4 - balls), 198, 50, balls > 1 ? WHITE : RED);\n}\n\nfunction drawTitle() {\n  ctxt('STAR CADET PINBALL', 50, GOLD);\n  ['PLAY', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 96, 100 + i * 14, i === titleSel ? WHITE : DIM));\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    txt(e.score ? String(e.score).padStart(8) : '', 128, y, i === 0 ? GOLD : WHITE);\n  });\n  if (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(String(score), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(64, 80, 128, 64);\n  ctxt('PAUSED', 88, GOLD);\n  ['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n\n/** Each line of the screen: the sky's colour for that line (the SNES did its skies this way, with HDMA). */\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

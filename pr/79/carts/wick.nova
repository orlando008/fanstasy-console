{
  "format": "nova16-cart",
  "version": 3,
  "meta": {
    "title": "Wick",
    "author": "NOVA-16",
    "description": "You are Wick, a candle flame alone in a dark castle. Run, jump and wall-jump through forty short rooms of water, steam and wind, where one touch snuffs you out and the next try starts at once. Every death leaves its soot; every room cleared replays all your flames together."
  },
  "label": null,
  "code": "// Wick\n// A precision platformer: Wick, a candle flame, runs, jumps and wall-jumps through one-screen rooms to light the lantern\n// in each (docs/carts/wick.md). Step 1: his movement, the rooms from the ROM, death and the instant restart.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"ember\": {\"pal\": 0, \"size\": 8, \"tile\": 518}, \"puff\": {\"pal\": 0, \"size\": 16, \"tile\": 516}, \"wick0\": {\"pal\": 0, \"size\": 16, \"tile\": 512}, \"wick1\": {\"pal\": 0, \"size\": 16, \"tile\": 514}},\n  scenes: {\"cells\": {\"h\": 2, \"mx\": 40, \"my\": 0, \"pal\": 1, \"w\": 10}, \"logo\": {\"h\": 5, \"mx\": 0, \"my\": 30, \"pal\": 3, \"w\": 32}, \"wall\": {\"h\": 26, \"mx\": 64, \"my\": 0, \"pal\": 2, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n};\n// END ART\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Songs use channels 0 to 5; effects take turns on 6 and 7. ---\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\n/** A song is only started if it is not already playing (so a death does not restart the music). */\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 1;\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- The rooms (rooms.py packs rooms.txt into the ROM): 16 x 13 cells of 16 px, under the HUD strip ---\n\nconst COLS = 16, ROWS = 13, CELL = 16, ROOM_Y = 16;\nconst AIR = 0, STONE = 1, LEDGE = 2, WATER = 3, START_CELL = 4, LANTERN = 5, EMBER = 6;\nlet ROOMS = [];\nfunction loadRooms() {\n  const b = rom('rooms'); let at = 1;\n  ROOMS = [];\n  for (let k = 0; k < b[0]; k++) {\n    const world = b[at], n = b[at + 1], par = b[at + 2] | (b[at + 3] << 8), len = b[at + 4];\n    let name = ''; for (let i = 0; i < len; i++) name += String.fromCharCode(b[at + 5 + i]);\n    at += 5 + len;\n    const cells = Array.from(b.slice(at, at + COLS * ROWS)); at += COLS * ROWS;\n    const s = cells.indexOf(START_CELL), l = cells.indexOf(LANTERN);\n    ROOMS.push({ world, n, par, name, cells, sx: (s % COLS) * CELL + 3, sy: Math.floor(s / COLS) * CELL + 4, lx: l % COLS, ly: Math.floor(l / COLS) });\n  }\n}\n/** The cell at column cx, row cy of a room: beyond the sides and the top is stone, below the bottom is air (a fall). */\nconst cellAt = (R, cx, cy) => (cx < 0 || cx >= COLS || cy < 0 ? STONE : cy >= ROWS ? AIR : R.cells[cy * COLS + cx]);\n\n// --- Wick's movement (spec section 5): positions in pixels, speeds in pixels a frame. Pure: stepWick(w, pad, R)\n// changes only w, so the tests and the solver play rooms with it as the game does. ---\n\nconst T = {\n  w: 10, h: 12,                    // his body (the flame above it touches nothing)\n  walk: 1.5, run: 2.6,             // top speeds\n  accG: 0.30, accA: 0.20, stop: 0.40, drift: 0.05,   // speeding up on the ground and in the air; stopping; slowing in the air\n  grav: 0.30, gravHold: 0.156,     // gravity; while A is held and he is rising (the higher jump)\n  fall: 4.5, slide: 1.0,           // the fastest fall; on a wall he is pressing towards\n  jump: -3.4,                      // about 2.3 cells held, 1.2 tapped\n  coyote: 6, buffer: 8,            // frames a jump still works after an edge; frames a press is remembered (a press 6 frames\n                                   // before the frame he lands on jumps on the frame after it)\n  wjx: 2.6, wjy: -3.2, lock: 9,    // a wall jump: away and up; frames the d-pad cannot turn him back\n  restart: 20,                     // frames from a death to the room again\n};\nconst PAD_L = 1, PAD_R = 2, PAD_A = 4, PAD_B = 8;\nconst towards = (v, to, by) => (v < to ? Math.min(to, v + by) : Math.max(to, v - by));\n/** Wick at a room's start. */\nconst newWick = (R) => ({ x: R.sx, y: R.sy, vx: 0, vy: 0, ground: true, wall: 0, coy: 0, buf: 0, lock: 0, a: 0, face: 1, dead: false, won: false, ember: false, ev: '' });\n/** Is the body at (x, y) in stone? */\nfunction inStone(R, x, y) {\n  // (the pixels his body covers, however little of the last one: he never sinks a fraction into stone)\n  const x0 = Math.floor(x / CELL), x1 = Math.floor((Math.ceil(x + T.w) - 1) / CELL), y0 = Math.floor(y / CELL), y1 = Math.floor((Math.ceil(y + T.h) - 1) / CELL);\n  for (let cy = y0; cy <= y1; cy++) for (let cx = x0; cx <= x1; cx++) if (cellAt(R, cx, cy) === STONE) return true;\n  return false;\n}\n/** One frame of Wick. pad: PAD_L, PAD_R, PAD_A, PAD_B. Sets w.ev to 'jump', 'walljump' or 'land' when that happened. */\nfunction stepWick(w, pad, R) {\n  w.ev = '';\n  if (w.dead || w.won) return w;\n  const a = pad & PAD_A ? 1 : 0, press = a && !w.a;\n  w.a = a;\n  if (press) w.buf = T.buffer; else if (w.buf) w.buf--;\n  let dir = (pad & PAD_R ? 1 : 0) - (pad & PAD_L ? 1 : 0);\n  if (w.lock) { w.lock--; if (dir && dir !== Math.sign(w.vx)) dir = 0; }\n  if (dir) { w.vx = towards(w.vx, dir * (pad & PAD_B ? T.run : T.walk), w.ground ? T.accG : T.accA); w.face = dir; }\n  else w.vx = towards(w.vx, 0, w.ground ? T.stop : T.drift);\n  // a jump: from the ground (or just after it), else off a wall\n  if (w.buf && (w.ground || w.coy)) { w.vy = T.jump; w.buf = 0; w.coy = 0; w.ground = false; w.ev = 'jump'; }\n  else if (w.buf && w.wall && !w.ground) { w.vy = T.wjy; w.vx = -w.wall * T.wjx; w.face = -w.wall; w.lock = T.lock; w.buf = 0; w.ev = 'walljump'; }\n  w.vy += a && w.vy < 0 ? T.gravHold : T.grav;\n  w.vy = Math.min(w.vy, w.wall && dir === w.wall && !w.ground ? T.slide : T.fall);\n  // across, a pixel at a time at most, stopping at stone\n  let left = w.vx;\n  while (left) {\n    const s = Math.abs(left) > 1 ? Math.sign(left) : left;\n    if (inStone(R, w.x + s, w.y)) { w.x = s > 0 ? Math.ceil(w.x) : Math.floor(w.x); if (inStone(R, w.x, w.y)) w.x -= Math.sign(s); w.vx = 0; break; }\n    w.x += s; left -= s;\n  }\n  // down or up: stone stops him; a ledge only when he comes down onto its top\n  const was = w.ground, bottom = w.y + T.h;\n  w.ground = false;\n  left = w.vy;\n  while (left) {\n    const s = Math.abs(left) > 1 ? Math.sign(left) : left, ny = w.y + s;\n    let hit = inStone(R, w.x, ny);\n    if (!hit && s > 0) { // a ledge under his feet: its top is the top of its cell\n      const cy = Math.floor((Math.ceil(ny + T.h) - 1) / CELL), top = cy * CELL;\n      if (w.y + T.h <= top && ny + T.h > top) for (let cx = Math.floor(w.x / CELL); cx <= Math.floor((w.x + T.w - 1) / CELL); cx++) if (cellAt(R, cx, cy) === LEDGE) hit = true;\n    }\n    if (hit) {\n      if (s > 0) { w.y = Math.floor((Math.ceil(ny + T.h) - 1) / CELL) * CELL - T.h; w.ground = true; if (!was && w.vy > 1.5) w.ev = w.ev || 'land'; }\n      else w.y = (Math.floor(ny / CELL) + 1) * CELL; // his head under the stone\n      w.vy = 0; break;\n    }\n    w.y = ny; left -= s;\n  }\n  if (was && !w.ground && w.vy >= 0) w.coy = T.coyote; else if (w.coy) w.coy--;\n  // a wall beside him, in the air: stone a pixel to the left or the right\n  w.wall = w.ground ? 0 : inStone(R, w.x + 1, w.y) ? 1 : inStone(R, w.x - 1, w.y) ? -1 : 0;\n  // what he touches: water and the fall below the room snuff him out; the lantern clears the room; an ember is picked up\n  const x0 = Math.floor((w.x + 1) / CELL), x1 = Math.floor((w.x + T.w - 2) / CELL), y0 = Math.floor((w.y + 1) / CELL), y1 = Math.floor((w.y + T.h - 2) / CELL);\n  for (let cy = y0; cy <= y1; cy++) for (let cx = x0; cx <= x1; cx++) {\n    const c = cellAt(R, cx, cy);\n    if (c === WATER) w.dead = true; else if (c === LANTERN) w.won = true; else if (c === EMBER) w.ember = true;\n  }\n  if (w.y > ROWS * CELL) w.dead = true;\n  return w;\n}\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the first room\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0;\nlet room = 0, cur = null, wick = null; // the room's number, the room, Wick\nlet frames = 0, started = false, deaths = 0, deadFor = 0, wonFor = 0, lit = false;\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  loadRooms();\n  // Layers: the room's cells on layer 1 (written into Map RAM by drawRoom), the far wall behind it on layer 2, the\n  // title's lettering on layer 0 (shown only on the title)\n  const wl = ART.scenes.wall, lg = ART.scenes.logo;\n  bg(1, { mx: 0, my: 0, mw: COLS * 2, mh: ROWS * 2, x: 0, y: -ROOM_Y, wrap: false, show: true });\n  bg(2, { mx: wl.mx, my: wl.my, mw: wl.w, mh: wl.h, x: 0, y: -ROOM_Y, wrap: false, show: true });\n  bg(0, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -40, wrap: false, show: false });\n  blend({ layers: ['overlay'], half: true }); // overlay colours from 192 up (ART.colors.GLASS) are see-through\n  color(0, 1, 1, 3);\n  if (skipTitle) startRoom(0); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; startRoomPicture(0); play(SONG.title); }\n\n/** Write a room's cells into Map RAM: each cell is four tiles of its picture in ART.scenes.cells. */\nconst CELL_ART = { [STONE]: 0, [LEDGE]: 1, [WATER]: 2, [LANTERN]: 3 };\nfunction drawRoom(Rm, lanternLit) {\n  const c = ART.scenes.cells;\n  for (let cy = 0; cy < ROWS; cy++) for (let cx = 0; cx < COLS; cx++) {\n    const kind = Rm.cells[cy * COLS + cx];\n    const k = kind === LANTERN && lanternLit ? 4 : CELL_ART[kind];\n    for (let j = 0; j < 2; j++) for (let i = 0; i < 2; i++) mset(cx * 2 + i, cy * 2 + j, k === undefined ? 0 : mget(c.mx + k * 2 + i, c.my + j));\n  }\n}\nfunction startRoomPicture(n) { cur = ROOMS[n]; drawRoom(cur, false); wick = newWick(cur); }\n/** Begin (or begin again) room n: Wick at its start, the clock at nothing until he first moves. */\nfunction startRoom(n, keepDeaths = false) {\n  room = n; startRoomPicture(n);\n  frames = 0; started = false; deadFor = 0; wonFor = 0; lit = false; paused = false; timer = 0; state = 'play';\n  if (!keepDeaths) deaths = 0;\n  play(SONG.play);\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'play') updatePlay();\n  prevMask = inputMask;\n}\n\nfunction updateTitle() {\n  if (pressed(A) || pressed(START)) { fx(SFX.select); startRoom(0); }\n}\n\n/** The buttons as stepWick takes them. */\nconst padOf = (m) => (m & (1 << LEFT) ? PAD_L : 0) | (m & (1 << RIGHT) ? PAD_R : 0) | (m & (1 << A) ? PAD_A : 0) | (m & (1 << B) ? PAD_B : 0);\n\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (wick.dead) { if (++deadFor >= T.restart) startRoom(room, true); return; }\n  if (wick.won) { if (++wonFor >= 50) { if (room + 1 < ROOMS.length) startRoom(room + 1); else toTitle(); } return; }\n  if (pressed(SELECT)) { startRoom(room, true); return; }\n  const pad = padOf(inputMask);\n  if (pad) started = true;\n  if (started) frames++;\n  stepWick(wick, pad, cur);\n  if (wick.ev === 'jump' || wick.ev === 'walljump') fx(SFX.move);\n  if (wick.dead) { deaths++; fx(SFX.hit); }\n  if (wick.won) { lit = true; drawRoom(cur, true); fx(SFX.record); }\n}\n\nfunction updatePause() {\n  if (pressed(START) || pressed(B)) { paused = false; return; }\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(A)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) startRoom(room, true);\n    else toTitle();\n  }\n}\n\n// --- Draw ---\n\nfunction draw() {\n  cls();\n  bg(0, { show: state === 'title' });\n  if (state === 'play') drawPlay(); else drawTitle();\n  if (paused) drawPause();\n}\n\nconst clockText = (f) => `${Math.floor(f / 3600)}:${String(Math.floor(f / 60) % 60).padStart(2, '0')}.${Math.floor((f % 60) / 6)}`;\n\nfunction drawWick() {\n  if (wick.dead) { if (deadFor < 12) sprite(ART.sprites.puff, wick.x - 3, ROOM_Y + wick.y - 4 - deadFor / 2); return; }\n  sprite(clock % 16 < 8 ? ART.sprites.wick0 : ART.sprites.wick1, wick.x - 3, ROOM_Y + wick.y - 4, { fx: wick.face < 0 });\n}\n\nfunction drawPlay() {\n  drawWick();\n  rectfill(0, 0, 256, ROOM_Y, SHADOW);\n  txt(`${cur.world}-${cur.n}`, 6, 4, GOLD);\n  txt(clockText(frames), 100, 4, WHITE);\n  txt(`DEATHS ${deaths}`, 176, 4, deaths ? RED : DIM);\n  if (wick.won && wonFor > 10) { panel(64, 96, 128, 30); ctxt('LIT!', 102, GOLD); ctxt(clockText(frames), 114, WHITE); }\n}\n\nfunction drawTitle() {\n  drawWick();\n  panel(40, 132, 176, 40);\n  ctxt('A: PLAY', 140, WHITE);\n  ctxt('A CANDLE IN THE DARK', 156, CYAN);\n}\n\nfunction drawPause() {\n  panel(64, 72, 128, 76);\n  ctxt('PAUSED', 80, GOLD);\n  ['RESUME', 'RESTART ROOM', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '> ' : '  '}${s}`, 76, 98 + i * 14, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

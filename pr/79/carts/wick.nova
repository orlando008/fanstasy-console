  "meta": {
    "title": "Wick",
    "author": "NOVA-16",
    "description": "You are Wick, a candle flame alone in a dark castle. Run, jump and wall-jump through forty short rooms of water, steam and wind, where one touch snuffs you out and the next try starts at once. Every death leaves its soot; every room cleared replays all your flames together."
  },
  "label": null,
  "code": "// Wick\n// A precision platformer: Wick, a candle flame, runs, jumps and wall-jumps through one-screen rooms to light the lantern\n// in each (docs/carts/wick.md). Step 1: his movement, the rooms from the ROM, death and the instant restart.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"bob\": {\"pal\": 2, \"size\": 16, \"tile\": 910}, \"drip\": {\"pal\": 1, \"size\": 8, \"tile\": 902}, \"ember\": {\"pal\": 0, \"size\": 8, \"tile\": 900}, \"fall\": {\"pal\": 0, \"size\": 32, \"tile\": 836}, \"gear\": {\"pal\": 2, \"size\": 16, \"tile\": 908}, \"gust\": {\"pal\": 2, \"size\": 8, \"tile\": 917}, \"jump\": {\"pal\": 0, \"size\": 32, \"tile\": 832}, \"land\": {\"pal\": 0, \"size\": 32, \"tile\": 844}, \"link\": {\"pal\": 2, \"size\": 8, \"tile\": 916}, \"puff\": {\"pal\": 0, \"size\": 32, \"tile\": 896}, \"rain0\": {\"pal\": 1, \"size\": 16, \"tile\": 932}, \"rain1\": {\"pal\": 1, \"size\": 16, \"tile\": 934}, \"run0\": {\"pal\": 0, \"size\": 32, \"tile\": 776}, \"run1\": {\"pal\": 0, \"size\": 32, \"tile\": 780}, \"slide\": {\"pal\": 0, \"size\": 32, \"tile\": 840}, \"snuffer\": {\"pal\": 2, \"size\": 32, \"tile\": 960}, \"soot\": {\"pal\": 0, \"size\": 8, \"tile\": 901}, \"steam0\": {\"pal\": 2, \"size\": 16, \"tile\": 904}, \"steam1\": {\"pal\": 2, \"size\": 16, \"tile\": 906}, \"wick0\": {\"pal\": 0, \"size\": 32, \"tile\": 768}, \"wick1\": {\"pal\": 0, \"size\": 32, \"tile\": 772}, \"wisp\": {\"pal\": 2, \"size\": 8, \"tile\": 903}},\n  scenes: {\"cells\": {\"h\": 2, \"mx\": 40, \"my\": 0, \"pal\": 1, \"w\": 24}, \"dark\": {\"h\": 1, \"mx\": 40, \"my\": 4, \"pal\": 4, \"w\": 1}, \"logo\": {\"h\": 5, \"mx\": 0, \"my\": 30, \"pal\": 3, \"w\": 32}, \"wall\": {\"h\": 26, \"mx\": 64, \"my\": 0, \"pal\": 2, \"w\": 32}, \"wall2\": {\"h\": 26, \"mx\": 96, \"my\": 0, \"pal\": 2, \"w\": 32}, \"wall3\": {\"h\": 26, \"mx\": 128, \"my\": 0, \"pal\": 2, \"w\": 32}, \"wall4\": {\"h\": 26, \"mx\": 160, \"my\": 0, \"pal\": 2, \"w\": 32}, \"wall5\": {\"h\": 26, \"mx\": 192, \"my\": 0, \"pal\": 2, \"w\": 32}},\n  colors: {\"GLASS\": 200},\n};\n// END ART\n// WORLD_PAL (generated by art.py: do not edit)\nconst WORLD_PAL = {\n  1: ['1818313139525a637b84849cadadc65221007b4a219c7352084284296bad5294c684bde7635a528c847bffd870', '10182121293939394a4a4a5a18295a424a7bc8d8f0'],\n  2: ['18183942395a6b5a7b94849cbdadc64221186b4a398c735a003929006342298c5a6bad7b635a528c847bffd870', '18102131213942314a524a5a297b4a6b9c6bb8f0c0'],\n  3: ['3121105242317b6b5a9c9484c6bdad6331008c5a29ad845a084284296bad5294c684bde78c6310ad944affd870', '18181031292142393152524a4a39216b5a4ae8d090'],\n  4: ['18213931425a526b7b7b8ca5a5bdc63118105a39317b6352184273396b9c6394bd8cbdde635a528c847bffd870', '212139293952424a635a637318295a424a7be0e8f8'],\n  5: ['2108084a292973524a94736bb5a5943910005a39217b634a084284296bad5294c684bde7635a528c847bffd870', '1808082918183929294a42395a29107b5239f0a040'],\n};\n// END WORLD_PAL\n/** A world's look: its colours into BG palettes 1 (the rooms' cells) and 2 (the far wall), and its far wall on BG2. */\nlet lookOf = 0;\nfunction setLook(w) {\n  if (w === lookOf || !WORLD_PAL[w]) return;\n  lookOf = w;\n  WORLD_PAL[w].forEach((hex, k) => { for (let i = 0; i * 6 < hex.length; i++) { const v = parseInt(hex.substr(i * 6, 6), 16); color(16 * (k + 1) + 1 + i, v >> 19, (v >> 11) & 31, (v >> 3) & 31); } });\n  const wl = ART.scenes[w > 1 ? `wall${w}` : 'wall'];\n  bg(2, { mx: wl.mx, my: wl.my, mw: wl.w, mh: wl.h, x: 0, y: -ROOM_Y, wrap: false, show: true });\n}\n/** Queue one of ART.sprites at (x, y), above the background; opts as for spr (fx, fy ...). */\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\n\n// --- Sound (SPEC 5). Songs use channels 0 to 5; effects take turns on 6 and 7. ---\n\nconst SFX = { move: 0, select: 1, pause: 2, hit: 3, over: 4, point: 5, record: 6 };\nconst SONG = { title: 0, play: 1 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\nlet playing = -1;\n/** A song is only started if it is not already playing (so a death does not restart the music). */\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 2; // (2: the chase rooms moved the rooms after them along)\nconst LAST_SLOT = 1, CLEAR_SLOT = 2, EMBER_SLOT = 4, DEATHS_SLOT = 5, BEST_SLOT = 10; // cleared: a bit a room over two slots; best times in frames\nconst isCleared = (n) => (dget(CLEAR_SLOT + (n >> 5)) >> (n & 31)) & 1;\nconst hasEmber = (k) => k >= 0 && (dget(EMBER_SLOT) >> k) & 1;\nconst bestOf = (n) => dget(BEST_SLOT + n);\nconst anyProgress = () => dget(CLEAR_SLOT) || dget(CLEAR_SLOT + 1) || dget(DEATHS_SLOT);\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- The rooms (rooms.py packs rooms.txt into the ROM): 16 x 13 cells of 16 px, under the HUD strip ---\n\nconst COLS = 16, ROWS = 13, CELL = 16, ROOM_Y = 16;\nconst AIR = 0, STONE = 1, LEDGE = 2, WATER = 3, START_CELL = 4, LANTERN = 5, EMBER = 6;\n// The hazards' cells (rooms.txt: d ^ > < = H V P ( ) r): a drip's spout, steam jets (up, right, left), a shelf that\n// crumbles, gears (moving across, moving up and down), a pendulum's pivot, wind (to the left, to the right), rain\nconst DRIP = 7, JET_U = 8, JET_R = 9, JET_L = 10, CRUMBLE = 11, GEAR_H = 12, GEAR_V = 13, PIVOT = 14, WIND_L = 15, WIND_R = 16, RAIN = 17;\n// Every timed hazard runs on one clock of 120 frames from the start of a try, so a room plays the same every try (and\n// the solver's states repeat). A hazard's place in the cycle comes from its column: a quarter of the cycle a column.\nconst CYCLE = 120, phase = (cx) => (cx % 4) * 30;\nconst H = {\n  dripFall: 3,                       // a drop's speed; one falls every cycle\n  jetOn: 60, jetWarn: 20, jetLen: 3, // steam: frames on in a cycle, frames of warning before, cells long\n  crumble: 24,                       // frames a shelf holds after Wick lands on it\n  gearGo: 48,                        // pixels a gear travels (there in half a cycle, back in the other)\n  arm: 48, swing: Math.PI / 3, bob: 6,   // a pendulum: its arm, its swing each side of straight down, its weight's radius\n  wind: 0.9,                         // wind carries him this many pixels a frame while he is in it (on top of his own speed)\n  rainOn: 72,                        // rain: frames falling in a cycle\n  lag: 150,                          // the Snuffer is where Wick was this many frames ago\n};\nconst LETTERS = '.#-~SL*d^><=HVP()r'; // rooms.txt's letter for each cell\nlet ROOMS = [], WORLDS = []; // the rooms in the ROM's order (a room's number here is its place in the save), and the worlds they make\nfunction loadRooms() {\n  const b = rom('rooms'); let at = 1, embers = 0;\n  ROOMS = [];\n  for (let k = 0; k < b[0]; k++) {\n    const world = b[at] & 127, chase = b[at] > 127, n = b[at + 1], par = b[at + 2] | (b[at + 3] << 8), len = b[at + 4];\n    let name = ''; for (let i = 0; i < len; i++) name += String.fromCharCode(b[at + 5 + i]);\n    at += 5 + len;\n    const cells = Array.from(b.slice(at, at + COLS * ROWS)); at += COLS * ROWS;\n    const Rm = makeRoom(world, n, par, name, cells, chase);\n    Rm.ember = Rm.ex < 0 ? -1 : embers++;\n    ROOMS.push(Rm);\n  }\n  WORLDS = [...new Set(ROOMS.map((r) => r.world))];\n}\n/** A room from its cells: where Wick starts, the lantern, the ember, and its hazards worked out once. The spouts,\n * jets, pivots and rain grates are stone to walk on; gears and wind are air in the grid, and things of their own. */\nfunction makeRoom(world, n, par, name, raw, chase = false) {\n  const cells = raw.slice(), at = (k) => ({ cx: k % COLS, cy: Math.floor(k / COLS) });\n  const s = raw.indexOf(START_CELL), l = raw.indexOf(LANTERN), e = raw.indexOf(EMBER);\n  const Rm = { world, n, par, name, chase, cells, sx: (s % COLS) * CELL + 3, sy: Math.floor(s / COLS) * CELL + 4, lx: l % COLS, ly: Math.floor(l / COLS),\n    rawText: raw.map((c) => LETTERS[c]).join(''), ember: e < 0 ? -1 : 0, ex: e < 0 ? -1 : e % COLS, ey: Math.floor(e / COLS), drips: [], jets: [], gears: [], bobs: [], rains: [], fixtures: [], timed: false };\n  const solid = (c) => c === STONE || c === DRIP || c === JET_U || c === JET_R || c === JET_L || c === PIVOT || c === RAIN;\n  /** How many cells of air from (cx, cy) going (dx, dy), up to `most`. */\n  const run = (cx, cy, dx, dy, most) => { let k = 0; while (k < most && cx >= 0 && cx < COLS && cy >= 0 && cy < ROWS && !solid(raw[cy * COLS + cx])) { k++; cx += dx; cy += dy; } return k; };\n  raw.forEach((c, k) => {\n    const { cx, cy } = at(k);\n    if (c === DRIP) Rm.drips.push({ x: cx * CELL + 6, y: (cy + 1) * CELL, len: run(cx, cy + 1, 0, 1, ROWS) * CELL, off: phase(cx) });\n    else if (c === JET_U || c === JET_R || c === JET_L) {\n      const dx = c === JET_R ? 1 : c === JET_L ? -1 : 0, dy = c === JET_U ? -1 : 0, len = run(cx + dx, cy + dy, dx, dy, H.jetLen) * CELL;\n      Rm.jets.push({ cx, cy, dx, dy, len, off: phase(cx + cy),\n        x: dx < 0 ? cx * CELL - len : dx > 0 ? (cx + 1) * CELL : cx * CELL + 3, y: dy < 0 ? cy * CELL - len : cy * CELL + 3, w: dx ? len : 10, h: dy ? len : 10 });\n    } else if (c === GEAR_H || c === GEAR_V) Rm.gears.push({ x: cx * CELL, y: cy * CELL, dx: c === GEAR_H ? 1 : 0, dy: c === GEAR_V ? -1 : 0, off: phase(cx) });\n    else if (c === PIVOT) Rm.bobs.push({ x: cx * CELL + 8, y: cy * CELL + 12, off: phase(cx) });\n    else if (c === RAIN) Rm.rains.push({ x: cx * CELL + 3, y: (cy + 1) * CELL, len: run(cx, cy + 1, 0, 1, ROWS) * CELL, off: phase(cx) });\n    if (solid(c) && c !== STONE) { Rm.fixtures.push({ cx, cy, c }); cells[k] = STONE; }\n    if (c === GEAR_H || c === GEAR_V) cells[k] = AIR;\n  });\n  Rm.timed = !!(Rm.drips.length + Rm.jets.length + Rm.gears.length + Rm.bobs.length + Rm.rains.length);\n  return Rm;\n}\n/** Where a hazard is at frame t of a try (the same every try). */\nconst gearAt = (g, t) => { const u = (t + g.off) % CYCLE, d = (u < CYCLE / 2 ? u : CYCLE - u) * (H.gearGo / (CYCLE / 2)); return { x: g.x + g.dx * d, y: g.y + g.dy * d }; };\nconst bobAt = (b, t) => { const a = H.swing * Math.sin(((t + b.off) / CYCLE) * 2 * Math.PI); return { x: b.x + Math.sin(a) * H.arm, y: b.y + Math.cos(a) * H.arm }; };\nconst dripAt = (d, t) => { const y = ((t + d.off) % CYCLE) * H.dripFall; return y < d.len - 4 ? d.y + y : -1; };\nconst jetOn = (j, t) => (t + j.off) % CYCLE < H.jetOn, jetWarn = (j, t) => (t + j.off) % CYCLE >= CYCLE - H.jetWarn;\nconst rainOn = (r, t) => (t + r.off) % CYCLE < H.rainOn;\n/** The Snuffer (a chase room): where Wick was H.lag frames ago, counted from his first move. Wick keeps his path as\n * a chain of places (w.trail: the newest, each with the one before it and, every 16th, the one 16 before), which\n * tries share, so the solver can branch a try without copying it. { x, y, on }: on once it has started to follow. */\nfunction snufferAt(w) {\n  let n = w.trail; if (!n) return null;\n  const to = n.d - H.lag;\n  if (to < 0) { while (n.d > 0) n = n.hop || n.prev; return { x: n.x, y: n.y, on: false }; }\n  while (n.d > to) n = n.hop && n.d - 16 >= to ? n.hop : n.prev;\n  return { x: n.x, y: n.y, on: true };\n}\n/** Is a crumbling shelf (cell k) still there for Wick w? */\nconst shelfThere = (w, k) => !(k in w.cr) || w.t - w.cr[k] < H.crumble;\n\n/** The cell at column cx, row cy of a room: beyond the sides and the top is stone, below the bottom is air (a fall). */\nconst cellAt = (R, cx, cy) => (cx < 0 || cx >= COLS || cy < 0 ? STONE : cy >= ROWS ? AIR : R.cells[cy * COLS + cx]);\n\n// --- Wick's movement (spec section 5): positions in pixels, speeds in pixels a frame. Pure: stepWick(w, pad, R)\n// changes only w, so the tests and the solver play rooms with it as the game does. ---\n\nconst T = {\n  w: 10, h: 12,                    // his body (the flame above it touches nothing)\n  walk: 1.5, run: 2.6,             // top speeds\n  accG: 0.30, accA: 0.20, stop: 0.40, drift: 0.05,   // speeding up on the ground and in the air; stopping; slowing in the air\n  grav: 0.30, gravHold: 0.156,     // gravity; while A is held and he is rising (the higher jump)\n  fall: 4.5, slide: 1.0,           // the fastest fall; on a wall he is pressing towards\n  jump: -3.4,                      // about 2.3 cells held, 1.2 tapped\n  coyote: 6, buffer: 8,            // frames a jump still works after an edge; frames a press is remembered (a press 6 frames\n                                   // before the frame he lands on jumps on the frame after it)\n  wjx: 2.6, wjy: -3.2, lock: 9,    // a wall jump: away and up; frames the d-pad cannot turn him back\n  restart: 20,                     // frames from a death to the room again\n};\nconst PAD_L = 1, PAD_R = 2, PAD_A = 4, PAD_B = 8;\nconst towards = (v, to, by) => (v < to ? Math.min(to, v + by) : Math.max(to, v - by));\n/** Wick at a room's start. */\n// (t: the frames of this try, the hazards' clock; gear: the gear he stands on, or -1; cr: the shelves he has set crumbling, and when)\nconst newWick = (R) => ({ x: R.sx, y: R.sy, vx: 0, vy: 0, ground: true, wall: 0, coy: 0, buf: 0, lock: 0, a: 0, face: 1, dead: false, won: false, ember: false, ev: '', t: 0, gear: -1, cr: {}, trail: null });\n/** Is the body at (x, y) in stone? */\nfunction inStone(R, x, y) {\n  // (the pixels his body covers, however little of the last one: he never sinks a fraction into stone)\n  const x0 = Math.floor(x / CELL), x1 = Math.floor((Math.ceil(x + T.w) - 1) / CELL), y0 = Math.floor(y / CELL), y1 = Math.floor((Math.ceil(y + T.h) - 1) / CELL);\n  for (let cy = y0; cy <= y1; cy++) for (let cx = x0; cx <= x1; cx++) if (cellAt(R, cx, cy) === STONE) return true;\n  return false;\n}\n/** One frame of Wick. pad: PAD_L, PAD_R, PAD_A, PAD_B. Sets w.ev to 'jump', 'walljump' or 'land' when that happened. */\nfunction stepWick(w, pad, R) {\n  w.ev = '';\n  if (w.dead || w.won) return w;\n  // a gear he stands on carries him as it moves\n  if (w.gear >= 0) { const g = R.gears[w.gear], p0 = gearAt(g, w.t), p1 = gearAt(g, w.t + 1); if (!inStone(R, w.x + p1.x - p0.x, w.y)) w.x += p1.x - p0.x; w.y += p1.y - p0.y; }\n  w.t++;\n  const a = pad & PAD_A ? 1 : 0, press = a && !w.a;\n  w.a = a;\n  if (press) w.buf = T.buffer; else if (w.buf) w.buf--;\n  let dir = (pad & PAD_R ? 1 : 0) - (pad & PAD_L ? 1 : 0);\n  if (w.lock) { w.lock--; if (dir && dir !== Math.sign(w.vx)) dir = 0; }\n  if (dir) { w.vx = towards(w.vx, dir * (pad & PAD_B ? T.run : T.walk), w.ground ? T.accG : T.accA); w.face = dir; }\n  else w.vx = towards(w.vx, 0, w.ground ? T.stop : T.drift);\n  // wind carries him while his middle is in it\n  const wc = cellAt(R, Math.floor((w.x + T.w / 2) / CELL), Math.floor((w.y + T.h / 2) / CELL));\n  const blown = wc === WIND_R ? H.wind : wc === WIND_L ? -H.wind : 0;\n  // a jump: from the ground (or just after it), else off a wall\n  if (w.buf && (w.ground || w.coy)) { w.vy = T.jump; w.buf = 0; w.coy = 0; w.ground = false; w.ev = 'jump'; }\n  else if (w.buf && w.wall && !w.ground) { w.vy = T.wjy; w.vx = -w.wall * T.wjx; w.face = -w.wall; w.lock = T.lock; w.buf = 0; w.ev = 'walljump'; }\n  w.vy += a && w.vy < 0 ? T.gravHold : T.grav;\n  w.vy = Math.min(w.vy, w.wall && dir === w.wall && !w.ground ? T.slide : T.fall);\n  // across, a pixel at a time at most, stopping at stone\n  let left = w.vx + blown;\n  while (left) {\n    const s = Math.abs(left) > 1 ? Math.sign(left) : left;\n    if (inStone(R, w.x + s, w.y)) { w.x = s > 0 ? Math.ceil(w.x) : Math.floor(w.x); if (inStone(R, w.x, w.y)) w.x -= Math.sign(s); w.vx = 0; break; }\n    w.x += s; left -= s;\n  }\n  // down or up: stone stops him; a ledge only when he comes down onto its top\n  const was = w.ground;\n  w.ground = false; w.gear = -1;\n  left = w.vy;\n  while (left) {\n    const s = Math.abs(left) > 1 ? Math.sign(left) : left, ny = w.y + s;\n    let hit = inStone(R, w.x, ny);\n    if (!hit && s > 0) { // a ledge under his feet: its top is the top of its cell\n      const cy = Math.floor((Math.ceil(ny + T.h) - 1) / CELL), top = cy * CELL;\n      if (w.y + T.h <= top && ny + T.h > top) for (let cx = Math.floor(w.x / CELL); cx <= Math.floor((w.x + T.w - 1) / CELL); cx++) {\n        const c = cellAt(R, cx, cy), k = cy * COLS + cx;\n        if (c === LEDGE) hit = true;\n        else if (c === CRUMBLE && shelfThere(w, k)) { hit = true; if (!(k in w.cr)) w.cr = { ...w.cr, [k]: w.t }; } // it starts to go\n      }\n      // a gear under his feet: its top is a ledge that moves (one that rises under his feet takes him up: 2 px of grace)\n      if (!hit) for (let i = 0; i < R.gears.length; i++) {\n        const g = gearAt(R.gears[i], w.t);\n        if (w.x + T.w > g.x && w.x < g.x + CELL && w.y + T.h <= g.y + 2 && ny + T.h > g.y) { hit = true; w.gear = i; w.y = g.y - T.h; w.ground = true; if (!was && w.vy > 1.5) w.ev = w.ev || 'land'; w.vy = 0; }\n      }\n      if (w.gear >= 0) break;\n    }\n    if (hit) {\n      if (s > 0) { w.y = Math.floor((Math.ceil(ny + T.h) - 1) / CELL) * CELL - T.h; w.ground = true; if (!was && w.vy > 1.5) w.ev = w.ev || 'land'; }\n      else w.y = (Math.floor(ny / CELL) + 1) * CELL; // his head under the stone\n      w.vy = 0; break;\n    }\n    w.y = ny; left -= s;\n  }\n  if (was && !w.ground && w.vy >= 0) w.coy = T.coyote; else if (w.coy) w.coy--;\n  // a wall beside him, in the air: stone a pixel to the left or the right\n  w.wall = w.ground ? 0 : inStone(R, w.x + 1, w.y) ? 1 : inStone(R, w.x - 1, w.y) ? -1 : 0;\n  // what he touches: water and the fall below the room snuff him out; the lantern clears the room; an ember is picked up\n  const x0 = Math.floor((w.x + 1) / CELL), x1 = Math.floor((w.x + T.w - 2) / CELL), y0 = Math.floor((w.y + 1) / CELL), y1 = Math.floor((w.y + T.h - 2) / CELL);\n  for (let cy = y0; cy <= y1; cy++) for (let cx = x0; cx <= x1; cx++) {\n    const c = cellAt(R, cx, cy);\n    if (c === WATER) w.dead = true; else if (c === LANTERN) w.won = true; else if (c === EMBER) w.ember = true;\n  }\n  if (w.y > ROWS * CELL) w.dead = true;\n  // the hazards that move: a drop, steam, a pendulum's weight, rain (his body a pixel smaller each side: a near miss is a miss)\n  const bx = w.x + 1, by = w.y + 1, bw = T.w - 2, bh = T.h - 2, over = (x, y, ww, hh) => bx < x + ww && bx + bw > x && by < y + hh && by + bh > y;\n  for (const d of R.drips) { const y = dripAt(d, w.t); if (y >= 0 && over(d.x, y, 4, 6)) w.dead = true; }\n  for (const j of R.jets) if (j.len && jetOn(j, w.t) && over(j.x, j.y, j.w, j.h)) w.dead = true;\n  for (const r of R.rains) if (r.len && rainOn(r, w.t) && over(r.x, r.y, 10, r.len)) w.dead = true;\n  for (const b of R.bobs) { const q = bobAt(b, w.t), nx = Math.max(bx, Math.min(q.x, bx + bw)), ny = Math.max(by, Math.min(q.y, by + bh)); if ((q.x - nx) ** 2 + (q.y - ny) ** 2 < H.bob * H.bob) w.dead = true; }\n  // the Snuffer, in a chase room: it comes along his path, and to touch it is to be snuffed out\n  if (R.chase && (w.trail || pad)) {\n    const d = w.trail ? w.trail.d + 1 : 0, n = { x: w.x, y: w.y, d, prev: w.trail, hop: null };\n    if (d && d % 16 === 0) { let q = n; for (let i = 0; i < 16; i++) q = q.prev; n.hop = q; }\n    w.trail = n;\n    const s = snufferAt(w);\n    if (s.on && Math.abs(w.x - s.x) < 8 && Math.abs(w.y - s.y) < 10) w.dead = true;\n  }\n  return w;\n}\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the first room\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, confirm = false, mapSel = 0;\nlet room = 0, cur = null, wick = null; // the room's number, the room, Wick\nlet frames = 0, started = false, deaths = 0, deadFor = 0, wonFor = 0, lit = false, landT = 0;\n// This visit to the room: where Wick was snuffed out (the soot), and every try's path, for the replay\nconst SOOT_MAX = 40, TRIES_MAX = 30, TRY_FRAMES = 2700;\nlet soot = [], tries = [], track = null, replayT = 0, replayEnd = 0, result = null;\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { for (let i = 0; i < 256; i++) dset(i, 0); dset(VERSION_SLOT, SAVE_VERSION); }\n  loadRooms();\n  // Layers: the room's cells on layer 1 (written into Map RAM by drawRoom), the far wall behind it on layer 2. Layer 0\n  // is the title's lettering on the title, and in a room the darkness (setLayers, each frame)\n  const wl = ART.scenes.wall;\n  bg(1, { mx: 0, my: 0, mw: COLS * 2, mh: ROWS * 2, x: 0, y: -ROOM_Y, wrap: false, show: true });\n  bg(2, { mx: wl.mx, my: wl.my, mw: wl.w, mh: wl.h, x: 0, y: -ROOM_Y, wrap: false, show: true });\n  color(0, 1, 1, 3);\n  if (skipTitle) enterRoom(0); else toTitle();\n}\n\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; confirm = false; paused = false; startRoomPicture(0); play(SONG.title); }\n/** The map of the rooms, on the room last played (or the first not cleared). */\nfunction toMap(n = dget(LAST_SLOT)) { state = 'map'; timer = 0; paused = false; mapSel = openAt(n); startRoomPicture(mapSel); play(SONG.title); }\n/** Can room n be chosen? A room of the four worlds once the one before it is cleared; the Chimney's (the bonus world)\n * once 12 embers are kept, and then one after the other. */\nconst BONUS = 5, BONUS_EMBERS = 12;\nconst WORLD_NAMES = { 1: 'THE DUNGEON', 2: 'THE LABORATORY', 3: 'THE CLOCK TOWER', 4: 'THE ROOFTOPS', 5: 'THE CHIMNEY' };\nfunction embersKept() { let n = 0; for (let v = dget(EMBER_SLOT); v; v >>>= 1) n += v & 1; return n; }\nfunction isOpen(n) {\n  const r = ROOMS[n]; if (!r) return false;\n  const first = n === 0 || ROOMS[n - 1].world !== r.world;\n  if (r.world === BONUS) return embersKept() >= BONUS_EMBERS && (first || isCleared(n - 1));\n  return n === 0 || isCleared(n - 1);\n}\n/** How many rooms can be chosen. */\nfunction openRooms() { let k = 0; for (let n = 0; n < ROOMS.length; n++) if (isOpen(n)) k++; return k; }\n/** The open room nearest to n, going back. */\nfunction openAt(n) { n = Math.max(0, Math.min(n, ROOMS.length - 1)); while (n > 0 && !isOpen(n)) n--; return n; }\n\n/** Write a room's cells into Map RAM: each cell is four tiles of its picture in ART.scenes.cells. */\n// (the pictures, in order: stone, stone lit along its top, a ledge, water, the water's surface, the lantern, lit; then\n// a spout, a steam jet's plate, a crumbling shelf, the rain's grate, a pendulum's pivot)\nconst FIXTURE_ART = { [DRIP]: 7, [JET_U]: 8, [JET_R]: 8, [JET_L]: 8, [RAIN]: 10, [PIVOT]: 11 };\nfunction putCell(cx, cy, k) {\n  const c = ART.scenes.cells;\n  for (let j = 0; j < 2; j++) for (let i = 0; i < 2; i++) mset(cx * 2 + i, cy * 2 + j, k === undefined ? 0 : mget(c.mx + k * 2 + i, c.my + j));\n}\nfunction drawRoom(Rm, lanternLit) {\n  for (let cy = 0; cy < ROWS; cy++) for (let cx = 0; cx < COLS; cx++) {\n    const kind = Rm.cells[cy * COLS + cx], above = cellAt(Rm, cx, cy - 1);\n    putCell(cx, cy, kind === STONE ? (cy && above !== STONE ? 1 : 0) : kind === LEDGE ? 2 : kind === WATER ? (above === WATER ? 3 : 4)\n      : kind === LANTERN ? (lanternLit ? 6 : 5) : kind === CRUMBLE ? 9 : undefined);\n  }\n  for (const f of Rm.fixtures) putCell(f.cx, f.cy, FIXTURE_ART[f.c]);\n  shelvesDrawn = '';\n}\n/** The shelves that have crumbled away are taken out of the picture (and put back when the room starts again). */\nlet shelvesDrawn = '';\nfunction drawShelves() {\n  const gone = Object.keys(wick.cr).filter((k) => !shelfThere(wick, k)).join();\n  if (gone === shelvesDrawn) return;\n  shelvesDrawn = gone;\n  cur.cells.forEach((c, k) => { if (c === CRUMBLE) putCell(k % COLS, Math.floor(k / COLS), gone.split(',').includes(String(k)) ? undefined : 9); });\n}\n/** The hazards that move, at this frame of the try. */\nfunction drawHazards() {\n  const S = ART.sprites, t = wick.t, Y = ROOM_Y;\n  for (const d of cur.drips) { const y = dripAt(d, t); if (y >= 0) sprite(S.drip, d.x - 2, Y + y - 1); }\n  for (const j of cur.jets) {\n    const n = j.len / CELL;\n    if (jetOn(j, t)) for (let k = 0; k < n; k++) sprite((clock >> 2) + k & 1 ? S.steam0 : S.steam1, (j.cx + j.dx * (k + 1)) * CELL, Y + (j.cy + j.dy * (k + 1)) * CELL, { fx: !!(clock & 8) });\n    else if (jetWarn(j, t)) sprite(S.wisp, (j.cx + j.dx) * CELL + 4 + j.dx * (clock % 6), Y + (j.cy + j.dy) * CELL + 4 + j.dy * (clock % 6));\n  }\n  for (const g of cur.gears) { const q = gearAt(g, t); sprite(S.gear, q.x, Y + q.y, { prio: 2 }); }\n  for (const b of cur.bobs) {\n    const q = bobAt(b, t);\n    for (let k = 1; k < 6; k++) sprite(S.link, b.x + (q.x - b.x) * (k / 6) - 4, Y + b.y + (q.y - b.y) * (k / 6) - 4);\n    sprite(S.bob, q.x - 8, Y + q.y - 8);\n  }\n  for (const r of cur.rains) if (rainOn(r, t)) for (let y = 0; y < r.len; y += CELL) sprite((clock >> 1) & 1 ? S.rain0 : S.rain1, r.x - 3, Y + r.y + y);\n  // wind: a streak in each cell of it, going its way\n  cur.cells.forEach((c, k) => { if (c === WIND_L || c === WIND_R) { const u = (clock * 2 + k * 5) % 12; sprite(S.gust, (k % COLS) * CELL + (c === WIND_R ? u : 8 - u), Y + Math.floor(k / COLS) * CELL + 2 + (k * 3) % 9, { fx: c === WIND_L, prio: 2 }); } });\n}\nfunction startRoomPicture(n) { cur = ROOMS[n]; setLook(cur.world); drawRoom(cur, false); wick = newWick(cur); }\n/** Come into room n (from the map, the title or the room before): no soot, no tries yet. */\nfunction enterRoom(n) { soot = []; tries = []; deaths = 0; dset(LAST_SLOT, n); startRoom(n); }\n/** Begin a try at room n: Wick at its start, the clock at nothing until he first moves. */\nfunction startRoom(n) {\n  room = n; startRoomPicture(n);\n  frames = 0; started = false; deadFor = 0; wonFor = 0; lit = false; paused = false; timer = 0; state = 'play';\n  track = [];\n  play(SONG.play);\n}\n/** A try is over (snuffed out, or the lantern lit): keep its path for the replay. */\nfunction endTry(won) {\n  tries.push({ track, won });\n  if (tries.length > TRIES_MAX) tries.splice(0, tries.length - TRIES_MAX); // the oldest go (never the one that won: it is the last)\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused) timer++;\n  if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'map') updateMap();\n  else if (state === 'play') updatePlay();\n  else if (state === 'replay') updateReplay();\n  else if (state === 'result') updateResult();\n  else if (state === 'card') updateCard();\n  else if (state === 'ending') updateEnding();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nconst titleItems = () => (anyProgress() ? ['CONTINUE', 'NEW GAME', 'RECORDS'] : ['NEW GAME']);\nfunction updateTitle() {\n  const items = titleItems();\n  if (pressed(UP) || pressed(DOWN)) { titleSel = confirm ? titleSel ^ 1 : (titleSel + (pressed(UP) ? items.length - 1 : 1)) % items.length; fx(SFX.move); }\n  if (confirm) {\n    if (pressed(B)) { confirm = false; titleSel = 1; fx(SFX.move); }\n    else if (pressed(A) || pressed(START)) { fx(SFX.select); if (titleSel === 1) newGame(); else { confirm = false; titleSel = 0; } }\n    return;\n  }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (items[titleSel] === 'CONTINUE') toMap();\n    else if (items[titleSel] === 'RECORDS') { state = 'records'; timer = 0; }\n    else if (anyProgress()) { confirm = true; titleSel = 0; } // KEEP MY GAME is first\n    else newGame();\n  }\n}\n/** A new game: nothing cleared, no times, no embers; straight into the first room. */\nfunction newGame() { for (let i = 1; i < 256; i++) dset(i, 0); enterRoom(0); }\n\nfunction updateMap() {\n  const before = mapSel;\n  if (pressed(LEFT) && mapSel > 0) mapSel--;\n  if (pressed(RIGHT) && isOpen(mapSel + 1)) mapSel++;\n  if (pressed(UP) || pressed(DOWN) || pressed(L) || pressed(R)) { // the next or the last world: its first room, if it is open\n    const w = WORLDS.indexOf(ROOMS[mapSel].world) + (pressed(DOWN) || pressed(R) ? 1 : -1), to = ROOMS.findIndex((r) => r.world === WORLDS[w]);\n    if (to >= 0 && isOpen(to)) mapSel = to;\n  }\n  if (mapSel !== before) { fx(SFX.move); startRoomPicture(mapSel); }\n  if (pressed(A) || pressed(START)) { fx(SFX.select); enterRoom(mapSel); }\n  else if (pressed(B)) { fx(SFX.move); toTitle(); }\n}\n\n/** The buttons as stepWick takes them. */\nconst padOf = (m) => (m & (1 << LEFT) ? PAD_L : 0) | (m & (1 << RIGHT) ? PAD_R : 0) | (m & (1 << A) ? PAD_A : 0) | (m & (1 << B) ? PAD_B : 0);\n\nfunction updatePlay() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (wick.dead) { if (++deadFor >= T.restart) startRoom(room); return; }\n  if (wick.won) { if (++wonFor >= 40) toReplay(); return; }\n  if (pressed(SELECT)) { if (track.length) endTry(false); startRoom(room); return; }\n  const pad = padOf(inputMask);\n  if (pad) started = true;\n  if (started) frames++;\n  stepWick(wick, pad, cur);\n  if (track.length < TRY_FRAMES * 2) track.push(wick.x, wick.y);\n  if (wick.ev === 'jump' || wick.ev === 'walljump') fx(SFX.move);\n  if (wick.ev === 'land') landT = 6; else if (landT) landT--;\n  if (wick.dead) {\n    deaths++; dset(DEATHS_SLOT, dget(DEATHS_SLOT) + 1); fx(SFX.hit);\n    soot.push({ x: wick.x + 1, y: Math.min(wick.y, ROWS * CELL - 10) + 2 }); if (soot.length > SOOT_MAX) soot.shift();\n    endTry(false);\n  }\n  if (wick.won) { lit = true; drawRoom(cur, true); fx(SFX.record); endTry(true); clearRoom(); }\n}\n/** The lantern is lit: the room is cleared, its best time and its ember kept. */\nfunction clearRoom() {\n  const best = bestOf(room), newBest = !best || frames < best, ember = wick.ember && cur.ember >= 0 && !hasEmber(cur.ember);\n  dset(CLEAR_SLOT + (room >> 5), dget(CLEAR_SLOT + (room >> 5)) | (1 << (room & 31)));\n  if (newBest) dset(BEST_SLOT + room, frames);\n  if (ember) dset(EMBER_SLOT, dget(EMBER_SLOT) | (1 << cur.ember));\n  result = { frames, best, newBest, ember, deaths };\n}\n/** Every try of this visit again, together from the start (when there was more than the one that won). */\nfunction toReplay() {\n  if (tries.length < 2) { state = 'result'; timer = 0; return; }\n  state = 'replay'; timer = 0; replayT = 0; replayEnd = Math.max(...tries.map((t) => t.track.length / 2)) + 30;\n}\nfunction updateReplay() {\n  replayT++;\n  if (replayT >= replayEnd || pressed(A) || pressed(START)) { state = 'result'; timer = 0; }\n}\nfunction updateResult() {\n  if (timer > 15 && (pressed(A) || pressed(START))) {\n    fx(SFX.select);\n    const next = room + 1;\n    if (next < ROOMS.length && ROOMS[next].world === cur.world) enterRoom(next); else { state = 'card'; timer = 0; } // a world's last room: its card\n  } else if (pressed(B)) toMap(room);\n}\n\n// --- A world's end, the ending, the records ---\n\n/** A world's rooms: how many are lit, the total of their best times (0 unless all are lit), its embers kept and in all. */\nfunction worldStats(w) {\n  let lit = 0, of = 0, time = 0, embers = 0, embersOf = 0;\n  ROOMS.forEach((r, i) => { if (r.world !== w) return; of++; if (isCleared(i)) { lit++; time += bestOf(i); } if (r.ember >= 0) { embersOf++; if (hasEmber(r.ember)) embers++; } });\n  return { lit, of, time: lit === of ? time : 0, embers, embersOf };\n}\nconst STORY = 4; // the last world of the story: after it, the ending\n/** The card after a world's last room: A goes to the ending after the story's last world, else to the map. */\nfunction updateCard() {\n  if (timer > 20 && (pressed(A) || pressed(START))) {\n    fx(SFX.select);\n    if (cur.world === STORY) { state = 'ending'; timer = 0; endPage = 0; } else toMap(isOpen(room + 1) ? room + 1 : room);\n  }\n}\n// The ending: a few pages, A for the next; then the title.\nconst ENDING = [\n  ['THE LAST LANTERN IS LIT.', '', 'FROM THE DUNGEON', 'TO THE ROOFTOPS', 'THE CASTLE IS BRIGHT AGAIN.'],\n  ['AND THE SNUFFER?', '', 'IT CAN PUT OUT ONE FLAME.', 'IT CANNOT PUT OUT', 'A CASTLE FULL OF THEM.'],\n  ['WICK', '', 'A GAME FOR THE NOVA-16', '', 'THANK YOU FOR PLAYING'],\n];\nlet endPage = 0;\nfunction updateEnding() {\n  if (timer > 30 && (pressed(A) || pressed(START))) { fx(SFX.select); timer = 0; if (++endPage > ENDING.length) toTitle(); }\n}\nfunction updateRecords() { if (pressed(A) || pressed(B) || pressed(START)) { fx(SFX.move); toTitle(); titleSel = titleItems().indexOf('RECORDS'); } }\n\nconst PAUSE_ITEMS = ['RESUME', 'RESTART ROOM', 'THE MAP'];\nfunction updatePause() {\n  if (pressed(START) || pressed(B)) { paused = false; return; }\n  if (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\n  if (pressed(A)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) { if (track.length && !wick.dead && !wick.won) endTry(false); startRoom(room); }\n    else toMap(room);\n  }\n}\n\n// --- Draw ---\n\n/** Layer 0: the title's lettering; in a room, the darkness, mixed half and half with the room and cut away round Wick\n * and a lit lantern (scanline). */\nfunction setLayers() {\n  const lg = ART.scenes.logo, dk = ART.scenes.dark, title = state === 'title';\n  if (title) bg(0, { mx: lg.mx, my: lg.my, mw: lg.w, mh: lg.h, x: 0, y: -40, wrap: false, show: true });\n  else bg(0, { mx: dk.mx, my: dk.my, mw: 1, mh: 1, x: 0, y: 0, wrap: true, show: true });\n  blend({ layers: title ? ['overlay'] : ['overlay', 'bg0'], half: true }); // (overlay colours from 192 up, GLASS, are see-through too)\n  winmask('bg0', title ? null : { w0: 'in', w1: 'in' });\n}\nconst LIGHT = 44, LANTERN_LIGHT = 30;\n/** Each line: the spans of Wick's light and of a lit lantern's (two circles, their edges ragged so they look soft). */\nfunction scanline(y) {\n  if (state === 'title') return;\n  const span = (n, cx, cy, r) => {\n    const d = y - cy, rr = r + ((y & 1) ? 3 : 0) + ((y & 2) ? -2 : 0);\n    if (d * d >= rr * rr) { winpos(n, 1, 0); return; }\n    const w = flr(sqrt2(rr * rr - d * d)); winpos(n, clamp(cx - w, 0, 255), clamp(cx + w, 0, 255));\n  };\n  if (wick.dead || state === 'map') winpos(0, 1, 0); else span(0, flr(wick.x) + 5, ROOM_Y + flr(wick.y) - 2, LIGHT + (clock % 12 < 6 ? 0 : 2));\n  if (lit && state !== 'map') span(1, cur.lx * CELL + 8, ROOM_Y + cur.ly * CELL + 8, LANTERN_LIGHT + min2(30, wonFor)); else winpos(1, 1, 0);\n}\n// (scanline may only call the console's own maths: these are tables and plain arithmetic)\nconst ROOTS = Array.from({ length: 128 * 128 }, (_, i) => Math.sqrt(i));\nconst sqrt2 = (v) => ROOTS[v > 16383 ? 16383 : v], min2 = (a, b) => (a < b ? a : b);\n\nfunction draw() {\n  cls();\n  setLayers();\n  if (state === 'title') drawTitle();\n  else if (state === 'map') drawMap();\n  else if (state === 'ending') drawEnding();\n  else if (state === 'records') drawRecords();\n  else { drawPlay(); if (state === 'result') drawResult(); if (state === 'card') drawCard(); }\n  if (paused) drawPause();\n}\n\nconst clockText = (f) => `${Math.floor(f / 3600)}:${String(Math.floor(f / 60) % 60).padStart(2, '0')}.${Math.floor((f % 60) / 6)}`;\n\n/** Wick's picture for what he is doing: 32 px, his body the lower middle of it. The flame tells the move: streaming\n * back as he runs, drawn out as he rises, pressed flat as he falls, bent away from a wall he slides on. */\nfunction drawWick() {\n  const S = ART.sprites, x = wick.x - 11, y = ROOM_Y + wick.y - 20;\n  if (wick.dead) { if (deadFor < 14) sprite(S.puff, x, y - deadFor / 2); return; }\n  let f = clock % 16 < 8 ? S.wick0 : S.wick1, flip = wick.face < 0;\n  if (!wick.ground) { if (wick.wall && wick.vy > 0) { f = S.slide; flip = wick.wall < 0; } else f = wick.vy < 0 ? S.jump : S.fall; }\n  else if (landT) f = S.land;\n  else if (Math.abs(wick.vx) > 0.4) f = clock % 10 < 5 ? S.run0 : S.run1;\n  sprite(f, x, y, { fx: flip });\n}\n/** The room's ember (until it is picked up in this try; dim if it was kept before), and the soot of this visit. */\nfunction drawThings() {\n  const S = ART.sprites;\n  if (cur.ember >= 0 && !wick.ember && (!hasEmber(cur.ember) || clock % 4 < 2)) sprite(S.ember, cur.ex * CELL + 4, ROOM_Y + cur.ey * CELL + 4 + (clock % 40 < 20 ? 0 : 1));\n  for (const s of soot) sprite(S.soot, s.x, ROOM_Y + s.y, { prio: 2 });\n  // the Snuffer: waiting where he began until it starts after him, then on his path, bobbing\n  const sn = cur.chase && state === 'play' ? snufferAt(wick) : null;\n  if (sn && (sn.on || clock % 8 < 5)) sprite(S.snuffer, sn.x - 11, ROOM_Y + sn.y - 20 + (clock % 20 < 10 ? 0 : 1));\n}\n/** The replay: every try as a small flame at where it was at this frame; a try that was snuffed out stops there. */\nfunction drawReplay() {\n  const S = ART.sprites;\n  for (const t of tries) {\n    const n = t.track.length / 2, k = Math.min(replayT, n - 1);\n    if (!t.won && replayT >= n + 8) continue;\n    const x = t.track[k * 2], y = t.track[k * 2 + 1];\n    if (t.won) sprite(replayT % 16 < 8 ? S.wick0 : S.wick1, x - 11, ROOM_Y + y - 20);\n    else sprite(S.ember, x + 1, ROOM_Y + y + 2);\n  }\n}\n\nfunction drawPlay() {\n  drawThings(); if (state !== 'card') drawHazards(); drawShelves(); // (a world's card is over the room: nothing moves under it)\n  if (state === 'replay') drawReplay(); else if (state === 'play') drawWick(); else if (state === 'result') sprite(ART.sprites.wick0, wick.x - 11, ROOM_Y + wick.y - 20);\n  rectfill(0, 0, 256, ROOM_Y, SHADOW);\n  txt(`${cur.world}-${cur.n}`, 6, 4, GOLD);\n  txt(clockText(frames), 100, 4, WHITE);\n  txt(`DEATHS ${deaths}`, 168, 4, deaths ? RED : DIM);\n  if (cur.ember >= 0) { if (wick.ember || hasEmber(cur.ember)) rectfill(245, 5, 5, 5, GOLD); else rect(245, 5, 5, 5, DIM); } // the room's ember: found, or its empty place\n  if (state === 'play' && !started && !deaths) { const w = cur.name.length * 8 + 16; panel(128 - w / 2, 22, w, 18); ctxt(cur.name.toUpperCase(), 27, WHITE); } // the room's name, under the strip, until he first moves\n  if (state === 'replay') { panel(56, 198, 144, 18); ctxt(`${tries.length} TRIES   A: ON`, 203, GOLD); }\n}\n\nfunction drawResult() {\n  const r = result;\n  panel(56, 72, 144, 84);\n  ctxt('LIT!', 80, GOLD);\n  ctxt(clockText(r.frames), 96, WHITE);\n  ctxt(r.newBest ? (r.best ? 'A NEW BEST' : 'FIRST TIME') : `BEST ${clockText(r.best)}`, 110, r.newBest ? GREEN : DIM);\n  ctxt(r.deaths ? `${r.deaths} SNUFFED OUT` : 'FIRST TRY', 124, r.deaths ? DIM : GREEN);\n  if (r.ember) ctxt('AN EMBER KEPT', 138, GOLD);\n  if (timer > 15 && clock % 60 < 40) ctxt('A: ON', 160, DIM);\n}\n\n/** The map: the rooms of the chosen room's world in a row, each lit when cleared, with its best time and its ember. */\nfunction drawMap() {\n  const w = ROOMS[mapSel].world, list = ROOMS.map((r, i) => ({ r, i })).filter((x) => x.r.world === w);\n  rectfill(0, 0, 256, ROOM_Y, SHADOW);\n  txt(WORLD_NAMES[w] || `WORLD ${w}`, 6, 4, GOLD);\n  txt(`DEATHS ${dget(DEATHS_SLOT)}`, 160, 4, DIM);\n  panel(8, 150, 240, 66);\n  list.forEach(({ r, i }, k) => {\n    const x = 16 + k * 20, on = i === mapSel, can = isOpen(i);\n    if (on) rectfill(x - 2, 156, 20, 22, PANEL);\n    txt(String(r.n), x + (r.n > 9 ? 0 : 4), 158, !can ? SHADOW : isCleared(i) ? GOLD : WHITE);\n    if (isCleared(i)) rectfill(x + 5, 169, 6, 6, GOLD);            // a lit lantern\n    else if (can) rect(x + 5, 169, 6, 6, DIM);\n    if (r.ember >= 0 && hasEmber(r.ember)) rectfill(x + 13, 169, 2, 2, RED);\n  });\n  const r = ROOMS[mapSel];\n  txt(`${r.world}-${r.n} ${r.name.toUpperCase()}`, 16, 184, WHITE);\n  txt(bestOf(mapSel) ? `BEST ${clockText(bestOf(mapSel))}` : 'NOT LIT YET', 16, 198, bestOf(mapSel) ? GREEN : DIM);\n  txt('A: PLAY', 184, 198, DIM);\n  rectfill(122, 200, 4, 4, RED); txt(`${embersKept()}/${ROOMS.filter((x) => x.ember >= 0).length}`, 130, 198, embersKept() >= BONUS_EMBERS ? GOLD : DIM); // the embers kept, of all there are\n}\n\n/** A world's card: its name, that it is lit, its time and embers, and what comes next. */\nfunction drawCard() {\n  const w = cur.world, st = worldStats(w), next = WORLD_NAMES[w + 1];\n  panel(32, 60, 192, 108);\n  ctxt(WORLD_NAMES[w], 70, GOLD);\n  ctxt(st.lit === st.of ? 'EVERY LANTERN IS LIT' : `${st.lit} OF ${st.of} LANTERNS LIT`, 86, WHITE);\n  if (st.time) ctxt(`BEST TIMES ${clockText(st.time)}`, 102, GREEN);\n  if (st.embersOf) ctxt(`EMBERS ${st.embers} OF ${st.embersOf}`, 116, st.embers === st.embersOf ? GOLD : DIM);\n  ctxt(w === STORY ? 'THE CASTLE IS BRIGHT' : w < STORY ? `NEXT: ${next}` : 'NOTHING IS LEFT IN THE DARK', 134, WHITE);\n  if (timer > 20 && clock % 60 < 40) ctxt('A: ON', 152, DIM);\n}\n/** The ending's pages, then what was done: rooms, embers, deaths, and whether the Chimney is open. */\nfunction drawEnding() {\n  sprite(clock % 16 < 8 ? ART.sprites.wick0 : ART.sprites.wick1, 112, 36);\n  rectfill(0, 80, 256, 144, ART.colors.GLASS); // a band right across: the words are on it, not on the room\n  if (endPage < ENDING.length) ENDING[endPage].forEach((s, i) => ctxt(s, 92 + i * 14, i === 0 ? GOLD : WHITE));\n  else {\n    let lit = 0; for (let i = 0; i < ROOMS.length; i++) if (isCleared(i)) lit++;\n    ctxt(`LANTERNS LIT ${lit} OF ${ROOMS.length}`, 92, WHITE);\n    ctxt(`EMBERS ${embersKept()} OF ${ROOMS.filter((r) => r.ember >= 0).length}`, 106, GOLD);\n    ctxt(`SNUFFED OUT ${dget(DEATHS_SLOT)} TIMES`, 120, DIM);\n    ctxt(embersKept() >= BONUS_EMBERS ? 'THE CHIMNEY IS OPEN' : `${BONUS_EMBERS} EMBERS OPEN THE CHIMNEY`, 140, GREEN);\n  }\n  if (timer > 30 && clock % 60 < 40) ctxt('A: ON', 190, DIM);\n}\n/** The records: a line for each world (lanterns lit, the total of its best times once all are lit, embers), and the deaths. */\nfunction drawRecords() {\n  rectfill(0, 0, 256, ROOM_Y, SHADOW);\n  txt('RECORDS', 6, 4, GOLD);\n  rectfill(0, ROOM_Y, 256, 224 - ROOM_Y, ART.colors.GLASS);\n  txt('LIT   TIME    EMBERS', 88, 36, DIM);\n  WORLDS.forEach((w, k) => {\n    const st = worldStats(w), y = 54 + k * 26;\n    txt(WORLD_NAMES[w] || `WORLD ${w}`, 16, y, st.lit === st.of ? GOLD : WHITE);\n    txt(`${st.lit}/${st.of}`, 88, y + 11, st.lit === st.of ? GOLD : WHITE);\n    txt(st.time ? clockText(st.time) : '-:--.-', 136, y + 11, st.time ? GREEN : DIM);\n    if (st.embersOf) txt(`${st.embers}/${st.embersOf}`, 200, y + 11, st.embers === st.embersOf ? GOLD : DIM);\n  });\n  txt(`SNUFFED OUT ${dget(DEATHS_SLOT)} TIMES`, 16, 186, DIM);\n  ctxt('B: BACK', 206, DIM);\n}\n\nfunction drawTitle() {\n  drawWick();\n  if (confirm) {\n    panel(40, 124, 176, 60);\n    ctxt('START A NEW GAME?', 132, WHITE); ctxt('YOUR ROOMS WILL BE LOST', 144, DIM);\n    ['KEEP MY GAME', 'START AGAIN'].forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 72, 158 + i * 12, i === titleSel ? WHITE : DIM));\n    return;\n  }\n  const items = titleItems();\n  panel(56, 132, 144, 24 + items.length * 14);\n  items.forEach((s, i) => txt(`${i === titleSel ? '> ' : '  '}${s}`, 80, 142 + i * 14, i === titleSel ? WHITE : DIM));\n}\n\nfunction drawPause() {\n  panel(64, 72, 128, 76);\n  ctxt('PAUSED', 80, GOLD);\n  PAUSE_ITEMS.forEach((s, i) => txt(`${i === pauseSel ? '> ' : '  '}${s}`, 76, 98 + i * 14, i === pauseSel ? WHITE : DIM));\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.GLASS); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\n",

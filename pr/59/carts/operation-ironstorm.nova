{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Operation Ironstorm",
    "author": "Independent Game Project",
    "description": "A jungle run-and-gun: jump the pits, fight through riflemen and heavy troopers, pick up five weapons (rifle, spread, rapid, laser, rocket) and take down the fortress commander. One checkpoint and three lives."
  },
  "label": "",
  "code": "// OPERATION IRONSTORM — Jungle Breach\n// Original NOVA-16 run-and-gun cartridge. All gameplay and drawing are self-contained.\n// Controls: arrows move/aim, X jump, Z fire, S cycle weapon, Enter pause/start.\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"b_crouch\": {\"pal\": 0, \"size\": 32, \"tile\": 712}, \"b_idle\": {\"pal\": 0, \"size\": 32, \"tile\": 640}, \"b_jump\": {\"pal\": 0, \"size\": 32, \"tile\": 708}, \"b_run0\": {\"pal\": 0, \"size\": 32, \"tile\": 644}, \"b_run1\": {\"pal\": 0, \"size\": 32, \"tile\": 648}, \"b_run2\": {\"pal\": 0, \"size\": 32, \"tile\": 652}, \"b_run3\": {\"pal\": 0, \"size\": 32, \"tile\": 704}, \"boss_bl\": {\"pal\": 3, \"size\": 32, \"tile\": 908}, \"boss_br\": {\"pal\": 3, \"size\": 32, \"tile\": 960}, \"boss_tl\": {\"pal\": 3, \"size\": 32, \"tile\": 900}, \"boss_tr\": {\"pal\": 3, \"size\": 32, \"tile\": 904}, \"g_did\": {\"pal\": 0, \"size\": 16, \"tile\": 768}, \"g_diu\": {\"pal\": 0, \"size\": 16, \"tile\": 748}, \"g_dn\": {\"pal\": 0, \"size\": 16, \"tile\": 750}, \"g_lvl\": {\"pal\": 0, \"size\": 16, \"tile\": 716}, \"g_up\": {\"pal\": 0, \"size\": 16, \"tile\": 718}, \"hvy0\": {\"pal\": 2, \"size\": 32, \"tile\": 776}, \"hvy1\": {\"pal\": 2, \"size\": 32, \"tile\": 832}, \"hvy2\": {\"pal\": 2, \"size\": 32, \"tile\": 840}, \"hvy3\": {\"pal\": 2, \"size\": 32, \"tile\": 896}, \"rif0\": {\"pal\": 1, \"size\": 32, \"tile\": 772}, \"rif1\": {\"pal\": 1, \"size\": 32, \"tile\": 780}, \"rif2\": {\"pal\": 1, \"size\": 32, \"tile\": 836}, \"rif3\": {\"pal\": 1, \"size\": 32, \"tile\": 844}},\n  scenes: {\"mid\": {\"h\": 28, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 64}, \"near\": {\"h\": 28, \"mx\": 96, \"my\": 0, \"pal\": 3, \"w\": 64}, \"sky\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}},\n  colors: {\"bossCore\": 184, \"em1\": 101, \"em2\": 102, \"em3\": 103, \"em4\": 104, \"ember\": 127, \"flash\": 106, \"grass\": 114, \"grassDk\": 115, \"grassHi\": 113, \"logoSh\": 105, \"night\": 107, \"pit\": 125, \"soil\": 117, \"soilDeep\": 119, \"soilDk\": 118, \"soilHi\": 116, \"st1\": 97, \"st2\": 98, \"st3\": 99, \"st4\": 100, \"stake\": 126, \"stone\": 120, \"stoneHi\": 121, \"water1\": 40, \"water2\": 41, \"water3\": 42, \"wood\": 122, \"woodDk\": 124, \"woodHi\": 123},\n};\n// END ART\n\nconst C = { black:1, shadow:2, purple:3, brown:4, green:5, red:6, grey:7, blue:8, orange:9, silver:10, lime:11, skin:12, cyan:13, yellow:14, white:15 };\nconst WORLD_W = 2240, FLOOR = 190, GRAVITY = 0.30;\nconst JUMP_VELOCITY = -6.1;\nconst WEAPONS = [\n  {name:'RIFLE', rate:9, speed:4.4, damage:1, color:C.yellow, kind:'normal'},\n  {name:'SPREAD', rate:18, speed:3.8, damage:1, color:C.orange, kind:'spread'},\n  {name:'RAPID', rate:3, speed:5.2, damage:1, color:C.cyan, kind:'rapid'},\n  {name:'LASER', rate:12, speed:7.5, damage:2, color:C.white, kind:'laser'},\n  {name:'ROCKET', rate:28, speed:3.2, damage:4, color:C.red, kind:'rocket'}\n];\nconst platforms = [\n  {x:220,y:151,w:76},{x:360,y:145,w:70},{x:505,y:157,w:95},{x:690,y:148,w:90},\n  {x:850,y:155,w:76},{x:1070,y:146,w:100},{x:1240,y:157,w:90},{x:1430,y:144,w:100},\n  {x:1590,y:155,w:84},{x:1770,y:145,w:100},\n  // Intentional stepping bridges: every major pit has a reachable route across it.\n  {x:435,y:158,w:40,bridge:true},{x:775,y:158,w:40,bridge:true},{x:980,y:158,w:40,bridge:true},\n  {x:1330,y:158,w:40,bridge:true},{x:1690,y:158,w:40,bridge:true}\n];\nconst pits = [[430,480],[770,820],[970,1025],[1320,1375],[1680,1735]];\nconst enemySeeds = [\n  [280,190,'rifle'],[405,190,'rifle'],[555,190,'heavy'],[645,190,'rifle'],[735,190,'rifle'],\n  [895,190,'heavy'],[1110,190,'rifle'],[1190,190,'rifle'],[1285,190,'heavy'],[1480,190,'rifle'],\n  [1540,190,'rifle'],[1635,190,'heavy'],[1810,190,'rifle'],[1900,190,'rifle']\n];\nlet state='title', paused=false, frame=0, cam=0, score=0, lives=3, checkpoint=0, boss=null, wasPaused=false;\nlet p, enemies=[], bullets=[], ebullets=[], pickups=[], particles=[], fireT=0, weapon=0, invuln=0, message='', messageT=0, deathT=0;\n\nfunction freshPlayer(x=36) { return {x,y:156,vx:0,vy:0,w:12,h:20,health:5,face:1,onGround:false,crouch:false}; }\nfunction startGame(fromCheckpoint=false) {\n  if (!fromCheckpoint) { score=0; lives=3; checkpoint=0; weapon=0; }\n  p=freshPlayer(fromCheckpoint?checkpoint:36); cam=Math.max(0,p.x-70); bullets=[]; ebullets=[]; particles=[]; fireT=0; invuln=48; wasPaused=false;\n  play(0);\n  enemies=enemySeeds.filter(e=>e[0]>=p.x+20).map((e,i)=>({x:e[0],y:e[1],type:e[2],health:e[2]==='heavy'?6:3,dir:i%2? -1:1,shot:35+(i*13)%70,alive:true,home:e[0],hit:0}));\n  pickups=[{x:330,y:115,weapon:1,taken:false},{x:735,y:118,weapon:2,taken:false},{x:1175,y:117,weapon:3,taken:false},{x:1510,y:112,weapon:4,taken:false}];\n  boss=null; state='play'; paused=false; message='JUNGLE BREACH'; messageT=90;\n}\nfunction setMessage(s,n=90){message=s;messageT=n;}\n// The music, in one place: 0 the jungle, 1 the title, 2 the fortress commander, 3 mission complete (once), 4 mission failed (once).\nlet song=-1;\nfunction play(n){if(n!==song){song=n;music(n);}}\nfunction key(b){return btn(b);}\nfunction pressed(b){return btnp(b);}\nfunction hitBox(a,b){return a.x < b.x+b.w && a.x+a.w > b.x && a.y < b.y+b.h && a.y+a.h > b.y;}\nfunction groundedAt(x,y){\n  if (y>=FLOOR && !pits.some(q=>x+p.w/2>q[0]&&x+p.w/2<q[1])) return FLOOR;\n  for(const q of platforms) if(x+p.w>q.x&&x<q.x+q.w&&y<=q.y&&y+5>=q.y) return q.y;\n  return null;\n}\nfunction shoot(){\n  if(fireT>0)return; const w=WEAPONS[weapon]; fireT=w.rate;\n  sfx(weapon===4?6:weapon===3?7:weapon===1?8:weapon===2?9:0);\n  const sx=p.x+p.w/2+p.face*8, sy=p.y+9;\n  let dx=p.face,dy=0;\n  if(key(UP)) {dy=-1; if(key(p.face>0?RIGHT:LEFT)) {dx=p.face;dy=-0.65;} else dx=0;}\n  else if(key(DOWN)&&!p.onGround){dy=1; if(key(p.face>0?RIGHT:LEFT)){dx=p.face;dy=0.65;}else dx=0;}\n  if(key(DOWN)&&p.onGround){p.crouch=true;}\n  const add=(vx,vy)=>bullets.push({x:sx,y:sy,vx,vy,damage:w.damage,color:w.color,kind:w.kind,life:90});\n  if(w.kind==='spread'){add(dx*w.speed,dy*w.speed-0.34);add(dx*w.speed,dy*w.speed);add(dx*w.speed,dy*w.speed+0.34);}\n  else add(dx*w.speed,dy*w.speed);\n  if(weapon===4) particles.push({x:sx,y:sy,life:9,color:C.orange});\n}\nfunction hurt(amount=1){if(invuln>0||state!=='play')return;p.health-=amount;invuln=70;sfx(2);for(let i=0;i<9;i++)particles.push({x:p.x+6,y:p.y+10,vx:(Math.random()-.5)*2,vy:(Math.random()-.8)*2,life:22,color:C.red});if(p.health<=0){lives--;state='dying';deathT=55;sfx(5);setMessage('WOUNDED',55);}}\nfunction fallIntoPit(){if(state!=='play')return; lives--;p.health=0;state='dying';deathT=55;invuln=0;sfx(5);spawnExplosion(p.x+6,p.y+12,true);setMessage('LOST IN THE PIT',55);}\nfunction spawnExplosion(x,y,big=false){for(let i=0;i<(big?20:8);i++)particles.push({x,y,vx:(Math.random()-.5)*(big?4:2.5),vy:(Math.random()-.5)*(big?4:2.5),life:big?32:18,color:[C.yellow,C.orange,C.red,C.white][i%4]});}\nfunction update(){frame++;\n  if(state==='title'){if(pressed(A)||pressed(B)||pressed(START)||pressed(SELECT))startGame();return;}\n  if(state==='victory'||state==='gameover'){if(pressed(A)||pressed(B)||pressed(START)||pressed(SELECT)){state='title';play(1);}return;}\n  if(state==='dying'){deathT--;updateParticles();if(deathT<=0){if(lives<=0){state='gameover';play(4);}else startGame(true);}return;}\n  if(pressed(START)){paused=!paused;if(paused){music(-1);wasPaused=true;}else music(song);}\n  if(paused){return;}\n  if(state!=='play')return;\n  if(fireT>0)fireT--; if(invuln>0)invuln--; if(messageT>0)messageT--;\n  p.crouch=key(DOWN)&&p.onGround;\n  p.vx=0; if(key(LEFT)){p.vx=-1.65;p.face=-1;} if(key(RIGHT)){p.vx=1.65;p.face=1;}\n  if(pressed(A)&&p.onGround){p.vy=JUMP_VELOCITY;p.onGround=false;sfx(1);}\n  if(pressed(X)||pressed(SELECT)||pressed(Y)){weapon=(weapon+1)%WEAPONS.length;setMessage('WEAPON: '+WEAPONS[weapon].name,45);}\n  if(key(B))shoot();\n  p.x=Math.max(0,Math.min(WORLD_W-p.w,p.x+p.vx));\n  const oldY=p.y; p.vy=Math.min(6.5,p.vy+GRAVITY);p.y+=p.vy;p.onGround=false;\n  if(p.vy>=0){let landing=null; if(p.y+p.h>=FLOOR&&!pits.some(q=>p.x+p.w/2>q[0]&&p.x+p.w/2<q[1]))landing=FLOOR;\n    for(const q of platforms)if(p.x+p.w>q.x&&p.x<q.x+q.w&&oldY+p.h<=q.y+2&&p.y+p.h>=q.y&&(!landing||q.y<landing))landing=q.y;\n    if(landing!==null){p.y=landing-p.h;p.vy=0;p.onGround=true;}\n  }\n  // Pit falls bypass temporary damage invulnerability: a fall is always fatal.\n  if(p.y>FLOOR+24){fallIntoPit();return;}\n  p.x=Math.min(WORLD_W-p.w,p.x);cam=Math.max(0,Math.min(WORLD_W-256,p.x-72));\n  // Collect weapons and activate checkpoint.\n  for(const q of pickups)if(!q.taken&&Math.abs((p.x+6)-q.x)<13&&Math.abs((p.y+10)-q.y)<20){q.taken=true;weapon=q.weapon;setMessage('PICKUP: '+WEAPONS[weapon].name,75);score+=100;}\n  if(p.x>=1035&&checkpoint<1035){checkpoint=1035;sfx(4);setMessage('CHECKPOINT ACTIVATED',100);}\n  // Enemies patrol locally and fire aimed shots.\n  for(const e of enemies){if(!e.alive)continue;e.hit=Math.max(0,e.hit-1);\n    // Aggressive: chase when player is close, otherwise patrol\n    const dist=Math.abs(e.x-p.x);\n    const heavy=e.type==='heavy';\n    if(dist<160){\n      // chase / face player\n      e.dir = p.x < e.x ? -1 : 1;\n      e.x += e.dir * (heavy ? 0.55 : 0.85);\n      // keep near home a bit so they don't all clump\n      if(Math.abs(e.x-e.home)>80) e.x += (e.home-e.x)*0.02;\n    } else {\n      e.x += e.dir * (heavy ? 0.35 : 0.55);\n      if(Math.abs(e.x-e.home)>32) e.dir *= -1;\n    }\n    // Shoot faster, more accurately, sometimes bursts\n    e.shot--;\n    if(e.shot<=0 && dist<250){\n      let dx=p.x-e.x, dy=(p.y+8)-(e.y-8);\n      let d=Math.max(1,Math.hypot(dx,dy));\n      // lead the target slightly when player is moving\n      dx += p.vx * 8;\n      d=Math.max(1,Math.hypot(dx,dy));\n      const spd = heavy ? 1.7 : 2.1;\n      ebullets.push({x:e.x+(e.dir>0?12:0), y:e.y-10, vx:dx/d*spd, vy:dy/d*spd, life:160});\n      // heavy sometimes fires a 3-round burst\n      if(heavy && Math.random()<0.45){\n        ebullets.push({x:e.x+(e.dir>0?12:0), y:e.y-12, vx:dx/d*spd*0.9, vy:dy/d*spd-0.25, life:140});\n        ebullets.push({x:e.x+(e.dir>0?12:0), y:e.y-8,  vx:dx/d*spd*0.9, vy:dy/d*spd+0.25, life:140});\n      }\n      e.shot = heavy ? (35 + Math.floor(Math.random()*25)) : (48 + Math.floor(Math.random()*35));\n    }\n    if(hitBox({x:p.x,y:p.y,w:p.w,h:p.h},{x:e.x-5,y:e.y-20,w:18,h:22}))hurt();\n  }\n  for(const b of bullets){b.x+=b.vx;b.y+=b.vy;b.life--;for(const e of enemies){if(!e.alive)continue;if(b.x>e.x-5&&b.x<e.x+13&&b.y>e.y-20&&b.y<e.y){e.health-=b.damage;e.hit=5;b.life=0;if(e.health<=0){e.alive=false;score+=e.type==='heavy'?250:100;sfx(3);spawnExplosion(e.x+5,e.y-10);}}}\n    if(b.kind==='rocket'&&b.life<=0){for(const e of enemies)if(e.alive&&Math.hypot(e.x-b.x,e.y-b.y)<30){e.health-=2;if(e.health<=0){e.alive=false;score+=150;}}spawnExplosion(b.x,b.y);}\n    if(b.x<cam-20||b.x>cam+280||b.y<0||b.y>230)b.life=0;\n  }\n  bullets=bullets.filter(b=>b.life>0);\n  for(const b of ebullets){b.x+=b.vx;b.y+=b.vy;b.life--;if(hitBox({x:b.x-2,y:b.y-2,w:4,h:4},p)){b.life=0;hurt();}if(b.x<cam-20||b.x>cam+280)b.life=0;}ebullets=ebullets.filter(b=>b.life>0);\n  // The boss enters once the player reaches the fortress.\n  if(p.x>1940&&!boss){boss={x:2055,y:133,health:55,max:55,shot:40,phase:0,hit:0};enemies.forEach(e=>e.alive=false);setMessage('FORTRESS COMMANDER',100);play(2);}\n  if(boss){boss.hit=Math.max(0,boss.hit-1);boss.shot--;boss.phase++;\n    // hover + occasional dive\n    const dive = (boss.phase % 180) > 140;\n    boss.y = dive ? (120 + Math.sin(boss.phase/6)*18) : (128 + Math.sin(boss.phase/20)*8);\n    // face / track player a bit\n    if(p.x < boss.x - 10) boss.x -= 0.4;\n    else if(p.x > boss.x + 10) boss.x += 0.35;\n    boss.x = Math.max(1900, Math.min(2100, boss.x));\n    if(boss.shot<=0){\n      const hpRatio = boss.health / boss.max;\n      // spread aimed at player\n      let dx=p.x-boss.x, dy=(p.y+6)-boss.y;\n      let d=Math.max(1,Math.hypot(dx,dy));\n      const baseSpd = 2.0 + (1-hpRatio)*0.8;\n      for(let i=-2;i<=2;i++){\n        ebullets.push({x:boss.x-8, y:boss.y+12, vx:(dx/d)*baseSpd + i*0.35, vy:(dy/d)*baseSpd + i*0.15, life:200});\n      }\n      // low health: extra ring + faster fire\n      if(hpRatio < 0.45){\n        for(let i=0;i<6;i++){\n          const a = (boss.phase/10 + i*1.05);\n          ebullets.push({x:boss.x, y:boss.y+10, vx:Math.cos(a)*1.8, vy:Math.sin(a)*1.8, life:150});\n        }\n      }\n      boss.shot = hpRatio < 0.3 ? 22 : (hpRatio < 0.6 ? 34 : 48);\n    }\n    for(const b of bullets)if(b.life>0&&b.x>boss.x-27&&b.x<boss.x+24&&b.y>boss.y-18&&b.y<boss.y+35){boss.health-=b.damage;b.life=0;boss.hit=4;if(b.kind==='rocket')spawnExplosion(b.x,b.y);}\n    if(boss.health<=0){spawnExplosion(boss.x,boss.y,true);score+=5000;sfx(10);play(3);boss=null;state='victory';}\n    if(boss&&hitBox(p,{x:boss.x-24,y:boss.y-18,w:48,h:52}))hurt();\n  }\n  updateParticles();\n}\nfunction updateParticles(){for(const a of particles){a.x+=(a.vx||0);a.y+=(a.vy||0);a.vy=(a.vy||0)+.04;a.life--;}particles=particles.filter(a=>a.life>0);}\nfunction draw(){cls();\n  if(state==='title'){drawTitle();return;}\n  drawWorld();\n  if(state==='dying'){if(frame%8<4)txt('DOWN!',103,95,C.white);}\n  if(state==='victory'){panel(31,65,194,95);ctxt('MISSION COMPLETE',82,C.yellow);ctxt('JUNGLE BREACH CLEARED',101,C.white);ctxt('SCORE '+score,119,C.cyan);ctxt('PRESS X TO TITLE',141,C.white);}\n  if(state==='gameover'){panel(45,72,166,78);ctxt('MISSION FAILED',89,C.red);ctxt('SCORE '+score,109,C.white);ctxt('PRESS X TO TITLE',130,C.white);}\n  if(paused){panel(72,77,112,70);ctxt('PAUSED',91,C.yellow);ctxt('ENTER TO RESUME',112,C.white);ctxt('S / X TO CHANGE WEAPON',128,C.grey);}\n}\n// ===== Drawing (the art is made by art.py: the layers, the sprites and the colours) =====\n// BG0 the near jungle, BG1 the misty jungle, BG2 the sky: each scrolls at its own share of the camera.\nconst LAYERS = [['near', 0.6], ['mid', 0.3], ['sky', 0.08]];\nconst K = ART.colors, FLASH = 4;\nlet LOGO = null, WATER = null, CORE = null;\nfunction setLayers() {\n  for (let i = 0; i < 3; i++) {\n    const s = ART.scenes[LAYERS[i][0]];\n    bg(i, { mx: s.mx, my: s.my, mw: s.w, mh: s.h, wrap: true, show: true });\n  }\n}\nfunction scrollLayers(x) { for (let i = 0; i < 3; i++) bgscroll(i, Math.floor(x * LAYERS[i][1]), 0); }\n// Colour animation: the waterfall's three blues turn round (the water falls); the boss's core pulses.\nfunction animateColours() {\n  const ph = Math.floor(frame / 5) % 3;\n  for (let k = 0; k < 3; k++) color(WATER.at[k], ...WATER.rgb[(k + ph) % 3]);\n  const glow = (Math.sin(frame / 5) + 1) / 2;\n  color(K.bossCore, ...CORE.map((v, i) => Math.round(v + (31 - v) * glow * (i === 2 ? 0.8 : 0.5))));\n}\nfunction hs(n) { n = Math.imul(n ^ (n >>> 15), 0x2c1b3c6d); n = Math.imul(n ^ (n >>> 12), 0x297a2d39); return (n ^ (n >>> 15)) >>> 0; }\nfunction sprite(name, x, y, fx, pal) {\n  const s = ART.sprites[name];\n  spr(s.tile, Math.round(x), Math.round(y), { size: s.size, pal: pal === undefined ? s.pal : pal, fx, prio: 3 });\n}\n\nfunction drawTitle() {\n  scrollLayers(frame * 0.6);\n  animateColours();\n  // a dark band behind the logo, so it reads against the sunset\n  for (let y = 16; y < 84; y++) if (y % 2 || (y > 22 && y < 76 && y % 4 === 0)) rectfill(0, y, 256, 1, K.night);\n  bigWord(0, 22, 2, [K.st1, K.st1, K.st2, K.st2, K.st3, K.st3, K.st4, K.st4]);\n  bigWord(1, 44, 3, [K.em1, K.em1, K.em2, K.em2, K.em3, K.em3, K.em4, K.em4]);\n  ctxt('JUNGLE BREACH', 84, C.lime);\n  // the commando on a rock, the jungle floor\n  rectfill(0, 182, 256, 42, K.soil); rectfill(0, 182, 256, 2, K.grassHi); rectfill(0, 184, 256, 3, K.grass); rectfill(0, 187, 256, 1, K.grassDk);\n  for (let x = 0; x < 256; x += 8) rectfill(x + (hs(x) % 4), 180, 2, 2 + hs(x * 3) % 3, K.grass);\n  rectfill(98, 166, 60, 16, K.stone); rectfill(100, 164, 56, 3, K.stoneHi); rectfill(98, 178, 60, 4, K.soilDk);\n  drawHero(116, 144, 1, false, 0, false, false);\n  ctxt('ARROWS MOVE AND AIM', 192, C.white);\n  ctxt('X JUMP   Z FIRE   S WEAPON', 203, C.white);\n  if (frame % 60 < 42) ctxt('PRESS ENTER', 214, C.yellow);\n}\n// The title's words, from the console font scaled up: a drop shadow, an outline, a colour ramp and a shine that sweeps across.\nfunction buildLogo() {\n  LOGO = ['OPERATION', 'IRONSTORM'].map((w) => {\n    cls(); print(w, 0, 0, 15);\n    const px = [];\n    for (let y = 0; y < 8; y++) for (let x = 0; x < w.length * 8; x++) if (pget(x, y)) px.push(x, y);\n    return { w: w.length * 8, px };\n  });\n  cls();\n}\nfunction bigWord(i, y0, s, ramp) {\n  const L = LOGO[i], x0 = 128 - (L.w * s) / 2, shine = (frame * 3) % 400 - 60;\n  for (let k = 0; k < L.px.length; k += 2) rectfill(x0 + L.px[k] * s + 2, y0 + L.px[k + 1] * s + 3, s, s, K.logoSh);\n  for (let k = 0; k < L.px.length; k += 2) rectfill(x0 + L.px[k] * s - 1, y0 + L.px[k + 1] * s - 1, s + 2, s + 2, C.black);\n  for (let k = 0; k < L.px.length; k += 2) {\n    const x = x0 + L.px[k] * s, y = L.px[k + 1];\n    const lit = Math.abs(x - shine + y * s * 0.5) < 6;\n    rectfill(x, y0 + y * s, s, s, lit ? K.flash : ramp[y]);\n  }\n}\n\nfunction drawWorld() {\n  scrollLayers(cam);\n  animateColours();\n  const t = frame;\n  for (let i = 0; i < 5; i++) {                       // birds crossing the sunset\n    const x = Math.floor(((i * 59 - t * 0.22) % 280 + 280) % 280), y = 46 + (i % 3) * 12 + Math.floor(Math.sin(t / 12 + i) * 2);\n    const wing = Math.floor(t / 8 + i) % 2;\n    pset(x, y, C.black); pset(x - 1, y - wing, C.black); pset(x + 1, y - wing, C.black); pset(x - 2, y - 1 + wing, C.black); pset(x + 2, y - 1 + wing, C.black);\n  }\n  drawGround();\n  drawPlatforms();\n  drawPickups();\n  for (const e of enemies) { if (!e.alive) continue; drawEnemy(e.x - cam, e.y, e.type, e.dir, e.hit); }\n  if (boss) drawBoss(boss.x - cam, boss.y, boss.hit);\n  for (const b of bullets) {\n    const x = b.x - cam;\n    if (b.kind === 'rocket') { circfill(x - Math.sign(b.vx) * 3, b.y, 2, K.ember); circfill(x, b.y, 3, C.orange); circfill(x, b.y, 1, C.yellow); }\n    else if (b.kind === 'laser') { rectfill(x - 4, b.y - 1, 9, 3, C.cyan); rectfill(x - 3, b.y, 7, 1, C.white); }\n    else { circfill(x, b.y, 2, b.color); pset(x, b.y, C.white); }\n  }\n  for (const b of ebullets) { circfill(b.x - cam, b.y, 2, C.red); circfill(b.x - cam, b.y, 1, K.ember); pset(b.x - cam, b.y, C.white); }\n  for (const a of particles) { pset(a.x - cam, a.y, a.color); if (a.life > 12) pset(a.x - cam + 1, a.y, a.color); if (a.life % 3 === 0) pset(a.x - cam, a.y - 1, C.white); }\n  for (let i = 0; i < 12; i++) {                      // fireflies\n    const x = Math.floor(((i * 39 + t * 0.3) % 280 + 280) % 280), y = 140 + ((i * 17) % 40) + Math.floor(Math.sin(t / 20 + i) * 3);\n    if (Math.floor(t / 13 + i) % 3) pset(x, y, C.yellow);\n  }\n  if (state !== 'dying' || frame % 8 < 4) drawHero(p.x - cam, p.y, p.face, p.crouch, invuln > 0 && frame % 8 < 4, !p.onGround, (key(LEFT) || key(RIGHT)) && p.onGround);\n  for (let i = 0; i < 20; i++) {                      // grass in front of the feet\n    const x = Math.floor(((i * 17 - cam) % 280 + 280) % 280), wx = x + cam;\n    if (!pits.some((q) => wx > q[0] && wx < q[1])) { rectfill(x, FLOOR - 3, 1, 3, K.grass); rectfill(x + 2, FLOOR - 2, 1, 2, K.grassHi); rectfill(x + 4, FLOOR - 4, 1, 4, K.grassDk); }\n  }\n  drawHud();\n  if (messageT > 0 && message) { panel(52, 30, 152, 19); ctxt(message, 36, C.yellow); }\n}\n\n// The jungle floor: grass, then soil with stones and roots, all fixed to the world (keyed to world x); the pits are chasms with stakes.\nfunction drawGround() {\n  rectfill(0, FLOOR, 256, 34, K.soil);\n  rectfill(0, FLOOR, 256, 1, K.grassHi); rectfill(0, FLOOR + 1, 256, 2, K.grass); rectfill(0, FLOOR + 3, 256, 1, K.grassDk);\n  rectfill(0, FLOOR + 4, 256, 2, K.soilHi);\n  rectfill(0, FLOOR + 20, 256, 6, K.soilDk); rectfill(0, FLOOR + 26, 256, 8, K.soilDeep);\n  const c0 = Math.floor(cam / 16);\n  for (let c = c0; c < c0 + 18; c++) {\n    const x = c * 16 - cam, h = hs(c);\n    rectfill(x + (h % 12), FLOOR + 4, 2, 2 + (h >> 4) % 3, K.grassDk);                       // grass hanging over the edge\n    if (h % 3 === 0) { const sx = x + (h >> 6) % 10, sy = FLOOR + 9 + (h >> 9) % 8; rectfill(sx, sy, 6, 4, K.stone); rectfill(sx + 1, sy, 4, 1, K.stoneHi); rectfill(sx, sy + 4, 6, 1, K.soilDk); }\n    if (h % 5 === 1) { const rx = x + (h >> 7) % 12; for (let k = 0; k < 8; k++) pset(rx + Math.floor(Math.sin(k + c) * 2), FLOOR + 8 + k, K.soilDk); }\n    if (h % 7 === 2) rectfill(x + (h >> 5) % 13, FLOOR + 22 + (h >> 8) % 6, 3, 2, K.soil);\n  }\n  for (const q of pits) {\n    const x0 = q[0] - cam, w = q[1] - q[0];\n    if (x0 > 256 || x0 + w < 0) continue;\n    rectfill(x0, FLOOR, w, 34, K.pit);\n    rectfill(x0, FLOOR, 2, 34, K.soilHi); rectfill(x0 + w - 2, FLOOR, 2, 34, K.soilDk);       // the walls, lit from the right\n    rectfill(x0 - 1, FLOOR, 1, 4, K.grassDk); rectfill(x0 + w, FLOOR, 1, 4, K.grassDk);\n    for (let s = 4; s < w - 4; s += 6) {                                                         // stakes at the bottom\n      for (let k = 0; k < 8; k++) rectfill(x0 + s + (k >> 2), FLOOR + 26 - k, Math.max(1, 3 - (k >> 2)), 1, k > 5 ? K.stake : K.woodDk);\n    }\n    const glow = Math.floor(frame / 10) % 2;                                                     // warning posts at the edges\n    for (const px of [x0 - 6, x0 + w + 3]) { rectfill(px, FLOOR - 9, 2, 9, K.woodDk); rectfill(px - 1, FLOOR - 11, 4, 3, glow ? C.red : K.ember); }\n  }\n}\n// Ledges of earth and grass with roots beneath; the bridges are planks on rope.\nfunction drawPlatforms() {\n  for (const q of platforms) {\n    const sx = q.x - cam;\n    if (sx < -q.w || sx > 256) continue;\n    if (q.bridge) {\n      for (let b = 0; b < q.w; b += 5) { rectfill(sx + b, q.y, 4, 3, K.wood); rectfill(sx + b, q.y, 4, 1, K.woodHi); rectfill(sx + b, q.y + 3, 4, 1, K.woodDk); }\n      line(sx - 2, q.y - 4, sx + q.w + 1, q.y - 4, K.stake);\n      for (const px of [sx - 2, sx + q.w]) rectfill(px, q.y - 6, 2, 10, K.woodDk);\n      for (let b = 2; b < q.w; b += 10) line(sx + b, q.y - 4, sx + b, q.y, K.stake);\n    } else {\n      rectfill(sx, q.y, q.w, 7, K.soil); rectfill(sx, q.y + 3, q.w, 2, K.soilHi);\n      rectfill(sx, q.y, q.w, 1, K.grassHi); rectfill(sx, q.y + 1, q.w, 2, K.grass);\n      rectfill(sx + 2, q.y + 7, q.w - 4, 2, K.soilDk); rectfill(sx + 6, q.y + 9, q.w - 12, 2, K.soilDeep);\n      for (let k = 6; k < q.w - 4; k += 9) rectfill(sx + k, q.y + 9, 1, 3 + (k % 4), K.grassDk);   // roots and moss hanging\n      rectfill(sx, q.y + 1, 1, 6, K.soilDk); rectfill(sx + q.w - 1, q.y + 1, 1, 6, K.soilHi);\n    }\n  }\n}\n// The weapon capsules (they were not drawn before): a winged capsule with the weapon's letter, bobbing.\nfunction drawPickups() {\n  for (const q of pickups) {\n    if (q.taken) continue;\n    const x = q.x - cam, y = q.y + Math.floor(Math.sin(frame / 10 + q.x) * 2);\n    if (x < -12 || x > 268) continue;\n    const flap = Math.floor(frame / 6) % 2;\n    rectfill(x - 9, y - 2 + flap, 4, 2, C.silver); rectfill(x + 6, y - 2 + flap, 4, 2, C.silver);\n    circfill(x, y, 5, C.black); circfill(x, y, 4, C.red); circfill(x - 1, y - 1, 2, C.orange);\n    print('.SRLM'[q.weapon], x - 3, y - 3, C.white);\n  }\n}\n// The commando: the body for the pose, and over it the arm and rifle for the aim, with a muzzle flash when firing.\nfunction drawHero(x, y, face, crouch, blink, airborne, moving) {\n  if (blink) return;\n  const bx = x + 6 - 16, by = y + 20 - 31, fx = face < 0;\n  rectfill(x - 1, y + 20, 14, 1, K.soilDk);\n  let pose = 'b_idle', bob = 0;\n  if (crouch) pose = 'b_crouch';\n  else if (airborne) pose = 'b_jump';\n  else if (moving) pose = 'b_run' + (Math.floor(frame / 6) % 4);\n  else bob = Math.floor(frame / 30) % 2;\n  sprite(pose, bx, by + bob, fx);\n  let aim = 'lvl', dx = 1, dy = 0;\n  const along = key(LEFT) || key(RIGHT);\n  if (key(UP)) { aim = along ? 'diu' : 'up'; dx = along ? 0.7 : 0; dy = along ? -0.7 : -1; }\n  else if (key(DOWN) && airborne) { aim = along ? 'did' : 'dn'; dx = along ? 0.7 : 0; dy = along ? 0.7 : 1; }\n  const gy = by + 10 + bob + (crouch ? 6 : 0);\n  sprite('g_' + aim, fx ? bx : bx + 16, gy, fx);\n  if (key(B) && frame % 6 < 3) {\n    const sx = (fx ? bx + 12 : bx + 19) + face * dx * 13, sy = gy + 7 + dy * 12;\n    circfill(sx, sy, 3, C.orange); circfill(sx, sy, 2, C.yellow); pset(sx, sy, C.white);\n  }\n}\nfunction drawEnemy(x, y, type, dir, hit) {\n  const heavy = type === 'heavy';\n  rectfill(x - 6, y, 18, 1, K.soilDk);\n  sprite((heavy ? 'hvy' : 'rif') + (Math.floor(frame / 8) % 4), x - 12, y - 31, dir < 0, hit ? FLASH : undefined);\n}\n// The fortress commander's gunship, four quarters of 32 px; it faces the commando, and its thrusters burn on the overlay.\nfunction drawBoss(x, y, hit) {\n  const left = !p || p.x < boss.x, ox = x - 32, oy = y - 24, pal = hit ? FLASH : undefined;\n  for (const [q, qx, qy] of [['tl', 0, 0], ['tr', 32, 0], ['bl', 0, 32], ['br', 32, 32]]) sprite('boss_' + q, left ? ox + qx : ox + 32 - qx, oy + qy, !left, pal);\n  for (const tx of [22, 44]) {\n    const fx = left ? ox + tx : ox + 64 - tx, n = 6 + (Math.floor(frame / 3) % 3) * 2;\n    for (let j = 0; j < n; j++) { const w = j < 3 ? 2 : 1; rectfill(fx - w, oy + 50 + j, w * 2, 1, j < 2 ? C.white : j < 5 ? C.yellow : C.orange); }\n  }\n  rectfill(x - 24, y - 32, 48, 4, C.black);\n  rectfill(x - 23, y - 31, Math.floor(46 * (boss.health / boss.max)), 2, C.red);\n}\nfunction drawHud() {\n  rectfill(0, 0, 256, 15, C.black); rectfill(0, 15, 256, 1, C.shadow);\n  txt('HP', 5, 4, C.white);\n  for (let i = 0; i < 5; i++) { const on = i < p.health; rectfill(24 + i * 9, 4, 7, 7, on ? C.red : C.shadow); if (on) { pset(25 + i * 9, 5, C.white); rectfill(24 + i * 9, 10, 7, 1, K.em4); } }\n  txt('LIVES ' + lives, 78, 4, C.white);\n  txt('SCORE ' + score, 150, 4, C.yellow);\n  panel(196, 204, 58, 16); txt(WEAPONS[weapon].name, 225 - WEAPONS[weapon].name.length * 4, 208, C.cyan);\n}\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, C.black); print(s, x, y, c); }\nfunction ctxt(s, y, c) { txt(s, 128 - s.length * 4, y, c); }\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, C.black); rect(x, y, w, h, C.grey); rect(x + 1, y + 1, w - 2, h - 2, C.shadow); }\n\nlet skipTitle = false; // a test sets it to start in the game\nfunction init() {\n  buildLogo();\n  WATER = { at: [K.water1, K.water2, K.water3] };\n  WATER.rgb = WATER.at.map((i) => color(i));\n  CORE = color(K.bossCore);\n  setLayers();\n  state = 'title';\n  play(1);\n  if (skipTitle) startGame();\n}\n",

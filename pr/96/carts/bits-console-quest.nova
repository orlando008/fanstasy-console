confirm: 1, pause: 2, fall: 3, treasure: 4, piece: 5, clear: 6, jump: 7, plug: 8, checkpoint: 9, power: 10, reboot: 11, spring: 12 };\nconst SONG = { title: 0, zones: [1, 2, 3, 4], practice: 5 };\nconst SFX_CH = [7, 6];\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, START];\nconst WALK = [ART.sprites.heroWalk1, ART.sprites.heroWalk2, ART.sprites.heroWalk3, ART.sprites.heroWalk4];\nconst C = ART.colors;\n\n// Deck coordinates are tile aligned. Short gaps teach the device before a long gap requires it.\nconst stageDeck = (x, w, y, h = 24) => ({ x, y, w, h });\nconst ledge = (x, w, y) => ({ ...stageDeck(x, w, y, 8), oneWay: true });\nconst liftAt = (id, x, y, top) => ({ id, kind: 'lift', x, y, w: 56, top });\nconst springAt = (id, x, y, w = 24) => ({ id, kind: 'spring', x, y, w });\nconst span = (kind, id, x, y, w = 128) => ({ kind, id, x, y, w });\nconst shelfAt = (id, x, y, target, w = 56) => ({ id, kind: 'shelf', x, y, target, w });\nconst power = (id, x, y) => ({ id, mode: 'once', x, y, on: [id] });\nconst mounted = (id, dy = -10, dx = 28) => ({ id, mode: 'once', mount: id, dx, dy, on: [id] });\nconst relay = (id, x, y, on, off = []) => ({ id, mode: 'switch', x, y, on, off });\nconst contact = (x, y, offset = 0) => ({ kind: 'contact', x, y, w: 24, offset });\nconst press = (x, y, offset = 0) => ({ kind: 'press', x, y, w: 40, raisedY: Math.max(22, y - 66), offset });\nconst point = (x, y) => ({ x, y });\nconst sign = (x, y, text) => ({ x, y, text });\n\nconst ZONES = ['FOUNDRY', 'CAVERNS', 'GARDENS', 'SKYLINE'];\nconst STAGE_SKIES = ['sky', 'cavernSky', 'gardenSky', 'skylineSky'];\nconst STAGE_BACKDROPS = ['factory', 'cavern', 'garden', 'skyline'];\nconst STAGE_DECK_COLORS = [null,\n  ['251c34', '433046', '59404e', '83574e', 'ae7962', '6d3c5b', 'bd7865', 'f0b887'],\n  ['132b2b', '1e3e32', '2f5946', '4d7954', '86a573', '245b4b', '479f74', '9ce3a0'],\n  ['252342', '302b55', '463b74', '6b5590', '9678b4', '9b4f38', 'df8549', 'ffc27a'],\n];\nconst SCENERY_COLORS = [null,\n  ['1d172d', '2d233f', '4b3051', '9a6448', '4f9a94'],\n  ['14282b', '1b3837', '254a42', '376753', '548a64'],\n  ['181931', '242443', '39335d', '357c8c', 'd9824a'],\n];\n\nfunction campaignStage(index, name, treasureName, width, spawnY, layout) {\n  const { goal, treasure, pieces, devices = [], sockets = [], hazards = [], signs = [], ...terrain } = layout;\n  const zone = index >> 1;\n  return {\n    index, name, treasureName, zone, width, mapY: 64, palette: zone ? 7 : 1,\n    backdrop: STAGE_BACKDROPS[zone], song: SONG.zones[zone], spawn: point(32, spawnY),\n    devices, hazards, signs, ...terrain,\n    sockets: [...sockets, { id: 'exit', mode: 'exit', ...goal }],\n    items: [\n      { kind: 'treasure', index, ...treasure },\n      ...pieces.map((p, i) => ({ kind: 'piece', index: index * 2 + i, ...p })),\n    ],\n  };\n}\n\nconst FOUNDRY = campaignStage(0, 'BUTTON ASSEMBLY', 'PROTOTYPE D-PAD', 1152, 192, {\n  deck: [\n    stageDeck(0, 184, 192, 32), stageDeck(224, 168, 192, 32),\n    stageDeck(520, 128, 112), stageDeck(688, 112, 112), stageDeck(928, 224, 112),\n    ledge(592, 48, 80),\n  ],\n  devices: [liftAt('lift', 424, 192, 112), springAt('spring', 568, 112, 22), span('scanline', 'scanline', 800, 112)],\n  sockets: [mounted('lift'), power('spring', 543, 101), power('scanline', 774, 101)],\n  beacons: [point(304, 192), point(736, 112)],\n  hazards: [contact(972, 112), press(1056, 112)],\n  signs: [sign(88, 140, 'A JUMP'), sign(760, 50, 'POWER + RUN')],\n  goal: point(1128, 101), treasure: point(616, 62),\n  pieces: [point(278, 175), point(607, 49)],\n});\n\nconst CAMPAIGN = [\n  FOUNDRY,\n  campaignStage(1, 'CABLE WORKS', 'BRAIDED CABLE', 1408, 192, {\n    deck: [\n      stageDeck(0, 224, 192, 32), stageDeck(208, 264, 136),\n      stageDeck(592, 320, 72), ledge(736, 48, 40),\n      stageDeck(952, 168, 88), stageDeck(1160, 248, 104),\n    ],\n    devices: [springAt('spring', 160, 192), liftAt('lift', 496, 136, 72)],\n    sockets: [power('spring', 108, 181), mounted('lift')],\n    beacons: [point(332, 136), point(980, 88)],\n    hazards: [press(1240, 104, 32)],\n    signs: [sign(114, 129, 'POWER THE SPRING'), sign(504, 82, 'RIDE THE LIFT')],\n    goal: point(1376, 93), treasure: point(760, 23),\n    pieces: [point(144, 177), point(1008, 73)],\n  }),\n  campaignStage(2, 'CONTACT MINE', 'CLEAR-SHELL CART', 1280, 184, {\n    deck: [\n      stageDeck(0, 352, 184, 40), stageDeck(536, 288, 184, 40),\n      ledge(664, 64, 144), stageDeck(864, 176, 160), stageDeck(1080, 200, 184, 40),\n    ],\n    devices: [shelfAt('shelf', 352, 184, 488)],\n    sockets: [mounted('shelf')],\n    beacons: [point(304, 184), point(784, 184)],\n    hazards: [contact(152, 184, 30), contact(584, 184, 72), contact(1120, 184, 16)],\n    signs: [sign(160, 125, 'JUMP LIVE CONTACTS'), sign(378, 120, 'PLUG IN ON SHELF')],\n    goal: point(1248, 173), treasure: point(704, 129),\n    pieces: [point(254, 168), point(930, 143)],\n  }),\n  campaignStage(3, 'SLOT ELEVATOR', 'GOLD CONTACT BOARD', 1360, 200, {\n    deck: [\n      stageDeck(0, 176, 200), stageDeck(288, 288, 120),\n      stageDeck(696, 320, 56), stageDeck(1056, 304, 104), ledge(1112, 80, 72),\n    ],\n    devices: [liftAt('lift', 200, 200, 120), liftAt('upperLift', 600, 120, 56)],\n    sockets: [mounted('lift'), mounted('upperLift')],\n    beacons: [point(362, 120), point(918, 56)],\n    hazards: [contact(445, 120, 48), press(1232, 104, 88)],\n    goal: point(1328, 93), treasure: point(1156, 56),\n    pieces: [point(330, 104), point(752, 40)],\n  }),\n  campaignStage(4, 'TRACE TRAIL', 'CERAMIC LOGIC CHIP', 1312, 184, {\n    deck: [\n      stageDeck(0, 232, 184, 40), stageDeck(360, 192, 184, 40),\n      stageDeck(592, 216, 160), ledge(664, 64, 120),\n      stageDeck(936, 184, 160), stageDeck(1160, 152, 136),\n    ],\n    devices: [span('bridge', 'firstBridge', 232, 184), span('bridge', 'secondBridge', 808, 160)],\n    sockets: [power('firstBridge', 204, 173), power('secondBridge', 776, 149)],\n    beacons: [point(480, 184), point(768, 160)],\n    hazards: [contact(1000, 160, 46)],\n    signs: [sign(205, 120, 'POWER THE TRACE')],\n    goal: point(1280, 125), treasure: point(707, 105),\n    pieces: [point(420, 168), point(675, 104)],\n  }),\n  campaignStage(5, 'RELAY GROVE', 'RELAY MODULE', 1472, 184, {\n    deck: [\n      stageDeck(0, 264, 184, 40), stageDeck(392, 256, 184, 40), ledge(592, 40, 128),\n      stageDeck(776, 248, 184, 40), stageDeck(1064, 184, 160), stageDeck(1288, 184, 136),\n    ],\n    devices: [\n      span('bridge', 'firstBridge', 264, 184), shelfAt('shelf', 144, 144, 200),\n      span('bridge', 'secondBridge', 648, 184), springAt('spring', 562, 184),\n    ],\n    sockets: [relay('firstRelay', 236, 173, ['firstBridge'], ['shelf']),\n      relay('secondRelay', 630, 173, ['secondBridge'], ['spring'])],\n    beacons: [point(468, 184), point(790, 184)],\n    hazards: [contact(850, 184, 12), contact(954, 184, 65)],\n    signs: [sign(232, 116, 'ROUTE POWER'), sign(583, 92, 'SPRING CACHE')],\n    goal: point(1440, 125), treasure: point(622, 111),\n    pieces: [point(480, 168), point(1104, 144)],\n  }),\n  campaignStage(6, 'PHOSPHOR ROOFTOPS', 'PHOSPHOR SWATCH', 1360, 144, {\n    deck: [\n      stageDeck(0, 200, 144), stageDeck(328, 232, 144),\n      stageDeck(696, 200, 144), ledge(728, 72, 104),\n      stageDeck(936, 176, 120), stageDeck(1152, 208, 96),\n    ],\n    devices: [span('scanline', 'firstScanline', 200, 144),\n      span('scanline', 'secondScanline', 560, 144, 136)],\n    sockets: [power('firstScanline', 172, 133), power('secondScanline', 532, 133)],\n    beacons: [point(496, 144), point(850, 144)],\n    hazards: [contact(426, 144, 45), contact(1004, 120, 25)],\n    signs: [sign(165, 80, 'POWER + RUN'), sign(532, 78, 'GOLD MEANS GO')],\n    goal: point(1328, 85), treasure: point(775, 89),\n    pieces: [point(368, 127), point(746, 88)],\n  }),\n  campaignStage(7, 'PICTURE LOCK', 'CRT TUNING DIAL', 1568, 192, {\n    deck: [\n      stageDeck(0, 192, 192, 32), stageDeck(312, 224, 112),\n      stageDeck(664, 208, 112), ledge(728, 64, 72),\n      stageDeck(864, 216, 56), stageDeck(1208, 360, 56),\n    ],\n    devices: [liftAt('lift', 216, 192, 112), span('scanline', 'firstScanline', 536, 112),\n      springAt('spring', 824, 112), span('scanline', 'lastScanline', 1080, 56)],\n    sockets: [mounted('lift'), power('firstScanline', 506, 101),\n      power('spring', 804, 101), power('lastScanline', 1044, 45)],\n    beacons: [point(378, 112), point(704, 112), point(1016, 56)],\n    hazards: [contact(112, 192, 42), press(424, 112, 76),\n      press(1290, 56, 40), contact(1420, 56, 64)],\n    signs: [sign(504, 46, 'POWER + RUN'), sign(820, 24, 'SPRING UP')],\n    goal: point(1536, 45), treasure: point(770, 55),\n    pieces: [point(388, 96), point(744, 55)],\n  }),\n];\n\nconst PRACTICE = {\n  practice: true, width: 800, mapY: 96, palette: 4, backdrop: 'lab', song: SONG.practice,\n  spawn: point(32, 192),\n  deck: [stageDeck(0, 240, 192, 32), ledge(144, 112, 144), stageDeck(384, 144, 144), stageDeck(648, 152, 64)],\n  devices: [span('bridge', 'bridge', 256, 144), shelfAt('shelf', 168, 108, 208, 40), liftAt('lift', 552, 144, 64)],\n  sockets: [relay('relay', 230, 133, ['bridge'], ['shelf']), mounted('lift'), { id: 'exit', mode: 'exit', x: 768, y: 53 }],\n  beacons: [point(205, 144), point(425, 144)],\n  signs: [sign(104, 102, '1  HOLD A'), sign(231, 80, '2  PLUG IN'), sign(466, 91, '3  RIDE LIFT')],\n  items: [],\n  hazards: [],\n};\n\nconst LAB = {\n  hub: true, width: 640, mapY: 96, palette: 4, backdrop: 'lab', song: SONG.practice,\n  spawn: point(72, 192), deck: [stageDeck(0, 640, 192, 32)],\n  devices: [], sockets: [\n    { id: 'console', mode: 'station', x: 80, y: 181 },\n    { id: 'treasures', mode: 'station', x: 232, y: 181 },\n    { id: 'puzzles', mode: 'station', x: 394, y: 181 },\n    { id: 'practice', mode: 'station', x: 552, y: 181 },\n  ],\n  beacons: [], signs: [], items: [], hazards: [],\n};\nconst CAMPAIGN_MASK = (1 << CAMPAIGN.length) - 1;\nconst ENDING_READY_FRAME = 120;\nconst readyToBoot = () => (dget(CLEAR_SLOT) & CAMPAIGN_MASK) === CAMPAIGN_MASK && !dget(ENDING_SLOT);\nconst PAUSE_LAB = ['RESUME', 'BACK TO TITLE'];\nconst PAUSE_STAGE = ['RESUME', 'RESTART STAGE', 'BACK TO LAB'];\nconst PAUSE_PRACTICE = ['RESUME', 'RESTART PRACTICE', 'BACK TO LAB'];\n\nlet skipTitle = false;\nlet state = 'title', paused = false, pauseSel = 0, clock = 0;\nlet selection = 0, labMenu = null, exhibit = 0;\nlet input = 0, previousInput = 0, playing = -1, fxNext = 0;\nlet course = FOUNDRY, devices = [], sockets = [], checkpoint, bit, camera, deathTimer, reboots, hazardTick;\n\nfunction fx(n) {\n  sfx(n, playing === SONG.practice ? 7 : SFX_CH[fxNext]);\n  fxNext ^= 1;\n}\n\nfunction play(song) {\n  if (playing === song) return;\n  playing = song;\n  music(song);\n}\n\nfunction scene(layer, asset, opts) {\n  bg(layer, { mx: asset.mx, my: asset.my, mw: asset.w, mh: asset.h, ...opts });\n}\n\nfunction buildTerrain(level) {\n  // Each zone has its own terrain tiles (art.py's terrain()); practice and the lab use Foundry's in their own colours.\n  const zone = level.practice || level.hub ? 0 : level.zone;\n  const tileOf = name => ART.tiles['deck' + name + zone];\n  // All campaign courses share the same map region. Clear gaps as well as writing the new terrain.\n  for (let row = 0; row < SCREEN_H / 8; row++) {\n    for (let col = 0; col < level.width / 8; col++) mset(col, level.mapY + row, 0);\n  }\n  for (const { x, y, w, h, oneWay } of level.deck) {\n    const cols = w / 8;\n    for (let dy = 0; dy < h; dy += 8) {\n      for (let c = 0; c < cols; c++) {\n        const mx = x / 8 + c, my = level.mapY + (y + dy) / 8, edge = c === 0 || c === cols - 1;\n        const name = dy ? ((mx * 7 + my * 3) % 5 ? 'Wall' : 'Wall2') :\n          oneWay ? (edge ? 'LedgeEnd' : 'Ledge') : edge ? 'End' : 'Top';\n        mset(mx, my, tile(tileOf(name), level.palette, !dy && c === cols - 1 && cols > 1));\n      }\n    }\n  }\n}\n\nfunction init() {\n  if (dget(0) !== SAVE_VERSION) {\n    for (let slot = 1; slot < 256; slot++) dset(slot, 0);\n    dset(0, SAVE_VERSION);\n  }\n  selection = clamp(dget(STAGE_SLOT), 0, lastUnlocked());\n  scene(0, ART.scenes.logo, { x: 0, y: -48, wrap: false });\n  if (skipTitle) startCourse(FOUNDRY);\n  else toTitle();\n}\n\nfunction writeSubPalette(index, colors) {\n  colors.forEach((rgb, i) => {\n    const value = parseInt(rgb, 16);\n    color(index * 16 + i + 1, value >> 19, (value >> 11) & 31, (value >> 3) & 31);\n  });\n}\n\nfunction setBackdrop(name) {\n  scene(2, ART.scenes[name], { x: 0, y: 0, wrap: true, show: true });\n}\n\nfunction toTitle() {\n  state = 'title';\n  labMenu = null;\n  paused = false;\n  clock = 0;\n  setBackdrop('factory');\n  play(SONG.title);\n}\n\nfunction resetDevices(saved) {\n  devices = course.devices.map((d, i) => saved?.devices[i] ? { ...saved.devices[i] } :\n    { ...d, homeX: d.x, homeY: d.y, lastX: d.x, lastY: d.y, powered: false, direction: -1, wait: 0, phase: 0 });\n  const byId = Object.fromEntries(devices.map(d => [d.id, d]));\n  sockets = course.sockets.map((s, i) => {\n    const socket = {\n      ...s, active: saved?.switches[i] || false, platform: byId[s.mount],\n      targets: (s.on || []).map(id => byId[id]),\n      alternateTargets: (s.off || []).map(id => byId[id]),\n    };\n    routePower(socket);\n    return socket;\n  });\n}\n\nfunction startCourse(level, entry = level.spawn) {\n  course = level;\n  labMenu = null;\n  if (!level.practice && !level.hub) {\n    selection = level.index;\n    dset(STAGE_SLOT, selection);\n    if (level.zone) {\n      writeSubPalette(6, SCENERY_COLORS[level.zone]);\n      writeSubPalette(7, STAGE_DECK_COLORS[level.zone]);\n    }\n  }\n  buildTerrain(level);\n  checkpoint = null;\n  reboots = 0;\n  hazardTick = 0;\n  resetDevices(null);\n  spawnBit(entry);\n  setBackdrop(course.backdrop);\n  bg(1, { mx: 0, my: course.mapY, mw: course.width / 8, mh: SCREEN_H / 8, x: 0, y: 0, wrap: false });\n  state = level.hub ? 'lab' : 'play';\n  paused = false;\n  clock = 0;\n  play(course.song);\n}\n\nfunction spawnBit({ x, y }) {\n  bit = { x, y, vx: 0, vy: 0, support: course.deck.find(p => p.y === y && x >= p.x && x < p.x + p.w),\n    coyote: COYOTE_FRAMES, jumpBuffer: 0, facingLeft: false, walk: 0,\n    landUntil: 0, plugUntil: 0, pluggedSocket: null, cheerUntil: 0 };\n  camera = clamp(x - SCREEN_W / 2, 0, course.width - SCREEN_W);\n  deathTimer = 0;\n}\n\nconst held = b => (input & (1 << b)) !== 0;\nconst pressed = b => held(b) && !(previousInput & (1 << b));\n\nfunction update() {\n  previousInput = input;\n  input = 0;\n  for (const b of BUTTONS) if (btn(b)) input |= 1 << b;\n  if (paused) {\n    updatePause();\n    return;\n  }\n  clock++;\n  if (state === 'title') {\n    if (pressed(A) || pressed(START) || pressed(B)) {\n      fx(SFX.confirm);\n      startCourse(pressed(B) ? PRACTICE : LAB);\n    }\n    return;\n  }\n  if (state === 'clear') {\n    if (pressed(B)) returnToLab(true);\n    else if (pressed(LEFT) || pressed(A) || pressed(START)) {\n      fx(SFX.confirm);\n      if (pressed(LEFT) || course.practice) startCourse(course);\n      else if (continuesZone()) startCourse(nextStage());\n      else returnToLab(true);\n    }\n    return;\n  }\n  if (state === 'ending') {\n    if (pressed(A) || pressed(START)) {\n      if (clock < ENDING_READY_FRAME) clock = ENDING_READY_FRAME;\n      else {\n        dset(ENDING_SLOT, 1);\n        startCourse(LAB);\n      }\n    }\n    return;\n  }\n  if (state === 'lab' && labMenu) {\n    updateLabMenu();\n    return;\n  }\n  if (pressed(START)) {\n    paused = true;\n    pauseSel = 0;\n    fx(SFX.pause);\n    return;\n  }\n  if (state === 'lab') updateLab();\n  else updateStage();\n}\n\nconst pauseOptions = () => course.hub ? PAUSE_LAB : course.practice ? PAUSE_PRACTICE : PAUSE_STAGE;\n\nfunction updatePause() {\n  const direction = Number(pressed(DOWN)) - Number(pressed(UP));\n  const count = pauseOptions().length;\n  if (direction) {\n    pauseSel = (pauseSel + direction + count) % count;\n    fx(SFX.move);\n  }\n  if (pressed(B) || pressed(START)) {\n    paused = false;\n    fx(SFX.pause);\n  } else if (pressed(A)) {\n    fx(SFX.confirm);\n    if (!pauseSel) paused = false;\n    else if (course.hub) toTitle();\n    else if (pauseSel === 1) startCourse(course);\n    else returnToLab();\n  }\n}\n\nfunction returnToLab(cleared = false) {\n  if (cleared && nextStage()) selection = Math.min(nextStage().index, lastUnlocked());\n  startCourse(LAB, course.practice ? point(534, 192) : LAB.spawn);\n}\n\nfunction updateLab() {\n  moveBit();\n  followBit();\n  if (!pressed(B)) return;\n  const socket = interaction();\n  if (!socket) return;\n  fx(SFX.plug);\n  if (socket.id === 'practice') startCourse(PRACTICE);\n  else if (socket.id === 'console' && readyToBoot()) {\n    state = 'ending';\n    clock = 0;\n  } else {\n    labMenu = socket.id;\n    exhibit = 0;\n  }\n}\n\nfunction updateLabMenu() {\n  if (pressed(B) || pressed(START)) {\n    labMenu = null;\n    fx(SFX.confirm);\n    return;\n  }\n\n  const horizontal = Number(pressed(RIGHT)) - Number(pressed(LEFT));\n  const vertical = Number(pressed(DOWN)) - Number(pressed(UP));\n  if (labMenu === 'console') {\n    const next = clamp(selection + (vertical || horizontal), 0, lastUnlocked());\n    if (next !== selection) {\n      selection = next;\n      fx(SFX.move);\n    }\n    if (pressed(A)) {\n      fx(SFX.confirm);\n      startCourse(CAMPAIGN[selection]);\n    }\n  } else {\n    const columns = labMenu === 'treasures' ? 4 : 1;\n    const count = labMenu === 'treasures' ? 8 : 4;\n    const next = (exhibit + (vertical ? vertical * columns : horizontal) + count) % count;\n    if (next !== exhibit) {\n      exhibit = next;\n      fx(SFX.move);\n    }\n  }\n}\n\nfunction advanceDevices() {\n  for (const d of devices) {\n    d.lastX = d.x;\n    d.lastY = d.y;\n    if (d.kind === 'scanline' && d.powered) {\n      d.phase = (d.phase + 1) % SCANLINE_PERIOD;\n    } else if (d.kind === 'shelf') {\n      d.x += Math.sign((d.powered ? d.target : d.homeX) - d.x);\n    } else if (d.kind === 'lift' && d.powered) {\n      if (d.wait > 0) {\n        d.wait--;\n      } else {\n        d.y += d.direction;\n        if (d.y === d.top || d.y === d.homeY) {\n          d.direction *= -1;\n          d.wait = d.y === d.top ? 60 : 45;\n        }\n      }\n    }\n  }\n}\n\nfunction solidDevice(d) {\n  if (d.kind === 'scanline') return d.powered && d.phase < SCANLINE_OFF;\n  if (d.kind === 'bridge') return d.powered;\n  return d.kind === 'lift' || d.kind === 'shelf';\n}\n\nfunction moveBit() {\n  if (bit.support?.kind && !solidDevice(bit.support)) bit.support = null;\n  const support = bit.support;\n  const wasSupported = Boolean(support);\n  const carryX = support?.kind === 'shelf' ? support.x - support.lastX : 0;\n  if (support?.kind === 'lift') bit.y += support.y - support.lastY;\n  if (pressed(A)) bit.jumpBuffer = BUFFER_FRAMES;\n  const spring = wasSupported && devices.find(d => d.kind === 'spring' && d.powered && d.y === bit.y && overPlatform(d));\n  if (spring || (bit.jumpBuffer > 0 && (wasSupported || bit.coyote > 0))) {\n    bit.vy = spring ? -6.2 : JUMP_SPEED;\n    bit.support = null;\n    bit.coyote = 0;\n    bit.jumpBuffer = 0;\n    fx(spring ? SFX.spring : SFX.jump);\n  } else {\n    bit.vy = Math.min(FALL_LIMIT, bit.vy + (held(A) && bit.vy < 0 ? HELD_GRAVITY : GRAVITY));\n  }\n\n  const direction = Number(held(RIGHT)) - Number(held(LEFT));\n  if (direction) {\n    bit.vx = clamp(bit.vx + direction * (wasSupported ? GROUND_ACCEL : AIR_ACCEL), -RUN_SPEED, RUN_SPEED);\n    bit.facingLeft = direction < 0;\n  } else {\n    const brake = wasSupported ? BRAKE : AIR_ACCEL;\n    bit.vx -= Math.sign(bit.vx) * Math.min(Math.abs(bit.vx), brake);\n  }\n  const fallSpeed = bit.vy;\n  moveHorizontally(carryX);\n  moveVertically();\n  if (!wasSupported && bit.support && fallSpeed > 2) bit.landUntil = clock + 6;\n\n  if (bit.support) bit.coyote = COYOTE_FRAMES;\n  else if (!wasSupported && bit.coyote > 0) bit.coyote--;\n  if (bit.jumpBuffer > 0) bit.jumpBuffer--;\n  bit.walk = bit.support && Math.abs(bit.vx) > 0.15 ? bit.walk + 1 : 0;\n}\n\nfunction moveHorizontally(carryX) {\n  const dx = bit.vx + carryX;\n  let x = clamp(bit.x + dx, BODY_HALF, course.width - BODY_HALF);\n  for (const p of course.deck) {\n    if (p.oneWay || bit.y <= p.y || bit.y - BODY_H >= p.y + p.h) continue;\n    if (dx > 0 && bit.x + BODY_HALF <= p.x) x = Math.min(x, p.x - BODY_HALF);\n    if (dx < 0 && bit.x - BODY_HALF >= p.x + p.w) x = Math.max(x, p.x + p.w + BODY_HALF);\n  }\n  if (x !== bit.x + dx) bit.vx = 0;\n  bit.x = x;\n}\n\nfunction overPlatform(p) {\n  return bit.x + BODY_HALF > p.x && bit.x - BODY_HALF < p.x + p.w;\n}\n\nfunction moveVertically() {\n  let y = bit.y + bit.vy;\n  let support = null;\n  if (bit.vy >= 0) {\n    for (const p of course.deck) {\n      if (overPlatform(p) && bit.y <= p.y && y >= p.y) {\n        y = p.y;\n        support = p;\n      }\n    }\n    for (const p of devices) {\n      if (!solidDevice(p)) continue;\n      // A rising lift can reach Bit from below between two frames.\n      if ((!support || p.y < y) && overPlatform(p) && bit.y <= Math.max(p.y, p.lastY) && y >= p.y) {\n        y = p.y;\n        support = p;\n      }\n    }\n  } else {\n    for (const p of course.deck) {\n      const underside = p.y + p.h + BODY_H;\n      if (!p.oneWay && overPlatform(p) && bit.y >= underside && y < underside) y = underside;\n    }\n  }\n  if (support || y !== bit.y + bit.vy) bit.vy = 0;\n  bit.y = y;\n  bit.support = support;\n}\n\nfunction followBit() {\n  camera = clamp(camera, bit.x - 160, bit.x - 96);\n  camera = clamp(camera, 0, course.width - SCREEN_W);\n}\n\nfunction socketPoint(s) {\n  if (s.platform) return { x: s.platform.x + s.dx, y: s.platform.y + s.dy };\n  return s;\n}\n\n// Find the segment's time interval inside one axis of a deck.\nfunction axisInterval(from, to, low, high) {\n  if (from === to) return from > low && from < high ? [-Infinity, Infinity] : [1, 0];\n  const near = (low - from) / (to - from), far = (high - from) / (to - from);\n  return [Math.min(near, far), Math.max(near, far)];\n}\n\nfunction clearSocketPath(x0, y0, x1, y1) {\n  return !course.deck.some(p => {\n    const [left, right] = axisInterval(x0, x1, p.x, p.x + p.w);\n    const [top, bottom] = axisInterval(y0, y1, p.y, p.y + p.h);\n    return Math.max(0, left, top) < Math.min(1, right, bottom);\n  });\n}\n\nfunction interaction() {\n  const centerY = bit.y - BODY_H / 2;\n  let nearest = null, distance = Infinity;\n  for (const s of sockets) {\n    if (s.mode === 'once' && s.active) continue;\n    const { x, y } = socketPoint(s);\n    const dx = bit.x - x, dy = centerY - y;\n    const dist = dx * dx + dy * dy;\n    if (Math.abs(dx) <= SOCKET_X_REACH && Math.abs(dy) <= SOCKET_Y_REACH && dist < distance && clearSocketPath(bit.x, centerY, x, y)) {\n      nearest = s;\n      distance = dist;\n    }\n  }\n  return nearest;\n}\n\nfunction routePower(s) {\n  for (const d of s.targets) d.powered = s.active;\n  for (const d of s.alternateTargets) d.powered = !s.active;\n}\n\nfunction plug(s) {\n  if (s.mode === 'exit') {\n    if (!course.practice) dset(CLEAR_SLOT, dget(CLEAR_SLOT) | (1 << course.index));\n    state = 'clear';\n    fx(SFX.clear);\n    return;\n  }\n  s.active = !s.active;\n  routePower(s);\n  bit.pluggedSocket = s;\n  bit.plugUntil = clock + PLUG_FRAMES;\n  fx(SFX.plug);\n  if (s.targets.length || s.alternateTargets.length) fx(SFX.power);\n}\n\nconst stageCleared = (index = 0) => (dget(CLEAR_SLOT) & (1 << index)) !== 0;\n\nfunction lastUnlocked() {\n  const firstIncomplete = CAMPAIGN.findIndex(stage => !stageCleared(stage.index));\n  return firstIncomplete < 0 ? CAMPAIGN.length - 1 : firstIncomplete;\n}\n\nconst nextStage = () => course.practice || course.hub ? null : CAMPAIGN[course.index + 1];\nconst continuesZone = () => nextStage() && nextStage().zone === course.zone;\nconst stageNumber = stage => (stage.zone + 1) + '-' + ((stage.index & 1) + 1);\nconst itemSlot = item => item.kind === 'treasure' ? TREASURE_SLOT : PIECE_SLOT;\nconst hasItem = item => (dget(itemSlot(item)) & (1 << item.index)) !== 0;\nconst collected = (kind, level = course) => level.items.filter(item => item.kind === kind && hasItem(item)).length;\nconst tally = (mask, count) => {\n  let total = 0;\n  for (let i = 0; i < count; i++) total += (mask >> i) & 1;\n  return total;\n};\nconst puzzleMask = zone => (dget(PIECE_SLOT) >>> (zone * 4)) & 15;\nconst hasTreasure = () => course.items.some(item => item.kind === 'treasure' && hasItem(item));\n\nfunction hazardState(h) {\n  if (h.kind === 'contact') {\n    const phase = (hazardTick + h.offset) % CONTACT_PERIOD;\n    return {\n      y: h.y - 9, height: 9, phase,\n      warning: phase >= CONTACT_WARNING && phase < CONTACT_LIVE,\n      danger: phase >= CONTACT_LIVE,\n    };\n  }\n\n  const phase = (hazardTick + h.offset) % PRESS_PERIOD;\n  const elapsed = phase - (PRESS_IDLE + PRESS_WARNING);\n  const depth = elapsed < PRESS_DROP ? clamp(elapsed / PRESS_DROP, 0, 1) :\n    clamp(1 - (elapsed - PRESS_DROP - PRESS_HOLD) / PRESS_RETURN, 0, 1);\n  return {\n    y: Math.floor(lerp(h.raisedY, h.y - 12, depth)), height: 12, phase,\n    warning: phase >= PRESS_IDLE && elapsed < 0, danger: elapsed >= 0,\n  };\n}\n\nfunction dangerAtBit(h) {\n  if (!overPlatform(h)) return false;\n  const { y, height, danger } = hazardState(h);\n  return danger && bit.y > y && bit.y - BODY_H < y + height;\n}\n\nfunction updateStage() {\n  if (deathTimer > 0) {\n    if (--deathTimer === 0) {\n      resetDevices(checkpoint);\n      hazardTick = checkpoint?.hazardTick ?? 0;\n      spawnBit(checkpoint?.beacon || course.spawn);\n      fx(SFX.reboot);\n    }\n    return;\n  }\n\n  hazardTick++;\n  advanceDevices();\n  moveBit();\n  followBit();\n\n  if (bit.y - BODY_H >= SCREEN_H + 8 || course.hazards.some(dangerAtBit)) {\n    deathTimer = RESPAWN_FRAMES;\n    reboots++;\n    fx(SFX.fall);\n    return;\n  }\n  const index = bit.support ? course.beacons.findIndex((b, i) => i > (checkpoint?.index ?? -1) &&\n    bit.y === b.y && Math.abs(bit.x - b.x) < 12) : -1;\n  if (index >= 0) {\n    const beacon = course.beacons[index];\n    // A one-shot socket comes back unplugged with its devices as the stage began, so it can be used again: a\n    // shelf or lift saved mid-move could otherwise strand Bit for good (plug in, then back onto this beacon).\n    const oneShot = new Set(sockets.filter(s => s.mode === 'once').flatMap(s => [...s.targets, s.platform]));\n    checkpoint = { index, beacon, hazardTick, devices: devices.map(d => oneShot.has(d) ? null : { ...d }),\n      switches: sockets.map(s => s.mode !== 'once' && s.active) };\n    fx(SFX.checkpoint);\n  }\n  for (const item of course.items) {\n    if (hasItem(item) || Math.abs(bit.x - item.x) >= 14 || Math.abs(bit.y - BODY_H / 2 - item.y) >= 15) continue;\n    const slot = itemSlot(item);\n    dset(slot, dget(slot) | (1 << item.index));\n    bit.cheerUntil = clock + 18;\n    fx(item.kind === 'treasure' ? SFX.treasure : SFX.piece);\n  }\n  if (pressed(B)) {\n    const socket = interaction();\n    if (socket) plug(socket);\n  }\n}\n\nfunction draw() {\n  cls();\n  const title = state === 'title';\n  bg(0, { show: title });\n  bg(1, { show: !title });\n  const scroll = title ? Math.floor(clock / 4) : Math.floor(camera);\n  bgscroll(2, Math.floor(scroll / 3), 0);\n  if (title) drawTitle();\n  else {\n    bgscroll(1, scroll, 0);\n    if (course.hub) drawLab(scroll);\n    else drawStage(scroll);\n    if (paused) drawPause();\n    else if (state === 'clear') drawClear();\n    else if (state === 'ending') drawEnding();\n    else if (labMenu) drawLabMenu();\n  }\n}\n\nfunction drawTitle() {\n  const cleared = tally(dget(CLEAR_SLOT), CAMPAIGN.length);\n  centered(cleared ? 'STAGES CLEARED  ' + cleared + '/8' : 'A NOVA-16 ADVENTURE', 116, C.MUTED);\n  panel(26, 145, 204, 51);\n  centered('A  ENTER LAB', 155, C.WHITE);\n  centered('B  PRACTICE', 175, C.CYAN);\n}\n\nconst LAB_LABELS = ['NOVA-16', 'TREASURES', 'PUZZLE WALL', 'PRACTICE'];\nconst PUZZLE_NAMES = ['CONTROLLER CUTAWAY', 'CARTRIDGE CUTAWAY', 'CIRCUIT CUTAWAY', 'CRT CUTAWAY'];\nconst treasureSprite = index => ART.sprites['displayTreasure' + index];\nconst puzzleSprite = zone => ART.sprites['puzzleArt' + zone];\n\nfunction cabinet(x, y, w, h) {\n  rectfill(x + 3, y + 3, w, h, C.INK);\n  rectfill(x, y, w, h, C.DARK);\n  rect(x, y, w, h, C.TRIM);\n  line(x + 2, y + 2, x + w - 3, y + 2, C.PURPLE);\n}\n\nfunction labLabel(text, center, y) {\n  const x = center - text.length * 4;\n  rectfill(x - 5, y - 3, text.length * 8 + 10, 14, C.PANEL);\n  print(text, x, y, C.WHITE);\n}\n\nfunction drawLab(scroll) {\n  const [consoleStation, treasures, puzzles, practice] = sockets.map(s => s.x - scroll);\n  const focus = state === 'lab' && !labMenu ? interaction() : null;\n  clip(0, 16, SCREEN_W, SCREEN_H - 16);\n\n  cabinet(consoleStation - 44, 81, 88, 51);\n  labLabel(LAB_LABELS[0], consoleStation, 91);\n  for (let i = 0; i < CAMPAIGN.length; i++) {\n    rectfill(consoleStation - 35 + 9 * i, 112, 6, 6, stageCleared(i) ? C.CYAN : C.TRIM);\n  }\n  cabinet(consoleStation - 36, 149, 72, 8);\n  drawSprite(ART.sprites.labConsole, consoleStation - 16, 123, false, 2);\n\n  cabinet(treasures - 56, 73, 112, 86);\n  labLabel(LAB_LABELS[1], treasures, 82);\n  for (let i = 0; i < CAMPAIGN.length; i++) {\n    const x = treasures - 46 + (i % 4) * 24, y = 101 + (i >> 2) * 24;\n    rectfill(x, y, 20, 20, C.PANEL);\n    rect(x, y, 20, 20, C.TRIM);\n    if (collected('treasure', CAMPAIGN[i])) drawArtifact(treasureSprite(i), x + 2, y + 2);\n  }\n\n  cabinet(puzzles - 61, 80, 122, 79);\n  labLabel(LAB_LABELS[2], puzzles, 90);\n  for (let zone = 0; zone < ZONES.length; zone++) {\n    const x = puzzles - 51 + 26 * zone;\n    const mask = puzzleMask(zone);\n    rectfill(x, 112, 22, 22, C.PANEL);\n    rect(x, 112, 22, 22, mask === 15 ? C.CYAN : C.TRIM);\n    for (let i = 0; i < 4; i++) {\n      rectfill(x + 4 + (i % 2) * 8, 116 + (i >> 1) * 8, 6, 6, (mask & (1 << i)) ? C.CYAN : C.DARK);\n    }\n    print(String(tally(mask, 4)), x + 7, 139, C.MUTED);\n  }\n\n  cabinet(practice - 42, 98, 84, 94);\n  rectfill(practice - 28, 117, 56, 75, C.INK);\n  rect(practice - 28, 117, 56, 74, C.PURPLE);\n  rectfill(practice - 27, 118, 3, 71, C.TRIM);\n  rectfill(practice + 25, 118, 2, 71, C.CYAN);\n  for (let i = 0; i < 3; i++) {\n    line(practice - 13 + i * 8, 140, practice - 9 + i * 8, 144, C.CYAN);\n    line(practice - 9 + i * 8, 144, practice - 13 + i * 8, 148, C.CYAN);\n  }\n  labLabel(LAB_LABELS[3], practice, 109);\n\n  for (const s of sockets) {\n    const boot = s.id === 'console' && readyToBoot();\n    const label = s.id === 'console' ? (boot ? 'B BOOT' : 'B STAGES') :\n      s.id === 'practice' ? 'B ENTER' : 'B VIEW';\n    const prompt = focus === s ? label : '';\n    drawSocket(s.x - scroll, s.y, boot ? ART.sprites.socketLive : ART.sprites.socketIdle, prompt);\n  }\n  drawSprite(bitSprite(), Math.floor(bit.x) - scroll - 16, Math.floor(bit.y) - 31, bit.facingLeft);\n  clip();\n  rectfill(0, 0, SCREEN_W, 16, C.PANEL);\n  line(0, 15, SCREEN_W - 1, 15, C.TRIM);\n  print('BIT\\'S LAB', 5, 4, C.WHITE);\n  print('T ' + tally(dget(TREASURE_SLOT), 8) + '/8  P ' + tally(dget(PIECE_SLOT), 16) + '/16', 141, 4, C.CYAN);\n}\n\n// The exhibits use the same tile art in the room and inside solid overlay panels. The overlay covers sprites, so\n// they are drawn on it: as runs of one colour (within a quadrant), worked out once for each picture.\nconst artifactRuns = new Map();\nfunction runsOf(asset) {\n  let runs = artifactRuns.get(asset);\n  if (runs) return runs;\n  runs = [];\n  const sx = (asset.tile & 15) * 8, sy = (asset.tile >> 4) * 8, half = asset.size / 2;\n  for (let row = 0; row < asset.size; row++) {\n    for (let col = 0; col < asset.size;) {\n      const pixel = sget(sx + col, sy + row);\n      let len = 1;\n      while (col + len < asset.size && (col + len) !== half && sget(sx + col + len, sy + row) === pixel) len++;\n      if (pixel) runs.push({ row, col, len, pixel, quadrant: (row >= half ? 2 : 0) + (col >= half ? 1 : 0) });\n      col += len;\n    }\n  }\n  artifactRuns.set(asset, runs);\n  return runs;\n}\n\nfunction drawArtifact(asset, x, y, scale = 1, quadrants = 15) {\n  if (!quadrants || x >= SCREEN_W || y >= SCREEN_H || x + asset.size * scale <= 0 || y + asset.size * scale <= 0) return;\n  const palette = 128 + asset.pal * 16;\n  for (const { row, col, len, pixel, quadrant } of runsOf(asset)) {\n    if (quadrants & (1 << quadrant)) rectfill(x + col * scale, y + row * scale, len * scale, scale, palette + pixel);\n  }\n}\n\nfunction drawLabMenu() {\n  if (labMenu === 'console') drawStageSelect();\n  else if (labMenu === 'treasures') drawTreasureCase();\n  else drawPuzzleWall();\n}\n\nfunction drawStageSelect() {\n  panel(8, 17, 240, 192);\n  print('STAGE SELECT', 20, 26, C.WHITE);\n  print('T  P', 194, 26, C.CYAN);\n  const unlocked = lastUnlocked();\n  for (const stage of CAMPAIGN) {\n    const y = 46 + stage.index * 16, selected = stage.index === selection;\n    const canPlay = stage.index <= unlocked;\n    if (selected) rectfill(13, y - 3, 230, 14, C.TRIM);\n    if (selected) print('>', 18, y, C.CYAN);\n    print(stageNumber(stage), 29, y, canPlay ? C.MUTED : C.PURPLE);\n    print(stage.name, 58, y, canPlay ? C.WHITE : C.PURPLE);\n    if (canPlay) {\n      print(String(collected('treasure', stage)), 201, y, C.GOLD);\n      print(String(collected('piece', stage)), 224, y, C.CYAN);\n    } else print('-', 224, y, C.MUTED);\n  }\n  centered('A PLAY    B BACK', 185, C.WHITE);\n}\n\nfunction drawTreasureCase() {\n  panel(9, 18, 238, 187);\n  centered('TREASURE CASE  ' + tally(dget(TREASURE_SLOT), 8) + '/8', 27, C.GOLD);\n  for (const stage of CAMPAIGN) {\n    const i = stage.index, x = 24 + (i % 4) * 53, y = 46 + (i >> 2) * 45;\n    const found = collected('treasure', stage);\n    rectfill(x, y, 49, 40, C.INK);\n    rect(x, y, 49, 40, exhibit === i ? C.GOLD : C.TRIM);\n    if (found) drawArtifact(treasureSprite(i), x + 16, y + 3);\n    else print('?', x + 21, y + 8, C.MUTED);\n    print(stageNumber(stage), x + 13, y + 24, C.MUTED);\n  }\n  const selected = CAMPAIGN[exhibit];\n  centered(collected('treasure', selected) ? selected.treasureName : 'UNFOUND TREASURE', 143, C.WHITE);\n  centered(selected.name, 158, C.MUTED);\n  centered('D-PAD SELECT   B BACK', 180, C.CYAN);\n}\n\nfunction drawPuzzleWall() {\n  panel(10, 16, 236, 191);\n  centered('PUZZLE WALL', 25, C.WHITE);\n  for (let zone = 0; zone < ZONES.length; zone++) {\n    const y = 49 + zone * 24, selected = exhibit === zone;\n    if (selected) rectfill(17, y - 4, 116, 19, C.TRIM);\n    print(ZONES[zone], 22, y, selected ? C.WHITE : C.MUTED);\n    print(tally(puzzleMask(zone), 4) + '/4', 103, y, C.CYAN);\n  }\n  const mask = puzzleMask(exhibit), x = 155, y = 48;\n  for (let i = 0; i < 4; i++) {\n    const left = x + (i % 2) * 32, top = y + (i >> 1) * 32;\n    rectfill(left, top, 32, 32, C.INK);\n    rect(left, top, 32, 32, C.TRIM);\n    if (!(mask & (1 << i))) print('?', left + 12, top + 12, C.MUTED);\n  }\n  drawArtifact(puzzleSprite(exhibit), x, y, 2, mask);\n  rect(x - 2, y - 2, 68, 68, mask === 15 ? C.CYAN : C.TRIM);\n  centered(mask === 15 ? PUZZLE_NAMES[exhibit] : tally(mask, 4) + '/4 PUZZLE PIECES', 149, C.WHITE);\n  centered('D-PAD SELECT   B BACK', 179, C.CYAN);\n}\n\nfunction drawEnding() {\n  panel(13, 24, 230, 177);\n  const ready = clock >= ENDING_READY_FRAME;\n  const dots = Math.min(8, Math.floor(clock / 10));\n  centered(ready ? 'NOVA-16 ONLINE' : 'BOOTING NOVA-16', 39, C.CYAN);\n  drawArtifact(ART.sprites.labConsole, 96, 56, 2);\n  for (let i = 0; i < 8; i++) rectfill(73 + 14 * i, 116, 9, 4, i < dots ? C.CYAN : C.TRIM);\n  if (ready) {\n    centered('ALL FOUR WORLDS RESTORED', 135, C.WHITE);\n    centered(tally(dget(TREASURE_SLOT), 8) + '/8 TREASURES  ' + tally(dget(PIECE_SLOT), 16) + '/16 PIECES', 151, C.MUTED);\n    centered('A BACK TO LAB', 176, C.GOLD);\n  } else centered(clock < 45 ? 'CHECKING CARTRIDGE' : 'RECONNECTING CONTROLLERS', 146, C.WHITE);\n}\n\nfunction drawDevices(scroll) {\n  for (const d of devices) {\n    const x = d.x - scroll;\n    const warning = d.kind === 'scanline' && d.powered && d.phase >= SCANLINE_WARNING && d.phase < SCANLINE_OFF;\n    const accent = warning ? C.GOLD : d.powered ? C.CYAN : course.practice ? C.PURPLE : C.CORAL;\n    if (d.kind === 'lift') {\n      for (const rail of [x + 3, x + d.w - 5]) rectfill(rail, d.top, 2, d.homeY - d.top + 8, C.TRIM);\n    }\n    if ((d.kind === 'bridge' || d.kind === 'scanline') && !solidDevice(d)) {\n      for (let n = 4; n < d.w; n += 12) rectfill(x + n, d.y + 2, 4, 2, d.powered ? C.STEEL : C.TRIM);\n      continue;\n    }\n    const y = d.kind === 'spring' ? d.y - 3 : d.y;\n    const h = d.kind === 'spring' ? 3 : 8;\n    rectfill(x, y, d.w, h, C.INK);\n    rectfill(x + 1, y, d.w - 2, 2, accent);\n    if (h > 3) rectfill(x + 3, y + 4, d.w - 6, 2, C.STEEL);\n    if (d.kind === 'scanline') {\n      const blink = warning && d.phase % 8 < 4;\n      for (let n = 5; n < d.w; n += 9) {\n        rectfill(x + n, y + 4, blink ? 2 : 4, 2, warning ? C.CORAL : C.SIGNAL);\n      }\n    }\n  }\n}\n\nfunction drawHazards(scroll) {\n  for (const h of course.hazards) {\n    const x = h.x - scroll;\n    if (x + h.w <= 0 || x >= SCREEN_W) continue;\n    const { y, height, phase, warning, danger } = hazardState(h);\n    const flash = phase % 8 < 4;\n    const signal = danger ? C.HOT : warning ? C.GOLD : C.PURPLE;\n    if (h.kind === 'contact') {\n      rectfill(x, h.y - 2, h.w, 4, C.INK);\n      for (let i = 2; i < h.w - 1; i += 5) {\n        rectfill(x + i, h.y - 2, 3, 2, signal);\n        if (danger || warning && flash) {\n          const tip = h.y - (danger ? 7 + ((i + phase) % 3) : 5);\n          line(x + i, h.y - 2, x + i + 2, tip, signal);\n          if (danger) line(x + i + 2, tip, x + i + 4, h.y - 5, C.GOLD);\n        }\n      }\n    } else {\n      rectfill(x + 13, h.raisedY - 14, 14, y - h.raisedY + 16, C.INK);\n      rectfill(x + 16, h.raisedY - 14, 4, y - h.raisedY + 16, C.STEEL);\n      rectfill(x, y, h.w, height, C.INK);\n      rectfill(x + 2, y + height - 3, h.w - 4, 2, signal);\n      for (let i = 5; i < h.w - 3; i += 8) line(x + i, y + 2, x + i - 2, y + 6, C.STEEL);\n      if (warning) {\n        rect(x - 1, y - 1, h.w + 2, height + 2, flash ? C.GOLD : C.CORAL);\n        const marker = x + Math.floor(h.w / 2);\n        const arrowY = h.y - (flash ? 8 : 12);\n        line(marker - 4, arrowY, marker, arrowY + 4, C.GOLD);\n        line(marker, arrowY + 4, marker + 4, arrowY, C.GOLD);\n      }\n    }\n  }\n}\n\nfunction drawStage(scroll) {\n  const prompt = interaction();\n  let queueTerminal = null;\n  clip(0, 16, SCREEN_W, SCREEN_H - 16);\n  drawDevices(scroll);\n  drawHazards(scroll);\n  for (const s of sockets) {\n    const { x, y } = socketPoint(s);\n    // the exit's terminal stands behind its socket (drawn after it, so the socket stays in front)\n    if (s.mode === 'exit') queueTerminal = { x: x - scroll - 16, y: y - 21 };\n    const live = s.active || s.mode === 'exit';\n    const label = s.mode === 'exit' ? 'B EXIT' : s.targets.some(d => d.kind === 'scanline') ? 'B POWER' : s.mode === 'switch' && live ? 'B RESET' : 'B PLUG';\n    drawSocket(x - scroll, y, live ? ART.sprites.socketLive : ART.sprites.socketIdle, prompt === s ? label : '');\n  }\n  if (queueTerminal) drawSprite(ART.sprites.exitTerminal, queueTerminal.x, queueTerminal.y, false, 2);\n  if (clock < bit.plugUntil) {\n    const { x, y } = socketPoint(bit.pluggedSocket);\n    drawPlugSparks(x - scroll, y);\n  }\n  for (const sign of course.signs) {\n    const w = sign.text.length * 8 + 12, x = sign.x - scroll - w / 2;\n    rectfill(x, sign.y, w, 14, C.PANEL);\n    rect(x, sign.y, w, 14, C.TRIM);\n    print(sign.text, x + 6, sign.y + 4, C.MUTED);\n  }\n  for (const [i, beacon] of course.beacons.entries()) {\n    const x = beacon.x - scroll, lit = i <= (checkpoint?.index ?? -1);\n    rectfill(x - 1, beacon.y - 28, 3, 28, C.TRIM);\n    rectfill(x + 2, beacon.y - 27, 11, 7, lit ? C.CYAN : C.PURPLE);\n    rectfill(x + 2, beacon.y - 22, 11, 2, lit ? C.STEEL : C.TRIM);\n  }\n  if (course.practice) drawSprite(ART.sprites.labConsole, 42 - scroll, 150, false, 2);\n  for (const item of course.items) {\n    if (hasItem(item)) continue;\n    const bob = Math.floor(clock / 12) % 4;\n    const asset = ART.sprites[item.kind === 'treasure' ? 'treasure' : 'piece'];\n    drawSprite(asset, item.x - scroll - 8, item.y - 8 + (bob === 3 ? 1 : bob));\n  }\n  if (!deathTimer) drawSprite(bitSprite(), Math.floor(bit.x) - scroll - 16, Math.floor(bit.y) - 31, bit.facingLeft);\n  clip();\n  rectfill(0, 0, SCREEN_W, 15, C.PANEL);\n  rectfill(0, 15, SCREEN_W, 1, C.TRIM);\n  if (course.practice) {\n    print('LAB PRACTICE', 5, 4, C.WHITE);\n    print('STATION ' + ((checkpoint?.index ?? -1) + 2) + '/3', 154, 4, C.CYAN);\n  } else {\n    print(stageNumber(course) + ' ' + ZONES[course.zone], 5, 4, C.WHITE);\n    print('T ' + collected('treasure') + '/1   P ' + collected('piece') + '/2', 131, 4, C.GOLD);\n  }\n  if (deathTimer && !paused) centered('REBOOTING', 70, C.MUTED);\n  else if (!course.practice && state === 'play' && clock < 100) {\n    const width = course.name.length * 8 + 12;\n    rectfill((SCREEN_W - width) / 2, 21, width, 14, C.PANEL);\n    rect((SCREEN_W - width) / 2, 21, width, 14, C.TRIM);\n    centered(course.name, 25, C.WHITE);\n  }\n}\n\nfunction bitSprite() {\n  const sprites = ART.sprites;\n  if (state === 'clear' || clock < bit.cheerUntil) return sprites.heroCheer;\n  if (clock < bit.plugUntil) return sprites.heroPlug;\n  if (!bit.support) return bit.vy < 0 ? sprites.heroJump : sprites.heroFall;\n  if (clock < bit.landUntil) return sprites.heroLand;\n  if (bit.walk) return WALK[Math.floor(bit.walk / 5) % WALK.length];\n  return clock % 150 >= 145 ? sprites.heroBlink : sprites.heroIdle;\n}\n\nfunction drawPlugSparks(x, y) {\n  const spread = Math.floor((PLUG_FRAMES + clock - bit.plugUntil) / 3);\n  line(x - 9 - spread, y - 8, x - 12 - spread, y - 11, C.CYAN);\n  line(x + 13 + spread, y - 5, x + 16 + spread, y - 7, C.CYAN);\n  rectfill(x + 9, y - 13 - spread, 1, 2, C.GOLD);\n}\n\nfunction drawSocket(x, y, asset, prompt) {\n  drawSprite(asset, x - 8, y - 8, false, 2);\n  if (!prompt || paused || deathTimer || (state !== 'play' && (state !== 'lab' || labMenu))) return;\n  const width = prompt.length * 8;\n  const left = clamp(x - width / 2, 3, SCREEN_W - width - 3);\n  rectfill(left - 2, y - 32, width + 4, 13, C.INK);\n  rect(left - 2, y - 32, width + 4, 13, C.TRIM);\n  print(prompt, left, y - 30, C.WHITE);\n}\n\nfunction drawSprite(asset, x, y, flip = false, prio = 3) {\n  if (x <= -asset.size || x >= SCREEN_W || y <= -asset.size || y >= SCREEN_H) return;\n  spr(asset.tile, x, y, { size: asset.size, pal: asset.pal, prio, fx: flip });\n}\n\nfunction drawPause() {\n  const items = pauseOptions();\n  panel(39, 70, 178, 41 + items.length * 14);\n  centered('PAUSED', 80, C.GOLD);\n  for (let i = 0; i < items.length; i++) {\n    print(i === pauseSel ? '>' : ' ', 48, 99 + i * 14, C.CYAN);\n    print(items[i], 64, 99 + i * 14, i === pauseSel ? C.WHITE : C.MUTED);\n  }\n}\n\nfunction drawClear() {\n  const next = nextStage();\n  panel(24, 60, 208, 102);\n  const title = course.practice ? 'PRACTICE COMPLETE' : next ? 'STAGE CLEAR' : 'CAMPAIGN CLEAR';\n  centered(title, 71, C.GOLD);\n  if (course.practice) centered('ALL 3 STATIONS', 97, C.MUTED);\n  else {\n    centered(hasTreasure() ? course.treasureName : 'TREASURE MISSING', 90, C.MUTED);\n    centered('PIECES ' + collected('piece') + '/2', 105, C.MUTED);\n  }\n  centered(course.practice ? 'A REPLAY   B LAB' : continuesZone() ? 'A NEXT   B LAB' : 'A BACK TO LAB', 126, C.WHITE);\n  if (!course.practice) centered('LEFT REPLAYS STAGE', 143, C.MUTED);\n}\n\nfunction panel(x, y, w, h) {\n  rectfill(x + 3, y + 3, w, h, C.INK);\n  rectfill(x, y, w, h, C.PANEL);\n  rect(x, y, w, h, C.TRIM);\n}\n\nfunction centered(text, y, colorIndex) {\n  print(text, 128 - text.length * 4, y, colorIndex);\n}\n\nfunction scanline(y) {\n  const name = state === 'title' ? 'sky' : (course.practice || course.hub) ? 'labSky' :\n    STAGE_SKIES[course.zone];\n  gradientLine(ART.gradients[name], y);\n}\n",

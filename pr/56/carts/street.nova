  "label": "",
  "code": "// Street: the test of the art kit's drawn figures (docs/dev/snes-picture.md; the art is all in art.py). A brawler drawn\n// in designed shapes on a skeleton, his animations rendered from poses, on a night street after Streets of Rage 2.\n// LEFT and RIGHT walk, A punches, B kicks.\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {},\n  scenes: {\"city\": {\"h\": 16, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"fence\": {\"h\": 20, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"ground\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"GOLD\": 114, \"INK\": 115, \"WHITE\": 113},\n  big: {\"idle0\": {\"h\": 76, \"parts\": [[24, 16, 480, 8, 0, 0], [24, 24, 481, 8, 0, 0], [32, 0, 482, 16, 0, 0], [32, 16, 484, 16, 0, 0], [48, 16, 486, 16, 0, 0], [24, 32, 488, 8, 0, 0], [24, 40, 489, 8, 0, 0], [24, 48, 490, 8, 0, 0], [24, 56, 491, 8, 0, 0], [32, 32, 492, 16, 0, 0], [48, 32, 494, 8, 0, 0], [56, 32, 495, 8, 0, 0], [32, 48, 512, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 504, 8, 0, 0], [48, 64, 505, 8, 0, 0]], \"w\": 82}, \"idle1\": {\"h\": 76, \"parts\": [[24, 16, 480, 8, 0, 0], [24, 24, 506, 8, 0, 0], [32, 0, 482, 16, 0, 0], [32, 16, 514, 16, 0, 0], [48, 16, 516, 16, 0, 0], [24, 32, 488, 8, 0, 0], [24, 40, 489, 8, 0, 0], [24, 48, 490, 8, 0, 0], [24, 56, 491, 8, 0, 0], [32, 32, 518, 16, 0, 0], [48, 32, 507, 8, 0, 0], [56, 32, 510, 8, 0, 0], [32, 48, 512, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 504, 8, 0, 0], [48, 64, 505, 8, 0, 0]], \"w\": 82}, \"kick0\": {\"h\": 76, \"parts\": [[24, 16, 480, 8, 0, 0], [24, 24, 481, 8, 0, 0], [32, 0, 482, 16, 0, 0], [32, 16, 484, 16, 0, 0], [48, 16, 486, 16, 0, 0], [24, 32, 488, 8, 0, 0], [24, 40, 489, 8, 0, 0], [24, 48, 490, 8, 0, 0], [24, 56, 491, 8, 0, 0], [32, 32, 492, 16, 0, 0], [48, 32, 494, 8, 0, 0], [56, 32, 495, 8, 0, 0], [32, 48, 512, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 504, 8, 0, 0], [48, 64, 505, 8, 0, 0]], \"w\": 82}, \"kick1\": {\"h\": 76, \"parts\": [[24, 0, 893, 8, 0, 0], [24, 8, 896, 8, 0, 0], [24, 16, 897, 8, 0, 0], [24, 24, 898, 8, 0, 0], [32, 0, 899, 8, 0, 0], [32, 8, 900, 8, 0, 0], [32, 16, 902, 16, 0, 0], [48, 16, 904, 16, 0, 0], [24, 32, 901, 8, 0, 0], [24, 40, 906, 8, 0, 0], [24, 48, 907, 8, 0, 0], [24, 56, 908, 8, 0, 0], [32, 32, 960, 32, 0, 0], [24, 64, 909, 8, 0, 0], [32, 64, 910, 8, 0, 0]], \"w\": 82}, \"kick2\": {\"h\": 76, \"parts\": [[24, 0, 911, 8, 0, 0], [24, 8, 912, 8, 0, 0], [16, 16, 928, 16, 0, 0], [32, 0, 913, 8, 0, 0], [32, 8, 914, 8, 0, 0], [32, 16, 930, 16, 0, 0], [48, 16, 932, 16, 0, 0], [24, 32, 915, 8, 0, 0], [24, 40, 856, 8, 0, 0], [24, 48, 916, 8, 0, 0], [24, 56, 917, 8, 0, 0], [32, 32, 934, 16, 0, 0], [48, 32, 936, 16, 0, 0], [32, 48, 938, 16, 0, 0], [64, 32, 940, 16, 0, 0], [24, 64, 922, 8, 0, 0], [32, 64, 923, 8, 0, 0], [40, 64, 924, 8, 0, 0]], \"w\": 82}, \"kick3\": {\"h\": 76, \"parts\": [[24, 8, 925, 8, 0, 0], [24, 16, 926, 8, 0, 0], [24, 24, 927, 8, 0, 0], [32, 0, 942, 16, 0, 0], [32, 16, 964, 16, 0, 0], [48, 16, 966, 16, 0, 0], [24, 32, 968, 8, 0, 0], [24, 40, 969, 8, 0, 0], [24, 48, 490, 8, 0, 0], [24, 56, 491, 8, 0, 0], [32, 32, 972, 32, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 970, 8, 0, 0], [40, 64, 971, 8, 0, 0], [48, 64, 984, 8, 0, 0]], \"w\": 82}, \"punch0\": {\"h\": 76, \"parts\": [[24, 16, 480, 8, 0, 0], [24, 24, 481, 8, 0, 0], [32, 0, 482, 16, 0, 0], [32, 16, 484, 16, 0, 0], [48, 16, 486, 16, 0, 0], [24, 32, 488, 8, 0, 0], [24, 40, 489, 8, 0, 0], [24, 48, 490, 8, 0, 0], [24, 56, 491, 8, 0, 0], [32, 32, 492, 16, 0, 0], [48, 32, 494, 8, 0, 0], [56, 32, 495, 8, 0, 0], [32, 48, 512, 16, 0, 0], [24, 64, 496, 8, 0, 0], [32, 64, 497, 8, 0, 0], [40, 64, 504, 8, 0, 0], [48, 64, 505, 8, 0, 0]], \"w\": 82}, \"punch1\": {\"h\": 76, \"parts\": [[24, 8, 782, 8, 0, 0], [24, 16, 783, 8, 0, 0], [24, 24, 786, 8, 0, 0], [32, 0, 800, 16, 0, 0], [32, 16, 802, 16, 0, 0], [48, 16, 804, 16, 0, 0], [24, 32, 787, 8, 0, 0], [24, 40, 788, 8, 0, 0], [24, 48, 789, 8, 0, 0], [24, 56, 796, 8, 0, 0], [32, 32, 806, 16, 0, 0], [48, 32, 797, 8, 0, 0], [32, 48, 808, 16, 0, 0], [24, 64, 798, 8, 0, 0], [32, 64, 799, 8, 0, 0], [40, 64, 810, 8, 0, 0], [48, 64, 811, 8, 0, 0]], \"w\": 82}, \"punch2\": {\"h\": 76, \"parts\": [[32, 0, 832, 32, 0, 0], [64, 16, 812, 8, 0, 0], [64, 24, 813, 8, 0, 0], [24, 48, 814, 8, 0, 0], [24, 56, 815, 8, 0, 0], [32, 32, 836, 32, 0, 0], [24, 64, 826, 8, 0, 0], [32, 64, 827, 8, 0, 0], [40, 64, 828, 8, 0, 0], [48, 64, 829, 8, 0, 0], [56, 64, 830, 8, 0, 0]], \"w\": 82}, \"punch3\": {\"h\": 76, \"parts\": [[24, 16, 831, 8, 0, 0], [24, 24, 840, 8, 0, 0], [32, 0, 842, 16, 0, 0], [32, 16, 844, 16, 0, 0], [48, 16, 846, 16, 0, 0], [24, 32, 841, 8, 0, 0], [24, 40, 856, 8, 0, 0], [24, 48, 857, 8, 0, 0], [24, 56, 872, 8, 0, 0], [32, 32, 874, 16, 0, 0], [48, 32, 873, 8, 0, 0], [56, 32, 876, 8, 0, 0], [32, 48, 878, 16, 0, 0], [24, 64, 877, 8, 0, 0], [32, 64, 888, 8, 0, 0], [40, 64, 889, 8, 0, 0], [48, 64, 892, 8, 0, 0]], \"w\": 82}, \"shadow\": {\"h\": 8, \"parts\": [[0, 0, 985, 8, 4, 0], [8, 0, 986, 8, 4, 0], [16, 0, 987, 8, 4, 0], [24, 0, 986, 8, 4, 1], [32, 0, 985, 8, 4, 1]], \"w\": 40}, \"walk0\": {\"h\": 76, \"parts\": [[16, 16, 520, 16, 0, 0], [32, 0, 522, 16, 0, 0], [32, 16, 524, 16, 0, 0], [48, 16, 526, 16, 0, 0], [16, 32, 544, 16, 0, 0], [16, 48, 546, 16, 0, 0], [32, 32, 576, 32, 0, 0], [64, 32, 511, 8, 0, 0], [16, 64, 548, 8, 0, 0], [24, 64, 549, 8, 0, 0], [32, 64, 550, 8, 0, 0], [40, 64, 551, 8, 0, 0], [48, 64, 552, 8, 0, 0], [56, 64, 553, 8, 0, 0]], \"w\": 82}, \"walk1\": {\"h\": 76, \"parts\": [[24, 16, 554, 8, 0, 0], [24, 24, 555, 8, 0, 0], [32, 8, 556, 8, 0, 0], [40, 8, 557, 8, 0, 0], [32, 16, 558, 16, 0, 0], [48, 24, 564, 8, 0, 0], [24, 32, 565, 8, 0, 0], [24, 40, 566, 8, 0, 0], [16, 48, 580, 16, 0, 0], [32, 32, 584, 32, 0, 0], [16, 64, 567, 8, 0, 0], [24, 64, 568, 8, 0, 0], [32, 64, 582, 16, 0, 0], [48, 64, 569, 8, 0, 0], [48, 72, 570, 8, 0, 0]], \"w\": 82}, \"walk2\": {\"h\": 76, \"parts\": [[24, 16, 571, 8, 0, 0], [24, 24, 572, 8, 0, 0], [32, 0, 522, 16, 0, 0], [32, 16, 588, 16, 0, 0], [48, 16, 573, 8, 0, 0], [48, 24, 590, 8, 0, 0], [24, 32, 591, 8, 0, 0], [24, 40, 606, 8, 0, 0], [24, 48, 607, 8, 0, 0], [24, 56, 612, 8, 0, 0], [32, 32, 640, 32, 0, 0], [24, 64, 613, 8, 0, 0], [32, 64, 614, 8, 0, 0], [40, 64, 615, 8, 0, 0]], \"w\": 82}, \"walk3\": {\"h\": 76, \"parts\": [[24, 16, 620, 8, 0, 0], [24, 24, 621, 8, 0, 0], [32, 0, 622, 16, 0, 0], [32, 16, 644, 16, 0, 0], [48, 16, 573, 8, 0, 0], [48, 24, 628, 8, 0, 0], [24, 32, 629, 8, 0, 0], [24, 40, 630, 8, 0, 0], [24, 48, 631, 8, 0, 0], [24, 56, 636, 8, 0, 0], [32, 32, 646, 16, 0, 0], [48, 32, 637, 8, 0, 0], [48, 40, 637, 8, 0, 2], [32, 48, 648, 16, 0, 0], [24, 64, 650, 8, 0, 0], [32, 64, 651, 8, 0, 0], [40, 64, 652, 8, 0, 0], [48, 64, 653, 8, 0, 0]], \"w\": 82}, \"walk4\": {\"h\": 76, \"parts\": [[24, 16, 654, 8, 0, 0], [24, 24, 655, 8, 0, 0], [32, 0, 522, 16, 0, 0], [32, 16, 676, 16, 0, 0], [48, 24, 666, 8, 0, 0], [24, 32, 667, 8, 0, 0], [24, 40, 668, 8, 0, 0], [16, 48, 678, 16, 0, 0], [32, 32, 704, 32, 0, 0], [16, 64, 669, 8, 0, 0], [24, 64, 670, 8, 0, 0], [32, 64, 671, 8, 0, 0], [40, 64, 680, 8, 0, 0], [48, 64, 681, 8, 0, 0], [56, 64, 553, 8, 0, 0]], \"w\": 82}, \"walk5\": {\"h\": 76, \"parts\": [[24, 16, 554, 8, 0, 0], [24, 24, 682, 8, 0, 0], [32, 8, 556, 8, 0, 0], [40, 8, 557, 8, 0, 0], [32, 16, 684, 16, 0, 0], [48, 24, 683, 8, 0, 0], [24, 32, 686, 8, 0, 0], [24, 40, 687, 8, 0, 0], [16, 48, 708, 16, 0, 0], [32, 32, 712, 32, 0, 0], [16, 64, 696, 8, 0, 0], [24, 64, 697, 8, 0, 0], [32, 64, 710, 16, 0, 0], [48, 64, 698, 8, 0, 0], [48, 72, 570, 8, 0, 0]], \"w\": 82}, \"walk6\": {\"h\": 76, \"parts\": [[24, 16, 571, 8, 0, 0], [24, 24, 572, 8, 0, 0], [32, 0, 522, 16, 0, 0], [32, 16, 588, 16, 0, 0], [48, 16, 573, 8, 0, 0], [48, 24, 590, 8, 0, 0], [24, 32, 591, 8, 0, 0], [24, 40, 699, 8, 0, 0], [24, 48, 702, 8, 0, 0], [24, 56, 703, 8, 0, 0], [32, 32, 716, 32, 0, 0], [24, 64, 740, 8, 0, 0], [32, 64, 741, 8, 0, 0], [40, 64, 742, 8, 0, 0]], \"w\": 82}, \"walk7\": {\"h\": 76, \"parts\": [[24, 16, 743, 8, 0, 0], [24, 24, 756, 8, 0, 0], [32, 0, 622, 16, 0, 0], [32, 16, 768, 16, 0, 0], [48, 16, 757, 8, 0, 0], [48, 24, 758, 8, 0, 0], [24, 32, 759, 8, 0, 0], [24, 40, 770, 8, 0, 0], [24, 48, 771, 8, 0, 0], [24, 56, 772, 8, 0, 0], [32, 32, 774, 16, 0, 0], [48, 32, 776, 16, 0, 0], [32, 48, 778, 16, 0, 0], [24, 64, 773, 8, 0, 0], [32, 64, 780, 8, 0, 0], [40, 64, 781, 8, 0, 0], [48, 64, 653, 8, 0, 0]], \"w\": 82}},\n  anims: {\"idle\": [\"idle0\", \"idle1\"], \"kick\": [\"kick0\", \"kick1\", \"kick2\", \"kick3\"], \"punch\": [\"punch0\", \"punch1\", \"punch2\", \"punch3\"], \"walk\": [\"walk0\", \"walk1\", \"walk2\", \"walk3\", \"walk4\", \"walk5\", \"walk6\", \"walk7\"]},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[4129,4129,4129,4129,4129,4129,4130,4130,5154,5154,5154,5154,5154,5154,5154,5154,5154,6178,6179,6179,6211,6211,6211,6211,6211,7235,7235,7235,7235,7236,7236,7236,8260,8260,8260,8260,8260,8260,8260,8292,9317,9317,9317,9317,9317,9317,9317,9318,9318,9318,9318,9318,9318,10374,10375,10375,10375,10375,10375,10375,10375,10376,10376,10376,10376,10376,11432,11433,11433,11433,11433,11433,11433,11433,11434,11434,11434,11434,11434,11434,12491,12491,12491,12491,12491,12492,12492,12492,12524,12524,12525,12525,12525,12525,12526,12526,12558,12558,12558,12559,12559,12559,12559,12560,12592,12592,12592,12593,12593,12593,12593,12593,12626,12626,12626,12626,13651,13651,13651,13651,13684],\"y0\":0}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n\nconst FEET = 70;            // the rig's canvas: the soles are this many pixels below its top\nconst GROUND = 204;         // where his feet are on the screen\nconst SPEED = { idle: 30, walk: 7, punch: 5, kick: 6 };   // frames each animation frame is shown\nlet x = 100, facing = 1, act = 'idle', frame = 0, timer = 0;\n\nfunction init() {\n  bg(2, { mx: ART.scenes.city.mx, my: 0, mw: 32, mh: 28, x: 0, y: 12, wrap: true, show: true });\n  bg(1, { mx: ART.scenes.fence.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n  bg(0, { mx: ART.scenes.ground.mx, my: 0, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n}\n\nfunction start(a) { if (act !== a) { act = a; frame = 0; timer = 0; } }\n\nfunction update() {\n  const busy = (act === 'punch' || act === 'kick');\n  if (!busy) {\n    if (btnp(A)) start('punch');\n    else if (btnp(B)) start('kick');\n    else if (btn(LEFT) || btn(RIGHT)) {\n      facing = btn(LEFT) ? -1 : 1;\n      x = clamp(x + facing * 1.2, -20, 200);\n      start('walk');\n    } else start('idle');\n  }\n  const n = ART.anims[act].length;\n  if (++timer >= SPEED[act]) {\n    timer = 0;\n    frame++;\n    if (frame >= n) { frame = 0; if (busy) start('idle'); }\n  }\n}\n\nfunction draw() {\n  cls();\n  // his shadow (sprite palette 4) is subtracted from the pavement under him\n  blend({ layers: ['spr'], op: 'sub' });\n  const b = ART.big[ART.anims[act][frame]];\n  bigSprite(b, flr(x), GROUND - FEET, { fx: facing < 0, prio: 2 });\n  bigSprite(ART.big.shadow, flr(x) + (facing < 0 ? b.w - 30 - 40 : 30) - 4, GROUND - 4, { prio: 2 });\n  print('WALK  A:PUNCH  B:KICK', 128 - 21 * 4, 214, ART.colors.WHITE);\n}\n\nfunction scanline(y) { gradientLine(ART.gradients.sky, y); }\n",

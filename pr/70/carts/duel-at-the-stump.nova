{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Duel at the Stump",
    "author": "Lucy",
    "description": "Hold to charge and release to flip a knife onto a woodland stump, using green power-meter zones to time single and double flips. Two players share the controls and alternate throws, with separate scores and streaks. First playable version."
  },
  "label": "",
  "code": "// Duel at the Stump. Started with tools/new-cart.js; first playable stump and two-player handoff.\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"chip\": {\"pal\": 2, \"size\": 8, \"tile\": 642}, \"knife0\": {\"pal\": 0, \"size\": 32, \"tile\": 384}, \"knife1\": {\"pal\": 0, \"size\": 32, \"tile\": 388}, \"knife10\": {\"pal\": 0, \"size\": 32, \"tile\": 520}, \"knife11\": {\"pal\": 0, \"size\": 32, \"tile\": 524}, \"knife12\": {\"pal\": 0, \"size\": 32, \"tile\": 576}, \"knife13\": {\"pal\": 0, \"size\": 32, \"tile\": 580}, \"knife14\": {\"pal\": 0, \"size\": 32, \"tile\": 584}, \"knife15\": {\"pal\": 0, \"size\": 32, \"tile\": 588}, \"knife2\": {\"pal\": 0, \"size\": 32, \"tile\": 392}, \"knife3\": {\"pal\": 0, \"size\": 32, \"tile\": 396}, \"knife4\": {\"pal\": 0, \"size\": 32, \"tile\": 448}, \"knife5\": {\"pal\": 0, \"size\": 32, \"tile\": 452}, \"knife6\": {\"pal\": 0, \"size\": 32, \"tile\": 456}, \"knife7\": {\"pal\": 0, \"size\": 32, \"tile\": 460}, \"knife8\": {\"pal\": 0, \"size\": 32, \"tile\": 512}, \"knife9\": {\"pal\": 0, \"size\": 32, \"tile\": 516}, \"leaf\": {\"pal\": 2, \"size\": 8, \"tile\": 640}, \"spark\": {\"pal\": 2, \"size\": 8, \"tile\": 641}},\n  scenes: {\"far\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"forest\": {\"h\": 28, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}, \"stump\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 3, \"w\": 32}},\n  colors: {\"BORDER\": 3, \"CREAM\": 4, \"GLASS\": 200, \"GREEN\": 8, \"INK\": 1, \"MUTED\": 2, \"ORANGE\": 6, \"PAPER\": 7, \"SHADOW\": 201, \"TEAL\": 5},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[26320,26320,26352,26352,26352,26353,26353,26353,26353,26353,26353,26353,26353,26353,26353,26353,26353,26353,26353,26353,26354,26354,26354,26354,26354,26354,26354,26386,26386,26386,26386,26386,26386,26386,26386,26387,26387,26387,26387,26387,26387,26387,26387,26387,26387,26387,26387,26387,26387,26387,26388,26420,26420,26420,26420,26420,26420,26420,26420,26420,26420,26420,26420,26420,26420,26421,26421,26421,26421,26421,26421,26421,26421,27445,27445,27445,27477,27477,27477,27477,27478,27478,26454,26454,26454,26454,26454,26454,26454,26454,26454,26454,26454,26455,26455,26455,26455,26455,26455,26455,26455,26455,26455,26455,26455,26455,26456,26456,26456,26456,25432,25432,25432,25432,25464,25464,25464,25464,25464,25465,25465,25465,25465,25465,25465,25465,25465,25465,25465,25465,25465,25465,25466,25466,25466,25466,24442,24442,24442,24442,24442,24442,24442,24442,24442,24442,24443,24443,24443,24443,24443,24443,24443,24443,24443,24443,24443,24443,24443,24476,23452,23452],\"y0\":32}},\n};\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n\n// GEOMETRY BEGIN — art.py reads this same geometry so wood and contacts coincide.\nconst STUMP = {left:88,right:168,top:168,bottom:208};\nconst SHAPE = [[0,14],[3,4],[3,-3],[2,-3],[2,-12],[-2,-12],[-2,-3],[-3,-3],[-3,4]];\n// GEOMETRY END\nconst TUNE = {chargeMax:60,gravity:0.28,substeps:4,speedMin:5.6,speedRange:2,spinMin:0.14,spinRange:0.10,tolerance:24*Math.PI/180,perfect:6*Math.PI/180,flightLimit:180,feedback:45,rounds:10};\n// Measured by real charge/release throws; the physics sweep guards these helper bands.\nconst RELEASE_ZONES = [{from:3,to:10,flips:1},{from:55,to:59,flips:2}];\nfunction releaseZone(held){return RELEASE_ZONES.find(z=>held>=z.from&&held<=z.to);}\nconst TAU = Math.PI*2;\nconst SFX = {move:0,select:1,back:2,pause:3,launch:4,stick:5,miss:6,handoff:7,finish:8};\nconst SONG = {title:0,play:1}, SFX_CH = [6,7];\nlet fxNext=0,playing=-1;\nfunction fx(n){sfx(n,SFX_CH[fxNext]);fxNext^=1;}\nfunction play(n){if(playing!==n){playing=n;music(n);}}\nlet skipTitle=false,state='title',timer=0,clock=0,active=0,selection=0;\nlet players=[],knife=null,charge=0,neutral=false,resumeState='aim',resumeTimer=0,helpFrom='title',confirmAction='';\nlet last=null,particles=[],attemptLog=[];\nlet inputMask=0,prevMask=0;\nconst BUTTONS=[UP,DOWN,LEFT,RIGHT,A,B,START,SELECT];\nconst pressed=b=>!!(inputMask&(1<<b))&&!(prevMask&(1<<b));\nfunction enter(s){state=s;timer=0;selection=0;}\nfunction newKnife(){return{x:128,y:154,vx:0,vy:0,angle:0,omega:0,travel:0,armed:false,spent:false,age:0};}\nfunction startGame(){\n  players=Array.from({length:2},()=>({score:0,combo:0,bestCombo:0,hits:0,attempts:0}));\n  active=0;charge=0;neutral=false;last=null;particles=[];attemptLog=[];knife=newKnife();enter('ready');play(SONG.play);\n}\nfunction init(){\n  for(const [layer,key]of [[2,'far'],[1,'forest'],[0,'stump']]){\n    const s=ART.scenes[key];bg(layer,{mx:s.mx,my:s.my,mw:s.w,mh:s.h,x:0,y:0,wrap:false,show:true});\n  }\n  blend({layers:['overlay'],half:true});brightness(15);\n  startGame();if(!skipTitle){enter('title');play(SONG.title);}\n}\nfunction vertices(k){const c=Math.cos(k.angle),s=Math.sin(k.angle);return SHAPE.map(([x,y])=>({x:k.x+x*c+y*s,y:k.y-x*s+y*c}));}\nfunction angleError(a){const n=((a%TAU)+TAU)%TAU;return Math.min(n,TAU-n);}\nfunction launch(){\n  const q=charge/TUNE.chargeMax;knife=newKnife();knife.vy=-(TUNE.speedMin+TUNE.speedRange*q);knife.omega=TUNE.spinMin+TUNE.spinRange*q;\n  knife.held=charge;fx(SFX.launch);enter('flight');\n}\n// Earliest swept contact among actual outline vertices; index 0 is the pointed tip.\nfunction contact(before,after){\n  let first=null;\n  const add=(time,index,side)=>{if(time>=0&&time<=1&&(!first||time<first.time-1e-8)){first={time,index,side};}};\n  for(let i=0;i<after.length;i++){\n    const a=before[i],b=after[i];\n    if(a.y<STUMP.top&&b.y>=STUMP.top){const u=(STUMP.top-a.y)/(b.y-a.y),x=a.x+(b.x-a.x)*u;if(x>=STUMP.left&&x<=STUMP.right)add(u,i,'top');}\n    for(const [edge,side]of [[STUMP.left,'left'],[STUMP.right,'right']]){\n      if((side==='left'&&a.x<edge&&b.x>=edge)||(side==='right'&&a.x>edge&&b.x<=edge)){\n        const u=(edge-a.x)/(b.x-a.x),y=a.y+(b.y-a.y)*u;if(y>=STUMP.top&&y<=STUMP.bottom)add(u,i,side);\n      }\n    }\n  }\n  return first;\n}\nfunction burst(x,y,good){for(let i=0;i<8&&particles.length<12;i++)particles.push({x,y,vx:rnd(2.2)-1.1,vy:-rnd(1.8)-0.2,life:30+rndi(0,14),good});}\nfunction resolve(good,flips=0,error=0,reason=''){\n  if(knife.spent)return;knife.spent=true;\n  const p=players[active];p.attempts++;\n  if(good){p.score+=10;p.combo++;p.bestCombo=Math.max(p.bestCombo,p.combo);p.hits++;knife.angle=0;knife.y=STUMP.top+1-14;knife.vy=0;knife.vx=0;knife.omega=0;fx(SFX.stick);}\n  else {p.combo=0;knife.vy=-1.7;knife.vx=1.1;knife.omega=0.18;fx(SFX.miss);}\n  last={good,flips,error,reason,points:good?10:0,player:active,held:knife.held};\n  attemptLog.push({...last});burst(128,STUMP.top,good);enter('feedback');\n}\nfunction stepFlight(){\n  const dt=1/TUNE.substeps;\n  for(let j=0;j<TUNE.substeps&&state==='flight';j++){\n    const old={...knife},before=vertices(knife);\n    knife.vy+=TUNE.gravity*dt;knife.x+=knife.vx*dt;knife.y+=knife.vy*dt;knife.angle+=knife.omega*dt;knife.travel+=Math.abs(knife.omega*dt);\n    const after=vertices(knife);\n    if(!knife.armed&&Math.max(...after.map(v=>v.y))<STUMP.top-0.25)knife.armed=true;\n    if(knife.armed){\n      const hit=contact(before,after);\n      if(hit){\n        const angle=old.angle+(knife.angle-old.angle)*hit.time,error=angleError(angle);\n        const traveled=old.travel+(knife.travel-old.travel)*hit.time;\n        const flips=Math.floor((traveled+TUNE.tolerance+1e-8)/TAU);\n        const good=hit.side==='top'&&hit.index===0&&knife.vy>0&&error<=TUNE.tolerance&&flips>=1;\n        knife.x=old.x+(knife.x-old.x)*hit.time;knife.y=old.y+(knife.y-old.y)*hit.time;knife.angle=angle;\n        resolve(good,good?flips:0,error,hit.index===0?'angle':'handle/side');return;\n      }\n    }\n  }\n  if(++knife.age>=TUNE.flightLimit||knife.y>224||knife.x< -32||knife.x>288)resolve(false,0,0,'out');\n}\nfunction nextTurn(){\n  if(players.every(p=>p.attempts>=TUNE.rounds)){enter('results');fx(SFX.finish);return;}\n  active^=1;knife=newKnife();charge=0;neutral=false;enter('ready');fx(SFX.handoff);\n}\nfunction pause(){resumeState=state==='charge'?'aim':state;resumeTimer=state==='charge'?0:timer;if(state==='charge'){charge=0;neutral=false;}enter('pause');fx(SFX.pause);}\nfunction resume(){state=resumeState;timer=resumeTimer;neutral=false;}\nfunction menuMove(n){if(pressed(UP)){selection=(selection+n-1)%n;fx(SFX.move);}if(pressed(DOWN)){selection=(selection+1)%n;fx(SFX.move);}}\nfunction update(){\n  inputMask=0;for(const b of BUTTONS)if(btn(b,0))inputMask|=1<<b;clock++;\n  if(!['pause','help','confirm'].includes(state)&&!pressed(START))timer++;\n  if(['aim','charge','flight','feedback'].includes(state)&&pressed(START))pause();\n  else if(['aim','charge','ready'].includes(state)&&pressed(SELECT)){\n    helpFrom=state==='charge'?'aim':state;charge=0;neutral=false;enter('help');\n  }else if(state==='title'){\n    menuMove(2);if(pressed(A)||pressed(START)){fx(SFX.select);if(selection===0)startGame();else{helpFrom='title';enter('help');}}\n  }else if(state==='ready'){\n    if(pressed(A)||pressed(START)){enter('aim');neutral=false;fx(SFX.select);}\n  }else if(state==='aim'){\n    if(!neutral){if(!btn(A)&&!btn(B))neutral=true;}\n    else if(pressed(A)){charge=1;enter('charge');}\n  }else if(state==='charge'){\n    if(pressed(B)){charge=0;neutral=false;enter('aim');fx(SFX.back);}\n    else if(!btn(A))launch();else charge=Math.min(TUNE.chargeMax,charge+1);\n  }else if(state==='flight')stepFlight();\n  else if(state==='feedback'){\n    if(!last.good){knife.vy+=0.15;knife.y=Math.min(224,knife.y+knife.vy);knife.x+=knife.vx;knife.angle+=knife.omega;}\n    if(timer>=TUNE.feedback||(timer>=15&&pressed(B)))nextTurn();\n  }else if(state==='results'){\n    menuMove(2);if(pressed(A)||pressed(START)){if(selection===0)startGame();else{enter('title');play(SONG.title);}}\n  }else if(state==='pause'){\n    menuMove(3);\n    if(pressed(B)||pressed(START)){resume();fx(SFX.pause);}\n    else if(pressed(A)){if(selection===0)resume();else{confirmAction=selection===1?'restart':'quit';enter('confirm');}}\n  }else if(state==='confirm'){\n    menuMove(2);if(pressed(B)){enter('pause');}\n    else if(pressed(A)){if(selection===0)enter('pause');else if(confirmAction==='restart')startGame();else{enter('title');play(SONG.title);}}\n  }else if(state==='help'){\n    if(pressed(A)||pressed(B)||pressed(START)||pressed(SELECT)){enter(helpFrom);neutral=false;fx(SFX.back);}\n  }\n  if(!['pause','help','confirm'].includes(state)){\n    for(const p of particles){p.life--;p.x+=p.vx;p.y+=p.vy;p.vy+=0.06;}particles=particles.filter(p=>p.life>0);\n  }\n  prevMask=inputMask;\n}\nfunction sprite(name,x,y,opts={}){const s=ART.sprites[name];spr(s.tile,Math.round(x),Math.round(y),{size:s.size,pal:s.pal,prio:3,...opts});}\nfunction text(s,x,y,c=ART.colors.INK){print(s,x,y,c);}\nfunction center(s,y,c=ART.colors.INK){text(s,128-s.length*4,y,c);}\nfunction panel(x,y,w,h){rectfill(x+2,y+3,w,h,ART.colors.SHADOW);rectfill(x,y,w,h,ART.colors.PAPER);rect(x,y,w,h,ART.colors.BORDER);rect(x+2,y+2,w-4,h-4,ART.colors.CREAM);}\nfunction drawMenu(items,x,y){items.forEach((s,i)=>text((i===selection?'> ':'  ')+s,x,y+i*16,i===selection?ART.colors.TEAL:ART.colors.INK));}\nfunction drawKnife(){\n  const pose=((Math.round(knife.angle/TAU*32)%32)+32)%32,k=pose%16,flip=pose>=16;\n  sprite('knife'+k,knife.x-16+(flip?1:0),knife.y-16+(flip?1:0),{pal:active,fx:flip,fy:flip});\n}\nfunction drawPowerHelper(){\n  const held=state==='charge'?charge:0,good=releaseZone(held);\n  rectfill(0,192,256,32,ART.colors.CREAM);line(0,192,255,192,ART.colors.BORDER);\n  text('1 FLIP',8,195,ART.colors.TEAL);text('2 FLIPS',192,195,ART.colors.TEAL);\n  center(good?'RELEASE!':held===TUNE.chargeMax?'TOO MUCH':held?'CHARGING':'HOLD X',195,good?ART.colors.TEAL:ART.colors.INK);\n  rectfill(6,205,244,16,ART.colors.BORDER);rectfill(8,207,240,12,ART.colors.INK);\n  rectfill(8,207,held*4,12,active?ART.colors.ORANGE:ART.colors.TEAL);\n  for(const z of RELEASE_ZONES)rectfill(8+(z.from-1)*4,207,(z.to-z.from+1)*4,12,ART.colors.GREEN);\n  const x=held?8+(held-1)*4+1:8;\n  rectfill(x-1,206,4,14,ART.colors.INK);rectfill(x,206,2,14,ART.colors.CREAM);\n}\nfunction draw(){\n  cls();\n  for(let i=0;i<5;i++){const x=(i*53+Math.floor(clock/(4+i)))%270-8,y=48+((i*37+Math.floor(clock/(14+i)))%88);sprite('leaf',x,y);}\n  if(knife)drawKnife();\n  for(const p of particles)sprite(p.good?'spark':'chip',p.x,p.y);\n  rectfill(0,0,256,32,ART.colors.CREAM);line(0,31,255,31,ART.colors.BORDER);\n  for(let i=0;i<2;i++){const x=i?176:8,p=players[i],c=i===active?ART.colors.TEAL:ART.colors.MUTED;\n    text((i===active?'>':' ')+'P'+(i+1)+' '+String(p.score).padStart(3,'0'),x,5,c);\n    text('STREAK '+p.combo,x,17,c);\n  }\n  center('ROUND',4,ART.colors.MUTED);center(Math.min(10,Math.floor(attemptLog.length/2)+1)+'/10',17);\n  if(state==='aim'||state==='charge')drawPowerHelper();\n  else{rectfill(0,208,256,16,ART.colors.CREAM);line(0,208,255,208,ART.colors.BORDER);text('HOLD X: charge  Z: cancel',8,213,ART.colors.MUTED);}\n  if(state==='title'){\n    panel(24,45,208,94);center('DUEL AT',57,ART.colors.TEAL);center('THE STUMP',73);center('A TWO-PLAYER FLIP DUEL',94,ART.colors.MUTED);drawMenu(['PLAY DUEL','HOW TO PLAY'],56,111);\n    center('SHARE A KEYBOARD OR GAMEPAD',193,ART.colors.CREAM);\n  }else if(state==='ready'){\n    panel(32,62,192,65);center('PLAYER '+(active+1)+' - YOUR TURN',74,active?ART.colors.ORANGE:ART.colors.TEAL);center('X / ENTER: READY',94);center('Then hold X and release.',110,ART.colors.MUTED);\n  }else if(state==='aim'){\n    center('PLAYER '+(active+1)+': HOLD X TO CHARGE',43,ART.colors.CREAM);\n  }else if(state==='feedback'){\n    const label=last.good?(last.flips>1?'DOUBLE FLIP!':last.error<=TUNE.perfect?'PERFECT!':'STUCK!'):'MISS';\n    center(label,56,last.good?ART.colors.CREAM:ART.colors.CREAM);center(last.good?'+10 POINTS':'TRY A DIFFERENT POWER',71,ART.colors.CREAM);\n  }else if(state==='results'){\n    panel(24,52,208,119);const a=players[0].score,b=players[1].score;\n    center(a===b?'DRAW!':'PLAYER '+(a>b?1:2)+' WINS!',65,ART.colors.TEAL);\n    center('P1 '+a+'    P2 '+b,87);center('10 THROWS EACH',103,ART.colors.MUTED);drawMenu(['REMATCH','TITLE'],64,125);\n  }else if(state==='pause'){\n    panel(32,64,192,96);center('PAUSED',76);drawMenu(['RESUME','RESTART DUEL','QUIT TO TITLE'],48,98);\n  }else if(state==='confirm'){\n    panel(16,64,224,92);center(confirmAction==='restart'?'RESTART THE DUEL?':'QUIT THIS DUEL?',76);center('Current points will be lost.',94,ART.colors.MUTED);drawMenu(['KEEP PLAYING','YES'],32,114);\n  }else if(state==='help'){\n    panel(8,36,240,168);center('HOW TO PLAY',47,ART.colors.TEAL);\n    ['X: ready, then release.','Hold X to build power.','Release in the green zones.','Left: 1 flip. Right: 2 flips.','Tip-first landings: 10 pts.','Alternate after every throw.','Each player keeps a streak.','Z cancels before a throw.','Enter pauses. 10 throws each.','No saved records yet.'].forEach((s,i)=>text(s,16,63+i*12));\n    center('X / Z: BACK',190,ART.colors.TEAL);\n  }\n}\nfunction scanline(y){gradientLine(ART.gradients.sky,y);}\n",

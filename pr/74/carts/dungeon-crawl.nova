l.vy = -(4 + 10 * plunge); ball.zone = zoneOf(plunge);\nif (plunge >= ZONE_A[0]) { stats.launch++; emit('launch'); if (!ball.zone) ball.skill = false; }\nplunge = 0; fx(SFX.launch);\n} else if (!waiting) plunge = 0;\nif (!waiting) [0, 1].forEach((h) => { if (held[h] && !heldPrev[h]) fx(SFX.flipUp); else if (!held[h] && heldPrev[h]) fx(SFX.flipDown); });\nheldPrev = waiting ? [false, false] : held;\nstepTable(bs, flips, waiting ? [false, false] : held);\nplaySong();\nif (ball.x > LANE_X && !ball.ride && ball.y >= BALL_HOME.y - 2 && Math.abs(ball.vy) < 4) { ball.y = BALL_HOME.y; ball.vy = 0; }\nprocessEvents();\nif (!waiting) {\nif (spell && --spell.t <= 0) { spell = null; say('SPELL FADES'); }\nif (saveT > 0) saveT--;\n}\nif (msgT > 0) msgT--;\nconst low = bs.reduce((a, b) => (b.y > a.y ? b : a)), lead = clamp((low.ride ? 0 : low.vy) * CAM_LEAD, -70, 70);\nconst want = clamp(low.y - 150 + lead, 0, TABLE_H - VIEW_H);\ncamY += (want - camY) * CAM_EASE;\nif (banner && banner.t > 0) banner.t--;\nfor (const b of bs.slice()) {\nif (!(b.y > DRAIN_Y && b.x < LANE_X)) continue;\nif (bs.length === 1) { drain(); break; }\nif (saveT > 0) { const s = SLOTS[0]; Object.assign(b, { x: s.x, y: s.y, vx: 0, vy: 0, hold: { h: s, t: HOLD * SUB } }); say('BALL SAVED'); continue; }\nbs.splice(bs.indexOf(b), 1); ball = bs[0]; fx(SFX.drain);\nif (bs.length === 1 && boss) failBoss();\n}\n}\nconst levelNo = (q) => q.depth * 10 + q.level;\nfunction gameOver() {\nstate = 'over'; timer = 0; play(-1); fx(SFX.over);\ndset(GAMES_SLOT, dget(GAMES_SLOT) + 1);\nconst deepest = Math.max(...players.map(levelNo));\nnewDeepest = deepest > dget(DEEPEST_SLOT) ? deepest : 0;\nif (newDeepest) dset(DEEPEST_SLOT, newDeepest);\ninitQueue = players.map((q, i) => i).sort((a, b) => players[b].score - players[a].score); firstRank = -1;\n}\nfunction nextInitials() {\nwhile (initQueue.length) {\nconst i = initQueue.shift(), r = insertTop({ score: players[i].score, initials: lastInitials(), lv: levelNo(players[i]) });\n
GOLD : WHITE);\n});\nif (newDeepest) ctxt(`DEEPEST YET: D${Math.floor(newDeepest / 10)} L${newDeepest % 10}`, 84 + players.length * 14, GOLD);\nif (timer > 60 && timer % 60 < 40) ctxt('START: CONTINUE', 84 + players.length * 14 + (newDeepest ? 14 : 0) + 4, DIM);\n}\nfunction drawPlayers() {\npanel(10, 96, 172, 82);\nctab('HOW MANY PLAYERS?', 104, GOLD);\nfor (let i = 1; i <= 4; i++) { const x = 30 + (i - 1) * 36, on = i === nPlayers; if (on) rect(x - 4, 120, 24, 22, GOLD); txt(String(i), x + 4, 127, on ? WHITE : DIM); }\nctab('LEFT / RIGHT', 150, DIM); ctab('A: START  B: BACK', 162, DIM);\n}\nconst ctab = (s, y, c) => txt(s, 96 - s.length * 4, y, c);\nfunction drawTitle() {\n[['logo_dungeon', 22], ['logo_crawl', 44], ['logo_pinball', 66]].forEach(([n, y]) => bigSprite(ART.big[n], 96 - ART.big[n].w / 2, y, { prio: 3 }));\npanel(40, 110, 112, 42);\n['PLAY', 'RECORDS'].forEach((t, i) => ctab(`${i === titleSel ? '> ' : '  '}${t}`, 118 + i * 16, i === titleSel ? WHITE : DIM));\nif (timer % 80 < 56) ctab('1 TO 4 PLAYERS', 176, DIM);\n}\nfunction drawRecords() {\npanel(24, 16, 208, 192);\nctxt('TOP 10', 24, GOLD);\ntopTen().forEach((e, i) => {\nconst y = 48 + i * 14, on = i === hl;\nif (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\ntxt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\ntxt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\ntxt(e.score ? String(e.score).padStart(8) : '', 112, y, i === 0 ? GOLD : WHITE);\nif (e.score && e.lv) txt(`D${Math.floor(e.lv / 10)}L${e.lv % 10}`, 184, y, RED);\n});\nconst d = dget(DEEPEST_SLOT);\nif (d) ctxt(`DEEPEST D${Math.floor(d / 10)} L${d % 10}   GAMES ${dget(GAMES_SLOT)}`, 180, DIM);\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawInitials() {\nconst ini = initials;\npanel(24, 40, 208, 144);\nctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\nctxt((nPlayers > 1 ? `PLAYER ${ini.who + 1}: ` : '') + String(players[ini.who].score), 68, WHITE);\nctxt('ENTER YOUR INITIALS', 90, DIM);\nfor (let i = 0; i < 3; i++) {\nconst on = i === ini.pos, x = 84 + i * 32;\nrect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\ntxt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n}\nif (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\nfunction drawPause() {\npanel(64, 80, 128, 64);\nctxt('PAUSED', 88, GOLD);\n['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 76, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, ART.colors.SLAB); rect(x, y, w, h, ART.colors.RIM); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nfunction scanline(y) { gradientLine(ART.gradients.glow, y); }\n",

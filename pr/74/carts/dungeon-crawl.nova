  "label": "",
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {},\nsprites: {\"ball\": {\"pal\": 0, \"size\": 16, \"tile\": 640}, \"bump\": {\"pal\": 1, \"size\": 32, \"tile\": 644}, \"bump_hit\": {\"pal\": 1, \"size\": 32, \"tile\": 648}, \"chest\": {\"pal\": 2, \"size\": 16, \"tile\": 808}, \"chest_open\": {\"pal\": 2, \"size\": 16, \"tile\": 810}, \"ember\": {\"pal\": 4, \"size\": 8, \"tile\": 784}, \"flame0\": {\"pal\": 4, \"size\": 16, \"tile\": 878}, \"flame1\": {\"pal\": 4, \"size\": 16, \"tile\": 896}, \"flame2\": {\"pal\": 4, \"size\": 16, \"tile\": 898}, \"glow\": {\"pal\": 4, \"size\": 16, \"tile\": 900}, \"gong\": {\"pal\": 1, \"size\": 16, \"tile\": 652}, \"gong_hit\": {\"pal\": 1, \"size\": 16, \"tile\": 654}, \"halo\": {\"pal\": 5, \"size\": 16, \"tile\": 642}, \"key\": {\"pal\": 3, \"size\": 16, \"tile\": 836}, \"plaque1\": {\"pal\": 3, \"size\": 16, \"tile\": 838}, \"plaque1_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 840}, \"plaque2\": {\"pal\": 3, \"size\": 16, \"tile\": 842}, \"plaque2_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 844}, \"plaque3\": {\"pal\": 3, \"size\": 16, \"tile\": 846}, \"plaque3_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 868}, \"plaque4\": {\"pal\": 3, \"size\": 16, \"tile\": 870}, \"plaque4_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 872}, \"plaque5\": {\"pal\": 3, \"size\": 16, \"tile\": 874}, \"plaque5_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 876}, \"plunger\": {\"pal\": 0, \"size\": 16, \"tile\": 902}, \"spring\": {\"pal\": 0, \"size\": 8, \"tile\": 785}, \"target\": {\"pal\": 3, \"size\": 16, \"tile\": 800}, \"target_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 802}},\nscenes: {\"decor\": {\"h\": 80, \"mx\": 24, \"my\": 0, \"pal\": 2, \"w\": 24}, \"decor_hi\": {\"h\": 80, \"mx\": 24, \"my\": 0, \"pal\": 2, \"w\": 24}, \"floor\": {\"h\": 80, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 24}, \"lava\": {\"h\": 4, \"mx\": 48, \"my\": 0, \"pal\": 3, \"w\": 4}},\
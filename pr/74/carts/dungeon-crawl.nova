2], [4, 1, 2, 4], [4, 6, 2, 4], [1, 9, 4, 2], [0, 6, 2, 4], [0, 1, 2, 4], [1, 5, 4, 1]];\nfunction led(v, x, y, n) {\nconst C = ART.colors, s = String(v);\nif (s.length > n) { x -= (s.length - n) * 7; n = s.length; }\nrectfill(x - 2, y - 2, n * 7 + 3, 15, C.LED_BG);\nfor (let i = 0; i < n; i++) {\nconst ch = s[s.length - n + i], on = ch === undefined ? 0 : SEGS[+ch], dx = x + i * 7;\nSEG_R.forEach(([sx, sy_, w, h], k) => rectfill(dx + sx, y + sy_, w, h, on >> k & 1 ? C.LED_ON : C.LED_OFF));\nif (on & 1) rectfill(dx + 1, y, 4, 1, C.LED_HI);\n}\n}\nfunction drawMenuPanel() {\nrectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS); line(TABLE_W, 0, TABLE_W, 223, PANEL);\nconst top = readEntry(0), d = dget(DEEPEST_SLOT);\ntxt('HIGH', 196, 3, GOLD); led(top.score, 197, 13, 8);\ntxt('DEEPEST', 196, 40, GOLD); txt(d ? `D${Math.floor(d / 10)} L${d % 10}` : '-', 196, 52, RED);\ntxt('GAMES', 196, 74, GOLD); txt(String(dget(GAMES_SLOT)), 196, 86, WHITE);\n}\nfunction drawBanner() {\nrectfill(0, 0, TABLE_W, 12, ART.colors.SLAB); line(0, 12, TABLE_W - 1, 12, ART.colors.RIM);\nif (banner && banner.t > 0) { rectfill(0, 12, TABLE_W, 12, ART.colors.SLAB); line(0, 24, TABLE_W - 1, 24, ART.colors.RIM); ctab(banner.a, 2, GOLD); ctab(banner.b, 13, WHITE); return; }\nif (boss) { ctab(`PIT LORD ${'*'.repeat(boss.hp)}`, 2, clock % 20 < 14 ? RED : GOLD); return; }\nif (level === 5) { ctab('BOSS LIT: SHOOT A RAMP', 2, clock % 40 < 28 ? RED : GOLD); return; }\nconst L = LEVELS[level - 1];\nctab(`${L.what} ${goalN}/${goalOf(level)}`, 2, WHITE);\n}\nconst short = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e5 ? Math.floor(n / 1000) + 'K' : String(n));\nfunction drawPanel() {\nrectfill(TABLE_W, 0, 256 - TABLE_W, 224, ART.colors.GLASS); line(TABLE_W, 0, TABLE_W, 223, PANEL);\ntxt(nPlayers > 1 ? `PLAYER ${cur + 1}` : 'SCORE', 196, 3, GOLD); led(score, 197, 13, 8);\ntxt(`BALL ${Math.min(BALLS, BALLS + 1 - balls)}`, 196, 26, balls > 1 ? DIM : RED);\ntxt(`D${depth} L${level}`, 196, 36, 
  "label": null,
  "code": "const SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\nconst ART = {\ntiles: {},\nsprites: {\"ball\": {\"pal\": 0, \"size\": 16, \"tile\": 608}, \"bump\": {\"pal\": 1, \"size\": 32, \"tile\": 640}, \"bump_hit\": {\"pal\": 1, \"size\": 32, \"tile\": 644}, \"chest\": {\"pal\": 2, \"size\": 16, \"tile\": 740}, \"chest_open\": {\"pal\": 2, \"size\": 16, \"tile\": 742}, \"ember\": {\"pal\": 4, \"size\": 8, \"tile\": 728}, \"flame0\": {\"pal\": 4, \"size\": 16, \"tile\": 834}, \"flame1\": {\"pal\": 4, \"size\": 16, \"tile\": 836}, \"flame2\": {\"pal\": 4, \"size\": 16, \"tile\": 838}, \"glow\": {\"pal\": 4, \"size\": 16, \"tile\": 840}, \"key\": {\"pal\": 3, \"size\": 16, \"tile\": 748}, \"plaque1\": {\"pal\": 3, \"size\": 16, \"tile\": 750}, \"plaque1_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 776}, \"plaque2\": {\"pal\": 3, \"size\": 16, \"tile\": 778}, \"plaque2_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 780}, \"plaque3\": {\"pal\": 3, \"size\": 16, \"tile\": 782}, \"plaque3_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 808}, \"plaque4\": {\"pal\": 3, \"size\": 16, \"tile\": 810}, \"plaque4_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 812}, \"plaque5\": {\"pal\": 3, \"size\": 16, \"tile\": 814}, \"plaque5_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 832}, \"plunger\": {\"pal\": 0, \"size\": 16, \"tile\": 842}, \"spring\": {\"pal\": 0, \"size\": 8, \"tile\": 729}, \"target\": {\"pal\": 3, \"size\": 16, \"tile\": 736}, \"target_lit\": {\"pal\": 3, \"size\": 16, \"tile\": 738}},\nscenes: {\"decor\": {\"h\": 80, \"mx\": 24, \"my\": 0, \"pal\": 2, \"w\": 24}, \"decor_hi\": {\"h\": 80, \"mx\": 24, \"my\": 0, \"pal\": 2, \"w\": 24}, \"floor\": {\"h\": 80, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 24}, \"lava\": {\"h\": 4, \"mx\": 48, \"my\": 0, \"pal\": 3, \"w\": 4}},\ncolors: {\"ARROW0\": 28, \"ARROW1\": 29, \"GLASS\": 200, \"LAVA0\": 49, \"LAVA1\": 50, \"LAVA2\": 51, \"LAVA3\": 52, \"LAVA4\": 53, \"LAVA5\": 54, \"LED_BG\": 116
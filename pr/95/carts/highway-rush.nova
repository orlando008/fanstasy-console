2,9823,9855,9855,10911,10911,10911,11967,11967,13023,13023,13055,14079,14111,14111,15167,15167,16223,16223,16223,17247,17247,17279,17279,18303,18303,18303,19327,19359,19359,20383,20383,20383,21439],\"y0\":0}},\n};\nfunction bigSprite(b, x, y, opts = {}) {\nconst fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\nfor (const [dx, dy, t, size, pal, f] of b.parts) {\nspr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n{ size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n}\n}\nfunction gradientLine(g, y) {\nconst v = g.lines[y - g.y0];\nif (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\nfunction sprite(s, x, y, opts = {}) { spr(s.tile, x, y, { size: s.size, pal: s.pal, prio: 3, ...opts }); }\nconst TUNE = {\ncruise: 5.2,\naccel: 0.05,\ndrag: 0.03,\nbrake: 0.17,\nsteer: 1.9,\nsteerLerp: 0.2,\nraceLen: 37000,\nconeSlow: 40, coneKeep: 0.72, coneMul: 0.66,\noilSpin: 70, oilMul: 0.88, oilGrip: 0.3,\nredSlow: 60, redMul: 0.68,\ngreenBoost: 70, greenAdd: 1.5,\nturboFrames: 100, turboAdd: 2.3,\nprotect: 45,\ncarKeep: 0.94, carSlow: 10, carProtect: 30,\ncubeBack: 60,\noilLife: 900,\nrubber: 0.14,\nspawnFirst: 1300, hazardGap: 190,\nrowGap: [190, 380],\nmix: [0.19, 0.33, 0.5, 0.63, 0.75],\n};\nconst HORIZON = 96, FOCAL = 128, HEIGHT = 46, CAMD = 55;\nconst CX = 512;\nconst LANES = [-32, 0, 32], LANE_W = 32, ROAD_HALF = 48, RAIL_X = 68;\nconst START_D = 100, LOOK = 900, FLOOR_TOP = HORIZON + 6, FOG_END = HORIZON + 30;\nconst FINISH_D = START_D + TUNE.raceLen;\nconst HAZE = [29, 25, 15];\nconst SFX = { move: 0, select: 1, pause: 2, beep: 3, go: 4, boost: 5, pad: 6, slow: 7, cone: 8, oil: 9, cube: 10, shield: 11, pop: 12, drop: 13,\ncrash: 14, scrape: 15, pass: 16, finish: 17, record: 18, engine: 19 };\nconst SONG = { title: 0, results: 1, race: 2 };\nconst SFX_CH = 7, ENGINE_CH = 6;\nfunction fx(n) { sfx(n, SFX_CH); }\nlet playing = -1;\nfunction play(song) { if (song === playing) return; playing = song; music(song); }\nconst ENGINE_FRAMES = 28, ENGINE_HOLD = 4;\nlet engineBucket = -1, engineT = 0, engineWant = -1, engineWantT = 0;\nfunction engineFor(r) { return r.v < 0.3 ? 0 : r.v < 2.5 ? 1 : r.v < 4.2 ? 2 : r.v < 5.4 ? 3 : r.boost > 0 ? 5 : 4; }\nfunction engineSound() {\nconst want = !paused && (state === 'grid' || state === 'race' || state === 'finish') ? engineFor(P) : -1;\nif (want !== engineWant) { engineWant = want; engineWantT = 0; } else engineWantT++;\nif (want < 0) { if (engineBucket >= 0) { sfx(-1, ENGINE_CH); engineBucket = -1; } return; }\nif (engineBucket < 0 || ++engineT >= ENGINE_FRAMES || want !== engineBucket && engineWantT >= ENGINE_HOLD) { engineBucket = want; engineT = 0; sfx(SFX.engine + want, ENGINE_CH); }\n}\nconst VERSION_SLOT = 0, SAVE_VERSION = 1, INITIALS_SLOT = 1, BEST_SLOT = 2, RACES_SLOT = 3;\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3;\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY; return { score: dget(s), initials: unpackInitials(dget(s + 1)) }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\nfunction insertTop(e) {\nif (!e.score) return -1;\nconst list = topTen(), at = list.findIndex((x) => e.score > x.score);\nif (at < 0) return -1;\nlist.splice(at, 0, e);\nfor (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\nreturn at;\n}\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\nconst held = (b) => (inputMask & (1 << b)) !== 0;\nlet skipTitle = false;\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet seedNo = 1, raceNo = 0, demo = false;\nlet cubeQ = [], racers = [], P = null, objs = [], decals = new Map(), oils = [], parts = [], finishOrder = [];\nlet rt = 0, camD = 0, camX = 0, nextRow = 0, objLow = 0, finishAt = -1;\nlet result = null, msg = '', msgT = 0, lastRank = 8, cubes = 0, passes = 0, shake = 0;\nconst RIVALS = [['RAZE', 1, 1.05, 0.9], ['VOLT', 2, 1.03, 0.8], ['NOVA', 3, 1.02, 0.85], ['ACE', 7, 1.06, 0.95], ['DRIFT', 1, 0.99, 0.6], ['COBRA', 2, 1.04, 0.7], ['JET', 3, 0.98, 0.5]];\nconst GRID = [[36, 0], [36, 2], [72, 1], [108, 0], [108, 2], [144, 1], [180, 0]];\nconst PAL_COLOR = [RED, 8, GOLD, GREEN, 0, 0, 0, WHITE];\nfunction lcg(seed) { let s = (Math.imul(seed, 2654435761) + 12345) >>> 0; return () => { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296; }; }\nconst KINDS = { c: { hw: 17, hl: 10 }, k: { hw: 13, hl: 6 }, o: { hw: 18, hl: 14 }, g: { hw: 18, hl: 24 }, r: { hw: 18, hl: 24 } };\nfunction makeTrack(seed) {\nconst rn = lcg(seed), list = [], dec = new Map(), mix = TUNE.mix;\nconst pick = (n) => Math.floor(rn() * n);\nconst add = (k, lane, d, dx = 0) => list.push({ k, x: LANES[lane] + dx, d, on: true, lane });\nconst decal = (k, lane, d, rows) => { const r0 = Math.floor(d / 8) - (rows >> 1); for (let j = 0; j < rows; j++) { const r = r0 + rows - 1 - j; if (!dec.has(r)) dec.set(r, []); dec.get(r).push([k, lane, j]); } };\nlet d = TUNE.spawnFirst, lastHaz = -1e9, n = 0;\nwhile (d < FINISH_D - 960) {\nconst roll = rn(), hazOk = d - lastHaz >= TUNE.hazardGap, free = pick(3);\nif (roll < mix[0] || !hazOk && roll < 0.6) {\nconst m = 1 + pick(3), start = pick(3);\nfor (let i = 0; i < m; i++) add('c', (start + i) % 3, d);\n} else if (roll < mix[1]) { const l = pick(3); add('g', l, d); decal('g', l, d, 6); if (rn() < 0.5) add('c', (l + 1 + pick(2)) % 3, d + 130); }\nelse if (roll < mix[2]) {\nfor (let l = 0; l < 3; l++) if (l !== free && (l === (free + 1) % 3 || rn() < 0.35)) { add('k', l, d, -9); add('k', l, d + 10, 9); }\nlastHaz = d;\n} else if (roll < mix[3]) { const l = pick(3); add('r', l, d); decal('r', l, d, 6); lastHaz = d; if (rn() < 0.5) add('c', (l + 1 + pick(2)) % 3, d + 20); }\nelse if (roll < mix[4]) { const l = pick(3); add('o', l, d); decal('o', l, d, 4); lastHaz = d; if (rn() < 0.3) { const l2 = (l + 1 + pick(2)) % 3; if (l2 !== free) { add('o', l2, d + 30); decal('o', l2, d + 30, 4); } } }\nn++;\nd += TUNE.rowGap[0] + rn() * (TUNE.rowGap[1] - TUNE.rowGap[0]);\n}\nlist.sort((a, b) => a.d - b.d);\nlist.forEach((o, i) => { o.i = i; o.hw = KINDS[o.k].hw; o.hl = KINDS[o.k].hl; });\nreturn { list, dec };\n}\nfunction lowerBound(d) { let lo = 0, hi = objs.length; while (lo < hi) { const m = (lo + hi) >> 1; if (objs[m].d < d) lo = m + 1; else hi = m; } return lo; }\nconst laneOf = (x) => (x < -16 ? 0 : x > 16 ? 2 : 1);\nconst TL = ART.tiles;\nconst hash2 = (a, b) => { let h = Math.imul(a * 73856093 ^ b * 19349663, 2246822519); h ^= h >>> 15; return h >>> 0; };\nconst T1 = (n, fxl = false) => tile(n, 1, fxl), T2 = (n) => tile(n, 2);\nfunction floorRow(r) {\nconst ty = (-r - 1) & 127, band = (r >> 2) & 1, B = band ? 'B' : 'A', dash = r % 6 < 3, finish = r === Math.floor(FINISH_D / 8) || r === Math.floor(FINISH_D / 8) + 1;\nfor (let tx = 0; tx < 128; tx++) {\nconst u = tx - 64;\nlet e;\nif (u >= -6 && u <= 5) {\nif (finish) e = T1(TL[((tx + r) & 1) ? 'chkA' : 'chkB']);\nelse if (u === -6) e = T1(TL['edgeL' + B]);\nelse if (u === 5) e = T1(TL['edgeR' + B]);\nelse if (dash && (u === -3 || u === 1)) e = T1(TL['dashR' + B]);\nelse if (dash && (u === -2 || u === 2)) e = T1(TL['dashL' + B]);\nelse e = T1(TL['asph' + B + hash2(tx, r) % 3]);\n} else if (u === -7 || u === 6) e = T1(TL[(r & 1) ? 'kerbR' : 'kerbW']);\nelse if (u === -8 || u === 7) e = T1(TL['sh' + B + (hash2(tx, r) & 1)]);\nelse if (u === -9 || u === 8) e = T1(TL[(r % 6 === 0 ? 'post' : 'rail') + B], u > 0);\nelse e = T1(TL['gr' + B + hash2(tx, r) % 4]);\nmset(tx, ty, e);\n}\nconst ds = decals.get(r);\nif (ds) for (const [k, lane, j] of ds) stamp(k, lane, ty, j);\nfor (const o of oils) if (o.rows && o.rows.has(r)) stamp('o', o.lane, ty, o.rows.get(r));\n}\nfunction stamp(k, lane, ty, j) {\nconst sc = ART.scenes[k === 'g' ? 'padG' : k === 'r' ? 'padR' : 'oil'];\nfor (let i = 0; i < 4; i++) mset(58 + lane * 4 + i, ty, mget(sc.mx + i, sc.my + j));\n}\nfunction ensureRows() {\nconst target = Math.floor((camD + 1000) / 8);\nwhile (nextRow <= target) floorRow(nextRow++);\n}\nconst FOG = {}, FOG_ENTRIES = [];\nfor (let i = 17; i < 32; i++) FOG_ENTRIES.push(i);\nfor (let i = 33; i < 48; i++) FOG_ENTRIES.push(i);\nfunction newRacer(id, x, d, pal, name, rv, skill) {\nreturn { id, x, d, v: 0, tx: x, pal, name, rv, skill, sv: 0, boost: 0, boostAdd: 0, slow: 0, spin: 0, inv: 0, shield: false, item: 0, itemT: 0, fin: -1, last: [], cool: 0, prev: d, turbo: false, brake: false, auto: false };\n}\nfunction startRace(seed) {\nseedNo = seed; srand(seed); raceNo++;\nconst tr = makeTrack(seed);\nobjs = tr.list; decals = tr.dec; oils = []; cubeQ = []; parts = []; finishOrder = [];\nracers = [newRacer(0, 0, START_D, 0, 'YOU', 1, 1)];\nRIVALS.forEach(([name, pal, rv, skill], i) => racers.push(newRacer(i + 1, LANES[GRID[i][1]], START_D + GRID[i][0], pal, name, rv, skill)));\nP = racers[0]; P.auto = false;\nrt = 0; finishAt = -1; result = null; msg = ''; msgT = 0; lastRank = 8; cubes = 0; passes = 0; objLow = 0; shake = 0;\ncamD = P.d - CAMD; camX = 0; nextRow = Math.floor(camD / 8) - 2;\nensureRows();\npaused = false; timer = 0;\n}\nfunction init() {\nif (dget(VERSION_SLOT) !== SAVE_VERSION) {\nfor (let i = 0; i < 256; i++) dset(i, 0);\ndset(VERSION_SLOT, SAVE_VERSION);\n}\nconst f = ART.scenes.far, n = ART.scenes.near, h = ART.scenes.hud;\nbg(0, { mx: h.mx, my: h.my, mw: h.w, mh: h.h, x: 0, y: 0, wrap: false, show: true });\nbg(1, { mx: n.mx, my: n.my, mw: n.w, mh: n.h, x: 0, y: 0, wrap: true, show: true });\nbg(2, { mx: f.mx, my: f.my, mw: f.w, mh: f.h, x: 0, y: 0, wrap: true, show: true });\nfor (const i of FOG_ENTRIES) FOG[i] = color(i);\nblend({ layers: ['overlay'], half: true });\nif (skipTitle) { startRace(1 + rndi(0, 99999)); toGrid(); } else toTitle();\n}\nfunction toTitle() { state = 'title'; timer = 0; titleSel = 0; paused = false; demo = true; startRace(7 + raceNo * 3); P.auto = true; play(SONG.title); }\nfunction toGrid() { state = 'grid'; timer = 0; demo = false; msg = ''; play(SONG.race); }\nfunction update() {\ninputMask = readPad(); clock++;\nif (!paused) timer++;\nif (paused) updatePause();\nelse if (state === 'title') updateTitle();\nelse if (state === 'grid') updateGrid();\nelse if (state === 'race' || state === 'finish') updateRace();\nelse if (state === 'results') updateResults();\nelse if (state === 'initials') updateInitials();\nelse if (state === 'records') updateRecords();\nengineSound();\nprevMask = inputMask;\n}\nfunction updateTitle() {\nstepWorld(); if (P.d > FINISH_D - 1500) toTitleAgain();\nif (pressed(UP) || pressed(DOWN)) { titleSel ^= 1; fx(SFX.move); }\nif (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (titleSel === 0) { startRace(newSeed()); toGrid(); } else { state = 'records'; hl = -1; timer = 0; }\n}\n}\nfunction newSeed() { return 1 + ((clock * 2654435761 + seedNo * 40503) >>> 8) % 99991; }\nfunction toTitleAgain() { const keep = titleSel; startRace(7 + raceNo * 3); P.auto = true; timer = 0; titleSel = keep; }\nfunction updateGrid() {\nstepWorld(true);\nconst c = timer;\nif (c === 60 || c === 120 || c === 180) fx(SFX.beep);\nif (c === 240) { fx(SFX.go); state = 'race'; timer = 0; msg = 'GO!'; msgT = 50; }\nif (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); }\n}\nfunction updateRace() {\nif (pressed(START) && state === 'race') { paused = true; pauseSel = 0; fx(SFX.pause); return; }\nrt++;\nstepWorld();\nif (P.fin >= 0 && state === 'race') { state = 'finish'; timer = 0; P.auto = true; fx(SFX.finish); msg = 'FINISH!'; msgT = 200; }\nif (state === 'finish' && timer > 210) toResults();\n}\nfunction stepWorld(still) {\nfor (const r of racers) {\nr.prev = r.d;\nif (r === P && !P.auto && !still) playerDrive(P); else if (still) { r.sv = 0; r.brake = true; } else aiDrive(r);\nif (!still) moveRacer(r);\n}\nif (!still) {\nfor (const r of racers) touchObjects(r);\ncarHits();\nfor (const o of oils) o.ttl--;\nconst gone = oils.filter((o) => o.ttl <= 0);\nif (gone.length) { oils = oils.filter((o) => o.ttl > 0); for (const o of gone) wipeOil(o); }\nfollowRank();\nwhile (cubeQ.length && cubeQ[0].back <= clock) cubeQ.shift().on = true;\n}\nfor (const r of racers) {\nif (r.fin < 0 && r.d >= FINISH_D && !still) { r.fin = rt; finishOrder.push(r); }\nif (r.inv > 0) r.inv--; if (r.slow > 0) r.slow--; if (r.spin > 0) r.spin--; if (r.boost > 0) r.boost--; if (r.cool > 0) r.cool--;\nif (r.boost <= 0) { r.boostAdd = 0; r.turbo = false; }\n}\nupdateParts();\nif (msgT > 0) msgT--;\nif (shake > 0) shake--;\nconst want = P.x * 0.62; camX += (want - camX) * 0.25;\ncamD = P.d - CAMD;\nensureRows();\n}\nfunction targetSpeed(r) {\nlet s = TUNE.cruise * r.rv;\nif (r.id && r.d < P.d - 700) s *= 1 + TUNE.rubber * Math.min(1, (P.d - r.d - 700) / 2500);\nelse if (r.id && r.d > P.d + 900) s *= 1 - TUNE.rubber * 0.6 * Math.min(1, (r.d - P.d - 900) / 2500);\nif (r.boost > 0) s += r.boostAdd;\nif (r.slow > 0) s *= TUNE.coneMul;\nif (r.spin > 0) s *= TUNE.oilMul;\nreturn s;\n}\nfunction moveRacer(r) {\nconst tgt = targetSpeed(r);\nif (r.brake) r.v = Math.max(0, r.v - TUNE.brake);\nelse if (r.v < tgt) r.v = Math.min(tgt, r.v + TUNE.accel * (r.boost > 0 ? 2.2 : 1));\nelse r.v = Math.max(tgt, r.v - TUNE.drag);\nr.d += r.v;\nr.x += r.sv;\nif (r.spin > 0) r.x += Math.sin((rt + r.id * 7) * 0.45) * 0.9 * Math.min(1, r.spin / 20);\nif (r.x > 40) { r.x = 40; scrape(r); } else if (r.x < -40) { r.x = -40; scrape(r); }\n}\nfunction scrape(r) {\nr.v *= 0.985;\nif (r === P && rt % 14 === 0) { fx(SFX.scrape); emit('spark', P.x + (P.x > 0 ? 12 : -12), P.d, 4, 0.3, 0.2, 10); }\n}\nfunction playerDrive(r) {\nconst dir = (held(RIGHT) ? 1 : 0) - (held(LEFT) ? 1 : 0), grip = r.spin > 0 ? TUNE.oilGrip : 1;\nr.sv += (dir * TUNE.steer - r.sv) * TUNE.steerLerp * grip;\nr.brake = held(B);\nif (pressed(A)) useItem(r);\nif (r.brake && r.v > 2) skid(r, 3);\nif (r.spin > 0 && rt % 4 === 0) skid(r, 1);\n}\nfunction skid(r, every) { if (rt % every === 0) { emit('smoke', r.x - 10, r.d - 6, 1, -0.2, 0.15, 22); emit('smoke', r.x + 10, r.d - 6, 1, 0.2, 0.15, 22); } }\nfunction aiDrive(r) {\nr.brake = false;\nif (r.fin >= 0) { if (r.id === 0) r.tx = 0; r.sv = clamp((r.tx - r.x) * 0.1, -1, 1); if (r.d > FINISH_D + 400 + r.id * 40) r.brake = true; return; }\nif (r.cool <= 0 || r.spin > 0) {\nconst ahead = lookAhead(r);\nif (ahead.block) {\nconst lane = bestLane(r);\nif (lane !== laneOf(r.tx) && r.spin <= 0) { r.tx = LANES[lane] + rndi(-5, 5); r.cool = 28; }\nelse if (ahead.slow !== null && ahead.dist < 40) { r.brake = ahead.dist < 22 && r.v > ahead.slow; }\n}\n}\nconst dx = r.tx - r.x;\nr.sv = clamp(dx * 0.12, -0.9, 0.9) * (r.spin > 0 ? TUNE.oilGrip : 1);\nconst f = nearestAhead(r, 30, 20);\nif (f && r.v > f.v) { r.v = Math.max(f.v * 0.97, r.v - 0.12); }\nif (r.item && r.itemT-- <= 0) useItem(r);\n}\nfunction lookAhead(r) {\nconst reach = 150 + r.v * 6;\nfor (let i = lowerBound(r.d + 4); i < objs.length && objs[i].d < r.d + reach; i++) {\nconst o = objs[i];\nif (!o.on || o.k === 'c' || o.k === 'g') continue;\nif (Math.abs(o.x - r.tx) < o.hw + 8 && (r.skill >= 1 || hash2(o.i, r.id) % 100 < r.skill * 100)) return { block: true, dist: o.d - r.d, slow: null };\n}\nfor (const o of oils) if (o.d > r.d + 4 && o.d < r.d + reach && Math.abs(o.x - r.tx) < 26 && o.owner !== r.id) return { block: true, dist: o.d - r.d, slow: null };\nconst f = nearestAhead(r, reach * 0.6, 22);\nif (f && f.v < r.v + 0.2) return { block: true, dist: f.d - r.d, slow: f.v };\nreturn { block: false };\n}\nfunction nearestAhead(r, reach, width) {\nlet best = null;\nfor (const o of racers) if (o !== r && o.d > r.d && o.d - r.d < reach && Math.abs(o.x - r.x) < width && (!best || o.d < best.d)) best = o;\nreturn best;\n}\nfunction bestLane(r) {\nlet best = laneOf(r.tx), bestScore = -1e9;\nfor (let l = 0; l < 3; l++) {\nlet s = -Math.abs(LANES[l] - r.x) * 0.5, clear = 0;\nfor (let i = lowerBound(r.d + 4); i < objs.length && objs[i].d < r.d + 190; i++) {\nconst o = objs[i];\nif (!o.on || Math.abs(o.x - LANES[l]) > o.hw + 12) continue;\nif (o.k === 'k' || o.k === 'o' || o.k === 'r') s -= 400; else if (o.k === 'c') s += 30; else s += 40;\n}\nfor (const o of oils) if (o.d > r.d && o.d < r.d + 190 && o.lane === l) s -= 400;\nfor (const o of racers) if (o !== r && o.d > r.d - 26 && o.d < r.d + 120 && Math.abs(o.x - LANES[l]) < 24) s -= 220 - (o.d - r.d) * 0.5;\nif (s > bestScore) { bestScore = s; best = l; }\n}\nreturn best;\n}\nfunction pickItem(r) {\nconst p = place(r), roll = rndi(0, 99);\nconst turbo = 38 + p * 3, shield = 30;\nreturn roll < turbo ? 1 : roll < turbo + shield ? 2 : 3;\n}\nfunction useItem(r) {\nconst it = r.item; if (!it) return;\nr.item = 0;\nif (it === 1) { r.boost = TUNE.turboFrames; r.boostAdd = TUNE.turboAdd; r.turbo = true; if (r === P) { fx(SFX.boost); shake = 12; } }\nelse if (it === 2) { r.shield = true; if (r === P) fx(SFX.shield); }\nelse dropOil(r);\n}\nfunction dropOil(r) {\nconst lane = laneOf(r.x), d = r.d - 36, o = { x: LANES[lane], d, lane, ttl: TUNE.oilLife, owner: r.id, on: true, hw: 18, hl: 14, k: 'o', rows: new Map() };\nconst r0 = Math.floor(d / 8) - 2;\nfor (let j = 0; j < 4; j++) o.rows.set(r0 + 3 - j, j);\noils.push(o);\nfor (const [row, j] of o.rows) if (row > camD / 8 && row < nextRow) stamp('o', lane, (-row - 1) & 127, j);\nif (r === P) { fx(SFX.drop); msg = 'OIL DROPPED'; msgT = 40; }\n}\nfunction wipeOil(o) { for (const row of o.rows.keys()) if (row > camD / 8 && row < nextRow) floorRow(row); }\nfunction hit(r, kind, o) {\nif (r.inv > 0) return false;\nif (r.shield) { r.shield = false; r.inv = TUNE.protect; if (r === P) { fx(SFX.pop); msg = 'SHIELD!'; msgT = 40; } emit('spark', r.x, r.d, 8, 0, 0.3, 14); return false; }\nr.inv = kind === 'car' ? TUNE.protect : 30;\nreturn true;\n}\nfunction touchObjects(r) {\nfor (let i = lowerBound(r.prev - 30); i < objs.length && objs[i].d < r.d + 30; i++) {\nconst o = objs[i];\nif (!o.on || r.last.includes(o) || Math.abs(o.x - r.x) >= o.hw || r.d < o.d - o.hl || r.prev > o.d + o.hl) continue;\nremember(r, o);\nif (o.k === 'c') { o.on = false; o.back = clock + TUNE.cubeBack; cubeQ.push(o); collect(r, o); }\nelse if (o.k === 'g') { r.boost = Math.max(r.boost, TUNE.greenBoost); r.boostAdd = Math.max(r.boostAdd, TUNE.greenAdd); if (r === P) { fx(SFX.pad); shake = 6; } }\nelse if (o.k === 'r') { if (hit(r, 'red', o)) { r.slow = TUNE.redSlow; r.v *= 0.85; if (r === P) fx(SFX.slow); } }\nelse if (o.k === 'k') { if (hit(r, 'cone', o)) { r.slow = TUNE.coneSlow; r.v *= TUNE.coneKeep; if (r === P) { fx(SFX.cone); shake = 10; } } o.on = false; emit('spark', o.x, o.d, 6, 0, 0.4, 16); }\nelse if (o.k === 'o') { if (hit(r, 'oil', o)) { r.spin = TUNE.oilSpin; r.slow = 20; if (r === P) { fx(SFX.oil); msg = 'OIL!'; msgT = 40; } } }\n}\nfor (const o of oils) {\nif (r.last.includes(o) || o.owner === r.id && r.id === P.id || Math.abs(o.x - r.x) >= o.hw || r.d < o.d - o.hl || r.prev > o.d + o.hl) continue;\nremember(r, o);\nif (hit(r, 'oil', o)) { r.spin = TUNE.oilSpin; r.slow = 20; if (r === P) { fx(SFX.oil); msg = 'OIL!'; msgT = 40; } else if (o.owner === P.id) { msg = r.name + ' SPUN OUT!'; msgT = 60; fx(SFX.pass); } }\n}\n}\nfunction remember(r, o) { r.last.push(o); if (r.last.length > 4) r.last.shift(); }\nfunction collect(r, o) {\nif (r === P) { cubes++; fx(SFX.cube); emit('sparkle', o.x, o.d, 6, 0, 0.1, 24); if (!P.item) { P.item = pickItem(P); P.itemT = rndi(60, 200); } else { msg = 'ITEM FULL'; msgT = 30; } }\nelse if (!r.item && r.id) { r.item = rndi(0, 1) ? 1 : 3; r.itemT = rndi(90, 300); }\n}\nfunction carHits() {\nfor (let i = 0; i < racers.length; i++) for (let j = i + 1; j < racers.length; j++) {\nconst a = racers[i], b = racers[j];\nif (Math.abs(a.d - b.d) > 18 || Math.abs(a.x - b.x) > 20) continue;\nconst back = a.d < b.d ? a : b, front = back === a ? b : a;\nif (back.inv > 0 || front.inv > 0) continue;\nconst protectedBack = back.shield, protectedFront = front.shield;\nif (protectedBack) { hit(back, 'car'); front.inv = 20; }\nelse if (protectedFront) { hit(front, 'car'); back.inv = 20; }\nelse {\nback.v = Math.min(back.v, front.v * TUNE.carKeep); back.slow = TUNE.carSlow; back.inv = TUNE.carProtect; front.inv = 20; front.v += 0.3;\nif (back === P || front === P) { fx(SFX.crash); shake = 14; emit('spark', (a.x + b.x) / 2, front.d - 8, 8, 0, 0.5, 16); }\n}\nconst push = Math.sign(back.x - front.x) || (back.id & 1 ? 1 : -1);\nback.x = clamp(back.x + push * 5, -40, 40); front.x = clamp(front.x - push * 5, -40, 40);\nback.tx = front.tx = clamp(back.tx, -32, 32);\n}\n}\nconst order = () => racers.slice().sort((a, b) => (a.fin >= 0 && b.fin >= 0 ? a.fin - b.fin : a.fin >= 0 ? -1 : b.fin >= 0 ? 1 : b.d - a.d));\nconst place = (r) => order().indexOf(r) + 1;\nfunction followRank() {\nconst p = place(P);\nif (p < lastRank && state === 'race' && !P.auto) { passes += lastRank - p; fx(SFX.pass); msg = p === 1 ? 'IN THE LEAD!' : `PASSED! ${ord(p)}`; msgT = 50; }\nlastRank = p;\n}\nconst ord = (n) => n + (n === 1 ? 'ST' : n === 2 ? 'ND' : n === 3 ? 'RD' : 'TH');\nfunction emit(k, x, d, n, vx, vd, life) {\nfor (let i = 0; i < n && parts.length < 28; i++) parts.push({ k, x: x + (n > 1 ? rndi(-4, 4) : 0), d, h: k === 'smoke' ? 1 : 4, vx: vx + (rndi(-3, 3) / 8), vd: P.v * (k === 'sparkle' ? 0 : 0.8) + vd * rndi(0, 4), vh: k === 'smoke' ? 0.2 : 0.5, life, max: life });\n}\nfunction updateParts() {\nfor (const p of parts) { p.x += p.vx; p.d += p.vd; p.h += p.vh; p.vh -= p.k === 'spark' ? 0.06 : 0; p.life--; }\nparts = parts.filter((p) => p.life > 0);\n}\nfunction toResults() {\nstate = 'results'; timer = 0; play(SONG.results);\nconst o = order(), pl = o.indexOf(P) + 1, secs = P.fin / 60;\nconst score = (8 - pl) * 1000 + Math.max(0, Math.floor((150 - secs) * 20)) + cubes * 100 + passes * 50;\nconst best = dget(BEST_SLOT), newBest = pl === 1 && (!best || P.fin < best);\nif (pl === 1 && newBest) dset(BEST_SLOT, P.fin);\ndset(RACES_SLOT, dget(RACES_SLOT) + 1);\nrank = insertTop({ score, initials: lastInitials() });\nresult = { place: pl, time: P.fin, score, cubes, passes, newBest, order: o.map((r) => ({ name: r.name, pal: r.pal, fin: r.fin, you: r === P })) };\nif (pl <= 3) fx(SFX.record);\n}\nfunction updateResults() {\nif (timer < 45) return;\nif (pressed(A) || pressed(START)) { fx(SFX.select); startRace(newSeed()); toGrid(); }\nelse if (pressed(B)) {\nfx(SFX.select);\nif (rank >= 0 && result.place <= 8) { state = 'initials'; timer = 0; initials = { chars: lastInitials().split(''), pos: 0 }; }\nelse toTitle();\n}\n}\nfunction updateInitials() {\nconst ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\nif (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\nif (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\nif (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\nconst done = pressed(START) || (pressed(A) && ini.pos === 2);\nif (pressed(A) && ini.pos < 2) ini.pos++;\nif (!done || timer < 20) return;\nconst v = packInitials(ini.chars.join(''));\ndset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\nfx(SFX.select);\nstate = 'records'; hl = rank; timer = 0;\n}\nfunction updateRecords() { if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); } }\nfunction updatePause() {\nif (pressed(UP)) { pauseSel = (pauseSel + 2) % 3; fx(SFX.move); }\nif (pressed(DOWN)) { pauseSel = (pauseSel + 1) % 3; fx(SFX.move); }\nif (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\nelse if (pressed(A) || pressed(START)) {\nfx(SFX.select);\nif (pauseSel === 0) paused = false;\nelse if (pauseSel === 1) { startRace(seedNo); toGrid(); }\nelse toTitle();\n}\n}\nlet sky = { camX: 0 };\nfunction draw() {\ncls();\nbg(2, { mx: ART.scenes.far.mx, my: ART.scenes.far.my, mw: ART.scenes.far.w, mh: ART.scenes.far.h, x: flr(camX * 0.35), y: 0, wrap: true, show: true });\nbg(1, { x: flr(camX * 0.8), y: 0, show: true });\naffine(null);\nconst sc = state === 'title' ? ART.scenes.logo : ART.scenes.hud;\nbg(0, { mx: sc.mx, my: sc.my, mw: sc.w, mh: sc.h, x: 0, y: state === 'title' ? -8 : 0, wrap: false, show: state !== 'records' && state !== 'initials' });\nif (state === 'records') { drawRecords(); return; }\nif (state === 'initials') { drawInitials(); return; }\ndrawWorld();\nif (state === 'title') drawTitle(); else drawHud();\nif (state === 'results') drawResults();\nif (paused) drawPause();\n}\nconst ZT = (z, a) => { for (let i = 0; i < a.length; i++) if (z < a[i]) return i; return a.length - 1; };\nconst CAR_Z = [62, 80, 104, 136, 180, 240, 330, 540], CUBE_Z = [75, 108, 160, 700], CONE_Z = [68, 90, 120, 165, 225, 600], POST_Z = [65, 88, 118, 160, 220, 600];\nconst projX = (x, z) => 128 + (x - camX) * FOCAL / z;\nconst projY = (z) => HORIZON - 1 + HEIGHT * FOCAL / z;\nfunction drawWorld() {\nconst dl = [];\nfor (const r of racers) { const z = r.d - camD; if (z > CAMD - 14 && z < 560) dl.push([z, 0, r]); }\nfor (let i = lowerBound(camD + CAMD - 20); i < objs.length && objs[i].d < camD + LOOK; i++) { const o = objs[i]; if (o.on && (o.k === 'c' || o.k === 'k')) dl.push([o.d - camD, o.k === 'c' ? 1 : 2, o]); }\nfor (const p of parts) { const z = p.d - camD; if (z > 20 && z < 300) dl.push([z - 0.5, 3, p]); }\nconst first = Math.ceil((camD + CAMD - 20) / 48) * 48;\nfor (let d = first; d < camD + 450; d += 48) { dl.push([d - camD, 4, -RAIL_X]); dl.push([d - camD, 4, RAIL_X]); }\ndl.sort((a, b) => a[0] - b[0]);\nfor (const [z, k, o] of dl) {\nif (k === 0) drawCar(o, z); else if (k === 1) drawCube(o, z); else if (k === 2) drawCone(o, z); else if (k === 3) drawPart(o, z); else drawPost(o, z);\n}\ndrawGantry();\nif (P.boost > 0 || P.v > 5.7) speedLines();\n}\nfunction drawCar(r, z) {\nconst T = ZT(z, CAR_Z);\nif (r.inv > 0 && (r.inv >> 2) % 2 === 0 && !r.shield && r.id === 0) return;\nconst pose = r.spin > 0 ? ((clock >> 2) & 1 ? 'L' : 'R') : r.sv < -0.5 ? 'L' : r.sv > 0.5 ? 'R' : 'C';\nconst big = ART.big[T < 1 ? 'car0' + pose : 'car' + T];\nconst sx = projX(r.x, z), yg = projY(z) + (r === P && P.v > 1 ? (clock >> 2) & 1 : 0);\nconst jolt = r === P && shake > 0 ? ((clock & 1) * 2 - 1) * Math.min(2, shake >> 2) : 0;\nconst x0 = Math.round(sx - big.w / 2) + jolt, y0 = Math.round(yg - big.h + 2);\nbigSprite(big, x0, y0, { pal: r.pal, prio: 1 });\nif (r.boost > 0 && r.turbo) {\nconst f = (clock >> 1) & 1, sz = T < 1 ? 2 : T < 2 ? 1 : 0, s = ART.sprites['flame' + sz + '_' + f];\nconst k = big.w / 56, w = s.size;\nfor (const px of [12, 44]) sprite(s, Math.round(x0 + px * k - w / 2), Math.round(y0 + 25.6 * k - w / 2 + (T < 2 ? 3 : 0)), { prio: 1, pal: 5 });\n}\nif (r.shield && r === P && T < 1) shieldBubble(x0, y0, big);\n}\nfunction shieldBubble(x0, y0, big) {\nconst pulse = 0.5 + 0.5 * Math.sin(clock * 0.3), c = pulse > 0.5 ? CYAN : 12;\nconst cx = x0 + big.w / 2, cy = y0 + big.h / 2 + 1, rx = big.w / 2 + 6, ry = big.h / 2 + 5;\nfor (let a = 0; a < 40; a++) { const q = a / 40 * 6.2832; pset(Math.round(cx + Math.cos(q) * rx), Math.round(cy + Math.sin(q) * ry), c); pset(Math.round(cx + Math.cos(q) * (rx - 1)), Math.round(cy + Math.sin(q) * (ry - 1)), c); }\n}\nfunction drawCube(o, z) {\nconst T = ZT(z, CUBE_Z), f = T < 1 ? (flr(clock / 5 + o.i) & 3) : (flr(clock / 9 + o.i) & 1);\nconst big = ART.big[`cube${T}_${f}`], lift = 7 * FOCAL / z;\nbigSprite(big, Math.round(projX(o.x, z) - big.w / 2), Math.round(projY(z) - big.h - lift + 3), { prio: 1 });\n}\nfunction drawCone(o, z) {\nconst big = ART.big['cone' + ZT(z, CONE_Z)];\nbigSprite(big, Math.round(projX(o.x, z) - big.w / 2), Math.round(projY(z) - big.h + 1), { prio: 1 });\n}\nfunction drawPost(x, z) {\nconst big = ART.big['post' + ZT(z, POST_Z)];\nbigSprite(big, Math.round(projX(x, z) - big.w / 2), Math.round(projY(z) - big.h + 1), { prio: 1 });\n}\nfunction drawPart(p, z) {\nconst sx = projX(p.x, z), sy = projY(z) - p.h * FOCAL / z, a = p.life / p.max;\nif (p.k === 'smoke') { const f = Math.min(3, flr((1 - a) * 4)), s = ART.sprites['puff' + f]; if (s) sprite(s, Math.round(sx - s.size / 2), Math.round(sy - s.size / 2), { prio: 1 }); }\nelse if (p.k === 'sparkle') { const f = Math.min(3, flr((1 - a) * 4)), s = ART.sprites['spark' + f]; if (s) sprite(s, Math.round(sx - s.size / 2), Math.round(sy - s.size / 2), { prio: 1 }); }\nelse { const c = a > 0.5 ? GOLD : 9; rectfill(Math.round(sx), Math.round(sy), 2, 2, c); }\n}\nfunction drawGantry() {\nconst z = FINISH_D - camD;\nif (z < 20 || z > 900) return;\nconst yb = (h) => HORIZON - 1 + (HEIGHT - h) * FOCAL / z, xs = (x) => projX(x, z), k = FOCAL / z;\nconst xl = xs(-58), xr = xs(58), top = yb(86), bot = yb(62), gnd = yb(0), w = Math.max(1, Math.round(4 * k));\nrectfill(Math.round(xl - w / 2), Math.round(top), w, Math.round(gnd - top), DIM); rectfill(Math.round(xr - w / 2), Math.round(top), w, Math.round(gnd - top), DIM);\nconst n = 12, cw = (xr - xl) / n, ch = (bot - top) / 2;\nfor (let i = 0; i < n; i++) for (let j = 0; j < 2; j++) rectfill(Math.round(xl + i * cw), Math.round(top + j * ch), Math.ceil(cw), Math.ceil(ch), (i + j) & 1 ? WHITE : SHADOW);\nrect(Math.round(xl), Math.round(top), Math.round(xr - xl), Math.round(bot - top), DIM);\n}\nfunction speedLines() {\nconst n = P.boost > 0 ? 14 : 7;\nfor (let i = 0; i < n; i++) {\nconst a = (hash2(i, 5) % 1000) / 1000 * 6.2832, ph = ((clock * 0.045 + i * 0.37) % 1);\nconst ca = Math.cos(a), sa = Math.sin(a);\nif (sa < 0.15 && Math.abs(ca) < 0.5) continue;\nconst r0 = 40 + ph * 150, r1 = r0 + 14 + ph * 22, y0 = HORIZON + sa * r0 * 0.7, y1 = HORIZON + sa * r1 * 0.7;\nif (y0 < HORIZON + 8) continue;\nconst x0 = 128 + ca * r0 * 1.2, x1 = 128 + ca * r1 * 1.2;\nif (Math.abs(x0 - 128) < 78 && y0 > 170) continue;\nline(Math.round(x0), Math.round(y0), Math.round(x1), Math.round(y1), ph > 0.5 ? WHITE : DIM);\n}\n}\nconst D16 = (n) => ART.sprites['dg' + n];\nfunction drawHud() {\nconst p = place(P);\nprint('POS', 10, 8, DIM); sprite(D16(p), 12, 17); print('/8', 32, 25, WHITE);\nconst it = P.item, ic = it === 1 ? ART.sprites.iBolt : it === 2 ? ART.sprites.iShield : it === 3 ? ART.sprites.iOil : null;\nif (ic) { sprite(ic, 73, 9); if (clock % 40 < 28) print('A', 80, 27, WHITE); } else print('ITEM', 67, 17, DIM);\nconst kmh = Math.round(P.v * 60), s = String(kmh).padStart(3, ' ');\nprint('SPEED', 134, 8, DIM);\nfor (let i = 0; i < 3; i++) if (s[i] !== ' ') sprite(D16(+s[i]), 150 + i * 16, 14);\nprint('km/h', 206, 20, WHITE);\nconst segs = 12, fill = clamp((P.v - 1) / 6.2, 0, 1) * segs;\nfor (let i = 0; i < segs; i++) rectfill(134 + i * 9, 30, 7, 3, i < fill ? (i < 7 ? GREEN : i < 10 ? GOLD : RED) : PANEL);\nconst x0 = 10, w = 228;\nrectfill(x0, 41, w, 5, ART.colors.GLASS);\nfor (const r of racers) if (r !== P) { const x = x0 + Math.round(clamp((r.d - START_D) / TUNE.raceLen, 0, 1) * w); rectfill(x - 1, 42, 3, 3, PAL_COLOR[r.pal] || WHITE); }\nconst px = x0 + Math.round(clamp((P.d - START_D) / TUNE.raceLen, 0, 1) * w);\nrectfill(px - 2, 40, 5, 7, WHITE); rectfill(px - 1, 41, 3, 5, RED);\nsprite(ART.sprites.iFlag, 242, 39);\nconst secs = Math.floor(rt / 60), t10 = Math.floor((rt % 60) / 6);\nprint(`${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}.${t10}`, 8, 52, WHITE);\nif (msgT > 0 && msg !== 'GO!' && msg !== 'FINISH!') ctxt(msg, 60, GOLD);\nif (state === 'grid') drawCountdown();\nif (state === 'finish' && timer < 190) bigText('FINISH', 128, 54, 5, GOLD, true);\nif (state === 'race' && msg === 'GO!' && msgT > 0) bigText('GO', 128, 50, 7, GREEN, true);\n}\nfunction drawCountdown() {\nconst c = timer, n = c < 60 ? 3 : c < 120 ? 2 : c < 180 ? 1 : 0;\nif (n > 0) bigText(String(n), 128, 50, 7, c % 60 < 8 ? WHITE : GOLD, true);\nelse bigText('GO', 128, 50, 7, GREEN, true);\n}\nfunction drawTitle() {\npanel(72, 134, 112, 76, true);\n['RACE', 'RECORDS'].forEach((s, i) => txt(`${i === titleSel ? '>' : ' '} ${s}`, 92, 142 + i * 14, i === titleSel ? WHITE : DIM));\nconst best = dget(BEST_SLOT);\nif (best) ctxt('BEST WIN ' + fmtTime(best), 174, GOLD);\nif (timer % 60 < 40) ctxt('PRESS START', 192, WHITE);\n}\nconst fmtTime = (f) => `${Math.floor(f / 3600)}:${String(Math.floor(f / 60) % 60).padStart(2, '0')}.${String(Math.floor((f % 60) / 6))}`;\nfunction drawResults() {\nconst R = result;\npanel(34, 62, 188, 156);\nctxt(R.place === 1 ? 'YOU WIN!' : `FINISHED ${ord(R.place)}`, 68, R.place <= 3 ? GOLD : WHITE);\nctxt(`TIME ${fmtTime(R.time)}${R.newBest ? '  NEW BEST!' : ''}`, 80, WHITE);\nR.order.forEach((e, i) => {\nconst y = 94 + i * 10;\nif (e.you) rectfill(40, y - 1, 176, 10, PANEL);\ntxt(String(i + 1), 46, y, i === 0 ? GOLD : DIM);\nrectfill(62, y + 1, 6, 5, PAL_COLOR[e.pal] || WHITE); txt(e.name, 74, y, e.you ? GOLD : WHITE);\ntxt(e.fin >= 0 ? fmtTime(e.fin) : '--', 150, y, e.you ? GOLD : DIM);\n});\ntxt(`SCORE ${R.score}${rank >= 0 ? '  TOP 10!' : ''}`, 46, 176, rank >= 0 ? GOLD : WHITE);\nif (timer > 45 && timer % 60 < 40) { txt('A: RACE AGAIN', 46, 190, WHITE); txt('B: TITLE', 46, 202, DIM); }\n}\nfunction drawRecords() {\nrectfill(0, 0, 256, 224, ART.colors.GLASS);\npanel(24, 16, 208, 192);\nctxt('TOP 10', 24, GOLD);\ntopTen().forEach((e, i) => {\nconst y = 48 + i * 14, on = i === hl;\nif (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\ntxt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\ntxt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\ntxt(e.score ? String(e.score).padStart(8) : '', 128, y, i === 0 ? GOLD : WHITE);\n});\nif (timer % 60 < 40) ctxt('START: BACK', 192, DIM);\n}\nfunction drawInitials() {\nconst ini = initials;\nrectfill(0, 0, 256, 224, ART.colors.GLASS);\npanel(24, 40, 208, 144);\nctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\nctxt(String(result.score), 68, WHITE);\nctxt('ENTER YOUR INITIALS', 90, DIM);\nfor (let i = 0; i < 3; i++) {\nconst on = i === ini.pos, x = 84 + i * 32;\nrect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\ntxt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n}\nif (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\nfunction drawPause() {\npanel(48, 80, 160, 64);\nctxt('PAUSED', 88, GOLD);\n['RESUME', 'RESTART', 'QUIT TO TITLE'].forEach((s, i) => txt(`${i === pauseSel ? '>' : ' '} ${s}`, 64, 104 + i * 10, i === pauseSel ? WHITE : DIM));\n}\nfunction panel(x, y, w, h, glass) { rectfill(x, y, w, h, glass ? ART.colors.GLASS : 2); rect(x, y, w, h, DIM); rect(x + 1, y + 1, w - 2, h - 2, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nconst FONT = { 0: '01110 10001 10011 10101 11001 10001 01110', 1: '00100 01100 00100 00100 00100 00100 01110', 2: '01110 10001 00001 00110 01000 10000 11111', 3: '11110 00001 00001 01110 00001 00001 11110',\nG: '01110 10001 10000 10111 10001 10001 01111', O: '01110 10001 10001 10001 10001 10001 01110', F: '11111 10000 10000 11110 10000 10000 10000', I: '01110 00100 00100 00100 00100 00100 01110',\nN: '10001 11001 10101 10101 10011 10001 10001', S: '01111 10000 10000 01110 00001 00001 11110', H: '10001 10001 10001 11111 10001 10001 10001' };\nfunction bigText(s, cx, y, k, col, shadow) {\nconst w = s.length * 6 * k - k; let x = Math.round(cx - w / 2);\nfor (const ch of s) {\nconst g = FONT[ch];\nif (g) g.split(' ').forEach((row, j) => { for (let i = 0; i < 5; i++) if (row[i] === '1') { if (shadow) rectfill(x + i * k + (k >> 2) + 1, y + j * k + (k >> 2) + 1, k, k, SHADOW); } });\nif (g) g.split(' ').forEach((row, j) => { for (let i = 0; i < 5; i++) if (row[i] === '1') rectfill(x + i * k, y + j * k, k, k, col); });\nx += 6 * k;\n}\n}\nfunction scanline(y) {\nif (y < HORIZON) { gradientLine(ART.gradients.sky, y); return; }\nif (y === HORIZON) {\nbg(1, { show: false });\nbg(2, { mx: 0, my: 0, mw: 128, mh: 128, x: 0, y: 0, wrap: true, show: false });\ncolor(0, HAZE[0], HAZE[1], HAZE[2]);\n}\nif (y < FLOOR_TOP) return;\nif (y === FLOOR_TOP) bg(2, { show: true });\nconst z = HEIGHT * FOCAL / (y - HORIZON + 1), s = z / FOCAL;\nconst py = ((-camD - z) % 1024 + 1024) % 1024;\naffine({ a: s, b: CX + camX - 128, c: 0, d: py, cx: 128, cy: 0 });\nbgscroll(2, 0, 1 - y);\nif (y <= FOG_END + 1) {\nconst k = y > FOG_END ? 0 : Math.pow(clamp((z - 160) / 840, 0, 1), 0.7);\nfor (const i of FOG_ENTRIES) { const c = FOG[i]; color(i, flr(lerp(c[0], HAZE[0], k)), flr(lerp(c[1], HAZE[1], k)), flr(lerp(c[2], HAZE[2], k))); }\n}\n}\n",

{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Rags to Riches",
    "author": "NOVA-16",
    "description": "Save the rehearsal room: take Dot, Zorp and Spike on a 10-week tour and raise $5,000. Each week play a concert, write songs or travel. Set the venue, price and ads, and keep each town fresh."
  },
  "label": "",
  "code": "// Rags to Riches\n// A ten-week band-management game: one action a week (concert, songs, travel), $5,000 to win. Spec: docs/carts/rags-to-riches.md.\n// Phase 1: the economy as pure functions (see \"The economy\"), the week hub, one concert flow and the end of the tour.\n// The frame (pause, saved top 10 with initials, records, sound and music cues, skipTitle) comes from tools/new-cart.js.\n\n// --- Colours: the default palette (DawnBringer 16). The overlay's index 0 is transparent. ---\n\n// Menu rows: the one under the cursor is GOLD (and has the > mark), the others WHITE, a row that cannot be chosen DIM (and says why when the cursor is on it).\nconst SHADOW = 1, PANEL = 3, RED = 6, DIM = 10, GREEN = 11, CYAN = 13, GOLD = 14, WHITE = 15;\n\n// --- Art: made by art.py (tiles.txt, palette.txt, map.txt). The block below is rewritten each time it runs. ---\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {\"arena\": {\"pal\": 5, \"size\": 32, \"tile\": 960}, \"bag\": {\"pal\": 6, \"size\": 16, \"tile\": 972}, \"bar\": {\"pal\": 5, \"size\": 32, \"tile\": 904}, \"city0\": {\"pal\": 7, \"size\": 16, \"tile\": 996}, \"city1\": {\"pal\": 7, \"size\": 16, \"tile\": 998}, \"city2\": {\"pal\": 7, \"size\": 16, \"tile\": 1000}, \"city3\": {\"pal\": 7, \"size\": 16, \"tile\": 1002}, \"city4\": {\"pal\": 7, \"size\": 16, \"tile\": 1004}, \"cloud0\": {\"pal\": 6, \"size\": 16, \"tile\": 964}, \"cloud1\": {\"pal\": 6, \"size\": 16, \"tile\": 968}, \"coin0\": {\"pal\": 6, \"size\": 8, \"tile\": 760}, \"coin1\": {\"pal\": 6, \"size\": 8, \"tile\": 762}, \"coin2\": {\"pal\": 6, \"size\": 8, \"tile\": 764}, \"coin3\": {\"pal\": 6, \"size\": 8, \"tile\": 766}, \"dot0\": {\"pal\": 1, \"size\": 32, \"tile\": 772}, \"dot1\": {\"pal\": 1, \"size\": 32, \"tile\": 840}, \"grubb0\": {\"pal\": 4, \"size\": 32, \"tile\": 832}, \"grubb1\": {\"pal\": 4, \"size\": 32, \"tile\": 900}, \"ring0\": {\"pal\": 6, \"size\": 16, \"tile\": 966}, \"ring1\": {\"pal\": 6, \"size\": 16, \"tile\": 970}, \"spark0\": {\"pal\": 6, \"size\": 8, \"tile\": 761}, \"spark1\": {\"pal\": 6, \"size\": 8, \"tile\": 763}, \"spark2\": {\"pal\": 6, \"size\": 8, \"tile\": 765}, \"spark3\": {\"pal\": 6, \"size\": 8, \"tile\": 767}, \"spike0\": {\"pal\": 3, \"size\": 32, \"tile\": 780}, \"spike1\": {\"pal\": 3, \"size\": 32, \"tile\": 896}, \"star\": {\"pal\": 6, \"size\": 16, \"tile\": 974}, \"theatre\": {\"pal\": 5, \"size\": 32, \"tile\": 908}, \"van0\": {\"pal\": 0, \"size\": 32, \"tile\": 768}, \"van1\": {\"pal\": 0, \"size\": 32, \"tile\": 836}, \"zorp0\": {\"pal\": 2, \"size\": 32, \"tile\": 776}, \"zorp1\": {\"pal\": 2, \"size\": 32, \"tile\": 844}},\n  scenes: {\"crowdkit\": {\"h\": 2, \"mx\": 192, \"my\": 28, \"pal\": 6, \"w\": 16}, \"hub0\": {\"h\": 28, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hub1\": {\"h\": 28, \"mx\": 32, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hub2\": {\"h\": 28, \"mx\": 64, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hub3\": {\"h\": 28, \"mx\": 96, \"my\": 0, \"pal\": 1, \"w\": 32}, \"hub4\": {\"h\": 28, \"mx\": 128, \"my\": 0, \"pal\": 1, \"w\": 32}, \"intro0\": {\"h\": 28, \"mx\": 96, \"my\": 28, \"pal\": 7, \"w\": 32}, \"intro1\": {\"h\": 28, \"mx\": 128, \"my\": 28, \"pal\": 7, \"w\": 32}, \"intro2\": {\"h\": 28, \"mx\": 160, \"my\": 28, \"pal\": 7, \"w\": 32}, \"ledger\": {\"h\": 28, \"mx\": 192, \"my\": 0, \"pal\": 1, \"w\": 32}, \"map\": {\"h\": 28, \"mx\": 224, \"my\": 0, \"pal\": 2, \"w\": 32}, \"stage0\": {\"h\": 28, \"mx\": 0, \"my\": 28, \"pal\": 3, \"w\": 32}, \"stage1\": {\"h\": 28, \"mx\": 32, \"my\": 28, \"pal\": 4, \"w\": 32}, \"stage2\": {\"h\": 28, \"mx\": 64, \"my\": 28, \"pal\": 5, \"w\": 32}, \"title\": {\"h\": 28, \"mx\": 160, \"my\": 0, \"pal\": 1, \"w\": 32}},\n  colors: {\"c3a\": 54, \"c3b\": 55, \"c4a\": 71, \"c5a\": 91, \"c5b\": 92, \"c5c\": 93, \"t_bld\": 26, \"t_ground\": 22, \"t_roof\": 28, \"t_s3\": 20},\n};\nART.cityPos = [[40, 50], [66, 90], [128, 38], [176, 68], [212, 94]];\n// END ART\n\n// --- Sound (SPEC 5). Any channel plays any instrument. Songs use channels 0 to 5; effects take turns on 6 and 7, ---\n// so they never cut into the music and two can sound at once (the takings and the crowd's cheer).\n\nconst SFX = { move: 0, select: 1, back: 2, pause: 3, refuse: 4, coin: 5, loss: 6, soldout: 7, cheer: 8, roll: 9, horn: 10, record: 11 };\nconst SONG = { title: 0, tour: 1, concert: 2, writing: 3, road: 4, victory: 5, defeat: 6 };\nconst SFX_CH = [7, 6];\nlet fxNext = 0;\nfunction fx(n) { sfx(n, SFX_CH[fxNext]); fxNext ^= 1; }\n\n// A song is only started if it is not already playing.\nlet playing = -1;\nfunction play(song) {\n  if (song === playing) return;\n  playing = song; music(song);\n}\n\n// --- The tuning numbers: every number of the economy is here (spec section 5 and 6) ---\n\nconst TUNE = {\n  weeks: 10, goal: 5000,\n  startCash: 400, startPop: 18, startFresh: 70,\n  priceMin: 5, priceMax: 50, priceStart: 10, priceStep: 1, priceBig: 5,\n  adMax: 200, adStep: 10, adBig: 50,\n  rollMin: 94, rollMax: 106, // the seeded variation of a crowd, in percent\n  freshCost: 10, fatigueGain: 30,\n  // the crowd's terms (spec 5.2): base + slope * value; the price term is base - price / city.priceScale, clamped\n  popBase: 0.10, popSlope: 1.80, freshBase: 0.65, freshSlope: 0.35,\n  priceBase: 1.35, priceLow: 0.25, priceHigh: 1.15,\n  adBoost: 0.50, adHalf: 80, // advertising adds up to adBoost of a crowd, half of it at adHalf dollars\n  fatigueSpan: 100, fatigueFloor: 0.25,\n  songFresh: 30, songPop: 8, fare: 20, // songwriting and travel: used from Phase 3\n};\n// The five markets. pool: the crowd the city can give; priceScale: how much a ticket can cost before the crowd thins out;\n// competition: the share of the crowd lost to rival bands. crowd/rooms/rivals are the words the player sees. Each city has\n// three venues (a bar, a theatre, an arena); rent is paid up front.\nconst CITIES = [\n  { name: 'RUSTPORT', crowd: 'SMALL', rooms: 'CHEAP', rivals: 'FEW', pool: 34, priceScale: 30, competition: 0.02,\n    venues: [{ name: 'THE SOGGY BOOT', capacity: 15, rent: 35 }, { name: 'RIVET HALL', capacity: 25, rent: 95 }, { name: 'DOCKSIDE DOME', capacity: 50, rent: 220 }] },\n  { name: 'SUNVALE', crowd: 'MEDIUM', rooms: 'CHEAP', rivals: 'FEW', pool: 44, priceScale: 36, competition: 0.04,\n    venues: [{ name: 'CACTUS CANTINA', capacity: 15, rent: 45 }, { name: 'MESA THEATRE', capacity: 35, rent: 120 }, { name: 'SUNBOWL', capacity: 65, rent: 285 }] },\n  { name: 'CEDAR CITY', crowd: 'BIG', rooms: 'FAIR', rivals: 'SOME', pool: 54, priceScale: 40, competition: 0.08,\n    venues: [{ name: 'THE KNOTHOLE', capacity: 20, rent: 55 }, { name: 'LUMBER HALL', capacity: 40, rent: 145 }, { name: 'CEDAR COLISEUM', capacity: 80, rent: 330 }] },\n  { name: 'METRO HEIGHTS', crowd: 'BIG', rooms: 'DEAR', rivals: 'MANY', pool: 68, priceScale: 46, competition: 0.15,\n    venues: [{ name: 'THE BASEMENT', capacity: 25, rent: 75 }, { name: 'SKYLINE THEATRE', capacity: 50, rent: 185 }, { name: 'METRO ARENA', capacity: 100, rent: 430 }] },\n  { name: 'COASTLINE', crowd: 'HUGE', rooms: 'PRICEY', rivals: 'MANY', pool: 78, priceScale: 50, competition: 0.18,\n    venues: [{ name: 'THE TIDEPOOL', capacity: 30, rent: 90 }, { name: 'PIER PLAYHOUSE', capacity: 60, rent: 215 }, { name: 'SURF STADIUM', capacity: 115, rent: 500 }] },\n];\n\n// --- The economy: pure functions (no state, no random numbers: the roll is an argument) ---\n\n/** The six multipliers of the crowd. */\nfunction factors(city, price, ad, pop, fresh, fatigue) {\n  return {\n    pop: TUNE.popBase + TUNE.popSlope * pop / 100,\n    fresh: TUNE.freshBase + TUNE.freshSlope * fresh / 100,\n    price: clamp(TUNE.priceBase - price / city.priceScale, TUNE.priceLow, TUNE.priceHigh),\n    ad: 1 + TUNE.adBoost * (ad / (ad + TUNE.adHalf)),\n    fatigue: clamp(1 - fatigue / TUNE.fatigueSpan, TUNE.fatigueFloor, 1),\n    comp: 1 - city.competition,\n  };\n}\n/** The crowd the band can expect, before the venue's size and the roll. */\nfunction expectedCrowd(city, price, ad, pop, fresh, fatigue) {\n  const f = factors(city, price, ad, pop, fresh, fatigue);\n  return city.pool * f.pop * f.fresh * f.price * f.ad * f.fatigue * f.comp;\n}\n/** The tickets sold: a whole number from 0 to the venue's capacity. roll is a percentage, TUNE.rollMin to rollMax. */\nfunction attendance(city, venue, price, ad, pop, fresh, fatigue, roll) {\n  return clamp(Math.round(expectedCrowd(city, price, ad, pop, fresh, fatigue) * roll / 100), 0, venue.capacity);\n}\n/** Popularity won or lost by a show of this size in this room (spec 5.3). */\nfunction popularityChange(att, capacity) {\n  const occ = Math.floor(att * 100 / capacity);\n  if (occ < 30) return occ < 10 ? -3 : occ < 20 ? -2 : -1;\n  return 1 + (occ >= 100 ? 5 : occ >= 90 ? 4 : occ >= 75 ? 3 : occ >= 60 ? 2 : occ >= 45 ? 1 : 0);\n}\n/** LOW, FAIR or STRONG: the expected crowd (roll 100) against the room, never the number itself. */\nfunction forecast(city, venue, price, ad, pop, fresh, fatigue) {\n  const r = expectedCrowd(city, price, ad, pop, fresh, fatigue) / venue.capacity;\n  return r < 0.4 ? 'LOW' : r < 0.75 ? 'FAIR' : 'STRONG';\n}\n/** The one line that says why the crowd was what it was (spec 5.5). */\nfunction mainFactor(f, full) {\n  if (full) return 'FULL HOUSE! BIGGER ROOM?';\n  const worst = [[f.pop, 'LOW POPULARITY'], [f.fresh, 'STALE SONGS'], [f.price, 'PRICE TOO HIGH'], [f.fatigue, 'TIRED MARKET']]\n    .reduce((a, b) => (b[0] < a[0] ? b : a));\n  return worst[0] >= 0.9 ? 'GOOD MIX OF PRICE AND BUZZ' : worst[1];\n}\n/** How the fans of a market feel, from its fatigue: the word the hub shows. */\nconst fansWord = (fatigue) => (fatigue < 20 ? 'EAGER' : fatigue < 45 ? 'WARM' : fatigue < 70 ? 'TIRED' : 'WORN OUT');\n/** Songwriting (spec 5.3): freshness and popularity up, no money, no fatigue. s = { pop, fresh }. */\nfunction writeSongs(s) {\n  const pop = clamp(s.pop + TUNE.songPop, 0, 100);\n  return { popBefore: s.pop, pop, popChange: pop - s.pop, freshBefore: s.fresh, fresh: clamp(s.fresh + TUNE.songFresh, 0, 100) };\n}\nconst canTravel = (cash) => cash >= TUNE.fare;\n/** The tour is won with the goal or more in cash at the end of week 10. */\nconst isWin = (cash) => cash >= TUNE.goal;\n/** Can the cash pay for a show in at least one venue of this city? */\nconst canConcert = (cash, c) => cash >= Math.min(...c.venues.map((v) => v.rent));\n/** The words under a concert's cutscene, from how full the room was (percent). */\nconst crowdVerdict = (occ) => (occ >= 100 ? 'SOLD OUT! THE ROOM ERUPTS!' : occ >= 75 ? 'WHAT A NIGHT!' : occ >= 45 ? 'A GOOD, LOUD CROWD' : occ >= 20 ? 'A THIN BUT KIND CROWD' : 'CRICKETS... AND ONE DOG');\n/** The most advertising the cash allows after the rent. */\nconst maxAd = (cash, rent) => clamp(Math.floor((cash - rent) / TUNE.adStep) * TUNE.adStep, 0, TUNE.adMax);\nconst canAfford = (cash, venue, ad) => venue.rent + ad <= cash;\n/** A whole concert, settled: s = { cash, pop, fresh, fatigue } before it. Returns every figure the result screen shows. */\nfunction settle(s, city, venue, price, ad, roll) {\n  const f = factors(city, price, ad, s.pop, s.fresh, s.fatigue);\n  const att = attendance(city, venue, price, ad, s.pop, s.fresh, s.fatigue, roll);\n  const revenue = att * price, net = revenue - venue.rent - ad, dp = popularityChange(att, venue.capacity);\n  return {\n    att, capacity: venue.capacity, price, revenue, rent: venue.rent, ad, net, roll,\n    cashBefore: s.cash, cash: s.cash + net,\n    popBefore: s.pop, pop: clamp(s.pop + dp, 0, 100), popChange: dp,\n    freshBefore: s.fresh, fresh: clamp(s.fresh - TUNE.freshCost, 0, 100),\n    fatigue: clamp(s.fatigue + TUNE.fatigueGain, 0, 100),\n    note: mainFactor(f, att >= venue.capacity),\n  };\n}\n\n// --- Words ---\n\nconst money = (n) => (n < 0 ? '-$' : '$') + String(Math.abs(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\nconst signed = (n) => (n < 0 ? '-' : '+') + money(Math.abs(n));\nconst SONG_LINES = ['A CHORUS ABOUT A SANDWICH', 'THREE CHORDS, ZERO SLEEP', 'THE SYNTH PLAYER WENT WILD', 'A RHYME FOR \"RENT\" AT LAST', 'THE VAN HUMS ALONG: A HIT?', 'THE NEIGHBORS ARE HUMMING IT'];\nconst ARRIVE_LINES = ['RUST, ROPES AND SEAGULLS', 'SO SUNNY THE VAN MELTS', 'SAWDUST IN THE AIR', 'ALL HONKING, NO PARKING', 'SURF, SAND AND SUNBURN'];\nconst INTRO_PANELS = [\n  ['THE REHEARSAL ROOM', ['DOT, ZORP AND SPIKE ARE A', 'BAND WITH A DAMP ROOM AND', 'A LANDLORD KNOCKING.']],\n  ['THE BAD NEWS', ['MR. GRUBB IS SELLING THE', 'BUILDING. KEEP THE ROOM FOR', '$5,000 IN TEN WEEKS.']],\n  ['THE PLAN', ['YOU HAVE $400, A BATTERED', 'VAN AND A FEW SONGS.', 'TIME TO HIT THE ROAD!']],\n];\nconst HELP_PAGES = [\n  ['THE GOAL', ['RAISE $5,000 IN 10 WEEKS.', 'ONE ACTION A WEEK:', '', '- PLAY A CONCERT', '- WRITE NEW SONGS', '- TRAVEL TO ANOTHER CITY', '', 'END WEEK 10 WITH $5,000 OR', 'MORE TO WIN. YOUR SCORE IS', 'THE FINAL CASH.']],\n  ['CONCERTS', ['PICK A VENUE: BIG ROOMS HOLD', 'MORE BUT COST MORE.', 'HIGH PRICES THIN THE CROWD.', 'ADVERTISING BRINGS FANS IN', 'BUT COSTS CASH.', 'RENT AND ADS ARE PAID UP', 'FRONT. THE FORECAST SAYS', 'LOW, FAIR OR STRONG.']],\n  ['SONGS AND TRAVEL', ['SONGS: NO MONEY, BUT FANS', 'AND FRESHNESS GROW.', '', 'TRAVEL: $20 AND A WEEK, NO', 'CONCERT. FANS IN A CITY GET', 'TIRED OF YOU; A NEW CITY', 'STARTS FRESH.']],\n  ['TIPS', ['A NEW BAND DRAWS SMALL', 'CROWDS, SO WRITE SONGS', 'EARLY: THEY BUILD FANS.', 'A FULL HOUSE WINS MORE FANS.', 'AFTER 2 OR 3 SHOWS HERE,', 'MOVE ON: FRESH CITIES PAY.', 'BIG CITIES PAY BETTER BUT', 'THEIR ROOMS COST MORE.']],\n  ['CONTROLS', ['D-PAD: MOVE OR CHANGE', 'L / R: BIG STEPS', 'A: CONFIRM    B: BACK', 'START: PAUSE AND HELP', '', 'NOTHING IS SPENT UNTIL YOU', 'CONFIRM AN ACTION.']],\n];\nconst two = (n) => String(n).padStart(2, '0');\n\n// --- Save slots (SPEC 13) ---\n\nconst VERSION_SLOT = 0, SAVE_VERSION = 2, INITIALS_SLOT = 1, INTRO_SLOT = 2; // INTRO_SLOT: 1 once the intro was seen or skipped\nconst TOP_SLOT = 10, TOP_N = 10, ENTRY = 3; // the top 10, best first: final cash, initials, trips * 16 + concerts (slots 10 to 39)\nconst LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n\nfunction readEntry(i) { const s = TOP_SLOT + i * ENTRY, t = dget(s + 2); return { score: dget(s), initials: unpackInitials(dget(s + 1)), trips: t >> 4, concerts: t & 15 }; }\nfunction writeEntry(i, e) { const s = TOP_SLOT + i * ENTRY; dset(s, e.score); dset(s + 1, packInitials(e.initials)); dset(s + 2, ((e.trips || 0) << 4) | (e.concerts || 0)); }\nconst topTen = () => Array.from({ length: TOP_N }, (_, i) => readEntry(i));\n\n/** Does tour result a rank above entry b? More cash first; on a tie fewer trips, then fewer concerts; a full tie ranks below. */\nconst beats = (a, b) => a.score !== b.score ? a.score > b.score : (a.trips || 0) !== (b.trips || 0) ? (a.trips || 0) < (b.trips || 0) : (a.concerts || 0) < (b.concerts || 0);\n/** The row a result would take in the top 10, or -1 (a score of $0 never does). */\nconst rankOf = (e) => (e.score ? topTen().findIndex((x) => beats(e, x)) : -1);\n/** Put a score into the top 10 if it makes it. Returns its row, or -1. */\nfunction insertTop(e) {\n  const at = rankOf(e);\n  if (at < 0) return -1;\n  const list = topTen();\n  list.splice(at, 0, e);\n  for (let i = at; i < TOP_N; i++) writeEntry(i, list[i]);\n  return at;\n}\n/** Three characters, 8 bits each. */\nconst packInitials = (str) => (str.charCodeAt(0) << 16) | (str.charCodeAt(1) << 8) | str.charCodeAt(2);\nconst unpackInitials = (v) => (v ? String.fromCharCode((v >> 16) & 255, (v >> 8) & 255, v & 255) : '---');\nconst lastInitials = () => (dget(INITIALS_SLOT) ? unpackInitials(dget(INITIALS_SLOT)) : 'AAA');\n\n// --- Input: edge-triggered presses (btnp repeats; menus want one press) ---\n\nlet inputMask = 0, prevMask = 0;\nconst BUTTONS = [UP, DOWN, LEFT, RIGHT, A, B, X, Y, L, R, START, SELECT];\nfunction readPad() { let m = 0; for (const b of BUTTONS) if (btn(b)) m |= 1 << b; return m; }\nconst pressed = (b) => (inputMask & (1 << b)) !== 0 && (prevMask & (1 << b)) === 0;\n\n// --- State ---\n\nlet skipTitle = false; // tests set this to land straight in the game\nlet state = 'title', paused = false, timer = 0, clock = 0;\nlet titleSel = 0, pauseSel = 0, rank = -1, hl = -1, initials = null;\nlet tour = null; // the run: week, cash, pop, fresh, city, fatigue per city, counts\nlet helpOpen = false, helpPage = 0, pauseAsk = -1, askSel = 0, introPage = 0, introThen = 'tour', mapSel = 0;\nlet hubSel = 0, venueSel = 0, plan = { row: 0, venue: 0, price: TUNE.priceStart, ad: 0 }, show = null, act = null, travelSel = 0;\n\nfunction newTour() {\n  return {\n    week: 1, cash: TUNE.startCash, pop: TUNE.startPop, fresh: TUNE.startFresh, city: 0,\n    fatigue: CITIES.map(() => 0), concerts: 0, songs: 0, trips: 0, best: 0, actions: 0, tickets: 0, earned: 0, spent: 0,\n  };\n}\nconst city = () => CITIES[tour.city];\nconst venue = () => city().venues[plan.venue];\nconst cheapestRent = () => Math.min(...city().venues.map((v) => v.rent));\n\nfunction init() {\n  if (dget(VERSION_SLOT) !== SAVE_VERSION) { // a new or older save: start clean\n    for (let i = 0; i < 256; i++) dset(i, 0);\n    dset(VERSION_SLOT, SAVE_VERSION);\n  }\n  if (skipTitle) startTour(true); else toTitle();\n}\n\n/** The song for each screen. Songs that are already playing are not restarted, so moving between screens that share one keeps it going. */\nfunction musicFor(s) {\n  if (s === 'cityStart' || s === 'hub' || s === 'venue' || s === 'setup' || s === 'songs' || s === 'travel') return SONG.tour;\n  if (s === 'show' || s === 'result') return SONG.concert;\n  if (s === 'songResult') return SONG.writing;\n  if (s === 'travelResult') return SONG.road;\n  if (s === 'final') return isWin(tour.cash) ? SONG.victory : SONG.defeat;\n  return SONG.title; // the title, the intro, the initials, the records\n}\nfunction go(s) { state = s; timer = 0; play(musicFor(s)); }\nfunction toTitle() { go('title'); titleSel = 0; paused = false; helpOpen = false; pauseAsk = -1; tour = null; }\n\n/** A new tour: on the map to pick the first city (no fare, no week). direct (tests) lands on the hub in Rustport. */\nfunction startTour(direct = false) {\n  tour = newTour(); hubSel = 0; show = null; act = null; paused = false; helpOpen = false; pauseAsk = -1; mapSel = 0;\n  plan = { row: 0, venue: 0, price: TUNE.priceStart, ad: 0 };\n  go(direct ? 'hub' : 'cityStart');\n}\nfunction startIntro(then) { introPage = 0; introThen = then; go('intro'); }\nfunction endIntro() {\n  dset(INTRO_SLOT, 1);\n  if (introThen === 'tour') startTour(); else toTitle();\n}\n\n// --- Update ---\n\nfunction update() {\n  inputMask = readPad(); clock++;\n  if (!paused && !helpOpen) timer++; // a state's clock: it stands still while paused or reading the help\n  if (helpOpen) updateHelp();\n  else if (paused) updatePause();\n  else if (state === 'title') updateTitle();\n  else if (state === 'intro') updateIntro();\n  else if (state === 'cityStart') updateCityStart();\n  else if (state === 'show') updateShow();\n  else if (state === 'hub') updateHub();\n  else if (state === 'venue') updateVenue();\n  else if (state === 'setup') updateSetup();\n  else if (state === 'songs') updateSongs();\n  else if (state === 'travel') updateTravel();\n  else if (state === 'result' || state === 'songResult' || state === 'travelResult') updateResult();\n  else if (state === 'final') updateFinal();\n  else if (state === 'initials') updateInitials();\n  else if (state === 'records') updateRecords();\n  prevMask = inputMask;\n}\n\nconst TITLE_ITEMS = ['NEW TOUR', 'HOW TO PLAY', 'RECORDS', 'SEE THE INTRO'];\nfunction updateTitle() {\n  if (pressed(UP)) { titleSel = (titleSel + TITLE_ITEMS.length - 1) % TITLE_ITEMS.length; fx(SFX.move); }\n  if (pressed(DOWN)) { titleSel = (titleSel + 1) % TITLE_ITEMS.length; fx(SFX.move); }\n  if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (titleSel === 0) { if (dget(INTRO_SLOT)) startTour(); else startIntro('tour'); } // the intro shows once, then it is skipped\n    else if (titleSel === 1) { helpOpen = true; helpPage = 0; }\n    else if (titleSel === 2) { go('records'); hl = -1; }\n    else startIntro('title');\n  }\n}\n\n/** The intro: A turns the page, START or B skips it all at once. It is shown on the first tour only (or from the title). */\nfunction updateIntro() {\n  if (pressed(START) || pressed(B)) { fx(SFX.select); endIntro(); return; }\n  if (pressed(A)) { fx(SFX.select); if (++introPage >= INTRO_PANELS.length) endIntro(); }\n}\n\n/** The help: LEFT/RIGHT (or A) turn the page; B or START close it. It works over the title and over a paused tour. */\nfunction updateHelp() {\n  if (pressed(LEFT)) { helpPage = (helpPage + HELP_PAGES.length - 1) % HELP_PAGES.length; fx(SFX.move); }\n  if (pressed(RIGHT)) { helpPage = (helpPage + 1) % HELP_PAGES.length; fx(SFX.move); }\n  if (pressed(A)) { fx(SFX.move); if (helpPage + 1 < HELP_PAGES.length) helpPage++; else helpOpen = false; }\n  if (pressed(B) || pressed(START)) { helpOpen = false; fx(SFX.back); }\n}\n\n/** The map: the cities in order from west to east. LEFT/UP go to the one before, RIGHT/DOWN to the next. */\nfunction mapMove(list, cur) {\n  const i = list.indexOf(cur);\n  if (pressed(LEFT) || pressed(UP)) { fx(SFX.move); return list[(i + list.length - 1) % list.length]; }\n  if (pressed(RIGHT) || pressed(DOWN)) { fx(SFX.move); return list[(i + 1) % list.length]; }\n  return cur;\n}\n/** Before week 1: choose where the tour starts. No fare, no week; B goes back to the title. */\nfunction updateCityStart() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.back); toTitle(); return; }\n  mapSel = mapMove(CITIES.map((_, i) => i), mapSel);\n  if (pressed(A)) { tour.city = mapSel; plan.venue = 0; fx(SFX.select); go('hub'); }\n}\n\n/** The hub: one action a week. An action that cannot be paid for is greyed, and the hub says why. */\nconst hubOk = () => [canConcert(tour.cash, city()), true, canTravel(tour.cash)];\nfunction updateHub() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(UP)) { hubSel = (hubSel + 2) % 3; fx(SFX.move); }\n  if (pressed(DOWN)) { hubSel = (hubSel + 1) % 3; fx(SFX.move); }\n  if (!pressed(A)) return;\n  if (!hubOk()[hubSel]) { fx(SFX.refuse); return; }\n  fx(SFX.select);\n  if (hubSel === 0) { venueSel = clamp(plan.venue, 0, city().venues.length - 1); go('venue'); }\n  else if (hubSel === 1) go('songs');\n  else { travelSel = otherCities()[0]; go('travel'); }\n}\nconst otherCities = () => CITIES.map((_, i) => i).filter((i) => i !== tour.city);\n\n/** Songwriting: the screen says what it costs (a week, no money) and what it gives; A writes, B goes back. */\nfunction updateSongs() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.back); go('hub'); return; }\n  if (pressed(A)) writeSongsNow();\n}\nfunction writeSongsNow() {\n  if (state !== 'songs' || tour.actions >= TUNE.weeks) return;\n  const r = writeSongs(tour);\n  act = { kind: 'songs', week: tour.week, ...r, line: rndi(0, SONG_LINES.length - 1) };\n  tour.pop = r.pop; tour.fresh = r.fresh; tour.songs++; tour.actions++; tour.week++;\n  go('songResult');                                                 // (its jingle starts with the screen)\n}\n\n/** Travel: pick one of the other four cities on the map, A pays the fare and goes, B goes back. */\nfunction updateTravel() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.back); go('hub'); return; }\n  travelSel = mapMove(otherCities(), travelSel);\n  if (pressed(A)) { if (canTravel(tour.cash)) travelNow(travelSel); else fx(SFX.refuse); }\n}\nfunction travelNow(dest) {\n  if (state !== 'travel' || tour.actions >= TUNE.weeks || dest === tour.city || !canTravel(tour.cash)) return;\n  act = { kind: 'travel', week: tour.week, from: tour.city, to: dest, fare: TUNE.fare, cashBefore: tour.cash, cash: tour.cash - TUNE.fare };\n  tour.cash -= TUNE.fare; tour.spent += TUNE.fare; tour.city = dest; plan.venue = 0; tour.trips++; tour.actions++; tour.week++;\n  go('travelResult'); fx(SFX.horn);\n}\n\n/** The venue picker: UP/DOWN choose a room, A takes it if the rent can be paid, B goes back. */\nfunction updateVenue() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.back); go('hub'); return; }\n  const n = city().venues.length;\n  if (pressed(UP)) { venueSel = (venueSel + n - 1) % n; fx(SFX.move); }\n  if (pressed(DOWN)) { venueSel = (venueSel + 1) % n; fx(SFX.move); }\n  if (!pressed(A)) return;\n  if (city().venues[venueSel].rent > tour.cash) { fx(SFX.refuse); return; }\n  fx(SFX.select);\n  plan.venue = venueSel; plan.row = 0; plan.ad = Math.min(plan.ad, maxAd(tour.cash, venue().rent));\n  go('setup');\n}\n\n/** Concert setup: UP/DOWN pick price or advertising, LEFT/RIGHT change by one step, L/R by a big step. */\nfunction updateSetup() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (pressed(B)) { fx(SFX.back); go('venue'); return; }\n  if (pressed(UP) || pressed(DOWN)) { plan.row ^= 1; fx(SFX.move); }\n  const dir = (btnp(RIGHT) || btnp(R) ? 1 : 0) - (btnp(LEFT) || btnp(L) ? 1 : 0), big = btnp(L) || btnp(R);\n  if (dir) {\n    const before = plan.row === 0 ? plan.price : plan.ad;\n    if (plan.row === 0) plan.price = clamp(plan.price + dir * (big ? TUNE.priceBig : TUNE.priceStep), TUNE.priceMin, TUNE.priceMax);\n    else plan.ad = clamp(plan.ad + dir * (big ? TUNE.adBig : TUNE.adStep), 0, maxAd(tour.cash, venue().rent));\n    if ((plan.row === 0 ? plan.price : plan.ad) !== before) fx(SFX.move);\n  }\n  if (pressed(A)) {\n    if (canAfford(tour.cash, venue(), plan.ad)) playConcert(); else fx(SFX.refuse);\n  }\n}\n\n/** Confirm the concert: pay, sell, update the band and the week. The state changes at once, so a second press cannot repeat it. */\nfunction playConcert() {\n  if (state !== 'setup' || tour.actions >= TUNE.weeks) return;\n  const s = { cash: tour.cash, pop: tour.pop, fresh: tour.fresh, fatigue: tour.fatigue[tour.city] };\n  show = settle(s, city(), venue(), plan.price, plan.ad, rndi(TUNE.rollMin, TUNE.rollMax));\n  show.week = tour.week; show.venue = venue().name;\n  tour.cash = show.cash; tour.pop = show.pop; tour.fresh = show.fresh; tour.fatigue[tour.city] = show.fatigue;\n  tour.concerts++; tour.best = Math.max(tour.best, show.net); tour.actions++; tour.week++;\n  tour.tickets += show.att; tour.earned += show.revenue; tour.spent += show.rent + show.ad;\n  go('show'); fx(SFX.roll);\n}\n\n/** The concert cutscene (placeholder crowd, art in Phase 5): the show is already settled; this only presents it. START pauses,\n *  A or B skips (after 10 frames, so the press that confirmed the show cannot skip it), and it ends by itself after SHOW_LEN frames. */\nconst SHOW_LEN = 200;\n/** The sounds of a concert's result: a fanfare for a full house, otherwise coins or a sad slide; and a cheer from the crowd if it was big. */\nfunction resultCue(r) {\n  fx(r.att >= r.capacity ? SFX.soldout : r.net >= 0 ? SFX.coin : SFX.loss);\n  if (r.att < r.capacity && r.att * 100 >= r.capacity * 75) fx(SFX.cheer);\n}\nfunction updateShow() {\n  if (pressed(START)) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (timer >= SHOW_LEN || (timer >= 10 && (pressed(A) || pressed(B)))) { go('result'); resultCue(show); }\n}\n\n/** After any action's results screen: A (not in the first 20 frames) goes on to the next week, or to the end after week 10. */\nfunction updateResult() {\n  if (pressed(START) && timer > 20) { paused = true; pauseSel = 0; fx(SFX.pause); return; }\n  if (timer < 20 || !pressed(A)) return;\n  fx(SFX.select);\n  if (tour.week > TUNE.weeks) toFinal(); else go('hub');\n}\n\nfunction toFinal() { go('final'); }                                      // the victory or the defeat song starts with the screen\n\n/** After the tour: the cash is the score. A top-10 cash asks for initials. */\nfunction updateFinal() {\n  if (timer < 40 || !(pressed(A) || pressed(START))) return;\n  fx(SFX.select);\n  rank = insertTop({ score: tour.cash, initials: lastInitials(), trips: tour.trips, concerts: tour.concerts });\n  if (rank >= 0) { go('initials'); initials = { chars: lastInitials().split(''), pos: 0 }; fx(SFX.record); }\n  else toTitle();\n}\n\n/** UP/DOWN pick a letter, LEFT/RIGHT (or A and B) move, START saves (as does A on the last letter). */\nfunction updateInitials() {\n  const ini = initials, k = LETTERS.indexOf(ini.chars[ini.pos]);\n  if (pressed(UP)) { ini.chars[ini.pos] = LETTERS[(k + 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(DOWN)) { ini.chars[ini.pos] = LETTERS[(k + LETTERS.length - 1) % LETTERS.length]; fx(SFX.move); }\n  if (pressed(LEFT) || pressed(B)) ini.pos = Math.max(0, ini.pos - 1);\n  if (pressed(RIGHT)) ini.pos = Math.min(2, ini.pos + 1);\n  const done = pressed(START) || (pressed(A) && ini.pos === 2);\n  if (pressed(A) && ini.pos < 2) ini.pos++;\n  if (!done || timer < 20) return;\n  const v = packInitials(ini.chars.join(''));\n  dset(INITIALS_SLOT, v); dset(TOP_SLOT + rank * ENTRY + 1, v);\n  fx(SFX.select);\n  go('records'); hl = rank;\n}\n\nfunction updateRecords() {\n  if ((pressed(START) || pressed(A) || pressed(B)) && timer > 20) { fx(SFX.select); toTitle(); }\n}\n\nconst PAUSE_ITEMS = ['RESUME', 'HOW TO PLAY', 'RESTART', 'QUIT TO TITLE'];\n/** The pause menu. RESTART and QUIT ask first (default NO): they throw the tour away, and a double press must not do it. */\nfunction updatePause() {\n  if (pauseAsk >= 0) {\n    if (pressed(UP) || pressed(DOWN)) { askSel ^= 1; fx(SFX.move); }\n    if (pressed(B)) { pauseAsk = -1; fx(SFX.back); return; }\n    if (!pressed(A)) return;\n    fx(SFX.select);\n    const yes = askSel === 1, what = pauseAsk; pauseAsk = -1;\n    if (yes) { if (what === 2) startTour(); else toTitle(); } // quitting abandons the tour: nothing is recorded\n    return;\n  }\n  const n = PAUSE_ITEMS.length;\n  if (pressed(UP)) { pauseSel = (pauseSel + n - 1) % n; fx(SFX.move); }\n  if (pressed(DOWN)) { pauseSel = (pauseSel + 1) % n; fx(SFX.move); }\n  if (pressed(B) || (pressed(START) && pauseSel === 0)) { paused = false; fx(SFX.pause); }\n  else if (pressed(A) || pressed(START)) {\n    fx(SFX.select);\n    if (pauseSel === 0) paused = false;\n    else if (pauseSel === 1) { helpOpen = true; helpPage = 0; }\n    else { pauseAsk = pauseSel; askSel = 0; }\n  }\n}\n\n// --- Draw ---\n\n/** A named sprite at (x, y): its picture, size and palette come from ART.sprites (made by art.py). */\nfunction sp(name, x, y, opts = {}) {\n  const s = ART.sprites[name];\n  // sprites are under the overlay, but a sprite that pokes out of the pause menu's panel or the help would show: leave it out while those are up\n  if (helpOpen || (paused && x < 232 && x + s.size > 24 && y < 168 && y + s.size > 64)) return;\n  spr(s.tile, Math.round(x), Math.round(y), { size: s.size, pal: s.pal, prio: 3, ...opts });\n}\n/** The frame (0 or 1) of an idle animation; k gives each figure its own beat. */\nconst beat = (k = 0) => Math.floor((clock + k * 11) / 20) & 1;\nconst MAP_POS = ART.cityPos;\nconst VENUE_ART = ['bar', 'theatre', 'arena'];\n\n// The backdrops. Each screen has a scene (made by art.py, in ART.scenes) on BG0; the concert also has the crowd on BG1.\n// The hub's city colours: the horizon, the ground, the buildings and the neon of the night palette, as hex.\nconst CITY_TINT = [['5a3c58', '2a1c1c', '1a0e10', 'ff8040'], ['9a5060', '3a2418', '2a1410', 'ffb030'], ['24485a', '10281c', '0a1a14', '80e0a0'],\n  ['382c6e', '1a1030', '120c28', 'ff60c0'], ['3c5aa0', '1c3c78', '141a44', '60e0ff']];\nconst TINT_ROLES = ['t_s3', 't_ground', 't_bld', 't_roof'];\nlet tinted = -1;\nfunction tintCity(i) {\n  if (i === tinted) return;\n  tinted = i;\n  CITY_TINT[i].forEach((h, k) => color(ART.colors[TINT_ROLES[k]], parseInt(h.slice(0, 2), 16) >> 3, parseInt(h.slice(2, 4), 16) >> 3, parseInt(h.slice(4, 6), 16) >> 3));\n}\nfunction scene(name, layer = 0) { const s = ART.scenes[name]; bg(layer, { mx: s.mx, my: s.my, mw: s.w, mh: s.h, x: 0, y: 0, wrap: false, show: true }); }\n/** The stage lights flicker by changing palette entries (the picture stays): neon, a spotlight, three coloured beams. */\nconst LIGHT_SETS = [[['c3a', 'ff60c0', '8a3470'], ['c3b', '60c8ff', '3a6a8a']], [['c4a', '7a6a58', 'a89878']], [['c5a', 'ff6080', '60c8ff', '70e070'], ['c5b', '60c8ff', '70e070', 'ff6080'], ['c5c', '70e070', 'ff6080', '60c8ff']]];\nfunction setColor(k, h) { color(ART.colors[k], parseInt(h.slice(0, 2), 16) >> 3, parseInt(h.slice(2, 4), 16) >> 3, parseInt(h.slice(4, 6), 16) >> 3); }\nfunction flicker(v) {\n  LIGHT_SETS[v].forEach(([k, ...cols], i) => setColor(k, cols[v === 2 ? (clock / 20 | 0) % 3 : v === 1 ? (clock / 40 | 0) & 1 : ((clock / 12 | 0) + i) & 1]));\n}\n/** The crowd: 48 heads in 3 rows of 16 on BG0, copied from the crowd kit scene. `heads` of them are there; the arms wave faster in a bigger crowd. */\nconst CROWD = { x: 192, y: 40 };\nfunction crowd(heads, occ) {\n  const kit = ART.scenes.crowdkit;\n  const wave = occ >= 0.75 ? 3 : occ >= 0.45 ? 2 : 1;\n  for (let s = 0; s < 48; s++) {\n    const cx = (s % 16) * 2, cy = Math.floor(s / 16) * 2, v = (s * 5 + (s >> 4) * 3) % 4, on = (s * 29 + 7) % 48 < heads, up = on && (((clock >> 3) + s) % 4) < wave ? 1 : 0;\n    for (let j = 0; j < 2; j++) for (let i = 0; i < 2; i++) mset(CROWD.x + cx + i, CROWD.y + cy + j, on ? mget(kit.mx + (v * 2 + up) * 2 + i, kit.my + j) : 0);\n  }\n  bg(0, { mx: CROWD.x, my: CROWD.y, mw: 32, mh: 6, x: 0, y: -120, wrap: false, show: true });   // BG0 is the front layer: the crowd stands in front of the stage on BG1\n}\n/** Which scene is behind the current screen. */\nfunction drawBackdrop() {\n  const show1 = state === 'show';\n  if (!show1) bg(1, { show: false }); // (the concert is the one screen with two layers: the stage on BG1 behind the crowd on BG0)\n  if (state === 'title') { tintCity(3); scene('title'); }\n  else if (state === 'intro') scene('intro' + introPage);\n  else if (state === 'cityStart' || state === 'travel') scene('map');\n  else if (show1) { scene('stage' + plan.venue, 1); flicker(plan.venue); }\n  else if (tour && (state === 'hub' || state === 'venue' || state === 'setup' || state === 'songs')) { tintCity(tour.city); scene('hub' + tour.city); }\n  else scene('ledger');\n}\n\nfunction draw() {\n  cls();\n  drawBackdrop();\n  if (state === 'title') drawTitle();\n  else if (state === 'intro') drawIntro();\n  else if (state === 'cityStart') drawCityStart();\n  else if (state === 'show') drawShow();\n  else if (state === 'hub') drawHub();\n  else if (state === 'venue') drawVenue();\n  else if (state === 'setup') drawSetup();\n  else if (state === 'result') drawResult();\n  else if (state === 'songs') drawSongs();\n  else if (state === 'songResult') drawSongResult();\n  else if (state === 'travel') drawTravel();\n  else if (state === 'travelResult') drawTravelResult();\n  else if (state === 'final') drawFinal();\n  else if (state === 'initials') drawInitials();\n  else if (state === 'records') drawRecords();\n  if (paused) drawPause();\n  if (helpOpen) drawHelp();\n}\n\n/** The band and the van on the road, as on the title and the hub. */\nfunction drawRoadCrew(y) {\n  sp('van' + beat(5), 12, y); sp('dot' + beat(1), 84, y); sp('zorp' + beat(2), 120, y); sp('spike' + beat(3), 156, y);\n}\n\nfunction drawTitle() {\n  drawRoadCrew(182);\n  panel(64, 96, 128, 66);\n  TITLE_ITEMS.forEach((t, i) => txt(`${i === titleSel ? '> ' : '  '}${t}`, 76, 104 + i * 14, i === titleSel ? GOLD : WHITE));\n  ctxt('RAISE $5,000 IN 10 WEEKS', 172, WHITE);\n}\n\n/** The intro: a painted panel (the room, the landlord at the door, the road at dawn) with its cast, above three lines of story. */\nfunction drawIntro() {\n  const [head, lines] = INTRO_PANELS[introPage];\n  rectfill(8, 8, 240, 20, SHADOW); rect(8, 8, 240, 20, PANEL);\n  ctxt(`${head}  ${introPage + 1}/${INTRO_PANELS.length}`, 14, GOLD);\n  if (introPage === 0) { sp('dot' + beat(1), 76, 84); sp('zorp' + beat(2), 112, 84); sp('spike' + beat(3), 148, 84); }\n  else if (introPage === 1) { sp('dot' + beat(1), 70, 84); sp('grubb' + (beat(4) && clock % 40 < 20 ? 1 : 0), 146, 84, { fx: true }); }\n  else {\n    sp('van' + (clock >> 3 & 1), 112, 84);\n    for (let i = 0; i < 4; i++) sp('spark' + ((clock >> 2) + i) % 4, 104 - i * 12 - ((clock * 2) % 12), 106 - (i & 1) * 4);     // the exhaust\n  }\n  rectfill(8, 124, 240, 92, SHADOW); rect(8, 124, 240, 92, PANEL);\n  lines.forEach((l, i) => ctxt(l, 140 + i * 14, WHITE));\n  ctxt(introPage + 1 < INTRO_PANELS.length ? 'A: NEXT   START: SKIP' : 'A: HIT THE ROAD', 198, DIM);\n}\n\n/** The map: the five cities as little landmarks on the continent, joined by a dashed road; the road crawls toward the highlighted city. */\nfunction drawMap(selectable, sel, here, header) {\n  ctxt(header, 8, GOLD);\n  for (let k = 0; k + 1 < CITIES.length; k++) {\n    const [x0, y0] = MAP_POS[k], [x1, y1] = MAP_POS[k + 1], n = Math.floor(Math.hypot(x1 - x0, y1 - y0));\n    for (let t = 0; t < n; t += 1) if (((t + (clock >> 3)) % 6) < 3) pset(Math.round(x0 + (x1 - x0) * t / n), Math.round(y0 + (y1 - y0) * t / n), WHITE);\n  }\n  CITIES.forEach((c, i) => {\n    const [x, y] = MAP_POS[i], on = i === sel;\n    sp('city' + i, x - 8, y - 8);\n    if (on) sp('ring' + (clock >> 4 & 1), x - 8, y - 8);\n    txt(c.name, clamp(x - c.name.length * 4, 4, 252 - c.name.length * 8), y + 10, on ? GOLD : i === here ? CYAN : WHITE);\n  });\n  if (here >= 0) txt('YOU', MAP_POS[here][0] - 12, MAP_POS[here][1] - 20, CYAN);\n}\n/** What the highlighted city is like, under the map. */\nfunction drawCityCard(ci) {\n  const c = CITIES[ci];\n  panel(8, 124, 240, 92);\n  ctxt(c.name, 130, GOLD);\n  ctxt(`CROWD ${c.crowd}  ROOMS ${c.rooms}`, 146, WHITE);\n  ctxt(`RIVALS ${c.rivals}  FANS ${fansWord(tour.fatigue[ci])}`, 158, WHITE);\n}\nfunction drawCityStart() {\n  drawMap(CITIES.map((_, i) => i), mapSel, -1, 'WHERE DOES THE TOUR START?');\n  drawCityCard(mapSel);\n  ctxt('NO FARE AND NO WEEK USED', 176, DIM);\n  ctxt('A: START HERE   B: BACK', 194, WHITE);\n}\n\n/** The line of figures at the top of every tour screen. */\nfunction drawStatus() {\n  panel(8, 8, 240, 44);\n  txt(`WEEK ${two(Math.min(tour.week, TUNE.weeks))}/${TUNE.weeks}`, 16, 14, WHITE);\n  rtxt(`CASH ${money(tour.cash)}`, 240, 14, isWin(tour.cash) ? GREEN : WHITE);\n  txt(`CITY: ${city().name}`, 16, 26, WHITE);\n  rtxt(`POP ${tour.pop}`, 240, 26, WHITE);\n  txt(`FRESHNESS: ${tour.fresh}`, 16, 38, WHITE);\n  rtxt(`GOAL ${money(TUNE.goal)}`, 240, 38, GOLD);\n}\n/** A panel with windows cut in it, so that sprites drawn under it (the venues, the band) show through. */\nfunction holePanel(x, y, w, h, holes) {\n  panel(x, y, w, h);\n  for (const [hx, hy, hw, hh] of holes) { rectfill(hx, hy, hw, hh, 0); rect(hx - 1, hy - 1, hw + 2, hh + 2, PANEL); }\n}\n\nfunction drawHub() {\n  drawStatus();\n  drawRoadCrew(178);\n  panel(24, 58, 208, 80);\n  const items = ['PLAY A CONCERT', 'WRITE NEW SONGS', `TRAVEL (${money(TUNE.fare)})`], ok = hubOk();\n  items.forEach((t, i) => txt(`${i === hubSel ? '> ' : '  '}${t}`, 40, 66 + i * 14, !ok[i] ? DIM : i === hubSel ? GOLD : WHITE));\n  if (!ok[hubSel]) {\n    ctxt(hubSel === 0 ? `NEED ${money(cheapestRent())} FOR ANY ROOM` : `NEED ${money(TUNE.fare)} FOR THE BUS`, 114, RED);\n  } else {\n    const c = city();\n    ctxt(`CROWD ${c.crowd}  ROOMS ${c.rooms}`, 110, DIM);\n    ctxt(`RIVALS ${c.rivals}  FANS ${fansWord(tour.fatigue[tour.city])}`, 122, DIM);\n  }\n  ctxt('A: SELECT   START: PAUSE', 214, WHITE);\n}\n\nfunction drawVenue() {\n  drawStatus();\n  const rows = city().venues.map((_, i) => 62 + i * 46);\n  holePanel(8, 56, 240, 152, rows.map((y) => [16, y + 4, 32, 32]));\n  city().venues.forEach((v, i) => {\n    const y = rows[i], on = i === venueSel, ok = v.rent <= tour.cash, c = !ok ? DIM : on ? GOLD : WHITE;\n    sp(VENUE_ART[i], 16, y + 4);\n    txt(`${on ? '> ' : '  '}${v.name}`, 52, y + 6, c);\n    if (!ok) rtxt(`NEED ${money(v.rent - tour.cash)}`, 240, y + 6, RED);\n    txt(`ROOM FOR ${v.capacity}`, 56, y + 20, c); rtxt(`RENT ${money(v.rent)}`, 240, y + 20, c);\n  });\n  ctxt('A: PICK  B: BACK', 194, WHITE);\n}\n\nfunction drawSetup() {\n  const v = venue(), after = tour.cash - v.rent - plan.ad, ok = canAfford(tour.cash, v, plan.ad);\n  drawStatus();\n  holePanel(8, 56, 240, 154, [[16, 62, 32, 32]]);\n  sp(VENUE_ART[plan.venue], 16, 62);\n  txt(v.name, 56, 68, GOLD);\n  txt(`ROOM FOR ${v.capacity}   RENT ${money(v.rent)}`, 56, 82, WHITE);\n  txt(`${plan.row === 0 ? '> ' : '  '}TICKET PRICE`, 20, 104, plan.row === 0 ? GOLD : WHITE);\n  rtxt(`< ${money(plan.price)} >`, 236, 104, plan.row === 0 ? GOLD : WHITE);\n  txt(`${plan.row === 1 ? '> ' : '  '}ADVERTISING`, 20, 118, plan.row === 1 ? GOLD : WHITE);\n  rtxt(`< ${money(plan.ad)} >`, 236, 118, plan.row === 1 ? GOLD : WHITE);\n  txt('UPFRONT COST', 20, 136, WHITE); rtxt(money(v.rent + plan.ad), 236, 136, WHITE);\n  txt('CASH AFTER', 20, 148, WHITE); rtxt(ok ? money(after) : `NEED ${money(-after)} MORE`, 236, 148, ok ? WHITE : RED);\n  const f = forecast(city(), v, plan.price, plan.ad, tour.pop, tour.fresh, tour.fatigue[tour.city]);\n  txt('CROWD FORECAST', 20, 162, WHITE); rtxt(f, 236, 162, f === 'LOW' ? RED : f === 'FAIR' ? GOLD : GREEN);\n  ctxt(`THIS USES WEEK ${tour.week} OF ${TUNE.weeks}`, 180, DIM);\n  ctxt(ok ? 'A: PLAY  B: BACK  L/R: BIG' : \"CAN'T PAY: B TO GO BACK\", 194, ok ? WHITE : RED);\n}\n\n/** The concert cutscene: the band on the venue's stage (the backdrop flickers with its lights), the crowd filling up to the turnout. */\nfunction drawShow() {\n  const r = show, occ = r.att / r.capacity, prog = Math.min(1, timer / 120), heads = Math.round(48 * occ * prog);\n  sp('zorp' + beat(1), 52, 72); sp('dot' + beat(0), 112, 68 + (beat(0) ? -2 : 0)); sp('spike' + beat(2), 172, 72);\n  crowd(heads, occ);\n  if (timer >= 10 && timer % 60 < 40) txt('A: SKIP', 200, 8, WHITE);\n  panel(8, 176, 240, 40);\n  ctxt(`LIVE AT ${r.venue}`, 182, GOLD);\n  ctxt(`${Math.floor(r.att * prog)} OF ${r.capacity} CAME`, 194, WHITE);\n  if (timer >= 130 && (timer < 150 || timer % 40 < 28)) ctxt(crowdVerdict(Math.floor(occ * 100)), 206, occ >= 0.45 ? GOLD : DIM);\n}\n\n// The result screens sit on the ledger backdrop with only text over it: the margins (28 pixels each side) are for the coins, clouds and stars.\nconst ML = 28, MR = 228;\n/** A line of a results screen: a label on the left, a value on the right. */\nfunction row(label, value, y, c = WHITE) { txt(label, ML, y, c); rtxt(value, MR, y, c); }\n/** n coins falling in the side margins, each turning. */\nfunction coinRain(n) {\n  for (let i = 0; i < n; i++) sp('coin' + (((clock >> 2) + i) & 3), i % 2 ? 236 - (i * 5) % 10 : 4 + (i * 7) % 10, ((clock * 2 + i * 41) % 240) - 16);\n}\n/** A rain cloud in each top corner. */\nfunction rainClouds() { sp('cloud' + (clock >> 3 & 1), 4, 4); sp('cloud' + (clock >> 3 & 1), 236, 4); }\nfunction continueLine() { if (timer >= 20) ctxt(tour.week > TUNE.weeks ? 'A: SEE THE FINAL TALLY' : `A: ON TO WEEK ${tour.week}`, 204, WHITE); }\n\nfunction drawResult() {\n  const r = show, full = r.att >= r.capacity;\n  if (r.net > 0) coinRain(Math.min(10, 2 + Math.floor(r.net / 100))); else if (r.net < 0) rainClouds();\n  if (full) { sp('star', 8, 40 + (clock >> 4 & 1) * 2); sp('star', 232, 40 + (clock >> 4 & 1) * 2); sp('spark' + (clock >> 2 & 3), 120, 44 - (clock >> 3 & 1)); }\n  ctxt(`WEEK ${r.week} CONCERT`, 14, GOLD);\n  ctxt(full ? `SOLD OUT! ${r.att} CAME` : `${r.att} OF ${r.capacity} CAME`, 28, full ? GOLD : WHITE);\n  rect(ML, 40, MR - ML, 6, PANEL); rectfill(ML + 1, 41, Math.floor((MR - ML - 2) * r.att / r.capacity), 4, full ? GOLD : CYAN);\n  row(`TICKETS ${r.att} X ${money(r.price)}`, money(r.revenue), 56);\n  row('VENUE RENT', signed(-r.rent), 70);\n  row('ADVERTISING', signed(-r.ad), 84);\n  row('NET', signed(r.net), 102, r.net >= 0 ? GREEN : RED);\n  row('CASH NOW', money(r.cash), 116);\n  row('POPULARITY', `${r.popBefore} > ${r.pop} (${r.popChange >= 0 ? '+' : ''}${r.popChange})`, 138, r.popChange >= 0 ? WHITE : RED);\n  row('FRESHNESS', `${r.freshBefore} > ${r.fresh}`, 152);\n  ctxt(r.note, 176, CYAN);\n  continueLine();\n}\n\nfunction drawSongs() {\n  const r = writeSongs(tour);\n  drawStatus();\n  holePanel(8, 56, 240, 154, [[76, 60, 108, 36]]);\n  sp('zorp' + beat(1), 78, 62); sp('dot' + beat(0), 112, 62); sp('spike' + beat(2), 146, 62);\n  ctxt('WRITE NEW SONGS', 100, GOLD);\n  ctxt('A WEEK IN THE REHEARSAL ROOM', 112, DIM);\n  row('FRESHNESS', `${r.freshBefore} > ${r.fresh}`, 128);\n  row('POPULARITY', `${r.popBefore} > ${r.pop}`, 140);\n  row('COST', `${money(0)} AND A WEEK`, 156);\n  row('INCOME THIS WEEK', money(0), 168, RED);\n  ctxt(`THIS USES WEEK ${tour.week} OF ${TUNE.weeks}`, 182, DIM);\n  ctxt('A: WRITE   B: BACK', 196, WHITE);\n}\n\nfunction drawSongResult() {\n  const r = act;\n  for (let i = 0; i < 6; i++) sp('spark' + (((clock >> 2) + i) & 3), i % 2 ? 236 : 8, 30 + i * 30 + ((clock >> 3) + i & 1) * 3);\n  sp('dot' + beat(0), 12, 184); sp('zorp' + beat(1), 212, 184);\n  ctxt(`WEEK ${r.week} NEW SONGS`, 14, GOLD);\n  ctxt(SONG_LINES[r.line], 32, CYAN);\n  row('FRESHNESS', `${r.freshBefore} > ${r.fresh}`, 64);\n  row('POPULARITY', `${r.popBefore} > ${r.pop} (+${r.popChange})`, 78);\n  row('TICKETS SOLD', '0', 106);\n  row('INCOME', money(0), 120);\n  row('CASH NOW', money(tour.cash), 134);\n  ctxt('NO MONEY THIS WEEK, BUT', 160, DIM);\n  ctxt('NEXT CROWD WILL BE BIGGER', 172, DIM);\n  if (timer >= 20) ctxt(tour.week > TUNE.weeks ? 'A: SEE THE FINAL TALLY' : `A: ON TO WEEK ${tour.week}`, 204, WHITE);\n}\n\nfunction drawTravel() {\n  drawMap(otherCities(), travelSel, tour.city, `WHERE TO?  ${money(TUNE.fare)} AND A WEEK`);\n  drawCityCard(travelSel);\n  const ok = canTravel(tour.cash);\n  ctxt(ok ? `CASH ${money(tour.cash)} > ${money(tour.cash - TUNE.fare)}` : `NEED ${money(TUNE.fare)} FOR THE BUS`, 170, ok ? DIM : RED);\n  if (ok) ctxt(`THIS USES WEEK ${tour.week} OF ${TUNE.weeks}`, 182, DIM);\n  ctxt('A: GO   B: BACK', 194, WHITE);\n}\n\nfunction drawTravelResult() {\n  const r = act, c = CITIES[r.to];\n  ctxt(`WEEK ${r.week} ON THE ROAD`, 14, GOLD);\n  ctxt(`${CITIES[r.from].name} > ${c.name}`.slice(0, 28), 32, WHITE);\n  ctxt(ARRIVE_LINES[r.to], 48, CYAN);\n  row('BUS FARE', signed(-r.fare), 76);\n  row('CASH NOW', money(r.cash), 90);\n  row('CONCERT THIS WEEK', 'NONE', 112, DIM);\n  sp('city' + r.to, 120, 128);\n  ctxt(`CROWD ${c.crowd}  ROOMS ${c.rooms}`, 150, DIM);\n  ctxt(`RIVALS ${c.rivals}  FANS ${fansWord(tour.fatigue[r.to])}`, 162, DIM);\n  rectfill(0, 199, 256, 1, PANEL);\n  sp('van' + (clock >> 3 & 1), ((timer * 2) % 320) - 32, 170);                                    // the van drives across the screen\n  continueLine();\n}\n\nfunction drawFinal() {\n  const win = isWin(tour.cash), at = rankOf({ score: tour.cash, trips: tour.trips, concerts: tour.concerts });\n  if (win) { coinRain(12); sp('star', 8, 60); sp('star', 232, 60); sp('bag', 120, 76 + (clock >> 4 & 1)); sp('spark' + (clock >> 2 & 3), 104, 82); sp('spark' + ((clock >> 2) + 2 & 3), 136, 84); }\n  else rainClouds();\n  ctxt(win ? 'YOU DID IT!' : 'TOUR OVER', 16, win ? GREEN : RED);\n  ctxt('FINAL CASH', 34, DIM);\n  ctxt(money(tour.cash), 46, win ? GREEN : WHITE);\n  ctxt(win ? `${money(tour.cash - TUNE.goal)} OVER THE GOAL` : `${money(TUNE.goal - tour.cash)} SHORT OF ${money(TUNE.goal)}`, 62, win ? GOLD : RED);\n  row('CONCERTS', String(tour.concerts), 94); row('SONGS', String(tour.songs), 106); row('TRIPS', String(tour.trips), 118);\n  row('TICKETS SOLD', String(tour.tickets), 134); row('TICKET SALES', money(tour.earned), 146);\n  row('RENT, ADS, FARES', money(tour.spent), 158);\n  row('BEST NIGHT', signed(tour.best), 172); row('POPULARITY', String(tour.pop), 184);\n  ctxt(at >= 0 ? `TOP 10 PLACE: #${at + 1}` : 'NOT IN THE TOP 10', 198, at >= 0 ? GOLD : DIM);\n  if (timer >= 40 && timer % 60 < 40) ctxt('A: CONTINUE', 208, WHITE);\n}\n\nfunction drawRecords() {\n  panel(24, 16, 208, 192);\n  ctxt('TOP 10 BY FINAL CASH', 24, GOLD);\n  topTen().forEach((e, i) => {\n    const y = 48 + i * 14, on = i === hl;\n    if (on && timer % 40 < 30) rectfill(28, y - 2, 200, 12, PANEL);\n    txt(String(i + 1).padStart(2), 40, y, i === 0 ? GOLD : DIM);\n    txt(e.score ? e.initials : '---', 72, y, on ? GOLD : WHITE);\n    if (e.score) { rtxt(money(e.score), 168, y, i === 0 ? GOLD : WHITE); rtxt(`${e.concerts}C ${e.trips}T`, 224, y, DIM); }\n  });\n  ctxt('TIE: FEWER TRIPS, CONCERTS', 190, DIM);\n  if (timer % 60 < 40) ctxt('START: BACK', 200, DIM);\n}\n\nfunction drawInitials() {\n  const ini = initials;\n  panel(24, 40, 208, 144);\n  ctxt(rank === 0 ? 'NEW HIGH SCORE!' : `TOP 10: #${rank + 1}`, 52, GOLD);\n  ctxt(money(tour.cash), 68, WHITE);\n  ctxt('ENTER YOUR INITIALS', 90, DIM);\n  for (let i = 0; i < 3; i++) {\n    const on = i === ini.pos, x = 84 + i * 32;\n    rect(x - 2, 106, 28, 20, on ? GOLD : PANEL);\n    txt(ini.chars[i], x + 10, 112, on ? GOLD : WHITE);\n  }\n  if (timer % 60 < 40) ctxt('START: SAVE', 160, WHITE);\n}\n\nfunction drawPause() {\n  panel(24, 64, 208, 104);\n  if (pauseAsk >= 0) {\n    ctxt(pauseAsk === 2 ? 'RESTART THE TOUR?' : 'QUIT TO THE TITLE?', 74, GOLD);\n    ctxt('THIS TOUR WILL BE LOST', 90, DIM);\n    ['NO, KEEP PLAYING', 'YES, DO IT'].forEach((t, i) => txt(`${i === askSel ? '>' : ' '} ${t}`, 64, 116 + i * 14, i === askSel ? GOLD : WHITE));\n    return;\n  }\n  ctxt('PAUSED', 74, GOLD);\n  PAUSE_ITEMS.forEach((t, i) => txt(`${i === pauseSel ? '>' : ' '} ${t}`, 64, 94 + i * 14, i === pauseSel ? GOLD : WHITE));\n}\n\n/** The help pages, over whatever is behind them. */\nfunction drawHelp() {\n  const [head, lines] = HELP_PAGES[helpPage];\n  panel(8, 8, 240, 208);\n  ctxt(`${head}  ${helpPage + 1}/${HELP_PAGES.length}`, 20, GOLD);\n  lines.forEach((l, i) => txt(l, 20, 46 + i * 12, WHITE));\n  ctxt('LEFT/RIGHT: PAGE   B: CLOSE', 198, DIM);\n}\n\nfunction panel(x, y, w, h) { rectfill(x, y, w, h, SHADOW); rect(x, y, w, h, PANEL); }\nfunction txt(s, x, y, c) { print(s, x + 1, y + 1, SHADOW); print(s, x, y, c); }\nconst ctxt = (s, y, c) => txt(s, 128 - s.length * 4, y, c);\nconst rtxt = (s, right, y, c) => txt(s, right - s.length * 8, y, c);\n",

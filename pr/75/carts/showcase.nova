{
  "format": "nova16-cart",
  "version": 2,
  "meta": {
    "title": "Showcase",
    "author": "NOVA-16",
    "description": "The art kit's SNES tools at work: two sculpted boxers in a ring, our hero seen from behind, with a receded crowd and HUD lettering, and a parallax valley under a sky gradient (LEFT and RIGHT)."
  },
  "label": "",
  "code": "// Showcase: the art kit's SNES tools, as a worked example (docs/dev/snes-picture.md, part B; the art is all in art.py).\n// LEFT and RIGHT change the page.\n//   RINGSIDE  our hero from behind, facing a sculpted boxer (big sprites) breathing in a ring, a receded crowd with camera\n//             flashes, ropes and posts, a canvas with an emblem, HUD lettering and his shadow, subtracted from the canvas\n//   VALLEY    a sky gradient set line by line, clouds, snowy mountains, hills, trees and grass on three layers that\n//             scroll at different speeds\n\n// ART (generated by art.py: do not edit)\nconst ART = {\n  tiles: {},\n  sprites: {},\n  scenes: {\"canvas\": {\"h\": 13, \"mx\": 64, \"my\": 15, \"pal\": 3, \"w\": 32}, \"crowd\": {\"h\": 14, \"mx\": 0, \"my\": 0, \"pal\": 1, \"w\": 32}, \"far\": {\"h\": 20, \"mx\": 96, \"my\": 0, \"pal\": 4, \"w\": 32}, \"mid\": {\"h\": 28, \"mx\": 128, \"my\": 0, \"pal\": 5, \"w\": 32}, \"near\": {\"h\": 28, \"mx\": 160, \"my\": 0, \"pal\": 6, \"w\": 32}, \"ring\": {\"h\": 20, \"mx\": 32, \"my\": 0, \"pal\": 2, \"w\": 32}},\n  colors: {\"GOLD\": 114, \"INK\": 115, \"WHITE\": 113},\n  big: {\"bar\": {\"h\": 10, \"parts\": [[0, 0, 904, 16, 2, 0], [16, 0, 906, 16, 2, 0], [32, 0, 906, 16, 2, 0], [48, 0, 906, 16, 2, 0], [64, 0, 906, 16, 2, 0], [80, 0, 904, 16, 2, 1]], \"w\": 96}, \"boxerLegs\": {\"h\": 48, \"parts\": [[16, 0, 682, 16, 1, 0], [32, 0, 708, 16, 1, 0], [48, 0, 639, 8, 1, 0], [48, 8, 710, 8, 1, 0], [32, 16, 711, 8, 1, 0], [16, 32, 712, 16, 1, 0], [32, 32, 714, 16, 1, 0], [48, 32, 716, 8, 1, 0], [48, 40, 717, 8, 1, 0], [16, 8, 626, 8, 0, 0], [24, 8, 627, 8, 0, 0], [16, 16, 680, 16, 0, 0], [32, 0, 704, 32, 0, 0], [16, 32, 634, 8, 0, 0], [24, 32, 635, 8, 0, 0], [32, 32, 636, 8, 0, 0], [40, 32, 637, 8, 0, 0], [48, 32, 638, 8, 0, 0]], \"w\": 72}, \"boxerTop\": {\"h\": 64, \"parts\": [[8, 24, 619, 8, 1, 0], [16, 24, 620, 8, 1, 0], [24, 24, 621, 8, 1, 0], [40, 24, 622, 8, 1, 0], [48, 24, 623, 8, 1, 0], [56, 24, 624, 8, 1, 0], [8, 32, 625, 8, 1, 0], [16, 32, 648, 16, 1, 0], [16, 48, 650, 16, 1, 0], [32, 32, 652, 32, 1, 0], [24, 0, 608, 8, 0, 0], [24, 8, 609, 8, 0, 0], [8, 24, 610, 8, 0, 0], [16, 16, 612, 16, 0, 0], [32, 0, 614, 16, 0, 0], [32, 16, 616, 16, 0, 0], [48, 24, 611, 8, 0, 0], [56, 24, 618, 8, 0, 0], [0, 32, 640, 32, 0, 0], [32, 32, 644, 32, 0, 0]], \"w\": 72}, \"hero\": {\"h\": 96, \"parts\": [[8, 24, 718, 8, 3, 0], [16, 16, 740, 16, 3, 0], [32, 0, 768, 32, 3, 0], [64, 8, 719, 8, 3, 0], [64, 16, 742, 16, 3, 0], [80, 16, 744, 16, 3, 0], [0, 32, 772, 32, 3, 0], [32, 32, 776, 32, 3, 0], [64, 32, 780, 32, 3, 0], [96, 56, 726, 8, 3, 0], [0, 64, 832, 32, 3, 0], [32, 64, 836, 32, 3, 0], [64, 64, 840, 32, 3, 0], [96, 64, 727, 8, 3, 0], [96, 72, 732, 8, 3, 0], [96, 80, 733, 8, 3, 0]], \"w\": 104}, \"round\": {\"h\": 21, \"parts\": [[0, 0, 844, 32, 2, 0], [32, 0, 896, 32, 2, 0], [64, 0, 750, 16, 2, 0], [80, 0, 734, 8, 2, 0], [80, 8, 735, 8, 2, 0], [64, 16, 900, 8, 2, 0], [72, 16, 901, 8, 2, 0], [96, 0, 902, 16, 2, 0], [96, 16, 900, 8, 2, 0], [104, 16, 900, 8, 2, 1]], \"w\": 117}, \"shadow\": {\"h\": 12, \"parts\": [[0, 0, 746, 16, 4, 0], [16, 0, 748, 16, 4, 0], [32, 0, 748, 16, 4, 1], [48, 0, 746, 16, 4, 1]], \"w\": 64}},\n  gradients: {\"sky\":{\"entry\":0,\"lines\":[19683,19683,19683,19683,19715,19715,19715,20740,20740,20740,20740,20740,20772,20772,20772,21796,21796,21796,21796,21796,21829,21829,22853,22853,22853,22853,22853,22853,22885,23909,23909,23909,23910,23910,23910,23910,24966,24966,24966,24966,24966,24966,24966,25990,26023,26023,26023,26023,26023,26023,27047,27047,27079,27079,27080,27080,27080,27080,27080,27112,27113,27113,28137,28137,28137,28169,28169,28170,28170,28170,28170,28170,28202,28202,29227,29227,29227,29227,29227,29259,29259,29260,29260,29260,29260,29260,29292,30317,30317,30317,30317,30317,30317,30349,30350,30350,30350,30350,30350,30350,31407,31407,31407,31407,31407,31408,31408,31440,31440,31440,31441,31441,31441,31441,31473,31474,31474,31474,31474,31474,31475,31507,31507,31507,31507,31508,31508,31508,31540,31540,31541,31541,31541,31541,31541,31542,31574,31574,31574,31574,31575,31575,31575,31607,31607,31608,32632,32632,32632,32632,32665],\"y0\":0}},\n};\n/** Draw one of ART.big at (x, y), its top left: opts { fx, fy (flip the whole sprite), prio (default 3), pal (every\n * part in this sprite palette, e.g. a hit flash) }. Each part is one spr() (generated by art.py). */\nfunction bigSprite(b, x, y, opts = {}) {\n  const fx = !!opts.fx, fy = !!opts.fy, prio = opts.prio ?? 3;\n  for (const [dx, dy, t, size, pal, f] of b.parts) {\n    spr(t, x + (fx ? b.w - dx - size : dx), y + (fy ? b.h - dy - size : dy),\n      { size, pal: opts.pal ?? pal, fx: fx !== !!(f & 1), fy: fy !== !!(f & 2), prio });\n  }\n}\n/** In scanline(y): set the CGRAM entry of a gradient from ART.gradients to its colour for line y (generated by art.py). */\nfunction gradientLine(g, y) {\n  const v = g.lines[y - g.y0];\n  if (v !== undefined) color(g.entry, v & 31, (v >> 5) & 31, v >> 10);\n}\n// END ART\n\nconst PAGES = ['RINGSIDE', 'VALLEY'];\nlet page = 0, scrollX = 0;\nconst flashes = [];\n\nfunction init() {\n  showPage();\n}\n\n/** Point the three layers at the page's scenes in Map RAM. */\nfunction showPage() {\n  const L = page === 0 ? [ART.scenes.canvas, ART.scenes.ring, ART.scenes.crowd] : [ART.scenes.near, ART.scenes.mid, ART.scenes.far];\n  for (let l = 0; l < 3; l++) {\n    const s = L[l];\n    bg(l, { mx: s.mx, my: l === 0 && page === 0 ? 0 : s.my, mw: 32, mh: 28, x: 0, y: 0, wrap: true, show: true });\n  }\n}\n\nfunction update() {\n  const was = page;\n  if (btnp(RIGHT)) page = (page + 1) % PAGES.length;\n  if (btnp(LEFT)) page = (page + PAGES.length - 1) % PAGES.length;\n  if (page !== was) showPage();\n  scrollX += 0.5;\n  // Camera flashes in the crowd: now and then the camera colour of the crowd's palette goes white for a few frames.\n  if (page === 0 && rnd() < 0.04) flashes.push(6);\n  for (let i = flashes.length - 1; i >= 0; i--) if (--flashes[i] <= 0) flashes.splice(i, 1);\n}\n\nfunction draw() {\n  cls();\n  blend(null);\n  if (page === 0) {\n    const flash = flashes.length > 0;\n    color(16 + 15, flash ? 31 : 5, flash ? 31 : 4, flash ? 31 : 6);   // the crowd palette's 'flash' entry (its 15th; 2a2236 in art.py)\n    // The boxer breathes: his top half (a big sprite of its own) bobs a pixel every half second over his legs. His\n    // shadow (sprite palette 4) is subtracted from the canvas: drawn after him at the same priority, so under him\n    // (sprites at priority 1 would be under the canvas layer itself).\n    blend({ layers: ['spr'], op: 'sub' });\n    const ox = 112, oy = 70;   // the opponent stands high in the frame, as in Super Punch-Out!!\n    bigSprite(ART.big.boxerTop, ox, oy + flr(t() / 30) % 2, { prio: 2 });\n    bigSprite(ART.big.boxerLegs, ox, oy + 64, { prio: 2 });\n    bigSprite(ART.big.shadow, ox + 4, oy + 100, { prio: 2 });\n    // Our hero, from behind in the foreground, over his opponent: drawn after the opponent, at a higher priority.\n    bigSprite(ART.big.hero, 40 + (flr(t() / 40) % 2), 128, { prio: 3 });\n    // The HUD: the round, and the two life bars (the empty part drawn over them on the overlay).\n    bigSprite(ART.big.round, 128 - flr(ART.big.round.w / 2), 6);\n    bigSprite(ART.big.bar, 8, 28); bigSprite(ART.big.bar, 152, 28);\n    rectfill(8 + 96 - 1 - 30, 29, 30, 8, ART.colors.INK);\n    print('NOVA', 8, 40, ART.colors.WHITE); print('KIT', 248 - 24, 40, ART.colors.WHITE);\n  } else {\n    // Parallax: the far layer at a quarter of the speed, the hills at half, the grass at full; the clouds drift too.\n    bgscroll(2, flr(scrollX / 4), 0);\n    bgscroll(1, flr(scrollX / 2), 0);\n    bgscroll(0, flr(scrollX), 0);\n  }\n  print(`< ${PAGES[page]} >`, 128 - (PAGES[page].length + 4) * 4, page === 0 ? 40 : 214, ART.colors.GOLD);\n}\n\nfunction scanline(y) {\n  if (page === 1) gradientLine(ART.gradients.sky, y);\n}\n",
